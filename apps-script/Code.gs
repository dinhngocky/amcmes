    ToWarehouseName: 'Kho nhận', TotalQuantity: 'Tổng số lượng', TotalValue: 'Tổng giá trị',
    Status: 'Trạng thái', Reason: 'Lý do', CreatedBy: 'Người lập', Notes: 'Ghi chú',
    CreatedAt: 'Ngày tạo', ReceivedAt: 'Nhận lúc', ReceivedBy: 'Người nhận', ClientRef: 'Mã chống trùng' };
  LABELS.StockTransferItems = { TransferItemID: 'Mã dòng', TransferID: 'Mã phiếu chuyển',
    ProductID: 'Mã Hệ Thống', SKU: 'Mã SKU', ProductName: 'Tên sản phẩm', Quantity: 'Số lượng',
    UnitCost: 'Giá vốn', LineTotal: 'Thành tiền', Notes: 'Ghi chú' };
  LABELS.StockMovements.WarehouseID = 'Mã kho';
  LABELS.StockMovements.WarehouseName = 'Kho';
  LABELS.Products.DefaultWarehouseID = 'Kho mặc định';
  LABELS.InventoryChecks.WarehouseName = 'Kho kiểm kê';

  VLABELS.Type = VLABELS.Type || {};
  VLABELS.Type.TransferOut = 'Chuyển kho đi';
  VLABELS.Type.TransferIn = 'Chuyển kho đến';
