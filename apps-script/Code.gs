function extractDriveFileId_(url) {
  var s = String(url || '');
  var m = s.match(/[?&]id=([^&]+)/) || s.match(/\/d\/([^/]+)/) || s.match(/thumbnail\?id=([^&]+)/);
  return m ? decodeURIComponent(m[1]) : '';
}

/**
 * Ảnh nào ĐANG được hệ thống lưu thì mới cho tải. Nếu không chặn, bất kỳ ai đăng nhập
 * cũng có thể nhờ máy chủ tải về một địa chỉ tùy ý, hoặc mở một tệp Drive bất kỳ của
 * chủ bảng tính bằng cách đoán mã tệp — vì mã chạy dưới quyền của chủ sở hữu.
 */
function imageIsKnown_(url) {
  var want = String(url || '').trim();
  if (!want) return false;
  var wantId = extractDriveFileId_(want) || '';
  var found = false;
  function xet(v) {
    if (found || !v) return;
    var s = String(v).trim();
    if (!s) return;
    if (s === want) { found = true; return; }
    if (wantId && extractDriveFileId_(s) === wantId) found = true;
  }
  try {
    xet(CONFIG.LOGO_URL);
    sheetToObjects_('Settings').forEach(function (s) {
      if (String(s.Key || '').indexOf('Logo') >= 0 || String(s.Key || '').indexOf('Image') >= 0) xet(s.Value);
    });
    if (!found) sheetToObjects_('Products').forEach(function (p) { xet(p.ImageUrl); });
    if (!found) sheetToObjects_('Payments').forEach(function (p) { xet(p.BillImageUrl); });
    if (!found) {
      try { sheetToObjects_('FinanceTransactions').forEach(function (t) { xet(t.BillImageUrl); }); } catch (e) { console.warn('[imageIsKnown_]', (e && e.message) || String(e));  }
    }
  } catch (e) { console.warn('[imageIsKnown_]', (e && e.message) || String(e));  return false; }
  return found;
}

function getImageDataUrl(url) {
  try {
    if (!url) return ok_({ dataUrl: '' });
    if (!imageIsKnown_(url)) {
      return err_('Chỉ tải được ảnh do hệ thống lưu (logo, ảnh sản phẩm, ảnh chứng từ).', 'ERR_IMG_NOT_ALLOWED');
    }
    var blob;
    var id = extractDriveFileId_(url);
    if (id) {
      blob = DriveApp.getFileById(id).getBlob();
    } else {
      var res = UrlFetchApp.fetch(url, { muteHttpExceptions: true, followRedirects: true });
      if (res.getResponseCode() >= 300) return ok_({ dataUrl: '', url: url });
      blob = res.getBlob();
    }
    return ok_({ url: url, dataUrl: 'data:' + blob.getContentType() + ';base64,' + Utilities.base64Encode(blob.getBytes()) });
  } catch (e) {
    return err_(e.message);
  }
}

function createProduct(data) {
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked', ['Products', 'StockMovements', 'Settings'], function () {
    return createProduct(data);
  });
  try {
    // Chặn trước khi cấp mã: lưu hỏng thì không đốt mất một số thứ tự.
    if (!String(data.ProductName || '').trim()) return err_('Chưa nhập tên sản phẩm.', 'ERR_NO_PRODUCT_NAME');
    var isService = isServiceProduct_(data);
    var partNumber = String(data.PartNumber || '').trim();
    var brandMaterial = String(data.BrandMaterial || '').trim();
    var rawCategory = String(data.Category || '').trim();
    var classification = isService ? 'Dịch vụ' : (rawCategory ? normalizeProductClassification_(rawCategory) : '');
    if (!partNumber) return err_('Chưa nhập Mã hàng (Part No. hoặc Drawing No.).', 'ERR_NO_PART_NUMBER');
    if (!brandMaterial) return err_('Chưa nhập Brand / Vật liệu.', 'ERR_NO_BRAND_MATERIAL');
    if (rawCategory && !classification) return err_('Phân loại không hợp lệ. Vui lòng chọn đúng danh sách đã cấu hình.', 'ERR_PRODUCT_CLASSIFICATION');
    if (productPartNumberExists_(partNumber, '')) return err_('Mã hàng "' + partNumber + '" đã tồn tại.', 'ERR_DUP_PART_NUMBER');
    // Giá âm sẽ kéo theo giá trị tồn âm, doanh thu âm và lợi nhuận sai ở mọi báo cáo phía sau.
    var loGia_ = assertPricesNotNegative_(data);
    if (loGia_) return err_(loGia_, 'ERR_NEGATIVE_PRICE');
    var id = generateId('SP');
    var now = new Date();
    if (data.SKU && sheetToObjects_('Products').some(function (p) { return String(p.SKU) === String(data.SKU); })) return err_('Mã SKU "' + data.SKU + '" đã tồn tại, vui lòng dùng mã khác.');
    // Dịch vụ cũ vẫn được hỗ trợ để không phá dữ liệu bán hàng, nhưng không xuất hiện trong luồng production-first.
    var cost = toNumber(data.CostPrice);
    var cur = isService ? 0 : toNumber(data.OpeningStock);
    var minS = isService ? 0 : toNumber(data.MinStock || CONFIG.LOW_STOCK_DEFAULT);
    var maxS = isService ? 0 : toNumber(data.MaxStock || CONFIG.MAX_STOCK_DEFAULT);
    var obj = {
      ProductID: id, SKU: data.SKU || id, ProductName: data.ProductName, ProductType: isService ? 'Service' : 'Product', ImageUrl: data.ImageUrl || '',
      PartNumber: partNumber, BrandMaterial: brandMaterial,
      Category: isService ? 'Dịch vụ' : classification,
      FAIRequired: productBool_(data.FAIRequired),
      TechnicalSpecifications: String(data.TechnicalSpecifications || '').trim(),
      Unit: data.Unit || (isService ? 'Lần' : 'cái'),
      CostPrice: cost, SalePrice: toNumber(data.SalePrice),
      MinStock: minS,
      MaxStock: maxS,
      OpeningStock: cur, CurrentStock: cur,
      StockValue: isService ? 0 : cur * cost,
      Status: isService ? 'Dịch vụ' : calculateStockStatus(cur, minS, maxS),
      CreatedAt: now, UpdatedAt: now, Notes: data.Notes || ''
    };
    appendRow('Products', obj);
    syncProductTaxonomy_(obj.Unit, obj.Category);
    if (!isService && cur > 0) {   // Dịch vụ: KHÔNG tạo phiếu tồn đầu kỳ
      appendRow('StockMovements', {
        MovementID: generateId('MV'), Date: now, Type: 'Opening', SourceType: 'Product', SourceID: id,
        ProductID: id, SKU: obj.SKU, ProductName: obj.ProductName, QuantityIn: cur, QuantityOut: 0,
        UnitCost: obj.CostPrice, UnitPrice: obj.SalePrice, StockAfter: cur, CreatedBy: getUser_(), Notes: 'Tồn đầu kỳ', CreatedAt: now, Status: 'Đã nhận'
      });
    }
    return ok_(obj, isService ? 'Đã tạo dịch vụ' : 'Đã tạo sản phẩm');
  } catch (e) { return err_(e.message); }
}

/**
 * Nhập nhiều sản phẩm 1 lần (từ Excel/CSV). Chạy ĐÚNG logic tạo sản phẩm cho từng dòng:
 * sinh Mã hệ thống, tạo phiếu "Tồn đầu kỳ" vào sổ (nên tồn không bao giờ bị âm), tính StockValue.
 * Bỏ qua dòng trùng Mã SKU (với hàng đã có hoặc trùng trong chính lô nhập).
 */
function bulkImportProducts(data) {
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked', ['Products', 'StockMovements', 'Settings'], function () { return bulkImportProducts(data); });
  try {
    var rows = data.rows || [];
    if (!rows.length) return err_('Không có dữ liệu để nhập');
    var now = new Date();
    var existingSku = {}, existingPartNumber = {}, allowedClassifications = productClassifications_();
    sheetToObjects_('Products').forEach(function (p) { if (p.SKU) existingSku[String(p.SKU).toLowerCase()] = true; });
    sheetToObjects_('Products').forEach(function (p) { if (p.PartNumber) existingPartNumber[String(p.PartNumber).trim().toLowerCase()] = true; });
    var batchSku = {}, batchPartNumber = {}, valid = [], skipped = 0, invalid = 0;
    var invalidReason = { ProductName: 0, PartNumber: 0, BrandMaterial: 0, InvalidCategory: 0 };
    rows.forEach(function (r) {
      var name = String(r.ProductName || '').trim();
      var partNumber = String(r.PartNumber || '').trim();
      var brandMaterial = String(r.BrandMaterial || '').trim();
      var rawCategory = String(r.Category || '').trim();
      var classification = isServiceProduct_(r) ? 'Dịch vụ' : (rawCategory ? normalizeProductClassification_(rawCategory, allowedClassifications) : '');
      if (!name || !partNumber || !brandMaterial || (rawCategory && !classification)) {
        invalid++;
        if (!name) invalidReason.ProductName++;
        if (!partNumber) invalidReason.PartNumber++;
        if (!brandMaterial) invalidReason.BrandMaterial++;
        if (rawCategory && !classification) invalidReason.InvalidCategory++;
        return;
      }
      var sku = String(r.SKU || '').trim();
      if (sku) { var k = sku.toLowerCase(); if (existingSku[k] || batchSku[k]) { skipped++; return; } batchSku[k] = true; }
      var pk = partNumber.toLowerCase();
      if (existingPartNumber[pk] || batchPartNumber[pk]) { skipped++; return; }
      batchPartNumber[pk] = true;
      valid.push(r);
    });
    if (!valid.length) {
      var reasonText = [];
      if (invalidReason.ProductName) reasonText.push(invalidReason.ProductName + ' thiếu Tên sản phẩm');
      if (invalidReason.PartNumber) reasonText.push(invalidReason.PartNumber + ' thiếu Mã hàng');
      if (invalidReason.BrandMaterial) reasonText.push(invalidReason.BrandMaterial + ' thiếu Brand/Vật liệu');
      if (invalidReason.InvalidCategory) reasonText.push(invalidReason.InvalidCategory + ' Phân loại không thuộc danh sách chuẩn');
      if (skipped) reasonText.push(skipped + ' dòng trùng mã');
      return err_('Không có dòng hợp lệ để nhập.' + (reasonText.length ? ' ' + reasonText.join('; ') + '.' : ' Mỗi dòng cần Tên sản phẩm, Mã hàng và Brand/Vật liệu.'));
    }
    var ids = generateIds('SP', valid.length);
    // FIX: chỉ đếm dòng KHÔNG PHẢI dịch vụ mới cần mã biến động kho (tránh lệch mvIds).
    var openingCount = 0;
    valid.forEach(function (r) { if (!isServiceProduct_(r) && toNumber(r.OpeningStock) > 0) openingCount++; });
    var mvIds = openingCount ? generateIds('MV', openingCount) : [];
    var mi = 0, productRows = [], movementRows = [], taxonomy = {};
    valid.forEach(function (r, idx) {
      var id = ids[idx];
      // FIX: 'isService' trước đây dùng mà không khai báo -> ReferenceError khi nhập Excel.
      var isService = isServiceProduct_(r);
      var cost = toNumber(r.CostPrice);
      var cur = isService ? 0 : toNumber(r.OpeningStock);
      var minS = isService ? 0 : ((r.MinStock !== undefined && r.MinStock !== '') ? toNumber(r.MinStock) : CONFIG.LOW_STOCK_DEFAULT);
      var maxS = isService ? 0 : ((r.MaxStock !== undefined && r.MaxStock !== '') ? toNumber(r.MaxStock) : CONFIG.MAX_STOCK_DEFAULT);
      var unit = String(r.Unit || '').trim() || (isService ? 'Lần' : 'cái');
      var rawCategory = String(r.Category || '').trim();
      var cat = isService ? 'Dịch vụ' : (rawCategory ? normalizeProductClassification_(rawCategory, allowedClassifications) : '');
      var name = String(r.ProductName).trim();
      var sku = String(r.SKU || '').trim() || id;
      productRows.push({
        ProductID: id, SKU: sku, ProductName: name, ProductType: isService ? 'Service' : 'Product', ImageUrl: '', Unit: unit, Category: cat,
        PartNumber: String(r.PartNumber || '').trim(), BrandMaterial: String(r.BrandMaterial || '').trim(),
        FAIRequired: productBool_(r.FAIRequired), TechnicalSpecifications: String(r.TechnicalSpecifications || '').trim(),
        CostPrice: cost, SalePrice: toNumber(r.SalePrice), MinStock: minS, MaxStock: maxS,
        OpeningStock: cur, CurrentStock: cur, StockValue: isService ? 0 : cur * cost,
        Status: isService ? 'Dịch vụ' : calculateStockStatus(cur, minS, maxS), CreatedAt: now, UpdatedAt: now, Notes: String(r.Notes || '').trim()
      });
      taxonomy[unit + '||' + cat] = [unit, cat];
      if (!isService && cur > 0) {   // Dịch vụ: không tạo tồn đầu kỳ
        movementRows.push({
          MovementID: mvIds[mi++], Date: now, Type: 'Opening', SourceType: 'Product', SourceID: id,
          ProductID: id, SKU: sku, ProductName: name, QuantityIn: cur, QuantityOut: 0,
          UnitCost: cost, UnitPrice: toNumber(r.SalePrice), StockAfter: cur, CreatedBy: getUser_(),
          Notes: 'Tồn đầu kỳ (nhập Excel)', CreatedAt: now, Status: 'Đã nhận'
        });
      }
    });
    appendRows('Products', productRows);
    if (movementRows.length) appendRows('StockMovements', movementRows);
    Object.keys(taxonomy).forEach(function (k) { try { syncProductTaxonomy_(taxonomy[k][0], taxonomy[k][1]); } catch (e) { console.warn('[bulkImportProducts]', (e && e.message) || String(e)); } });
    writeAudit_('Nhập sản phẩm từ Excel', 'Product', '', 'Tạo ' + productRows.length + ' SP' + (skipped ? ', bỏ qua ' + skipped + ' trùng SKU' : ''));
    return ok_({ created: productRows.length, skipped: skipped, invalid: invalid }, 'Đã nhập ' + productRows.length + ' sản phẩm' + (skipped ? ' — bỏ qua ' + skipped + ' dòng trùng mã' : '') + (invalid ? ' — bỏ qua ' + invalid + ' dòng thiếu dữ liệu chuẩn' : ''));
  } catch (e) { return err_(e.message); }
}

/**
 * Đổi mã SKU của một sản phẩm thì phải đổi cả những bản sao đã ghi kèm trong
 * chứng từ cũ (chi tiết phiếu mua/bán, biến động kho, kiểm kê, trả hàng, báo giá).
 * Nếu không, chứng từ cũ in ra vẫn hiện mã SKU cũ và người dùng tưởng dữ liệu sai.
 * Các sổ này lưu SKU chỉ để hiển thị, ProductID mới là khóa nối — nên đổi hoàn toàn an toàn.
 */
function syncProductSkuEverywhere_(productId, newSku) {
  var targets = [
    ['SalesItems', 'SalesItemID'], ['PurchaseItems', 'PurchaseItemID'],
    ['StockMovements', 'MovementID'], ['InventoryCheckItems', 'CheckItemID'],
    ['SalesReturnItems', 'ReturnItemID'], ['PurchaseReturnItems', 'PurchaseReturnItemID'],
    ['QuoteItems', 'QuoteItemID']
  ];
  var changed = 0;
  for (var i = 0; i < targets.length; i++) {
    var sheetName = targets[i][0], idField = targets[i][1];
    if (!SCHEMA[sheetName] || SCHEMA[sheetName].indexOf('SKU') < 0) continue;
    var rows;
    try { rows = sheetToObjects_(sheetName); } catch (e) { console.warn('[syncProductSkuEverywhere_]', (e && e.message) || String(e));  continue; }
    var map = {}, n = 0;
    for (var j = 0; j < rows.length; j++) {
      if (String(rows[j].ProductID) === String(productId) && String(rows[j].SKU || '') !== String(newSku)) {
        map[String(rows[j][idField])] = { SKU: newSku };
        n++;
      }
    }
    if (!n) continue;
    if (typeof updateRowsById_ === 'function') updateRowsById_(sheetName, idField, map);
    else Object.keys(map).forEach(function (id) { updateRowById(sheetName, idField, id, map[id]); });
    changed += n;
  }
  return changed;
}

function updateProduct(productId, data) {
  data = data || {};
  // Đổi mã SKU sẽ sửa lây sang các sổ chi tiết -> phải khóa luôn để lưu hỏng còn khôi phục được.
  if (!data.__locked) return runLocked_(data, '__locked',
    ['Products', 'StockMovements', 'Settings', 'SalesItems', 'PurchaseItems',
      'InventoryCheckItems', 'SalesReturnItems', 'PurchaseReturnItems', 'QuoteItems'], function () {
    return updateProduct(productId, data);
  });
  try {
    if (data.SKU !== undefined && sheetToObjects_('Products').some(function (p) { return p.ProductID !== productId && String(p.SKU) === String(data.SKU); })) return err_('Mã SKU "' + data.SKU + '" đã thuộc về sản phẩm khác.');
    if (data.ProductName !== undefined && !String(data.ProductName || '').trim()) return err_('Tên sản phẩm không được để trống.');
    if (data.PartNumber !== undefined && !String(data.PartNumber || '').trim()) return err_('Mã hàng không được để trống.');
    if (data.BrandMaterial !== undefined && !String(data.BrandMaterial || '').trim()) return err_('Brand / Vật liệu không được để trống.');
    if (data.PartNumber !== undefined && productPartNumberExists_(data.PartNumber, productId)) return err_('Mã hàng "' + String(data.PartNumber).trim() + '" đã thuộc về sản phẩm khác.', 'ERR_DUP_PART_NUMBER');
    var loGiaSua_ = assertPricesNotNegative_(data);
    if (loGiaSua_) return err_(loGiaSua_, 'ERR_NEGATIVE_PRICE');
    var updates = {};
    ['SKU', 'ProductName', 'PartNumber', 'BrandMaterial', 'ImageUrl', 'Unit', 'TechnicalSpecifications', 'Notes'].forEach(function (k) {
      if (data[k] !== undefined) updates[k] = data[k];
    });
    if (data.Category !== undefined) {
      var rawCategory = String(data.Category || '').trim();
      var normalizedCategory = normalizeProductType_(data.ProductType) === 'Service' ? 'Dịch vụ' : (rawCategory ? normalizeProductClassification_(rawCategory) : '');
      if (rawCategory && !normalizedCategory) return err_('Phân loại không hợp lệ. Vui lòng chọn đúng danh sách đã cấu hình.', 'ERR_PRODUCT_CLASSIFICATION');
      updates.Category = normalizedCategory;
    }
    if (data.FAIRequired !== undefined) updates.FAIRequired = productBool_(data.FAIRequired);
    ['CostPrice', 'SalePrice', 'MinStock', 'MaxStock'].forEach(function (k) {
      if (data[k] !== undefined) updates[k] = toNumber(data[k]);
    });
    // Cho phép đổi Loại mặt hàng. Nếu chuyển sang Dịch vụ -> triệt tiêu mọi số liệu kho.
    if (data.ProductType !== undefined) {
      var t = normalizeProductType_(data.ProductType) || 'Product';
      updates.ProductType = t;
      if (t === 'Service') {
        updates.Category = 'Dịch vụ';
        updates.MinStock = 0; updates.MaxStock = 0; updates.OpeningStock = 0; updates.CurrentStock = 0; updates.StockValue = 0; updates.Status = 'Dịch vụ';
      }
    }
    updates.UpdatedAt = new Date();
    updateRowById('Products', 'ProductID', productId, updates);
    if (updates.SKU !== undefined) syncProductSkuEverywhere_(productId, updates.SKU);
    syncProductTaxonomy_(updates.Unit, updates.Category);
    recalculateProductStock(productId); // với Dịch vụ sẽ tự giữ tồn = 0
    return ok_(null, 'Đã cập nhật sản phẩm');
  } catch (e) { return err_(e.message); }
}

function parseListSetting_(value) {
  return String(value || '')
    .split(/[\n,;]+/)
    .map(function (x) { return String(x || '').trim(); })
    .filter(function (x, i, arr) { return x && arr.indexOf(x) === i; });
}

/**
 * Học thêm nhóm khách hàng / nhóm nhà cung cấp mới vào Cài đặt.
 * Cần thiết vì nhóm có thể tới từ nhập Excel hoặc gõ thẳng trên Google Sheet;
 * nếu không học thì lần sau mở ô chọn sẽ không thấy nhóm đó nữa.
 */
function syncPartyTaxonomy_(customerGroup, supplierCategory) {
  try {
    var st = settings_();
    if (customerGroup) {
      var g = parseListSetting_(st.CustomerGroups || 'Khách lẻ,Đại lý,Doanh nghiệp');
      if (g.indexOf(customerGroup) < 0) { g.push(customerGroup); updateSetting('CustomerGroups', g.join(', ')); }
    }
    if (supplierCategory) {
      var c = parseListSetting_(st.SupplierCategories || 'Nguyên liệu,Bao bì,Thiết bị');
      if (c.indexOf(supplierCategory) < 0) { c.push(supplierCategory); updateSetting('SupplierCategories', c.join(', ')); }
    }
  } catch (e) { console.warn('[syncPartyTaxonomy_]', (e && e.message) || String(e));  }
}

function syncProductTaxonomy_(unit, category) {
  var st = settings_();
  var units = parseListSetting_(st.ProductUnits || 'cái,hộp,kg,lít,chai,gói,thùng');
  if (unit && units.indexOf(unit) < 0) units.push(unit);
  updateSetting('ProductUnits', units.join(', '));
  // Phân loại do quản trị cấu hình; tuyệt đối không ghi đè về 8 giá trị mặc định khi lưu sản phẩm.
  if (!parseListSetting_(st.ProductCategories).length) updateSetting('ProductCategories', PRODUCT_CLASSIFICATION_DEFAULTS_.join(', '));
}

function deleteProduct(productId, __locked) {
  if (!__locked) return withMutationLock_(['Products', 'StockMovements', 'BOM', 'ProductionOrders', 'ProductionMaterials',
    'Machines', 'MaterialRequirements', 'WarehouseReceiptItems', 'MaterialLocations', 'MaterialKitItems'], function () {
    return deleteProduct(productId, true);
  });
  try {
    // P0-#3: chặn xóa nếu sản phẩm đã phát sinh giao dịch (tránh mồ côi dữ liệu lịch sử)
    var refs = [];
    if (sheetToObjects_('SalesItems').some(function (i) { return i.ProductID === productId; })) refs.push('hóa đơn bán');
    if (sheetToObjects_('PurchaseItems').some(function (i) { return i.ProductID === productId; })) refs.push('phiếu mua');
    if (sheetToObjects_('QuoteItems').some(function (i) { return i.ProductID === productId; })) refs.push('báo giá');
    if (sheetToObjects_('BOM').some(function (i) { return i.ProductID === productId || i.ComponentID === productId; })) refs.push('BOM');
    if (sheetToObjects_('ProductionOrders').some(function (i) { return i.ProductID === productId; })) refs.push('lệnh sản xuất');
    if (sheetToObjects_('ProductionMaterials').some(function (i) { return i.ComponentID === productId; })) refs.push('vật tư lệnh sản xuất');
    if (sheetToObjects_('Machines').some(function (i) { return i.ProductID === productId; })) refs.push('máy');
    if (sheetToObjects_('MaterialRequirements').some(function (i) { return i.ProductID === productId; })) refs.push('nhu cầu vật tư');
    if (sheetToObjects_('WarehouseReceiptItems').some(function (i) { return i.ProductID === productId; })) refs.push('phiếu nhận hàng');
    if (sheetToObjects_('MaterialLocations').some(function (i) { return i.ProductID === productId; })) refs.push('vị trí vật tư');
    if (sheetToObjects_('MaterialKitItems').some(function (i) { return i.ProductID === productId; })) refs.push('bộ kit vật tư');
    var moves = sheetToObjects_('StockMovements').filter(function (m) { return m.ProductID === productId; });
    if (moves.some(function (m) { return m.Type !== 'Tồn đầu kỳ' && m.Type !== 'Opening'; })) refs.push('biến động kho');
    if (refs.length) return err_('Không thể xóa sản phẩm vì đã phát sinh giao dịch (' + refs.join(', ') + '). Để giữ toàn vẹn lịch sử, hãy đưa tồn về 0 và ngừng sử dụng sản phẩm thay vì xóa.');
    // chưa phát sinh giao dịch -> xóa luôn dòng tồn đầu kỳ kèm theo
    moves.forEach(function (m) { deleteRowById('StockMovements', 'MovementID', m.MovementID); });
    deleteRowById('Products', 'ProductID', productId);
    return ok_(null, 'Đã xóa sản phẩm');
  } catch (e) { return err_(e.message); }
}

/** Xóa 1 dòng biến động kho và tính lại tồn sản phẩm liên quan. */
function deleteStockMovement(movementId, __locked) {
  if (!__locked) return withMutationLock_(['StockMovements', 'Products'], function () {
    return deleteStockMovement(movementId, true);
  });
  try {
    var m = sheetToObjects_('StockMovements').filter(function (x) { return x.MovementID === movementId; })[0];
    // P0-#3: không cho xóa trực tiếp phiếu kho thuộc chứng từ gốc (phải hủy/sửa chứng từ để không lệch sổ)
    if (m && ['SalesOrder', 'PurchaseOrder', 'SalesReturn', 'InventoryCheck', 'WarehouseReceipt', 'MaterialKit'].indexOf(m.SourceType) >= 0) {
      return err_('Phiếu kho này thuộc chứng từ ' + (m.SourceID || '') + '. Hãy hủy/sửa chứng từ gốc thay vì xóa phiếu kho trực tiếp để tránh lệch tồn và công nợ.');
    }
    deleteRowById('StockMovements', 'MovementID', movementId);
    if (m && m.ProductID) recalculateProductStock(m.ProductID);
    return ok_(null, 'Đã xóa phiếu kho');
  } catch (e) { return err_(e.message); }
}

/** Xóa phiếu kiểm kê: xóa phiếu + chi tiết + các điều chỉnh tồn liên quan, rồi tính lại tồn. */
function deleteInventoryCheck(checkId, __locked) {
  if (!__locked) return withMutationLock_(['InventoryChecks', 'InventoryCheckItems', 'StockMovements', 'Products'], function () {
    return deleteInventoryCheck(checkId, true);
  });
  try {
    var affected = {};
    sheetToObjects_('StockMovements').filter(function (mv) { return mv.SourceID === checkId; }).forEach(function (mv) { affected[mv.ProductID] = true; });
    // xóa các movement điều chỉnh của phiếu này (lặp tới khi hết)
    var mv = sheetToObjects_('StockMovements').filter(function (x) { return x.SourceID === checkId; });
    mv.forEach(function (x) { deleteRowById('StockMovements', 'MovementID', x.MovementID); });
    sheetToObjects_('InventoryCheckItems').filter(function (i) { return i.CheckID === checkId; })
      .forEach(function (i) { deleteRowById('InventoryCheckItems', 'CheckItemID', i.CheckItemID); });
    deleteRowById('InventoryChecks', 'CheckID', checkId);
    Object.keys(affected).forEach(function (pid) { recalculateProductStock(pid); });
    return ok_(null, 'Đã xóa phiếu kiểm kê');
  } catch (e) { return err_(e.message); }
}

/** Cập nhật nhanh 1 trường (vd: Trạng thái) trực tiếp từ danh sách. */
function updateField(sheetName, idColumn, idValue, field, value, __locked) {
  if (!__locked && sheetName === 'StockMovements' && field === 'Status') {
    return withMutationLock_(['StockMovements', 'Products'], function () {
      return updateField(sheetName, idColumn, idValue, field, value, true);
    });
  }
  try {
    if(PROC_TABLES_.concat(['PurchaseItems','MaterialLocations','PurchaseRequisitions','PurchaseRequisitionItems','WarehouseReceiptItems','MaterialKitItems']).indexOf(sheetName)>=0)return err_('Hãy dùng biểu mẫu nghiệp vụ để giữ truy vết vật tư.');
    if(sheetName==='MaterialRequirements')return updateMaterialRequirement(idValue,(function(){var x={};x[field]=value;return x;})());
    if(sheetName==='PurchaseOrders')dedicatedBlockPO_(idValue);
    if(sheetName==='StockMovements'&&field!=='Status'&&field!=='Notes')return err_('Không sửa trực tiếp thuộc tính sổ kho.');
    if (sheetName === 'PurchaseOrders' && idColumn === 'PurchaseID' && field === 'Status') {
      return updatePurchaseStatus(idValue, value);
    }
    if (sheetName === 'SalesOrders' && idColumn === 'SalesID' && field === 'Status') {
      return updateSalesStatus(idValue, value);
    }
    if (sheetName === 'ProductionOrders' && idColumn === 'ProductionID' && field === 'Status') {
      return updateProductionStatus(idValue, value);
    }
    var u = {}; u[field] = value;
    if (sheetName === 'StockMovements' && field === 'Status') {
      var oldMv = sheetToObjects_('StockMovements').filter(function (x) { return x.MovementID === idValue; })[0];
      if (!oldMv) return err_('Không tìm thấy phiếu kho');
      if(oldMv.SourceType==='MaterialKit'||(oldMv.SourceType==='WarehouseReceipt'&&oldMv.RequirementID))return err_('Không đổi trạng thái sổ kho của phiếu IQC/kit trực tiếp.');
      validateStatus_(value, toNumber(oldMv.QuantityIn) > 0 ? STOCK_IN_STATUS_FLOW : STOCK_OUT_STATUS_FLOW, 'Trạng thái phiếu kho');
    }
    var found = updateRowById(sheetName, idColumn, idValue, u);
    // Đổi trạng thái phiếu kho -> tính lại tồn của sản phẩm liên quan
    if (found && sheetName === 'StockMovements' && field === 'Status') {
      var m = sheetToObjects_('StockMovements').filter(function (x) { return x.MovementID === idValue; })[0];
      if (m && m.ProductID) {
        recalculateProductStock(m.ProductID);
        // P1-#2: chặn tồn âm sau khi đổi trạng thái (khối khóa sẽ tự khôi phục)
        var pp = sheetToObjects_('Products').filter(function (x) { return x.ProductID === m.ProductID; })[0];
        if (pp && toNumber(pp.CurrentStock) < 0) return err_('Không thể đổi trạng thái: tồn kho "' + m.ProductName + '" sẽ bị âm (' + toNumber(pp.CurrentStock) + '). Hãy nhập thêm hàng trước.');
      }
    }
    return found ? ok_(null, 'Đã cập nhật') : err_('Không tìm thấy bản ghi');
  } catch (e) { return err_(e.message); }
}

/**
 * Điều chỉnh tồn kho về số mong muốn: tự tạo phiếu nhập/xuất chênh lệch (chuẩn ERP -
 * tồn luôn truy vết được qua biến động kho thay vì sửa cứng).
 */
function adjustProductStock(productId, targetQty, note, __locked) {
  if (!__locked) return withMutationLock_(['StockMovements', 'Products'], function () {
    return adjustProductStock(productId, targetQty, note, true);
  });
  try {
    var p = sheetToObjects_('Products').filter(function (x) { return x.ProductID === productId; })[0];
    if (!p) return err_('Không tìm thấy sản phẩm');
    var cur = toNumber(p.CurrentStock), target = toNumber(targetQty), diff = target - cur;
    if (diff === 0) return ok_(null, 'Tồn không đổi');
    var now = new Date();
    appendRow('StockMovements', {
      MovementID: generateId('MV'), Date: now, Type: diff > 0 ? 'ManualIn' : 'ManualOut', SourceType: 'Manual', SourceID: '',
      ProductID: p.ProductID, SKU: p.SKU, ProductName: p.ProductName,
      QuantityIn: diff > 0 ? diff : 0, QuantityOut: diff < 0 ? Math.abs(diff) : 0,
      UnitCost: toNumber(p.CostPrice), UnitPrice: toNumber(p.SalePrice), StockAfter: '',
      CreatedBy: getUser_(), Notes: note || 'Điều chỉnh tồn kho', CreatedAt: now, Status: diff > 0 ? 'Đã nhận' : 'Đã giao'
    });
    recalculateProductStock(productId);
    return ok_(null, 'Đã điều chỉnh tồn kho');
  } catch (e) { return err_(e.message); }
}

/**
 * Tác động THỰC TẾ lên tồn của 1 dòng biến động, theo TRẠNG THÁI:
 *  - Nhập: chỉ cộng kho khi 'Đã nhận' (Đang xử lý/Đã đặt hàng/Đã hủy/Trả lại NCC -> 0).
 *  - Xuất: trừ kho khi đang xử lý giao (Đóng gói/Sẵn sàng giao hàng/Đang vận chuyển/Đã giao);
 *          'Đã hủy'/'Trả lại vào kho' -> không trừ (tồn được hoàn lại).
 *  - Dòng cũ chưa có trạng thái (rỗng): tính như bình thường để tương thích.
 */
/* 'Trả lại NCC': hàng xuất trả nhà cung cấp có hiệu lực ngay khi lập phiếu (không qua quy trình giao hàng),
   nếu thiếu trạng thái này thì movementEffective_ trả 0 -> tồn kho KHÔNG giảm dù đã trả hàng. */
var OUT_ACTIVE_STATUS = ['Đóng gói', 'Sẵn sàng giao hàng', 'Đang vận chuyển', 'Đã giao', 'Trả lại NCC'];
var PURCHASE_STATUS_FLOW = ['Đã đặt hàng', 'Đã nhập kho', 'Hoàn tất', 'Đã hủy'];
var PURCHASE_STATUS_NEXT = {
  'Đã đặt hàng': ['Đã nhập kho', 'Đã hủy'],
  'Đã nhập kho': ['Hoàn tất', 'Đã hủy'],
  'Hoàn tất': [],
  'Đã hủy': []
};
var STOCK_IN_STATUS_FLOW = ['Đang xử lý', 'Đã đặt hàng', 'Đã nhận', 'Đã hủy', 'Trả lại NCC'];
var STOCK_OUT_STATUS_FLOW = ['Đóng gói', 'Sẵn sàng giao hàng', 'Đang vận chuyển', 'Đã giao', 'Đã hủy', 'Trả lại vào kho'];
var SALES_STATUS_FLOW = ['Đang xử lý', 'Hoàn tất', 'Đã hủy', 'Đã khóa'];
var SALES_STATUS_NEXT = { 'Đang xử lý': ['Hoàn tất', 'Đã hủy'], 'Hoàn tất': ['Đã hủy', 'Đã khóa'], 'Đã khóa': ['Hoàn tất'], 'Đã hủy': [] };

function normalizeStatus_(status, fallback) {
  status = String(status || '').trim();
  return status || fallback;
}

function validateStatus_(status, allowed, label) {
  if (allowed.indexOf(status) < 0) throw new Error((label || 'Trạng thái') + ' không hợp lệ: ' + status);
}

function validatePurchaseStatusChange_(po, nextStatus) {
  nextStatus = normalizeStatus_(nextStatus, po && po.Status || 'Đã đặt hàng');
  validateStatus_(nextStatus, PURCHASE_STATUS_FLOW, 'Trạng thái phiếu mua');
  if (!po || !po.PurchaseID) return nextStatus;
  var cur = normalizeStatus_(po.Status, 'Đã đặt hàng');
  if (cur === nextStatus) return nextStatus;
  validateStatus_(cur, PURCHASE_STATUS_FLOW, 'Trạng thái hiện tại');
  if (isCompleted_(cur) || isCancelled_(cur)) throw new Error('Phiếu mua đã ở trạng thái cuối, không thể đổi trạng thái trực tiếp');
  if ((PURCHASE_STATUS_NEXT[cur] || []).indexOf(nextStatus) < 0) {
    throw new Error('Không thể chuyển phiếu mua từ "' + cur + '" sang "' + nextStatus + '"');
  }
  if (isCompleted_(nextStatus) && toNumber(po.PayableAmount) > 0) {
    throw new Error('Chỉ được hoàn tất phiếu mua khi đã thanh toán đủ');
  }
  return nextStatus;
}

function movementEffective_(m) {
  var inQ = toNumber(m.QuantityIn), outQ = toNumber(m.QuantityOut), st = m.Status, type = m.Type;

  /* HÀNG CHỜ IQC / LỖI IQC: KHÔNG tính vào tồn kho.
     Đây là điểm quan trọng — hàng TQ về chưa qua kiểm tra chất lượng
     thì chưa được coi là tồn khả dụng. */
  if (st === 'Chờ IQC' || st === 'Lỗi IQC' || st === 'WAITING_IQC') return 0;

  // Tồn đầu kỳ, điều chỉnh kiểm kê & biến động sản xuất luôn có hiệu lực
  if (type === 'Chuyển kho đi' || type === 'Chuyển kho đến' || type === 'TransferOut' || type === 'TransferIn') return inQ - outQ;
  if (type === 'Tồn đầu kỳ' || type === 'Điều chỉnh kiểm kê' || type === 'Xuất NVL sản xuất' || type === 'Nhập thành phẩm') return inQ - outQ;
  if (inQ > 0) { return (!st || st === 'Đã nhận' || st === 'Trả lại vào kho') ? inQ : 0; }
  if (outQ > 0) { return (!st || OUT_ACTIVE_STATUS.indexOf(st) >= 0) ? -outQ : 0; }
  return 0;
}

function recalculateProductStock(productId) {
  var products = sheetToObjects_('Products');
  var p = products.filter(function (x) { return x.ProductID === productId; })[0];
  if (!p) return;
  // DỊCH VỤ: không có tồn kho -> luôn về 0 và trạng thái 'Dịch vụ'.
  if (isServiceProduct_(p)) {
    updateRowById('Products', 'ProductID', productId, {
      CurrentStock: 0, OpeningStock: 0, StockValue: 0, Status: 'Dịch vụ', UpdatedAt: new Date()
    });
    return 0;
  }
  var movements = (buildStockIndex_()[String(productId)] || []);
  var current = 0, inQtyTotal = 0, costSum = 0;
  movements.forEach(function (m) {
    var eff = movementEffective_(m);
    current += eff;
    // Giá vốn bình quân gia quyền: gộp các đợt nhập đã ghi nhận (eff > 0)
    if (eff > 0) { inQtyTotal += eff; costSum += eff * toNumber(m.UnitCost); }
  });
  // Tồn đầu kỳ: nếu sản phẩm được NHẬP TAY vào Sheet (không có dòng biến động "Tồn đầu kỳ"),
  // lấy giá trị từ cột "Tồn đầu kỳ" (OpeningStock) làm gốc — nếu không tồn sẽ bị âm khi bán.
  // SP tạo qua WebApp đã có sẵn dòng movement "Tồn đầu kỳ" nên nhánh này bỏ qua (không cộng trùng).
  var hasOpeningMovement = movements.some(function (m) { return m.Type === 'Tồn đầu kỳ' || m.Type === 'Opening'; });
  if (!hasOpeningMovement) {
    var op = toNumber(p.OpeningStock);
    if (op !== 0) { current += op; if (op > 0) { inQtyTotal += op; costSum += op * toNumber(p.CostPrice); } }
  }
  // Nếu có đợt nhập -> cập nhật giá vốn = bình quân gia quyền; nếu không, giữ giá vốn hiện tại
  var avgCost = inQtyTotal > 0 ? Math.round(costSum / inQtyTotal) : toNumber(p.CostPrice);
  var status = calculateStockStatus(current, p.MinStock, p.MaxStock);
  updateRowById('Products', 'ProductID', productId, {
    CurrentStock: current, CostPrice: avgCost, StockValue: current * avgCost, Status: status, UpdatedAt: new Date()
  });
  return current;
}

/**
 * Tính lại tồn cho NHIỀU sản phẩm trong 1 lần đọc + 1 lần ghi (P0 hiệu năng).
 * Giữ NGUYÊN quy tắc của recalculateProductStock(): dịch vụ về 0, giá vốn bình quân gia quyền,
 * chỉ cộng "Tồn đầu kỳ" từ cột OpeningStock khi CHƯA có dòng biến động tồn đầu kỳ.
 */
function recalculateProductStocks_(productIds) {
  var idsMap = {};
  (productIds || []).forEach(function (id) { if (id) idsMap[id] = true; });
  var list = Object.keys(idsMap);
  if (!list.length) return;
  if (list.length <= 3) { list.forEach(function (pid) { recalculateProductStock(pid); }); return; }

  var movByPid = buildStockIndex_();
  var now = new Date(), updates = {};
  sheetToObjects_('Products').forEach(function (p) {
    if (!idsMap[p.ProductID]) return;
    if (isServiceProduct_(p)) {
      updates[p.ProductID] = { CurrentStock: 0, OpeningStock: 0, StockValue: 0, Status: 'Dịch vụ', UpdatedAt: now };
      return;
    }
    var movements = movByPid[p.ProductID] || [];
    var current = 0, inQtyTotal = 0, costSum = 0, hasOpeningMovement = false;
    movements.forEach(function (m) {
      var eff = movementEffective_(m);
      current += eff;
      if (eff > 0) { inQtyTotal += eff; costSum += eff * toNumber(m.UnitCost); }
      if (m.Type === 'Tồn đầu kỳ' || m.Type === 'Opening') hasOpeningMovement = true;
    });
    if (!hasOpeningMovement) {
      var op = toNumber(p.OpeningStock);
      if (op !== 0) { current += op; if (op > 0) { inQtyTotal += op; costSum += op * toNumber(p.CostPrice); } }
    }
    var avgCost = inQtyTotal > 0 ? Math.round(costSum / inQtyTotal) : toNumber(p.CostPrice);
    updates[p.ProductID] = {
      CurrentStock: current, CostPrice: avgCost, StockValue: current * avgCost,
      Status: calculateStockStatus(current, p.MinStock, p.MaxStock), UpdatedAt: now
    };
  });
  updateRowsById_('Products', 'ProductID', updates);
}

function recalculateAllStocks() {
  var products = sheetToObjects_('Products');
  products.forEach(function (p) { recalculateProductStock(p.ProductID); });
  return ok_(null, 'Đã tính lại tồn kho cho ' + products.length + ' sản phẩm');
}

