function money_(n) {
  n = Math.round(toNumber(n)); var s = String(Math.abs(n)), out = '';
  for (var i = 0; i < s.length; i++) { if (i > 0 && (s.length - i) % 3 === 0) out += '.'; out += s.charAt(i); }
  return (n < 0 ? '-' : '') + out + ' đ';
}
function settings_() { var o = {}; sheetToObjects_('Settings').forEach(function (s) { o[s.Key] = s.Value; }); return o; }

/** Dự báo dòng tiền 30 ngày: phải thu (vào) - phải trả (ra) theo nhóm thời gian. */
function getCashFlowForecast() {
  try {
    var today = new Date(); today.setHours(0, 0, 0, 0);
    var horizon = new Date(today); horizon.setDate(horizon.getDate() + 30);
    var weeks = [{ label: 'Quá hạn', in: 0, out: 0 }, { label: '0-7 ngày', in: 0, out: 0 }, { label: '8-14 ngày', in: 0, out: 0 }, { label: '15-21 ngày', in: 0, out: 0 }, { label: '22-30 ngày', in: 0, out: 0 }];
    function bucket(due) { if (!due) return -1; var d = new Date(due); d.setHours(0, 0, 0, 0); if (d < today) return 0; if (d > horizon) return -1; var diff = Math.floor((d - today) / 86400000); if (diff < 7) return 1; if (diff < 14) return 2; if (diff < 21) return 3; return 4; }
    var inflow = 0, outflow = 0, overdueIn = 0, overdueOut = 0;
    sheetToObjects_('SalesOrders').forEach(function (s) { var r = toNumber(s.ReceivableAmount); if (r <= 0) return; var b = bucket(s.DueDate); if (b < 0) return; weeks[b].in += r; inflow += r; if (b === 0) overdueIn += r; });
    sheetToObjects_('PurchaseOrders').forEach(function (p) { var r = toNumber(p.PayableAmount); if (r <= 0) return; var b = bucket(p.DueDate); if (b < 0) return; weeks[b].out += r; outflow += r; if (b === 0) overdueOut += r; });
    return ok_({ weeks: weeks, inflow: inflow, outflow: outflow, net: inflow - outflow, overdueIn: overdueIn, overdueOut: overdueOut });
  } catch (e) { return err_(e.message); }
}

/** Chuyển HTML -> PDF base64 (cho tải xuống). */
function docToPdf(html, filename) {
  try {
    // Không có nội dung thì báo bằng tiếng Việt, đừng để lộ lỗi kỹ thuật của Google ra màn hình.
    if (!html || !String(html).trim()) return err_('Chưa có nội dung chứng từ để xuất PDF.', 'ERR_NO_DOC');
    var name = (filename || 'ChungTu');
    var blob = Utilities.newBlob(html, 'text/html', name + '.html').getAs('application/pdf');
    return ok_({ base64: Utilities.base64Encode(blob.getBytes()), filename: name + '.pdf' });
  } catch (e) { return err_(e.message); }
}

/** Lấy dữ liệu theo nhóm để xuất Excel. */
function exportDataset_(dataset) {
  var map = {
    products: 'Products', sales: 'SalesOrders', purchases: 'PurchaseOrders', customers: 'Customers',
    suppliers: 'Suppliers', movements: 'StockMovements', payments: 'Payments', returns: 'SalesReturns',
    financeTransactions: 'FinanceTransactions', cashAccounts: 'CashAccounts',
    financeCategories: 'FinanceCategories', budgets: 'BudgetPlans', budgetLines: 'BudgetLines'
  };
  return map[dataset] ? sheetToObjects_(map[dataset]) : [];
}

/**
 * Xuất Excel (.xlsx) đẹp: chọn nhóm dữ liệu + các trường. fields: [{key,label}].
 * Trả về base64 để tải xuống. (Cần quyền Spreadsheet + UrlFetch + Drive.)
 */
function exportExcelReport(dataset, fields, title) {
  try {
    fields = fields || [];
    if (!fields.length) return err_('Chưa chọn trường dữ liệu');
    var rows = exportDataset_(dataset);
    var stamp = getTodayString();
    var ss = SpreadsheetApp.create('AMCVN_' + dataset + '_' + stamp);
    var sh = ss.getSheets()[0]; sh.setName('Báo cáo');
    var ncol = fields.length;
    // Tiêu đề lớn
    sh.getRange(1, 1, 1, ncol).merge().setValue((title || 'BÁO CÁO AMCVN') + ' - ' + stamp)
      .setFontSize(14).setFontWeight('bold').setFontColor('#630ed4').setHorizontalAlignment('left');
    sh.setRowHeight(1, 30);
    // Header
    var headers = fields.map(function (f) { return f.label; });
    var hr = sh.getRange(2, 1, 1, ncol);
    hr.setValues([headers]).setFontWeight('bold').setFontColor('#ffffff').setBackground('#630ed4').setVerticalAlignment('middle');
    sh.setRowHeight(2, 26);
    var moneyIdx = [], dateIdx = [];
    fields.forEach(function (f, i) { if (MONEY_COLS.indexOf(f.key) >= 0) moneyIdx.push(i + 1); if (DATE_COLS.indexOf(f.key) >= 0) dateIdx.push(i + 1); });
    if (rows.length) {
      var data = rows.map(function (r) { return fields.map(function (f) { var v = r[f.key]; return (v === undefined || v === null) ? '' : v; }); });
      sh.getRange(3, 1, data.length, ncol).setValues(data);
      moneyIdx.forEach(function (c) { sh.getRange(3, c, data.length, 1).setNumberFormat('#,##0" ₫"'); });
      dateIdx.forEach(function (c) { sh.getRange(3, c, data.length, 1).setNumberFormat('dd/MM/yyyy'); });
      // dòng xen kẽ
      try { sh.getRange(2, 1, data.length + 1, ncol).applyRowBanding(SpreadsheetApp.BandingTheme.LIGHT_GREY, true, false); } catch (e) { console.warn('[exportExcelReport]', (e && e.message) || String(e)); }
    }
    sh.setFrozenRows(2);
    try { sh.getRange(2, 1, Math.max(2, rows.length + 1), ncol).createFilter(); } catch (e) { console.warn('[exportExcelReport]', (e && e.message) || String(e)); }
    for (var c = 1; c <= ncol; c++) { try { sh.autoResizeColumn(c); } catch (e) { console.warn('[exportExcelReport]', (e && e.message) || String(e)); } }
    SpreadsheetApp.flush();
    var url = 'https://docs.google.com/spreadsheets/d/' + ss.getId() + '/export?format=xlsx';
    var blob = UrlFetchApp.fetch(url, { headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() } }).getBlob();
    var b64 = Utilities.base64Encode(blob.getBytes());
    try { DriveApp.getFileById(ss.getId()).setTrashed(true); } catch (e) { console.warn('[exportExcelReport]', (e && e.message) || String(e)); }
    return ok_({ base64: b64, filename: 'AMCVN_' + dataset + '_' + stamp + '.xlsx' });
  } catch (e) { return err_(e.message); }
}

