function refreshCustomerBalance_(customerId) {
  var sales = sheetToObjects_('SalesOrders').filter(function (s) { return s.CustomerID === customerId; });
  var total = 0, receivable = 0, last = '';
  sales.forEach(function (s) {
    if (isCancelled_(normalizeStatus_(s.Status, ''))) return;
    if (String(s.Status || '') !== 'NO_CU') total += toNumber(s.TotalAmount);   // nợ cũ không phải "đã mua"
    receivable += toNumber(s.ReceivableAmount);
    if (s.SalesDate && (!last || new Date(s.SalesDate) > new Date(last))) last = s.SalesDate;
  });
  updateRowById('Customers', 'CustomerID', customerId, { TotalSales: total, ReceivableBalance: receivable, LastPurchaseDate: last });
}

