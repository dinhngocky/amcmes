function getPaymentDetail(paymentId) {
  return cachedPayload_('paydetail:' + paymentId, function () { return build_getPaymentDetail(paymentId); });
}
function build_getPaymentDetail(paymentId) {
  try {
    var pay = sheetToObjects_('Payments').filter(function (p) { return p.PaymentID === paymentId; })[0];
    if (!pay) return err_('Không tìm thấy phiếu thanh toán');
    var allocs = sheetToObjects_('PaymentAllocations').filter(function (a) { return a.PaymentID === paymentId; });
    if (!allocs.length && pay.SourceType && pay.SourceID) {
      allocs = [{ PaymentID: pay.PaymentID, ObjectType: pay.ObjectType, ObjectID: pay.ObjectID, ObjectName: pay.ObjectName, SourceType: pay.SourceType, SourceID: pay.SourceID, Amount: pay.Amount, CreatedAt: pay.CreatedAt }];
    }
    var salesMap = {}, purMap = {};
    sheetToObjects_('SalesOrders').forEach(function (s) { salesMap[s.SalesID] = s; });
    sheetToObjects_('PurchaseOrders').forEach(function (p) { purMap[p.PurchaseID] = p; });
    var salesItems = sheetToObjects_('SalesItems'), purchaseItems = sheetToObjects_('PurchaseItems');
    var sources = [], items = [];
    allocs.forEach(function (a) {
      if (salesMap[a.SourceID]) { // nhận diện theo SourceID (SourceType trong sheet đã dịch 'Hóa đơn'/'Phiếu mua')
        var so = salesMap[a.SourceID];
        sources.push({ SourceType: a.SourceType, SourceID: a.SourceID, Name: so.CustomerName, Date: so.SalesDate, TotalAmount: so.TotalAmount, PaidAmount: so.PaidAmount, RemainAmount: so.ReceivableAmount, AllocAmount: a.Amount });
        salesItems.filter(function (it) { return it.SalesID === a.SourceID; }).forEach(function (it) { items.push({ SourceID: a.SourceID, ProductName: it.ProductName, Quantity: it.Quantity, Price: it.SalePrice, LineTotal: it.LineRevenue }); });
      } else if (purMap[a.SourceID]) {
        var po = purMap[a.SourceID];
        sources.push({ SourceType: a.SourceType, SourceID: a.SourceID, Name: po.SupplierName, Date: po.PurchaseDate, TotalAmount: po.TotalAmount, PaidAmount: po.PaidAmount, RemainAmount: po.PayableAmount, AllocAmount: a.Amount });
        purchaseItems.filter(function (it) { return it.PurchaseID === a.SourceID; }).forEach(function (it) { items.push({ SourceID: a.SourceID, ProductName: it.ProductName, Quantity: it.Quantity, Price: it.UnitCost, LineTotal: it.LineTotal }); });
      } else {
        sources.push({ SourceType: a.SourceType, SourceID: a.SourceID, Name: a.ObjectName || pay.ObjectName, Date: pay.PaymentDate, TotalAmount: '', PaidAmount: '', RemainAmount: '', AllocAmount: a.Amount });
      }
    });
    if (!allocs.length && (pay.SourceType === 'CustomerReceipt' || pay.SourceType === 'SupplierPayment' || !pay.SourceID)) {
      sources.push({
        SourceType: pay.SourceType || (financePaymentIsCustomer_(pay) ? 'CustomerReceipt' : 'SupplierPayment'),
        SourceID: '', Name: pay.ObjectName, Date: pay.PaymentDate,
        TotalAmount: '', PaidAmount: '', RemainAmount: '', AllocAmount: pay.Amount,
        IsAdvance: true
      });
    }
    return ok_({ payment: pay, allocations: allocs, sources: sources, items: items });
  } catch (e) { return err_(e.message); }
}

