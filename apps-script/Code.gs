/**
 * XÁC NHẬN IQC cho lô hàng TQ.
 *
 * data: {
 *   items: [{
 *     ShipmentItemID,
 *     AcceptedQty,      // SL đạt
 *     RejectedQty,      // SL lỗi
 *     LocationCode,     // vị trí kho (chỉ ghi cho SL đạt)
 *     LotNo,
 *     NCRNo,
 *     Notes
 *   }]
 * }
 *
 * Sau khi xác nhận:
 *   - StockMovements của lô: 'Chờ IQC' → 'Đã nhận' (SL đạt) hoặc 'Lỗi IQC'
 *   - Cộng SL đạt vào tồn kho
 *   - Ghi MaterialLocations cho SL đạt (nếu có vị trí)
 *   - Lô → RECEIVED (khớp SL gửi) hoặc DIFF (lệch)
 */
function confirmChinaShipmentIQC(shipmentId, data) {
  data = data || {};
  if (!data.__locked) {
    return runLocked_(data, '__locked',
      ['ChinaShipments', 'ChinaShipmentItems', 'Products', 'StockMovements', 'MaterialLocations'],
      function () { return confirmChinaShipmentIQC(shipmentId, data); });
  }
  try {
    var h = amcvnFind_('ChinaShipments', 'ShipmentID', shipmentId);
    if (!h) return err_('Không tìm thấy lô hàng.');
    if (String(h.Status) !== 'RECEIVING') {
      return err_('Lô hàng chưa nhận hoặc đã IQC xong.');
    }

    var inputItems = data.items || [];
    if (!inputItems.length) return err_('Chưa có dòng nào để xác nhận IQC.');

    var inputMap = {};
    inputItems.forEach(function (x) { inputMap[String(x.ShipmentItemID)] = x; });

    var shipmentItems = sheetToObjects_('ChinaShipmentItems')
      .filter(function (x) { return String(x.ShipmentID) === String(shipmentId); });

    var pendingMoves = sheetToObjects_('StockMovements').filter(function (m) {
      return String(m.SourceType) === 'ChinaShipment'
        && String(m.SourceID) === String(shipmentId)
        && String(m.Status) === 'Chờ IQC';
    });

    var now = new Date();
    var wh = whById_(h.WarehouseID) || whDefault_();
    var totalAccepted = 0, totalRejected = 0, totalDiffValue = 0;
    var moveUpdates = {};
    var locationRows = [];
    var productUpdates = {};

    shipmentItems.forEach(function (row) {
      var input = inputMap[String(row.ShipmentItemID)];
      if (!input) return;

      var accepted = Math.max(0, toNumber(input.AcceptedQty));
      var rejected = Math.max(0, toNumber(input.RejectedQty));
      var total = accepted + rejected;
      var receivedQty = toNumber(row.ReceivedQty);

      if (Math.abs(total - receivedQty) > 0.0001) {
        throw new Error('Dòng ' + (row.LineNo || row.ShipmentItemID)
          + ': SL đạt (' + accepted + ') + SL lỗi (' + rejected + ') phải bằng SL đã nhận (' + receivedQty + ').');
      }

      var unitCost = toNumber(row.UnitCost);
      totalAccepted += accepted;
      totalRejected += rejected;
      totalDiffValue += (total - toNumber(row.SentQty)) * unitCost;

      updateRowById('ChinaShipmentItems', 'ShipmentItemID', row.ShipmentItemID, {
        AcceptedQty: accepted,
        RejectedQty: rejected,
        IQCStatus: rejected <= 0 ? 'PASS' : (accepted > 0 ? 'PARTIAL' : 'FAIL'),
        LocationCode: String(input.LocationCode || row.LocationCode || '').trim(),
        LotNo: String(input.LotNo || row.LotNo || '').trim(),
        NCRNo: String(input.NCRNo || '').trim(),
        Notes: input.Notes !== undefined ? String(input.Notes || '').trim() : row.Notes,
        UpdatedAt: now
      });

      // Tìm movement tương ứng: cùng ProductID, cùng SL đã nhận, đang Chờ IQC
      var move = pendingMoves.filter(function (m) {
        return String(m.ProductID) === String(row.ProductID)
          && Math.abs(toNumber(m.QuantityIn) - receivedQty) < 0.0001;
      })[0];
      if (move) {
        if (accepted > 0) {
          moveUpdates[move.MovementID] = {
            QuantityIn: accepted,
            Status: 'Đã nhận',
            Notes: (move.Notes || '').replace('CHỜ IQC', 'IQC đạt ' + accepted + (rejected > 0 ? ' / lỗi ' + rejected : ''))
          };
          productUpdates[row.ProductID] = true;

          // Ghi MaterialLocations cho SL đạt
          if (input.LocationCode && String(input.LocationCode).trim()) {
            locationRows.push({
              LocationID: generateId('LOC'),
              WarehouseID: wh.WarehouseID,
              WarehouseName: wh.WarehouseName,
              LocationCode: String(input.LocationCode).trim().toUpperCase(),
              ProductID: row.ProductID,
              SKU: row.SKU || '',
              ProductName: row.ProductName,
              LotNo: String(input.LotNo || row.LotNo || '').trim(),
              Quantity: accepted,
              ReceiptItemID: '',
              Status: 'ACTIVE',
              UpdatedAt: now,
              UpdatedBy: getUser_(),
              RequirementID: '',
              ProjectID: h.ProjectID || '',
              MachineID: '',
              ModuleID: '',
              InventoryMode: 'COMMON'
            });
          }
        } else {
          // Toàn bộ lỗi → đánh dấu Lỗi IQC, không cộng tồn
          moveUpdates[move.MovementID] = {
            QuantityIn: 0,
            Status: 'Lỗi IQC',
            Notes: (move.Notes || '').replace('CHỜ IQC', 'IQC lỗi toàn bộ ' + rejected)
          };
        }
      }
    });

    if (Object.keys(moveUpdates).length) {
      updateRowsById_('StockMovements', 'MovementID', moveUpdates);
      recalculateProductStocks_(Object.keys(productUpdates));
    }
    if (locationRows.length) {
      appendRows('MaterialLocations', locationRows);
    }

    var totalSent = toNumber(h.TotalSentQty);
    var diffTotal = toNumber(h.TotalReceivedQty) - totalSent;
    var finalStatus = Math.abs(diffTotal) <= 0.0001 ? 'RECEIVED' : 'DIFF';

    updateRowById('ChinaShipments', 'ShipmentID', shipmentId, {
      Status: finalStatus,
      IQCCompletedAt: now,
      IQCCompletedBy: getUser_(),
      Notes: (h.Notes || '') + ' | IQC đạt ' + totalAccepted + (totalRejected > 0 ? ', lỗi ' + totalRejected : ''),
      UpdatedAt: now
    });

    writeAudit_('Xác nhận IQC hàng TQ', 'ChinaShipment', shipmentId,
      h.ShipmentCode + ' · đạt ' + totalAccepted + ' · lỗi ' + totalRejected);

    return ok_({
      ShipmentID: shipmentId,
      TotalAccepted: totalAccepted,
      TotalRejected: totalRejected,
      Status: finalStatus
    }, 'Đã xác nhận IQC: đạt ' + totalAccepted + (totalRejected > 0 ? ', lỗi ' + totalRejected : '') + '. Vật tư đạt đã vào tồn kho.');
  } catch (e) { return err_(e.message); }
}

