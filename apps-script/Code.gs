    if (!VAT_DOC_CTX_) return;
    updateRowById(sheetName, idKey, idValue, {
      InvoiceNo: VAT_DOC_CTX_.InvoiceNo, InvoiceSerial: VAT_DOC_CTX_.InvoiceSerial, InvoiceDate: VAT_DOC_CTX_.InvoiceDate
