/**
 * Bổ sung cột "Loại mặt hàng" (ProductType) cho sheet Sản phẩm cũ và backfill dữ liệu.
 * FIX: bản cũ dò header theo tên TIẾNG ANH ('ProductType'/'Category') trong khi sheet ghi header
 * TIẾNG VIỆT -> luôn trượt, tạo thêm cột rác và gán sai. Nay dò theo VỊ TRÍ trong SCHEMA
 * (đúng cách sheetToObjects_ đọc dữ liệu), an toàn và không mất dữ liệu cũ.
 */
function migrateProductTypes() {
  try {
    var sh = getSheet_('Products');
    var keys = SCHEMA.Products;
    var typeCol = keys.indexOf('ProductType') + 1;
    var catCol = keys.indexOf('Category') + 1;
    if (typeCol === 0) return err_('SCHEMA.Products chưa có ProductType');
    // Ghi lại dòng header đầy đủ theo SCHEMA (thêm cột mới nếu thiếu, không đụng dữ liệu).
    sh.getRange(1, 1, 1, keys.length).setValues([viHeaders_('Products')]);
    var lastRow = sh.getLastRow();
    if (lastRow < 2) return ok_({ updated: 0 }, 'Sheet Sản phẩm chưa có dữ liệu');
    var types = readSheetRange_(sh, 2, typeCol, lastRow - 1, 1);
    var cats = readSheetRange_(sh, 2, catCol, lastRow - 1, 1);
    var changed = 0;
    for (var i = 0; i < types.length; i++) {
      var t = normalizeProductType_(types[i][0]);
      if (!t) { // ô trống -> suy ra từ Nhóm hàng
        t = (normalizeProductType_(cats[i][0]) === 'Service') ? 'Service' : 'Product';
        changed++;
      }
      types[i][0] = t;
    }
    sh.getRange(2, typeCol, types.length, 1).setValues(types);
    return ok_({ updated: changed }, 'Đã gán "Loại mặt hàng" cho ' + changed + ' sản phẩm (tổng ' + types.length + ')');
  } catch (e) { return err_(e.message); }
}

