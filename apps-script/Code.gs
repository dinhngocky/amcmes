var PRICE_CALC_TYPES = ['WeightQtyUnitPrice', 'QtyUnitPrice', 'ManualPrice', 'CustomFormula'];
var COST_CALC_TYPES = ['ManualAmount', 'WeightQtyUnitPrice', 'QtyUnitPrice', 'ProductQtyUnitPrice', 'PercentOfSubtotal', 'CustomFormula'];
var COST_GROUPS = ['Nguyên vật liệu', 'Nhân công', 'Sơn', 'Gia công', 'Vận chuyển', 'Phụ phí', 'Khác'];
var FORMULA_VARS_ = ['weight', 'quantity', 'unitPrice', 'productionQty', 'subtotal'];

/* Bộ tính biểu thức AN TOÀN: tự tokenize + parse đệ quy, KHÔNG dùng eval / new Function.
   Chỉ chấp nhận số, + - * / ( ) và đúng 5 biến trong whitelist. */
function evalFormula_(expr, vars) {
  var s = String(expr == null ? '' : expr).trim();
  if (!s) throw new Error('Công thức trống.');
  if (s.length > 200) throw new Error('Công thức quá dài (tối đa 200 ký tự).');
  vars = vars || {};

  var tokens = [], i = 0;
  while (i < s.length) {
    var c = s.charAt(i);
    if (c === ' ' || c === '\t') { i++; continue; }
    if ('+-*/()'.indexOf(c) >= 0) { tokens.push({ t: c }); i++; continue; }
    if ((c >= '0' && c <= '9') || c === '.') {
      var j = i;
      while (j < s.length && ((s.charAt(j) >= '0' && s.charAt(j) <= '9') || s.charAt(j) === '.')) j++;
      var num = Number(s.slice(i, j));
      if (!isFinite(num)) throw new Error('Số không hợp lệ trong công thức: "' + s.slice(i, j) + '"');
      tokens.push({ t: 'num', v: num }); i = j; continue;
    }
    if (/[A-Za-z_]/.test(c)) {
      var k = i;
      while (k < s.length && /[A-Za-z0-9_]/.test(s.charAt(k))) k++;
      var name = s.slice(i, k);
