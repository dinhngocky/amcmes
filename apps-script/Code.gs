function setupMil4MModule() {
  var changed = [];
  try { changed = ensureSchemaColumns_(true); } catch (e) { console.warn('[setupMil4MModule]', (e && e.message) || String(e)); }
  try { getSheet_('Mil4MIssues'); } catch (e) { console.warn('[setupMil4MModule]', (e && e.message) || String(e)); }
  var msg = 'Đã bật module MIL 4M + Issue từ Chat.';
  if (changed.length) msg = 'Đã bổ sung cột cho: ' + changed.join(', ') + '. ' + msg;
  try { SpreadsheetApp.getUi().alert(msg); } catch (e) { console.warn('[setupMil4MModule]', (e && e.message) || String(e)); }
  return ok_({ changed: changed }, msg);
}
