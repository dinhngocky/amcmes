/* ---------------------------- Helpers ---------------------------- */

function chatTruthy_(v) {
  return v === true || String(v).toLowerCase() === 'true' || String(v) === '1' || String(v) === 'yes';
}

function chatCanPost_(user) {
  if (!user) return false;
  if (authIsAdmin_(user)) return true;
  return authAllowed_(user, 'production', 'c');
}

function chatCanDelete_(user) {
  return user && authIsAdmin_(user);
}

function chatSeverity_(v) {
  var s = String(v || 'INFO').toUpperCase();
  if (['INFO', 'WARNING', 'CRITICAL'].indexOf(s) < 0) return 'INFO';
  return s;
}

function chatReportType_(v) {
  var s = String(v || 'CHAT').toUpperCase();
  if (['CHAT', 'REPORT', 'INCIDENT'].indexOf(s) < 0) return 'CHAT';
  return s;
}

/**
 * Lấy hoặc tạo folder ảnh chat cho 1 máy.
 */
function chatFolderFor_(machineCode) {
  var rootName = 'AMCVN Chat Images';
  var folders = DriveApp.getFoldersByName(rootName);
  var root = folders.hasNext() ? folders.next() : DriveApp.createFolder(rootName);
  var code = String(machineCode || 'UNKNOWN').replace(/[^A-Za-z0-9_\-]/g, '_');
  var subs = root.getFoldersByName(code);
  var sub = subs.hasNext() ? subs.next() : root.createFolder(code);
  return sub;
}

/**
 * Upload 1 ảnh chat. Trả về URL.
 * data: { data: base64 (có hoặc không prefix), name, mimeType }
 */
function uploadChatImage(file, machineCode, __locked) {
  if (!__locked) {
    return withMutationLock_([], function () { return uploadChatImage(file, machineCode, true); });
  }
  var driveFile = null;
  try {
    if (!file || !file.data) return err_('Không có dữ liệu ảnh.', 'ERR_CHAT_IMG');
    var image = validateImageUpload_(file);
    var folder = chatFolderFor_(machineCode);
    var stamp = Utilities.formatDate(new Date(), getTz_(), 'yyyyMMdd_HHmmss');
    var safeName = 'chat_' + stamp + '_' + Math.floor(Math.random() * 10000) + '.' + image.name.split('.').pop();
    var blob = Utilities.newBlob(image.bytes, image.mime, safeName);
    driveFile = folder.createFile(blob);
    if (MUTATION_CTX_) MUTATION_CTX_.undo.push(function () { driveFile.setTrashed(true); });
    driveFile.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    return ok_({
      url: 'https://drive.google.com/thumbnail?id=' + driveFile.getId() + '&sz=w1200',
      viewUrl: driveFile.getUrl(),
      id: driveFile.getId()
    }, 'Đã tải ảnh lên');
  } catch (e) {
    if (driveFile) {
      try { driveFile.setTrashed(true); } catch (cleanup) { console.warn('[uploadChatImage cleanup]', cleanup.message); }
    }
    return err_(e, 'ERR_CHAT_IMG');
  }
}

/**
 * Chuẩn bị dữ liệu tin nhắn để trả về FE.
 */
function chatRowToDto_(row, userReadAt) {
  var images = [];
  try {
    if (row.ImageUrls) images = JSON.parse(row.ImageUrls);
    if (!Array.isArray(images)) images = [];
  } catch (e) { images = []; }

  var createdMs = row.CreatedAt ? new Date(row.CreatedAt).getTime() : 0;
  var isUnread = userReadAt ? (createdMs > userReadAt) : true;

  return {
    ReportID: row.ReportID,
    Content: String(row.Content || ''),
    ReportType: chatReportType_(row.ReportType),
    Severity: chatSeverity_(row.Severity),
    StageCode: String(row.StageCode || ''),
    StageName: String(row.StageName || ''),
    ModuleID: String(row.ModuleID || ''),
    ModuleName: String(row.ModuleName || ''),
    ImageUrls: images,
    ImageCount: toNumber(row.ImageCount) || images.length,
    ReporterID: String(row.ReporterID || ''),
    ReporterName: String(row.ReporterName || ''),
    ReporterAvatar: String(row.ReporterAvatar || ''),
    IsDeleted: chatTruthy_(row.IsDeleted),
    DeletedBy: String(row.DeletedBy || ''),
    DeletedAt: String(row.DeletedAt || ''),
    CreatedAt: String(row.CreatedAt || ''),
    CreatedMs: createdMs,
    IsUnread: isUnread
  };
}

/**
 * Tính khóa lưu "last read at" cho mỗi user-máy.
 */
function chatReadKey_(userId, machineId) {
  return 'CHAT_READ_' + String(userId || '').replace(/[^A-Za-z0-9_]/g, '_') + '_' + String(machineId || '').replace(/[^A-Za-z0-9_]/g, '_');
}

function chatGetReadAt_(userId, machineId) {
  try {
    var v = PropertiesService.getScriptProperties().getProperty(chatReadKey_(userId, machineId));
    return v ? Number(v) : 0;
  } catch (e) { return 0; }
}

function chatSetReadAt_(userId, machineId, atMs) {
  try {
    var props = PropertiesService.getScriptProperties();
    var key = chatReadKey_(userId, machineId);
    trackMutationProperty_(key);
    props.setProperty(key, String(atMs || Date.now()));
    return true;
  } catch (e) {
    console.warn('[chatSetReadAt_]', (e && e.message) || String(e));
    return false;
  }
}

/* ---------------------------- API ---------------------------- */

/**
 * Lấy feed tin nhắn của 1 máy.
 * options: { beforeMs, limit }
 *   beforeMs: lấy tin nhắn CŨ HƠN mốc này (cho infinite scroll)
 *   limit: số tin (mặc định 30)
 *
 * Trả về: { rows, hasMore, latestMs, unreadCount }
 */
function getDailyReports(machineId, options) {
  try {
    if (!machineId) return err_('Thiếu mã máy.', 'ERR_CHAT');
    var machine = amcvnFind_('Machines', 'MachineID', machineId);
    if (!machine) return err_('Không tìm thấy máy.', 'ERR_CHAT_MACHINE');

    options = options || {};
    var limit = Math.min(100, Math.max(5, toNumber(options.limit) || CHAT_PAGE_SIZE_));
    var beforeMs = toNumber(options.beforeMs) || 0;
    var user = AUTH_CTX_;
    var userId = user ? user.UserID : '';

    // Lấy tất cả tin chưa xóa của máy này
    var all = sheetToObjects_('DailyReports').filter(function (r) {
      return String(r.MachineID) === String(machineId) && !chatTruthy_(r.IsDeleted);
    });

    // Sắp xếp mới nhất trước
    all.sort(function (a, b) {
      var ta = a.CreatedAt ? new Date(a.CreatedAt).getTime() : 0;
      var tb = b.CreatedAt ? new Date(b.CreatedAt).getTime() : 0;
      return tb - ta;
    });

    var latestMs = all.length ? (all[0].CreatedAt ? new Date(all[0].CreatedAt).getTime() : 0) : 0;

    // Lọc theo beforeMs nếu có
    var filtered = beforeMs > 0
      ? all.filter(function (r) {
          var t = r.CreatedAt ? new Date(r.CreatedAt).getTime() : 0;
          return t < beforeMs;
        })
      : all;

    var page = filtered.slice(0, limit);
    var hasMore = filtered.length > limit;

    // Read at
    var readAt = chatGetReadAt_(userId, machineId);
    var rows = page.map(function (r) { return chatRowToDto_(r, readAt); });

    // Đếm chưa đọc
    var unreadCount = 0;
    all.forEach(function (r) {
      var t = r.CreatedAt ? new Date(r.CreatedAt).getTime() : 0;
      if (t > readAt) unreadCount++;
    });

    return ok_({
      rows: rows,
      hasMore: hasMore,
      latestMs: latestMs,
      unreadCount: unreadCount,
      machineCode: machine.MachineCode
    });
  } catch (e) {
    return err_(e, 'ERR_CHAT_LIST');
  }
}

/**
 * Gửi tin nhắn mới.
 * data: {
 *   MachineID,
 *   Content,
 *   ReportType,   // CHAT | REPORT | INCIDENT
 *   Severity,     // INFO | WARNING | CRITICAL
 *   StageCode, StageName,
 *   ModuleID, ModuleName,
 *   Images: [{ url, id }]  // đã upload trước đó
 * }
 */
function postDailyReport(data) {
  data = data || {};
  if (!data.__locked) {
    return runLocked_(data, '__locked', ['DailyReports'], function () { return postDailyReport(data); });
  }
  try {
    var user = AUTH_CTX_;
    if (!user) return err_('Phiên đăng nhập đã hết hạn.', 'ERR_AUTH');
    if (!chatCanPost_(user)) {
      return err_('Bạn không có quyền gửi tin nhắn vào máy này.', 'ERR_CHAT_PERM');
    }
    var machine = amcvnFind_('Machines', 'MachineID', data.MachineID);
    if (!machine) return err_('Không tìm thấy máy.', 'ERR_CHAT_MACHINE');

    var content = String(data.Content || '').trim();
    var images = Array.isArray(data.Images) ? data.Images : [];
    if (!content && !images.length) {
      return err_('Tin nhắn phải có nội dung hoặc ảnh.', 'ERR_CHAT_EMPTY');
    }
    if (content.length > 2000) {
      return err_('Nội dung tối đa 2000 ký tự.', 'ERR_CHAT_LONG');
    }
    if (images.length > CHAT_MAX_IMAGES_) {
      return err_('Tối đa ' + CHAT_MAX_IMAGES_ + ' ảnh 1 tin nhắn.', 'ERR_CHAT_IMG_MAX');
    }

    var imageUrls = images.map(function (x) {
      return typeof x === 'string' ? x : (x && x.url) || '';
    }).filter(function (x) { return x; });

    var now = new Date();
    var row = {
      ReportID: generateId('CHAT'),
      MachineID: machine.MachineID,
      ProjectID: machine.ProjectID || '',
      Content: content,
      ReportType: chatReportType_(data.ReportType),
      Severity: chatSeverity_(data.Severity),
      StageCode: String(data.StageCode || '').trim(),
      StageName: String(data.StageName || '').trim(),
      ModuleID: String(data.ModuleID || '').trim(),
      ModuleName: String(data.ModuleName || '').trim(),
      ImageUrls: JSON.stringify(imageUrls),
      ImageCount: imageUrls.length,
      ReporterID: String(user.UserID || ''),
      ReporterName: String(user.FullName || user.Username || 'Người dùng'),
      ReporterAvatar: '',
      IsDeleted: false,
      DeletedBy: '',
      DeletedAt: '',
      CreatedAt: now
    };
    appendRow('DailyReports', row);

    // Ghi audit chỉ khi là báo cáo sự cố
    if (row.ReportType === 'INCIDENT' || row.Severity === 'CRITICAL') {
      writeAudit_('Báo cáo sự cố', 'DailyReport', row.ReportID,
        machine.MachineCode + ' · ' + row.Severity + ' · ' + content.slice(0, 120));
    }

    return ok_({ ReportID: row.ReportID, row: chatRowToDto_(row, 0) }, 'Đã gửi tin nhắn');
  } catch (e) {
    return err_(e, 'ERR_CHAT_POST');
  }
}

/**
 * Xóa mềm tin nhắn. Chỉ Admin.
 */
function deleteDailyReport(reportId) {
  return withMutationLock_(['DailyReports'], function () {
    try {
      var user = AUTH_CTX_;
      if (!user) return err_('Phiên đăng nhập đã hết hạn.', 'ERR_AUTH');
      if (!chatCanDelete_(user)) {
        return err_('Chỉ quản trị viên mới được xóa tin nhắn.', 'ERR_CHAT_DELETE_PERM');
      }
      var row = amcvnFind_('DailyReports', 'ReportID', reportId);
      if (!row) return err_('Không tìm thấy tin nhắn.', 'ERR_CHAT_NOT_FOUND');

      updateRowById('DailyReports', 'ReportID', reportId, {
        IsDeleted: true,
        DeletedBy: String(user.UserID || ''),
        DeletedAt: new Date()
      });
      writeAudit_('Xóa tin nhắn', 'DailyReport', reportId, String(row.Content || '').slice(0, 80));
      return ok_(null, 'Đã xóa tin nhắn');
    } catch (e) {
      return err_(e, 'ERR_CHAT_DELETE');
    }
  });
}

/**
 * Đánh dấu đã đọc tất cả tin của máy này (cập nhật readAt = now).
 * Gọi khi user mở popup chat.
 */
function markChatRead(machineId) {
  try {
    var user = AUTH_CTX_;
    if (!user) return err_('Phiên đăng nhập đã hết hạn.', 'ERR_AUTH');
    if (!machineId) return err_('Thiếu mã máy.', 'ERR_CHAT');

    // Lấy tin mới nhất của máy
    var all = sheetToObjects_('DailyReports').filter(function (r) {
      return String(r.MachineID) === String(machineId) && !chatTruthy_(r.IsDeleted);
    });
    var latestMs = 0;
    all.forEach(function (r) {
      var t = r.CreatedAt ? new Date(r.CreatedAt).getTime() : 0;
      if (t > latestMs) latestMs = t;
    });

    chatSetReadAt_(user.UserID, machineId, latestMs || Date.now());
    return ok_({ latestMs: latestMs }, 'Đã đánh dấu đã đọc');
  } catch (e) {
    return err_(e, 'ERR_CHAT_READ');
  }
}

/**
 * Đếm số tin chưa đọc của TẤT CẢ các máy user có quyền xem.
 * Dùng cho badge tổng trên menu hoặc popup chọn máy.
 */
function getChatUnreadSummary() {
  try {
    var user = AUTH_CTX_;
    if (!user) return err_('Phiên đăng nhập đã hết hạn.', 'ERR_AUTH');

    var machines = sheetToObjects_('Machines');
    var reports = sheetToObjects_('DailyReports').filter(function (r) {
      return !chatTruthy_(r.IsDeleted);
    });

    // Gom theo máy
    var byMachine = {};
    reports.forEach(function (r) {
      var mid = String(r.MachineID || '');
      if (!mid) return;
      var t = r.CreatedAt ? new Date(r.CreatedAt).getTime() : 0;
      if (!byMachine[mid] || t > byMachine[mid]) byMachine[mid] = t;
    });

    var total = 0;
    var perMachine = [];
    machines.forEach(function (m) {
      var lastMsgAt = byMachine[m.MachineID] || 0;
      if (!lastMsgAt) return;
      var readAt = chatGetReadAt_(user.UserID, m.MachineID);
      var count = reports.filter(function (r) {
        if (String(r.MachineID) !== String(m.MachineID)) return false;
        var t = r.CreatedAt ? new Date(r.CreatedAt).getTime() : 0;
        return t > readAt;
      }).length;
      if (count > 0) {
        total += count;
        perMachine.push({
          MachineID: m.MachineID,
          MachineCode: m.MachineCode,
          MachineName: m.MachineName,
          UnreadCount: count,
          LastMsgAt: lastMsgAt
        });
      }
    });

    perMachine.sort(function (a, b) { return b.LastMsgAt - a.LastMsgAt; });

    return ok_({ total: total, perMachine: perMachine });
  } catch (e) {
    return err_(e, 'ERR_CHAT_UNREAD');
  }
}

/**
 * Đếm nhanh cho 1 máy cụ thể.
 */
function getChatUnreadCount(machineId) {
  try {
    var user = AUTH_CTX_;
    if (!user) return err_('Phiên đăng nhập đã hết hạn.', 'ERR_AUTH');
    if (!machineId) return err_('Thiếu mã máy.', 'ERR_CHAT');
    var readAt = chatGetReadAt_(user.UserID, machineId);
    var count = sheetToObjects_('DailyReports').filter(function (r) {
      if (String(r.MachineID) !== String(machineId)) return false;
      if (chatTruthy_(r.IsDeleted)) return false;
      var t = r.CreatedAt ? new Date(r.CreatedAt).getTime() : 0;
      return t > readAt;
    }).length;
    return ok_({ machineId: machineId, unreadCount: count });
  } catch (e) {
    return err_(e, 'ERR_CHAT_UNREAD');
  }
}

/**
 * Thống kê nhanh tin nhắn của máy trong N ngày gần nhất.
 */
function getDailyReportStats(machineId, days) {
  try {
    if (!machineId) return err_('Thiếu mã máy.', 'ERR_CHAT');
    days = Math.max(1, Math.min(365, toNumber(days) || 30));
    var fromMs = Date.now() - days * 86400000;

    var all = sheetToObjects_('DailyReports').filter(function (r) {
      return String(r.MachineID) === String(machineId)
        && !chatTruthy_(r.IsDeleted)
        && (r.CreatedAt ? new Date(r.CreatedAt).getTime() : 0) >= fromMs;
    });

    var total = all.length;
    var incidents = 0, warnings = 0, withImages = 0;
    var byReporter = {};
    all.forEach(function (r) {
      if (chatReportType_(r.ReportType) === 'INCIDENT') incidents++;
      if (chatSeverity_(r.Severity) === 'WARNING') warnings++;
      if (toNumber(r.ImageCount) > 0) withImages++;
      var rn = String(r.ReporterName || '');
      if (rn) byReporter[rn] = (byReporter[rn] || 0) + 1;
    });

    var topReporters = Object.keys(byReporter).map(function (k) {
      return { name: k, count: byReporter[k] };
    }).sort(function (a, b) { return b.count - a.count; }).slice(0, 5);

    return ok_({
      days: days,
      total: total,
      incidents: incidents,
      warnings: warnings,
      withImages: withImages,
      topReporters: topReporters
    });
  } catch (e) {
    return err_(e, 'ERR_CHAT_STATS');
  }
}

