/**
 * Migrate 1 sheet:
 * - Nếu sheet chưa có: tạo sheet + header.
 * - Nếu sheet đã có: đọc dữ liệu hiện có, map lại theo header cũ,
 *   rồi ghi lại theo schema mới.
 * - Không thêm data mới.
 */
function _nxMigrateOneSheetStructureOnly_(ss, name) {
  var schema = SCHEMA[name];
  if (!schema || !schema.length) {
    return {
      sheet: name,
      ok: true,
      message: 'Bỏ qua vì không có SCHEMA'
    };
  }

  var tab = resolveSheetName_(name);
  var sh = ss.getSheetByName(tab) || ss.getSheetByName(name);
  var created = false;
  var renamed = false;

  if (!sh) {
    sh = ss.insertSheet(tab);
    created = true;
  } else if (sh.getName() !== tab) {
    sh.setName(tab);
    renamed = true;
  }

  var oldLastRow = sh.getLastRow();
  var oldLastCol = sh.getLastColumn();
  var oldHeaders = [];
  var oldData = [];

  if (oldLastRow >= 1 && oldLastCol >= 1) {
    oldHeaders = readSheetRange_(sh, 1, 1, 1, oldLastCol)[0];
  }

  if (oldLastRow >= 2 && oldLastCol >= 1) {
    oldData = readSheetRange_(sh, 2, 1, oldLastRow - 1, oldLastCol);
  }

  var oldKeys = oldHeaders.map(function (h) {
    return _nxHeaderToInternalKey_(name, h);
  });

  var migratedRows = oldData.map(function (row) {
    return schema.map(function (key) {
      var idx = oldKeys.indexOf(key);
      return idx >= 0 ? row[idx] : '';
    });
  });

  // Đảm bảo sheet đủ cột/dòng trước khi ghi.
  if (sh.getMaxColumns() < schema.length) {
    sh.insertColumnsAfter(sh.getMaxColumns(), schema.length - sh.getMaxColumns());
  }

  if (sh.getMaxRows() < migratedRows.length + 1) {
    sh.insertRowsAfter(sh.getMaxRows(), migratedRows.length + 1 - sh.getMaxRows());
  }

  // Clear nội dung + format nhưng dữ liệu đã nằm trong migratedRows.
  sh.clearContents();
  sh.clearFormats();

  // Header tiếng Việt chuẩn theo schema hiện tại.
  var headers = viHeaders_(name);
  sh.getRange(1, 1, 1, schema.length).setValues([headers]);

  // Ghi lại dữ liệu cũ theo schema mới.
  if (migratedRows.length) {
    sh.getRange(2, 1, migratedRows.length, schema.length).setValues(migratedRows);
  }

  // Format đẹp.
  formatSheetHeader_(sh, name);
  applySheetFormatting_(sh, schema);

  // Xóa các filter view/filter lỗi nếu có thì applySheetFormatting_ đã xử lý filter thường.
  try { sh.setFrozenRows(1); } catch (e0) { console.warn('[_nxMigrateOneSheetStructureOnly_]', (e0 && e0.message) || String(e0)); }
  try { sh.setHiddenGridlines(true); } catch (e1) { console.warn('[_nxMigrateOneSheetStructureOnly_]', (e1 && e1.message) || String(e1)); }
  try { sh.setTabColor(SETUP_TAB_COLORS[name] || CONFIG.HEADER_BG); } catch (e2) { console.warn('[_nxMigrateOneSheetStructureOnly_]', (e2 && e2.message) || String(e2)); }

  return {
    sheet: tab,
    internalName: name,
    ok: true,
    created: created,
    renamed: renamed,
    rowsKept: migratedRows.length,
    columns: schema.length,
    message: created
      ? 'Đã tạo sheet mới, không thêm demo data'
      : 'Đã cập nhật cấu trúc, giữ ' + migratedRows.length + ' dòng dữ liệu'
  };
}

/**
 * Convert header cũ về key nội bộ.
 * Hỗ trợ:
 * - Header đang là tiếng Anh nội bộ, ví dụ ProductID.
 * - Header đang là tiếng Việt, ví dụ Mã Hệ Thống.
 */
function _nxHeaderToInternalKey_(sheetName, header) {
  var h = String(header == null ? '' : header).trim();
  if (!h) return '';

  var schema = SCHEMA[sheetName] || [];
  if (schema.indexOf(h) >= 0) return h;

  var labels = LABELS[sheetName] || {};
  for (var key in labels) {
    if (String(labels[key]).trim() === h) return key;
  }

  // Fallback: trả lại header gốc.
  return h;
}

