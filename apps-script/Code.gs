/* ===================== AMCVN SPRINT 5: QUALITY & FAT ===================== */
function qualityOpen_(row) {
  return ['CLOSED', 'CANCELLED'].indexOf(amcvnText_(row && row.Status).toUpperCase()) < 0;
}
function qualitySeverity_(value) {
  var severity = amcvnText_(value).toUpperCase() || 'MINOR';
  return ['CRITICAL', 'MAJOR', 'MINOR'].indexOf(severity) >= 0 ? severity : '';
}
function qualityValidateModule_(machineId, moduleId) {
  if (!moduleId) return true;
  var row = amcvnFind_('MachineModules', 'ModuleID', moduleId);
  return !!row && String(row.MachineID) === String(machineId);
}
function qualityFatReadinessFromRows_(machineId, allIssues, allChecks, allPunches) {
  var issues = (allIssues || []).filter(function (x) { return String(x.MachineID) === String(machineId); });
  var checks = (allChecks || []).filter(function (x) { return String(x.MachineID) === String(machineId); });
  var punches = (allPunches || []).filter(function (x) { return String(x.MachineID) === String(machineId); });
  var openIssues = issues.filter(qualityOpen_);
  var blockingIssues = openIssues.filter(function (x) { return ['CRITICAL', 'MAJOR'].indexOf(amcvnText_(x.Severity).toUpperCase()) >= 0; });
  var failedChecks = checks.filter(function (x) { return amcvnText_(x.Result).toUpperCase() === 'FAIL'; });
  var pendingChecks = checks.filter(function (x) { return ['PASS', 'NA'].indexOf(amcvnText_(x.Result).toUpperCase()) < 0; });
  var openPunches = punches.filter(qualityOpen_);
  var blockingPunches = openPunches.filter(function (x) { return ['CRITICAL', 'MAJOR'].indexOf(amcvnText_(x.Severity).toUpperCase()) >= 0; });
  var reasons = [];
  if (!checks.length) reasons.push('chưa có FAT checklist');
  if (blockingIssues.length) reasons.push(blockingIssues.length + ' lỗi chất lượng Critical/Major đang mở');
  if (failedChecks.length) reasons.push(failedChecks.length + ' mục FAT không đạt');
  if (pendingChecks.length) reasons.push(pendingChecks.length + ' mục FAT chưa hoàn tất');
  if (blockingPunches.length) reasons.push(blockingPunches.length + ' punch Critical/Major chưa đóng');
  var qualityStatus = blockingIssues.length ? 'BLOCKED' : (openIssues.length ? 'OPEN' : 'PASS');
  var fatStatus = !checks.length ? 'NOT_STARTED' : (failedChecks.length ? 'FAILED' : (pendingChecks.length ? 'IN_PROGRESS' : (openPunches.length ? 'PUNCH_LIST' : 'PASS')));
  return { ready: reasons.length === 0, reasons: reasons, qualityStatus: qualityStatus, fatStatus: fatStatus,
    totalChecks: checks.length, passedChecks: checks.filter(function (x) { return ['PASS', 'NA'].indexOf(amcvnText_(x.Result).toUpperCase()) >= 0; }).length,
    pendingChecks: pendingChecks.length, failedChecks: failedChecks.length, openIssues: openIssues.length,
    blockingIssues: blockingIssues.length, openPunches: openPunches.length, blockingPunches: blockingPunches.length };
}
function qualityFatReadiness_(machineId) {
  return qualityFatReadinessFromRows_(machineId, sheetToObjects_('QualityIssues'), sheetToObjects_('FATChecks'), sheetToObjects_('FATPunchList'));
}
function qualityFatRefreshMachine_(machineId) {
  var machine = amcvnFind_('Machines', 'MachineID', machineId); if (!machine) return;
  var gate = qualityFatReadiness_(machineId), upd = { QualityStatus: gate.qualityStatus, FATStatus: gate.fatStatus, UpdatedAt: new Date() };
  if (gate.blockingIssues || gate.failedChecks || gate.blockingPunches) upd.RiskLevel = 'HIGH';
  updateRowById('Machines', 'MachineID', machineId, upd);
  refreshProjectRollup_(machine.ProjectID);
  return gate;
}
function getMachineQualityFAT(machineId) {
  try {
    var machine = amcvnFind_('Machines', 'MachineID', machineId); if (!machine) return err_('Không tìm thấy máy.', 'ERR_NOT_FOUND');
    var project = amcvnFind_('Projects', 'ProjectID', machine.ProjectID);
    var modules = sheetToObjects_('MachineModules').filter(function (x) { return String(x.MachineID) === String(machineId); });
    var issues = sheetToObjects_('QualityIssues').filter(function (x) { return String(x.MachineID) === String(machineId); });
    var checks = sheetToObjects_('FATChecks').filter(function (x) { return String(x.MachineID) === String(machineId); });
    var punches = sheetToObjects_('FATPunchList').filter(function (x) { return String(x.MachineID) === String(machineId); });
    issues.sort(function (a, b) { return (qualityOpen_(b) ? 1 : 0) - (qualityOpen_(a) ? 1 : 0) || new Date(b.OpenedAt || 0) - new Date(a.OpenedAt || 0); });
    checks.sort(function (a, b) { return amcvnText_(a.Category).localeCompare(amcvnText_(b.Category)); });
    punches.sort(function (a, b) { return (qualityOpen_(b) ? 1 : 0) - (qualityOpen_(a) ? 1 : 0) || new Date(a.TargetDate || 0) - new Date(b.TargetDate || 0); });
    return ok_({ machine: machine, project: project, modules: modules, issues: issues, checks: checks, punches: punches,
