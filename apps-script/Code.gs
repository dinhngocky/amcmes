/**
 * DANH SÁCH TRẮNG: chỉ chạy đúng những hàm của ứng dụng.
 *
 * Trước đây cổng tra hàm bằng eval(fn) rồi mới xét quyền, mà hàm không gắn phân hệ
 * thì mặc định ai cũng gọi được. Hậu quả: một cái tên như "eval" cũng tra ra được và
 * lọt qua hàng rào -> bất kỳ ai có tài khoản đều chạy được mã tùy ý trên máy chủ,
 * dưới quyền của chủ bảng tính. Chặn bằng danh sách đen thì luôn sót (Function,
 * Object, JSON, DriveApp...), nên phải đảo lại thành danh sách trắng.
 */
function fnAllowed_(fn) {
  return !!FN_MODULE_[fn] || FN_OPEN_.indexOf(fn) >= 0;
}

/* ============================================================================
 *  CỔNG DUY NHẤT: mọi lời gọi từ giao diện đều đi qua đây
 * ========================================================================== */
function apiCall(token, fn, args, userAgent) {
  installPerformanceV223_();
  try {
    var user = authSession_(token, userAgent);
    if (!user) {
      return err_('Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.', 'ERR_AUTH');
    }
    AUTH_CTX_ = user;
    fn = String(fn || '');
    args = args || [];
    // Chỉ chấp nhận tên hàm hợp lệ, không phải hàm nội bộ (kết thúc bằng gạch dưới).
    if (!fn || !/^[A-Za-z][A-Za-z0-9_]*$/.test(fn) || FN_BLOCKED_.indexOf(fn) >= 0
      || fn.charAt(fn.length - 1) === '_') {
      return err_('Lời gọi không hợp lệ.', 'ERR_FN');
    }
    // Phải nằm trong danh sách trắng MỚI được tra ra hàm — xem chú thích ở fnAllowed_.
    if (!fnAllowed_(fn)) {
      return err_('Lời gọi không hợp lệ.', 'ERR_FN');
    }
    var f = null;
    try { f = (typeof globalThis !== 'undefined') ? globalThis[fn] : this[fn]; } catch (e0) { console.warn('[apiCall]', (e0 && e0.message) || String(e0));  f = null; }

    if (typeof f !== 'function') {
      return err_('Không tìm thấy hàm server "' + fn + '". Hãy Deploy lại WebApp bằng bản mới nhất.', 'ERR_FN');
    }
    var need = authRequirement_(fn, args);
    if (!authAllowed_(user, need.module, need.action)) {
      return err_('Bạn không có quyền ' + authActionLabel_(need.action) + ' ở phần "'
          + authModuleLabel_(need.module) + '". Liên hệ quản trị viên nếu cần mở quyền.', 'ERR_PERM');
    }
    if (need.extra && !authHasExtra_(user, need.extra)) {
      return err_('Bạn chưa được cấp quyền "' + authExtraLabel_(need.extra) + '". Liên hệ quản trị viên nếu cần mở quyền.', 'ERR_PERM');
    }

    if(PROC_COST_FNS_.indexOf(fn)>=0&&!authHasExtra_(user,'cost'))return err_('Bạn chưa có quyền xem giá vốn/báo giá.','ERR_PERM');
    AUDIT_MODULE_ = need.module;
    AUDIT_WRITTEN_ = false;
    var invoke = function () {
      var result = f.apply(null, args);
      if (need.action !== 'v' && result && result.success && !AUDIT_WRITTEN_) auditAuto_(fn, args, result, need.module);
      return result;
    };
    var perfStartedV223 = Date.now();
    var out = need.action === 'v' ? invoke() : withMutationLock_([], invoke);
    perfLogRequestV223_(fn, perfStartedV223, out);
    if (out === undefined || out === null) out = ok_(null);

    // NHẬT KÝ: mọi thao tác GHI thành công đều để lại dấu vết. Hàm nào tự ghi nhật ký
    // riêng rồi (writeAudit_) thì bỏ qua để không có 2 dòng cho cùng một việc.

    // Không có quyền xem giá vốn -> gỡ sạch giá vốn/lợi nhuận khỏi dữ liệu gửi về máy khách.
    if (out && out.data && !authHasExtra_(user, 'cost')) out.data = stripCostDeep_(out.data);
    if (!out || typeof out !== 'object' || typeof out.success !== 'boolean') return ok_(out);
    return out.success ? ok_(out.data, out.message) : Object.assign(err_(out.message, out.errorCode), { data: out.data == null ? null : sanitizeForClient_(out.data) });
  } catch (e) {
    return err_(e && e.message ? e.message : e, 'ERR_API');
  }
}

function authModuleLabel_(id) {
  for (var i = 0; i < AUTH_MODULES_.length; i++) if (AUTH_MODULES_[i].id === id) return AUTH_MODULES_[i].label;
  return id;
}
function authActionLabel_(a) {
  if (a === 'c') return 'thêm mới';
  if (a === 'e') return 'sửa';
  if (a === 'd') return 'xóa';
  return 'xem';
}
function authExtraLabel_(id) {
  for (var i = 0; i < AUTH_EXTRAS_.length; i++) if (AUTH_EXTRAS_[i].id === id) return AUTH_EXTRAS_[i].label;
  return id;
}

/** Các trường mang thông tin giá vốn / lợi nhuận — gỡ khi người dùng không được xem. */
var COST_FIELDS_ = ['CostPrice', 'UnitCost', 'CostAmount', 'Profit', 'LineCost', 'LineProfit',
  'StockValue', 'MaterialCost', 'ActualMaterialCost', 'LaborCost', 'OverheadCost', 'MoneyCostTotal',
  'cost', 'costTotal', 'totalCost', 'profit', 'totalProfit', 'grossProfit', 'margin', 'profitMargin',
  'costValue', 'stockValue', 'inventoryValue',
  // Bảng điều khiển & báo cáo trả lợi nhuận dưới tên khác — vẫn là số liệu giá vốn.
  'netProfitAfterExpense', 'profitImpact', 'netProfit', 'operatingProfit',
  // Giá trị tồn trong báo cáo Nhập - Xuất - Tồn (tính theo giá vốn).
  'OpenValue', 'InValue', 'OutValue', 'CloseValue',
  'openValue', 'inValue', 'outValue', 'closeValue'];
function stripCostDeep_(value, depth) {
  depth = depth || 0;
  if (depth > 8 || value === null || value === undefined) return value;
  if (Array.isArray(value)) {
    return value.map(function (v) { return stripCostDeep_(v, depth + 1); });
  }
  if (typeof value === 'object') {
    var out = {};
    Object.keys(value).forEach(function (k) {
      if (COST_FIELDS_.indexOf(k) >= 0) return;   // bỏ hẳn khóa nhạy cảm
      out[k] = stripCostDeep_(value[k], depth + 1);
    });
    return out;
  }
  return value;
}

/* ---------- Màn hình quản lý người dùng ---------- */
function getAuthMeta() {
  try {
    return ok_({
      modules: authEnabledModules_(),
      actions: AUTH_ACTIONS_,
      extras: AUTH_EXTRAS_,
      roles: AUTH_ROLES_.map(function (r) {
        return { name: r.name, desc: r.desc, perms: authFormatPerms_(r.perms) };
      })
    });
  } catch (e) { return err_(e.message); }
}

/** Số quản trị viên đang hoạt động, KHÔNG tính người có mã truyền vào. */
function authCountActiveAdmins_(exceptId) {
  var n = 0;
  authUsers_().forEach(function (u) {
    if (exceptId && String(u.UserID) === String(exceptId)) return;
    if (authIsAdmin_(u) && !authIsLocked_(u) && u.Username && u.PasswordHash) n++;
  });
  return n;
}

function updateUser(userId, data) {
  try {
    data = data || {};
    var user = authFindUserById_(userId);
    if (!user) return err_('Không tìm thấy người dùng.');
    var updates = {};
    if (data.FullName !== undefined) updates.FullName = String(data.FullName || '');
    if (data.Email !== undefined) updates.Email = String(data.Email || '');
    if (data.Role !== undefined) updates.Role = String(data.Role || 'Nhân viên');
    if (data.Status !== undefined) updates.Status = String(data.Status || 'Đang hoạt động');
    if (data.Permissions !== undefined) {
      updates.Permissions = authNormalizePerms_(data.Permissions, data.Role || user.Role);
    }
    if (data.Username !== undefined) {
      var uname = authNormUsername_(data.Username);
      if (uname) {
        var other = authFindUserByLogin_(uname);
        if (other && String(other.UserID) !== String(user.UserID)) {
          return err_('Tên đăng nhập "' + uname + '" đã có người dùng.');
        }
      }
      updates.Username = uname;
    }
    if (data.Password) {
      var pw = String(data.Password);
      if (pw.length < 4) return err_('Mật khẩu phải từ 4 ký tự trở lên.');
      var salt = authNewSalt_();
      updates.PasswordSalt = salt;
      updates.PasswordHash = authHash_(pw, salt);
    }
    // Không để hệ thống mất sạch quản trị viên.
    if (authIsAdmin_(user)) {
      var stillAdmin = (updates.Permissions === undefined)
        ? true : authIsAdmin_({ Permissions: updates.Permissions });
      var stillActive = !authIsLocked_({ Status: (updates.Status !== undefined ? updates.Status : user.Status) });
      if ((!stillAdmin || !stillActive) && authCountActiveAdmins_(user.UserID) === 0) {
        return err_('Đây là quản trị viên duy nhất còn hoạt động — không thể hạ quyền hoặc khóa.');
      }
    }
    updateRowById('Users', 'UserID', user.UserID, updates);
    writeAudit_('Cập nhật người dùng', 'Users', user.UserID, updates.Username || user.Username || '');
    var merged = {};
    Object.keys(user).forEach(function (k) { merged[k] = user[k]; });
    Object.keys(updates).forEach(function (k) { merged[k] = updates[k]; });
    return ok_(publicUser_(merged), 'Đã cập nhật người dùng');
  } catch (e) { return err_(e.message); }
}

function resetUserPassword(userId, newPassword) {
  try {
    var user = authFindUserById_(userId);
    if (!user) return err_('Không tìm thấy người dùng.');
    if (!user.Username) return err_('Người này chưa có tên đăng nhập — hãy đặt tên đăng nhập trước.');
    var pw = String(newPassword || '');
    if (pw.length < 4) return err_('Mật khẩu phải từ 4 ký tự trở lên.');
    var salt = authNewSalt_();
    updateRowById('Users', 'UserID', user.UserID, { PasswordSalt: salt, PasswordHash: authHash_(pw, salt) });
    writeAudit_('Đặt lại mật khẩu', 'Users', user.UserID, user.Username || '');
    return ok_(null, 'Đã đặt lại mật khẩu cho ' + (user.FullName || user.Username));
  } catch (e) { return err_(e.message); }
}

function deleteUser(userId) {
  try {
    var user = authFindUserById_(userId);
    if (!user) return err_('Không tìm thấy người dùng.');
    if (AUTH_CTX_ && String(AUTH_CTX_.UserID) === String(user.UserID)) {
      return err_('Không thể xóa chính tài khoản bạn đang đăng nhập.');
    }
    if (authIsAdmin_(user) && authCountActiveAdmins_(user.UserID) === 0) {
      return err_('Đây là quản trị viên duy nhất còn hoạt động — không thể xóa.');
    }
    deleteRowById('Users', 'UserID', user.UserID);
    writeAudit_('Xóa người dùng', 'Users', user.UserID, user.Username || '');
    return ok_(null, 'Đã xóa người dùng');
  } catch (e) { return err_(e.message); }
}

/** Người dùng tự đổi mật khẩu của mình (ai đăng nhập cũng làm được). */
function changeMyPassword(oldPassword, newPassword) {
  try {
    var me = AUTH_CTX_;
    if (!me) return err_('Phiên đăng nhập đã hết hạn.', 'ERR_AUTH');
    if (!me.PasswordHash) return err_('Tài khoản này chưa đặt mật khẩu.');
    if (authHash_(oldPassword, me.PasswordSalt) !== String(me.PasswordHash)) {
      return err_('Mật khẩu hiện tại không đúng.');
    }
    var pw = String(newPassword || '');
    if (pw.length < 4) return err_('Mật khẩu mới phải từ 4 ký tự trở lên.');
    var salt = authNewSalt_();
    updateRowById('Users', 'UserID', me.UserID, { PasswordSalt: salt, PasswordHash: authHash_(pw, salt) });
    writeAudit_('Đổi mật khẩu', 'Users', me.UserID, me.Username || '');
    return ok_(null, 'Đã đổi mật khẩu');
  } catch (e) { return err_(e.message); }
}

/* ============================================================================
 *  CHẠY TAY MỘT LẦN TRONG APPS SCRIPT: setupAuthModule()
 *  - Bổ sung 5 cột mới cho sheet "Người dùng" (không đụng dữ liệu cũ).
 *  - Tạo tài khoản quản trị đầu tiên nếu chưa ai đăng nhập được.
 * ========================================================================== */
function setupAuthModule() {
  var changed = [];
  try { changed = ensureSchemaColumns_(true); } catch (e) { console.warn('[setupAuthModule]', (e && e.message) || String(e)); }
  var list = authUsers_();
  var hasLogin = list.some(function (u) { return u.Username && u.PasswordHash; });
  var msg;
  if (hasLogin) {
    msg = 'Cấu trúc đã sẵn sàng. Hệ thống đã có tài khoản đăng nhập — không tạo thêm.';
  } else {
    var salt = authNewSalt_();
    var adminPerms = authFormatPerms_(authRolePerms_('Quản trị'));
    var target = list.filter(function (u) {
      return String(u.Role || '').trim().toLowerCase() === 'quản trị';
    })[0] || list[0];
    if (target) {
      updateRowById('Users', 'UserID', target.UserID, {
        Username: 'admin', PasswordSalt: salt, PasswordHash: authHash_('123456', salt),
        Role: 'Quản trị', Status: 'Đang hoạt động', Permissions: adminPerms
      });
    } else {
      appendRow('Users', {
        UserID: generateId('U'), FullName: 'Quản trị viên', Email: '', Role: 'Quản trị',
        Status: 'Đang hoạt động', CreatedAt: new Date(), Username: 'admin',
        PasswordHash: authHash_('123456', salt), PasswordSalt: salt,
        Permissions: adminPerms, LastLoginAt: ''
      });
    }
    msg = 'Đã bật đăng nhập. Tài khoản quản trị: admin / 123456 — hãy đổi mật khẩu ngay sau lần đăng nhập đầu tiên.';
  }
  if (changed.length) msg = 'Đã bổ sung cột: ' + changed.join(', ') + '. ' + msg;
  try { SpreadsheetApp.getUi().alert(msg); } catch (e) { console.warn('[setupAuthModule]', (e && e.message) || String(e)); }
  return ok_({ changed: changed }, msg);
}
/**
 * CỨU HỘ khi chính quản trị viên quên mật khẩu: chạy tay trong Apps Script.
 * Đặt lại mật khẩu tài khoản quản trị đầu tiên về 123456 (không đụng dữ liệu khác).
 */
function resetAdminPassword() {
  var admin = null;
  authUsers_().forEach(function (u) {
    if (!admin && authIsAdmin_(u) && u.Username) admin = u;
  });
  if (!admin) {
    var msg0 = 'Chưa có tài khoản quản trị nào có tên đăng nhập. Hãy chạy setupAuthModule() trước.';
    try { SpreadsheetApp.getUi().alert(msg0); } catch (e) { console.warn('[resetAdminPassword]', (e && e.message) || String(e)); }
    return err_(msg0);
  }
  var salt = authNewSalt_();
  updateRowById('Users', 'UserID', admin.UserID, {
    PasswordSalt: salt, PasswordHash: authHash_('123456', salt), Status: 'Đang hoạt động'
  });
  var msg = 'Đã đặt lại mật khẩu cho "' + (admin.Username || admin.FullName) + '" về 123456 — hãy đổi ngay sau khi đăng nhập.';
  try { SpreadsheetApp.getUi().alert(msg); } catch (e) { console.warn('[resetAdminPassword]', (e && e.message) || String(e)); }
  return ok_({ username: admin.Username }, msg);
}

