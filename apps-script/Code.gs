function getInitialData() {
  try {
    // Lần mở đầu tiên sau khi cập nhật bản mới: tự bổ sung các cột còn thiếu trên Sheet.
    try { ensureSchemaColumns_(false); } catch (e) { console.warn('[getInitialData]', (e && e.message) || String(e)); }
    try { migrateAmcvnBrand_(); } catch (eBrand) { console.warn('[getInitialData]', (eBrand && eBrand.message) || String(eBrand)); }
    var settings = {};
    cachedSheetToObjects_('Settings').forEach(function (s) { settings[s.Key] = s.Value; });
    return ok_({
      settings: settings,
      appName: CONFIG.APP_NAME,
      brand: CONFIG.BRAND,
      logoUrl: settings.LogoUrl || CONFIG.LOGO_URL || '',
      currency: settings.Currency || CONFIG.CURRENCY,
      defaultVat: toNumber(settings.DefaultVAT !== undefined && settings.DefaultVAT !== null && settings.DefaultVAT !== '' ? settings.DefaultVAT : CONFIG.DEFAULT_VAT),
      users: cachedSheetToObjects_('Users').map(publicUser_)
    });
  } catch (e) { return err_(e.message); }
}

/**
 * Tải GỘP toàn bộ danh sách hay dùng trong 1 lần gọi -> frontend nạp sẵn cache,
 * chuyển tab gần như tức thì (thay vì mỗi tab 1 vòng gọi server riêng).
 */
function getBootstrap() {
  try {
    // Nạp sẵn theo QUYỀN của người đang đăng nhập: phân hệ nào không được xem thì
    // không gửi dữ liệu về máy khách (chạy tay từ Apps Script thì lấy đủ như cũ).
    var can = function (mod) {
      if (typeof AUTH_CTX_ === 'undefined' || !AUTH_CTX_) return true;
      return authAllowed_(AUTH_CTX_, mod, 'view');
    };
    var seeSales = can('sales'), seePurchase = can('purchasing'), seeStock = can('inventory');
    return ok_({
      products: (seeStock || seeSales || can('production')) ? getProducts().data : [],
      customers: seeSales ? getCustomers().data : [],
      suppliers: seePurchase ? getSuppliers().data : [],
      sales: seeSales ? getSalesOrders().data : [],
      purchases: seePurchase ? getPurchaseOrders().data : [],
      quotes: seeSales ? getQuotes().data : [],
      returns: seeSales ? getSalesReturns().data : [],
      checks: seeStock ? getInventoryChecks().data : [],
      purchaseReturns: seePurchase ? getPurchaseReturns().data : [],
      financeModal: (CONFIG.ENABLE_FINANCE && can('finance')) ? getFinanceModalData().data : null
    });
  } catch (e) { return err_(e.message); }
}

/**
 * MỞ APP CHỈ BẰNG MỘT LỜI GỌI.
 *
 * Trước đây lúc mở app phải gọi 3 lượt riêng: cấu hình chung, dữ liệu nạp sẵn, rồi
 * số liệu màn hình chính. Mỗi lượt là một LẦN CHẠY RIÊNG của Apps Script, mà bộ nhớ
 * đệm sheet chỉ sống trong một lần chạy — nên cùng những sheet đó bị đọc lại 3 lượt.
 * Gộp vào một lần chạy thì mỗi sheet chỉ đọc đúng một lần, đồng thời bớt được 2 vòng
 * đi-về qua mạng.
 *
 * Hỏng phần nào thì phần đó trả về null, không kéo đổ cả lời gọi — giao diện tự gọi
 * lại lẻ phần còn thiếu.
 */
function getBootAll(locDashboard) {
  try {
    var init = null, boot = null, dash = null;
    try { var a = getInitialData(); if (a && a.success) init = a.data; } catch (e) { console.warn('[getBootAll]', (e && e.message) || String(e));  }
    try { var b = getBootstrapMaster_(); if (b && b.success) boot = b.data; } catch (e) { console.warn('[getBootAll]', (e && e.message) || String(e));  }
    // locDashboard === false nghĩa là người này không vào màn hình chính -> khỏi tính cho tốn.
    if (locDashboard && typeof locDashboard === 'object') {
      try { var c = getDashboardData(locDashboard); if (c && c.success) dash = c.data; } catch (e) { console.warn('[getBootAll]', (e && e.message) || String(e));  }
    }
    return ok_({ init: init, bootstrap: boot, dashboard: dash });
  } catch (e) { return err_(e.message); }
}

/**
 * Dữ liệu liên thông của 1 sản phẩm: NCC ưa thích (tổng hợp từ lịch sử mua) + đơn đặt mua đang mở.
 */
function getProductRelations(productId) {
  try {
    var items = sheetToObjects_('PurchaseItems').filter(function (i) { return i.ProductID === productId; });
    var poMap = {}; sheetToObjects_('PurchaseOrders').forEach(function (p) { poMap[p.PurchaseID] = p; });
    var agg = {}, openPOs = [];
    items.forEach(function (it) {
      var po = poMap[it.PurchaseID]; if (!po) return;
      var key = po.SupplierID || po.SupplierName || '—';
      if (!agg[key]) agg[key] = { SupplierID: po.SupplierID || '', SupplierName: po.SupplierName || '—', times: 0, totalQty: 0, totalValue: 0, lastCost: 0, lastDate: '' };
      var a = agg[key]; a.times++; a.totalQty += toNumber(it.Quantity); a.totalValue += toNumber(it.Quantity) * toNumber(it.UnitCost);
      if (!a.lastDate || (po.PurchaseDate && new Date(po.PurchaseDate) > new Date(a.lastDate))) { a.lastDate = po.PurchaseDate; a.lastCost = toNumber(it.UnitCost); }
      if (!isCompleted_(po.Status) && !isCancelled_(po.Status)) {
        openPOs.push({ PurchaseID: po.PurchaseID, SupplierName: po.SupplierName, Status: po.Status, Quantity: toNumber(it.Quantity), UnitCost: toNumber(it.UnitCost), PurchaseDate: po.PurchaseDate, DueDate: po.DueDate });
      }
    });
    var suppliers = Object.keys(agg).map(function (k) { return agg[k]; }).sort(function (a, b) { return b.times - a.times || b.totalQty - a.totalQty; });
    return ok_({ suppliers: suppliers, openPOs: openPOs });
  } catch (e) { return err_(e.message); }
}

function periodBounds_(period, now) {
  now = now || new Date();
  var tz = getTz_();
  
  function getMidnight(dateObj, offsetDays) {
    var d = new Date(dateObj.getTime() + (offsetDays || 0) * 86400000);
    var ymd = Utilities.formatDate(d, tz, "yyyy-MM-dd");
    var offset = Utilities.formatDate(d, tz, "Z");
    return new Date(ymd + "T00:00:00" + offset);
  }

  if (typeof period === 'object' && period) {
    var cs = period.start ? parseDate_(period.start) : null;
    var ce = period.end ? parseDate_(period.end) : null;
    if (cs && !isNaN(cs.getTime()) && ce && !isNaN(ce.getTime())) {
      cs = getMidnight(cs, 0); ce = getMidnight(ce, 1);
      var span = Math.max(86400000, ce.getTime() - cs.getTime());
      return {
        start: cs, end: ce,
        prevStart: new Date(cs.getTime() - span), prevEnd: cs,
        label: 'Từ ' + Utilities.formatDate(cs, tz, 'dd/MM/yyyy') + ' đến ' + Utilities.formatDate(new Date(ce.getTime() - 86400000), tz, 'dd/MM/yyyy'),
        groupBy: period.groupBy || 'auto'
      };
    }
    period = period.period || 'month';
  }
  var dayMs = 86400000, start, end, prevStart, prevEnd, label;
  if (period === 'today') {
    start = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    end = new Date(start.getTime() + dayMs);
    prevStart = new Date(start.getTime() - dayMs); prevEnd = start; label = 'Hôm nay';
  } else if (period === '7days') {
    end = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
    start = new Date(end.getTime() - 7 * dayMs);
    prevEnd = start; prevStart = new Date(start.getTime() - 7 * dayMs); label = '7 ngày qua';
  } else if (period === 'quarter') {
    var q = Math.floor(now.getMonth() / 3);
    start = new Date(now.getFullYear(), q * 3, 1);
    end = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
    prevStart = new Date(now.getFullYear(), q * 3 - 3, 1); prevEnd = start;
    label = 'Quý ' + (q + 1) + '/' + now.getFullYear();
  } else {
    start = new Date(now.getFullYear(), now.getMonth(), 1);
    end = new Date(now.getFullYear(), now.getMonth() + 1, 1);
    prevStart = new Date(now.getFullYear(), now.getMonth() - 1, 1); prevEnd = start;
    label = 'Tháng ' + (now.getMonth() + 1) + '/' + now.getFullYear();
  }
  return { start: start, end: end, prevStart: prevStart, prevEnd: prevEnd, label: label, groupBy: 'auto' };
}

function pctDelta_(cur, prev) {
  if (!prev) return cur > 0 ? 100 : 0;
  return Math.round((cur - prev) / prev * 1000) / 10;
}

function aggSalesRange_(sales, returns, start, end) {
  var rev = 0, prof = 0, cost = 0, orders = 0, custRev = {};
  sales.forEach(function (s) {
    // BỎ QUA NỢ CŨ VÀ ĐƠN HỦY KHỎI TỔNG DOANH THU/LỢI NHUẬN
    if (isCancelled_(s.Status) || s.Status === 'NO_CU') return; 
    
    var d = parseDate_(s.SalesDate);
    if (!d || isNaN(d.getTime()) || d < start || d >= end) return;
    rev += netRevenue_(s); prof += toNumber(s.Profit); cost += toNumber(s.CostAmount); orders++;
    var key = s.CustomerName || s.CustomerID || 'Khách lẻ';
    custRev[key] = (custRev[key] || 0) + netRevenue_(s);
  });
  returns.forEach(function (r) {
    var d = parseDate_(r.ReturnDate);
    if (!d || isNaN(d.getTime()) || d < start || d >= end) return;
    rev -= toNumber(r.TotalAmount); prof -= (toNumber(r.TotalAmount) - toNumber(r.CostAmount));
  });
  var topCustomers = Object.keys(custRev).map(function (k) { return { name: k, revenue: Math.round(custRev[k]) }; })
    .sort(function (a, b) { return b.revenue - a.revenue; }).slice(0, 5);
  return {
    revenue: Math.round(rev), profit: Math.round(prof), cost: Math.round(cost), orders: orders,
    aov: orders ? Math.round(rev / orders) : 0, margin: rev > 0 ? Math.round(prof / rev * 1000) / 10 : 0,
    topCustomers: topCustomers
  };
}

function chartSalesRange_(sales, returns, start, end, groupBy) {
  groupBy = groupBy || 'auto';
  var dayMs = 86400000, spanDays = Math.max(1, Math.round((end - start) / dayMs));
  if (groupBy === 'auto') groupBy = spanDays <= 1 ? 'hour' : (spanDays <= 45 ? 'day' : (spanDays <= 180 ? 'week' : 'month'));
  var buckets = {}, labels = [], keys = [];
  function keyFor(d) {
    if (groupBy === 'hour') return Utilities.formatDate(d, getTz_(), 'HH:00');
    if (groupBy === 'day') return Utilities.formatDate(d, getTz_(), 'dd/MM');
    if (groupBy === 'week') {
      var copy = new Date(d.getFullYear(), d.getMonth(), d.getDate());
      var diff = (copy.getDay() + 6) % 7;
      copy.setDate(copy.getDate() - diff);
      return 'Tuần ' + Utilities.formatDate(copy, getTz_(), 'dd/MM');
    }
    return Utilities.formatDate(d, getTz_(), 'MM/yyyy');
  }
  function ensure(k) { if (!buckets[k]) { buckets[k] = { revenue: 0, cost: 0, profit: 0, sales: [], returns: [] }; keys.push(k); } return buckets[k]; }
  function seedBuckets_() {
    var d = new Date(start.getTime());
    if (groupBy === 'hour') {
      d.setMinutes(0, 0, 0);
      while (d < end) { ensure(keyFor(d)); d = new Date(d.getTime() + 3600000); }
    } else if (groupBy === 'day') {
      d = new Date(d.getFullYear(), d.getMonth(), d.getDate());
      while (d < end) { ensure(keyFor(d)); d.setDate(d.getDate() + 1); }
    } else if (groupBy === 'week') {
      var diff = (d.getDay() + 6) % 7;
      d = new Date(d.getFullYear(), d.getMonth(), d.getDate() - diff);
      while (d < end) { ensure(keyFor(d)); d.setDate(d.getDate() + 7); }
    } else {
      d = new Date(d.getFullYear(), d.getMonth(), 1);
      while (d < end) { ensure(keyFor(d)); d.setMonth(d.getMonth() + 1); }
    }
  }
  seedBuckets_();
  sales.forEach(function (s) {
    // BỎ QUA NỢ CŨ VÀ ĐƠN HỦY KHỎI BIỂU ĐỒ DOANH THU
    if (isCancelled_(s.Status) || s.Status === 'NO_CU') return; 
    
    var d = parseDate_(s.SalesDate);
    if (!d || isNaN(d.getTime()) || d < start || d >= end) return;
    var b = ensure(keyFor(d)); b.revenue += netRevenue_(s); b.cost += toNumber(s.CostAmount); b.profit += toNumber(s.Profit);
    b.sales.push({
      id: s.SalesID, date: s.SalesDate, customer: s.CustomerName, total: toNumber(s.TotalAmount),
      cost: toNumber(s.CostAmount), discount: toNumber(s.Discount), vat: toNumber(s.VAT),
      shipping: toNumber(s.ShippingFee), profit: toNumber(s.Profit)
    });
  });
  returns.forEach(function (r) {
    var d = parseDate_(r.ReturnDate);
    if (!d || isNaN(d.getTime()) || d < start || d >= end) return;
    var b = ensure(keyFor(d)); b.revenue -= toNumber(r.TotalAmount); b.cost -= toNumber(r.CostAmount); b.profit -= (toNumber(r.TotalAmount) - toNumber(r.CostAmount));
    b.returns.push({
      id: r.ReturnID, date: r.ReturnDate, customer: r.CustomerName, total: toNumber(r.TotalAmount),
      cost: toNumber(r.CostAmount), profitImpact: -(toNumber(r.TotalAmount) - toNumber(r.CostAmount))
    });
  });
  labels = keys;
  return {
    labels: labels,
    revenue: labels.map(function (k) { return Math.round(buckets[k].revenue); }),
    cost: labels.map(function (k) { return Math.round(buckets[k].cost); }),
    profit: labels.map(function (k) { return Math.round(buckets[k].profit); }),
    details: labels.reduce(function (m, k) {
      m[k] = {
        revenue: Math.round(buckets[k].revenue), cost: Math.round(buckets[k].cost),
        profit: Math.round(buckets[k].profit), sales: buckets[k].sales, returns: buckets[k].returns
      };
      return m;
    }, {}),
    groupBy: groupBy
  };
}

function getDashboardData(period) {
  period = period || 'month';
  return cachedPayload_('dash:' + period, function () { return buildDashboardData_(period); });
}

function buildDashboardData_(period) {
  try {
    ensureTradingItemSnapshotSchema_();
    period = period || 'month';
    var products = cachedSheetToObjects_('Products');
    var sales = cachedSheetToObjects_('SalesOrders');
    var purchases = cachedSheetToObjects_('PurchaseOrders');
    var purchaseItems = cachedSheetToObjects_('PurchaseItems');
    var salesItems = cachedSheetToObjects_('SalesItems');
    // Bỏ đọc 'StockMovements' ở đây: sổ này thường lớn nhất hệ thống mà Dashboard KHÔNG dùng tới.
    // Đọc thừa làm mỗi lần mở Dashboard chậm thêm rất nhiều.

    var returns = cachedSheetToObjects_('SalesReturns');
    var productMap = {}; products.forEach(function (p) { productMap[p.ProductID] = p; });
    var revenue = 0, profit = 0, cost = 0, receivable = 0, payable = 0, stockValue = 0;
    // Mua vào & hàng trả lại NCC (dùng cho KPI "Tổng mua thuần" và dòng hoạt động gần đây)
    var purchaseGross = 0;
    purchases.forEach(function (p) {
      if (!isCancelled_(normalizeStatus_(p.Status, ''))) purchaseGross += toNumber(p.TotalAmount);
    });
    var prDash = prReturnStats_(null, null);
    var purchaseReturnTotal = prDash.total;
    
    sales.forEach(function (s) {
      receivable += toNumber(s.ReceivableAmount); // LUÔN CỘNG CÔNG NỢ PHẢI THU
      
      // BỎ QUA DOANH THU/CHI PHÍ/LỢI NHUẬN CỦA NỢ CŨ & ĐƠN HỦY
      if (!isCancelled_(s.Status) && s.Status !== 'NO_CU') {
          revenue += netRevenue_(s);
          profit += toNumber(s.Profit);
          cost += toNumber(s.CostAmount);
      }
    });
    
    // Trừ doanh thu/lợi nhuận do hàng trả lại (doanh thu thuần)
    returns.forEach(function (r) {
      revenue -= toNumber(r.TotalAmount);
      cost -= toNumber(r.CostAmount);   // giá vốn cũng phải trừ, nếu không thẻ Giá vốn cao hơn thực tế
      profit -= (toNumber(r.TotalAmount) - toNumber(r.CostAmount));
    });
    
    purchases.forEach(function (p) { 
        payable += toNumber(p.PayableAmount); // LUÔN CỘNG CÔNG NỢ PHẢI TRẢ
    });
    
    var allServicePurchaseExpense = servicePurchaseExpense_(purchases, purchaseItems, productMap);
    cost += allServicePurchaseExpense;
    profit -= allServicePurchaseExpense;
    products.forEach(function (p) { stockValue += toNumber(p.StockValue); });

    var b = periodBounds_(period);
    var financeTx = [], cashAccounts = [], budgetAlerts = [];
    if (CONFIG.ENABLE_FINANCE) {
      try { financeTx = cachedSheetToObjects_('FinanceTransactions'); } catch (ignore) { console.warn('[buildDashboardData_]', (ignore && ignore.message) || String(ignore));  financeTx = []; }
      try { cashAccounts = cachedSheetToObjects_('CashAccounts'); } catch (ignore2) { console.warn('[buildDashboardData_]', (ignore2 && ignore2.message) || String(ignore2));  cashAccounts = []; }
      try { budgetAlerts = cachedSheetToObjects_('BudgetLines').filter(function (l) { return l.Status === 'Sắp vượt' || l.Status === 'Vượt ngân sách'; }); } catch (ignore3) { console.warn('[buildDashboardData_]', (ignore3 && ignore3.message) || String(ignore3));  budgetAlerts = []; }
    }
    var financeInPeriod = financeTx.filter(function (t) {
      return String(t.Status || '') === 'Paid' && financeInRange_(t.TransactionDate, b.start, b.end);
    });
    var operatingRows = financeInPeriod.filter(function (t) {
      return t.Direction === 'Out' && t.TransactionType === 'Expense';
    });
    var operatingExpense = operatingRows.reduce(function (s, t) { return s + toNumber(t.Amount); }, 0);
    var cashIn = financeInPeriod.filter(function (t) { return t.Direction === 'In'; }).reduce(function (s, t) { return s + toNumber(t.Amount); }, 0);
    var cashOut = financeInPeriod.filter(function (t) { return t.Direction === 'Out'; }).reduce(function (s, t) { return s + toNumber(t.Amount); }, 0);
    var totalCashBalance = cashAccounts.filter(function (a) { return String(a.Status || 'Đang hoạt động') !== 'Ngừng dùng'; })
      .reduce(function (s, a) { return s + toNumber(a.CurrentBalance); }, 0);
    var expenseByCategory = {};
    operatingRows.forEach(function (t) {
      var key = t.CategoryName || 'Chi phí khác';
      expenseByCategory[key] = (expenseByCategory[key] || 0) + toNumber(t.Amount);
    });
    var operatingExpenseCategories = Object.keys(expenseByCategory).map(function (key) {
      return { name: key, value: expenseByCategory[key] };
    }).sort(function (a, b) { return b.value - a.value; });
    var latestOperatingExpenses = operatingRows.slice().sort(function (a, b) {
      return (parseDate_(b.TransactionDate) || 0) - (parseDate_(a.TransactionDate) || 0);
    }).slice(0, 5);
    var chart = chartSalesRange_(sales, returns, b.start, b.end, b.groupBy);

    // Cơ cấu nhóm hàng (theo StockValue)
    var byCat = {};
    products.forEach(function (p) {
      var c = p.Category || 'Khác';
      byCat[c] = (byCat[c] || 0) + toNumber(p.StockValue);
    });

    // Top sản phẩm bán chạy (theo Quantity)
    var saleInPeriod = {};
    sales.forEach(function (s) {
      if (isCancelled_(s.Status) || s.Status === 'NO_CU') return; // KHÔNG TÍNH NỢ CŨ VÀO SẢN PHẨM BÁN CHẠY
      var d = parseDate_(s.SalesDate);
      if (d && !isNaN(d.getTime()) && d >= b.start && d < b.end) saleInPeriod[s.SalesID] = true;
    });
    var qtyByProduct = {};
    salesItems.forEach(function (it) {
      if (!saleInPeriod[it.SalesID]) return;
      var key = it.ProductName || it.ProductID;
      if (!qtyByProduct[key]) qtyByProduct[key] = { name: key, qty: 0, revenue: 0 };
      qtyByProduct[key].qty += toNumber(it.Quantity);
      qtyByProduct[key].revenue += toNumber(it.LineRevenue);
    });
    var topProducts = Object.keys(qtyByProduct).map(function (k) { return qtyByProduct[k]; })
      .sort(function (a, b) { return b.qty - a.qty; }).slice(0, 5);

    // Cảnh báo tồn
    var lowStock = products.filter(function (p) { return p.Status === 'Sắp hết'; }).length;
    var outStock = products.filter(function (p) { return p.Status === 'Hết hàng'; }).length;
    var overStock = products.filter(function (p) { return p.Status === 'Vượt tồn'; }).length;

    // Cảnh báo công nợ quá hạn
    var today = new Date(); today.setHours(0, 0, 0, 0);
    var overdueReceivable = sales.filter(function (s) {
      var due = parseDate_(s.DueDate);
      return toNumber(s.ReceivableAmount) > 0 && due && due < today;
    }).length;
    var overduePayable = purchases.filter(function (p) {
      var due = parseDate_(p.DueDate);
      return toNumber(p.PayableAmount) > 0 && due && due < today;
    }).length;

    // Hoạt động gần đây (Lọc bỏ NO_CU khỏi hoạt động bán/mua hàng gần đây)
    var activities = [];
    var validSales = sales.filter(function(s) { return s.Status !== 'NO_CU'; });
    var validPurchases = purchases.filter(function(p) { return p.Status !== 'NO_CU'; });

    validSales.slice(-6).forEach(function (s) {
      activities.push({ type: 'sale', icon: 'point_of_sale', title: 'Hóa đơn ' + s.SalesID + ' — ' + s.CustomerName, amount: toNumber(s.TotalAmount), date: s.SalesDate });
    });
    validPurchases.slice(-6).forEach(function (p) {
      activities.push({ type: 'purchase', icon: 'local_shipping', title: 'Phiếu mua ' + p.PurchaseID + ' — ' + p.SupplierName, amount: toNumber(p.TotalAmount), date: p.PurchaseDate });
    });
    prDash.list.slice(-6).forEach(function (r) {
      activities.push({
        type: 'purchaseReturn', icon: 'assignment_return',
        title: 'Trả hàng NCC ' + r.PurchaseReturnID + ' — ' + (r.SupplierName || ''),
        amount: -toNumber(r.TotalAmount), date: r.ReturnDate
      });
    });
    activities.sort(function (a, b) { return (parseDate_(b.date) || 0) - (parseDate_(a.date) || 0); });
    activities = activities.slice(0, 8);

    // KPI theo kỳ + so sánh kỳ trước
    var cur = aggSalesRange_(sales, returns, b.start, b.end);
    var prev = aggSalesRange_(sales, returns, b.prevStart, b.prevEnd);
    var curServiceExpense = servicePurchaseExpense_(purchases, purchaseItems, productMap, b.start, b.end);
    var prevServiceExpense = servicePurchaseExpense_(purchases, purchaseItems, productMap, b.prevStart, b.prevEnd);
    cur.servicePurchaseExpense = Math.round(curServiceExpense);
    cur.cost += Math.round(curServiceExpense); cur.profit -= Math.round(curServiceExpense);
    cur.margin = cur.revenue > 0 ? Math.round(cur.profit / cur.revenue * 1000) / 10 : 0;
    prev.servicePurchaseExpense = Math.round(prevServiceExpense);
    prev.cost += Math.round(prevServiceExpense); prev.profit -= Math.round(prevServiceExpense);
    prev.margin = prev.revenue > 0 ? Math.round(prev.profit / prev.revenue * 1000) / 10 : 0;
    var periodBlock = {
      key: period, label: b.label, current: cur, previous: prev,
      delta: {
        revenue: pctDelta_(cur.revenue, prev.revenue),
        profit: pctDelta_(cur.profit, prev.profit),
        orders: pctDelta_(cur.orders, prev.orders),
        aov: pctDelta_(cur.aov, prev.aov),
        margin: Math.round((cur.margin - prev.margin) * 10) / 10
      }
    };

    return ok_({
      kpi: {
        revenue: revenue, profit: profit, cost: cost,
        stockValue: stockValue, receivable: receivable, payable: payable,
        purchaseTotal: purchaseGross - purchaseReturnTotal,  // mua vào đã TRỪ hàng trả lại NCC
        purchaseGross: purchaseGross,
        purchaseReturn: purchaseReturnTotal,
        purchaseReturnCount: prDash.count,
        servicePurchaseExpense: allServicePurchaseExpense,
        operatingExpense: operatingExpense, netProfitAfterExpense: cur.profit - operatingExpense,
        netCashFlow: cashIn - cashOut, totalCashBalance: totalCashBalance
      },
      chart: chart,
      // Khóa StockValue (không phải "value") vì đây là giá trị tồn theo GIÁ VỐN — người
      // không có quyền xem giá vốn phải không thấy được cơ cấu này.
      categories: Object.keys(byCat).map(function (k) { return { name: k, StockValue: Math.round(byCat[k]) }; }),
      topProducts: topProducts,
      period: periodBlock,
      alerts: { lowStock: lowStock, outStock: outStock, overStock: overStock, overdueReceivable: overdueReceivable, overduePayable: overduePayable },
      activities: activities,
      operatingExpenseCategories: operatingExpenseCategories,
      latestOperatingExpenses: latestOperatingExpenses,
      budgetAlerts: budgetAlerts.slice(0, 8)
    });
  } catch (e) { return err_(e.message); }
}

