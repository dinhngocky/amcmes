/* Chỉ trả dòng CTB đang hiệu lực và các dòng REMOVED của ECN hiện hành để đối chiếu. */
function getMaterialRequirements(machineId,filters){
  try{
    filters=filters||{};
    var current=machineId?machineBomSortVersions_(cachedSheetToObjects_('MachineBOMVersions').filter(function(v){
      return String(v.MachineID)===String(machineId)&&amcvnText_(v.Status).toUpperCase()==='RELEASED';
    }))[0]:null;
    var rows=(machineId?readScopedRowsV224_('MaterialRequirements','MachineID',[machineId]):cachedSheetToObjects_('MaterialRequirements')).filter(function(r){
      if(machineId&&String(r.MachineID)!==String(machineId))return false;
      if(filters.projectId&&String(r.ProjectID)!==String(filters.projectId))return false;
      if(filters.moduleId&&String(r.ModuleID)!==String(filters.moduleId))return false;
      var active=materialIsActive_(r);
      var currentRemoved=!!(filters.includeECN&&current&&String(r.ECNToBOMVersionID)===String(current.BOMVersionID)&&String(r.ECNChangeType).toUpperCase()==='REMOVED');
      if(!active&&!filters.includeCancelled&&!currentRemoved)return false;
      if(filters.shortageOnly&&toNumber(r.ShortageQty)<=0)return false;
      if(filters.criticalOnly&&materialCritical_(r.CriticalLevel)!=='A')return false;
      return true;
    });
    rows.sort(function(a,b){
      var order={ADDED:0,UPDATED:1,UNCHANGED:2,'':2,REMOVED:3};
      return (order[String(a.ECNChangeType||'').toUpperCase()]||2)-(order[String(b.ECNChangeType||'').toUpperCase()]||2)
        ||materialCritical_(a.CriticalLevel).localeCompare(materialCritical_(b.CriticalLevel))||amcvnSortCode_(a,b,'SKU');
    });
    return ok_(rows.map(dedicatedEnrich_));
  }catch(e){return err_(e.message);}
}

