    sheetToObjects_('Customers').forEach(function (c) {
      if (c.CustomerID) byId[String(c.CustomerID).trim().toLowerCase()] = c;
      var k = impPartyKey_(c.CustomerName, c.Phone);
      if (k && !byKey[k]) byKey[k] = c;
    });
    var toCreate = [], updatesMap = {}, skipped = 0, batchId = {}, batchKey = {}, debts = [];
    rows.forEach(function (r) {
      var name = impStr_(r.CustomerName);
      if (!name) { skipped++; return; }
      var code = impStr_(r.CustomerID);
      var key = impPartyKey_(name, r.Phone);
      // Có MÃ thì mã là căn cứ duy nhất: phần mềm cũ cho phép 2 khách trùng tên khác mã.
      var hit = code ? byId[code.toLowerCase()] : byKey[key];
      if (hit) {
        if (mode === 'update') {
          var u = {};
          ['Phone', 'Email', 'Address', 'CustomerGroup', 'Notes'].forEach(function (f) { if (impStr_(r[f])) u[f] = impStr_(r[f]); });
          u.CustomerName = name;
          if (r.Status !== undefined && r.Status !== '') u.Status = impPartyStatus_(r.Status);
          updatesMap[hit.CustomerID] = u;
          impCollectDebt_(debts, hit.CustomerID, name, r);   // sửa lại nợ cũ khi nhập lại file
        } else skipped++;
        return;
      }
      if (code) { if (batchId[code.toLowerCase()]) { skipped++; return; } batchId[code.toLowerCase()] = true; }
      else { if (key && batchKey[key]) { skipped++; return; } if (key) batchKey[key] = true; }
      toCreate.push({ code: code, name: name, r: r });
    });
    // Giữ chỗ cho mã cũ trong file TRƯỚC khi cấp mã mới.
    toCreate.forEach(function (x) { if (x.code) bumpCounterTo_('KH', x.code); });
    var needGen = toCreate.filter(function (x) { return !x.code; }).length;
    var genIds = needGen ? generateIds('KH', needGen) : [];
    var gi = 0, newRows = [];
    toCreate.forEach(function (x) {
      var r = x.r;
      var id = x.code || genIds[gi++];
      if (x.code) bumpCounterTo_('KH', x.code);
      newRows.push({
        CustomerID: id, CustomerName: x.name, Phone: impStr_(r.Phone),
        Email: impStr_(r.Email), Address: impStr_(r.Address),
        CustomerGroup: impStr_(r.CustomerGroup) || 'Khách lẻ',
        TotalSales: 0, ReceivableBalance: 0,
        LastPurchaseDate: impDate_(r.LastPurchaseDate) || '', Status: impPartyStatus_(r.Status),
        Notes: impStr_(r.Notes), CreatedAt: impDate_(r.CreatedAt) || now
      });
      impCollectDebt_(debts, id, x.name, r);
    });
    if (newRows.length) appendRows('Customers', newRows);
    var updated = Object.keys(updatesMap).length;
    if (updated) updateRowsById_('Customers', 'CustomerID', updatesMap);
    var warnings = [];
    if (debts.length) {
      impWriteOpeningDocs_('Customer', debts, now);
      warnings.push('Đã ghi nhận nợ cũ đầu kỳ cho ' + debts.length + ' khách hàng');
      refreshAllCustomerBalances_();
    }
    if (newRows.length || updated) writeAudit_('Nhập khách hàng từ file', 'Customer', '', 'Tạo ' + newRows.length + ', cập nhật ' + updated + ', bỏ qua ' + skipped);
    return impResult_(newRows.length, updated, skipped, warnings,
      'Đã nhập ' + newRows.length + ' khách hàng' + (updated ? ', cập nhật ' + updated : '') + (skipped ? ', bỏ qua ' + skipped + ' dòng trùng/thiếu tên' : ''));
  } catch (e) { return err_(e.message); }
}

