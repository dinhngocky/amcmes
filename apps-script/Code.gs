var cachedTz_ = null;
function getTz_() {
  if (cachedTz_) return cachedTz_;
  try {
    cachedTz_ = SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone();
  } catch(e) { console.warn('[getTz_]', (e && e.message) || String(e)); 
    cachedTz_ = Session.getScriptTimeZone();
  }
  return cachedTz_;
}

/** Chuẩn hoá 1 giá trị "loại mặt hàng" bất kỳ về 'Service' | 'Product'.
 *  Nhận diện: Service / service / Dịch vụ / Dich vu / DV. */
function normalizeProductType_(v) {
  var s = String(v == null ? '' : v).trim().toLowerCase();
  if (!s) return '';
  if (s === 'service' || s === 'dịch vụ' || s === 'dich vu' || s === 'dv') return 'Service';
  return 'Product';
}
/** Dịch vụ = không tồn kho. Dùng cho MỌI nhánh nghiệp vụ liên quan kho. */
function isServiceProduct_(p) {
  if (!p) return false;
  if (normalizeProductType_(p.ProductType) === 'Service') return true;
  return normalizeProductType_(p.Category) === 'Service'; // Category 'Dịch vụ'
}

