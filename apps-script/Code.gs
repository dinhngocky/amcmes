  VLABELS.SourceType.StockTransfer = 'Phiếu chuyển kho';

  if (typeof MONEY_COLS !== 'undefined') {
    ['TotalValue', 'LineTotal'].forEach(function (k) { if (MONEY_COLS.indexOf(k) < 0) MONEY_COLS.push(k); });
  }
  if (typeof SETUP_SHEET_ORDER !== 'undefined') {
    ['Warehouses', 'StockTransfers', 'StockTransferItems'].forEach(function (n) {
      if (SETUP_SHEET_ORDER.indexOf(n) < 0) SETUP_SHEET_ORDER.push(n);
    });
  }
  if (typeof SETUP_TAB_COLORS !== 'undefined') {
    SETUP_TAB_COLORS.Warehouses = '#0891b2';
    SETUP_TAB_COLORS.StockTransfers = '#0891b2';
    SETUP_TAB_COLORS.StockTransferItems = '#0891b2';
