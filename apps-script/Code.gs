function authRolePerms_(role) {
  var r = String(role || '').trim().toLowerCase();
  // Tương thích tên vai trò quản trị của các bản cũ / dữ liệu nhập từ hệ thống khác.
  if (['admin', 'administrator', 'super admin', 'quản trị viên', 'quan tri', 'quan tri vien'].indexOf(r) >= 0) r = 'quản trị';
  if (['manager', 'quản lý chung', 'quan ly'].indexOf(r) >= 0) r = 'quản lý';
  if (['warehouse', 'thủ kho', 'thu kho'].indexOf(r) >= 0) r = 'kho';
  for (var i = 0; i < AUTH_ROLES_.length; i++) {
    if (AUTH_ROLES_[i].name.toLowerCase() === r) return AUTH_ROLES_[i].perms;
  }
  return AUTH_ROLES_[AUTH_ROLES_.length - 1].perms; // không khớp vai trò nào -> chỉ xem
}

/* ---------- Chuỗi phân quyền lưu trên Sheet ----------
 * Dạng mới:  "sales:vced|inventory:v|cost:v"   (v=xem, c=thêm, e=sửa, d=xóa)
 * Dạng cũ:   "sales:edit|inventory:view"       -> vẫn đọc được, tự quy đổi. */
function authNormActions_(text) {
  var lv = String(text == null ? '' : text).trim().toLowerCase();
  if (!lv) return '';
  if (lv === 'edit' || lv === 'full') return 'vced';   // bản cũ: "sửa" nghĩa là toàn quyền
  if (lv === 'view') return 'v';
  var out = '';
  ['v', 'c', 'e', 'd'].forEach(function (a) { if (lv.indexOf(a) >= 0) out += a; });
  // Thêm/sửa/xóa mà không xem được thì vô nghĩa -> luôn kèm quyền xem.
  if (out && out.indexOf('v') < 0) out = 'v' + out;
  return out;
}
function authParsePerms_(text) {
  var out = {};
  String(text == null ? '' : text).split('|').forEach(function (part) {
    var p = String(part).trim();
    if (!p) return;
    var kv = p.split(':');
    var mod = String(kv[0] || '').trim();
    if (!mod) return;
    var acts = authNormActions_(kv.length > 1 ? kv[1] : 'v');
    if (acts) out[mod] = acts;
  });
  return out;
}
function authFormatPerms_(obj) {
  var parts = [];
  AUTH_MODULES_.forEach(function (m) {
    var acts = authNormActions_(obj && obj[m.id]);
    if (acts) parts.push(m.id + ':' + acts);
  });
  AUTH_EXTRAS_.forEach(function (x) {
    if (obj && obj[x.id]) parts.push(x.id + ':v');
  });
  return parts.join('|');
}
/** Nhận object / chuỗi / rỗng -> luôn trả chuỗi chuẩn. Rỗng thì lấy theo vai trò. */
function authNormalizePerms_(perms, role) {
  if (perms && typeof perms === 'object') return authFormatPerms_(perms);
  var s = String(perms == null ? '' : perms).trim();
  if (s) return authFormatPerms_(authParsePerms_(s));
  return authFormatPerms_(authRolePerms_(role));
}
/** Quyền thực tế của một người: ưu tiên cột Permissions, trống thì theo vai trò. */
function authPermsOf_(user) {
  if (!user) return {};
  var s = String(user.Permissions == null ? '' : user.Permissions).trim();
  if (s) {
    var parsed = authParsePerms_(s);
    // Tương thích tài khoản tạo trước AMCVN Core V1: chỉ kế thừa quyền của module
    // hoàn toàn mới nếu vai trò dựng sẵn có khai báo, không thay đổi quyền module cũ.
    var roleDefaults = authRolePerms_(user.Role);
    var roleText = String(user.Role || '').trim().toLowerCase();
    var legacyAdmin = ['admin', 'administrator', 'super admin', 'quản trị', 'quản trị viên', 'quan tri', 'quan tri vien'].indexOf(roleText) >= 0
      || /[ced]/.test(String(parsed.users || ''));
    if (!parsed.projects) parsed.projects = legacyAdmin ? 'vced' : (roleDefaults.projects || '');
    if (!parsed.material_control) parsed.material_control = legacyAdmin ? 'vced' : (roleDefaults.material_control || '');
    if (!parsed.quality) parsed.quality = legacyAdmin ? 'vced' : (roleDefaults.quality || '');
    if (!parsed.projects) delete parsed.projects;
    if (!parsed.material_control) delete parsed.material_control;
    if (!parsed.quality) delete parsed.quality;
    return parsed;
  }
  return authRolePerms_(user.Role);
}
function authIsAdmin_(user) {
  var p = authPermsOf_(user);
  return String(p.users || '').indexOf('e') >= 0 || String(p.users || '').indexOf('c') >= 0;
}
/**
 * Người này có được làm hành động `action` trên phân hệ `moduleId` không?
 *   action: 'v' xem | 'c' thêm | 'e' sửa | 'd' xóa (mặc định 'v')
 * Với quyền đặc biệt (cost/import/export/audit) chỉ cần có mặt là được.
 */
function authAllowed_(user, moduleId, action) {
  if (!moduleId || moduleId === 'common') return true;
  var p = authPermsOf_(user);
  var have = String(p[moduleId] || '');
  if (!have) return false;
  var act = String(action || 'v');
  // 'edit' của bản cũ nghĩa là mọi hành động ghi
  if (act === 'edit') act = 'e';
  if (act === 'view') act = 'v';
  if (act.length > 1) act = act.charAt(0);
  return have.indexOf(act) >= 0;
}
/** Quyền đặc biệt: cost / import / export / audit / salary / discount. */
function authHasExtra_(user, extraId) {
  var p = authPermsOf_(user);
  return !!p[extraId];
}

/* ---------- Mật khẩu ---------- */
function authNewSalt_() { return Utilities.getUuid().split('-').join(''); }
function authHash_(password, salt) {
  var raw = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,
    String(salt || '') + '::' + String(password || ''), Utilities.Charset.UTF_8);
  var hex = '';
  for (var i = 0; i < raw.length; i++) {
    var b = (raw[i] < 0 ? raw[i] + 256 : raw[i]).toString(16);
    hex += (b.length === 1 ? '0' : '') + b;
  }
  return hex;
}
function authNormUsername_(s) { return String(s == null ? '' : s).trim().toLowerCase(); }

/** Bản thông tin an toàn để gửi ra trình duyệt: KHÔNG kèm mã băm và chuỗi trộn. */
function publicUser_(u) {
  if (!u) return u;
  return {
    UserID: u.UserID, FullName: u.FullName, Email: u.Email, Role: u.Role,
    Status: u.Status, CreatedAt: u.CreatedAt, Username: u.Username || '',
    Permissions: authFormatPerms_(authPermsOf_(u)), LastLoginAt: u.LastLoginAt || '',
    HasLogin: !!(u.Username && u.PasswordHash), IsAdmin: authIsAdmin_(u)
  };
}

function authUsers_() { return sheetToObjects_('Users'); }
function authFindUserByLogin_(login) {
  var key = authNormUsername_(login);
  if (!key) return null;
  var list = authUsers_();
  for (var i = 0; i < list.length; i++) {
    if (authNormUsername_(list[i].Username) === key) return list[i];
  }
  for (var j = 0; j < list.length; j++) {
    if (authNormUsername_(list[j].Email) === key) return list[j];
  }
  return null;
}
function authFindUserById_(id) {
  var list = authUsers_();
  for (var i = 0; i < list.length; i++) if (String(list[i].UserID) === String(id)) return list[i];
  return null;
}
function authIsLocked_(u) {
  if (isLocked_(u && u.Status)) return true;
  var s = String(u && u.Status || '').trim().toLowerCase();
  return s === 'tạm khoá' || s === 'tạm khóa' || s === 'tam khoa' || s === 'khóa' || s === 'locked';
}

/* ---------- Phiên đăng nhập ----------
 * Lưu ở CacheService cho nhanh + Script Properties để không mất phiên khi cache bị dọn. */
function authSaveSession_(token, userId, ttlSeconds, userAgent) {
  if (!userAgent) throw new Error('Thiếu thông tin trình duyệt; hãy tải lại trang.');
  var ttl = Math.min(Math.max(1, ttlSeconds || AUTH_TOKEN_TTL_), AUTH_TOKEN_TTL_);
  var info = { u: userId, exp: Date.now() + ttl * 1000, ua: simpleHash_(String(userAgent)) };
  var payload = JSON.stringify(info);
  trackMutationProperty_(AUTH_TOKEN_PREFIX_ + token);
  PropertiesService.getScriptProperties().setProperty(AUTH_TOKEN_PREFIX_ + token, payload);
  try { CacheService.getScriptCache().put('auth:' + token, payload, ttl); } catch (e) { console.warn('[authSaveSession_]', e.message); }
  return info;
}
function authDropSession_(token) {
  if (!token) return;
  trackMutationProperty_(AUTH_TOKEN_PREFIX_ + token);
  PropertiesService.getScriptProperties().deleteProperty(AUTH_TOKEN_PREFIX_ + token);
  try { CacheService.getScriptCache().remove('auth:' + token); } catch (e) { console.warn('[authDropSession_]', e.message); }
}
/** Dọn phiên hết hạn — gọi mỗi lần đăng nhập để Script Properties không phình ra. */
function authCleanSessions_() {
  var props = PropertiesService.getScriptProperties(), all = props.getProperties(), now = Date.now();
  Object.keys(all).forEach(function (key) {
    if (key.indexOf(AUTH_TOKEN_PREFIX_) !== 0) return;
    var info = null;
    try { info = JSON.parse(all[key]); } catch (e) { console.warn('[authCleanSessions_]', e.message); }
    if (!info || !info.exp || info.exp <= now) { trackMutationProperty_(key); props.deleteProperty(key); }
  });
}
function authSession_(token, userAgent) {
  var info = authSessionInfo_(token, userAgent);
  if (!info) return null;
  var user = authFindUserById_(info.u);
  return !user || authIsLocked_(user) ? null : user;
}

/* ---------- Hàm giao diện gọi TRỰC TIẾP (không qua cổng) ---------- */

/** Hệ thống đã có tài khoản đăng nhập chưa (dùng cho màn hình đăng nhập). */
function authStatus() {
  try {
    try { migrateAmcvnBrand_(); } catch (eBrand) { console.warn('[authStatus]', (eBrand && eBrand.message) || String(eBrand)); }
    var settings = {};
    try { cachedSheetToObjects_('Settings').forEach(function (s) { settings[s.Key] = s.Value; }); } catch (e) { console.warn('[authStatus]', (e && e.message) || String(e)); }
    var list = [];
    try { list = authUsers_(); } catch (e) { console.warn('[authStatus]', (e && e.message) || String(e)); }
    var hasAccount = list.some(function (u) { return u.Username && u.PasswordHash; });
    return ok_({
      ready: hasAccount,
      businessName: settings.BusinessName || '',
      logoUrl: settings.LogoUrl || CONFIG.LOGO_URL || '',
      appName: CONFIG.APP_NAME
    });
  } catch (e) { return err_(e.message); }
}

function login(username, password, remember, userAgent, __locked) {
  if (!__locked) return withMutationLock_(['Users', 'Settings', 'AuditLog'], function () { return login(username, password, remember, userAgent, true); });
  try {
    try { migrateAmcvnBrand_(); } catch (eBrand) { console.warn('[login]', (eBrand && eBrand.message) || String(eBrand)); }
    var uname = authNormUsername_(username);
    if (!uname) return err_('Vui lòng nhập tên đăng nhập.', 'ERR_LOGIN');
    var user = authFindUserByLogin_(uname);
    if (!user || !user.PasswordHash) return err_('Sai tên đăng nhập hoặc mật khẩu.', 'ERR_LOGIN');
    if (authIsLocked_(user)) return err_('Tài khoản đang bị tạm khóa. Liên hệ quản trị viên.', 'ERR_LOGIN_LOCKED');
    if (authHash_(password, user.PasswordSalt) !== String(user.PasswordHash)) {
      return err_('Sai tên đăng nhập hoặc mật khẩu.', 'ERR_LOGIN');
    }
    authCleanSessions_();
    var token = Utilities.getUuid();
    var session = authSaveSession_(token, user.UserID, AUTH_TOKEN_TTL_, userAgent);
    AUTH_CTX_ = user;
    try { updateRowById('Users', 'UserID', user.UserID, { LastLoginAt: new Date() }); } catch (e) { console.warn('[login]', (e && e.message) || String(e)); }
    try { writeAudit_('Đăng nhập', 'Users', user.UserID, user.Username || ''); } catch (e) { console.warn('[login]', (e && e.message) || String(e)); }
    return ok_({ token: token, expiresAt: session.exp, user: publicUser_(user), modules: authEnabledModules_() },
      'Xin chào ' + (user.FullName || user.Username));
  } catch (e) { if (token) authDropSession_(token); return err_(e.message, 'ERR_LOGIN'); }
}

function logout(token) {
  return withMutationLock_([], function () { authDropSession_(token); return ok_(null, 'Đã đăng xuất'); });
}

/** Mở lại ứng dụng (F5) mà phiên còn hạn -> không phải gõ mật khẩu lại. */
function authWhoami(token, userAgent) {
  try {
    var user = authSession_(token, userAgent);
    if (!user) return err_('Phiên đăng nhập đã hết hạn.', 'ERR_AUTH');
    AUTH_CTX_ = user;
    return ok_({ token: token, expiresAt: authSessionInfo_(token, userAgent).exp, user: publicUser_(user), modules: authEnabledModules_() });
  } catch (e) { return err_(e.message, 'ERR_AUTH'); }
}

