  };
}

/** Thuế TNCN lũy tiến từng phần. Thu nhập tính thuế <= 0 thì không phải nộp. */
function hrPersonalTax_(taxable) {
  var t = Math.max(0, toNumber(taxable));
  if (t <= 0) return 0;
  var tax = 0, prev = 0;
  for (var i = 0; i < HR_TAX_BRACKETS_.length; i++) {
    var b = HR_TAX_BRACKETS_[i];
    var slice = Math.min(t, b.upTo) - prev;
    if (slice > 0) tax += slice * b.rate / 100;
    prev = b.upTo;
    if (t <= b.upTo) break;
  }
  return roundMoney_(tax);
}

/* ------------------------------ Hồ sơ nhân viên ------------------------------ */
function hrEmployees_() { return sheetToObjects_('Employees'); }
function hrEmployeeById_(id) {
  var list = hrEmployees_();
  for (var i = 0; i < list.length; i++) if (String(list[i].EmployeeID) === String(id)) return list[i];
  return null;
}
function hrActiveEmployees_() {
  return hrEmployees_().filter(function (e) { return String(e.Status || 'Đang làm việc') === 'Đang làm việc'; });
}
function hrAllowanceOf_(e) {
  return toNumber(e.AllowanceLunch) + toNumber(e.AllowanceTransport) + toNumber(e.AllowancePhone) + toNumber(e.AllowanceOther);
}

function getEmployees() {
  try {
    var rows = hrEmployees_().map(function (e) {
      var o = {};
      Object.keys(e).forEach(function (k) { o[k] = e[k]; });
      o.TotalAllowance = hrAllowanceOf_(e);
      return o;
    });
    return ok_(rows);
  } catch (e) { return err_(e.message); }
}

function getHrBootstrap() {
  try {
    var emps = getEmployees().data || [];
    var deps = [], poss = [];
    emps.forEach(function (e) {
      var d = String(e.Department || '').trim(); if (d && deps.indexOf(d) < 0) deps.push(d);
      var p = String(e.Position || '').trim(); if (p && poss.indexOf(p) < 0) poss.push(p);
    });
    var accounts = [];
    try {
      accounts = cachedSheetToObjects_('CashAccounts').filter(function (a) { return String(a.Status || '') !== 'Ngừng dùng'; })
        .map(function (a) { return { AccountID: a.AccountID, AccountName: a.AccountName }; });
    } catch (e2) { console.warn('[getHrBootstrap]', (e2 && e2.message) || String(e2));  accounts = []; }
    var cats = [];
    try {
      cats = cachedSheetToObjects_('FinanceCategories').filter(function (c) { return c.CategoryType === 'Expense'; })
        .map(function (c) { return { CategoryID: c.CategoryID, CategoryName: c.CategoryName }; });
    } catch (e3) { console.warn('[getHrBootstrap]', (e3 && e3.message) || String(e3));  cats = []; }
    return ok_({
      employees: emps, departments: deps.sort(), positions: poss.sort(),
      salaryTypes: HR_SALARY_TYPES_, leaveTypes: HR_LEAVE_TYPES_,
      config: hrConfig_(), accounts: accounts, expenseCategories: cats,
      canSeeAllSalary: !AUTH_CTX_ || authHasExtra_(AUTH_CTX_, 'salary'),
      myEmployeeId: hrMyEmployeeId_()
    });
  } catch (e) { return err_(e.message); }
}

/** Người đang đăng nhập ứng với nhân viên nào (để chỉ xem phiếu lương của mình). */
function hrMyEmployeeId_() {
  if (!AUTH_CTX_) return '';
  var uid = String(AUTH_CTX_.UserID || '');
  var mail = String(AUTH_CTX_.Email || '').trim().toLowerCase();
  var hit = hrEmployees_().filter(function (e) {
    return (uid && String(e.UserID) === uid) || (mail && String(e.Email || '').trim().toLowerCase() === mail);
  })[0];
  return hit ? hit.EmployeeID : '';
}

function createEmployee(data) {
  return withMutationLock_(['Employees'], function () {
    try {
      data = data || {};
      var name = String(data.FullName || '').trim();
      if (!name) return err_('Vui lòng nhập họ tên nhân viên.');
      var code = String(data.EmployeeCode || '').trim().toUpperCase();
      if (code && hrEmployees_().some(function (e) { return String(e.EmployeeCode).toUpperCase() === code; })) {
        return err_('Mã nhân viên "' + code + '" đã có rồi.');
      }
      var id = generateId('NV');
      if (!code) code = 'NV' + padSeq_(hrEmployees_().length + 1);
      var row = {
        EmployeeID: id, EmployeeCode: code, FullName: name, Gender: data.Gender || '',
        BirthDate: data.BirthDate ? docDate_(data.BirthDate) : '', Phone: data.Phone || '', Email: data.Email || '',
        Address: data.Address || '', IDNumber: data.IDNumber || '',
        Department: data.Department || '', Position: data.Position || '',
        StartDate: docDate_(data.StartDate, new Date()), EndDate: '',
        ContractType: data.ContractType || 'Chính thức',
        SalaryType: HR_SALARY_TYPES_.indexOf(data.SalaryType) >= 0 ? data.SalaryType : 'Tháng',
        BaseSalary: Math.max(0, toNumber(data.BaseSalary)),
        AllowanceLunch: Math.max(0, toNumber(data.AllowanceLunch)),
        AllowanceTransport: Math.max(0, toNumber(data.AllowanceTransport)),
        AllowancePhone: Math.max(0, toNumber(data.AllowancePhone)),
        AllowanceOther: Math.max(0, toNumber(data.AllowanceOther)),
        InsuranceBase: Math.max(0, toNumber(data.InsuranceBase)),
        Dependants: Math.max(0, Math.round(toNumber(data.Dependants))),
        BankAccount: data.BankAccount || '', BankName: data.BankName || '', UserID: data.UserID || '',
        Status: data.Status || 'Đang làm việc', Notes: data.Notes || '',
        CreatedAt: new Date(), UpdatedAt: new Date()
      };
      appendRow('Employees', row);
      writeAudit_('Thêm nhân viên', 'Employee', id, name + ' · ' + (row.Position || ''));
      return ok_(row, 'Đã thêm nhân viên ' + name);
    } catch (e) { return err_(e.message); }
  });
}

function updateEmployee(employeeId, data) {
  return withMutationLock_(['Employees'], function () {
    try {
      data = data || {};
      var e = hrEmployeeById_(employeeId);
      if (!e) return err_('Không tìm thấy nhân viên.');
      var upd = {};
      ['FullName', 'Gender', 'Phone', 'Email', 'Address', 'IDNumber', 'Department', 'Position',
        'ContractType', 'BankAccount', 'BankName', 'UserID', 'Notes'].forEach(function (k) {
          if (data[k] !== undefined) upd[k] = String(data[k] || '');
        });
      ['BaseSalary', 'AllowanceLunch', 'AllowanceTransport', 'AllowancePhone', 'AllowanceOther', 'InsuranceBase'].forEach(function (k) {
        if (data[k] !== undefined) upd[k] = Math.max(0, toNumber(data[k]));
      });
      if (data.Dependants !== undefined) upd.Dependants = Math.max(0, Math.round(toNumber(data.Dependants)));
      if (data.SalaryType !== undefined && HR_SALARY_TYPES_.indexOf(data.SalaryType) >= 0) upd.SalaryType = data.SalaryType;
      if (data.EmployeeCode !== undefined) {
        var code = String(data.EmployeeCode || '').trim().toUpperCase();
        if (code && hrEmployees_().some(function (x) {
          return String(x.EmployeeID) !== String(employeeId) && String(x.EmployeeCode).toUpperCase() === code;
        })) return err_('Mã nhân viên "' + code + '" đã có rồi.');
        upd.EmployeeCode = code;
      }
      if (data.BirthDate !== undefined) upd.BirthDate = data.BirthDate ? docDate_(data.BirthDate) : '';
      if (data.StartDate !== undefined) upd.StartDate = data.StartDate ? docDate_(data.StartDate) : '';
      if (data.EndDate !== undefined) upd.EndDate = data.EndDate ? docDate_(data.EndDate) : '';
      if (data.Status !== undefined) {
        upd.Status = String(data.Status || 'Đang làm việc');
        if (upd.Status === 'Đã nghỉ việc' && !upd.EndDate && !e.EndDate) upd.EndDate = new Date();
      }
      upd.UpdatedAt = new Date();
      updateRowById('Employees', 'EmployeeID', employeeId, upd);
      writeAudit_('Sửa hồ sơ nhân viên', 'Employee', employeeId, upd.FullName || e.FullName);
      var merged = {};
      Object.keys(e).forEach(function (k) { merged[k] = e[k]; });
      Object.keys(upd).forEach(function (k) { merged[k] = upd[k]; });
      return ok_(merged, 'Đã cập nhật hồ sơ nhân viên');
    } catch (e) { return err_(e.message); }
  });
}

function deleteEmployee(employeeId) {
  return withMutationLock_(['Employees', 'Attendance', 'PayrollLines'], function () {
    try {
      var e = hrEmployeeById_(employeeId);
      if (!e) return err_('Không tìm thấy nhân viên.');
      var inPayroll = sheetToObjects_('PayrollLines').filter(function (l) { return String(l.EmployeeID) === String(employeeId); }).length;
      if (inPayroll) {
        return err_('Nhân viên "' + e.FullName + '" đã có ' + inPayroll + ' dòng trong bảng lương — không xóa được. '
          + 'Hãy chuyển trạng thái sang "Đã nghỉ việc" để giữ lại lịch sử.', 'ERR_HR_HAS_PAYROLL');
      }
      var att = sheetToObjects_('Attendance').filter(function (a) { return String(a.EmployeeID) === String(employeeId); });
      if (att.length) deleteRowsByIds_('Attendance', 'AttendanceID', att.map(function (a) { return a.AttendanceID; }));
      deleteRowById('Employees', 'EmployeeID', employeeId);
      writeAudit_('Xóa nhân viên', 'Employee', employeeId, e.FullName);
      return ok_(null, 'Đã xóa nhân viên ' + e.FullName);
    } catch (e) { return err_(e.message); }
  });
}

/* -------------------------------- Chấm công -------------------------------- */
/** Kỳ chấm công dạng 'YYYY-MM'. Không truyền thì lấy tháng hiện tại. */
function hrPeriodKey_(v) {
  if (v && /^\d{4}-\d{2}$/.test(String(v))) return String(v);
  var d = v ? new Date(v) : new Date();
  if (isNaN(d.getTime())) d = new Date();
  return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2);
}
/** Số công quy đổi của một loại công: nghỉ không lương = 0, nửa ngày = 0.5... */
function hrWorkValueOf_(leaveType, given) {
  if (given !== undefined && given !== null && String(given) !== '') return Math.max(0, toNumber(given));
  var t = String(leaveType || 'Đi làm');
  if (t === 'Nghỉ không lương') return 0;
  if (t === 'Nửa ngày') return 0.5;
  return 1;    // Đi làm / Nghỉ phép / Nghỉ lễ / Nghỉ ốm đều tính đủ công hưởng lương
}

function getAttendance(periodKey) {
  try {
    var key = hrPeriodKey_(periodKey);
    var rows = sheetToObjects_('Attendance').filter(function (a) { return String(a.PeriodKey) === key; });
    var summary = {};
    rows.forEach(function (a) {
      var s = summary[a.EmployeeID] || (summary[a.EmployeeID] = { EmployeeID: a.EmployeeID, EmployeeName: a.EmployeeName, WorkDays: 0, OvertimeHours: 0, Days: 0 });
      s.WorkDays += toNumber(a.WorkValue);
      s.OvertimeHours += toNumber(a.OvertimeHours);
      s.Days++;
    });
    return ok_({
      periodKey: key, rows: rows,
      summary: Object.keys(summary).map(function (k) { return summary[k]; }),
      employees: hrActiveEmployees_().map(function (e) {
        return { EmployeeID: e.EmployeeID, EmployeeCode: e.EmployeeCode, FullName: e.FullName, Department: e.Department, Position: e.Position };
      }),
      leaveTypes: HR_LEAVE_TYPES_, config: hrConfig_()
    });
  } catch (e) { return err_(e.message); }
}

/**
 * Ghi chấm công. rows: [{EmployeeID, WorkDate, LeaveType, WorkValue, OvertimeHours, Note}]
 * Cùng một nhân viên trong cùng một ngày thì GHI ĐÈ, không tạo thêm dòng trùng.
 */
function saveAttendance(periodKey, rows) {
  return withMutationLock_(['Attendance'], function () {
    try {
      var key = hrPeriodKey_(periodKey);
      rows = (rows || []).filter(function (r) { return r && r.EmployeeID && r.WorkDate; });
      if (!rows.length) return err_('Chưa có dòng chấm công nào.');
      var empMap = {};
      hrEmployees_().forEach(function (e) { empMap[e.EmployeeID] = e; });
      var existing = {};
      sheetToObjects_('Attendance').filter(function (a) { return String(a.PeriodKey) === key; })
        .forEach(function (a) {
          existing[String(a.EmployeeID) + '|' + formatDate(a.WorkDate)] = a;
        });
      var newRows = [], updates = {};
      var now = new Date();
      // Cấp mã theo LÔ: gọi generateId trong vòng lặp sẽ ra cùng một mã cho mọi dòng
      // (bộ đếm chỉ nhích lên sau khi đã ghi xuống sheet) -> chấm công sẽ đè lên nhau.
      var newIds = generateIds('CC', rows.length);
      var idx = 0;
      rows.forEach(function (r) {
        var e = empMap[r.EmployeeID];
        if (!e) return;
        var d = new Date(r.WorkDate);
        if (isNaN(d.getTime())) return;
        var leave = HR_LEAVE_TYPES_.indexOf(r.LeaveType) >= 0 ? r.LeaveType : 'Đi làm';
        var payload = {
          PeriodKey: key, EmployeeID: e.EmployeeID, EmployeeName: e.FullName, WorkDate: d,
          LeaveType: leave, WorkValue: hrWorkValueOf_(leave, r.WorkValue),
          OvertimeHours: Math.max(0, toNumber(r.OvertimeHours)), Note: r.Note || ''
        };
        var k = String(e.EmployeeID) + '|' + formatDate(d);
        if (existing[k]) updates[String(existing[k].AttendanceID)] = payload;
        else {
          payload.AttendanceID = newIds[idx++];
          payload.CreatedBy = getUser_();
          payload.CreatedAt = now;
          newRows.push(payload);
          existing[k] = payload;
        }
      });
      if (newRows.length) appendRows('Attendance', newRows);
      if (Object.keys(updates).length) updateRowsById_('Attendance', 'AttendanceID', updates);
      writeAudit_('Chấm công', 'Attendance', key, 'Thêm ' + newRows.length + ', cập nhật ' + Object.keys(updates).length + ' dòng');
      return ok_({ created: newRows.length, updated: Object.keys(updates).length, periodKey: key },
        'Đã lưu chấm công kỳ ' + key);
    } catch (e) { return err_(e.message); }
  });
}

function deleteAttendance(attendanceId) {
  return withMutationLock_(['Attendance'], function () {
    try {
      var a = sheetToObjects_('Attendance').filter(function (x) { return String(x.AttendanceID) === String(attendanceId); })[0];
      if (!a) return err_('Không tìm thấy dòng chấm công.');
      deleteRowById('Attendance', 'AttendanceID', attendanceId);
      return ok_(null, 'Đã xóa dòng chấm công');
    } catch (e) { return err_(e.message); }
  });
}

/* -------------------------------- Bảng lương -------------------------------- */
function hrPayrollById_(id) {
  var list = sheetToObjects_('PayrollPeriods');
  for (var i = 0; i < list.length; i++) if (String(list[i].PayrollID) === String(id)) return list[i];
  return null;
}

/** Tính một dòng lương từ hồ sơ + số công. Tách riêng để test và sửa dễ. */
function hrComputeLine_(e, work, cfg, overrides) {
  overrides = overrides || {};
  var std = toNumber(overrides.StandardDays) > 0 ? toNumber(overrides.StandardDays) : cfg.StandardDays;
  var days = toNumber(work.WorkDays);
  var otHours = toNumber(work.OvertimeHours);
  var base = toNumber(overrides.BaseSalary !== undefined ? overrides.BaseSalary : e.BaseSalary);
  var type = e.SalaryType || 'Tháng';

  var salaryByWork;
  if (type === 'Ngày') salaryByWork = base * days;
  else if (type === 'Giờ') salaryByWork = base * days;          // với kiểu Giờ thì "số công" chính là số giờ
  else if (type === 'Khoán') salaryByWork = base;
  else salaryByWork = std > 0 ? base * days / std : 0;          // kiểu Tháng

  var hourly = 0;
  if (type === 'Giờ') hourly = base;
  else if (type === 'Ngày') hourly = cfg.HoursPerDay > 0 ? base / cfg.HoursPerDay : 0;
  else hourly = (std > 0 && cfg.HoursPerDay > 0) ? base / std / cfg.HoursPerDay : 0;

  var otRate = toNumber(overrides.OvertimeRate) > 0 ? toNumber(overrides.OvertimeRate) : cfg.OvertimeRate;
  var overtimePay = roundMoney_(hourly * otHours * otRate);
  var allowance = toNumber(overrides.Allowance !== undefined ? overrides.Allowance : hrAllowanceOf_(e));
  var bonus = Math.max(0, toNumber(overrides.Bonus));
  salaryByWork = roundMoney_(salaryByWork);
  var gross = roundMoney_(salaryByWork + allowance + bonus + overtimePay);

  var insBase = toNumber(overrides.InsuranceBase !== undefined ? overrides.InsuranceBase : e.InsuranceBase);
  var insEmp = roundMoney_(insBase * cfg.InsuranceEmployeePct / 100);
  var insCom = roundMoney_(insBase * cfg.InsuranceCompanyPct / 100);

  var deps = Math.max(0, Math.round(toNumber(overrides.Dependants !== undefined ? overrides.Dependants : e.Dependants)));
  var taxable = Math.max(0, gross - insEmp - cfg.PersonalDeduction - deps * cfg.DependantDeduction);
  var tax = hrPersonalTax_(taxable);

  var advance = Math.max(0, toNumber(overrides.Advance));
  var other = Math.max(0, toNumber(overrides.OtherDeduction));
  var totalDeduction = roundMoney_(insEmp + tax + advance + other);
  var net = roundMoney_(gross - totalDeduction);

  return {
    SalaryType: type, BaseSalary: base, StandardDays: std, WorkDays: days,
    OvertimeHours: otHours, OvertimeRate: otRate, SalaryByWork: salaryByWork,
    Allowance: allowance, Bonus: bonus, OvertimePay: overtimePay, GrossPay: gross,
    InsuranceBase: insBase, InsuranceEmployee: insEmp, InsuranceCompany: insCom,
    Dependants: deps, TaxableIncome: roundMoney_(taxable), PersonalTax: tax,
    Advance: advance, OtherDeduction: other, TotalDeduction: totalDeduction, NetPay: net
  };
}

/**
 * Lập bảng lương cho một kỳ: gom chấm công của kỳ đó rồi tính cho từng nhân viên đang làm việc.
 * data: { PeriodKey, PeriodName, FromDate, ToDate, StandardDays, Notes, employees:[EmployeeID] }
 */
function createPayroll(data) {
  return withMutationLock_(['PayrollPeriods', 'PayrollLines', 'Attendance', 'Employees'], function () {
    try {
      data = data || {};
      var key = hrPeriodKey_(data.PeriodKey);
      var exist = sheetToObjects_('PayrollPeriods').filter(function (p) {
        return String(p.PeriodKey) === key && !isCancelled_(String(p.Status || ''));
      })[0];
      if (exist) return err_('Kỳ lương ' + key + ' đã có bảng lương ' + exist.PayrollID + '. Hãy mở bảng cũ hoặc xóa đi rồi lập lại.', 'ERR_HR_PERIOD_EXISTS');

      var cfg = hrConfig_();
      var std = toNumber(data.StandardDays) > 0 ? toNumber(data.StandardDays) : cfg.StandardDays;
      var only = (data.employees && data.employees.length) ? data.employees.map(String) : null;
      var emps = hrActiveEmployees_().filter(function (e) { return !only || only.indexOf(String(e.EmployeeID)) >= 0; });
      if (!emps.length) return err_('Chưa có nhân viên nào đang làm việc để tính lương.', 'ERR_HR_NO_EMPLOYEE');

      var att = {};
      sheetToObjects_('Attendance').filter(function (a) { return String(a.PeriodKey) === key; })
        .forEach(function (a) {
          var s = att[a.EmployeeID] || (att[a.EmployeeID] = { WorkDays: 0, OvertimeHours: 0 });
          s.WorkDays += toNumber(a.WorkValue);
          s.OvertimeHours += toNumber(a.OvertimeHours);
        });

      var id = generateId('BLG');
      var now = new Date();
      var lineIds = generateIds('PLG', emps.length);
      var totalGross = 0, totalDed = 0, totalNet = 0, totalInsCom = 0;
      var lines = emps.map(function (e, idx) {
        // Không chấm công ngày nào -> mặc định tính đủ công chuẩn (doanh nghiệp nhỏ hay làm vậy),
        // nhưng người dùng sửa lại được ngay trên bảng lương.
        var w = att[e.EmployeeID] || { WorkDays: (e.SalaryType === 'Tháng' ? std : 0), OvertimeHours: 0 };
        var c = hrComputeLine_(e, w, cfg, { StandardDays: std });
        totalGross += c.GrossPay; totalDed += c.TotalDeduction; totalNet += c.NetPay; totalInsCom += c.InsuranceCompany;
        var row = {
          PayrollLineID: lineIds[idx], PayrollID: id, EmployeeID: e.EmployeeID, EmployeeCode: e.EmployeeCode,
          EmployeeName: e.FullName, Department: e.Department || '', Position: e.Position || '',
          PaidAmount: 0, PaymentStatus: 'Chưa trả', Note: ''
        };
        Object.keys(c).forEach(function (k) { row[k] = c[k]; });
        return row;
      });

      appendRow('PayrollPeriods', {
        PayrollID: id, PeriodKey: key, PeriodName: data.PeriodName || ('Lương tháng ' + key),
        FromDate: data.FromDate ? docDate_(data.FromDate) : '', ToDate: data.ToDate ? docDate_(data.ToDate) : '',
        StandardDays: std, EmployeeCount: lines.length,
        TotalGross: roundMoney_(totalGross), TotalDeduction: roundMoney_(totalDed), TotalNet: roundMoney_(totalNet),
        TotalInsuranceCompany: roundMoney_(totalInsCom),
        Status: 'Nháp', Notes: data.Notes || '', CreatedBy: getUser_(), CreatedAt: now,
        ApprovedBy: '', ApprovedAt: '', PaidAt: '', TransactionID: ''
      });
      appendRows('PayrollLines', lines);
      writeAudit_('Lập bảng lương', 'Payroll', id, key + ' · ' + lines.length + ' nhân viên · ' + formatMoney_(totalNet));
      return ok_({ PayrollID: id, PeriodKey: key, EmployeeCount: lines.length, TotalNet: roundMoney_(totalNet) },
        'Đã lập bảng lương kỳ ' + key + ' cho ' + lines.length + ' nhân viên');
    } catch (e) { return err_(e.message); }
  });
}

function getPayrolls() {
  try { return ok_(sheetToObjects_('PayrollPeriods').slice().reverse()); }
  catch (e) { return err_(e.message); }
}

function getPayrollDetail(payrollId) {
  try {
    var p = hrPayrollById_(payrollId);
    if (!p) return err_('Không tìm thấy bảng lương.');
    var lines = sheetToObjects_('PayrollLines').filter(function (l) { return String(l.PayrollID) === String(payrollId); });
    // Không có quyền xem lương người khác -> chỉ trả về đúng dòng của mình.
    if (AUTH_CTX_ && !authHasExtra_(AUTH_CTX_, 'salary')) {
      var me = hrMyEmployeeId_();
      lines = lines.filter(function (l) { return String(l.EmployeeID) === String(me); });
    }
    return ok_({ payroll: p, lines: lines, config: hrConfig_() });
  } catch (e) { return err_(e.message); }
}

/** Sửa một dòng lương (thưởng, tạm ứng, trừ khác, số công...) rồi tính lại cả bảng. */
function updatePayrollLine(payrollLineId, data) {
  return withMutationLock_(['PayrollPeriods', 'PayrollLines'], function () {
    try {
      data = data || {};
      var line = sheetToObjects_('PayrollLines').filter(function (l) { return String(l.PayrollLineID) === String(payrollLineId); })[0];
      if (!line) return err_('Không tìm thấy dòng lương.');
      var p = hrPayrollById_(line.PayrollID);
      if (!p) return err_('Không tìm thấy bảng lương.');
      if (String(p.Status || '') === 'Đã chi lương') return err_('Bảng lương đã chi, không sửa được nữa.', 'ERR_HR_PAID');
      var e = hrEmployeeById_(line.EmployeeID) || {};
      var cfg = hrConfig_();
      var c = hrComputeLine_({
        SalaryType: line.SalaryType, BaseSalary: line.BaseSalary, InsuranceBase: line.InsuranceBase,
        Dependants: line.Dependants,
        AllowanceLunch: 0, AllowanceTransport: 0, AllowancePhone: 0, AllowanceOther: 0
      }, {
        WorkDays: data.WorkDays !== undefined ? toNumber(data.WorkDays) : toNumber(line.WorkDays),
        OvertimeHours: data.OvertimeHours !== undefined ? toNumber(data.OvertimeHours) : toNumber(line.OvertimeHours)
      }, cfg, {
        StandardDays: line.StandardDays,
        BaseSalary: data.BaseSalary !== undefined ? toNumber(data.BaseSalary) : toNumber(line.BaseSalary),
        Allowance: data.Allowance !== undefined ? toNumber(data.Allowance) : toNumber(line.Allowance),
        Bonus: data.Bonus !== undefined ? toNumber(data.Bonus) : toNumber(line.Bonus),
        Advance: data.Advance !== undefined ? toNumber(data.Advance) : toNumber(line.Advance),
        OtherDeduction: data.OtherDeduction !== undefined ? toNumber(data.OtherDeduction) : toNumber(line.OtherDeduction),
        InsuranceBase: data.InsuranceBase !== undefined ? toNumber(data.InsuranceBase) : toNumber(line.InsuranceBase),
        Dependants: data.Dependants !== undefined ? toNumber(data.Dependants) : toNumber(line.Dependants),
        OvertimeRate: data.OvertimeRate !== undefined ? toNumber(data.OvertimeRate) : toNumber(line.OvertimeRate)
      });
      var upd = {};
      Object.keys(c).forEach(function (k) { upd[k] = c[k]; });
      if (data.Note !== undefined) upd.Note = String(data.Note || '');
      updateRowById('PayrollLines', 'PayrollLineID', payrollLineId, upd);
      hrRecalcPayrollTotals_(line.PayrollID);
      return ok_(upd, 'Đã cập nhật lương của ' + line.EmployeeName);
    } catch (e) { return err_(e.message); }
  });
}

function hrRecalcPayrollTotals_(payrollId) {
  var lines = sheetToObjects_('PayrollLines').filter(function (l) { return String(l.PayrollID) === String(payrollId); });
  var g = 0, d = 0, n = 0, ic = 0, paid = 0;
  lines.forEach(function (l) {
    g += toNumber(l.GrossPay); d += toNumber(l.TotalDeduction); n += toNumber(l.NetPay);
    ic += toNumber(l.InsuranceCompany); paid += toNumber(l.PaidAmount);
  });
  updateRowById('PayrollPeriods', 'PayrollID', payrollId, {
    EmployeeCount: lines.length, TotalGross: roundMoney_(g), TotalDeduction: roundMoney_(d),
    TotalNet: roundMoney_(n), TotalInsuranceCompany: roundMoney_(ic)
  });
  return { gross: g, deduction: d, net: n, insuranceCompany: ic, paid: paid };
}

function approvePayroll(payrollId) {
  return withMutationLock_(['PayrollPeriods'], function () {
    try {
      var p = hrPayrollById_(payrollId);
      if (!p) return err_('Không tìm thấy bảng lương.');
      if (String(p.Status || '') === 'Đã chi lương') return err_('Bảng lương đã chi rồi.');
      if (String(p.Status || '') === 'Đã duyệt') return err_('Bảng lương đã duyệt rồi.');
      updateRowById('PayrollPeriods', 'PayrollID', payrollId, { Status: 'Đã duyệt', ApprovedBy: getUser_(), ApprovedAt: new Date() });
      writeAudit_('Duyệt bảng lương', 'Payroll', payrollId, p.PeriodName || p.PeriodKey);
      return ok_(null, 'Đã duyệt bảng lương ' + (p.PeriodName || p.PeriodKey));
    } catch (e) { return err_(e.message); }
  });
}

/**
 * Chi lương: đánh dấu đã trả cho từng dòng và (nếu có module Tài chính)
 * ghi luôn một phiếu chi vào sổ quỹ để chi phí lương không bị bỏ sót.
 */
function payPayroll(payrollId, data) {
  return withMutationLock_(['PayrollPeriods', 'PayrollLines'].concat(FINANCE_LOCK_SHEETS_), function () {
    try {
      data = data || {};
      var p = hrPayrollById_(payrollId);
      if (!p) return err_('Không tìm thấy bảng lương.');
      if (String(p.Status || '') === 'Đã chi lương') return err_('Bảng lương này đã chi rồi.');
      if (String(p.Status || '') !== 'Đã duyệt') return err_('Hãy duyệt bảng lương trước khi chi.', 'ERR_HR_NOT_APPROVED');
      var lines = sheetToObjects_('PayrollLines').filter(function (l) { return String(l.PayrollID) === String(payrollId); });
      if (!lines.length) return err_('Bảng lương không có dòng nào.');

      var updates = {};
      var total = 0;
      lines.forEach(function (l) {
        var net = toNumber(l.NetPay);
        total += net;
        updates[String(l.PayrollLineID)] = { PaidAmount: net, PaymentStatus: 'Đã trả' };
      });
      updateRowsById_('PayrollLines', 'PayrollLineID', updates);

      var txId = '';
      if (data.AccountID) {
        var catId = data.CategoryID || hrSalaryCategoryId_();
        var tx = createFinanceTransaction({
          TransactionDate: data.PayDate || new Date(), Direction: 'Out', TransactionType: 'Expense',
          CategoryID: catId, AccountID: data.AccountID, Amount: roundMoney_(total),
          Method: data.Method || 'Chuyển khoản', SourceType: 'Payroll', SourceID: payrollId,
          ObjectType: 'Payroll', ObjectName: p.PeriodName || p.PeriodKey,
          Notes: 'Chi lương kỳ ' + (p.PeriodName || p.PeriodKey) + ' cho ' + lines.length + ' nhân viên'
        });
        if (!tx || !tx.success) return err_('Đã tính lương xong nhưng chưa ghi được phiếu chi: ' + ((tx && tx.message) || ''), 'ERR_HR_PAY_FINANCE');
        txId = tx.data && tx.data.TransactionID;
      }

      updateRowById('PayrollPeriods', 'PayrollID', payrollId, {
        Status: 'Đã chi lương', PaidAt: new Date(), TransactionID: txId
      });
      writeAudit_('Chi lương', 'Payroll', payrollId,
        (p.PeriodName || p.PeriodKey) + ' · ' + lines.length + ' nhân viên · ' + formatMoney_(total));
      return ok_({ PayrollID: payrollId, TotalPaid: roundMoney_(total), TransactionID: txId },
        'Đã chi lương ' + formatMoney_(total) + ' cho ' + lines.length + ' nhân viên'
        + (txId ? ' và ghi vào sổ quỹ.' : '. Chưa ghi vào sổ quỹ vì bạn không chọn tài khoản tiền.'));
    } catch (e) { return err_(e.message); }
  });
}

/** Danh mục chi "Lương nhân viên" — chưa có thì tạo để phiếu chi luôn có chỗ ghi. */
function hrSalaryCategoryId_() {
