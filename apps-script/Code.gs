    var upd = amcvnPick_(data, ['ModuleCode', 'ModuleName', 'ModuleType', 'Owner', 'PlanStart', 'PlanFinish',
      'ActualStart', 'ActualFinish', 'ProgressPercent', 'MaterialStatus', 'AssemblyStatus', 'IssueCount', 'Status', 'Notes']);
    if (upd.ModuleCode !== undefined) {
