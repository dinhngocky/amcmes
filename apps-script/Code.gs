/**
 * Nhật ký thao tác — có lọc theo người, khoảng ngày, phân hệ và từ khóa.
 * Trả kèm danh sách người thực hiện + phân hệ để giao diện dựng bộ lọc.
 */
function getAuditLog(filters) {
  try {
    filters = filters || {};
    var rows = sheetToObjects_('AuditLog');
    var users = {}, modules = {};
    rows.forEach(function (r) {
      if (r.User) users[String(r.User)] = true;
      if (r.Module) modules[String(r.Module)] = true;
    });
    var from = filters.from ? new Date(String(filters.from) + 'T00:00:00') : null;
    var to = filters.to ? new Date(String(filters.to) + 'T23:59:59') : null;
    var q = String(filters.q || '').trim().toLowerCase();
    var out = rows.filter(function (r) {
      if (filters.user && String(r.User) !== String(filters.user)) return false;
      if (filters.module && String(r.Module) !== String(filters.module)) return false;
      if (from || to) {
        var t = r.Time ? new Date(r.Time) : null;
        if (!t || isNaN(t.getTime())) return false;
        if (from && t < from) return false;
        if (to && t > to) return false;
      }
      if (q) {
        var hay = (String(r.User) + ' ' + String(r.Action) + ' ' + String(r.Entity) + ' '
          + String(r.EntityID) + ' ' + String(r.Detail)).toLowerCase();
        if (hay.indexOf(q) < 0) return false;
      }
      return true;
    });
    var total = out.length;
    var limit = Math.min(Math.max(toNumber(filters.limit) || 500, 50), 2000);
    out = out.slice(-limit).reverse();   // mới nhất lên đầu
    return ok_({
      rows: out, total: total, shown: out.length,
      users: Object.keys(users).sort(),
      modules: Object.keys(modules).sort().map(function (m) { return { id: m, label: authModuleLabel_(m) }; })
    });
  } catch (e) { return err_(e.message); }
}

/* ----- Chặn chiết khấu vượt tạm tính (P1) ----- */
/**
 * CHỐNG BẤM LƯU NHIỀU LẦN.
 * Frontend gửi kèm ClientRef (mã do máy khách sinh). Nếu đã có chứng từ mang đúng
 * mã đó thì KHÔNG ghi thêm, mà trả lại chứng từ cũ như một lần lưu thành công.
 * Nhờ vậy dù mạng chậm, người dùng bấm Lưu 5 lần vẫn chỉ ra 1 chứng từ.
 */
function dupByClientRef_(sheetName, idField, clientRef, label) {
  if (!clientRef) return null;
  var found = null;
  var list = sheetToObjects_(sheetName);
  for (var i = list.length - 1; i >= 0; i--) {
    if (String(list[i].ClientRef || '') === String(clientRef)) { found = list[i]; break; }
  }
  if (!found) return null;
  var data = { duplicated: true };
  data[idField] = found[idField];
  return ok_(data, (label || 'Chứng từ') + ' ' + found[idField] + ' đã được ghi nhận trước đó');
}

/** Đếm số dòng hàng hợp lệ của một chứng từ (bỏ dòng trống / số lượng <= 0). */
function countValidLines_(items) {
  return (items || []).filter(function (it) {
    return it && it.ProductID && toNumber(it.Quantity) > 0;
  }).length;
}

/**
 * Mọi dòng hàng phải trỏ tới một sản phẩm CÓ THẬT.
 *
 * Nếu không kiểm, một mã sản phẩm sai sẽ lọt qua: dòng hàng bị bỏ khi ghi chi tiết
 * (chứng từ thành ra rỗng) nhưng vẫn sinh một dòng biến động kho không có mã sản phẩm,
 * làm bẩn sổ kho và không đối soát được. Trả về câu báo lỗi, hoặc '' nếu hợp lệ.
 * pMap: bản đồ ProductID -> sản phẩm (truyền vào để khỏi đọc lại sheet).
 */
function assertKnownProducts_(items, pMap, tenTruong) {
  tenTruong = tenTruong || 'ProductID';
  var la = [];
  (items || []).forEach(function (it) {
    if (!it) return;
    var pid = String(it[tenTruong] || it.ProductID || '');
    if (!pid) return;
    if (pid === 'NO_CU') return;             // dòng "nợ cũ" là dòng ảo, không phải sản phẩm
    if (!pMap[pid] && la.indexOf(pid) < 0) la.push(pid);
  });
  if (!la.length) return '';
  return 'Không tìm thấy sản phẩm: ' + la.join(', ')
    + '. Hãy tải lại trang rồi chọn lại hàng — có thể sản phẩm vừa bị xóa hoặc đổi mã.';
}

/** Giá vốn / giá bán / tồn không được âm. Trả về câu báo lỗi, hoặc '' nếu hợp lệ. */
function assertPricesNotNegative_(data) {
  var kiem = [
    ['CostPrice', 'Giá vốn'], ['SalePrice', 'Giá bán'],
    ['OpeningStock', 'Tồn đầu kỳ'], ['MinStock', 'Tồn tối thiểu'], ['MaxStock', 'Tồn tối đa']
  ];
  for (var i = 0; i < kiem.length; i++) {
    var k = kiem[i][0];
    if (data[k] === undefined || data[k] === null || data[k] === '') continue;
    if (toNumber(data[k]) < 0) return kiem[i][1] + ' không được là số âm.';
  }
  return '';
}

function assertDiscount_(discount, subtotal) {
  if (toNumber(discount) > toNumber(subtotal)) throw new Error('Chiết khấu (' + formatMoney_(discount) + ') không được vượt quá tạm tính (' + formatMoney_(subtotal) + ').');
}

