function productClassifications_() {
  var configured = [];
  try { configured = parseListSetting_(settings_().ProductCategories); } catch (e) { console.warn('[productClassifications_]', (e && e.message) || String(e));  configured = []; }
  return configured.length ? configured : PRODUCT_CLASSIFICATION_DEFAULTS_.slice();
}

function normalizeProductClassification_(value, allowed) {
  var raw = String(value == null ? '' : value).trim();
  if (!raw) return '';
  var list = allowed && allowed.length ? allowed : productClassifications_();
  for (var i = 0; i < list.length; i++) {
    if (String(list[i]).toLowerCase() === raw.toLowerCase()) return String(list[i]);
  }
  return '';
}

function productBool_(value) {
  if (value === true || value === 1) return true;
  var v = String(value == null ? '' : value).trim().toLowerCase();
  return ['true', '1', 'yes', 'y', 'có', 'co', 'fai', 'fai_required', 'required'].indexOf(v) >= 0;
}

function productPartNumberExists_(partNumber, exceptProductId) {
  var key = String(partNumber || '').trim().toLowerCase();
  if (!key) return false;
  return sheetToObjects_('Products').some(function (p) {
    return String(p.ProductID) !== String(exceptProductId || '') &&
      String(p.PartNumber || '').trim().toLowerCase() === key;
  });
}

