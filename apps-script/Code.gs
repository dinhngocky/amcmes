  rows.forEach(function (r, idx) { r.MovementID = ids[idx]; r.Date = dateValue || new Date(); r.SourceType = 'SalesOrder'; r.SourceID = salesId; r.CreatedBy = getUser_(); r.CreatedAt = new Date(); r.Notes = r.Notes || note || ('Xuất cho ' + salesId); });
  appendRows('StockMovements', rows);
