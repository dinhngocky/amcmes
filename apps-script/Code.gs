/* ---------------------------- Helpers ---------------------------- */

function mil4mCategory_(v) {
  var s = String(v || '').toUpperCase();
  if (['MAN', 'MACHINE', 'MATERIAL', 'METHOD'].indexOf(s) < 0) return 'MAN';
  return s;
}

function mil4mSeverity_(v) {
  var s = String(v || 'MEDIUM').toUpperCase();
  if (['LOW', 'MEDIUM', 'HIGH', 'CRITICAL'].indexOf(s) < 0) return 'MEDIUM';
  return s;
}

function mil4mStatus_(v) {
  var s = String(v || 'OPEN').toUpperCase();
  if (ISSUE_STATUS_FLOW_.indexOf(s) < 0) return 'OPEN';
  return s;
}

function mil4mIsOpen_(row) {
  return ['OPEN', 'IN_PROGRESS'].indexOf(mil4mStatus_(row && row.Status)) >= 0;
}

function mil4mCategoryMeta_(code) {
  for (var i = 0; i < MIL4M_CATEGORIES_.length; i++) {
    if (MIL4M_CATEGORIES_[i].code === code) return MIL4M_CATEGORIES_[i];
  }
  return MIL4M_CATEGORIES_[0];
}

/** Lấy Owner email của máy — dùng để gửi email khẩn. */
function mil4mOwnerEmail_(machine, user) {
  try {
    // Ưu tiên Owner của máy
    var ownerName = amcvnText_(machine.Owner) || amcvnText_(machine.LeadEngineer);
    if (ownerName) {
      var owner = sheetToObjects_('Users').filter(function (u) {
        return String(u.FullName || '').trim().toLowerCase() === String(ownerName).trim().toLowerCase();
      })[0];
      if (owner && owner.Email) return owner.Email;
    }
    // Fallback: Admin đầu tiên
    var admin = sheetToObjects_('Users').filter(function (u) { return authIsAdmin_(u); })[0];
    if (admin && admin.Email) return admin.Email;
    // Fallback cuối: OwnerEmail trong Settings
    var settings = settings_();
    if (settings.OwnerEmail) return settings.OwnerEmail;
    return '';
  } catch (e) {
    console.warn('[mil4mOwnerEmail_]', (e && e.message) || String(e));
    return '';
  }
}

/** Gửi email khi chat CRITICAL. */
function mil4mSendCriticalEmail_(machine, chatRow, issueRow) {
  try {
    var settings = settings_();
    var business = settings.BusinessName || 'AMCVN';
    var to = mil4mOwnerEmail_(machine, null);
    if (!to) return;

    // Không gửi nếu người báo là chính Owner
    var reporterName = String(chatRow.ReporterName || '').trim();
    var ownerName = amcvnText_(machine.Owner) || amcvnText_(machine.LeadEngineer);
    if (reporterName && ownerName && reporterName.toLowerCase() === ownerName.toLowerCase()) return;

    var subject = '[' + business + '][KHẨN] Sự cố nghiêm trọng — Máy ' + (machine.MachineCode || '');
    var url = '';
    try {
      var props = PropertiesService.getScriptProperties();
      url = props.getProperty('NEXUPONE_WEBAPP_URL') || '';
    } catch (e) { console.warn('[mil4mSendCriticalEmail_]', (e && e.message) || String(e)); }

    var html = '<div style="font-family:Arial,sans-serif;color:#111827;max-width:680px;line-height:1.55">'
      + '<div style="padding:16px 20px;border-radius:16px;background:#dc2626;color:#fff;margin-bottom:18px">'
      +   '<div style="font-size:18px;font-weight:800">' + esc_(business) + ' — Báo động sự cố</div>'
      +   '<div style="opacity:.92;font-size:13px;margin-top:4px">Máy ' + esc_(machine.MachineCode || '') + ' · ' + esc_(machine.MachineName || '') + '</div>'
      + '</div>'
      + '<table style="border-collapse:collapse;width:100%;margin-bottom:12px">'
      +   '<tr><td style="padding:6px 10px;background:#fef2f2;border:1px solid #fecaca;width:160px"><b>Người báo</b></td><td style="padding:6px 10px;border:1px solid #fecaca">' + esc_(reporterName) + '</td></tr>'
      +   '<tr><td style="padding:6px 10px;background:#fef2f2;border:1px solid #fecaca"><b>Mức độ</b></td><td style="padding:6px 10px;border:1px solid #fecaca;color:#dc2626;font-weight:700">' + esc_(issueRow.Severity || 'CRITICAL') + '</td></tr>'
      +   '<tr><td style="padding:6px 10px;background:#fef2f2;border:1px solid #fecaca"><b>Loại 4M</b></td><td style="padding:6px 10px;border:1px solid #fecaca">' + esc_(mil4mCategoryMeta_(issueRow.Category).label) + '</td></tr>'
      +   (issueRow.StageName ? '<tr><td style="padding:6px 10px;background:#fef2f2;border:1px solid #fecaca"><b>Công đoạn</b></td><td style="padding:6px 10px;border:1px solid #fecaca">' + esc_(issueRow.StageName) + '</td></tr>' : '')
      +   (issueRow.ModuleName ? '<tr><td style="padding:6px 10px;background:#fef2f2;border:1px solid #fecaca"><b>Module</b></td><td style="padding:6px 10px;border:1px solid #fecaca">' + esc_(issueRow.ModuleName) + '</td></tr>' : '')
      + '</table>'
      + '<div style="padding:14px 16px;border-radius:12px;background:#fef2f2;border:1px solid #fecaca;margin-bottom:16px">'
      +   '<div style="font-size:12px;color:#991b1b;font-weight:700;margin-bottom:6px">NỘI DUNG</div>'
      +   '<div style="white-space:pre-wrap">' + esc_(String(chatRow.Content || '')) + '</div>'
      + '</div>'
      + '<p>Vui lòng kiểm tra và xử lý ngay.</p>'
      + (url ? '<p><a href="' + esc_(url) + '" style="display:inline-block;background:#dc2626;color:#fff;padding:10px 18px;border-radius:10px;text-decoration:none;font-weight:700">Mở AMCVN</a></p>' : '')
      + '<p style="color:#6b7280;font-size:12px;margin-top:24px">Email tự động từ AMCVN — Báo cáo sự cố sản xuất.</p>'
      + '</div>';

    MailApp.sendEmail({ to: to, subject: subject, htmlBody: html });
    return to;
  } catch (e) {
    console.warn('[mil4mSendCriticalEmail_]', (e && e.message) || String(e));
    return '';
