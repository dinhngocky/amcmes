/* ---------------------------- API: MIL 4M ---------------------------- */

/**
 * Lấy danh sách vấn đề MIL 4M.
 * filters: { machineId, projectId, status, category, severity, owner, includeClosed, search }
 */
function getMil4MIssues(filters) {
  try {
    filters = filters || {};
    var q = String(filters.search || '').trim().toLowerCase();
    var rows = sheetToObjects_('Mil4MIssues');

    var out = rows.filter(function (r) {
      if (filters.machineId && String(r.MachineID) !== String(filters.machineId)) return false;
      if (filters.projectId && String(r.ProjectID) !== String(filters.projectId)) return false;
      if (filters.status && mil4mStatus_(r.Status) !== String(filters.status).toUpperCase()) return false;
      if (filters.category && mil4mCategory_(r.Category) !== String(filters.category).toUpperCase()) return false;
      if (filters.severity && mil4mSeverity_(r.Severity) !== String(filters.severity).toUpperCase()) return false;
      if (filters.owner && String(r.Owner || '').trim().toLowerCase() !== String(filters.owner).trim().toLowerCase()) return false;
      if (!filters.includeClosed) {
        // Mặc định loại bỏ CLOSED và CANCELLED
        if (['OPEN', 'IN_PROGRESS'].indexOf(mil4mStatus_(r.Status)) < 0) return false;
      }
      if (q) {
        var hay = [r.IssueID, r.Title, r.Description, r.Owner, r.ModuleName, r.StageName].join(' ').toLowerCase();
        if (hay.indexOf(q) < 0) return false;
      }
      return true;
    });

    // Sắp xếp: open trước, severity cao trước, hạn gần trước
    var sevRank = { 'CRITICAL': 0, 'HIGH': 1, 'MEDIUM': 2, 'LOW': 3 };
    out.sort(function (a, b) {
      var oa = mil4mIsOpen_(a) ? 0 : 1;
      var ob = mil4mIsOpen_(b) ? 0 : 1;
      if (oa !== ob) return oa - ob;
      var sa = sevRank[mil4mSeverity_(a.Severity)] || 9;
      var sb = sevRank[mil4mSeverity_(b.Severity)] || 9;
      if (sa !== sb) return sa - sb;
      var da = a.DueDate ? new Date(a.DueDate).getTime() : Infinity;
      var db = b.DueDate ? new Date(b.DueDate).getTime() : Infinity;
      return da - db;
    });

    var dtos = out.map(function (r) { return mil4mRowToDto_(r, AUTH_CTX_); });

    // Thống kê nhanh
    var stats = {
      total: dtos.length,
      open: 0, inProgress: 0, closed: 0, cancelled: 0,
      critical: 0, high: 0, blocked: 0, overdue: 0
    };
    var now = Date.now();
    dtos.forEach(function (d) {
      if (d.Status === 'OPEN') stats.open++;
      else if (d.Status === 'IN_PROGRESS') stats.inProgress++;
      else if (d.Status === 'CLOSED') stats.closed++;
      else if (d.Status === 'CANCELLED') stats.cancelled++;
      if (d.Severity === 'CRITICAL') stats.critical++;
      if (d.Severity === 'HIGH') stats.high++;
      if (d.Blocked) stats.blocked++;
      if (d.IsOpen && d.DueDate && new Date(d.DueDate).getTime() < now) stats.overdue++;
    });

    return ok_({ rows: dtos, stats: stats, categories: MIL4M_CATEGORIES_ });
  } catch (e) {
    return err_(e, 'ERR_MIL4M_LIST');
  }
}

function getMil4MIssueDetail(issueId) {
  try {
    var row = amcvnFind_('Mil4MIssues', 'IssueID', issueId);
    if (!row) return err_('Không tìm thấy vấn đề.', 'ERR_MIL4M_NOT_FOUND');
    var machine = amcvnFind_('Machines', 'MachineID', row.MachineID) || {};
    var chat = row.SourceReportID ? amcvnFind_('DailyReports', 'ReportID', row.SourceReportID) : null;
    return ok_({
      issue: mil4mRowToDto_(row, AUTH_CTX_),
      machine: { MachineID: machine.MachineID, MachineCode: machine.MachineCode, MachineName: machine.MachineName },
      sourceChat: chat ? {
        ReportID: chat.ReportID,
        Content: String(chat.Content || ''),
        ReporterName: String(chat.ReporterName || ''),
        CreatedAt: String(chat.CreatedAt || '')
      } : null
    });
  } catch (e) {
    return err_(e, 'ERR_MIL4M_DETAIL');
  }
}

/**
 * Tạo vấn đề MIL 4M thủ công.
 * data: { MachineID, ModuleID, ModuleName, StageCode, StageName,
 *         Category, Title, Description, RootCause, CorrectiveAction,
 *         Severity, Owner, DueDate, Blocked }
 */
function createMil4MIssue(data) {
  data = data || {};
  if (!data.__locked) {
    return runLocked_(data, '__locked', ['Mil4MIssues', 'Machines'], function () { return createMil4MIssue(data); });
  }
  try {
    var user = AUTH_CTX_;
    if (!user) return err_('Phiên đăng nhập đã hết hạn.', 'ERR_AUTH');

    var machine = amcvnFind_('Machines', 'MachineID', data.MachineID);
    if (!machine) return err_('Vui lòng chọn máy hợp lệ.', 'ERR_MIL4M_MACHINE');

    var title = String(data.Title || '').trim();
    if (!title) return err_('Vui lòng nhập tiêu đề.', 'ERR_MIL4M_TITLE');
    if (title.length > 200) return err_('Tiêu đề tối đa 200 ký tự.', 'ERR_MIL4M_TITLE_LONG');

    var cat = mil4mCategory_(data.Category);
    var sev = mil4mSeverity_(data.Severity);
    var owner = String(data.Owner || '').trim();
    var dueDate = data.DueDate ? docDate_(data.DueDate) : '';
    var blocked = productBool_(data.Blocked);

    var now = new Date();
    var row = {
      IssueID: generateId('M4M'),
      MachineID: machine.MachineID,
      ProjectID: machine.ProjectID || '',
      ModuleID: String(data.ModuleID || '').trim(),
      ModuleName: String(data.ModuleName || '').trim(),
      StageCode: String(data.StageCode || '').trim(),
      StageName: String(data.StageName || '').trim(),
      Category: cat,
      Title: title,
      Description: String(data.Description || '').trim(),
      RootCause: String(data.RootCause || '').trim(),
      CorrectiveAction: String(data.CorrectiveAction || '').trim(),
      Resolution: '',
      Severity: sev,
      Owner: owner,
      DueDate: dueDate,
      Status: 'OPEN',
      Blocked: blocked,
      SourceReportID: String(data.SourceReportID || '').trim(),
      Source: data.SourceReportID ? 'FROM_CHAT' : 'MANUAL',
      OpenedAt: now,
      ClosedAt: '',
      ClosedBy: '',
      CreatedBy: user.UserID || getUser_(),
      CreatedAt: now,
      UpdatedAt: now
    };
    appendRow('Mil4MIssues', row);

    // Nếu tạo từ chat → ghi link ngược lại
    if (row.SourceReportID) {
      updateRowById('DailyReports', 'ReportID', row.SourceReportID, {
        LinkedIssueID: row.IssueID,
        IssueCreatedAt: now
      });
    }

    // Nếu blocked → update máy
    if (blocked) {
      updateRowById('Machines', 'MachineID', machine.MachineID, {
        BlockedReason: 'Vấn đề 4M: ' + title,
        RiskLevel: sev === 'CRITICAL' ? 'HIGH' : 'MEDIUM',
        UpdatedAt: now
      });
    }

    writeAudit_('Tạo vấn đề 4M', 'Mil4MIssue', row.IssueID,
      cat + ' · ' + title.slice(0, 80) + (row.Source === 'FROM_CHAT' ? ' (từ chat)' : ''));

    return ok_({ issue: mil4mRowToDto_(row, user) }, 'Đã tạo vấn đề ' + row.IssueID);
  } catch (e) {
    return err_(e, 'ERR_MIL4M_CREATE');
  }
}

/**
 * Cập nhật vấn đề MIL 4M.
 */
function updateMil4MIssue(issueId, data) {
  data = data || {};
  if (!data.__locked) {
    return runLocked_(data, '__locked', ['Mil4MIssues', 'Machines'], function () { return updateMil4MIssue(issueId, data); });
  }
  try {
    var user = AUTH_CTX_;
    if (!user) return err_('Phiên đăng nhập đã hết hạn.', 'ERR_AUTH');

    var row = amcvnFind_('Mil4MIssues', 'IssueID', issueId);
    if (!row) return err_('Không tìm thấy vấn đề.', 'ERR_MIL4M_NOT_FOUND');

    var upd = { UpdatedAt: new Date() };
    if (data.Title !== undefined) {
      var t = String(data.Title || '').trim();
      if (!t) return err_('Tiêu đề không được để trống.', 'ERR_MIL4M_TITLE');
      upd.Title = t;
    }
    if (data.Category !== undefined) upd.Category = mil4mCategory_(data.Category);
    if (data.Severity !== undefined) upd.Severity = mil4mSeverity_(data.Severity);
    if (data.Description !== undefined) upd.Description = String(data.Description || '').trim();
    if (data.RootCause !== undefined) upd.RootCause = String(data.RootCause || '').trim();
    if (data.CorrectiveAction !== undefined) upd.CorrectiveAction = String(data.CorrectiveAction || '').trim();
    if (data.Resolution !== undefined) upd.Resolution = String(data.Resolution || '').trim();
    if (data.Owner !== undefined) upd.Owner = String(data.Owner || '').trim();
    if (data.DueDate !== undefined) upd.DueDate = data.DueDate ? docDate_(data.DueDate) : '';
    if (data.ModuleID !== undefined) upd.ModuleID = String(data.ModuleID || '').trim();
    if (data.ModuleName !== undefined) upd.ModuleName = String(data.ModuleName || '').trim();
    if (data.StageCode !== undefined) upd.StageCode = String(data.StageCode || '').trim();
    if (data.StageName !== undefined) upd.StageName = String(data.StageName || '').trim();

    // Xử lý Status (chỉ cho phép chuyển qua 4 trạng thái)
    if (data.Status !== undefined) {
      var newStatus = mil4mStatus_(data.Status);
      upd.Status = newStatus;
      if (newStatus === 'CLOSED' || newStatus === 'CANCELLED') {
        upd.ClosedAt = new Date();
        upd.ClosedBy = user.UserID || getUser_();
        if (newStatus === 'CLOSED' && data.Resolution !== undefined) {
          upd.Resolution = String(data.Resolution || '').trim();
        }
      } else {
        // Mở lại
        upd.ClosedAt = '';
        upd.ClosedBy = '';
      }
    }

    if (data.Blocked !== undefined) {
      upd.Blocked = productBool_(data.Blocked);
    }

    updateRowById('Mil4MIssues', 'IssueID', issueId, upd);

    // Nếu Blocked thay đổi → cập nhật máy
    if (upd.Blocked !== undefined && upd.Blocked !== productBool_(row.Blocked)) {
      var machine = amcvnFind_('Machines', 'MachineID', row.MachineID);
      if (machine) {
        updateRowById('Machines', 'MachineID', row.MachineID, {
          BlockedReason: upd.Blocked ? ('Vấn đề 4M: ' + (upd.Title || row.Title)) : '',
          UpdatedAt: new Date()
        });
      }
    }

    writeAudit_('Cập nhật vấn đề 4M', 'Mil4MIssue', issueId, upd.Status || '');
    return ok_({ issue: mil4mRowToDto_(amcvnFind_('Mil4MIssues', 'IssueID', issueId), user) }, 'Đã cập nhật vấn đề');
  } catch (e) {
    return err_(e, 'ERR_MIL4M_UPDATE');
  }
}

/**
 * Đóng vấn đề (status = CLOSED) kèm kết quả xử lý.
 */
function closeMil4MIssue(issueId, resolution) {
  return updateMil4MIssue(issueId, {
    Status: 'CLOSED',
    Resolution: resolution || ''
  });
}

/**
 * Đổi trạng thái nhanh (Mới ↔ Đang xử lý).
 */
function toggleMil4MStatus(issueId) {
  var row = amcvnFind_('Mil4MIssues', 'IssueID', issueId);
  if (!row) return err_('Không tìm thấy vấn đề.', 'ERR_MIL4M_NOT_FOUND');
  var cur = mil4mStatus_(row.Status);
  var next = cur === 'OPEN' ? 'IN_PROGRESS' : (cur === 'IN_PROGRESS' ? 'OPEN' : 'OPEN');
  return updateMil4MIssue(issueId, { Status: next });
}

function deleteMil4MIssue(issueId) {
  return withMutationLock_(['Mil4MIssues', 'DailyReports', 'Machines'], function () {
    try {
      var user = AUTH_CTX_;
      if (!user) return err_('Phiên đăng nhập đã hết hạn.', 'ERR_AUTH');
      if (!authIsAdmin_(user)) return err_('Chỉ quản trị viên mới được xóa vấn đề.', 'ERR_PERM');

      var row = amcvnFind_('Mil4MIssues', 'IssueID', issueId);
      if (!row) return err_('Không tìm thấy vấn đề.', 'ERR_MIL4M_NOT_FOUND');

      // Gỡ link ngược ở chat
      if (row.SourceReportID) {
        updateRowById('DailyReports', 'ReportID', row.SourceReportID, {
          LinkedIssueID: '',
          IssueCreatedAt: ''
        });
      }

      deleteRowById('Mil4MIssues', 'IssueID', issueId);
      writeAudit_('Xóa vấn đề 4M', 'Mil4MIssue', issueId, String(row.Title || '').slice(0, 80));
      return ok_(null, 'Đã xóa vấn đề');
    } catch (e) {
      return err_(e, 'ERR_MIL4M_DELETE');
    }
  });
}

/* ---------------------------- API: Tạo Issue từ Chat ---------------------------- */

/**
 * Tạo vấn đề MIL 4M từ 1 tin nhắn chat.
 * data: {
 *   ReportID,
 *   Category, Title, Description, RootCause, CorrectiveAction,
 *   Severity, Owner, DueDate, Blocked,
 *   ModuleID, ModuleName, StageCode, StageName
 * }
 */
function createIssueFromChat(data) {
  data = data || {};
  if (!data.__locked) {
    return runLocked_(data, '__locked', ['Mil4MIssues', 'DailyReports', 'Machines', 'Users'],
      function () { return createIssueFromChat(data); });
  }
  try {
    var user = AUTH_CTX_;
    if (!user) return err_('Phiên đăng nhập đã hết hạn.', 'ERR_AUTH');

    var reportId = String(data.ReportID || '').trim();
    if (!reportId) return err_('Thiếu mã tin nhắn.', 'ERR_MIL4M_REPORT');

    var report = amcvnFind_('DailyReports', 'ReportID', reportId);
    if (!report) return err_('Không tìm thấy tin nhắn.', 'ERR_MIL4M_REPORT_NOT_FOUND');
    if (chatTruthy_(report.IsDeleted)) return err_('Tin nhắn đã bị xóa.', 'ERR_MIL4M_REPORT_DELETED');
    if (report.LinkedIssueID) return err_('Tin nhắn này đã có vấn đề ' + report.LinkedIssueID + '.', 'ERR_MIL4M_DUPLICATE');

    var machine = amcvnFind_('Machines', 'MachineID', report.MachineID);
    if (!machine) return err_('Không tìm thấy máy của tin nhắn.', 'ERR_MIL4M_MACHINE');

    // Điền mặc định từ chat nếu data không có
    var title = String(data.Title || '').trim();
    if (!title) {
      var content = String(report.Content || '').trim();
      title = content ? content.split('\n')[0].slice(0, 150) : 'Sự cố từ chat';
    }
    var description = String(data.Description || '').trim() || String(report.Content || '');
    var stageCode = String(data.StageCode || report.StageCode || '');
    var stageName = String(data.StageName || report.StageName || '');
    var moduleId = String(data.ModuleID || report.ModuleID || '');
    var moduleName = String(data.ModuleName || report.ModuleName || '');

    var r = createMil4MIssue({
      MachineID: machine.MachineID,
      ModuleID: moduleId,
      ModuleName: moduleName,
      StageCode: stageCode,
      StageName: stageName,
      Category: data.Category || 'MACHINE',
      Title: title,
      Description: description,
      RootCause: data.RootCause || '',
      CorrectiveAction: data.CorrectiveAction || '',
      Severity: data.Severity || report.Severity || 'HIGH',
      Owner: data.Owner || '',
      DueDate: data.DueDate || '',
      Blocked: data.Blocked === true,
      SourceReportID: reportId,
      __locked: true
    });
    if (!r || !r.success) return r;

    var issue = r.data.issue;

    // Gửi email nếu CRITICAL
    if (String(issue.Severity).toUpperCase() === 'CRITICAL') {
      try {
        mil4mSendCriticalEmail_(machine, report, {
          IssueID: issue.IssueID,
          Severity: issue.Severity,
          Category: issue.Category,
          StageName: issue.StageName,
          ModuleName: issue.ModuleName
        });
      } catch (mailErr) {
        console.warn('[createIssueFromChat]', (mailErr && mailErr.message) || String(mailErr));
      }
    }

    return ok_({ issue: issue }, 'Đã tạo vấn đề ' + issue.IssueID + ' từ tin nhắn');
  } catch (e) {
    return err_(e, 'ERR_MIL4M_FROM_CHAT');
  }
}

/* ---------------------------- API: Thống kê ---------------------------- */

function getMil4MStats(machineId, days) {
  try {
    days = Math.max(1, Math.min(365, toNumber(days) || 30));
    var fromMs = Date.now() - days * 86400000;
    var rows = sheetToObjects_('Mil4MIssues').filter(function (r) {
      if (machineId && String(r.MachineID) !== String(machineId)) return false;
      var t = r.OpenedAt ? new Date(r.OpenedAt).getTime() : 0;
      return t >= fromMs;
    });

    var byCategory = { MAN: 0, MACHINE: 0, MATERIAL: 0, METHOD: 0 };
    var bySeverity = { LOW: 0, MEDIUM: 0, HIGH: 0, CRITICAL: 0 };
    var byStatus = { OPEN: 0, IN_PROGRESS: 0, CLOSED: 0, CANCELLED: 0 };
    var fromChat = 0, manual = 0;

    rows.forEach(function (r) {
      byCategory[mil4mCategory_(r.Category)]++;
      bySeverity[mil4mSeverity_(r.Severity)]++;
      byStatus[mil4mStatus_(r.Status)]++;
      if (String(r.Source || '') === 'FROM_CHAT') fromChat++;
      else manual++;
    });

    return ok_({
      days: days,
      total: rows.length,
      byCategory: byCategory,
      bySeverity: bySeverity,
      byStatus: byStatus,
      fromChat: fromChat,
      manual: manual
    });
  } catch (e) {
    return err_(e, 'ERR_MIL4M_STATS');
  }
}

