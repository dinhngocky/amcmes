      Permissions: authNormalizePerms_(data.Permissions, data.Role || 'Nhân viên'), LastLoginAt: ''
    };
    // Có nhập tên đăng nhập -> tạo luôn tài khoản đăng nhập được.
    var uname = authNormUsername_(data.Username);
    if (uname) {
      if (authFindUserByLogin_(uname)) throw new Error('Tên đăng nhập "' + uname + '" đã có người dùng.');
      var pw = String(data.Password || '');
      if (pw.length < 4) throw new Error('Mật khẩu phải từ 4 ký tự trở lên.');
      var salt = authNewSalt_();
      obj.Username = uname; obj.PasswordSalt = salt; obj.PasswordHash = authHash_(pw, salt);
    }
    appendRow('Users', obj);
    writeAudit_('Tạo tài khoản', 'User', id, obj.FullName + (uname ? (' (' + uname + ')') : ''));
    return ok_(publicUser_(obj), 'Đã tạo người dùng');
  } catch (e) { return err_(e.message); }
}

/* ============================================================================
 *  SETUP — TẠO SHEET + FORMAT + DEMO DATA
 * ========================================================================== */

/**
 * Tạo toàn bộ sheet, format đẹp và (tuỳ chọn) sinh dữ liệu demo liên thông.
 * Chạy: setupNexUpOneSheets(true)  -> reset & tạo demo
 *       setupNexUpOneSheets(false) -> chỉ đảm bảo cấu trúc, giữ dữ liệu
 */
function _setupAMCVNSheetsCore_(resetDemo) {
  var ss = getSpreadsheet_();

  // 1) Tạo / cập nhật cấu trúc các sheet (đổi tên tab cũ tiếng Anh -> tiếng Việt nếu có)
  Object.keys(SCHEMA).forEach(function (name) {
    var tab = resolveSheetName_(name);
    var sh = ss.getSheetByName(tab) || ss.getSheetByName(name);
    if (!sh) sh = ss.insertSheet(tab);
    else if (sh.getName() !== tab) sh.setName(tab);
    if (resetDemo) sh.clearContents().clearFormats();
    formatSheetHeader_(sh, name);
  });

  // 2) Seed Settings (luôn đảm bảo có)
  seedSettings_(resetDemo);

  // 3) Tạo README
  buildReadme_();

  // 4) Demo data
  if (resetDemo) seedDemoData_();
  if (CONFIG.ENABLE_FINANCE) {
    try { migrateFinanceModule(); if (resetDemo) seedFinanceDemo_(); } catch (financeSetupErr) { console.warn('[_setupAMCVNSheetsCore_]', (financeSetupErr && financeSetupErr.message) || String(financeSetupErr));  }
  }
  Object.keys(SCHEMA).forEach(function (name) { applySheetFormatting_(getSheet_(name), SCHEMA[name]); });
  applyWorkbookPolish_();

  // 5) Xoá sheet trống mặc định nếu có
  var def = ss.getSheetByName('Sheet1');
  if (def && def.getLastRow() === 0 && ss.getSheets().length > 1) ss.deleteSheet(def);

  SpreadsheetApp.getActive().toast('AMCVN setup hoàn tất!', 'AMCVN', 5);
  return ok_(null, 'Setup hoàn tất' + (resetDemo ? ' (kèm dữ liệu demo)' : ''));
}

function formatSheetHeader_(sh, name) {
  var headers = viHeaders_(name);
  sh.getRange(1, 1, 1, headers.length).setValues([headers]);
  var hRange = sh.getRange(1, 1, 1, headers.length);
  hRange.setBackground(SETUP_TAB_COLORS[name] || CONFIG.HEADER_BG).setFontColor('#ffffff').setFontWeight('bold')
    .setFontSize(10).setVerticalAlignment('middle').setHorizontalAlignment('center').setWrap(true);
  try { hRange.setBorder(false, false, true, false, false, false, '#ffffff', SpreadsheetApp.BorderStyle.SOLID_MEDIUM); } catch (e) { console.warn('[formatSheetHeader_]', (e && e.message) || String(e)); }
  try { sh.setTabColor(SETUP_TAB_COLORS[name] || CONFIG.HEADER_BG); } catch (e2) { console.warn('[formatSheetHeader_]', (e2 && e2.message) || String(e2)); }
  try { sh.setHiddenGridlines(true); } catch (e3) { console.warn('[formatSheetHeader_]', (e3 && e3.message) || String(e3)); }
  sh.setRowHeight(1, 42);
  sh.setFrozenRows(1);
}

function applySheetFormatting_(sh, headers) {
  if (!sh) return;
  var lastRow = sh.getLastRow();
  var lastCol = headers.length;
  var dataRows = Math.max(0, lastRow - 1);

  // Filter
  try { if (sh.getFilter()) sh.getFilter().remove(); } catch (e) { console.warn('[applySheetFormatting_]', (e && e.message) || String(e)); }
  try { sh.getRange(1, 1, Math.max(2, lastRow), lastCol).createFilter(); } catch (e) { console.warn('[applySheetFormatting_]', (e && e.message) || String(e)); }
  try { sh.setHiddenGridlines(true); } catch (e0) { console.warn('[applySheetFormatting_]', (e0 && e0.message) || String(e0)); }

  // Column width hợp lý
  for (var c = 0; c < headers.length; c++) {
    var h = headers[c];
    var w = 120;
    if (h === 'ImageUrl') w = 260;
    else if (/Address|Notes|Description/.test(h)) w = 260;
    else if (/ProductName|SupplierName|CustomerName|ObjectName/.test(h)) w = 220;
    else if (/ID$|^SKU$|Unit|Role|Type|Direction/.test(h)) w = 118;
    else if (/Status|PaymentStatus/.test(h)) w = 145;
    else if (/Email/.test(h)) w = 210;
    else if (MONEY_COLS.indexOf(h) >= 0) w = 142;
    else if (DATE_COLS.indexOf(h) >= 0) w = 122;
    else if (/Quantity|Stock|Items|Increase|Decrease|Difference/.test(h)) w = 120;
    sh.setColumnWidth(c + 1, w);
  }

  if (lastRow < 2) return;
  var body = sh.getRange(2, 1, dataRows, lastCol);
  body.setFontFamily('Arial').setFontSize(10).setVerticalAlignment('middle').setWrap(false)
    .setBorder(false, false, true, false, false, false, '#eef2f7', SpreadsheetApp.BorderStyle.SOLID);
  sh.setRowHeights(2, dataRows, 34);

  // Định dạng tiền & ngày
  for (var c2 = 0; c2 < headers.length; c2++) {
    var col = c2 + 1;
    var range = sh.getRange(2, col, lastRow - 1, 1);
    if (MONEY_COLS.indexOf(headers[c2]) >= 0) {
      range.setNumberFormat('#,##0" ₫"').setHorizontalAlignment('right').setFontWeight('bold');
    } else if (DATE_COLS.indexOf(headers[c2]) >= 0) {
      range.setNumberFormat('dd/MM/yyyy').setHorizontalAlignment('center');
    } else if (/Quantity|Stock|Items|Increase|Decrease|Difference|MinStock|MaxStock|OpeningStock|CurrentStock/.test(headers[c2])) {
      range.setNumberFormat('#,##0').setHorizontalAlignment('right');
    } else if (/Status|PaymentStatus|Unit|Role|Type|Direction|Method/.test(headers[c2])) {
      range.setHorizontalAlignment('center');
    }
  }

  // Alternating row colors (banding)
  try {
    sh.getRange(1, 1, lastRow, lastCol).getBandings().forEach(function (b) { b.remove(); });
    var banding = sh.getRange(1, 1, lastRow, lastCol).applyRowBanding(SpreadsheetApp.BandingTheme.LIGHT_GREY, true, false);
    banding.setHeaderRowColor(SETUP_TAB_COLORS[internalNameFromSheet_(sh)] || CONFIG.HEADER_BG).setFirstRowColor('#ffffff').setSecondRowColor('#f8fafc');
  } catch (e) { console.warn('[applySheetFormatting_]', (e && e.message) || String(e)); }

  // Conditional formatting cho cột trạng thái
  applyStatusConditionalFormatting_(sh, headers);
  applyDataValidation_(sh, headers);
}

function applyStatusConditionalFormatting_(sh, headers) {
  var lastRow = sh.getLastRow();
  if (lastRow < 2) return;
  var statusColumns = [];
  ['Status', 'PaymentStatus'].forEach(function (name) {
    var idx = headers.indexOf(name);
    if (idx >= 0) statusColumns.push(idx + 1);
  });
  if (!statusColumns.length) return;

  var rules = [];
  var map = [
    { texts: ['Đã thanh toán', 'Còn hàng', 'Đang hoạt động', 'Đang giao dịch', 'Hoàn tất', 'Khớp', 'Tất toán', 'Đã nhận', 'Đã giao'], bg: '#d1fae5', fg: '#065f46' },
    { texts: ['Thanh toán một phần', 'Sắp hết', 'Sắp đến hạn', 'Đang xử lý', 'Đã đặt hàng', 'Đóng gói', 'Sẵn sàng giao hàng', 'Đang vận chuyển', 'Đã gửi KH'], bg: '#fef3c7', fg: '#92400e' },
    { texts: ['Chưa thanh toán'], bg: '#ffedd5', fg: '#9a3412' },
    { texts: ['Quá hạn', 'Hết hàng', 'Lệch', 'Đã hủy', 'Đã huỷ'], bg: '#fee2e2', fg: '#991b1b' },
    { texts: ['Vượt tồn', 'Mới', 'Đã chuyển HĐ', 'Trả lại NCC', 'Trả lại vào kho'], bg: '#ede9fe', fg: '#5b21b6' },
    { texts: ['Ngừng giao dịch', 'Tạm khoá'], bg: '#e5e7eb', fg: '#4b5563' }
  ];
  statusColumns.forEach(function (col) {
    var range = sh.getRange(2, col, lastRow - 1, 1);
    map.forEach(function (m) {
      m.texts.forEach(function (t) {
        rules.push(SpreadsheetApp.newConditionalFormatRule()
          .whenTextEqualTo(t).setBackground(m.bg).setFontColor(m.fg).setRanges([range]).build());
      });
    });
  });
  sh.setConditionalFormatRules(rules);

  // Data validation cho cột Status (dropdown)
  // (không bắt buộc nhưng giúp nhập tay nhất quán)
}

function internalNameFromSheet_(sh) {
  var sheetName = sh.getName();
  for (var k in SHEET_LABELS) if (SHEET_LABELS[k] === sheetName || k === sheetName) return k;
  return sheetName;
}

function statusOptionsForSheet_(name, field) {
  if (field === 'PaymentStatus') return ['Chưa thanh toán', 'Thanh toán một phần', 'Đã thanh toán', 'Đã hủy'];
  var map = {
    Products: ['Còn hàng', 'Sắp hết', 'Hết hàng', 'Vượt tồn'],
    Customers: ['Đang giao dịch', 'Ngừng giao dịch'],
    Suppliers: ['Đang giao dịch', 'Ngừng giao dịch'],
    PurchaseOrders: ['Đã đặt hàng', 'Đã nhập kho', 'Hoàn tất', 'Đã hủy'],
    SalesOrders: ['Đang xử lý', 'Hoàn tất', 'Đã hủy'],
    Quotes: ['Mới', 'Đã gửi KH', 'Đã chuyển HĐ', 'Đã hủy'],
    StockMovements: ['Đang xử lý', 'Đã đặt hàng', 'Đã nhận', 'Đóng gói', 'Sẵn sàng giao hàng', 'Đang vận chuyển', 'Đã giao', 'Đã hủy', 'Trả lại NCC', 'Trả lại vào kho'],
    InventoryChecks: ['Hoàn tất', 'Lệch', 'Khớp'],
    InventoryCheckItems: ['Khớp', 'Lệch'],
    Users: ['Đang hoạt động', 'Tạm khoá'],
    SalesReturns: ['Chờ hoàn tiền', 'Đã hoàn tiền', 'Hoàn tất', 'Đã hủy']
  };
  return map[name] || [];
}

function applyDataValidation_(sh, headers) {
  var lastRow = sh.getLastRow();
  if (lastRow < 2) return;
  var name = internalNameFromSheet_(sh);
  ['Status', 'PaymentStatus'].forEach(function (field) {
    var idx = headers.indexOf(field);
    if (idx < 0) return;
    var opts = statusOptionsForSheet_(name, field);
    if (!opts.length) return;
    var rule = SpreadsheetApp.newDataValidation().requireValueInList(opts, true).setAllowInvalid(true).build();
    sh.getRange(2, idx + 1, Math.max(1, lastRow - 1), 1).setDataValidation(rule);
  });
}

function applyWorkbookPolish_() {
  var ss = getSpreadsheet_();
  var ordered = [README_TAB].concat(SETUP_SHEET_ORDER.map(function (name) { return resolveSheetName_(name); }));
  ordered.forEach(function (tab, idx) {
    var sh = ss.getSheetByName(tab);
    if (!sh) return;
    try { ss.setActiveSheet(sh); ss.moveActiveSheet(idx + 1); } catch (e) { console.warn('[applyWorkbookPolish_]', (e && e.message) || String(e)); }
  });
  Object.keys(SCHEMA).forEach(function (name) {
    var sh = getSheet_(name);
    try { sh.setTabColor(SETUP_TAB_COLORS[name] || CONFIG.HEADER_BG); } catch (e2) { console.warn('[applyWorkbookPolish_]', (e2 && e2.message) || String(e2)); }
    try { sh.setHiddenGridlines(true); } catch (e3) { console.warn('[applyWorkbookPolish_]', (e3 && e3.message) || String(e3)); }
  });
  var readme = ss.getSheetByName(README_TAB);
  if (readme) {
    try { readme.setTabColor('#111827'); readme.setHiddenGridlines(true); } catch (e4) { console.warn('[applyWorkbookPolish_]', (e4 && e4.message) || String(e4)); }
    ss.setActiveSheet(readme);
  }
}

