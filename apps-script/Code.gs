function getReportsData(filters) {
  filters = filters || {};
  var k = '';
  try { k = JSON.stringify(filters); } catch (e) { console.warn('[getReportsData]', (e && e.message) || String(e));  k = String(filters); }
  return cachedPayload_('report:' + k, function () { return buildReportsData_(filters); });
}

function buildReportsData_(filters) {
  try {
    ensureTradingItemSnapshotSchema_();
    filters = filters || {};
    var sales = cachedSheetToObjects_('SalesOrders');
    var salesItems = cachedSheetToObjects_('SalesItems');
    var purchases = cachedSheetToObjects_('PurchaseOrders');
    var purchaseItems = cachedSheetToObjects_('PurchaseItems');
    var products = cachedSheetToObjects_('Products');
    var customers = sheetToObjects_('Customers');
    var suppliers = sheetToObjects_('Suppliers');
    var start = filters.start ? parseDate_(filters.start) : null;
    var end = filters.end ? parseDate_(filters.end) : null;
    if (end && !isNaN(end.getTime())) end.setHours(23, 59, 59, 999);
    function inRange_(v) {
      var d = parseDate_(v);
      if (!d || isNaN(d.getTime())) return true;
      if (start && d < start) return false;
      if (end && d > end) return false;
      return true;
    }
    var returnsAll = cachedSheetToObjects_('SalesReturns');
    sales = sales.filter(function (s) { return inRange_(s.SalesDate) && !isCancelled_(s.Status); });
    purchases = purchases.filter(function (p) { return inRange_(p.PurchaseDate) && !isCancelled_(p.Status); });
    var returns = returnsAll.filter(function (r) { return inRange_(r.ReturnDate); });
    var salesIdMap = {};
    sales.forEach(function (s) { salesIdMap[s.SalesID] = true; });

    var revenue = 0, cost = 0, profit = 0, purchaseTotal = 0;
    var productMap = {}; products.forEach(function (p) { productMap[p.ProductID] = p; });
    var monthly = {};
    sales.forEach(function (s) {
      revenue += netRevenue_(s); cost += toNumber(s.CostAmount); profit += toNumber(s.Profit);
      var d = parseDate_(s.SalesDate);
      if (d && !isNaN(d.getTime())) {
        var k = d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2);
        if (!monthly[k]) monthly[k] = { revenue: 0, cost: 0, profit: 0 };
        monthly[k].revenue += netRevenue_(s);
        monthly[k].cost += toNumber(s.CostAmount);
        monthly[k].profit += toNumber(s.Profit);
      }
    });
    // Trừ hàng trả lại -> doanh thu/lợi nhuận thuần
    returns.forEach(function (r) {
      var rt = toNumber(r.TotalAmount), rc = toNumber(r.CostAmount);
      revenue -= rt; cost -= rc; profit -= (rt - rc);
      var d = parseDate_(r.ReturnDate);
      if (d && !isNaN(d.getTime())) {
        var k = d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2);
        if (!monthly[k]) monthly[k] = { revenue: 0, cost: 0, profit: 0 };
        monthly[k].revenue -= rt; monthly[k].cost -= rc; monthly[k].profit -= (rt - rc);
      }
    });
    purchases.forEach(function (p) { purchaseTotal += toNumber(p.TotalAmount); });
    // Hàng trả lại nhà cung cấp làm GIẢM giá trị mua vào -> "Tổng mua hàng" phải là số THUẦN.
    var prStats = prReturnStats_(start, end);
    var purchaseGross = purchaseTotal;
    var purchaseReturnTotal = prStats.total;
    purchaseTotal = purchaseGross - purchaseReturnTotal;
    var servicePurchaseExpense = servicePurchaseExpense_(purchases, purchaseItems, productMap);
    cost += servicePurchaseExpense;
    profit -= servicePurchaseExpense;
    var purchaseMap = {}; purchases.forEach(function (p) { purchaseMap[p.PurchaseID] = p; });
    purchaseItems.forEach(function (it) {
      var po = purchaseMap[it.PurchaseID], prod = productMap[it.ProductID] || {};
      if (!po || itemProductType_(it, prod) !== 'Service') return;
      var d = parseDate_(po.PurchaseDate); if (!d || isNaN(d.getTime())) return;
      var k = d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2);
      if (!monthly[k]) monthly[k] = { revenue: 0, cost: 0, profit: 0 };
      var amount = toNumber(it.LineTotal || (toNumber(it.Quantity) * toNumber(it.UnitCost)));
      monthly[k].cost += amount; monthly[k].profit -= amount;
    });
    var months = Object.keys(monthly).sort();

    // Top sản phẩm
    var byProd = {};
    salesItems.filter(function (it) { return salesIdMap[it.SalesID]; }).forEach(function (it) {
      var k = it.ProductName || it.ProductID;
      if (!byProd[k]) byProd[k] = { name: k, qty: 0, revenue: 0, profit: 0 };
      byProd[k].qty += toNumber(it.Quantity); byProd[k].revenue += toNumber(it.LineRevenue); byProd[k].profit += toNumber(it.LineProfit);
    });
    var topProducts = Object.keys(byProd).map(function (k) { return byProd[k]; }).sort(function (a, b) { return b.revenue - a.revenue; }).slice(0, 10);

    // Top khách hàng
    var byCust = {};
    sales.forEach(function (s) {
      var k = s.CustomerID || s.CustomerName;
      if (!byCust[k]) byCust[k] = { name: s.CustomerName || k, totalSales: 0, receivable: 0 };
      if (String(s.Status || '') !== 'NO_CU') byCust[k].totalSales += toNumber(s.TotalAmount);
      byCust[k].receivable += toNumber(s.ReceivableAmount);
    });
    var topCustomers = Object.keys(byCust).map(function (k) { return byCust[k]; }).sort(function (a, b) { return b.totalSales - a.totalSales; }).slice(0, 10);

    // Top nhà cung cấp
    var bySup = {};
    purchases.forEach(function (p) {
      var k = p.SupplierID || p.SupplierName;
      if (!bySup[k]) bySup[k] = { name: p.SupplierName || k, totalPurchase: 0, payable: 0 };
      bySup[k].totalPurchase += toNumber(p.TotalAmount);
      bySup[k].payable += toNumber(p.PayableAmount);
    });
    // Trừ phần đã trả lại cho từng NCC -> cột "Tổng mua" trong Top NCC cũng là số thuần.
    Object.keys(prStats.bySupplier).forEach(function (k) {
      var info = prStats.bySupplier[k];
      if (!bySup[k]) bySup[k] = { name: info.name || k, totalPurchase: 0, payable: 0 };
      bySup[k].purchaseReturn = (bySup[k].purchaseReturn || 0) + info.amount;
      bySup[k].purchaseGross = (bySup[k].purchaseGross === undefined ? bySup[k].totalPurchase : bySup[k].purchaseGross);
      bySup[k].totalPurchase -= info.amount;
    });
    Object.keys(bySup).forEach(function (k) {
      if (bySup[k].purchaseGross === undefined) bySup[k].purchaseGross = bySup[k].totalPurchase;
      if (bySup[k].purchaseReturn === undefined) bySup[k].purchaseReturn = 0;
    });
    var topSuppliers = Object.keys(bySup).map(function (k) { return bySup[k]; }).sort(function (a, b) { return b.totalPurchase - a.totalPurchase; }).slice(0, 10);

    // Báo cáo tồn kho
    var inventoryReport = products.map(function (p) {
      // Giữ tên khóa StockValue (không đổi thành "value") vì đây là giá trị tồn TÍNH THEO GIÁ VỐN,
      // phải bị gỡ đi với người không có quyền xem giá vốn.
      return { name: p.ProductName, sku: p.SKU, current: toNumber(p.CurrentStock), StockValue: toNumber(p.StockValue), status: p.Status };
    }).sort(function (a, b) { return b.value - a.value; });

    var chartStart = start || (sales.length && sales[0].SalesDate ? parseDate_(sales[0].SalesDate) : new Date());
    if (!chartStart || isNaN(chartStart.getTime())) chartStart = new Date();
    var chartEnd = end ? new Date(end.getTime() + 1) : new Date();
    if (chartEnd <= chartStart) chartEnd = new Date(chartStart.getTime() + 86400000);
    var rangeChart = chartSalesRange_(sales, returns, chartStart, chartEnd, filters.groupBy || 'auto');

    return ok_({
      summary: {
        revenue: revenue, cost: cost, profit: profit,
        purchaseTotal: purchaseTotal,          // đã TRỪ hàng trả lại NCC
        purchaseGross: purchaseGross,          // mua vào trước khi trừ
        purchaseReturn: purchaseReturnTotal,   // giá trị đã trả lại NCC
        purchaseReturnCount: prStats.count
      },
      monthly: {
        months: months,
        revenue: months.map(function (m) { return Math.round(monthly[m].revenue); }),
        cost: months.map(function (m) { return Math.round(monthly[m].cost); }),
        profit: months.map(function (m) { return Math.round(monthly[m].profit); })
      },
      chart: rangeChart,
      topProducts: topProducts, topCustomers: topCustomers, topSuppliers: topSuppliers,
      inventory: inventoryReport
    });
  } catch (e) { return err_(e.message); }
}

