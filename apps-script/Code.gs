function getCashAccounts() { try { recalculateCashAccounts(); return ok_(sheetToObjects_('CashAccounts')); } catch (e) { return err_(e.message); } }
function createCashAccount(data) {
  return withMutationLock_(['CashAccounts', 'FinanceTransactions'], function () {
    data = data || {}; var now = financeNow_();
    if (!data.AccountName) return err_('Vui lòng nhập tên tài khoản tiền.');
