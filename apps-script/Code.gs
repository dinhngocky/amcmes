function customerDebtReminderGroups_() {
  var today = new Date(); today.setHours(0, 0, 0, 0);
  var customers = {};
  sheetToObjects_('Customers').forEach(function (c) { customers[c.CustomerID] = c; });
  var groups = {};
  sheetToObjects_('SalesOrders').filter(function (s) {
    return toNumber(s.ReceivableAmount) > 0 && s.CustomerID && s.DueDate && new Date(s.DueDate) < today;
  }).forEach(function (s) {
    (groups[s.CustomerID] = groups[s.CustomerID] || { customer: customers[s.CustomerID] || { CustomerID: s.CustomerID, CustomerName: s.CustomerName }, invoices: [] }).invoices.push(s);
  });
  return groups;
}

function debtReminderLastSentMap_() {
  var props = PropertiesService.getScriptProperties(), data = {};
  Object.keys(customerDebtReminderGroups_()).forEach(function (cid) {
    data[cid] = props.getProperty('DebtReminderLastSent_' + cid) || '';
  });
  return data;
}

function daysSince_(dateText) {
  if (!dateText) return 99999;
  var d = new Date(dateText);
  if (isNaN(d.getTime())) return 99999;
  var today = new Date(); today.setHours(0, 0, 0, 0);
  d.setHours(0, 0, 0, 0);
  return Math.floor((today.getTime() - d.getTime()) / 86400000);
}

function getCustomerDebtReminderCandidates() {
  try {
    var st = settings_();
    var interval = Math.max(1, toNumber(st.CustomerReminderIntervalDays || 7) || 7);
    var groups = customerDebtReminderGroups_();
    var last = debtReminderLastSentMap_();
    var rows = Object.keys(groups).map(function (cid) {
      var g = groups[cid], c = g.customer || {};
      var total = g.invoices.reduce(function (a, s) { return a + toNumber(s.ReceivableAmount); }, 0);
      var oldest = g.invoices.reduce(function (a, s) {
        var d = s.DueDate ? new Date(s.DueDate) : null;
        return (!a || (d && d < a)) ? d : a;
      }, null);
      var lastSent = last[cid] || '';
      return {
        CustomerID: cid,
        CustomerName: c.CustomerName || g.invoices[0].CustomerName || cid,
        Email: c.Email || '',
        Phone: c.Phone || '',
        InvoiceCount: g.invoices.length,
        TotalDebt: total,
        OldestDueDate: oldest || '',
        LastSent: lastSent,
        CanSendNow: !!(c.Email) && daysSince_(lastSent) >= interval,
        WaitDays: Math.max(0, interval - daysSince_(lastSent))
      };
    }).sort(function (a, b) { return b.TotalDebt - a.TotalDebt; });
    return ok_({ intervalDays: interval, rows: rows });
  } catch (e) { return err_(e.message); }
}

function sendCustomerDebtReminders(customerIds, force) {
  try {
    customerIds = Array.isArray(customerIds) ? customerIds : [];
    if (!customerIds.length) return err_('Chưa chọn khách hàng cần gửi nhắc công nợ.');
    var st = settings_(), business = st.BusinessName || 'AMCVN';
    var interval = Math.max(1, toNumber(st.CustomerReminderIntervalDays || 7) || 7);
    var groups = customerDebtReminderGroups_();
    var props = PropertiesService.getScriptProperties();
    var todayText = Utilities.formatDate(new Date(), getTz_(), 'yyyy-MM-dd');
    var sent = 0, skipped = 0, errors = [];
    customerIds.forEach(function (cid) {
      var g = groups[cid];
      if (!g) { skipped++; return; }
      var c = g.customer || {};
      if (!c.Email) { skipped++; errors.push((c.CustomerName || cid) + ': chưa có email'); return; }
      var lastSent = props.getProperty('DebtReminderLastSent_' + cid) || '';
      if (!force && daysSince_(lastSent) < interval) { skipped++; return; }
      var email = buildCustomerDebtReminderEmail_(business, c, g.invoices, st);
      try {
        MailApp.sendEmail({ to: c.Email, subject: email.subject, htmlBody: email.html });
        props.setProperty('DebtReminderLastSent_' + cid, todayText);
        sent++;
      } catch (e) { console.warn('[sendCustomerDebtReminders]', (e && e.message) || String(e));  skipped++; errors.push((c.CustomerName || cid) + ': ' + e.message); }
    });
    return ok_({ sent: sent, skipped: skipped, errors: errors }, 'Đã gửi ' + sent + ' email nhắc công nợ' + (skipped ? ', bỏ qua ' + skipped : ''));
  } catch (e) { return err_(e.message); }
}

