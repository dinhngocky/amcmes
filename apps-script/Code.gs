function ensureSalesInventory_(salesId, editAllowance) {
  var so = sheetToObjects_('SalesOrders').filter(function (s) { return s.SalesID === salesId; })[0];
  if (!so) throw new Error('Không tìm thấy hóa đơn');
  // Đã có biến động xuất kho cho hóa đơn này -> KHÔNG xuất lại (tránh trừ tồn 2 lần khi đổi trạng thái).
  // Lọc theo SourceID (duy nhất) vì SourceType trong sheet đã bị dịch sang tiếng Việt ('Hóa đơn'), so 'SalesOrder' sẽ luôn trượt.
  if (sheetToObjects_('StockMovements').filter(function (m) { return m.SourceID === salesId; }).length) return;
  var items = sheetToObjects_('SalesItems').filter(function (i) { return i.SalesID === salesId; });
  var pMap = {}; sheetToObjects_('Products').forEach(function (p) { pMap[p.ProductID] = p; });
  editAllowance = editAllowance || {};
  for (var i = 0; i < items.length; i++) {
    var pp = pMap[items[i].ProductID];
    if (pp) {
      if (pp.ProductType === 'Service' || pp.Category === 'Dịch vụ') continue;
      var available = toNumber(pp.CurrentStock) + toNumber(editAllowance[items[i].ProductID]);
      if (toNumber(items[i].Quantity) > available) throw new Error('Không đủ tồn để xuất "' + items[i].ProductName + '" (tồn hiện tại: ' + toNumber(pp.CurrentStock) + ', đã có trong phiếu: ' + toNumber(editAllowance[items[i].ProductID]) + ')');
    }
  }
  var mids = generateIds('MV', items.length); var rows = [];
  items.forEach(function (it, idx) {
    var p = pMap[it.ProductID];
    if (!p) throw new Error('Không tìm thấy sản phẩm ' + it.ProductID);
    if (!isServiceProduct_(p)) {
      rows.push({
        MovementID: mids[idx],
        Date: so.SalesDate ? new Date(so.SalesDate) : new Date(),
        Type: 'SaleOut', SourceType: 'SalesOrder', SourceID: salesId, ProductID: it.ProductID, SKU: it.SKU, ProductName: it.ProductName, QuantityIn: 0, QuantityOut: toNumber(it.Quantity), UnitCost: toNumber(it.CostPrice), UnitPrice: toNumber(it.SalePrice), StockAfter: '', CreatedBy: getUser_(), Notes: 'Xuất cho ' + salesId, CreatedAt: new Date(), Status: 'Đã giao'
        });
      }
    });
