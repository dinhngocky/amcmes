function menuAuthorizeAll_() {
  try {
    var ss = getSpreadsheet_();
    ss.getId();
    PropertiesService.getScriptProperties().setProperty('NEXUPONE_AUTH_CHECK', String(new Date().getTime()));
    CacheService.getScriptCache().put('NEXUPONE_AUTH_CHECK', 'ok', 30);

    var folder = DriveApp.getRootFolder();
    var temp = folder.createFile('AMCVN_authorization_check.txt', 'AMCVN authorization check');
    temp.setTrashed(true);

    MailApp.getRemainingDailyQuota();
    UrlFetchApp.fetch('https://www.google.com/generate_204', { muteHttpExceptions: true });

    try {
      ScriptApp.newTrigger('nexupOneAuthNoop_').timeBased().after(60 * 60 * 1000).create();
      ScriptApp.getProjectTriggers().forEach(function (t) {
        try {
          if (t.getHandlerFunction && t.getHandlerFunction() === 'nexupOneAuthNoop_') ScriptApp.deleteTrigger(t);
        } catch (ignoreDelete) { console.warn('[menuAuthorizeAll_]', (ignoreDelete && ignoreDelete.message) || String(ignoreDelete)); }
      });
    } catch (triggerErr) { console.warn('[menuAuthorizeAll_]', (triggerErr && triggerErr.message) || String(triggerErr)); 
      // Một số tài khoản Google báo lỗi tạm thời ở deleteTrigger/createTrigger.
      // Các tính năng trigger thật vẫn sẽ tự xin quyền khi bật lịch nhắc nợ/sao lưu.
    }

    Utilities.newBlob('<html><body>AMCVN</body></html>', 'text/html', 'AMCVN.html').getAs('application/pdf');

    SpreadsheetApp.getUi().alert('AMCVN đã được cấp quyền thành công. Bạn có thể dùng WebApp, upload ảnh, gửi email, sao lưu, xuất PDF và bật lịch nhắc nợ.');
    return 'AUTHORIZED';
  } catch (e) { console.warn('[menuAuthorizeAll_]', (e && e.message) || String(e)); 
    SpreadsheetApp.getUi().alert('Cấp quyền chưa hoàn tất: ' + e.message + '\n\nHãy bấm lại menu AMCVN > Cấp quyền toàn bộ và chọn Cho phép.');
    throw e;
  }
}

