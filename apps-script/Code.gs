/* ============================================================================
 *  AMC MODULE: IN TEM QR (BẢN ĐƠN GIẢN — TỔNG HỢP THEO PHIẾU NHẬN)
 *
 *  TRIẾT LÝ:
 *   - In tem dựa trên dòng nhận hàng (WarehouseReceiptItems) — có đủ thông tin
 *     về phiếu nhập, PO, dự án, máy, cụm, vị trí.
 *   - Với sản phẩm chỉ có tồn kho (không gắn phiếu nhận) → vẫn in được, dùng
 *     thông tin cơ bản từ Products.
 *   - KHÔNG theo dõi tem đã in hay chưa. KHÔNG sinh LabelCode.
 *   - Người dùng chọn dòng cần in, hệ thống in ngay.
 * ==========================================================================*/

/**
 * Danh sách dòng nhận hàng (đã có SL) để in tem.
 * Mỗi dòng có đầy đủ: phiếu nhập, PO, dự án, máy, cụm, vị trí, số lượng.
 *
 * filters: { search, receiptId, warehouseId, projectCode, includeZero }
 */
function getReceiptLinesForPrint(filters) {
  try {
    filters = filters || {};
    var q = String(filters.search || '').trim().toLowerCase();
    var receiptId = String(filters.receiptId || '').trim();
    var warehouseId = String(filters.warehouseId || '').trim();
    var projectCode = String(filters.projectCode || '').trim();
    var includeZero = !!filters.includeZero;

    // Gom metadata 1 lần
    var receiptMap = {};
    sheetToObjects_('WarehouseReceipts').forEach(function (r) { receiptMap[r.ReceiptID] = r; });

    var reqMap = {};
    sheetToObjects_('MaterialRequirements').forEach(function (r) { reqMap[r.RequirementID] = r; });

    var machineMap = {};
    sheetToObjects_('Machines').forEach(function (m) { machineMap[m.MachineID] = m; });

    var moduleMap = {};
    sheetToObjects_('MachineModules').forEach(function (m) { moduleMap[m.ModuleID] = m; });

    var projectMap = {};
    sheetToObjects_('Projects').forEach(function (p) { projectMap[p.ProjectID] = p; });

    var productMap = {};
    sheetToObjects_('Products').forEach(function (p) { productMap[p.ProductID] = p; });

    // ── Phần A: Dòng nhận hàng ───────────────────────────────────
    var rows = [];
    sheetToObjects_('WarehouseReceiptItems').forEach(function (x) {
      var receipt = receiptMap[x.ReceiptID] || {};
      var req = x.RequirementID ? (reqMap[x.RequirementID] || {}) : {};
      var product = productMap[x.ProductID] || {};
      var mode=inventoryMode_(x.InventoryMode);
      var machineId = mode==='DEDICATED'?(x.MachineID||req.MachineID||''):'';
      var moduleId = mode==='DEDICATED'?(x.ModuleID||req.ModuleID||''):'';
      var machine = machineId ? (machineMap[machineId] || {}) : {};
      var moduleRow = moduleId ? (moduleMap[moduleId] || {}) : {};
      var projectId = mode==='DEDICATED'?(x.ProjectID||req.ProjectID||machine.ProjectID||''):'';
      var project = projectId ? (projectMap[projectId] || {}) : {};

      // SL đạt IQC nếu có, không thì dùng SL đã nhận
      var iqcStatus=amcvnText_(x.IQCStatus).toUpperCase();
      var qty=iqcStatus==='PENDING'?toNumber(x.ReceivedQty):toNumber(x.AcceptedQty);
      if (!includeZero && qty <= 0) return;

      // Lọc theo phiếu nhận
      if (receiptId && String(x.ReceiptID) !== receiptId) return;
      // Lọc theo kho
      if (warehouseId && String(receipt.WarehouseID || '') !== warehouseId) return;
      // Lọc theo dự án
      if (projectCode) {
        var pc = String(project.ProjectCode || req.ProjectCode || '').trim().toLowerCase();
        if (pc.indexOf(projectCode.toLowerCase()) < 0) return;
      }
      // Tìm kiếm tự do
      if (q) {
        var hay = [
          x.PartNumber, x.SKU, x.ProductName,
          product.BrandMaterial, product.PartNumber, product.SKU,
          x.ReceiptID, receipt.PurchaseID, project.ProjectCode,
          machine.MachineCode, machine.MachineName,
          moduleRow.ModuleCode, moduleRow.ModuleName
        ].join(' ').toLowerCase();
        if (hay.indexOf(q) < 0) return;
      }

      // QR mới: Mã hàng | Số PO | Số dự án | Số lượng
      var partNo = x.PartNumber || product.PartNumber || product.SKU || '';
      var po     = receipt.PurchaseID || req.PurchaseID || '';
      var projCd = project.ProjectCode || req.ProjectCode || '';
      var qrValue = [partNo, po, projCd, String(Math.round(qty))].join('|');

      rows.push({
        _key: 'RCVI:' + x.ReceiptItemID,
        Source: 'RECEIPT',
        ReceiptItemID: x.ReceiptItemID,
        ReceiptID: x.ReceiptID,
        ProductID: x.ProductID,
        PartNumber: partNo,
        SKU: x.SKU || product.SKU || '',
        ProductName: x.ProductName || product.ProductName || '',
        BrandMaterial: product.BrandMaterial || '',
        Unit: x.Unit || product.Unit || '',
        Quantity: qty,
        PurchaseID: po,
        ProjectCode: projCd,
        MachineCode: machine.MachineCode || '',
        MachineName: machine.MachineName || '',
        ModuleCode: moduleRow.ModuleCode || '',
        ModuleName: moduleRow.ModuleName || '',
        LocationCode: x.LocationCode || '',
        LotNo: x.LotNo || '',
        WarehouseID: receipt.WarehouseID || '',
        WarehouseName: receipt.WarehouseName || '',
        QRValue: qrValue,
        ReceiptDate: receipt.ReceiptDate || '',
        InventoryMode: mode
      });
    });

    // ── Phần B: Sản phẩm chỉ có tồn (không gắn phiếu nhận) ──────
    // Chỉ thêm khi KHÔNG lọc theo phiếu nhận
    if (!receiptId) {
      // Tập hợp ProductID đã xuất hiện ở phần A
      var seenProducts = {};
      rows.forEach(function (r) { seenProducts[r.ProductID] = true; });

      // Tồn theo kho nếu có lọc
      var def = null;
      try { def = whDefault_(); } catch (e) { console.warn('[getReceiptLinesForPrint]', (e && e.message) || String(e));  def = null; }
      var defWhId = def ? def.WarehouseID : '';
      var defWhName = def ? def.WarehouseName : '';

      var stockByWarehouse = {};
      if (warehouseId) {
        sheetToObjects_('StockMovements').forEach(function (m) {
          if (String(m.WarehouseID || defWhId) !== String(warehouseId)) return;
          stockByWarehouse[m.ProductID] = (stockByWarehouse[m.ProductID] || 0) + movementEffective_(m);
        });
      }

      sheetToObjects_('Products').forEach(function (p) {
        if (isServiceProduct_(p)) return;
        if (seenProducts[p.ProductID]) return;   // đã có ở phần A

        var qty = warehouseId
          ? (stockByWarehouse[p.ProductID] || 0)
          : toNumber(p.CurrentStock);
        if (!includeZero && qty <= 0) return;

        if (q) {
          var hay = [p.PartNumber, p.SKU, p.ProductName, p.BrandMaterial].join(' ').toLowerCase();
          if (hay.indexOf(q) < 0) return;
        }

        var partNo = p.PartNumber || p.SKU || '';
        var qrValue = [partNo, '', '', String(Math.round(qty))].join('|');

        rows.push({
          _key: 'PROD:' + p.ProductID,
          Source: 'STOCK',
          ReceiptItemID: '',
          ReceiptID: '',
          ProductID: p.ProductID,
          PartNumber: partNo,
          SKU: p.SKU || '',
          ProductName: p.ProductName || '',
          BrandMaterial: p.BrandMaterial || '',
          Unit: p.Unit || '',
          Quantity: qty,
          PurchaseID: '',
          ProjectCode: '',
          MachineCode: '',
          MachineName: '',
          ModuleCode: '',
          ModuleName: '',
          LocationCode: '',
          LotNo: '',
          WarehouseID: warehouseId || defWhId,
          WarehouseName: warehouseId
            ? ((whById_(warehouseId) || {}).WarehouseName || '')
            : defWhName,
          QRValue: qrValue,
          ReceiptDate: '',
          InventoryMode: 'COMMON'
        });
      });
    }

    // Sắp xếp: mới nhận lên trước, sau đó theo tên
    rows.sort(function (a, b) {
      var ta = a.ReceiptDate ? new Date(a.ReceiptDate).getTime() : 0;
      var tb = b.ReceiptDate ? new Date(b.ReceiptDate).getTime() : 0;
      if (ta !== tb) return tb - ta;
      return String(a.ProductName).localeCompare(String(b.ProductName), 'vi');
    });

    return ok_(rows);
  } catch (e) { return err_(e.message); }
}

/**
 * Danh sách phiếu nhận hàng để lọc.
 */
function getReceiptsForFilter() {
  try {
    var rows = sheetToObjects_('WarehouseReceipts').map(function (r) {
      return {
        ReceiptID: r.ReceiptID,
        ReceiptDate: r.ReceiptDate || '',
        PurchaseID: r.PurchaseID || '',
        SupplierName: r.SupplierName || '',
        WarehouseName: r.WarehouseName || ''
      };
    });
    rows.sort(function (a, b) {
      return new Date(b.ReceiptDate || 0) - new Date(a.ReceiptDate || 0);
    });
    return ok_(rows);
  } catch (e) { return err_(e.message); }
}

/**
 * Danh sách dự án để lọc.
 */
function getProjectsForFilter() {
  try {
    var rows = sheetToObjects_('Projects').map(function (p) {
      return {
        ProjectID: p.ProjectID,
        ProjectCode: p.ProjectCode || '',
        ProjectName: p.ProjectName || ''
      };
    });
    rows.sort(function (a, b) {
      return String(a.ProjectCode).localeCompare(String(b.ProjectCode));
    });
    return ok_(rows);
  } catch (e) { return err_(e.message); }
}

