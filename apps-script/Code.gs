function updateProject(projectId, data) {
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked', ['Projects'], function () { return updateProject(projectId, data); });
  try {
    var old = amcvnFind_('Projects', 'ProjectID', projectId);
    if (!old) return err_('Không tìm thấy dự án.', 'ERR_NOT_FOUND');
    var upd = amcvnPick_(data, ['ProjectCode', 'ProjectName', 'CustomerID', 'CustomerName', 'ProjectType',
      'PM', 'SCM', 'KickoffDate', 'TargetFATDate', 'TargetDeliveryDate', 'Status', 'Priority', 'RiskLevel', 'Notes']);
    if (upd.ProjectCode !== undefined) {
      upd.ProjectCode = amcvnText_(upd.ProjectCode).toUpperCase();
      if (!upd.ProjectCode) return err_('Mã dự án không được để trống.');
      if (amcvnCodeExists_('Projects', 'ProjectCode', upd.ProjectCode, 'ProjectID', projectId)) return err_('Mã dự án đã tồn tại.');
    }
    if (upd.ProjectName !== undefined && !amcvnText_(upd.ProjectName)) return err_('Tên dự án không được để trống.');
    if (upd.CustomerID !== undefined || upd.CustomerName !== undefined) {
      var customer = amcvnCustomerRef_(upd.CustomerID !== undefined ? upd.CustomerID : old.CustomerID,
        upd.CustomerName !== undefined ? upd.CustomerName : old.CustomerName);
      upd.CustomerID = customer.CustomerID; upd.CustomerName = customer.CustomerName;
    }
    upd.UpdatedAt = new Date();
    updateRowById('Projects', 'ProjectID', projectId, upd);
    if (upd.ProjectCode && upd.ProjectCode !== old.ProjectCode) {
      var machineUpdates = {};
      sheetToObjects_('Machines').forEach(function (m) { if (String(m.ProjectID) === String(projectId)) machineUpdates[m.MachineID] = { ProjectCode: upd.ProjectCode, UpdatedAt: new Date() }; });
      updateRowsById_('Machines', 'MachineID', machineUpdates);
    }
    writeAudit_('Cập nhật dự án', 'Project', projectId, old.ProjectCode || projectId);
    return ok_(amcvnFind_('Projects', 'ProjectID', projectId), 'Đã cập nhật dự án');
