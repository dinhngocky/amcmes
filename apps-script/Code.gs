/**
 * Thay toàn bộ các dòng nguồn bằng các dòng phân bổ theo cụm.
 * Tổng QtyPerMachine và SpareQty của từng nhóm bắt buộc giữ nguyên.
 */
function saveBOMModuleAllocations(versionId, groups) {
  groups = Array.isArray(groups) ? groups : [];
  return withMutationLock_(['MachineBOMVersions','MachineBOMLines','MachineModules','AuditLog'], function () {
    try {
      var version = machineBomVersion_(versionId);
      if (!version) throw new Error('Không tìm thấy phiên bản BOM.');
      if (!machineBomDraft_(version)) throw new Error('Chỉ được phân cụm trên BOM DRAFT.');
      if (!groups.length) throw new Error('Không có dữ liệu phân bổ để lưu.');
      if (groups.length > 2000) throw new Error('Mỗi lần chỉ xử lý tối đa 2.000 nhóm vật tư.');

      var allLines = machineBomLines_(versionId);
      var lineMap = {}, modules = {}, used = {}, deleteIds = [], newRows = [], now = new Date(), user = getUser_();
      allLines.forEach(function (x) { lineMap[String(x.BOMLineID)] = x; });
      sheetToObjects_('MachineModules').filter(function (m) {
        return String(m.MachineID) === String(version.MachineID);
      }).forEach(function (m) { modules[String(m.ModuleID)] = m; });

      groups.forEach(function (g, gi) {
        var ids = Array.isArray(g.SourceLineIDs) ? g.SourceLineIDs.map(String) : [];
        if (!ids.length) throw new Error('Nhóm ' + (gi + 1) + ' không có dòng nguồn.');
        var source = ids.map(function (id) {
          if (used[id]) throw new Error('Dòng BOM được gửi lặp lại: ' + id);
          used[id] = true;
          var line = lineMap[id];
          if (!line) throw new Error('Dòng BOM không còn tồn tại: ' + id);
          deleteIds.push(id);
          return line;
        });
        var first = source[0], productId = String(first.ProductID || '');
        if (source.some(function (x) { return String(x.ProductID || '') !== productId; })) {
          throw new Error('Nhóm ' + (gi + 1) + ' chứa nhiều mã vật tư khác nhau.');
        }

        var expectedUse = source.reduce(function (n, x) { return n + Math.max(0, toNumber(x.QtyPerMachine)); }, 0);
        var expectedSpare = source.reduce(function (n, x) { return n + Math.max(0, toNumber(x.SpareQty)); }, 0);
        var allocs = (Array.isArray(g.Allocations) ? g.Allocations : []).map(function (a) {
          return { ModuleID: String(a.ModuleID || ''), Quantity: Math.max(0, toNumber(a.Quantity)) };
        }).filter(function (a) { return a.Quantity > 0; });
        var allocated = allocs.reduce(function (n, a) { return n + a.Quantity; }, 0);
        if (Math.abs(allocated - expectedUse) > 0.000001) {
          throw new Error((first.PartNumber || first.SKU || first.ProductName) + ': tổng phân bổ ' + allocated + ' phải bằng SL lắp ' + expectedUse + '.');
        }
        var seenModule = {};
        allocs.forEach(function (a) {
          var mk = a.ModuleID || '__UNASSIGNED__';
          if (seenModule[mk]) throw new Error((first.PartNumber || first.SKU) + ': một cụm bị lặp nhiều dòng.');
          seenModule[mk] = true;
          var module = a.ModuleID ? modules[a.ModuleID] : null;
          if (a.ModuleID && !module) throw new Error('Cụm không thuộc máy: ' + a.ModuleID);
          var row = {};
          SCHEMA.MachineBOMLines.forEach(function (k) { row[k] = first[k] == null ? '' : first[k]; });
          row.BOMLineID = ''; row.RootLineID = ''; row.ChangeType = ''; row.BOMVersionID = versionId;
          row.ModuleID = module ? module.ModuleID : '';
          row.ModuleCode = module ? module.ModuleCode : '';
          row.ModuleName = module ? module.ModuleName : '';
          row.ModuleDrawingNo = module ? (module.ModuleDrawingNo || first.ModuleDrawingNo || '') : '';
          row.ModuleQty = 1;
          row.QtyPerModule = a.Quantity;
          row.QtyPerMachine = a.Quantity;
          row.SpareQty = 0;
          row.RequiredQty = a.Quantity;
          row.CreatedBy = user; row.CreatedAt = now; row.UpdatedAt = now;
          newRows.push(row);
        });
        if (expectedSpare > 0) {
          var spare = {};
          SCHEMA.MachineBOMLines.forEach(function (k) { spare[k] = first[k] == null ? '' : first[k]; });
          spare.BOMLineID = ''; spare.RootLineID = ''; spare.ChangeType = ''; spare.BOMVersionID = versionId;
          spare.ModuleID = ''; spare.ModuleCode = ''; spare.ModuleName = '';
          spare.ModuleQty = 0; spare.QtyPerModule = 0; spare.QtyPerMachine = 0;
          spare.SpareQty = expectedSpare; spare.RequiredQty = expectedSpare;
          spare.Notes = (amcvnText_(first.Notes) + ' [DỰ PHÒNG CHUNG]').trim();
          spare.CreatedBy = user; spare.CreatedAt = now; spare.UpdatedAt = now;
          newRows.push(spare);
        }
      });

      var newIds = generateIds('MBL', newRows.length);
      newRows.forEach(function (x, i) { x.BOMLineID = newIds[i]; });
      removeBOMLinesV224_(versionId, deleteIds);
      if (newRows.length) appendRows('MachineBOMLines', newRows);
      var count = machineBomLines_(versionId).length;
      updateRowById('MachineBOMVersions','BOMVersionID',versionId,{TotalLines:count,UpdatedAt:now});
      writeAudit_('Phân bổ vật tư BOM theo cụm','MachineBOMVersion',versionId,
        groups.length+' mã · '+deleteIds.length+' dòng cũ → '+newRows.length+' dòng phân bổ');
      return ok_({groups:groups.length,removed:deleteIds.length,created:newRows.length,totalLines:count},
        'Đã phân bổ '+groups.length+' mã vật tư thành '+newRows.length+' dòng theo cụm; tổng số lượng được giữ nguyên.');
    } catch (e) { return err_(e.message); }
  });
}
