/** Lấy giá trị đầu tiên tìm được trong object theo danh sách khóa. */
function auditPick_(obj, keys) {
  if (!obj || typeof obj !== 'object') return '';
  for (var i = 0; i < keys.length; i++) {
    var v = obj[keys[i]];
    if (v !== undefined && v !== null && String(v) !== '') return v;
  }
  return '';
}

/** Mã chứng từ liên quan: ưu tiên kết quả trả về, sau đó tới tham số. */
function auditEntityId_(args, out) {
  var ID_KEYS = ['SalesID', 'PurchaseID', 'QuoteID', 'ReturnID', 'PurchaseReturnID', 'PaymentID',
    'MovementID', 'CheckID', 'ProductionID', 'TransactionID', 'TransferID', 'PayrollID', 'EmployeeID',
    'ShiftID', 'WarehouseID', 'ProductID', 'CustomerID', 'SupplierID', 'AccountID', 'CategoryID',
    'BudgetID', 'UserID'];
  var d = out && out.data;
  if (d && typeof d === 'object' && !Array.isArray(d)) {
    var fromOut = auditPick_(d, ID_KEYS);
    if (fromOut) return String(fromOut);
    if (d.order) { var o = auditPick_(d.order, ID_KEYS); if (o) return String(o); }
  }
  for (var i = 0; i < args.length; i++) {
    var a = args[i];
    if (typeof a === 'string' && a && a.length <= 40 && /^[A-Za-z]{1,4}[-0-9]/.test(a)) return a;
    if (a && typeof a === 'object' && !Array.isArray(a)) {
      var fromArg = auditPick_(a, ID_KEYS);
      if (fromArg) return String(fromArg);
    }
  }
  return '';
}

/** Câu mô tả ngắn: đối tác + số tiền + ghi chú, để đọc nhật ký là hiểu ngay. */
function auditDetail_(fn, args, out) {
  var parts = [];
  var NAME_KEYS = ['CustomerName', 'SupplierName', 'ObjectName', 'ProductName', 'AccountName',
    'CategoryName', 'FullName', 'BudgetName', 'WarehouseName', 'EmployeeName', 'Username'];
  var MONEY_KEYS = ['TotalAmount', 'Amount', 'RefundAmount', 'PaidAmount', 'NetPay', 'amount', 'total'];
  var src = null;
  var d = out && out.data;
  if (d && typeof d === 'object' && !Array.isArray(d)) src = d;
  for (var i = 0; i < args.length && !src; i++) {
    if (args[i] && typeof args[i] === 'object' && !Array.isArray(args[i])) src = args[i];
  }
  var name = auditPick_(src, NAME_KEYS);
  if (name) parts.push(String(name));
  var money = auditPick_(src, MONEY_KEYS);
  if (money !== '' && toNumber(money) > 0) parts.push(formatMoney_(toNumber(money)));

  // Sửa nhanh trên bảng: nói rõ đổi trường nào thành gì.
  if (fn === 'updateField' && args.length >= 5) {
    parts.push(String(args[3]) + ' -> ' + String(args[4]));
  }
  if (fn === 'bulkDelete' && args.length >= 2) {
    parts.push('Loại: ' + String(args[0]) + ', ' + (Array.isArray(args[1]) ? args[1].length : 0) + ' mục');
  }
  // Nhập từ file: lấy luôn câu tổng kết của máy chủ.
  if (/^bulkImport|^importFinance/.test(fn) && out && out.message) parts.push(String(out.message));
  if (!parts.length && out && out.message) parts.push(String(out.message));
  return parts.join(' · ').slice(0, 480);
}

/** Ghi một dòng nhật ký cho lời gọi vừa chạy xong (chỉ dùng trong apiCall). */
function auditAuto_(fn, args, out, moduleId) {
  try {
    var meta = FN_AUDIT_[fn];
    var action = meta ? meta[0] : ('Thao tác: ' + fn);
    var entity = meta ? meta[1] : (authModuleLabel_(moduleId) || '');
    appendRow('AuditLog', {
      Time: new Date(), User: getUser_(), Action: action, Entity: entity,
      EntityID: auditEntityId_(args || [], out), Detail: auditDetail_(fn, args || [], out),
      UserID: (AUTH_CTX_ && AUTH_CTX_.UserID) || '', Module: moduleId || ''
    });
  } catch (e) { console.warn('[auditAuto_]', (e && e.message) || String(e));  /* nhật ký hỏng thì thôi, không được làm hỏng nghiệp vụ */ }
}
