}

/** Số hóa đơn không được trùng nhau trong cùng một sổ. */
function checkInvoiceNo(sheetName, invoiceNo, exceptId) {
  try {
    var no = String(invoiceNo || '').trim();
    if (!no) return ok_({ duplicate: false });
    var idKey = sheetName === 'PurchaseOrders' ? 'PurchaseID' : 'SalesID';
    var hit = sheetToObjects_(sheetName).filter(function (r) {
      return String(r.InvoiceNo || '').trim() === no && String(r[idKey]) !== String(exceptId || '');
    })[0];
    return ok_({ duplicate: !!hit, docId: hit ? hit[idKey] : '' },
      hit ? ('Số hóa đơn ' + no + ' đã dùng cho chứng từ ' + hit[idKey]) : '');
  } catch (e) { return err_(e.message); }
}

/**
 * BÁO CÁO THUẾ GTGT theo từng mức thuế suất.
 * kind: 'out' thuế đầu ra (bán) | 'in' thuế đầu vào (mua) | 'all' cả hai.
 */
function getVatReport(filters) {
  try {
    filters = filters || {};
    var from = filters.from ? new Date(String(filters.from) + 'T00:00:00') : null;
    var to = filters.to ? new Date(String(filters.to) + 'T23:59:59') : null;
    var inRange = function (d) {
      var x = parseDate_(d);
      if (!x || isNaN(x.getTime())) return false;
      if (from && x < from) return false;
      if (to && x > to) return false;
      return true;
    };
    var kind = filters.kind || 'all';

    function build(docSheet, itemSheet, idKey, dateKey, amountKey, partyKey) {
      var docs = sheetToObjects_(docSheet).filter(function (d) {
        return !isCancelled_(String(d.Status || '')) && String(d.Status || '') !== 'NO_CU' && inRange(d[dateKey]);
      });
      var keep = {};
      docs.forEach(function (d) { keep[String(d[idKey])] = d; });
      var items = sheetToObjects_(itemSheet).filter(function (i) { return keep[String(i[idKey])]; });
      var byRate = {};
      var rows = [];
      items.forEach(function (i) {
        var d = keep[String(i[idKey])];
        var p = toNumber(i.VATPercent);
        var a = toNumber(i.VATAmount);
        var amount = toNumber(i[amountKey]);
        var b = byRate[p] || (byRate[p] = { rate: p, base: 0, vat: 0, lines: 0 });
        b.base += amount; b.vat += a; b.lines++;
      });
      docs.forEach(function (d) {
        rows.push({
          DocID: d[idKey], Date: d[dateKey], InvoiceNo: d.InvoiceNo || '', InvoiceSerial: d.InvoiceSerial || '',
          InvoiceDate: d.InvoiceDate || '', Party: d[partyKey] || '',
          Subtotal: toNumber(d.Subtotal), Discount: toNumber(d.Discount),
          VAT: toNumber(d.VAT), TotalAmount: toNumber(d.TotalAmount)
        });
      });
      return {
        rates: Object.keys(byRate).map(function (k) { return byRate[k]; })
          .sort(function (a, b) { return a.rate - b.rate; })
          .map(function (b) { return { rate: b.rate, base: roundMoney_(b.base), vat: roundMoney_(b.vat), lines: b.lines }; }),
        docs: rows,
        totalBase: roundMoney_(rows.reduce(function (s, r) { return s + r.Subtotal - r.Discount; }, 0)),
        totalVat: roundMoney_(rows.reduce(function (s, r) { return s + r.VAT; }, 0)),
        docCount: rows.length
      };
    }

    var outRep = (kind === 'in') ? null : build('SalesOrders', 'SalesItems', 'SalesID', 'SalesDate', 'LineRevenue', 'CustomerName');
    var inRep = (kind === 'out') ? null : build('PurchaseOrders', 'PurchaseItems', 'PurchaseID', 'PurchaseDate', 'LineTotal', 'SupplierName');
    return ok_({
      from: filters.from || '', to: filters.to || '', kind: kind,
      output: outRep, input: inRep,
      payable: (outRep && inRep) ? roundMoney_(outRep.totalVat - inRep.totalVat) : null,
      rates: VAT_RATES_
    });
  } catch (e) { return err_(e.message); }
}

/* ============================================================================
 *  CHẠY TAY MỘT LẦN TRONG APPS SCRIPT: setupVatLineModule()
 *  Bổ sung cột thuế suất cho các sheet chi tiết và cột Số hóa đơn cho chứng từ.
 *  Chứng từ CŨ được điền thuế suất suy ra từ tổng thuế đã có -> báo cáo không bị trống.
 * ========================================================================== */
function setupVatLineModule() {
  var changed = [];
  try { changed = ensureSchemaColumns_(true); } catch (e) { console.warn('[setupVatLineModule]', (e && e.message) || String(e));  }
  var filled = 0;

  function backfill(docSheet, itemSheet, idKey, amountKey) {
    var docs = {};
    sheetToObjects_(docSheet).forEach(function (d) { docs[String(d[idKey])] = d; });
    var updates = {};
    var itemIdKey = SCHEMA[itemSheet][0];
    sheetToObjects_(itemSheet).forEach(function (i) {
      if (i.VATPercent !== '' && i.VATPercent !== null && i.VATPercent !== undefined) return;
      var d = docs[String(i[idKey])];
      if (!d) return;
      var base = Math.max(0, toNumber(d.Subtotal) - toNumber(d.Discount));
      var rate = base > 0 ? Math.round(toNumber(d.VAT) / base * 100) : 0;
      var sub = toNumber(d.Subtotal);
      var ratio = sub > 0 ? base / sub : 0;
      updates[String(i[itemIdKey])] = {
        VATPercent: rate,
        VATAmount: roundMoney_(toNumber(i[amountKey]) * ratio * rate / 100)
      };
      filled++;
    });
    if (Object.keys(updates).length) updateRowsById_(itemSheet, itemIdKey, updates);
  }

  backfill('SalesOrders', 'SalesItems', 'SalesID', 'LineRevenue');
  backfill('PurchaseOrders', 'PurchaseItems', 'PurchaseID', 'LineTotal');
  backfill('Quotes', 'QuoteItems', 'QuoteID', 'LineTotal');

  var msg = 'Đã bật VAT từng dòng và Số hóa đơn. Đã điền thuế suất cho ' + filled + ' dòng hàng cũ.';
  if (changed.length) msg = 'Đã bổ sung cột cho: ' + changed.join(', ') + '. ' + msg;
  try { SpreadsheetApp.getUi().alert(msg); } catch (e) { console.warn('[setupVatLineModule]', (e && e.message) || String(e));  }
  return ok_({ changed: changed, filled: filled }, msg);
}

