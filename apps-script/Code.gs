function setCustomerOpeningDebt(customerId, amount, note) {
  /* Gộp tham số về MỘT object rồi đệ quy bằng chính object đó.
     Trước đây mỗi lần gọi lại tạo payload mới nên cờ __locked không bao giờ được giữ
     -> hàm tự gọi chính nó vô hạn và luôn báo lỗi, tính năng nợ cũ không dùng được. */
  var p = (customerId && typeof customerId === 'object') ? customerId
    : { customerId: customerId, amount: amount, note: note };
  if (p.amount && typeof p.amount === 'object') {
    p.note = p.amount.note || p.amount.Notes || p.note;
    p.amount = p.amount.amount || p.amount.Amount || 0;
  }
  if (!p.customerId) return err_('Thiếu khách hàng');
  p.amount = toNumber(p.amount); p.note = p.note || '';
  if (!p.__locked) return runLocked_(p, '__locked',
    ['SalesOrders', 'SalesItems', 'Customers'], function () {
      return setCustomerOpeningDebt(p);
    });
  customerId = p.customerId; amount = p.amount; note = p.note;
  try {
    var customer = sheetToObjects_('Customers').filter(function (c) { return c.CustomerID === customerId; })[0];
    if (!customer) return err_('Không tìm thấy khách hàng');
    var rows = sheetToObjects_('SalesOrders').filter(function (s) {
      return s.CustomerID === customerId && (s.Status === 'NO_CU' || String(s.Notes || '').indexOf('nợ cũ') >= 0 || String(s.Notes || '').indexOf('Nợ cũ') >= 0);
    });
    rows.sort(function (a, b) { return new Date(a.CreatedAt || a.SalesDate || 0) - new Date(b.CreatedAt || b.SalesDate || 0); });
    var now = new Date();
    var amt = Math.max(0, toNumber(amount));
    var main = rows[0];
    if (!main) {
      var id = generateId('HD');
      appendRow('SalesOrders', {
        SalesID: id, SalesDate: now, CustomerID: customerId, CustomerName: customer.CustomerName,
        Subtotal: amt, Discount: 0, VAT: 0, ShippingFee: 0, TotalAmount: amt, PaidAmount: 0,
        ReceivableAmount: amt, CostAmount: 0, Profit: 0, PaymentStatus: calculatePaymentStatus(amt, 0),
        DueDate: '', Status: 'NO_CU', CreatedBy: getUser_(), Notes: note || 'Ghi nhận nợ cũ đầu kỳ', CreatedAt: now
      });
      appendRow('SalesItems', {
        SalesItemID: generateId('HDI'), SalesID: id, ProductID: 'NO_CU', SKU: '',
        ProductName: 'Nợ đầu kỳ', Quantity: 1, CostPrice: 0, SalePrice: amt,
        LineRevenue: amt, LineCost: 0, LineProfit: 0
      });
      main = { SalesID: id };
    } else {
      updateRowById('SalesOrders', 'SalesID', main.SalesID, {
        Subtotal: amt, Discount: 0, VAT: 0, ShippingFee: 0, TotalAmount: amt, PaidAmount: 0,
        ReceivableAmount: amt, CostAmount: 0, Profit: 0, PaymentStatus: calculatePaymentStatus(amt, 0),
        Status: 'NO_CU', Notes: note || main.Notes || 'Ghi nhận nợ cũ đầu kỳ', CustomerName: customer.CustomerName
      });
      var item = sheetToObjects_('SalesItems').filter(function (i) { return i.SalesID === main.SalesID && i.ProductID === 'NO_CU'; })[0];
      if (item) updateRowById('SalesItems', 'SalesItemID', item.SalesItemID, { ProductName: 'Nợ đầu kỳ', Quantity: 1, SalePrice: amt, LineRevenue: amt, LineProfit: amt });
      else appendRow('SalesItems', { SalesItemID: generateId('HDI'), SalesID: main.SalesID, ProductID: 'NO_CU', SKU: '', ProductName: 'Nợ đầu kỳ', Quantity: 1, CostPrice: 0, SalePrice: amt, LineRevenue: amt, LineCost: 0, LineProfit: 0 });
    }
    rows.slice(1).forEach(function (r) {
      updateRowById('SalesOrders', 'SalesID', r.SalesID, { TotalAmount: 0, Subtotal: 0, ReceivableAmount: 0, PaidAmount: 0, PaymentStatus: 'Đã thanh toán', Notes: 'Nợ cũ trùng đã được đưa về 0' });
    });
    refreshCustomerBalance_(customerId);
    return ok_({ SalesID: main.SalesID, amount: amt }, 'Đã điều chỉnh nợ đầu kỳ khách hàng');
