/**
 * data: { rows: [{PurchaseID, InvoiceNo, PurchaseDate, SupplierID, SupplierName, Subtotal,
 *                 Discount, VAT, ShippingFee, TotalAmount, PaidAmount, PayableAmount, Status, Notes}],
 *         items: [{PurchaseID, SKU, ProductName, Quantity, UnitCost, VATRate}],
 *         affectStock, createMissingParty }
 */
function bulkImportPurchaseOrders(data) {
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked',
    ['PurchaseOrders', 'PurchaseItems', 'StockMovements', 'Payments', 'Suppliers', 'Products'],
    function () { return bulkImportPurchaseOrders(data); });
  try {
    var rows = data.rows || [];
    if (!rows.length) return err_('Không có dữ liệu để nhập');
    var affectStock = data.affectStock === true;
    var createMissing = data.createMissingParty !== false;
    var now = new Date(), warnings = [];

    var existingIds = {};
    sheetToObjects_('PurchaseOrders').forEach(function (p) { if (p.PurchaseID) existingIds[String(p.PurchaseID).trim().toLowerCase()] = true; });
    var smaps = impSupplierMaps_();

    if (createMissing) {
      var missing = {};
      rows.forEach(function (r) {
        var name = impStr_(r.SupplierName), code = impStr_(r.SupplierID);
        if (!name && !code) return;
        if (impFindParty_(smaps, code, name)) return;
        var k = (code || name).toLowerCase();
        if (!missing[k]) missing[k] = { code: code, name: name || code };
      });
      var madeS = impCreateMissingSuppliers_(smaps, missing);
      if (madeS) warnings.push('Tự tạo ' + madeS + ' nhà cung cấp chưa có hồ sơ');
    }

    var valid = [], skipped = 0, batchIds = {};
    rows.forEach(function (r) {
      var code = impStr_(r.PurchaseID);
      if (code && (existingIds[code.toLowerCase()] || batchIds[code.toLowerCase()])) { skipped++; return; }
      var party = impFindParty_(smaps, r.SupplierID, r.SupplierName);
      if (!party) { skipped++; return; }
      if (code) batchIds[code.toLowerCase()] = true;
      valid.push({ code: code, ref: impStr_(r.__ref) || code, r: r, party: party });
    });
    if (!valid.length) return impResult_(0, 0, skipped, warnings, 'Không có phiếu mua mới để nhập' + (skipped ? ' (' + skipped + ' dòng trùng mã hoặc không tìm được NCC)' : ''));

    // Giữ chỗ cho mã cũ trong file TRƯỚC khi cấp mã mới, tránh mã tự sinh trùng mã trong cùng lô.
    valid.forEach(function (x) { if (x.code) bumpCounterTo_('PM', x.code); });
    var needGen = valid.filter(function (x) { return !x.code; }).length;
    var genIds = needGen ? generateIds('PM', needGen) : [];
    var gi = 0;
    valid.forEach(function (x) { x.id = x.code || genIds[gi++]; });

    var itemsByCode = {};
    (data.items || []).forEach(function (it) {
      var k = impStr_(it.PurchaseID).toLowerCase(); if (!k) return;
      (itemsByCode[k] = itemsByCode[k] || []).push(it);
    });
    var pmaps = Object.keys(itemsByCode).length ? impProductMaps_() : null;

    var totalItems = 0;
    valid.forEach(function (x) { totalItems += (itemsByCode[(x.ref || x.code || x.id).toLowerCase()] || []).length; });
    var itemIds = totalItems ? generateIds('PMI', totalItems) : [];
    var moveIds = (affectStock && totalItems) ? generateIds('MV', totalItems) : [];
    var payCount = 0;
    valid.forEach(function (x) { if (impNum_(x.r.PaidAmount) > 0) payCount++; });
    var payIds = payCount ? generateIds('TT', payCount) : [];

    var orderRows = [], itemRows = [], moveRows = [], payRows = [], affected = {};
    var ii = 0, mi = 0, pi = 0;

    valid.forEach(function (x) {
      var r = x.r, id = x.id;
      var date = impDate_(r.PurchaseDate) || impDate_(r.CreatedAt) || now;
      var lines = itemsByCode[(x.ref || x.code || x.id).toLowerCase()] || [];
      var lineSubtotal = 0;
      var parsed = lines.map(function (it) {
        var prod = pmaps ? impFindProduct_(pmaps, it.SKU, it.ProductName, it.ProductID) : null;
        var qty = impNum_(it.Quantity) || 0;
        var cost = impNum_(it.UnitCost !== undefined && it.UnitCost !== '' ? it.UnitCost : (prod ? prod.CostPrice : 0));
        lineSubtotal += qty * cost;
        return { prod: prod, qty: qty, cost: cost, raw: it, line: qty * cost, rate: it.VATRate };
      });

      var hasSub = r.Subtotal !== undefined && r.Subtotal !== '';
      var subtotal = hasSub ? Math.max(0, impNum_(r.Subtotal)) : lineSubtotal;
      var discount = Math.max(0, impNum_(r.Discount));
      var hasVatMoney = r.VAT !== undefined && r.VAT !== '';
      var vatCalc = computeLineVat_(parsed, subtotal, discount, r.VATRate !== undefined && r.VATRate !== '' ? r.VATRate : 0);
      var vat = hasVatMoney ? Math.max(0, impNum_(r.VAT)) : vatCalc.vat;
      var ship = Math.max(0, impNum_(r.ShippingFee));
      var hasTotal = r.TotalAmount !== undefined && r.TotalAmount !== '';
      var hasPaid = r.PaidAmount !== undefined && r.PaidAmount !== '';
      var hasPay = r.PayableAmount !== undefined && r.PayableAmount !== '';
      var money;
      if (hasTotal || hasPaid || hasPay) {
        money = impResolveMoney_(hasTotal ? r.TotalAmount : (subtotal - discount + vat + ship), r.PaidAmount, r.PayableAmount,
          hasTotal || subtotal > 0, hasPaid, hasPay);
      } else {
        money = { total: Math.max(0, subtotal - discount + vat + ship), paid: 0 };
      }
      var total = money.total, paid = money.paid;
      var payable = Math.max(0, total - paid);
      var status = impStr_(r.Status);
      if (PURCHASE_STATUS_FLOW.indexOf(status) < 0) status = 'Đã nhập kho';
      if (isCompleted_(status) && payable > 0) status = 'Đã nhập kho';
      if (isCancelled_(status)) payable = 0;

      orderRows.push({
        PurchaseID: id, PurchaseDate: date, SupplierID: x.party.id, SupplierName: x.party.name,
        Subtotal: subtotal, Discount: discount, VAT: vat, ShippingFee: ship,
        TotalAmount: total, PaidAmount: paid, PayableAmount: payable,
        PaymentStatus: isCancelled_(status) ? 'Đã hủy' : calculatePaymentStatus(total, paid),
        DueDate: impDate_(r.DueDate) || '', Status: status, CreatedBy: getUser_(),
        Notes: impStr_(r.Notes) || ('Nhập từ file' + (x.code && x.code !== id ? ' · mã gốc ' + x.code : '')),
        CreatedAt: now, InvoiceNo: impStr_(r.InvoiceNo)
      });

      parsed.forEach(function (p, idx) {
        var pid = p.prod ? p.prod.ProductID : '';
        itemRows.push({
          PurchaseItemID: itemIds[ii++], PurchaseID: id, ProductID: pid,
          SKU: p.prod ? p.prod.SKU : impStr_(p.raw.SKU),
          ProductName: p.prod ? p.prod.ProductName : impStr_(p.raw.ProductName),
          Quantity: p.qty, UnitCost: p.cost, LineTotal: p.qty * p.cost,
          VATRate: vatCalc.lines[idx].rate, VATAmount: vatCalc.lines[idx].amount
        });
        if (affectStock && p.prod && !impIsService_(p.prod) && !isCancelled_(status) && status !== 'Đã đặt hàng') {
          moveRows.push({
            MovementID: moveIds[mi++], Date: date, Type: 'PurchaseIn', SourceType: 'PurchaseOrder', SourceID: id,
            ProductID: pid, SKU: p.prod.SKU, ProductName: p.prod.ProductName,
            QuantityIn: p.qty, QuantityOut: 0, UnitCost: p.cost, UnitPrice: toNumber(p.prod.SalePrice), StockAfter: '',
            CreatedBy: getUser_(), Notes: 'Nhập từ ' + id + ' (nhập từ file)', CreatedAt: now, Status: 'Đã nhận'
          });
          affected[pid] = true;
        }
      });

      if (paid > 0 && !isCancelled_(status)) {
        payRows.push({
          PaymentID: payIds[pi++], PaymentDate: date, ObjectType: 'Supplier', ObjectID: x.party.id,
          ObjectName: x.party.name, SourceType: 'PurchaseOrder', SourceID: id, PaymentDirection: 'Out',
          Amount: paid, Method: impStr_(r.Method) || 'Tiền mặt', BillImageUrl: '', BillAmount: '', BillOcrText: '',
          Note: 'Đã trả theo ' + id + ' (nhập từ file)', CreatedBy: getUser_(), CreatedAt: now
        });
      }
    });

    appendRows('PurchaseOrders', orderRows);
    if (itemRows.length) appendRows('PurchaseItems', itemRows);
    if (moveRows.length) appendRows('StockMovements', moveRows);
    if (payRows.length) appendRows('Payments', payRows);
    if (Object.keys(affected).length) recalculateProductStocks_(Object.keys(affected));
    refreshAllSupplierBalances_();

    writeAudit_('Nhập phiếu mua từ file', 'PurchaseOrder', '', 'Tạo ' + orderRows.length + ' phiếu, ' + itemRows.length + ' dòng hàng, bỏ qua ' + skipped);
    return impResult_(orderRows.length, 0, skipped, warnings,
      'Đã nhập ' + orderRows.length + ' phiếu mua' + (itemRows.length ? ' (' + itemRows.length + ' dòng hàng)' : '') + (skipped ? ', bỏ qua ' + skipped : ''));
  } catch (e) { return err_(e.message); }
}

/**
 * data: {
 *   rows:  [{SalesID, InvoiceNo, SalesDate, CustomerID, CustomerName, Subtotal, Discount, VAT,
 *            ShippingFee, TotalAmount, PaidAmount, ReceivableAmount, Status, Notes, __ref}],
 *   items: [{SalesID, ProductID, SKU, ProductName, Quantity, SalePrice, VATRate}]  (tùy chọn)
 *   affectStock:        true -> trừ kho theo từng dòng hàng (MẶC ĐỊNH false)
 *   createMissingParty: true -> tự tạo khách hàng chưa có (mặc định true)
 * }
 * NHIỀU DÒNG HÀNG: các dòng cùng một Mã hóa đơn được gộp vào 1 hóa đơn, mỗi dòng giữ
 * thuế suất riêng (0/5/8/10%) nên 1 đơn có cả hàng V8 lẫn V10 vẫn ra đúng tiền thuế.
 * LƯU Ý NGHIỆP VỤ: khi chuyển dữ liệu từ phần mềm cũ, tồn kho thường đã nạp bằng "tồn hiện tại"
 * của sản phẩm; bật affectStock sẽ trừ kho lần nữa -> mặc định KHÔNG đụng vào kho.
 */
function bulkImportSalesOrders(data) {
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked',
    ['SalesOrders', 'SalesItems', 'StockMovements', 'Payments', 'Customers', 'Products'],
    function () { return bulkImportSalesOrders(data); });
  try {
    var rows = data.rows || [];
    if (!rows.length) return err_('Không có dữ liệu để nhập');
    var affectStock = data.affectStock === true;
    var createMissing = data.createMissingParty !== false;
    var now = new Date(), warnings = [];

    var existingIds = {};
    sheetToObjects_('SalesOrders').forEach(function (s) { if (s.SalesID) existingIds[String(s.SalesID).trim().toLowerCase()] = true; });
    var cmaps = impCustomerMaps_();

    // B1: khách hàng được chứng từ nhắc tới nhưng chưa có hồ sơ -> tạo trước.
    if (createMissing) {
      var missing = {};
      rows.forEach(function (r) {
        var name = impStr_(r.CustomerName), code = impStr_(r.CustomerID);
        if (!name && !code) return;
        if (impFindParty_(cmaps, code, name)) return;
        var k = (code || name).toLowerCase();
        if (!missing[k]) missing[k] = { code: code, name: name || code };
      });
      var madeC = impCreateMissingCustomers_(cmaps, missing);
      if (madeC) warnings.push('Tự tạo ' + madeC + ' khách hàng chưa có hồ sơ');
    }

    // B2: chuẩn hóa từng hóa đơn.
    var valid = [], skipped = 0, batchIds = {};
    rows.forEach(function (r) {
      var code = impStr_(r.SalesID);
      if (code && (existingIds[code.toLowerCase()] || batchIds[code.toLowerCase()])) { skipped++; return; }
      var party = impFindParty_(cmaps, r.CustomerID, r.CustomerName);
      if (!party) { skipped++; return; }
      if (code) batchIds[code.toLowerCase()] = true;
      // __ref: khóa client dùng để ghép dòng hàng vào chứng từ (khi file không có mã hóa đơn).
      valid.push({ code: code, ref: impStr_(r.__ref) || code, r: r, party: party });
    });
    if (!valid.length) return impResult_(0, 0, skipped, warnings, 'Không có hóa đơn mới để nhập' + (skipped ? ' (' + skipped + ' dòng trùng mã hoặc không tìm được khách)' : ''));

    // Giữ chỗ cho mã cũ trong file TRƯỚC khi cấp mã mới, tránh mã tự sinh trùng mã trong cùng lô.
    valid.forEach(function (x) { if (x.code) bumpCounterTo_('HD', x.code); });
    var needGen = valid.filter(function (x) { return !x.code; }).length;
    var genIds = needGen ? generateIds('HD', needGen) : [];
    var gi = 0;
    valid.forEach(function (x) { x.id = x.code || genIds[gi++]; });

    // B3: dòng hàng — gom theo mã hóa đơn gốc.
    var itemsByCode = {};
    (data.items || []).forEach(function (it) {
      var k = impStr_(it.SalesID).toLowerCase();
      if (!k) return;
      (itemsByCode[k] = itemsByCode[k] || []).push(it);
    });
    var pmaps = Object.keys(itemsByCode).length ? impProductMaps_() : null;

    var totalItems = 0;
    valid.forEach(function (x) { totalItems += (itemsByCode[(x.ref || x.code || x.id).toLowerCase()] || []).length; });
    var itemIds = totalItems ? generateIds('HDI', totalItems) : [];
    var moveIds = (affectStock && totalItems) ? generateIds('MV', totalItems) : [];
    var payCount = 0;
    valid.forEach(function (x) { if (impNum_(x.r.PaidAmount) > 0 || (impNum_(x.r.TotalAmount) - impNum_(x.r.ReceivableAmount)) > 0) payCount++; });
    var payIds = payCount ? generateIds('TT', payCount) : [];

    var orderRows = [], itemRows = [], moveRows = [], payRows = [], affected = {};
    var ii = 0, mi = 0, pi = 0;

    valid.forEach(function (x) {
      var r = x.r, id = x.id;
      var date = impDate_(r.SalesDate) || impDate_(r.CreatedAt) || now;
      var lines = itemsByCode[(x.ref || x.code || x.id).toLowerCase()] || [];
      var lineSubtotal = 0, costAmount = 0;
      var parsed = lines.map(function (it) {
        var prod = pmaps ? impFindProduct_(pmaps, it.SKU, it.ProductName, it.ProductID) : null;
        var qty = impNum_(it.Quantity) || 0;
        var price = impNum_(it.SalePrice);
        var cost = prod ? toNumber(prod.CostPrice) : 0;
        lineSubtotal += qty * price; costAmount += qty * cost;
        return { prod: prod, qty: qty, price: price, cost: cost, raw: it, line: qty * price, rate: it.VATRate };
      });

      var hasSub = r.Subtotal !== undefined && r.Subtotal !== '';
      var subtotal = hasSub ? Math.max(0, impNum_(r.Subtotal)) : lineSubtotal;
      var discount = Math.max(0, impNum_(r.Discount));
      // Thuế: ưu tiên cột tiền thuế của file; không có thì tính theo thuế suất từng dòng.
      var hasVatMoney = r.VAT !== undefined && r.VAT !== '';
      var vatCalc = computeLineVat_(parsed, subtotal, discount, r.VATRate !== undefined && r.VATRate !== '' ? r.VATRate : 0);
      var vat = hasVatMoney ? Math.max(0, impNum_(r.VAT)) : vatCalc.vat;
      var ship = Math.max(0, impNum_(r.ShippingFee));
      var hasTotal = r.TotalAmount !== undefined && r.TotalAmount !== '';
      var hasPaid = r.PaidAmount !== undefined && r.PaidAmount !== '';
      var hasRecv = r.ReceivableAmount !== undefined && r.ReceivableAmount !== '';
      var money;
      if (hasTotal || hasPaid || hasRecv) {
        money = impResolveMoney_(hasTotal ? r.TotalAmount : (subtotal - discount + vat + ship), r.PaidAmount, r.ReceivableAmount,
          hasTotal || subtotal > 0, hasPaid, hasRecv);
      } else {
        money = { total: Math.max(0, subtotal - discount + vat + ship), paid: 0 };
      }
      var total = money.total, paid = money.paid;
      var receivable = Math.max(0, total - paid);
      var status = impStr_(r.Status);
      if (SALES_STATUS_FLOW.indexOf(status) < 0) status = receivable > 0 ? 'Đang xử lý' : 'Hoàn tất';

      orderRows.push({
        SalesID: id, SalesDate: date, CustomerID: x.party.id, CustomerName: x.party.name,
        Subtotal: subtotal, Discount: discount, VAT: vat, ShippingFee: ship,
        TotalAmount: total, PaidAmount: paid, ReceivableAmount: receivable,
        CostAmount: Math.round(costAmount), Profit: Math.round(total - vat - ship - costAmount),
        PaymentStatus: isCancelled_(status) ? 'Đã hủy' : calculatePaymentStatus(total, paid),
        DueDate: impDate_(r.DueDate) || '', Status: status, CreatedBy: getUser_(),
        Notes: impStr_(r.Notes) || ('Nhập từ file' + (x.code && x.code !== id ? ' · mã gốc ' + x.code : '')),
        CreatedAt: now, InvoiceNo: impStr_(r.InvoiceNo)
      });

      parsed.forEach(function (p, idx) {
        var pid = p.prod ? p.prod.ProductID : '';
        itemRows.push({
          SalesItemID: itemIds[ii++], SalesID: id, ProductID: pid,
          SKU: p.prod ? p.prod.SKU : impStr_(p.raw.SKU),
          ProductName: p.prod ? p.prod.ProductName : impStr_(p.raw.ProductName),
          Quantity: p.qty, CostPrice: p.cost, SalePrice: p.price,
          LineRevenue: p.qty * p.price, LineCost: p.qty * p.cost, LineProfit: p.qty * (p.price - p.cost),
          VATRate: vatCalc.lines[idx].rate, VATAmount: vatCalc.lines[idx].amount
        });
        if (affectStock && p.prod && !impIsService_(p.prod) && !isCancelled_(status)) {
          moveRows.push({
            MovementID: moveIds[mi++], Date: date, Type: 'SaleOut', SourceType: 'SalesOrder', SourceID: id,
            ProductID: pid, SKU: p.prod.SKU, ProductName: p.prod.ProductName,
            QuantityIn: 0, QuantityOut: p.qty, UnitCost: p.cost, UnitPrice: p.price, StockAfter: '',
            CreatedBy: getUser_(), Notes: 'Xuất cho ' + id + ' (nhập từ file)', CreatedAt: now, Status: 'Đã giao'
          });
          affected[pid] = true;
        }
      });

      if (paid > 0 && !isCancelled_(status)) {
        payRows.push({
          PaymentID: payIds[pi++], PaymentDate: date, ObjectType: 'Customer', ObjectID: x.party.id,
          ObjectName: x.party.name, SourceType: 'SalesOrder', SourceID: id, PaymentDirection: 'In',
          Amount: paid, Method: impStr_(r.Method) || 'Tiền mặt', BillImageUrl: '', BillAmount: '', BillOcrText: '',
          Note: 'Đã thu theo ' + id + ' (nhập từ file)', CreatedBy: getUser_(), CreatedAt: now
        });
      }
    });

    appendRows('SalesOrders', orderRows);
    if (itemRows.length) appendRows('SalesItems', itemRows);
    if (moveRows.length) appendRows('StockMovements', moveRows);
    if (payRows.length) appendRows('Payments', payRows);
    if (Object.keys(affected).length) recalculateProductStocks_(Object.keys(affected));
    refreshAllCustomerBalances_();

    writeAudit_('Nhập hóa đơn từ file', 'SalesOrder', '', 'Tạo ' + orderRows.length + ' HĐ, ' + itemRows.length + ' dòng hàng, bỏ qua ' + skipped);
    return impResult_(orderRows.length, 0, skipped, warnings,
      'Đã nhập ' + orderRows.length + ' hóa đơn' + (itemRows.length ? ' (' + itemRows.length + ' dòng hàng)' : '') + (skipped ? ', bỏ qua ' + skipped : ''));
  } catch (e) { return err_(e.message); }
}

/**
 * data: { rows: [{QuoteID, QuoteDate, ExpiredDate, CustomerID, CustomerName, Discount, VAT, Status, Notes}],
 *         items: [{QuoteID, SKU, ProductName, Quantity, SalePrice, VATRate}], createMissingParty }
 */
function bulkImportQuotes(data) {
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked', ['Quotes', 'QuoteItems', 'Customers'],
    function () { return bulkImportQuotes(data); });
  try {
    var rows = data.rows || [];
    if (!rows.length) return err_('Không có dữ liệu để nhập');
    var now = new Date(), warnings = [];
    var existingIds = {};
    sheetToObjects_('Quotes').forEach(function (q) { if (q.QuoteID) existingIds[String(q.QuoteID).trim().toLowerCase()] = true; });
    var cmaps = impCustomerMaps_();
    if (data.createMissingParty !== false) {
      var missing = {};
      rows.forEach(function (r) {
        var name = impStr_(r.CustomerName), code = impStr_(r.CustomerID);
        if (!name && !code) return;
        if (impFindParty_(cmaps, code, name)) return;
        var k = (code || name).toLowerCase();
        if (!missing[k]) missing[k] = { code: code, name: name || code };
      });
      var made = impCreateMissingCustomers_(cmaps, missing);
      if (made) warnings.push('Tự tạo ' + made + ' khách hàng chưa có hồ sơ');
    }
    var valid = [], skipped = 0, batchIds = {};
    rows.forEach(function (r) {
      var code = impStr_(r.QuoteID);
      if (code && (existingIds[code.toLowerCase()] || batchIds[code.toLowerCase()])) { skipped++; return; }
      var party = impFindParty_(cmaps, r.CustomerID, r.CustomerName);
      if (!party) { skipped++; return; }
      if (code) batchIds[code.toLowerCase()] = true;
      valid.push({ code: code, ref: impStr_(r.__ref) || code, r: r, party: party });
    });
    if (!valid.length) return impResult_(0, 0, skipped, warnings, 'Không có báo giá mới để nhập');
    // Giữ chỗ cho mã cũ trong file TRƯỚC khi cấp mã mới, tránh mã tự sinh trùng mã trong cùng lô.
    valid.forEach(function (x) { if (x.code) bumpCounterTo_('BG', x.code); });
    var needGen = valid.filter(function (x) { return !x.code; }).length;
    var genIds = needGen ? generateIds('BG', needGen) : [];
    var gi = 0;
    valid.forEach(function (x) { x.id = x.code || genIds[gi++]; });

    var itemsByCode = {};
    (data.items || []).forEach(function (it) {
      var k = impStr_(it.QuoteID).toLowerCase(); if (!k) return;
      (itemsByCode[k] = itemsByCode[k] || []).push(it);
    });
    var pmaps = Object.keys(itemsByCode).length ? impProductMaps_() : null;
    var totalItems = 0;
    valid.forEach(function (x) { totalItems += (itemsByCode[(x.ref || x.code || x.id).toLowerCase()] || []).length; });
    var itemIds = totalItems ? generateIds('BGI', totalItems) : [];
    var quoteRows = [], itemRows = [], ii = 0;
    valid.forEach(function (x) {
      var r = x.r, id = x.id;
      var lines = itemsByCode[(x.ref || x.code || x.id).toLowerCase()] || [];
      var subtotal = 0;
      var parsed = lines.map(function (it) {
        var prod = pmaps ? impFindProduct_(pmaps, it.SKU, it.ProductName, it.ProductID) : null;
        var qty = impNum_(it.Quantity) || 0;
        var price = impNum_(it.SalePrice !== undefined && it.SalePrice !== '' ? it.SalePrice : (prod ? prod.SalePrice : 0));
        subtotal += qty * price;
        return { prod: prod, qty: qty, price: price, raw: it, line: qty * price, rate: it.VATRate };
      });
      if (r.Subtotal !== undefined && r.Subtotal !== '') subtotal = Math.max(0, impNum_(r.Subtotal));
      var discount = Math.max(0, impNum_(r.Discount));
      var vatCalc = computeLineVat_(parsed, subtotal, discount, r.VATRate !== undefined && r.VATRate !== '' ? r.VATRate : 0);
      var vat = (r.VAT !== undefined && r.VAT !== '') ? Math.max(0, impNum_(r.VAT)) : vatCalc.vat;
      var total = (r.TotalAmount !== undefined && r.TotalAmount !== '') ? Math.max(0, impNum_(r.TotalAmount)) : Math.max(0, subtotal - discount + vat);
      var status = impStr_(r.Status) || 'Mới';
      quoteRows.push({
        QuoteID: id, QuoteDate: impDate_(r.QuoteDate) || now, ExpiredDate: impDate_(r.ExpiredDate) || '',
        CustomerID: x.party.id, CustomerName: x.party.name, Subtotal: subtotal, Discount: discount,
        VAT: vat, TotalAmount: total, Status: status,
        Notes: impStr_(r.Notes) || 'Nhập từ file', CreatedAt: now
      });
      parsed.forEach(function (p, idx) {
        itemRows.push({
          QuoteItemID: itemIds[ii++], QuoteID: id, ProductID: p.prod ? p.prod.ProductID : '',
          SKU: p.prod ? p.prod.SKU : impStr_(p.raw.SKU),
          ProductName: p.prod ? p.prod.ProductName : impStr_(p.raw.ProductName),
          Quantity: p.qty, SalePrice: p.price, LineTotal: p.qty * p.price,
          VATRate: vatCalc.lines[idx].rate, VATAmount: vatCalc.lines[idx].amount
        });
      });
    });
    appendRows('Quotes', quoteRows);
    if (itemRows.length) appendRows('QuoteItems', itemRows);
    writeAudit_('Nhập báo giá từ file', 'Quote', '', 'Tạo ' + quoteRows.length + ' báo giá, ' + itemRows.length + ' dòng hàng');
    return impResult_(quoteRows.length, 0, skipped, warnings,
      'Đã nhập ' + quoteRows.length + ' báo giá' + (itemRows.length ? ' (' + itemRows.length + ' dòng hàng)' : '') + (skipped ? ', bỏ qua ' + skipped : ''));
  } catch (e) { return err_(e.message); }
}

/**
 * data: { rows: [{SKU, ProductName, ActualStock, CostPrice, SalePrice}], reason }
 * Đưa tồn hiện tại về đúng số trong file bằng 1 phiếu điều chỉnh cho mỗi SP
 * (giữ dấu vết trong Lịch sử kho, không sửa lén số liệu).
 */
function bulkImportStockLevels(data) {
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked', ['Products', 'StockMovements'],
    function () { return bulkImportStockLevels(data); });
  try {
    var rows = data.rows || [];
    if (!rows.length) return err_('Không có dữ liệu để nhập');
    var now = new Date();
    var reason = impStr_(data.reason) || 'Cập nhật tồn từ file nhập';
    var pmaps = impProductMaps_();
    var plan = [], skipped = 0, priceUpd = {}, seen = {};
    rows.forEach(function (r) {
      var prod = impFindProduct_(pmaps, r.SKU, r.ProductName, r.ProductID);
      if (!prod) { skipped++; return; }
      if (seen[prod.ProductID]) { skipped++; return; }
      seen[prod.ProductID] = true;
      var pu = {};
      if (r.CostPrice !== undefined && r.CostPrice !== '') pu.CostPrice = Math.max(0, impNum_(r.CostPrice));
      if (r.SalePrice !== undefined && r.SalePrice !== '') pu.SalePrice = Math.max(0, impNum_(r.SalePrice));
      if (Object.keys(pu).length) { pu.UpdatedAt = now; priceUpd[prod.ProductID] = pu; }
      if (impIsService_(prod)) return;
      if (r.ActualStock === undefined || r.ActualStock === '') return;
      var target = impNum_(r.ActualStock), cur = toNumber(prod.CurrentStock), diff = target - cur;
      if (!diff) return;
      plan.push({ prod: prod, diff: diff, cost: pu.CostPrice !== undefined ? pu.CostPrice : toNumber(prod.CostPrice) });
    });
    if (Object.keys(priceUpd).length) updateRowsById_('Products', 'ProductID', priceUpd);
    if (!plan.length) {
      var msgNo = 'Không có tồn nào cần điều chỉnh' + (Object.keys(priceUpd).length ? ' (đã cập nhật giá cho ' + Object.keys(priceUpd).length + ' SP)' : '');
      return impResult_(0, Object.keys(priceUpd).length, skipped, [], msgNo);
    }
    var mvIds = generateIds('MV', plan.length);
    var moveRows = plan.map(function (x, i) {
      return {
        MovementID: mvIds[i], Date: now, Type: x.diff > 0 ? 'ManualIn' : 'ManualOut', SourceType: 'Manual', SourceID: '',
        ProductID: x.prod.ProductID, SKU: x.prod.SKU, ProductName: x.prod.ProductName,
        QuantityIn: x.diff > 0 ? x.diff : 0, QuantityOut: x.diff < 0 ? Math.abs(x.diff) : 0,
        UnitCost: x.cost, UnitPrice: toNumber(x.prod.SalePrice), StockAfter: '',
        CreatedBy: getUser_(), Notes: reason, CreatedAt: now, Status: x.diff > 0 ? 'Đã nhận' : 'Đã giao'
      };
    });
    appendRows('StockMovements', moveRows);
    recalculateProductStocks_(plan.map(function (x) { return x.prod.ProductID; }));
    writeAudit_('Cập nhật tồn kho từ file', 'Product', '', 'Điều chỉnh ' + plan.length + ' SP, bỏ qua ' + skipped);
    return impResult_(plan.length, Object.keys(priceUpd).length, skipped, [],
      'Đã điều chỉnh tồn cho ' + plan.length + ' sản phẩm' + (skipped ? ', bỏ qua ' + skipped + ' dòng không khớp SP' : ''));
  } catch (e) { return err_(e.message); }
}

/**
 * data: { rows: [{ObjectType, Code, Name, Phone, Amount, Notes}], mode, defaultType, createMissingParty }
 *   mode: 'set' (nợ cũ = số trong file) | 'add' (cộng thêm)
 *       | 'balance' (mặc định — số trong file là SỐ DƯ CUỐI CÙNG phải đạt được:
 *                    nợ cũ = số dư mục tiêu − công nợ đang treo trên các chứng từ đã nhập)
 *
 * Vì sao cần 'balance': file khách hàng của phần mềm cũ ghi "Nợ cần thu HIỆN TẠI" — số này ĐÃ
 * bao gồm công nợ của các hóa đơn chưa thu trong file hóa đơn. Nhập cả hai mà không cân đối
 * thì công nợ bị cộng hai lần.
 */
function bulkImportOpeningDebts(data) {
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked',
    ['Customers', 'Suppliers', 'SalesOrders', 'SalesItems', 'PurchaseOrders', 'PurchaseItems'],
    function () { return bulkImportOpeningDebts(data); });
  try {
    var rows = data.rows || [];
    if (!rows.length) return err_('Không có dữ liệu để nhập');
    var mode = ['set', 'add', 'balance'].indexOf(data.mode) >= 0 ? data.mode : 'balance';
    var createMissing = data.createMissingParty !== false;
    var defType = data.defaultType === 'Supplier' ? 'Supplier' : 'Customer';
    var now = new Date(), warnings = [];
    var cmaps = impCustomerMaps_(), smaps = impSupplierMaps_();
    var isSupplierRow = function (r) {
      var s = impStr_(r.ObjectType).toLowerCase();
      if (!s) return defType === 'Supplier';
      return s === 'supplier' || s.indexOf('ncc') >= 0 || s.indexOf('cung cấp') >= 0 || s.indexOf('cung cap') >= 0 || s.indexOf('phải trả') >= 0;
    };

    if (createMissing) {
      var missC = {}, missS = {};
      rows.forEach(function (r) {
        var name = impStr_(r.Name), code = impStr_(r.Code);
        if (!name && !code) return;
        var sup = isSupplierRow(r);
        if (impFindParty_(sup ? smaps : cmaps, code, name, r.Phone)) return;
        var bucket = sup ? missS : missC;
        var k = (code || name).toLowerCase();
        if (!bucket[k]) bucket[k] = { code: code, name: name || code };
      });
      var mc = impCreateMissingCustomers_(cmaps, missC);
      var ms = impCreateMissingSuppliers_(smaps, missS);
      if (mc) warnings.push('Tự tạo ' + mc + ' khách hàng chưa có hồ sơ');
      if (ms) warnings.push('Tự tạo ' + ms + ' nhà cung cấp chưa có hồ sơ');
    }

    // Số dư đang treo trên chứng từ THẬT (không tính chứng từ nợ cũ) + chứng từ nợ cũ đang có.
    var realDebt = {}, openDoc = {};
    sheetToObjects_('SalesOrders').forEach(function (s) {
      if (!s.CustomerID || isCancelled_(normalizeStatus_(s.Status, ''))) return;
      if (String(s.Status) === 'NO_CU') { if (!openDoc['C' + s.CustomerID]) openDoc['C' + s.CustomerID] = s; return; }
      realDebt['C' + s.CustomerID] = (realDebt['C' + s.CustomerID] || 0) + toNumber(s.ReceivableAmount);
    });
    sheetToObjects_('PurchaseOrders').forEach(function (p) {
      if (!p.SupplierID || isCancelled_(normalizeStatus_(p.Status, ''))) return;
      if (String(p.Status) === 'NO_CU') { if (!openDoc['S' + p.SupplierID]) openDoc['S' + p.SupplierID] = p; return; }
      realDebt['S' + p.SupplierID] = (realDebt['S' + p.SupplierID] || 0) + toNumber(p.PayableAmount);
    });

    var newDocs = { Customer: [], Supplier: [] }, soUpd = {}, poUpd = {};
    var skipped = 0, seen = {}, touched = 0;
    rows.forEach(function (r) {
      var amount = impNum_(r.Amount);
      var sup = isSupplierRow(r);
      var party = impFindParty_(sup ? smaps : cmaps, r.Code, r.Name, r.Phone);
      if (!party) { skipped++; return; }
      var key = (sup ? 'S' : 'C') + party.id;
      if (seen[key]) { skipped++; return; }
      seen[key] = true;
      var cur = openDoc[key];
      var curOpen = cur ? toNumber(sup ? cur.PayableAmount : cur.ReceivableAmount) : 0;
      var target;
      if (mode === 'add') target = curOpen + amount;
      else if (mode === 'set') target = amount;
      else target = amount - (realDebt[key] || 0);     // balance
      target = Math.max(0, Math.round(target));
      if (target === Math.round(curOpen)) return;
      touched++;
      if (cur) {
        var paid = toNumber(sup ? cur.PaidAmount : cur.PaidAmount);
        var total = target + paid;
        if (sup) poUpd[cur.PurchaseID] = { Subtotal: total, TotalAmount: total, PayableAmount: target, PaymentStatus: calculatePaymentStatus(total, paid) };
        else soUpd[cur.SalesID] = { Subtotal: total, TotalAmount: total, ReceivableAmount: target, PaymentStatus: calculatePaymentStatus(total, paid) };
      } else if (target > 0) {
        newDocs[sup ? 'Supplier' : 'Customer'].push({ id: party.id, name: party.name, amount: target });
      }
    });

    if (Object.keys(soUpd).length) updateRowsById_('SalesOrders', 'SalesID', soUpd);
    if (Object.keys(poUpd).length) updateRowsById_('PurchaseOrders', 'PurchaseID', poUpd);
    if (newDocs.Customer.length) impWriteOpeningDocs_('Customer', newDocs.Customer, now);
    if (newDocs.Supplier.length) impWriteOpeningDocs_('Supplier', newDocs.Supplier, now);
    // Chứng từ nợ cũ bị sửa tổng tiền -> dòng chi tiết phải khớp lại cho khỏi lệch khi in.
    impSyncOpeningDocItems_(soUpd, poUpd);
    refreshAllCustomerBalances_();
    refreshAllSupplierBalances_();

    writeAudit_('Nhập công nợ đầu kỳ', 'Debt', '', 'Cập nhật ' + touched + ' đối tác (' + mode + '), bỏ qua ' + skipped);
    return impResult_(touched, 0, skipped, warnings,
      'Đã ghi công nợ đầu kỳ cho ' + touched + ' đối tác' + (skipped ? ', bỏ qua ' + skipped + ' dòng trùng/không tìm thấy' : ''));
  } catch (e) { return err_(e.message); }
}

/**
 * data: { rows: [{PaymentDate, ObjectType, Code, Name, PaymentDirection, Amount, Method, SourceID, Note}] }
 *   - Có SourceID khớp mã hóa đơn / phiếu mua -> ghi nhận thanh toán cho đúng chứng từ đó.
 *   - Không có SourceID -> tự phân bổ vào các chứng từ còn nợ của đối tác đó, cũ nhất trước.
 */
function bulkImportPayments(data) {
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked',
    ['Payments', 'PaymentAllocations', 'SalesOrders', 'PurchaseOrders', 'Customers', 'Suppliers'],
    function () { return bulkImportPayments(data); });
  try {
    var rows = data.rows || [];
    if (!rows.length) return err_('Không có dữ liệu để nhập');
    var now = new Date();
    var cmaps = impCustomerMaps_(), smaps = impSupplierMaps_();
    var soMap = {}, poMap = {}, partyDocs = {}, docByCode = {};
    sheetToObjects_('SalesOrders').forEach(function (s) {
      if (!s.SalesID) return;
      soMap[String(s.SalesID).trim().toLowerCase()] = s;
      if (isCancelled_(normalizeStatus_(s.Status, ''))) return;
      var rec = toNumber(s.ReceivableAmount); if (rec <= 0) return;
      var d = { id: s.SalesID, date: s.SalesDate, rec: rec, sup: false };
      (partyDocs['C' + s.CustomerID] = partyDocs['C' + s.CustomerID] || []).push(d);
      docByCode[String(s.SalesID).trim().toLowerCase()] = d;
    });
    sheetToObjects_('PurchaseOrders').forEach(function (p) {
      if (!p.PurchaseID) return;
      poMap[String(p.PurchaseID).trim().toLowerCase()] = p;
      if (isCancelled_(normalizeStatus_(p.Status, ''))) return;
      var pay = toNumber(p.PayableAmount); if (pay <= 0) return;
      var d = { id: p.PurchaseID, date: p.PurchaseDate, rec: pay, sup: true };
      (partyDocs['S' + p.SupplierID] = partyDocs['S' + p.SupplierID] || []).push(d);
      docByCode[String(p.PurchaseID).trim().toLowerCase()] = d;
    });
    Object.keys(partyDocs).forEach(function (k) {
      partyDocs[k].sort(function (a, b) { return new Date(a.date || 0).getTime() - new Date(b.date || 0).getTime(); });
    });
    // Chống nhập trùng khi chạy lại cùng 1 file: khóa = ngày + đối tượng + số tiền + mã chứng từ.
    var existingKeys = {};
    sheetToObjects_('Payments').forEach(function (p) {
      existingKeys[impPaymentKey_(p.PaymentDate, p.ObjectID, p.Amount, p.SourceID)] = true;
      existingKeys[impPaymentKey_(p.PaymentDate, p.ObjectID, p.Amount, '')] = true;
    });

    var isOut = function (v) {
      var s = impStr_(v).toLowerCase();
      return s === 'out' || s.indexOf('chi') === 0 || s.indexOf('trả') === 0 || s.indexOf('tra') === 0;
    };
    var isSupplier = function (v) {
      var s = impStr_(v).toLowerCase();
      return s === 'supplier' || s.indexOf('ncc') >= 0 || s.indexOf('cung cấp') >= 0 || s.indexOf('cung cap') >= 0;
    };

    var plan = [], skipped = 0, batchKeys = {};
    rows.forEach(function (r) {
      var amount = Math.max(0, impNum_(r.Amount));
      if (!amount) { skipped++; return; }
      var srcId = impStr_(r.SourceID);
      var so = srcId ? soMap[srcId.toLowerCase()] : null;
      var po = (!so && srcId) ? poMap[srcId.toLowerCase()] : null;
      var sup = po ? true : (so ? false : (isSupplier(r.ObjectType) || isOut(r.PaymentDirection)));
      var party = so ? { id: so.CustomerID, name: so.CustomerName }
        : po ? { id: po.SupplierID, name: po.SupplierName }
        : impFindParty_(sup ? smaps : cmaps, r.Code, r.Name, r.Phone);
      if (!party) { skipped++; return; }
      var date = impDate_(r.PaymentDate) || now;
      var key = impPaymentKey_(date, party.id, amount, so ? so.SalesID : (po ? po.PurchaseID : ''));
      if (existingKeys[key] || batchKeys[key]) { skipped++; return; }
      batchKeys[key] = true;
      plan.push({ r: r, amount: amount, so: so, po: po, sup: sup, party: party, date: date });
    });
    if (!plan.length) return impResult_(0, 0, skipped, [], 'Không có phiếu thu/chi mới để nhập' + (skipped ? ' (' + skipped + ' dòng trùng hoặc thiếu đối tượng)' : ''));

    var paySpecs = [], allocSpecs = [], soAdd = {}, poAdd = {}, allocated = 0, advance = 0;
    plan.forEach(function (p) {
      var base = {
        PaymentDate: p.date, ObjectType: p.sup ? 'Supplier' : 'Customer',
        ObjectID: p.party.id, ObjectName: p.party.name,
        PaymentDirection: p.sup ? 'Out' : 'In', Method: impStr_(p.r.Method) || 'Tiền mặt',
        BillImageUrl: '', BillAmount: '', BillOcrText: '',
        Note: impStr_(p.r.Note) || 'Nhập từ file', CreatedBy: getUser_(), CreatedAt: now
      };
      // 1) Phiếu ghi rõ mã chứng từ -> gắn thẳng vào chứng từ đó.
      if (p.so || p.po) {
        var direct = p.so || p.po;
        var directId = direct.SalesID || direct.PurchaseID;
        paySpecs.push(Object.assign({}, base, { SourceType: p.so ? 'SalesOrder' : 'PurchaseOrder', SourceID: directId, Amount: p.amount, allocs: null }));
        if (p.so) soAdd[directId] = (soAdd[directId] || 0) + p.amount;
        else poAdd[directId] = (poAdd[directId] || 0) + p.amount;
        var copy = docByCode[String(directId).trim().toLowerCase()];
        if (copy) copy.rec -= Math.min(copy.rec, p.amount);
        allocated++;
        return;
      }
      // 2) Không ghi mã -> phân bổ vào các chứng từ còn nợ (cũ nhất trước).
      var docs = partyDocs[(p.sup ? 'S' : 'C') + p.party.id] || [];
      var remain = p.amount, hits = [];
      for (var i = 0; i < docs.length && remain > 0.5; i++) {
        var doc = docs[i];
        if (doc.rec <= 0) continue;
        var take = Math.min(remain, doc.rec);
        hits.push({ doc: doc, amount: take });
        if (doc.sup) poAdd[doc.id] = (poAdd[doc.id] || 0) + take;
        else soAdd[doc.id] = (soAdd[doc.id] || 0) + take;
        doc.rec -= take;
        remain -= take;
      }
      if (hits.length === 1 && remain <= 0.5) {
        paySpecs.push(Object.assign({}, base, { SourceType: hits[0].doc.sup ? 'PurchaseOrder' : 'SalesOrder', SourceID: hits[0].doc.id, Amount: hits[0].amount, allocs: null }));
        allocated++;
      } else if (hits.length) {
        var sumHit = hits.reduce(function (s, h) { return s + h.amount; }, 0);
        paySpecs.push(Object.assign({}, base, { SourceType: 'Nhiều chứng từ', SourceID: '', Amount: sumHit, allocs: hits }));
        allocated++;
      }
      if (remain > 0.5) {
        // Hết chứng từ còn nợ -> phần dư ghi nhận là tiền trả trước, không trừ vào đâu cả.
        paySpecs.push(Object.assign({}, base, {
          SourceType: 'Manual', SourceID: '', Amount: remain, allocs: null,
          Note: base.Note + (hits.length ? ' (phần dư sau khi gắn chứng từ)' : ' (trả trước, chưa gắn chứng từ)')
        }));
        advance++;
      }
    });

    var payIds = generateIds('TT', paySpecs.length);
    var payRows = paySpecs.map(function (sp, i) {
      var row = Object.assign({}, sp, { PaymentID: payIds[i] });
      delete row.allocs;
      if (sp.allocs) sp.allocs.forEach(function (h) {
        allocSpecs.push({
          PaymentID: payIds[i], ObjectType: sp.ObjectType, ObjectID: sp.ObjectID, ObjectName: sp.ObjectName,
          SourceType: h.doc.sup ? 'PurchaseOrder' : 'SalesOrder', SourceID: h.doc.id, Amount: h.amount, CreatedAt: now
        });
      });
      return row;
    });
    appendRows('Payments', payRows);
    if (allocSpecs.length) {
      var allocIds = generateIds('AL', allocSpecs.length);
      appendRows('PaymentAllocations', allocSpecs.map(function (a, i) { return Object.assign({ AllocationID: allocIds[i] }, a); }));
    }

    var soUpd = {};
    Object.keys(soAdd).forEach(function (id) {
      var s = soMap[String(id).toLowerCase()]; if (!s) return;
      var total = toNumber(s.TotalAmount), paid = Math.min(total, toNumber(s.PaidAmount) + soAdd[id]);
      soUpd[id] = { PaidAmount: paid, ReceivableAmount: Math.max(0, total - paid), PaymentStatus: calculatePaymentStatus(total, paid) };
    });
    if (Object.keys(soUpd).length) updateRowsById_('SalesOrders', 'SalesID', soUpd);
    var poUpd = {};
    Object.keys(poAdd).forEach(function (id) {
      var p = poMap[String(id).toLowerCase()]; if (!p) return;
      var total = toNumber(p.TotalAmount), paid = Math.min(total, toNumber(p.PaidAmount) + poAdd[id]);
      poUpd[id] = { PaidAmount: paid, PayableAmount: Math.max(0, total - paid), PaymentStatus: calculatePaymentStatus(total, paid) };
    });
    if (Object.keys(poUpd).length) updateRowsById_('PurchaseOrders', 'PurchaseID', poUpd);
    refreshAllCustomerBalances_();
    refreshAllSupplierBalances_();

    writeAudit_('Nhập phiếu thu/chi từ file', 'Payment', '', 'Tạo ' + payRows.length + ' dòng (' + allocated + ' gắn chứng từ), bỏ qua ' + skipped);
    return impResult_(plan.length, 0, skipped, [],
      'Đã nhập ' + plan.length + ' phiếu thu/chi (' + allocated + ' tự gắn vào chứng từ còn nợ' + (advance ? ', ' + advance + ' ghi nhận trả trước' : '') + ')' + (skipped ? ', bỏ qua ' + skipped : ''));
  } catch (e) { return err_(e.message); }
}

/**
 * data: { rows: [{ProductSKU, ProductName, ComponentSKU, ComponentName, Quantity, Unit}], mode }
 * Mỗi dòng = 1 nguyên vật liệu của 1 thành phẩm. Các dòng cùng thành phẩm gộp thành 1 định mức.
 * mode: 'skip' (giữ định mức đã có) | 'update' (thay toàn bộ định mức của thành phẩm đó)
 */
function bulkImportBOM(data) {
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked', ['BOM'], function () { return bulkImportBOM(data); });
  try {
    var rows = data.rows || [];
    if (!rows.length) return err_('Không có dữ liệu để nhập');
    var mode = data.mode === 'update' ? 'update' : 'skip';
    var now = new Date();
    var pmaps = impProductMaps_();
    var existing = sheetToObjects_('BOM');
    var hasBom = {};
    existing.forEach(function (b) { if (b.ProductID) hasBom[b.ProductID] = true; });
    var groups = {}, skipped = 0;
    rows.forEach(function (r) {
      var prod = impFindProduct_(pmaps, r.ProductSKU, r.ProductName, r.ProductID);
      var comp = impFindProduct_(pmaps, r.ComponentSKU, r.ComponentName, r.ComponentID);
      var qty = impNum_(r.Quantity);
      if (!prod || !comp || qty <= 0 || prod.ProductID === comp.ProductID) { skipped++; return; }
      if (hasBom[prod.ProductID] && mode !== 'update') { skipped++; return; }
      var g = (groups[prod.ProductID] = groups[prod.ProductID] || { prod: prod, comps: {} });
      g.comps[comp.ProductID] = { comp: comp, qty: qty, unit: impStr_(r.Unit) || impStr_(comp.Unit) };
    });
    var pids = Object.keys(groups);
    if (!pids.length) return impResult_(0, 0, skipped, [], 'Không có định mức mới để nhập' + (skipped ? ' (' + skipped + ' dòng bỏ qua)' : ''));
    // Chế độ cập nhật: xóa định mức cũ của đúng những thành phẩm có trong file.
    var replaced = 0;
    if (mode === 'update') {
      existing.forEach(function (b) {
        if (!groups[b.ProductID]) return;
        deleteRowById('BOM', 'BOMItemID', b.BOMItemID);
        replaced++;
      });
    }
    var lines = [];
    pids.forEach(function (pid) {
      var g = groups[pid];
      Object.keys(g.comps).forEach(function (cid) { lines.push({ g: g, c: g.comps[cid] }); });
    });
    var ids = generateIds('BOM', lines.length);
    appendRows('BOM', lines.map(function (x, i) {
      return {
        BOMItemID: ids[i], ProductID: x.g.prod.ProductID, ProductName: x.g.prod.ProductName,
        ComponentID: x.c.comp.ProductID, ComponentName: x.c.comp.ProductName, ComponentSKU: x.c.comp.SKU,
        Quantity: x.c.qty, Unit: x.c.unit, CreatedAt: now
      };
    }));
    writeAudit_('Nhập định mức từ file', 'BOM', '', 'Tạo ' + lines.length + ' dòng cho ' + pids.length + ' thành phẩm');
    return impResult_(pids.length, replaced, skipped, [],
      'Đã nhập định mức cho ' + pids.length + ' thành phẩm (' + lines.length + ' dòng NVL)' + (skipped ? ', bỏ qua ' + skipped : ''));
  } catch (e) { return err_(e.message); }
}
/* ===== HẾT ENGINE NHẬP EXCEL ===== */

/* ===== AMC MODULE: ĐỊNH DẠNG MÃ LINH HOẠT (đồng bộ 4 phiên bản) ===== */
/**
 * Cho phép người dùng TỰ ĐẶT quy tắc sinh mã cho từng loại chứng từ / đối tượng
 * (hóa đơn, khách hàng, nhà cung cấp, phiếu mua, phiếu trả...).
 *
 * MẪU MÃ dùng các thẻ:
 *   {SEQ} hoặc {SEQ:n}  số thứ tự tự tăng (n = số chữ số, 1..8, mặc định 3)
 *   {YYYY} {YY} {MM} {DD}  năm / tháng / ngày theo múi giờ của bảng tính
 * Ví dụ: "HD{YY}{MM}-{SEQ:4}" -> HD2608-0001
 *
 * AN TOÀN:
 *  - Chưa cấu hình gì thì chạy y hệt trước đây (KH001, HD001...) -> dữ liệu cũ không đổi.
 *  - Mã cũ GIỮ NGUYÊN, chỉ mã sinh MỚI theo mẫu mới.
 *  - Trước khi cấp mã luôn dò số lớn nhất đang có khớp mẫu + kiểm tra mã đã tồn tại
 *    -> KHÔNG BAO GIỜ cấp trùng, kể cả khi đổi mẫu qua lại hay vừa nhập từ Excel.
 */

var CODE_FORMAT_DEFS_ = [
  { key: 'KH', sheet: 'Customers', label: 'Khách hàng', icon: 'group' },
  { key: 'NCC', sheet: 'Suppliers', label: 'Nhà cung cấp', icon: 'storefront' },
  { key: 'SP', sheet: 'Products', label: 'Sản phẩm', icon: 'inventory_2' },
  { key: 'HD', sheet: 'SalesOrders', label: 'Hóa đơn bán', icon: 'receipt_long' },
  { key: 'PM', sheet: 'PurchaseOrders', label: 'Phiếu mua', icon: 'local_shipping' },
  { key: 'BG', sheet: 'Quotes', label: 'Báo giá', icon: 'request_quote' },
  { key: 'TT', sheet: 'Payments', label: 'Phiếu thu / chi', icon: 'payments' },
  { key: 'TR', sheet: 'SalesReturns', label: 'Trả hàng khách', icon: 'assignment_return' },
  { key: 'PR', sheet: 'PurchaseReturns', label: 'Trả hàng NCC', icon: 'assignment_return' },
  { key: 'KK', sheet: 'InventoryChecks', label: 'Phiếu kiểm kê', icon: 'fact_check' },
  { key: 'MV', sheet: 'StockMovements', label: 'Phiếu kho', icon: 'swap_vert' },
  { key: 'LSX', sheet: 'ProductionOrders', label: 'Lệnh sản xuất', icon: 'precision_manufacturing' },
  { key: 'FT', sheet: 'FinanceTransactions', label: 'Bút toán sổ quỹ', icon: 'account_balance_wallet' }
];

var CODE_RESET_OPTIONS_ = [
  { value: 'never', label: 'Không reset (chạy liên tục)' },
  { value: 'year', label: 'Reset đầu mỗi NĂM' },
  { value: 'month', label: 'Reset đầu mỗi THÁNG' },
  { value: 'day', label: 'Reset mỗi NGÀY' }
];

var CODE_TOKENS_ = [
  { token: '{SEQ}', desc: 'Số thứ tự tự tăng (3 chữ số): 001, 002...' },
  { token: '{SEQ:4}', desc: 'Số thứ tự với số chữ số tự chọn (1-8): 0001' },
  { token: '{YYYY}', desc: 'Năm 4 chữ số: 2026' },
  { token: '{YY}', desc: 'Năm 2 chữ số: 26' },
  { token: '{MM}', desc: 'Tháng 2 chữ số: 08' },
  { token: '{DD}', desc: 'Ngày 2 chữ số: 04' }
];

/** Chỉ hiện những loại chứng từ mà PHIÊN BẢN NÀY thực sự có (TM không có Lệnh sản xuất...). */
function codeFormatEntities_() {
  return CODE_FORMAT_DEFS_.filter(function (d) {
    return !!SCHEMA[d.sheet] && prefixToSheet_(d.key) === d.sheet;
  });
}
function codeFormatDef_(key) {
  var list = codeFormatEntities_();
  for (var i = 0; i < list.length; i++) if (list[i].key === key) return list[i];
  return null;
}

/** Ngày/tháng/năm theo múi giờ bảng tính — 1 lần gọi formatDate rồi cắt chuỗi. */
function codeDateParts_(when) {
  var s = Utilities.formatDate(when || new Date(), getTz_(), 'yyyy-MM-dd');
  return { yyyy: s.slice(0, 4), yy: s.slice(2, 4), mm: s.slice(5, 7), dd: s.slice(8, 10) };
}

function codePad_(n, width) {
  var s = String(Math.max(0, Math.round(toNumber(n))));
  while (s.length < width) s = '0' + s;
  return s;
}

/** Dựng 1 mã hoàn chỉnh từ mẫu + số thứ tự. */
function renderCodeTemplate_(template, seq, when) {
  var p = codeDateParts_(when);
  var out = String(template || '');
  out = out.replace(/\{YYYY\}/g, p.yyyy).replace(/\{YY\}/g, p.yy)
    .replace(/\{MM\}/g, p.mm).replace(/\{DD\}/g, p.dd);
  out = out.replace(/\{SEQ(?::(\d+))?\}/g, function (m, n) {
    var w = Math.min(8, Math.max(1, parseInt(n || '3', 10) || 3));
    return codePad_(seq, w);
  });
  return out;
}

/** Biểu thức nhận diện các mã ĐÃ SINH theo cùng mẫu & cùng kỳ -> để dò số lớn nhất. */
function codeTemplateRegex_(template, when) {
  var p = codeDateParts_(when);
  var t = String(template || '');
  var esc = function (s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); };
  var re = /\{(SEQ)(?::(\d+))?\}|\{(YYYY|YY|MM|DD)\}/g;
  var pattern = '', last = 0, m;
  while ((m = re.exec(t))) {
    pattern += esc(t.slice(last, m.index));
    if (m[1] === 'SEQ') pattern += '(\\d+)';
    else pattern += esc(p[String(m[3]).toLowerCase()]);
    last = m.index + m[0].length;
  }
  pattern += esc(t.slice(last));
  try { return new RegExp('^' + pattern + '$'); } catch (e) { console.warn('[codeTemplateRegex_]', (e && e.message) || String(e));  return null; }
}

/** Đọc cấu hình mẫu mã (có cache trong 1 lần thực thi). */
var REQ_CODE_FORMATS_ = null;
function codeFormatMap_() {
  if (REQ_CODE_FORMATS_) return REQ_CODE_FORMATS_;
  var map = {};
  try {
    sheetToObjects_('CodeFormats').forEach(function (r) {
      if (!r.EntityKey) return;
      map[String(r.EntityKey).trim()] = {
        Template: String(r.Template || '').trim(),
        ResetBy: String(r.ResetBy || 'never').trim(),
        Enabled: !(String(r.Enabled) === 'false' || r.Enabled === false || String(r.Enabled) === 'Không')
      };
    });
  } catch (e) { console.warn('[codeFormatMap_]', (e && e.message) || String(e));  map = {}; }
  REQ_CODE_FORMATS_ = map;
  return map;
}
function invalidateCodeFormats_() { REQ_CODE_FORMATS_ = null; invalidateReqCache_('CodeFormats'); }

/** Trả về cấu hình đang ÁP DỤNG cho 1 prefix, hoặc null nếu dùng cách sinh mã mặc định. */
function codeFormatFor_(prefix) {
  var def = codeFormatDef_(prefix);
  if (!def) return null;
  var cfg = codeFormatMap_()[prefix];
  if (!cfg || !cfg.Enabled) return null;
  if (!cfg.Template || cfg.Template.indexOf('{SEQ') < 0) return null;
  return cfg;
}

function codePeriodKey_(resetBy, when) {
  var p = codeDateParts_(when);
  if (resetBy === 'year') return p.yyyy;
  if (resetBy === 'month') return p.yyyy + p.mm;
  if (resetBy === 'day') return p.yyyy + p.mm + p.dd;
  return 'ALL';
}

/** Số thứ tự lớn nhất đang tồn tại trong sheet KHỚP đúng mẫu + kỳ hiện tại. */
function codeSeqMaxForTemplate_(prefix, template, when) {
  var def = codeFormatDef_(prefix);
  if (!def) return 0;
  var keys = SCHEMA[def.sheet];
  var idKey = keys ? keys[0] : null;
  if (!idKey) return 0;
  var rx = codeTemplateRegex_(template, when);
  if (!rx) return 0;
  var rows = sheetToObjects_(def.sheet), max = 0;
  for (var i = 0; i < rows.length; i++) {
    var m = rx.exec(String(rows[i][idKey] || ''));
    if (m && m[1]) { var n = parseInt(m[1], 10); if (!isNaN(n) && n > max) max = n; }
  }
  return max;
}

/** Tập hợp toàn bộ mã đang có của 1 loại chứng từ -> chặn tuyệt đối việc cấp trùng. */
function codeExistingIdSet_(prefix) {
  var def = codeFormatDef_(prefix);
  var set = {};
  if (!def) return set;
  var keys = SCHEMA[def.sheet];
  var idKey = keys ? keys[0] : null;
  if (!idKey) return set;
  sheetToObjects_(def.sheet).forEach(function (r) {
    var v = String(r[idKey] || '');
    if (v) set[v] = true;
  });
  return set;
}

/** Đọc / ghi bộ đếm theo khóa (prefix + kỳ). Dùng chung sheet Counters sẵn có. */
function codeCounterRead_(sh, key) {
  var rows = sheetToObjects_('Counters');
  for (var i = 0; i < rows.length; i++) {
    if (String(rows[i].Prefix) === key) return { row: rows[i].__row, value: toNumber(rows[i].LastSeq) };
  }
  return { row: -1, value: 0 };
}

/* Giữ nguyên cách sinh mã cũ (PREFIX + 3 chữ số) cho các loại chưa cấu hình. */
function nextIdsLegacy_(prefix, count) {
  trackMutationSheet_('Counters');
  var sh = getCountersSheet_();
  var cur = codeCounterRead_(sh, prefix);
  var rowIdx = cur.row, stored = cur.value;
  var base = Math.max(stored, codeHealBase_(prefix, stored));
  if (rowIdx < 0) { rowIdx = sh.getLastRow() + 1; sh.getRange(rowIdx, 1).setValue(prefix); }
  var ids = [];
  for (var j = 1; j <= count; j++) ids.push(prefix + padSeqFor_(prefix, base + j));
  sh.getRange(rowIdx, 2).setValue(base + count);
  invalidateReqCache_('Counters');
  return ids;
}

function nextIds_(prefix, count) {
  trackMutationSheet_('Counters');
  count = Math.max(0, toNumber(count));
  if (!count) return [];
  var cfg = codeFormatFor_(prefix);
  if (!cfg) return nextIdsLegacy_(prefix, count);

  var now = new Date();
  var counterKey = codeCounterKey_(prefix, cfg, now);
  var sh = getCountersSheet_();
  var cur = migrateCodeCounter_(prefix, cfg, now);
  var rowIdx = cur.row;
  var base = Math.max(cur.value, codeSeqMaxForTemplate_(prefix, cfg.Template, now));
  if (rowIdx < 0) { rowIdx = sh.getLastRow() + 1; sh.getRange(rowIdx, 1).setValue(counterKey); }

  var existing = codeExistingIdSet_(prefix);
  var ids = [], n = base, guard = 0;
  while (ids.length < count && guard++ < count + 5000) {
    n++;
    var code = renderCodeTemplate_(cfg.Template, n, now);
    if (existing[code]) continue;   // mã đã tồn tại (nhập từ Excel, đổi mẫu qua lại...) -> bỏ qua
    existing[code] = true;
    ids.push(code);
  }
  if (ids.length < count) throw new Error('Không cấp đủ mã mới cho "' + prefix + '". Hãy kiểm tra lại Mẫu mã trong Cài đặt.');
  sh.getRange(rowIdx, 2).setValue(n);
  invalidateReqCache_('Counters');
  return ids;
}

/* ---------------------------------------------------------------- API cho giao diện */

/** Mẫu mặc định của 1 loại = y hệt cách sinh mã cũ. */
function codeDefaultTemplate_(key) { return key + '{SEQ:3}'; }

function getCodeFormats() {
  try {
    var map = codeFormatMap_();
    var now = new Date();
    var entities = codeFormatEntities_().map(function (d) {
      var cfg = map[d.key] || {};
      var template = cfg.Template || codeDefaultTemplate_(d.key);
      var resetBy = cfg.ResetBy || 'never';
      var enabled = cfg.Template ? cfg.Enabled !== false : false;
      var seqMax = 0, samples = [];
      try {
        seqMax = codeSeqMaxForTemplate_(d.key, template, now);
        for (var i = 1; i <= 3; i++) samples.push(renderCodeTemplate_(template, seqMax + i, now));
      } catch (e) { console.warn('[getCodeFormats]', (e && e.message) || String(e));  samples = []; }
      return {
        key: d.key, label: d.label, icon: d.icon, sheet: d.sheet,
        sheetLabel: resolveSheetName_(d.sheet),
        template: template, resetBy: resetBy, enabled: enabled,
        currentSeq: seqMax, samples: samples,
        isDefault: template === codeDefaultTemplate_(d.key) && !enabled
      };
    });
    return ok_({ entities: entities, tokens: CODE_TOKENS_, resetOptions: CODE_RESET_OPTIONS_ });
  } catch (e) { return err_(e, 'ERR_CODEFMT_LIST'); }
}

/** Kiểm tra 1 mẫu mã; trả về lỗi dễ hiểu hoặc 3 mã ví dụ. */
function validateCodeTemplate_(template) {
  var t = String(template || '').trim();
  if (!t) return 'Chưa nhập mẫu mã';
  if (t.length > 40) return 'Mẫu mã quá dài (tối đa 40 ký tự)';
  if (t.indexOf('{SEQ') < 0) return 'Mẫu mã bắt buộc phải có {SEQ} để mỗi chứng từ một mã riêng';
  if ((t.match(/\{SEQ(?::\d+)?\}/g) || []).length > 1) return 'Chỉ được dùng {SEQ} một lần';
  if (/^[=+@]/.test(t)) return 'Mẫu mã không được bắt đầu bằng =, + hoặc @';
  var leftover = t.replace(/\{SEQ(?::\d+)?\}|\{YYYY\}|\{YY\}|\{MM\}|\{DD\}/g, '');
  if (/[{}]/.test(leftover)) return 'Có thẻ không hợp lệ. Chỉ dùng: {SEQ} {SEQ:n} {YYYY} {YY} {MM} {DD}';
  if (!/^[A-Za-z0-9\-_.\/]*$/.test(leftover)) return 'Phần cố định chỉ được dùng chữ, số và các ký tự - _ . /';
  var m = t.match(/\{SEQ:(\d+)\}/);
  if (m && (Number(m[1]) < 1 || Number(m[1]) > 8)) return 'Số chữ số của {SEQ} phải từ 1 đến 8';
  return '';
}

function previewCodeFormat(template, entityKey) {
  try {
    var err = validateCodeTemplate_(template);
    if (err) return err_(err, 'ERR_CODEFMT_INVALID');
    var now = new Date();
    var start = 0;
    try { if (entityKey) start = codeSeqMaxForTemplate_(entityKey, template, now); } catch (e) { console.warn('[previewCodeFormat]', (e && e.message) || String(e));  start = 0; }
    var samples = [];
    for (var i = 1; i <= 3; i++) samples.push(renderCodeTemplate_(template, start + i, now));
    return ok_({ samples: samples, currentSeq: start });
  } catch (e) { return err_(e, 'ERR_CODEFMT_PREVIEW'); }
}

/**
 * Lưu cấu hình. list: [{key, template, resetBy, enabled}]
 * Chỉ ghi những loại có trong phiên bản này; kiểm tra 2 loại không sinh ra cùng dãy mã.
 */
function saveCodeFormats(list) {
  return withMutationLock_(['CodeFormats'], function () {
    try {
      list = list || [];
      var valid = {}, errors = [];
      codeFormatEntities_().forEach(function (d) { valid[d.key] = d; });

      var rendered = {};
      var rows = [];
      list.forEach(function (x) {
        var d = valid[x.key];
        if (!d) return;                       // loại không có ở bản này -> bỏ qua
        var enabled = !!x.enabled;
        var template = String(x.template || '').trim() || codeDefaultTemplate_(d.key);
        if (enabled) {
          var err = validateCodeTemplate_(template);
          if (err) { errors.push(d.label + ': ' + err); return; }
          var sample = renderCodeTemplate_(template, 1, new Date());
          if (rendered[sample]) { errors.push(d.label + ' và ' + rendered[sample] + ' sinh ra cùng một dãy mã (' + sample + '). Hãy đổi phần cố định cho khác nhau.'); return; }
          rendered[sample] = d.label;
        }
        rows.push({
          EntityKey: d.key, Label: d.label, Template: template,
          ResetBy: ['never', 'year', 'month', 'day'].indexOf(x.resetBy) >= 0 ? x.resetBy : 'never',
          Enabled: enabled ? 'true' : 'false',
          UpdatedAt: new Date(), UpdatedBy: getUser_()
        });
      });
      if (errors.length) return err_(errors.join(' | '), 'ERR_CODEFMT_INVALID');

      bulkWrite_('CodeFormats', rows);
      invalidateCodeFormats_();
      writeAudit_('Lưu định dạng mã', 'CodeFormats', '', rows.filter(function (r) { return r.Enabled === 'true'; })
        .map(function (r) { return r.EntityKey + '=' + r.Template; }).join(', ') || 'Tất cả về mặc định');
      return ok_({ saved: rows.length }, 'Đã lưu định dạng mã. Các mã tạo mới sẽ theo mẫu này, mã cũ giữ nguyên.');
    } catch (e) { return err_(e, 'ERR_CODEFMT_SAVE'); }
  });
}

/** Đặt lại số đếm của 1 loại về giá trị mong muốn (mã kế tiếp = value + 1). */
function resetCodeSequence(entityKey, value) {
  return withMutationLock_(['CodeFormats'], function () {
    try {
      var d = codeFormatDef_(entityKey);
      if (!d) return err_('Không có loại chứng từ "' + entityKey + '" trong phiên bản này', 'ERR_CODEFMT_KEY');
      var n = Math.max(0, Math.round(toNumber(value)));
      var cfg = codeFormatFor_(entityKey);
      var now = new Date();
      var key = cfg ? codeCounterKey_(entityKey, cfg, now) : entityKey;
      var template = cfg ? cfg.Template : codeDefaultTemplate_(entityKey);
      var existingMax = codeSeqMaxForTemplate_(entityKey, template, now);
      if (n < existingMax) {
        return err_('Không đặt được về ' + n + ' vì đang có mã tới số ' + existingMax +
          '. Đặt số nhỏ hơn sẽ sinh mã trùng.', 'ERR_CODEFMT_SEQ_LOW');
      }
      var sh = getCountersSheet_();
      var cur = codeCounterRead_(sh, key);
      var rowIdx = cur.row;
      if (rowIdx < 0) { rowIdx = sh.getLastRow() + 1; sh.getRange(rowIdx, 1).setValue(key); }
      sh.getRange(rowIdx, 2).setValue(n);
      invalidateReqCache_('Counters');
      writeAudit_('Đặt lại số đếm mã', 'CodeFormats', entityKey, 'Về ' + n);
      return ok_({ next: renderCodeTemplate_(template, n + 1, now) }, 'Mã kế tiếp sẽ là ' + renderCodeTemplate_(template, n + 1, now));
    } catch (e) { return err_(e, 'ERR_CODEFMT_RESET'); }
  });
}
/* ===== HẾT MODULE ĐỊNH DẠNG MÃ ===== */

/* ===== AMCVN CORE V1: DỰ ÁN -> MÁY -> MODULE ============================ */

function amcvnText_(v) { return String(v == null ? '' : v).trim(); }
function amcvnPercent_(v) { return Math.max(0, Math.min(100, toNumber(v))); }
function amcvnFind_(sheetName, idKey, id) {
  var rows = sheetToObjects_(sheetName);
  for (var i = 0; i < rows.length; i++) if (String(rows[i][idKey]) === String(id)) return rows[i];
  return null;
}
function amcvnCodeExists_(sheetName, codeKey, code, exceptIdKey, exceptId) {
  var key = amcvnText_(code).toLowerCase();
  return sheetToObjects_(sheetName).some(function (r) {
    return amcvnText_(r[codeKey]).toLowerCase() === key
      && (!exceptIdKey || String(r[exceptIdKey]) !== String(exceptId));
  });
}
function amcvnPick_(src, fields) {
  var out = {};
  fields.forEach(function (f) { if (src[f] !== undefined) out[f] = src[f]; });
  return out;
}
function amcvnCustomerRef_(id, name) {
  var cid = amcvnText_(id), cname = amcvnText_(name);
  try {
    var rows = sheetToObjects_('Customers'), hit = null;
    for (var i = 0; i < rows.length; i++) {
      if ((cid && String(rows[i].CustomerID) === cid)
        || (!cid && cname && amcvnText_(rows[i].CustomerName).toLowerCase() === cname.toLowerCase())) { hit = rows[i]; break; }
    }
    if (hit) return { CustomerID: hit.CustomerID, CustomerName: hit.CustomerName };
  } catch (e) { console.warn('[amcvnCustomerRef_]', (e && e.message) || String(e)); }
  return { CustomerID: cid, CustomerName: cname };
}
function amcvnSortCode_(a, b, key) {
  return amcvnText_(a[key]).localeCompare(amcvnText_(b[key]), undefined, { numeric: true });
}
function refreshProjectRollup_(projectId) {
  var machines = sheetToObjects_('Machines').filter(function (m) { return String(m.ProjectID) === String(projectId); });
  var qty = machines.length, progress = 0, ctb = 0;
  machines.forEach(function (m) { progress += amcvnPercent_(m.ProgressPercent); ctb += amcvnPercent_(m.CTBPercent); });
  updateRowById('Projects', 'ProjectID', projectId, {
    MachineQty: qty,
    ProgressPercent: qty ? Math.round(progress / qty) : 0,
    CTBPercent: qty ? Math.round(ctb / qty) : 0,
    UpdatedAt: new Date()
  });
}
function refreshMachineRollup_(machineId) {
  var machine = amcvnFind_('Machines', 'MachineID', machineId);
  if (!machine) return;
  var modules = sheetToObjects_('MachineModules').filter(function (m) { return String(m.MachineID) === String(machineId); });
  if (modules.length) {
    var progress = modules.reduce(function (sum, m) { return sum + amcvnPercent_(m.ProgressPercent); }, 0);
    updateRowById('Machines', 'MachineID', machineId, {
      ProgressPercent: Math.round(progress / modules.length), UpdatedAt: new Date()
    });
  }
  refreshProjectRollup_(machine.ProjectID);
}

