function financeNow_() { return new Date(); }
function financeBool_(v) { return v === true || String(v).toLowerCase() === 'true' || String(v) === '1' || String(v).toLowerCase() === 'yes'; }
function financePeriodKey_(dateValue) { var d = parseDate_(dateValue) || new Date(); return Utilities.formatDate(d, getTz_(), 'yyyy-MM'); }
function financeStartOfMonth_(periodKey) { var parts = String(periodKey || financePeriodKey_(new Date())).split('-'); return new Date(Number(parts[0]), Number(parts[1]) - 1, 1); }
function financeEndOfMonth_(periodKey) { var s = financeStartOfMonth_(periodKey); return new Date(s.getFullYear(), s.getMonth() + 1, 0); }
function financeInRange_(value, start, end) {
  var d = parseDate_(value); if (!d) return false;
  if (start && d < start) return false;
  if (end) { var ee = new Date(end); ee.setHours(23, 59, 59, 999); if (d > ee) return false; }
  return true;
}
function financeFindById_(sheet, key, id) {
  return sheetToObjects_(sheet).filter(function (r) { return String(r[key]) === String(id); })[0] || null;
}
function financeDefaultAccount_() {
  var rows = sheetToObjects_('CashAccounts').filter(function (a) { return String(a.Status || 'Đang hoạt động') !== 'Ngừng dùng'; });
  return rows.filter(function (a) { return financeBool_(a.IsDefault); })[0] || rows[0] || null;
}
function financeCategoryByName_(name, type) {
  var rows = sheetToObjects_('FinanceCategories');
  return rows.filter(function (c) {
    return String(c.CategoryName) === String(name) && (!type || String(c.CategoryType) === String(type));
  })[0] || null;
}

