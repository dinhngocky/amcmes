function migrateFinanceModule() {
  try {
    installFinanceSchema_();
    // 'Payments' phải có mặt: schema vừa thêm 2 cột AccountID/AccountName ở cuối.
    ['CashAccounts', 'FinanceCategories', 'FinanceTransactions', 'BudgetPlans', 'BudgetLines', 'Payments'].forEach(function (name) {
      var sh = getSheet_(name);
      sh.getRange(1, 1, 1, SCHEMA[name].length).setValues([viHeaders_(name)]);
      formatSheetHeader_(sh, name);
    });
    seedFinanceDefaults_();
    try { syncPaymentsToFinance_(); } catch (syncErr) { console.warn('[migrateFinanceModule]', (syncErr && syncErr.message) || String(syncErr));  }
    recalculateFinance();
    return ok_(null, 'Đã đảm bảo cấu trúc module Tài chính');
  } catch (e) { return err_(e.message); }
}

/* Trước đây bootstrap chỉ lấy `.data` của các lời gọi con. Nếu getFinanceDashboard hoặc
   getFinanceTransactions thất bại thì `.data` = undefined nhưng bootstrap VẪN trả success:true
   -> giao diện im lặng hiện toàn số 0, không có cách nào biết hỏng ở đâu.
   Nay mỗi bước được bọc riêng và lỗi được gom vào `errors` để UI hiển thị. */
function getFinanceBootstrap() {
  var errors = [];

  function step(label, fn, fallback) {
    try {
      var r = fn();

      if (r && r.success === false) {
        errors.push(label + ': ' + (r.message || 'lỗi không rõ'));
        return fallback;
      }

      return r;
    } catch (e) { console.warn('[step]', (e && e.message) || String(e)); 
      errors.push(label + ': ' + e.message);
      return fallback;
    }
  }

  try {
    installFinanceSchema_();
  } catch (e) {
    return err_('Không khởi tạo được cấu trúc module Tài chính: ' + e.message);
  }

  step('Khởi tạo dữ liệu mặc định', function () {
    seedFinanceDefaults_();
    return null;
  }, null);

  /**
   * Fix lỗi:
   * WebApp vào Tài chính nhưng tab Thu/Chi rỗng cho đến khi bấm Đối soát.
   *
   * Nguyên nhân:
   * Payments đã có dữ liệu nhưng FinanceTransactions thiếu bút toán tương ứng.
   *
   * Cách xử lý:
   * Khi bootstrap tài chính, kiểm tra Payment nào chưa có FinanceTransaction thì tự sync nhẹ.
   * syncFinanceFromPayment_ đã chống trùng bằng SourceType=Payment + SourceID=PaymentID.
   */
  var needSync = step('Kiểm tra phiếu thanh toán thiếu bút toán', function () {
    return financePaymentsNeedSync_();
  }, false);

  if (needSync) {
    step('Đồng bộ phiếu thanh toán sang sổ thu chi', function () {
      return syncPaymentsToFinance_();
    }, null);
  }

  /**
   * Luôn tính lại số dư và ngân sách trước khi trả payload.
   * Việc này giúp dashboard và tab Thu/Chi khớp ngay sau F5, không cần bấm Đối soát.
   */
  step('Tính lại số dư sổ quỹ và ngân sách', function () {
    return recalculateFinance();
  }, null);

  // Sau khi có thể vừa ghi thêm bút toán/tính lại số dư, bắt buộc xóa cache đọc sheet.
  clearDataCache_();

  var accounts = step('Đọc Tài khoản tiền', function () {
    return cachedSheetToObjects_('CashAccounts');
  }, []);

  var categories = step('Đọc Danh mục thu chi', function () {
    return cachedSheetToObjects_('FinanceCategories');
  }, []);

  var transactions = step('Đọc Sổ thu chi', function () {
    var r = getFinanceTransactions({});
    return r.success === false ? r : r.data;
  }, []);

  var budgets = step('Đọc Ngân sách', function () {
    return cachedSheetToObjects_('BudgetPlans');
  }, []);

  var budgetLines = step('Đọc Chi tiết ngân sách', function () {
    return cachedSheetToObjects_('BudgetLines');
  }, []);

  var dashboard = step('Tính bảng điều khiển', function () {
    var r = getFinanceDashboard({ period: 'month' });
    return r.success === false ? r : r.data;
  }, null);

  if (!dashboard) dashboard = {};

  var payload = {
    cashAccounts: accounts,
    financeCategories: categories,
    financeTransactions: transactions,
    budgets: budgets,
    budgetLines: budgetLines,
    financeDashboard: dashboard,
    errors: errors
  };

  if (!accounts.length && !errors.length) {
    errors.push('Chưa có tài khoản tiền nào. Hãy bấm "Khởi tạo lại module Tài chính".');
  }

  /**
   * Nếu không đọc được giao dịch nào nhưng tài khoản có số dư khác số dư đầu kỳ,
   * nghĩa là đang có khả năng đọc nhầm tab rỗng hoặc cache/sheet chưa đồng bộ.
   */
  if (!errors.length && accounts.length && !transactions.length) {
    var drifted = accounts.filter(function (a) {
      return Math.abs(toNumber(a.CurrentBalance) - toNumber(a.OpeningBalance)) > 0.5;
    });

    if (drifted.length) {
      errors.push(
        'Sổ thu chi đọc ra 0 giao dịch, nhưng ' + drifted.length +
        ' tài khoản có số dư khác số dư đầu kỳ. Hãy chạy Chẩn đoán/Đối soát để kiểm tra tab dữ liệu.'
      );
    }
  }

  return ok_(payload);
}

/* Tìm các bút toán sổ quỹ bị nhân bản.
   - Trùng TransactionID (ID cấp trùng).
   - Trùng bút toán sinh từ cùng một phiếu thanh toán (SourceType=Payment + SourceID).
   Trả về danh sách CHỈ SỐ DÒNG cần xóa (giữ dòng đầu tiên). */
function findFinanceDuplicates_() {
  var rows = sheetToObjects_('FinanceTransactions');
  var seenId = {}, seenSrc = {}, dupIds = [], dupSrc = [], drop = [];
  rows.forEach(function (t, i) {
    var rowNo = i + 2; // +1 header, +1 index 0
    var id = String(t.TransactionID || '');
    var isDup = false;
    if (id) {
      if (seenId[id]) { dupIds.push(id); isDup = true; }
      else seenId[id] = true;
    }
    if (!isDup && String(t.SourceType || '') === 'Payment' && t.SourceID && String(t.Status) !== 'Cancelled') {
      var k = String(t.SourceID);
      if (seenSrc[k]) { dupSrc.push(k); isDup = true; }
      else seenSrc[k] = true;
    }
    if (isDup) drop.push({ row: rowNo, TransactionID: id, SourceID: t.SourceID, Amount: toNumber(t.Amount) });
  });
  return { total: rows.length, drop: drop, duplicateIds: dupIds, duplicatePayments: dupSrc };
}
function getFinanceDuplicates() { try { return ok_(findFinanceDuplicates_()); } catch (e) { return err_(e.message); } }

/* Xóa các dòng nhân bản (từ dưới lên để không lệch chỉ số), rồi tính lại số dư & ngân sách. */
function repairFinanceDuplicates() {
  return withMutationLock_(['FinanceTransactions', 'CashAccounts', 'BudgetPlans', 'BudgetLines'], function () {
    try {
      var found = findFinanceDuplicates_();
      if (!found.drop.length) return ok_({ removed: 0 }, 'Không có bút toán nào bị nhân bản.');
      var sh = getSheet_('FinanceTransactions');
      var rowsDesc = found.drop.map(function (d) { return d.row; }).sort(function (a, b) { return b - a; });
      rowsDesc.forEach(function (r) { sh.deleteRow(r); });
      clearDataCache_();
      recalculateFinance();
      writeAudit_('Dọn bút toán nhân bản', 'FinanceTransaction', '', 'Đã xóa ' + rowsDesc.length + ' dòng trùng');
      return ok_({ removed: rowsDesc.length, detail: found.drop },
        'Đã xóa ' + rowsDesc.length + ' bút toán bị nhân bản và tính lại số dư tài khoản.');
    } catch (e) { return err_(e.message); }
  });
}

/* Liệt kê TOÀN BỘ tab thật trong bảng tính (tên + số dòng + số cột).
   Dùng để phát hiện trường hợp getSheet_ tự tạo tab rỗng vì tab dữ liệu bị đổi tên. */
function getSpreadsheetTabs() {
  try {
    var tabs = getSpreadsheet_().getSheets().map(function (sh) {
      return { name: sh.getName(), rows: Math.max(0, sh.getLastRow() - 1), cols: sh.getLastColumn() };
    });
    return ok_(tabs);
  } catch (e) { return err_(e.message); }
}

/* Chẩn đoán từng bước — chạy thủ công trong Apps Script Editor hoặc từ nút trên UI. */
function diagnoseFinance() {
  var out = { steps: [], ok: true };
  function s(label, fn) {
    try { var v = fn(); out.steps.push({ step: label, ok: true, info: v }); }
    catch (e) { console.warn('[s]', (e && e.message) || String(e));  out.ok = false; out.steps.push({ step: label, ok: false, info: e.message }); }
  }
  s('installFinanceSchema_', function () { installFinanceSchema_(); return 'ok'; });

  // Tab nào đang thực sự tồn tại? (phát hiện tab dữ liệu bị đổi tên -> code đọc nhầm tab rỗng)
  var realTabs = [];
  s('Các tab thật trong bảng tính', function () {
    realTabs = getSpreadsheet_().getSheets().map(function (sh) { return { name: sh.getName(), rows: Math.max(0, sh.getLastRow() - 1) }; });
    return realTabs.map(function (t) { return t.name + ' (' + t.rows + ' dòng)'; }).join(' · ');
  });
  ['CashAccounts', 'FinanceCategories', 'FinanceTransactions', 'BudgetPlans', 'BudgetLines'].forEach(function (name) {
    s('Sheet "' + resolveSheetName_(name) + '"', function () {
      var want = resolveSheetName_(name);
      var sh = getSheet_(name);
      // Không liệt kê được tab (quyền/thiếu API) -> chỉ báo số dòng, KHÔNG kết luận thiếu tab.
      if (!realTabs.length) return 'dòng=' + Math.max(0, sh.getLastRow() - 1) + ', cột=' + sh.getLastColumn() + ' (schema cần ' + SCHEMA[name].length + ' cột)';
      var hit = realTabs.filter(function (t) { return t.name === want; })[0];
      if (!hit) throw new Error('KHÔNG có tab tên "' + want + '" — code sẽ tự tạo tab rỗng. Kiểm tra xem tab dữ liệu có bị đổi tên không.');
      var msg = 'dòng=' + hit.rows + ', cột=' + sh.getLastColumn() + ' (schema cần ' + SCHEMA[name].length + ' cột)';
      if (name === 'FinanceTransactions' && hit.rows === 0) {
        var known = Object.keys(SCHEMA).map(function (k) { return resolveSheetName_(k); });
        var similar = realTabs.filter(function (t) {
          return t.name !== want && t.rows > 0 && known.indexOf(t.name) < 0 && /thu chi|giao dịch|transaction|finance/i.test(t.name);
        });
        if (similar.length) throw new Error('Tab "' + want + '" RỖNG, nhưng có tab khác đang chứa dữ liệu: ' + similar.map(function (t) { return '"' + t.name + '" (' + t.rows + ' dòng)'; }).join(', ') + '. Hãy đổi tên tab đó thành "' + want + '".');
      }
      return msg;
    });
  });
  s('seedFinanceDefaults_', function () { seedFinanceDefaults_(); return 'ok'; });
  s('Đếm tài khoản tiền', function () { return sheetToObjects_('CashAccounts').length + ' tài khoản'; });
  s('getFinanceTransactions', function () { var r = getFinanceTransactions({}); if (!r.success) throw new Error(r.message); return r.data.length + ' giao dịch'; });
  s('recalculateCashAccounts', function () { var r = recalculateCashAccounts(); if (!r.success) throw new Error(r.message); return 'ok'; });
  s('Kích thước cache Sổ thu chi', function () {
    var json = JSON.stringify(sanitizeForClient_(sheetToObjects_('FinanceTransactions')));
    var b = utf8Length_(json);
    return b + ' byte (' + json.length + ' ký tự) — giới hạn CacheService 102400 byte' + (b >= 90000 ? ' → BỎ QUA cache' : ' → có cache');
  });
  s('Bút toán nhân bản', function () {
    var d = findFinanceDuplicates_();
    if (d.drop.length) throw new Error(d.drop.length + ' dòng trùng trên tổng ' + d.total + ' → bấm "Dọn bút toán trùng"');
    return 'không có (tổng ' + d.total + ' dòng)';
  });
  s('getFinanceDashboard', function () { var r = getFinanceDashboard({ period: 'month' }); if (!r.success) throw new Error(r.message); return 'tổng số dư = ' + r.data.totalCashBalance; });
  s('getFinanceReports', function () { var r = getFinanceReports({ period: 'month' }); if (!r.success) throw new Error(r.message); return 'ok'; });
  try { Logger.log(JSON.stringify(out, null, 2)); } catch (e) { console.warn('[diagnoseFinance]', (e && e.message) || String(e));  }
  return ok_(out);
}

