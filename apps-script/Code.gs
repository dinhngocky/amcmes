    ui.ButtonSet.OK_CANCEL
  );
  if (res.getSelectedButton() !== ui.Button.OK) return;
  var url = normalizeWebAppUrl_(res.getResponseText());
  if (!url) {
    ui.alert('Bạn chưa nhập WebApp URL hoặc Deployment ID.');
    return;
  }
  saveWebAppUrl_(url);
  ui.alert('Đã lưu link WebApp:\n' + url);
}

