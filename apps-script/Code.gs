}
installQrTraceSchema_();
/**
 * Parse QR theo cấu trúc MỚI: PartNumber|PO|ProjectCode|Quantity
 * Trả về object hoặc null nếu không hợp lệ.
 */
function parseQrValue_(qrValue) {
  var raw = String(qrValue || '').trim();
  if (!raw) return null;

  // Cấu trúc mới: 4 phần ngăn bởi dấu |
  var parts = raw.split('|');
  if (parts.length === 4) {
    return {
      raw: raw,
      partNumber: String(parts[0] || '').trim(),
      purchaseId: String(parts[1] || '').trim(),
      projectCode: String(parts[2] || '').trim(),
      quantity: toNumber(parts[3]),
      isLegacy: false
    };
  }

  // Tương thích ngược: QR cũ có thể là ReceiptItemID|PartNumber|Qty
  if (parts.length === 3) {
    return {
      raw: raw,
      receiptItemId: String(parts[0] || '').trim(),
      partNumber: String(parts[1] || '').trim(),
      quantity: toNumber(parts[2]),
      isLegacy: true
    };
  }

  // QR chỉ là mã hàng đơn thuần → coi như tìm theo mã hàng
  return {
    raw: raw,
    partNumber: raw,
    quantity: 0,
    isLegacy: false,
    partNumberOnly: true
  };
}

/**
 * Tìm TẤT CẢ các lô vật tư khớp với QR.
 *
 * Chiến lược tìm (theo thứ tự ưu tiên):
 *   1. Nếu QR có ReceiptItemID (legacy) → tìm chính xác 1 dòng
 *   2. Nếu QR có PartNumber + PurchaseID + ProjectCode → tìm trong WarehouseReceiptItems
 *      theo các tiêu chí đó, có thể ra NHIỀU dòng (nhiều lô)
 *   3. Nếu QR chỉ có PartNumber → tìm tất cả các dòng nhận có mã hàng đó
 *   4. Nếu PartNumber không khớp lô nào → tra Products để lấy tồn kho tổng
 */
function findQrMatches_(parsed) {
  if (!parsed) return { lots: [], products: [], parsed: null };

  var products = sheetToObjects_('Products');
  var productMap = {};
  products.forEach(function (p) {
    var key = String(p.PartNumber || '').trim().toLowerCase();
    if (key) productMap[key] = p;
    var skuKey = String(p.SKU || '').trim().toLowerCase();
    if (skuKey && !productMap[skuKey]) productMap[skuKey] = p;
  });

  var product = productMap[String(parsed.partNumber || '').toLowerCase()] || null;

  // Bước 1: Legacy QR có ReceiptItemID
  if (parsed.isLegacy && parsed.receiptItemId) {
    var item = sheetToObjects_('WarehouseReceiptItems').filter(function (x) {
      return String(x.ReceiptItemID) === String(parsed.receiptItemId);
    })[0];
    if (item) {
      return { lots: [item], products: product ? [product] : [], parsed: parsed, matchType: 'EXACT_LOT' };
    }
  }

  // Bước 2 & 3: Tìm theo mã hàng (+ PO + dự án nếu có)
  if (!parsed.partNumber) {
    return { lots: [], products: product ? [product] : [], parsed: parsed, matchType: 'PRODUCT_ONLY' };
  }

  var receiptMap = {};
  sheetToObjects_('WarehouseReceipts').forEach(function (r) { receiptMap[r.ReceiptID] = r; });

  var reqMap = {};
  sheetToObjects_('MaterialRequirements').forEach(function (r) { reqMap[r.RequirementID] = r; });

  var machineMap = {};
  sheetToObjects_('Machines').forEach(function (m) { machineMap[m.MachineID] = m; });

  var projectMap = {};
  sheetToObjects_('Projects').forEach(function (p) { projectMap[p.ProjectID] = p; });

  var partLower = String(parsed.partNumber).toLowerCase();
  var candidates = [];

  sheetToObjects_('WarehouseReceiptItems').forEach(function (x) {
    var partNo = String(x.PartNumber || '').trim().toLowerCase();
    if (partNo !== partLower) {
      // Cho phép match theo SKU của sản phẩm
      if (product && String(x.ProductID) !== String(product.ProductID)) return;
      if (!product) return;
    }

    var receipt = receiptMap[x.ReceiptID] || {};
    var req = x.RequirementID ? (reqMap[x.RequirementID] || {}) : {};
    var machine = req.MachineID ? (machineMap[req.MachineID] || {}) : {};
    var project = req.ProjectID ? (projectMap[req.ProjectID] || {}) : (machine.ProjectID ? (projectMap[machine.ProjectID] || {}) : {});

    // Lọc theo PO nếu QR có
    if (parsed.purchaseId && String(receipt.PurchaseID || '') !== parsed.purchaseId) {
      // Cho phép match một phần (PO TQ đôi khi có prefix)
      if (String(receipt.PurchaseID || '').indexOf(parsed.purchaseId) < 0 &&
          parsed.purchaseId.indexOf(String(receipt.PurchaseID || '')) < 0) return;
    }

    // Lọc theo dự án nếu QR có
    if (parsed.projectCode) {
      var pc = String(project.ProjectCode || req.ProjectCode || '').toLowerCase();
      if (pc !== parsed.projectCode.toLowerCase()) return;
    }

    var lotQty = toNumber(x.AcceptedQty) > 0 ? toNumber(x.AcceptedQty) : toNumber(x.ReceivedQty);
    candidates.push({
      item: x,
      receipt: receipt,
      req: req,
      machine: machine,
      project: project,
      lotQty: lotQty
    });
  });

  // Sắp xếp: ưu tiên lô có SL khớp với QR, sau đó mới đến lô mới nhất
  if (parsed.quantity > 0) {
    candidates.sort(function (a, b) {
      var diffA = Math.abs(a.lotQty - parsed.quantity);
      var diffB = Math.abs(b.lotQty - parsed.quantity);
      return diffA - diffB;
    });
  } else {
    candidates.sort(function (a, b) {
      var ta = a.receipt.ReceiptDate ? new Date(a.receipt.ReceiptDate).getTime() : 0;
      var tb = b.receipt.ReceiptDate ? new Date(b.receipt.ReceiptDate).getTime() : 0;
      return tb - ta;
    });
  }

  var lots = candidates.map(function (c) { return c.item; });
  var matchType = lots.length === 0 ? 'PRODUCT_ONLY'
                : lots.length === 1 ? 'EXACT_LOT'
                : 'MULTI_LOT';

  return {
    lots: lots,
    candidates: candidates,
    products: product ? [product] : [],
    parsed: parsed,
    matchType: matchType
  };
}
/**
 * TRUY XUẤT QR — trả về nguồn gốc, vị trí, lịch sử di chuyển.
 *
 * Trả về:
 *   {
 *     parsed: { partNumber, purchaseId, projectCode, quantity },
 *     product: { ... } | null,
 *     lots: [
 *       {
 *         item, receipt, req, machine, module, project,
 *         locations: [{ LocationCode, Quantity, LotNo, UpdatedAt }],
 *         currentQty, systemLocation,
 *         movements: [{ Date, Type, QtyIn, QtyOut, WarehouseName, SourceID, Notes }]
 *       }
 *     ],
 *     matchType: 'EXACT_LOT' | 'MULTI_LOT' | 'PRODUCT_ONLY' | 'NOT_FOUND'
 *   }
 */
function traceByQr(qrValue) {
  try {
    var parsed = parseQrValue_(qrValue);
    if (!parsed || !parsed.partNumber) {
      return err_('Mã QR không hợp lệ. Cấu trúc đúng: Mã hàng|PO|Dự án|Số lượng', 'ERR_QR_INVALID');
    }

    var matches = findQrMatches_(parsed);
    if (!matches.lots.length && !matches.products.length) {
      return ok_({
        parsed: parsed,
        product: null,
        lots: [],
        matchType: 'NOT_FOUND',
        message: 'Không tìm thấy vật tư nào khớp với mã QR này.'
      });
    }

    var product = matches.products[0] || null;
    var whMap = {};
    try { whAll_().forEach(function (w) { whMap[w.WarehouseID] = w; }); } catch (e) { console.warn('[traceByQr]', (e && e.message) || String(e));  }

    var machineMap = {};
    sheetToObjects_('Machines').forEach(function (m) { machineMap[m.MachineID] = m; });

    var moduleMap = {};
    sheetToObjects_('MachineModules').forEach(function (m) { moduleMap[m.ModuleID] = m; });

    var projectMap = {};
    sheetToObjects_('Projects').forEach(function (p) { projectMap[p.ProjectID] = p; });

    var productMap = {};
    sheetToObjects_('Products').forEach(function (p) { productMap[p.ProductID] = p; });

    // Tập hợp tất cả ProductID liên quan để lấy lịch sử biến động 1 lần
    var productIds = {};
    matches.lots.forEach(function (it) { if (it.ProductID) productIds[it.ProductID] = true; });
    if (product) productIds[product.ProductID] = true;

    var movementsByProduct = {};
    sheetToObjects_('StockMovements').forEach(function (m) {
      var pid = String(m.ProductID || '');
      if (!productIds[pid]) return;
      (movementsByProduct[pid] = movementsByProduct[pid] || []).push(m);
    });
    Object.keys(movementsByProduct).forEach(function (pid) {
      movementsByProduct[pid].sort(function (a, b) {
        return new Date(b.Date || b.CreatedAt || 0).getTime() - new Date(a.Date || a.CreatedAt || 0).getTime();
      });
    });

    // Vị trí kho hiện tại theo ProductID (dùng chung cho mọi lô cùng sản phẩm)
    var locationsByProduct = {};
    sheetToObjects_('MaterialLocations').forEach(function (loc) {
      if (toNumber(loc.Quantity) <= 0) return;
      var pid = String(loc.ProductID || '');
      (locationsByProduct[pid] = locationsByProduct[pid] || []).push(loc);
    });

    var outLots = [];

    matches.lots.forEach(function (item) {
      var receipt = matches.candidates.filter(function (c) { return c.item === item; })[0] || {};
      var lotProduct = productMap[item.ProductID] || product || {};
      var req = receipt.req || {};
      var machine = receipt.machine || {};
      var module = req.ModuleID ? (moduleMap[req.ModuleID] || {}) : {};
      var project = receipt.project || {};

      var locs = (locationsByProduct[item.ProductID] || []).filter(function (loc) {
        // Lọc theo lô: khớp ReceiptItemID nếu có, hoặc LotNo
        if (loc.ReceiptItemID && String(loc.ReceiptItemID) === String(item.ReceiptItemID)) return true;
        if (item.LotNo && loc.LotNo && String(loc.LotNo) === String(item.LotNo)) return true;
        if (loc.RequirementID && req.RequirementID && String(loc.RequirementID) === String(req.RequirementID)) return true;
        return false;
      });
      if (!locs.length && item.LocationCode) {
        // Fallback: lấy theo vị trí ghi trên dòng nhận hàng
        locs = (locationsByProduct[item.ProductID] || []).filter(function (loc) {
          return String(loc.LocationCode || '') === String(item.LocationCode || '');
        });
      }

      var currentQty = locs.reduce(function (s, l) { return s + toNumber(l.Quantity); }, 0);
      var systemLocation = locs.map(function (l) {
        return (l.LocationCode || '?') + (l.LotNo ? ' (' + l.LotNo + ')' : '');
      }).join(', ');

      var moves = (movementsByProduct[item.ProductID] || []).slice(0, 30).map(function (m) {
        var w = whMap[m.WarehouseID] || {};
        return {
          MovementID: m.MovementID,
          Date: m.Date || m.CreatedAt,
          Type: m.Type,
          SourceType: m.SourceType,
          SourceID: m.SourceID,
          QuantityIn: toNumber(m.QuantityIn),
          QuantityOut: toNumber(m.QuantityOut),
          UnitCost: toNumber(m.UnitCost),
          WarehouseName: m.WarehouseName || w.WarehouseName || '',
          Status: m.Status || '',
          Notes: m.Notes || ''
        };
      });

      outLots.push({
        ReceiptItemID: item.ReceiptItemID,
        ReceiptID: item.ReceiptID,
        ReceiptDate: receipt.receipt ? receipt.receipt.ReceiptDate : '',
        PurchaseID: receipt.receipt ? receipt.receipt.PurchaseID : '',
        SupplierName: receipt.receipt ? receipt.receipt.SupplierName : '',
        WarehouseName: receipt.receipt ? receipt.receipt.WarehouseName : '',
        ProductID: item.ProductID,
        SKU: item.SKU,
        PartNumber: item.PartNumber,
        ProductName: item.ProductName,
        BrandMaterial: lotProduct.BrandMaterial || '',
        Unit: item.Unit || lotProduct.Unit || '',
        ReceivedQty: toNumber(item.ReceivedQty),
        AcceptedQty: toNumber(item.AcceptedQty),
        IQCStatus: item.IQCStatus || '',
        LotNo: item.LotNo || '',
        LocationCode: item.LocationCode || '',
        CurrentLocations: locs.map(function (l) {
          return {
            LocationID: l.LocationID,
            WarehouseID: l.WarehouseID,
            WarehouseName: l.WarehouseName,
            LocationCode: l.LocationCode,
            LotNo: l.LotNo,
            Quantity: toNumber(l.Quantity),
            Status: l.Status,
            UpdatedAt: l.UpdatedAt
          };
        }),
        CurrentQty: currentQty,
        SystemLocation: systemLocation,
        ProjectID: project.ProjectID || '',
        ProjectCode: project.ProjectCode || '',
        MachineID: machine.MachineID || '',
        MachineCode: machine.MachineCode || '',
        MachineName: machine.MachineName || '',
        ModuleID: module.ModuleID || '',
        ModuleCode: module.ModuleCode || '',
        ModuleName: module.ModuleName || '',
        RequirementID: req.RequirementID || '',
        Movements: moves
      });
    });

    // Sản phẩm tổng quát (dùng khi QR chỉ có mã hàng, không khớp lô nào)
    var productInfo = null;
    if (product) {
      var pLocs = (locationsByProduct[product.ProductID] || []).map(function (l) {
        return {
          LocationCode: l.LocationCode,
          WarehouseName: l.WarehouseName,
          Quantity: toNumber(l.Quantity),
          LotNo: l.LotNo
        };
      });
      productInfo = {
        ProductID: product.ProductID,
        SKU: product.SKU,
        PartNumber: product.PartNumber,
        ProductName: product.ProductName,
        BrandMaterial: product.BrandMaterial,
        Unit: product.Unit,
        CurrentStock: toNumber(product.CurrentStock),
        Locations: pLocs,
        Movements: (movementsByProduct[product.ProductID] || []).slice(0, 30).map(function (m) {
          return {
            MovementID: m.MovementID,
            Date: m.Date || m.CreatedAt,
            Type: m.Type,
            SourceID: m.SourceID,
            QuantityIn: toNumber(m.QuantityIn),
            QuantityOut: toNumber(m.QuantityOut),
            WarehouseName: m.WarehouseName || '',
            Notes: m.Notes || ''
          };
        })
      };
    }

    return ok_({
      parsed: parsed,
      product: productInfo,
      lots: outLots,
      matchType: matches.matchType,
      lotCount: outLots.length
    });
  } catch (e) {
    return err_(e, 'ERR_QR_TRACE');
  }
}
/**
 * KIỂM VỊ TRÍ — so sánh vị trí hệ thống với vị trí thực tế.
 *
 * Trả về danh sách các lô khớp QR kèm:
 *   - systemLocation: vị trí hệ thống
 *   - actualLocation: vị trí người dùng nhập
 *   - result: MATCH | MISMATCH
 */
function auditLocationByQr(qrValue, actualLocation, actualQty) {
  try {
    var traceResult = traceByQr(qrValue);
    if (!traceResult.success) return traceResult;

    var data = traceResult.data;
    var actualLoc = String(actualLocation || '').trim().toUpperCase();
    var actualQuantity = toNumber(actualQty);

    var audits = data.lots.map(function (lot) {
      var sysLoc = String(lot.SystemLocation || '').toUpperCase();
      var sysQty = toNumber(lot.CurrentQty);
      var result;
      if (!sysLoc && !actualLoc) result = 'MATCH';
      else if (sysLoc === actualLoc) result = 'MATCH';
      else if (!sysLoc && actualLoc) result = 'EXTRA';
      else if (sysLoc && !actualLoc) result = 'MISMATCH';
      else result = 'MISMATCH';

      // Nếu có SL thực tế, kiểm tra thêm
      if (result === 'MATCH' && actualQuantity > 0 && Math.abs(actualQuantity - sysQty) > 0.0001) {
        result = 'MISMATCH';
      }

      return {
        ReceiptItemID: lot.ReceiptItemID,
        PartNumber: lot.PartNumber,
        ProductID: lot.ProductID,
        ProductName: lot.ProductName,
        MachineID: lot.MachineID,
        ModuleID: lot.ModuleID,
        RequirementID: lot.RequirementID,
        SystemLocation: sysLoc,
        ActualLocation: actualLoc,
        SystemQty: sysQty,
        ActualQty: actualQuantity > 0 ? actualQuantity : sysQty,
        Result: result,
        LotNo: lot.LotNo,
        Locations: lot.CurrentLocations
      };
    });

    // Nếu QR không khớp lô nào nhưng vẫn tìm thấy sản phẩm
    if (!audits.length && data.product) {
      var p = data.product;
      audits.push({
        ReceiptItemID: '',
        PartNumber: p.PartNumber,
        ProductID: p.ProductID,
        ProductName: p.ProductName,
        MachineID: '',
        ModuleID: '',
        RequirementID: '',
        SystemLocation: (p.Locations || []).map(function (l) { return l.LocationCode; }).join(', ').toUpperCase(),
        ActualLocation: actualLoc,
        SystemQty: toNumber(p.CurrentStock),
        ActualQty: actualQuantity > 0 ? actualQuantity : toNumber(p.CurrentStock),
        Result: (p.Locations || []).length ? (actualLoc ? 'MISMATCH' : 'MATCH') : 'NOT_FOUND',
        LotNo: '',
        Locations: p.Locations || []
      });
    }

    return ok_({
      parsed: data.parsed,
      audits: audits,
      matchType: data.matchType,
      lotCount: audits.length
    });
  } catch (e) {
    return err_(e, 'ERR_QR_AUDIT');
  }
}
/**
 * LƯU KẾT QUẢ KIỂM VỊ TRÍ.
 *
 * data: {
 *   QRValue: string,
 *   audits: [{ ReceiptItemID, PartNumber, ProductID, MachineID, ModuleID,
 *              RequirementID, SystemLocation, ActualLocation,
 *              SystemQty, ActualQty, Result, Notes }],
 *   autoUpdateLocation: boolean,   // true = cập nhật MaterialLocations theo vị trí thực tế
 *   Notes: string                  // ghi chú chung
 * }
 */
function saveLocationAudit(data) {
  data = data || {};
  if (!data.__locked) {
    return runLocked_(data, '__locked',
      ['LocationAudits', 'MaterialLocations', 'AuditLog'],
      function () { return saveLocationAudit(data); });
  }
  try {
    var audits = data.audits || [];
    if (!audits.length) return err_('Không có dòng nào để lưu.', 'ERR_AUDIT_EMPTY');

    var qrValue = String(data.QRValue || '').trim();
    var now = new Date();
    var user = getUser_();
    var autoUpdate = !!data.autoUpdateLocation;
    var rows = [];
    var ids = generateIds('AUDIT', audits.length);
    var idx = 0;
    var updatedLocations = 0;

    audits.forEach(function (a) {
      rows.push({
        AuditID: ids[idx++],
        QRValue: qrValue,
        PartNumber: String(a.PartNumber || '').trim(),
        ProductID: String(a.ProductID || '').trim(),
        MachineID: String(a.MachineID || '').trim(),
        ModuleID: String(a.ModuleID || '').trim(),
        RequirementID: String(a.RequirementID || '').trim(),
        ReceiptItemID: String(a.ReceiptItemID || '').trim(),
        SystemLocation: String(a.SystemLocation || '').trim().toUpperCase(),
        ActualLocation: String(a.ActualLocation || '').trim().toUpperCase(),
        SystemQty: toNumber(a.SystemQty),
        ActualQty: toNumber(a.ActualQty),
        Result: String(a.Result || 'MATCH').toUpperCase(),
        AuditedBy: user,
        AuditedAt: now,
        Notes: String(a.Notes || data.Notes || '').trim()
      });
    });

    appendRows('LocationAudits', rows);

    // Cập nhật MaterialLocations nếu yêu cầu và kết quả là MISMATCH
    if (autoUpdate) {
      audits.forEach(function (a) {
        if (String(a.Result).toUpperCase() !== 'MISMATCH') return;
        var newLoc = String(a.ActualLocation || '').trim().toUpperCase();
        if (!newLoc) return;

        // Tìm MaterialLocations theo ProductID + RequirementID (hoặc ReceiptItemID)
        var locs = sheetToObjects_('MaterialLocations').filter(function (l) {
          if (String(l.ProductID) !== String(a.ProductID)) return false;
          if (toNumber(l.Quantity) <= 0) return false;
          if (a.ReceiptItemID && String(l.ReceiptItemID) === String(a.ReceiptItemID)) return true;
          if (a.RequirementID && String(l.RequirementID) === String(a.RequirementID)) return true;
          return false;
        });

        locs.forEach(function (l) {
          updateRowById('MaterialLocations', 'LocationID', l.LocationID, {
            LocationCode: newLoc,
            UpdatedAt: now,
            UpdatedBy: user,
            Notes: (l.Notes || '') + ' | Cập nhật từ kiểm vị trí ' + now.toISOString().slice(0, 10)
          });
          updatedLocations++;
        });
      });
    }

    writeAudit_('Kiểm vị trí kho', 'LocationAudit', qrValue,
      audits.length + ' dòng · ' + (autoUpdate ? 'đã cập nhật ' + updatedLocations + ' vị trí' : 'chỉ ghi log'));

    return ok_({
      saved: rows.length,
      updatedLocations: updatedLocations,
      auditIds: rows.map(function (r) { return r.AuditID; })
    }, 'Đã lưu ' + rows.length + ' dòng kiểm vị trí'
      + (autoUpdate ? (', cập nhật ' + updatedLocations + ' vị trí trong kho' ) : ''));
  } catch (e) {
    return err_(e, 'ERR_AUDIT_SAVE');
  }
}
/**
 * LỊCH SỬ KIỂM VỊ TRÍ — dùng cho màn hình Kiểm vị trí kho.
 */
function getLocationAudits(filters) {
  try {
    filters = filters || {};
    var rows = sheetToObjects_('LocationAudits').slice();

    if (filters.from || filters.to) {
      var from = filters.from ? new Date(String(filters.from) + 'T00:00:00') : null;
      var to = filters.to ? new Date(String(filters.to) + 'T23:59:59') : null;
      rows = rows.filter(function (r) {
        var d = r.AuditedAt ? new Date(r.AuditedAt) : null;
        if (!d || isNaN(d.getTime())) return false;
        if (from && d < from) return false;
        if (to && d > to) return false;
        return true;
      });
    }
    if (filters.result) {
      rows = rows.filter(function (r) { return String(r.Result).toUpperCase() === String(filters.result).toUpperCase(); });
    }
    if (filters.auditedBy) {
      rows = rows.filter(function (r) { return String(r.AuditedBy) === String(filters.auditedBy); });
    }
    if (filters.search) {
      var q = String(filters.search).toLowerCase();
      rows = rows.filter(function (r) {
        var hay = [r.QRValue, r.PartNumber, r.ProductID, r.SystemLocation, r.ActualLocation, r.Notes].join(' ').toLowerCase();
        return hay.indexOf(q) >= 0;
      });
    }

    rows.sort(function (a, b) {
      return new Date(b.AuditedAt || 0).getTime() - new Date(a.AuditedAt || 0).getTime();
    });

    // Thống kê nhanh
    var stats = {
      total: rows.length,
      match: rows.filter(function (r) { return String(r.Result).toUpperCase() === 'MATCH'; }).length,
      mismatch: rows.filter(function (r) { return String(r.Result).toUpperCase() === 'MISMATCH'; }).length,
      notFound: rows.filter(function (r) { return String(r.Result).toUpperCase() === 'NOT_FOUND'; }).length,
      extra: rows.filter(function (r) { return String(r.Result).toUpperCase() === 'EXTRA'; }).length
    };

    return ok_({ rows: rows.slice(0, 500), total: rows.length, stats: stats });
  } catch (e) {
    return err_(e, 'ERR_AUDIT_LIST');
  }
}
