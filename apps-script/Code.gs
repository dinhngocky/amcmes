function completeProductionOrderActuals(id, actualQty, materials) {
  return runLocked_({id: id}, '__locked', ['ProductionOrders', 'ProductionMaterials', 'ProductionProgressLogs', 'StockMovements', 'Products'], function () {
    try {
      ensureProductionWorkflowSchema_();
      var o = sheetToObjects_('ProductionOrders').filter(function (x) { return x.ProductionID === id; })[0];
      if (!o) return err_('Không tìm thấy lệnh');
      if (o.Status === 'Hoàn thành') return err_('Lệnh đã hoàn thành trước đó. Hệ thống không ghi kho lần hai.');
      if (o.Status !== 'Đang sản xuất') return err_('Chỉ lệnh đang sản xuất mới được hoàn thành. Trạng thái hiện tại: ' + (o.Status || 'Không xác định'));

      var finishedQty = toNumber(actualQty);
      if (finishedQty <= 0) return err_('Số lượng thành phẩm thực tế phải lớn hơn 0.');
      materials = Array.isArray(materials) ? materials : [];
      var productMap = {}; sheetToObjects_('Products').forEach(function (p) { productMap[p.ProductID] = p; });
      var materialRows = sheetToObjects_('ProductionMaterials').filter(function (m) { return m.ProductionID === id && isStockProductionMaterial_(m, productMap); });
      var actualMap = {};
      materials.forEach(function (m) { actualMap[m.ProductionMatID] = Number(m.ActualQuantity); });
      for (var i = 0; i < materialRows.length; i++) {
        var row = materialRows[i];
        var actual = actualMap[row.ProductionMatID];
        if (!isFinite(actual) || actual < 0) return err_('Số lượng thực tế của "' + row.ComponentName + '" không hợp lệ.');
        updateRowById('ProductionMaterials', 'ProductionMatID', row.ProductionMatID, { ActualQuantity: actual });
      }

      updateRowById('ProductionOrders', 'ProductionID', id, { ActualQuantity: finishedQty });
      syncProductionInventory_(id, 'Hoàn thành');

      var now = new Date();
      updateRowById('ProductionOrders', 'ProductionID', id, {
        Status: 'Hoàn thành', ActualQuantity: finishedQty, ProgressPercent: 100,
        CurrentStage: 'Hoàn thành', StartedAt: o.StartedAt || now, CompletedAt: now
      });
      appendProductionProgressLog_(id, 'Hoàn thành', 100, 'Chốt số lượng thực tế và nhập thành phẩm', now);
      writeAudit_('Chốt sản xuất thực tế', 'ProductionOrder', id, 'TP: ' + actualQty);
      return ok_(null, 'Đã hoàn thành lệnh SX và chốt hao hụt');
    } catch (e) { return err_(e.message); }
  });
}

