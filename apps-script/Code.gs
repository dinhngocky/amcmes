var PRODUCT_CLASSIFICATION_DEFAULTS_ = [
  'Thành phẩm', 'Module', 'Vật tư gia công CNC', 'Vật tư Kim loại tấm',
  'Vật tư tiêu chuẩn', 'Vật tư phụ trợ', 'CCDC', 'Khác'
