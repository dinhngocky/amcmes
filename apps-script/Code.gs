function procDays_(date){return date?Math.floor((Date.parse(procDay_(date)+'T00:00:00Z')-Date.parse(procToday_()+'T00:00:00Z'))/86400000):null;}
function procDatePlus_(days){var d=new Date(procToday_()+'T12:00:00Z');d.setUTCDate(d.getUTCDate()+Number(days));return d.toISOString().slice(0,10);}
