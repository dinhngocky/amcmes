 *  GENERIC CRUD
 * ========================================================================== */

function getSheetData(sheetName) {
  try {
    // Sheet "Người dùng" có mã băm mật khẩu -> không bao giờ gửi thô ra trình duyệt.
    if (sheetName === 'Users') return getUsers();
    return ok_(cachedSheetToObjects_(sheetName));
  }
  catch (e) { return err_(e.message); }
}

/** Thêm dòng từ object (theo thứ tự cột SCHEMA, key tiếng Anh). Trả về object đã ghi. */
function appendRow(sheetName, object) {
  trackMutationSheet_(sheetName);
  if (typeof whStampRows_ === 'function') whStampRows_(sheetName, [object]);
  if (typeof vatStampRows_ === 'function') vatStampRows_(sheetName, [object]);
  clearDataCache_(sheetName);
  var sh = getSheet_(sheetName);
  var keys = SCHEMA[sheetName] || readSheetRange_(sh, 1, 1, 1, sh.getLastColumn())[0];
  var obj = normalizeMaterialRefV224_(sheetName, translateRowForSheet_(object));
  var row = keys.map(function (h) { return (obj[h] !== undefined && obj[h] !== null) ? obj[h] : ''; });
  sh.appendRow(row);
  invalidateReqCache_(sheetName);
  return object;
}

function updateRowById(sheetName, idColumn, idValue, updates) {
  trackMutationSheet_(sheetName);
  var rows = sheetToObjects_(sheetName), sh = getSheet_(sheetName);
  var keys = SCHEMA[sheetName] || (sheetToObjects_(sheetName, true)[0] || []);
  if (keys.indexOf(idColumn) < 0) throw new Error('Không có cột ' + idColumn);
  var row = rows.filter(function (r) { return String(r[idColumn]) === String(idValue); })[0];
  if (!row) return false;
  var u = normalizeMaterialRefV224_(sheetName, Object.assign({},row,translateRowForSheet_(updates)));
  var values = keys.map(function (key) { var v = u[key] !== undefined ? u[key] : row[key]; return v == null ? '' : v; });
  sh.getRange(row.__row, 1, 1, keys.length).setValues([values]);
  clearDataCache_(sheetName); invalidateReqCache_(sheetName); return true;
}

function updateInlineNote(sheetName, idValue, note) {
  try {
    var allow = {
      Products: 'ProductID',
      Customers: 'CustomerID',
      Suppliers: 'SupplierID',
      PurchaseOrders: 'PurchaseID',
      SalesOrders: 'SalesID',
      Quotes: 'QuoteID',
      SalesReturns: 'ReturnID',
      StockMovements: 'MovementID',
      InventoryChecks: 'CheckID',
      ProductionOrders: 'ProductionID'
    };
    var idColumn = allow[sheetName];
    if (!idColumn) return err_('Bang nay chua ho tro cap nhat ghi chu nhanh.');
    if (!SCHEMA[sheetName] || SCHEMA[sheetName].indexOf('Notes') < 0) return err_('Bang nay khong co cot Notes.');
    var ok = updateRowById(sheetName, idColumn, idValue, { Notes: String(note || '') });
    if (!ok) return err_('Khong tim thay dong can cap nhat ghi chu.');
    return ok_({ sheetName: sheetName, id: idValue, Notes: String(note || '') }, 'Da cap nhat ghi chu.');
  } catch (e) {
    return err_(e.message);
  }
}

function deleteRowById(sheetName, idColumn, idValue) {
  trackMutationSheet_(sheetName);
  var row = sheetToObjects_(sheetName).filter(function (r) { return String(r[idColumn]) === String(idValue); })[0];
  if (!row) return false;
  getSheet_(sheetName).deleteRow(row.__row);
  clearDataCache_(sheetName); invalidateReqCache_(sheetName); return true;
}

/**
 * Đổi các giá trị branding MẶC ĐỊNH của bản NexUp cũ sang AMCVN/AMC đúng một lần.
 * Chỉ thay giá trị nhận diện chính xác là mặc định cũ; tên doanh nghiệp hoặc tên
 * người dùng đã được khách hàng tùy chỉnh sẽ không bị ghi đè.
 * Các khóa kỹ thuật NEXUPONE_* được giữ nguyên để bảo toàn cấu hình/phiên cũ.
 */
function migrateAmcvnBrand_() {
  var props = PropertiesService.getScriptProperties();
  if (props.getProperty('AMCVN_BRAND_MIGRATION') === '1') return;
  var settingUpdates = {}, userUpdates = {};
  var replacements = {
    BusinessName: { 'Công ty TNHH NexUp Việt Nam': 'AMCVN', 'NexUpOne': 'AMCVN' },
    ProfileName: { 'Admin NexUp': 'Admin AMC' },
    InvoiceTemplate: { 'Mẫu hóa đơn chuẩn NexUp': 'Mẫu hóa đơn chuẩn AMC' },
    QuoteTemplate: { 'Mẫu báo giá chuẩn NexUp': 'Mẫu báo giá chuẩn AMC' },
    BankAccountName: { 'CTY NEXUP': 'CTY AMC' },
    BankInfo: { 'VCB - 0123456789 - CTY NEXUP': 'VCB - 0123456789 - CTY AMC' }
  };
  try {
    sheetToObjects_('Settings').forEach(function (s) {
      var map = replacements[s.Key];
      if (map && map[String(s.Value)] !== undefined) settingUpdates[s.Key] = { Value: map[String(s.Value)] };
    });
    if (Object.keys(settingUpdates).length) updateRowsById_('Settings', 'Key', settingUpdates);
  } catch (e) { console.warn('[migrateAmcvnBrand_]', (e && e.message) || String(e)); }
  try {
    sheetToObjects_('Users').forEach(function (u) {
      if (String(u.FullName || '') === 'Admin NexUp') userUpdates[u.UserID] = { FullName: 'Admin AMC' };
    });
    if (Object.keys(userUpdates).length) updateRowsById_('Users', 'UserID', userUpdates);
  } catch (e2) { console.warn('[migrateAmcvnBrand_]', (e2 && e2.message) || String(e2)); }
  props.setProperty('AMCVN_BRAND_MIGRATION', '1');
}

