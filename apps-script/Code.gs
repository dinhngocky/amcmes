      pnl: { revenue: revenue, cogs: cogs, servicePurchaseExpense: servicePurchaseExpense, grossProfit: revenue - cogs, operatingExpense: operating, otherIncome: otherIncome, netProfit: revenue - cogs - operating + otherIncome },
      cashflow: { cashIn: cashIn, cashOut: cashOut, net: cashIn - cashOut, customerPayments: txs.filter(function (t) { return t.TransactionType === 'CustomerPayment'; }).reduce(function (s, t) { return s + toNumber(t.Amount); }, 0), supplierPayments: txs.filter(function (t) { return t.TransactionType === 'SupplierPayment'; }).reduce(function (s, t) { return s + toNumber(t.Amount); }, 0), refunds: txs.filter(function (t) { return t.TransactionType === 'SalesRefund'; }).reduce(function (s, t) { return s + toNumber(t.Amount); }, 0) },
      expensesByCategory: Object.keys(cat).map(function (k) { return { CategoryName: k, Amount: cat[k], Percent: operating ? cat[k] / operating * 100 : 0 }; }),
      budgets: sheetToObjects_('BudgetPlans'), budgetLines: sheetToObjects_('BudgetLines')
    });
  } catch (e) { return err_(e.message); }
}

/* ── Nhận diện hướng tiền & tài khoản của một phiếu thanh toán ──
   CẢNH BÁO: sheet lưu giá trị ĐÃ DỊCH (PaymentDirection In->'Thu', ObjectType Customer->'Khách hàng').
   Đọc lại bằng sheetToObjects_ sẽ KHÔNG dịch ngược, nên phải so cả 2 dạng. */
function financePaymentIsIn_(pay) {
  var d = String(pay.PaymentDirection || '').trim();
  if (d === 'In' || d === 'Thu') return true;
  if (d === 'Out' || d === 'Chi') return false;
  return financePaymentIsCustomer_(pay); // chỉ dùng khi thiếu hướng tiền
}
function financePaymentIsCustomer_(pay) {
  var ot = String(pay.ObjectType || '').trim();
  return ot === 'Customer' || ot === 'Khách hàng';
}
/* Đối trừ công nợ = bút toán bù trừ, KHÔNG có tiền thật ra/vào quỹ. */
function financeIsNonCashMethod_(method) {
  var s = String(method || '').toLowerCase();
  return s.indexOf('đối trừ') >= 0 || s.indexOf('doi tru') >= 0;
}
/* Tài khoản do người dùng chọn; nếu không có thì gợi ý theo phương thức, cuối cùng mới lấy mặc định. */
function financeAccountForPayment_(accountId, method) {
  if (accountId) {
    var picked = financeFindById_('CashAccounts', 'AccountID', accountId);
    if (picked) return picked;
  }
  var rows = sheetToObjects_('CashAccounts').filter(function (a) { return String(a.Status || 'Đang hoạt động') !== 'Ngừng dùng'; });
  if (!rows.length) return null;
  var m = String(method || '').toLowerCase();
  var want = 'Cash';
  if (m.indexOf('chuyển khoản') >= 0 || m.indexOf('chuyen khoan') >= 0 || m.indexOf('thẻ') >= 0 || m.indexOf('the') === 0) want = 'Bank';
  else if (m.indexOf('ví') >= 0 || m.indexOf('vi dien tu') >= 0) want = 'EWallet';
  var byType = rows.filter(function (a) { return a.AccountType === want; });
  return byType.filter(function (a) { return financeBool_(a.IsDefault); })[0]
    || byType[0]
    || rows.filter(function (a) { return financeBool_(a.IsDefault); })[0]
    || rows[0];
}

function syncFinanceFromPayment_(paymentId) {
  seedFinanceDefaults_();
  var pay = financeFindById_('Payments', 'PaymentID', paymentId); if (!pay) return;
  var exists = sheetToObjects_('FinanceTransactions').some(function (t) { return t.SourceType === 'Payment' && String(t.SourceID) === String(paymentId) && t.Status !== 'Cancelled'; });
  if (exists) return;
  // Đối trừ công nợ không làm dịch chuyển tiền -> không ghi sổ quỹ.
  if (financeIsNonCashMethod_(pay.Method)) return;

  var isIn = financePaymentIsIn_(pay);
  var isCustomer = financePaymentIsCustomer_(pay);
  var acc = financeAccountForPayment_(pay.AccountID, pay.Method); if (!acc) return;

  var type, catName;
  if (isCustomer && isIn) { type = 'CustomerPayment'; catName = 'Thu tiền khách hàng'; }
  else if (isCustomer && !isIn) { type = 'SalesRefund'; catName = 'Hoàn tiền khách hàng'; }
  else if (!isCustomer && !isIn) { type = 'SupplierPayment'; catName = 'Thanh toán nhà cung cấp'; }
  else { type = 'SupplierRefund'; catName = 'Thu khác'; }
  var cat = financeCategoryByName_(catName, isIn ? 'Income' : 'Expense') || {};

  appendRow('FinanceTransactions', {
    TransactionID: generateId('FT'), TransactionDate: pay.PaymentDate || new Date(), Direction: isIn ? 'In' : 'Out',
    TransactionType: type, CategoryID: cat.CategoryID || '', CategoryName: cat.CategoryName || catName,
    AccountID: acc.AccountID, AccountName: acc.AccountName, ToAccountID: '', ToAccountName: '',
    ObjectType: pay.ObjectType, ObjectID: pay.ObjectID, ObjectName: pay.ObjectName, SourceType: 'Payment',
    SourceID: paymentId, Amount: toNumber(pay.Amount), Method: pay.Method || 'Tiền mặt', Status: 'Paid',
    BillImageUrl: pay.BillImageUrl || '', Notes: pay.Note || catName, CreatedAt: pay.CreatedAt || new Date(), UpdatedAt: new Date(),
    BillAmount: pay.BillAmount === '' || pay.BillAmount == null ? '' : toNumber(pay.BillAmount), BillOcrText: pay.BillOcrText || ''
  });
  recalculateFinance();
}
function financePaymentsNeedSync_() {
  try {
    var pays = sheetToObjects_('Payments').filter(function (p) {
      return p && p.PaymentID && !financeIsNonCashMethod_(p.Method);
    });

    if (!pays.length) return false;

    var txs = sheetToObjects_('FinanceTransactions').filter(function (t) {
      return t && t.SourceType === 'Payment' && String(t.Status || '') !== 'Cancelled';
    });

    var existing = {};
    txs.forEach(function (t) {
      existing[String(t.SourceID)] = true;
    });

    return pays.some(function (p) {
      return !existing[String(p.PaymentID)];
    });
  } catch (e) { console.warn('[financePaymentsNeedSync_]', (e && e.message) || String(e)); 
    // Nếu kiểm tra lỗi thì sync lại cho chắc, syncFinanceFromPayment_ đã có chống trùng.
    return true;
  }
}

function syncPaymentsToFinance_() {
  var pays = sheetToObjects_('Payments').filter(function (p) {
    return p && p.PaymentID && !financeIsNonCashMethod_(p.Method);
  });

  if (!pays.length) return ok_(0, 'Không có phiếu thanh toán cần đồng bộ');

  var txs = sheetToObjects_('FinanceTransactions').filter(function (t) {
    return t && t.SourceType === 'Payment' && String(t.Status || '') !== 'Cancelled';
  });

  var existing = {};
  txs.forEach(function (t) {
    existing[String(t.SourceID)] = true;
  });

  var synced = 0;

  pays.forEach(function (p) {
    if (!existing[String(p.PaymentID)]) {
      syncFinanceFromPayment_(p.PaymentID);
      existing[String(p.PaymentID)] = true;
      synced++;
    }
  });

  if (synced > 0) {
    clearDataCache_();
  }

  return ok_(synced, synced ? ('Đã đồng bộ ' + synced + ' phiếu thanh toán sang sổ thu chi') : 'Sổ thu chi đã khớp với phiếu thanh toán');
}

/* Mọi phiếu thanh toán đều phải đi qua đây để sổ quỹ không bao giờ lệch với sổ thanh toán.
   Tự điền tài khoản tiền nếu chứng từ gốc chưa chỉ định, rồi sinh bút toán sổ quỹ. */
function appendPaymentRow_(row) {
  if (financeIsNonCashMethod_(row.Method)) {
    row.AccountID = ''; row.AccountName = '';
  } else {
    // Người dùng đã chọn tài khoản -> KHÔNG được âm thầm rơi về tài khoản mặc định.
    if (row.AccountID) {
      var picked = financeFindById_('CashAccounts', 'AccountID', row.AccountID);
      if (!picked) throw new Error('Không tìm thấy tài khoản tiền đã chọn (' + row.AccountID + ').');
      if (String(picked.Status || 'Đang hoạt động') === 'Ngừng dùng') throw new Error('Tài khoản tiền "' + picked.AccountName + '" đã ngừng dùng, hãy chọn tài khoản khác.');
      row.AccountID = picked.AccountID; row.AccountName = picked.AccountName;
    } else {
      try { seedFinanceDefaults_(); } catch (seedErr) { console.warn('[appendPaymentRow_]', (seedErr && seedErr.message) || String(seedErr));  }
      var acc = financeAccountForPayment_('', row.Method);
      if (acc) { row.AccountID = acc.AccountID; row.AccountName = acc.AccountName; }
    }
  }
  appendRow('Payments', row);
  try { syncFinanceFromPayment_(row.PaymentID); } catch (e) { console.warn('[appendPaymentRow_]', (e && e.message) || String(e));  }
  return row.PaymentID;
}

/* ============================================================================
 *  DEV_ · Self-test sổ quỹ. CHỈ chạy thủ công trong Apps Script Editor.
 *  Không xuất hiện trên UI (frontend không gọi gas('DEV_...')).
 *  Dữ liệu test đều mang tiền tố TEST_ và được dọn sạch nếu cleanup=true.
 * ========================================================================== */
function DEV_runFinanceSmokeTest(cleanup) {
  if (cleanup === undefined) cleanup = true;
  installFinanceSchema_();
  seedFinanceDefaults_();

  var pass = 0, fail = 0, log = [];
  function check(label, got, want) {
    var ok = Math.abs(toNumber(got) - toNumber(want)) < 0.001;
    ok ? pass++ : fail++;
    var line = (ok ? 'PASS ' : 'FAIL ') + label + '  got=' + got + ' want=' + want;
    log.push(line); Logger.log(line);
  }

  var createdAccounts = [], createdTx = [];
  try {
    // 1) Hai tài khoản test
    var idCash = generateId('CA'), idBank = generateId('CA'), now = financeNow_();
    appendRow('CashAccounts', { AccountID: idCash, AccountName: 'TEST_Cash', AccountType: 'Cash', OpeningBalance: 5000000, CurrentBalance: 5000000, Currency: 'VND', IsDefault: false, Status: 'Đang hoạt động', Notes: 'TEST_', CreatedAt: now, UpdatedAt: now });
    appendRow('CashAccounts', { AccountID: idBank, AccountName: 'TEST_Bank', AccountType: 'Bank', OpeningBalance: 2000000, CurrentBalance: 2000000, Currency: 'VND', IsDefault: false, Status: 'Đang hoạt động', Notes: 'TEST_', CreatedAt: now, UpdatedAt: now });
    createdAccounts = [idCash, idBank];

    var catIn = financeCategoryByName_('Thu khác', 'Income') || {};
    var catOut = financeCategoryByName_('Chi phí khác', 'Expense') || {};
    if (!catIn.CategoryID || !catOut.CategoryID) throw new Error('Thiếu danh mục thu/chi mặc định.');

    function mk(data) {
      var r = createFinanceTransaction(data);
      if (!r.success) throw new Error(r.message);
      createdTx.push(r.data.TransactionID);
      return r.data;
    }
    // 2) In 1.000.000 -> TEST_Cash
    mk({ Direction: 'In', CategoryID: catIn.CategoryID, AccountID: idCash, Amount: 1000000, TransactionDate: new Date(), Notes: 'TEST_ thu' });
    // 3) Out 200.000 <- TEST_Cash
    mk({ Direction: 'Out', CategoryID: catOut.CategoryID, AccountID: idCash, Amount: 200000, TransactionDate: new Date(), Notes: 'TEST_ chi' });
    // 4) Transfer 300.000 TEST_Cash -> TEST_Bank
    mk({ Direction: 'Transfer', AccountID: idCash, ToAccountID: idBank, Amount: 300000, TransactionDate: new Date(), Notes: 'TEST_ chuyen quy' });

    recalculateCashAccounts();
    var acc = function (id) { return financeFindById_('CashAccounts', 'AccountID', id) || {}; };
    check('TEST_Cash = 5.000.000 +1.000.000 -200.000 -300.000', acc(idCash).CurrentBalance, 5500000);
    check('TEST_Bank = 2.000.000 +300.000', acc(idBank).CurrentBalance, 2300000);

    // 5) Chặn dữ liệu sai
    check('Chan Amount <= 0', createFinanceTransaction({ Direction: 'Out', CategoryID: catOut.CategoryID, AccountID: idCash, Amount: 0 }).success ? 1 : 0, 0);
    check('Chan thieu AccountID', createFinanceTransaction({ Direction: 'Out', CategoryID: catOut.CategoryID, Amount: 1000 }).success ? 1 : 0, 0);
    check('Chan Transfer cung tai khoan', createFinanceTransaction({ Direction: 'Transfer', AccountID: idCash, ToAccountID: idCash, Amount: 1000 }).success ? 1 : 0, 0);
    check('Chan phieu thu dung danh muc chi', createFinanceTransaction({ Direction: 'In', CategoryID: catOut.CategoryID, AccountID: idCash, Amount: 1000 }).success ? 1 : 0, 0);

    // 6) Hủy giao dịch -> số dư hoàn lại
    var cancelId = createdTx[1]; // phiếu chi 200.000
    if (!cancelFinanceTransaction(cancelId).success) throw new Error('Không hủy được giao dịch test');
    check('Sau khi huy phieu chi 200.000, TEST_Cash = 5.700.000', acc(idCash).CurrentBalance, 5700000);

    // 7) Đối soát 2 lần không lệch (idempotent)
    var before = toNumber(acc(idCash).CurrentBalance);
    reconcileFinance(); reconcileFinance();
    check('Doi soat 2 lan khong lam lech so du', acc(idCash).CurrentBalance, before);

  } catch (e) { console.warn('[DEV_runFinanceSmokeTest]', (e && e.message) || String(e)); 
    fail++; log.push('FAIL exception: ' + e.message); Logger.log('FAIL exception: ' + e.message);
  } finally {
    if (cleanup) {
      createdTx.forEach(function (id) { try { deleteRowById('FinanceTransactions', 'TransactionID', id); } catch (e) { console.warn('[DEV_runFinanceSmokeTest]', (e && e.message) || String(e));  } });
      createdAccounts.forEach(function (id) { try { deleteRowById('CashAccounts', 'AccountID', id); } catch (e) { console.warn('[DEV_runFinanceSmokeTest]', (e && e.message) || String(e));  } });
      try { recalculateFinance(); } catch (e) { console.warn('[DEV_runFinanceSmokeTest]', (e && e.message) || String(e));  }
      Logger.log('Da don sach du lieu TEST_');
    }
  }
  var summary = 'DEV_runFinanceSmokeTest: PASS=' + pass + ' FAIL=' + fail;
  Logger.log(summary);
  return { success: fail === 0, message: summary, log: log };
}

function importFinanceTransactions(rows) {
  return withMutationLock_(['FinanceTransactions', 'CashAccounts', 'BudgetPlans', 'BudgetLines'], function () {
    rows = rows || []; var created = 0;
    try {
      rows.forEach(function (r) {
        var acc = sheetToObjects_('CashAccounts').filter(function (a) { return a.AccountName === (r.AccountName || r['Tài khoản']); })[0];
        var cat = sheetToObjects_('FinanceCategories').filter(function (c) { return c.CategoryName === (r.CategoryName || r['Danh mục']); })[0];
        if (!acc || !cat) throw new Error('Không tìm thấy tài khoản hoặc danh mục ở dòng import.');
        createFinanceTransaction({ TransactionDate: r.TransactionDate || r['Ngày'], Direction: cat.CategoryType === 'Income' ? 'In' : 'Out', CategoryID: cat.CategoryID, AccountID: acc.AccountID, Amount: r.Amount || r['Số tiền'], Method: r.Method || r['Phương thức'], Notes: r.Notes || r['Ghi chú'] });
        created++;
      });
    } catch (e) { return err_(e.message); }
    return ok_({ created: created }, 'Đã import ' + created + ' giao dịch');
  });
}

