    var totalPlan = 0, totalActual = 0, worst = 'Đang theo dõi';
    sheetToObjects_('BudgetLines').filter(function (l) { return l.BudgetID === p.BudgetID; }).forEach(function (l) {
      var actual = txs.filter(function (t) { return t.CategoryID === l.CategoryID && financeInRange_(t.TransactionDate, start, end); })
        .reduce(function (s, t) { return s + toNumber(t.Amount); }, 0);
      var planned = toNumber(l.PlannedAmount), pct = planned ? actual / planned * 100 : 0;
      var status = pct >= 100 ? 'Vượt ngân sách' : (pct >= toNumber(l.AlertThreshold || 80) ? 'Sắp vượt' : 'Đang theo dõi');
      if (status === 'Vượt ngân sách') worst = status; else if (status === 'Sắp vượt' && worst !== 'Vượt ngân sách') worst = status;
      totalPlan += planned; totalActual += actual;
      updateRowById('BudgetLines', 'BudgetLineID', l.BudgetLineID, { ActualAmount: actual, RemainingAmount: planned - actual, UsagePercent: pct, Status: status });
    });
    updateRowById('BudgetPlans', 'BudgetID', p.BudgetID, { TotalBudget: totalPlan, ActualSpent: totalActual, RemainingBudget: totalPlan - totalActual, UsagePercent: totalPlan ? totalActual / totalPlan * 100 : 0, Status: worst, UpdatedAt: financeNow_() });
  });
