function v218RelinkRequirement_(fromId,toId,ctx,review){
  if(!fromId||!toId||String(fromId)===String(toId))return 0;
  var specs=[
    ['PurchaseRequisitionItems','RequestItemID'],['PurchaseItems','PurchaseItemID'],
