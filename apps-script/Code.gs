  return withMutationLock_(['ProductionPricingSnapshots'], function () {
    try {
      if (!sheetToObjects_('PriceFormulaTemplates').filter(function (x) { return x.PriceFormulaID === priceFormulaId; })[0]) return err_('Không tìm thấy công thức giá bán.');
      return ok_(writeProductionPricing_(productionId, priceFormulaId, {}), 'Đã áp dụng công thức giá bán cho lệnh ' + productionId);
    } catch (e) { return err_(e.message); }
  });
}
function saveProductionPricing(productionId, data) {
  return withMutationLock_(['ProductionPricingSnapshots'], function () {
    try {
      var old = sheetToObjects_('ProductionPricingSnapshots').filter(function (x) { return x.ProductionID === productionId; })[0];
      var pid = (data && data.PriceFormulaID) || (old && old.PriceFormulaID) || '';
      return ok_(writeProductionPricing_(productionId, pid, data || {}), 'Đã lưu và tính lại giá bán');
    } catch (e) { return err_(e.message); }
  });
}

/* Lợi nhuận = Giá bán − Giá gốc. Tỷ suất = Lợi nhuận / Giá bán. */
function calculateProductionProfit(productionId) {
  try {
    var o = productionOrder_(productionId);
    if (!o) return err_('Không tìm thấy lệnh sản xuất.');
    var snap = sheetToObjects_('ProductionPricingSnapshots').filter(function (x) { return x.ProductionID === productionId; })[0];
    var sellingPrice = snap ? toNumber(snap.SellingPrice) : 0;
    var costTotal = productionCostTotal_(productionId);
    var usesCostFormula = costTotal !== null;
    var qty = toNumber(o.ActualQuantity) || toNumber(o.Quantity);
    // Không có dòng giá gốc -> fallback BOM cũ (UnitCost × SL), KHÔNG cộng trùng.
    if (!usesCostFormula) costTotal = toNumber(o.UnitCost) * qty;
    var grossProfit = sellingPrice - costTotal;
    return ok_({
      ProductionID: productionId, usesCostFormula: usesCostFormula,
      SellingPrice: sellingPrice, TotalCost: costTotal, Quantity: qty,
      UnitCost: qty > 0 ? Math.round(costTotal / qty) : 0,
      GrossProfit: grossProfit, GrossMargin: sellingPrice > 0 ? grossProfit / sellingPrice : 0
    });
  } catch (e) { return err_(e.message); }
}

/* Payload gộp cho popup chi tiết lệnh sản xuất. */
function getProductionPricingBundle(productionId) {
  try {
    var cl = getProductionCostLines(productionId);
    var pr = calculateProductionProfit(productionId);
    if (!pr.success) return pr;
    return ok_({
      pricing: sheetToObjects_('ProductionPricingSnapshots').filter(function (x) { return x.ProductionID === productionId; })[0] || null,
      costLines: (cl.data && cl.data.lines) || [],
      byGroup: (cl.data && cl.data.byGroup) || {},
      profit: pr.data
    });
  } catch (e) { return err_(e.message); }
}

/* Gợi ý công thức cho popup tạo lệnh sản xuất. */
function getProductionFormulaPreview(productId, quantity) {
  try {
    var pf = findPriceFormulaForProduct(productId);
    var cf = findCostFormulaForProduct(productId);
    var out = { price: null, cost: null };
    if (pf) out.price = { formula: pf, SellingPrice: roundMoney_(sellingPriceOf_(pf, { productionQty: toNumber(quantity) })) };
    if (cf) {
      var calc = calculateCostFormulaLines(costFormulaLines_(cf.FormulaID), { productionQty: toNumber(quantity) });
      out.cost = { formula: cf, lines: calc.lines, total: calc.total, byGroup: calc.byGroup };
    }
    return ok_(out);
  } catch (e) { return err_(e.message); }
}

/* Gắn công thức vào lệnh vừa tạo. Không có công thức phù hợp -> KHÔNG làm gì (BOM chạy như cũ). */
function attachFormulasToProduction_(productionId, productId, data) {
  data = data || {};
  var applied = { price: null, cost: null };
  try {
    var pf = data.PriceFormulaID
      ? sheetToObjects_('PriceFormulaTemplates').filter(function (x) { return x.PriceFormulaID === data.PriceFormulaID; })[0]
      : findPriceFormulaForProduct(productId);
    if (pf) applied.price = writeProductionPricing_(productionId, pf.PriceFormulaID, {
      Weight: data.SellWeight, Quantity: data.SellQuantity, UnitPrice: data.SellUnitPrice
    });
  } catch (e) { console.warn('[attachFormulasToProduction_]', (e && e.message) || String(e));  }
  try {
    var cf = data.CostFormulaID
      ? sheetToObjects_('CostFormulaTemplates').filter(function (x) { return x.FormulaID === data.CostFormulaID; })[0]
      : findCostFormulaForProduct(productId);
    if (cf) {
      applied.cost = writeProductionCostLines_(productionId, cf.FormulaID, costFormulaLines_(cf.FormulaID)).total;
      recalculateProductionCost(productionId);
    }
  } catch (e) { console.warn('[attachFormulasToProduction_]', (e && e.message) || String(e));  }
  return applied;
}

