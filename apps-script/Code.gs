/** Ghi đè dữ liệu (giữ header dòng 1) bằng mảng object. */
function bulkWrite_(sheetName, objects) {
  clearDataCache_(sheetName);
  invalidateReqCache_(sheetName);
  var sh = getSheet_(sheetName);
  var headers = SCHEMA[sheetName];
  // clear data cũ (giữ header)
  if (sh.getLastRow() > 1) sh.getRange(2, 1, sh.getLastRow() - 1, headers.length).clearContent();
  if (!objects.length) return;
  var rows = objects.map(function (o0) {
    var o = translateRowForSheet_(o0);
    return headers.map(function (h) { return (o[h] !== undefined && o[h] !== null) ? o[h] : ''; });
  });
  sh.getRange(2, 1, rows.length, headers.length).setValues(rows);
  invalidateReqCache_(sheetName);
}

