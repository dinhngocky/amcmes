  // Dịch vụ không có biến động kho -> KHÔNG dựng lại phiếu xuất khi đối soát.
  var pMapRb = {}; sheetToObjects_('Products').forEach(function (p) { pMapRb[p.ProductID] = p; });
  var items = sheetToObjects_('SalesItems').filter(function (it) { return activeMap[it.SalesID] && itemProductType_(it, pMapRb[it.ProductID] || {}) !== 'Service'; });
  var ids = generateIds('MV', items.length);
