    return ok_({ active: false, hour: hour, ownerEmail: ownerEmail || '', remindCustomers: !!remindCustomers, customerIntervalDays: customerIntervalDays }, 'Đã lưu cấu hình nhắc nợ');
  } catch (e) { return err_(e.message); }
}
