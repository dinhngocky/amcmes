function appendProductionProgressLog_(productionId, stage, percent, note, at) {
  var now = at || new Date();
  appendRow('ProductionProgressLogs', {
    LogID: generateId('PLOG'), ProductionID: productionId, LogDate: now,
    Stage: stage || '', ProgressPercent: Math.max(0, Math.min(100, toNumber(percent))),
    Note: note || '', CreatedAt: now
  });
}

function updateProductionProgress(productionId, data, __locked) {
  data = data || {};
  if (!__locked) return withMutationLock_(['ProductionOrders', 'ProductionProgressLogs'], function () { return updateProductionProgress(productionId, data, true); });
  try {
    ensureProductionWorkflowSchema_();
    var order = sheetToObjects_('ProductionOrders').filter(function (x) { return x.ProductionID === productionId; })[0];
    if (!order) return err_('Không tìm thấy lệnh sản xuất ' + productionId);
    if (order.Status === 'Hoàn thành') return err_('Lệnh đã hoàn thành. Không thể sửa tiến độ trong workflow này.');
    if (isCancelled_(order.Status)) return err_('Lệnh đã hủy. Không thể cập nhật tiến độ.');

    var percent = Number(data.ProgressPercent);
    if (!isFinite(percent) || percent < 0 || percent > 100) return err_('Tiến độ phải nằm trong khoảng 0 đến 100%.');
    var stage = String(data.CurrentStage || data.Stage || '').trim();
    if (!stage) return err_('Nhập công đoạn hiện tại.');
    var now = new Date();
    var updates = { ProgressPercent: percent, CurrentStage: stage };
    if (order.Status === 'Đang sản xuất' && !order.StartedAt) updates.StartedAt = now;
    updateRowById('ProductionOrders', 'ProductionID', productionId, updates);
    appendProductionProgressLog_(productionId, stage, percent, String(data.Note || '').trim(), now);
    writeAudit_('Cập nhật tiến độ ' + percent + '%', 'ProductionOrder', productionId, stage);
    return ok_({ ProgressPercent: percent, CurrentStage: stage, suggestComplete: percent === 100 }, 'Đã cập nhật tiến độ sản xuất');
  } catch (e) { return err_(e.message); }
}

/* Tạo lệnh sản xuất: xuất NVL theo định mức × SL, nhập thành phẩm, tính giá thành */
function createProductionOrder(data) {
  whEnter_(data);   // module nhiều kho: nhớ kho đang thao tác cho các dòng biến động
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked', ['ProductionOrders', 'ProductionMaterials', 'ProductionProgressLogs', 'StockMovements', 'Products', 'BOM'], function () { return createProductionOrder(data); });
  try {
    ensureProductionWorkflowSchema_();
    var prod = sheetToObjects_('Products').filter(function (p) { return p.ProductID === data.ProductID; })[0];
    if (!prod) return err_('Chọn thành phẩm cần sản xuất');
    if (isServiceProduct_(prod)) return err_('"' + prod.ProductName + '" là Dịch vụ (không tồn kho) nên không thể sản xuất.');
    var qty = toNumber(data.Quantity);
    if (qty <= 0) return err_('Số lượng sản xuất phải lớn hơn 0');
    var bom = bomForProduct_(data.ProductID);
    if (!bom.length) return err_('Thành phẩm "' + prod.ProductName + '" chưa có định mức (BOM). Hãy thiết lập định mức trước.');
    
    var status = normalizeStatus_(data.Status, 'Đã lên lệnh');
    validateStatus_(status, PRODUCTION_STATUS_FLOW, 'Trạng thái lệnh sản xuất');
    if (status === 'Hoàn thành') return err_('Không thể tạo lệnh ở trạng thái Hoàn thành. Hãy tạo lệnh, bắt đầu sản xuất rồi chốt số lượng thực tế.');
    
    var machine=data.MachineID?amcvnFind_('Machines','MachineID',data.MachineID):null;
    if(data.MachineID&&!machine)return err_('Máy được chọn không tồn tại.');
    var linkedKit=data.KitID?amcvnFind_('MaterialKits','KitID',data.KitID):null;
    if(data.KitID&&!linkedKit)return err_('Bộ kit được chọn không tồn tại.');
    if(linkedKit&&(!machine||String(linkedKit.MachineID)!==String(machine.MachineID)))return err_('Bộ kit không thuộc máy đã chọn.');
    if(machine)data.ProjectID=machine.ProjectID;
    var now = new Date(); var pdate = docDate_(data.ProductionDate, now);
    var materialCost = 0, bomMoneyCost = 0;
    var needs = bom.map(function (b) {
      if (b.LineType === 'MoneyCost') {
        var baseAmount = bomLineAmount_(b);
        var moneyLine = baseAmount * qty;
        bomMoneyCost += moneyLine;
        return { b: b, need: toNumber(b.Quantity) || 1, lineCost: moneyLine, LineType: 'MoneyCost' };
      }
      var need = b.Quantity * qty;
      materialCost += need * b.unitCost;
      return { b: b, need: need, lineCost: need * b.unitCost, LineType: 'Material' };
    });
    var materialNeeds = needs.filter(function (n) { return n.LineType === 'Material' && n.b.ComponentID; });
    
    var labor = toNumber(data.LaborCost);
    var overhead = toNumber(data.OverheadCost) + bomMoneyCost;
    var unitCost = qty > 0 ? Math.round((materialCost + labor + overhead) / qty) : 0;
    
    // Validate tồn kho nếu tạo lệnh chạy ngay
    if (status === 'Đang sản xuất' || status === 'Hoàn thành') {
      var short = materialNeeds.filter(function (n) { return n.need > n.b.stock + 0.0001; });
      if (short.length) { var s = short[0]; return err_('Không đủ NVL "' + s.b.ComponentName + '" để sản xuất (cần ' + s.need + (s.b.Unit ? ' ' + s.b.Unit : '') + ', tồn ' + s.b.stock + ')'); }
    }
    
    var id = generateId('LSX');
    // Lưu Version BOM tĩnh tại thời điểm tạo
    appendRow('ProductionOrders', { ProductionID: id, ProductionDate: pdate, ProjectID:data.ProjectID||'', MachineID:data.MachineID||'', KitID:data.KitID||'', BOMVersionID:data.BOMVersionID||'', LeaderEmployeeID:data.LeaderEmployeeID||'', LeaderName:data.LeaderName||'', ProductID: prod.ProductID, ProductName: prod.ProductName, Quantity: qty, ActualQuantity: '', MaterialCost: materialCost, ActualMaterialCost: '', LaborCost: labor, OverheadCost: toNumber(data.OverheadCost), MoneyCostTotal: bomMoneyCost, UnitCost: unitCost, Status: status, Notes: data.Notes || '', CreatedBy: getUser_(), CreatedAt: now, ProgressPercent: 0, CurrentStage: status === 'Đang sản xuất' ? 'Bắt đầu sản xuất' : 'Chờ sản xuất', StartedAt: status === 'Đang sản xuất' ? now : '', CompletedAt: '' });
    
    var matIds = generateIds('PMAT', materialNeeds.length);
    appendRows('ProductionMaterials', materialNeeds.map(function (n, i) { return { ProductionMatID: matIds[i], ProductionID: id, ComponentID: n.b.ComponentID, ComponentName: n.b.ComponentName, ComponentSKU: n.b.ComponentSKU, Quantity: n.need, ActualQuantity: n.need, UnitCost: n.b.unitCost, LineCost: n.lineCost, LineType: 'Material', CostGroup: 'NVL', CostName: '', Notes: n.b.Notes || '' }; }));

    if (status === 'Đang sản xuất') {
      syncProductionInventory_(id, status);
      appendProductionProgressLog_(id, 'Bắt đầu sản xuất', 0, 'Khởi động lệnh sản xuất', now);
    }

    return ok_({ ProductionID: id, MaterialCost: materialCost, MoneyCostTotal: bomMoneyCost, UnitCost: unitCost }, 'Đã tạo lệnh sản xuất ' + id);
  } catch (e) { return err_(e.message); }
}

function syncProductionInventory_(id, status) {
  var o = sheetToObjects_('ProductionOrders').filter(function (x) { return x.ProductionID === id; })[0];
  if (!o) throw new Error('Không tìm thấy lệnh sản xuất');

  var existingMoves = sheetToObjects_('StockMovements').filter(function (m) { return m.SourceID === id; });
  var outMoves = existingMoves.filter(function(m) { return m.Type === 'ProductionOut' || m.Type === 'Xuất NVL sản xuất'; });
  var inMoves = existingMoves.filter(function(m) { return m.Type === 'ProductionIn' || m.Type === 'Nhập thành phẩm'; });

  var pMap = {}; sheetToObjects_('Products').forEach(function (p) { pMap[p.ProductID] = p; });
  var mats = sheetToObjects_('ProductionMaterials').filter(function (m) { return m.ProductionID === id && isStockProductionMaterial_(m, pMap); });
  
  var expectedQty = toNumber(o.Quantity);
  var actualQty = status === 'Hoàn thành' ? toNumber(o.ActualQuantity) : expectedQty;
  var now = new Date(); var pdate = o.ProductionDate ? new Date(o.ProductionDate) : now;
  var affected = {};

  if (isCancelled_(status) || status === 'Đã lên lệnh') {
    inMoves.forEach(function (m) {
       var tpProd = pMap[m.ProductID] || {};
       if (toNumber(tpProd.CurrentStock) - toNumber(m.QuantityIn) < 0) throw new Error('Không thể lùi trạng thái vì Thành phẩm đã xuất bán (Tồn sẽ âm).');
       deleteRowById('StockMovements', 'MovementID', m.MovementID); affected[m.ProductID] = true;
    });
    outMoves.forEach(function (m) { deleteRowById('StockMovements', 'MovementID', m.MovementID); affected[m.ProductID] = true; });
  } 
  else if (status === 'Đang sản xuất') {
    inMoves.forEach(function (m) { deleteRowById('StockMovements', 'MovementID', m.MovementID); affected[m.ProductID] = true; });
    if (!outMoves.length) {
      var moves = []; var moveIds = generateIds('MV', mats.length);
      mats.forEach(function (m, idx) {
        var cp = pMap[m.ComponentID] || {};
        if (toNumber(m.Quantity) > toNumber(cp.CurrentStock) + 0.0001) throw new Error('Không đủ NVL "' + m.ComponentName + '"');
        moves.push({ MovementID: moveIds[idx], Date: pdate, Type: 'ProductionOut', SourceType: 'ProductionOrder', SourceID: id, ProductID: m.ComponentID, SKU: m.ComponentSKU || cp.SKU || '', ProductName: m.ComponentName, QuantityIn: 0, QuantityOut: toNumber(m.Quantity), UnitCost: toNumber(m.UnitCost), UnitPrice: '', StockAfter: '', CreatedBy: getUser_(), Notes: 'Xuất NVL (Đang sản xuất)', CreatedAt: now, Status: 'Đã nhận' });
        affected[m.ComponentID] = true;
      });
      if(moves.length) appendRows('StockMovements', moves);
    }
  }
  else if (status === 'Hoàn thành') {
    if (inMoves.length) throw new Error('Lệnh sản xuất đã có phiếu nhập thành phẩm. Không thể hoàn thành lần hai.');

    // Khi lệnh đang chạy, tồn hiện tại đã bị trừ theo định mức. Trước khi chốt thực tế,
    // cộng trả phần đã giữ của chính lệnh này để tính đúng lượng NVL còn có thể sử dụng.
    var releasedByProduct = {}, requiredByProduct = {}, matNameByProduct = {};
    outMoves.forEach(function (m) { releasedByProduct[m.ProductID] = (releasedByProduct[m.ProductID] || 0) + toNumber(m.QuantityOut); });
    mats.forEach(function (m) {
      requiredByProduct[m.ComponentID] = (requiredByProduct[m.ComponentID] || 0) + toNumber(m.ActualQuantity);
      matNameByProduct[m.ComponentID] = m.ComponentName || m.ComponentID;
    });
    var shortages = [];
    Object.keys(requiredByProduct).forEach(function (pid) {
      var available = toNumber((pMap[pid] || {}).CurrentStock) + toNumber(releasedByProduct[pid]);
      var required = toNumber(requiredByProduct[pid]);
      if (required > available + 0.0001) shortages.push({ name: matNameByProduct[pid], required: required, available: available, missing: required - available });
    });
    if (shortages.length) {
      throw new Error('Không đủ NVL để hoàn thành: ' + shortages.map(function (s) {
        return '"' + s.name + '" cần ' + s.required + ', có thể dùng ' + s.available + ', thiếu ' + s.missing;
      }).join('; ') + '. Tồn kho chưa bị thay đổi.');
    }

    outMoves.forEach(function (m) { deleteRowById('StockMovements', 'MovementID', m.MovementID); affected[m.ProductID] = true; });
    inMoves.forEach(function (m) { deleteRowById('StockMovements', 'MovementID', m.MovementID); affected[m.ProductID] = true; });
    
    var moves = []; var moveIds = generateIds('MV', mats.length + 1);
    var actualMatCost = 0;
    mats.forEach(function (m, idx) {
      var outQ = toNumber(m.ActualQuantity);
      actualMatCost += outQ * toNumber(m.UnitCost);
      moves.push({ MovementID: moveIds[idx], Date: pdate, Type: 'ProductionOut', SourceType: 'ProductionOrder', SourceID: id, ProductID: m.ComponentID, SKU: m.ComponentSKU || '', ProductName: m.ComponentName, QuantityIn: 0, QuantityOut: outQ, UnitCost: toNumber(m.UnitCost), UnitPrice: '', StockAfter: '', CreatedBy: getUser_(), Notes: 'Xuất NVL thực tế (Hoàn thành)', CreatedAt: now, Status: 'Đã nhận' });
      affected[m.ComponentID] = true;
    });
    
    var labor = toNumber(o.LaborCost), overhead = toNumber(o.OverheadCost);
    // MoneyCostTotal là snapshot tổng chi phí tiền của BOM theo số lượng kế hoạch.
    // Với lệnh cũ chưa có field này, OverheadCost đã chứa phần MoneyCost nên không cộng lại.
    var moneyCost = o.MoneyCostTotal === '' || o.MoneyCostTotal == null ? 0 : toNumber(o.MoneyCostTotal);
    var finalUnitCost = actualQty > 0 ? Math.round((actualMatCost + labor + overhead + moneyCost) / actualQty) : 0;
    updateRowById('ProductionOrders', 'ProductionID', id, { ActualMaterialCost: actualMatCost, UnitCost: finalUnitCost });

    moves.push({ MovementID: moveIds[mats.length], Date: pdate, Type: 'ProductionIn', SourceType: 'ProductionOrder', SourceID: id, ProductID: o.ProductID, SKU: (pMap[o.ProductID] && pMap[o.ProductID].SKU) || '', ProductName: o.ProductName, QuantityIn: actualQty, QuantityOut: 0, UnitCost: finalUnitCost, UnitPrice: (pMap[o.ProductID] && pMap[o.ProductID].SalePrice) || '', StockAfter: '', CreatedBy: getUser_(), Notes: 'Nhập thành phẩm thực tế', CreatedAt: now, Status: 'Đã nhận' });
    affected[o.ProductID] = true;
    
    appendRows('StockMovements', moves);
  }
  Object.keys(affected).forEach(function (pid) { recalculateProductStock(pid); });
}

/* Thực thi: xuất NVL + nhập thành phẩm (idempotent theo SourceID) */
function executeProduction_(id) {
  var o = sheetToObjects_('ProductionOrders').filter(function (x) { return x.ProductionID === id; })[0];
  if (!o) throw new Error('Không tìm thấy lệnh sản xuất');
  if (sheetToObjects_('StockMovements').filter(function (m) { return m.SourceID === id; }).length) return;
  var pMap = {}; sheetToObjects_('Products').forEach(function (p) { pMap[p.ProductID] = p; });
  var mats = sheetToObjects_('ProductionMaterials').filter(function (m) { return m.ProductionID === id && isStockProductionMaterial_(m, pMap); });
  var qty = toNumber(o.Quantity);
  for (var i = 0; i < mats.length; i++) {
    var cc = pMap[mats[i].ComponentID] || {};
    if (toNumber(mats[i].Quantity) > toNumber(cc.CurrentStock) + 0.0001) throw new Error('Không đủ NVL "' + mats[i].ComponentName + '" (cần ' + toNumber(mats[i].Quantity) + ', tồn ' + toNumber(cc.CurrentStock) + ')');
  }
  var now = new Date(); var pdate = o.ProductionDate ? new Date(o.ProductionDate) : now;
  var moveIds = generateIds('MV', mats.length + 1);
  var moves = [], affected = {};
  mats.forEach(function (m, idx) {
    var cp = pMap[m.ComponentID] || {};
    moves.push({ MovementID: moveIds[idx], Date: pdate, Type: 'ProductionOut', SourceType: 'ProductionOrder', SourceID: id, ProductID: m.ComponentID, SKU: m.ComponentSKU || cp.SKU || '', ProductName: m.ComponentName, QuantityIn: 0, QuantityOut: toNumber(m.Quantity), UnitCost: toNumber(m.UnitCost), UnitPrice: '', StockAfter: '', CreatedBy: getUser_(), Notes: 'Xuất NVL cho lệnh SX ' + id, CreatedAt: now, Status: 'Đã nhận' });
    affected[m.ComponentID] = true;
  });
  moves.push({ MovementID: moveIds[mats.length], Date: pdate, Type: 'ProductionIn', SourceType: 'ProductionOrder', SourceID: id, ProductID: o.ProductID, SKU: (pMap[o.ProductID] && pMap[o.ProductID].SKU) || '', ProductName: o.ProductName, QuantityIn: qty, QuantityOut: 0, UnitCost: toNumber(o.UnitCost), UnitPrice: (pMap[o.ProductID] && pMap[o.ProductID].SalePrice) || '', StockAfter: '', CreatedBy: getUser_(), Notes: 'Nhập thành phẩm từ lệnh SX ' + id, CreatedAt: now, Status: 'Đã nhận' });
  affected[o.ProductID] = true;
  appendRows('StockMovements', moves);
  Object.keys(affected).forEach(function (pid) { recalculateProductStock(pid); });
}

function reverseProduction_(id) {
  var affected = {}, productionTypes = { ProductionOut: true, ProductionIn: true, 'Xuất NVL sản xuất': true, 'Nhập thành phẩm': true };
  sheetToObjects_('StockMovements').filter(function (m) { return m.SourceID === id && productionTypes[m.Type]; }).forEach(function (m) {
    if (m.ProductID) affected[m.ProductID] = true;
    deleteRowById('StockMovements', 'MovementID', m.MovementID);
  });
  Object.keys(affected).forEach(function (pid) { recalculateProductStock(pid); });
}

function updateProductionStatus(id, status, __locked) {
  if (!__locked) return withMutationLock_(['ProductionOrders', 'ProductionMaterials', 'ProductionProgressLogs', 'StockMovements', 'Products'], function () { return updateProductionStatus(id, status, true); });
  try {
    ensureProductionWorkflowSchema_();
    var o = sheetToObjects_('ProductionOrders').filter(function (x) { return x.ProductionID === id; })[0];
    if (!o) return err_('Không tìm thấy lệnh sản xuất');
    status = normalizeStatus_(status, o.Status);
    validateStatus_(status, PRODUCTION_STATUS_FLOW, 'Trạng thái lệnh sản xuất');
    var current = normalizeStatus_(o.Status, 'Đã lên lệnh');
    if (current === 'Hoàn thành') return err_('Lệnh đã hoàn thành. Không thể đổi trạng thái hoặc hoàn thành lại.');
    if (isCancelled_(current)) return err_('Lệnh đã hủy. Không thể tiếp tục sản xuất.');
    if (current === status) return ok_({ Status: current }, 'Lệnh đã ở trạng thái ' + current);
    if ((PRODUCTION_STATUS_NEXT[current] || []).indexOf(status) < 0) return err_('Không thể chuyển lệnh từ "' + current + '" sang "' + status + '".');
    if (status === 'Hoàn thành') return err_('Hãy mở popup hoàn tất, nhập số lượng thực tế và xác nhận chốt lệnh.');

    var now = new Date();
    var updates = { Status: status };
    if (status === 'Đang sản xuất') {
      syncProductionInventory_(id, 'Đang sản xuất');
      updates.StartedAt = o.StartedAt || now;
      updates.CurrentStage = o.CurrentStage && o.CurrentStage !== 'Chờ sản xuất' ? o.CurrentStage : 'Bắt đầu sản xuất';
      updates.ProgressPercent = Math.max(0, Math.min(99, toNumber(o.ProgressPercent)));
      appendProductionProgressLog_(id, updates.CurrentStage, updates.ProgressPercent, 'Chuyển trạng thái sang Đang sản xuất', now);
    } else if (isCancelled_(status)) {
      reverseProduction_(id);
      updates.CurrentStage = 'Đã hủy';
      appendProductionProgressLog_(id, 'Đã hủy', toNumber(o.ProgressPercent), 'Hủy lệnh sản xuất', now);
    }

    updateRowById('ProductionOrders', 'ProductionID', id, updates);
    writeAudit_('Đổi trạng thái lệnh SX → ' + status, 'ProductionOrder', id, o.ProductName || '');
    return ok_(updates, 'Đã cập nhật trạng thái lệnh sản xuất');
  } catch (e) { return err_(e.message); }
}

function deleteProductionOrder(id, __locked) {
  if (!__locked) return withMutationLock_(['ProductionOrders', 'ProductionMaterials', 'StockMovements', 'Products'], function () { return deleteProductionOrder(id, true); });
  try {
    var o = sheetToObjects_('ProductionOrders').filter(function (x) { return x.ProductionID === id; })[0];
    if (!o) return err_('Không tìm thấy lệnh sản xuất');
    reverseProduction_(id);
    sheetToObjects_('ProductionMaterials').filter(function (m) { return m.ProductionID === id; }).forEach(function (m) { deleteRowById('ProductionMaterials', 'ProductionMatID', m.ProductionMatID); });
    deleteRowById('ProductionOrders', 'ProductionID', id);
    writeAudit_('Xóa lệnh sản xuất', 'ProductionOrder', id, o.ProductName || '');
    return ok_(null, 'Đã xóa lệnh sản xuất ' + id);
  } catch (e) { return err_(e.message); }
}

/* ----- Sao lưu Spreadsheet (thủ công + tự động hằng tuần) ----- */
function backupSpreadsheet() {
  try {
    var ss = getSpreadsheet_();
    var name = (CONFIG.APP_NAME || 'AMCVN') + ' - Backup ' + getTodayString();
    var file = DriveApp.getFileById(ss.getId()).makeCopy(name);
    writeAudit_('Sao lưu dữ liệu', 'System', '', 'Tạo bản sao: ' + name);
    return ok_({ id: file.getId(), name: name }, 'Đã sao lưu: ' + name);
  } catch (e) { return err_(e.message); }
}
function setupBackupSchedule() {
  try {
    ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'backupSpreadsheet') ScriptApp.deleteTrigger(t); });
    ScriptApp.newTrigger('backupSpreadsheet').timeBased().everyWeeks(1).onWeekDay(ScriptApp.WeekDay.MONDAY).atHour(1).create();
    return ok_(null, 'Đã bật sao lưu tự động hằng tuần (khoảng 1h sáng thứ Hai).');
  } catch (e) { return err_(e.message); }
}
function disableBackupSchedule() {
  try { ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'backupSpreadsheet') ScriptApp.deleteTrigger(t); }); return ok_(null, 'Đã tắt sao lưu tự động.'); } catch (e) { return err_(e.message); }
}

/* ============================================================================
 *  SALES RETURNS (Trả hàng) + PAYMENT ALLOCATION HELPERS
 * ========================================================================== */

function getSalesReturns() {
  try { return ok_(sheetToObjects_('SalesReturns')); } catch (e) { return err_(e.message); }
}

function getSalesReturnDetail(returnId) {
  return cachedPayload_('srdetail:' + returnId, function () { return build_getSalesReturnDetail(returnId); });
}
function build_getSalesReturnDetail(returnId) {
  try {
    var r = sheetToObjects_('SalesReturns').filter(function (x) { return x.ReturnID === returnId; })[0];
    var items = sheetToObjects_('SalesReturnItems').filter(function (i) { return i.ReturnID === returnId; });
    var payments = sheetToObjects_('Payments').filter(function (p) { return p.SourceID === returnId || (String(p.Note || '').indexOf(returnId) >= 0); });
    return ok_({ ret: r, items: items, payments: payments });
  } catch (e) { return err_(e.message); }
}

/**
 * data: { SalesID?, CustomerID, CustomerName?, ReturnDate?, ReturnType:'Hoàn tiền'|'Trừ công nợ',
 *         RefundMethod?, Notes?, items:[{ProductID, Quantity, SalePrice?}] }
 */
function createSalesReturn(data) {
  whEnter_(data);   // module nhiều kho: nhớ kho đang thao tác cho các dòng biến động
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked',
    ['SalesReturns', 'SalesReturnItems', 'StockMovements', 'SalesOrders', 'Payments', 'Customers', 'Products'].concat(FINANCE_LOCK_SHEETS_),
    function () { return createSalesReturn(data); });
  try {
    var dupChk = dupByClientRef_('SalesReturns', 'ReturnID', data.ClientRef, 'Phiếu trả hàng');
    if (dupChk) return dupChk;
    if (data.SalesID) {
      var srcSO = sheetToObjects_('SalesOrders').filter(function (s) { return s.SalesID === data.SalesID; })[0];
      if (!srcSO) return err_('Không tìm thấy hóa đơn ' + data.SalesID, 'ERR_SR_ORDER_NOT_FOUND');
      if (isCancelled_(normalizeStatus_(srcSO.Status, ''))) return err_('Hóa đơn ' + data.SalesID + ' đã hủy nên không thể tạo phiếu trả hàng.', 'ERR_SR_ORDER_CANCELLED');
    }
    var id = generateId('TR');
    var now = new Date();
    var rdate = docDate_(data.ReturnDate, now);
    var pMap = {}; sheetToObjects_('Products').forEach(function (p) { pMap[p.ProductID] = p; });
    var loSP_ = assertKnownProducts_(data.items, pMap);
    if (loSP_) return err_(loSP_, 'ERR_PRODUCT_NOT_FOUND');
    var linkedSalesItems = data.SalesID ? sheetToObjects_('SalesItems').filter(function (i) { return i.SalesID === data.SalesID; }) : [];
    var linkedQty = {}, linkedPrice = {}, linkedCost = {};
    linkedSalesItems.forEach(function (i) {
      linkedQty[i.ProductID] = (linkedQty[i.ProductID] || 0) + toNumber(i.Quantity);
      linkedPrice[i.ProductID] = toNumber(i.SalePrice);
      linkedCost[i.ProductID] = toNumber(i.CostPrice);
    });
    var returnedQty = {};
    if (data.SalesID) {
      var returnIds = {};
      sheetToObjects_('SalesReturns').filter(function (r) {
        return r.SalesID === data.SalesID && !isCancelled_(normalizeStatus_(r.Status, ''));
      }).forEach(function (r) { returnIds[r.ReturnID] = true; });
      sheetToObjects_('SalesReturnItems').forEach(function (i) {
        if (returnIds[i.ReturnID]) returnedQty[i.ProductID] = (returnedQty[i.ProductID] || 0) + toNumber(i.Quantity);
      });
    }

    var customerId = data.CustomerID, customerName = data.CustomerName;
    if (data.SalesID && (!customerId || !customerName)) {
      var so0 = sheetToObjects_('SalesOrders').filter(function (s) { return s.SalesID === data.SalesID; })[0];
      if (so0) { customerId = customerId || so0.CustomerID; customerName = customerName || so0.CustomerName; }
    }

    var subtotal = 0, costAmount = 0;
    var rows = (data.items || []).map(function (it) {
      var prod = pMap[it.ProductID] || {};
      var qty = toNumber(it.Quantity);
      var price = toNumber(it.SalePrice || linkedPrice[it.ProductID] || prod.SalePrice);
      var cost = data.SalesID && linkedCost[it.ProductID] !== undefined ? toNumber(linkedCost[it.ProductID]) : toNumber(prod.CostPrice);
      subtotal += qty * price; costAmount += qty * cost;
      return { prod: prod, qty: qty, price: price, cost: cost, rev: qty * price, lcost: qty * cost };
    }).filter(function (x) { return x.qty > 0 && x.prod.ProductID; });
    if (!rows.length) return err_('Chưa chọn sản phẩm trả');
    if (data.SalesID) {
      var requestQty = {};
      rows.forEach(function (x) { requestQty[x.prod.ProductID] = (requestQty[x.prod.ProductID] || 0) + x.qty; });
      for (var pid in requestQty) {
        var remainQty = Math.max(0, toNumber(linkedQty[pid]) - toNumber(returnedQty[pid]));
        if (requestQty[pid] > remainQty) {
          var pName = (pMap[pid] && pMap[pid].ProductName) || pid;
          return err_('Số lượng trả "' + pName + '" vượt số lượng còn được trả của hóa đơn gốc. Đã bán: ' + toNumber(linkedQty[pid]) + ', đã trả: ' + toNumber(returnedQty[pid]) + ', còn được trả: ' + remainQty + '.');
        }
      }
    }

    var total = subtotal;
    var returnType = data.ReturnType || 'Hoàn tiền';

    var debtAvailable = 0;
    if (returnType === 'Trừ công nợ') {
      if (data.SalesID) {
        var debtOrder = sheetToObjects_('SalesOrders').filter(function (s) { return s.SalesID === data.SalesID; })[0];
        debtAvailable = debtOrder ? toNumber(debtOrder.ReceivableAmount) : 0;
      } else if (customerId) {
        debtAvailable = sheetToObjects_('SalesOrders')
          .filter(function (s) { return s.CustomerID === customerId && toNumber(s.ReceivableAmount) > 0; })
          .reduce(function (sum, s) { return sum + toNumber(s.ReceivableAmount); }, 0);
      }
    }
    var debtAppliedPlan = returnType === 'Trừ công nợ' ? Math.min(total, Math.max(0, debtAvailable)) : 0;
    var refundPlan = returnType === 'Trừ công nợ' ? Math.max(0, total - debtAppliedPlan) : 0;
    var returnStatus = returnType === 'Trừ công nợ'
      ? (refundPlan > 0 ? 'Chờ hoàn tiền' : 'Hoàn tất')
      : 'Đã hoàn tiền';

    appendRow('SalesReturns', {
      ClientRef: data.ClientRef || '',
      ReturnID: id, ReturnDate: rdate, SalesID: data.SalesID || '', CustomerID: customerId || '', CustomerName: customerName || '',
      Subtotal: subtotal, TotalAmount: total, CostAmount: costAmount, RefundAmount: refundPlan,
      RefundMethod: data.RefundMethod || (returnType === 'Hoàn tiền' ? 'Tiền mặt' : 'Đối trừ công nợ'),
      ReturnType: returnType, Status: returnStatus, CreatedBy: getUser_(), Notes: data.Notes || '', CreatedAt: now
    });

    var returnItemIds = generateIds('TRI', rows.length);
    var movementIds = generateIds('MV', rows.length);
    var returnItemRows = [], movementRows = [], affectedProducts = {};
    rows.forEach(function (x, idx) {
      returnItemRows.push({
        ReturnItemID: returnItemIds[idx], ReturnID: id, ProductID: x.prod.ProductID, SKU: x.prod.SKU,
        ProductName: x.prod.ProductName, Quantity: x.qty, CostPrice: x.cost, SalePrice: x.price, LineRevenue: x.rev, LineCost: x.lcost
      });
      // Dịch vụ: vẫn xử lý tiền/công nợ nhưng KHÔNG nhập lại kho.
      if (!isServiceProduct_(x.prod)) {
        movementRows.push({
          MovementID: movementIds[idx], Date: rdate, Type: 'SaleReturn', SourceType: 'SalesReturn', SourceID: id,
          ProductID: x.prod.ProductID, SKU: x.prod.SKU, ProductName: x.prod.ProductName, QuantityIn: x.qty, QuantityOut: 0,
          UnitCost: x.cost, UnitPrice: x.price, StockAfter: '', CreatedBy: getUser_(), Notes: 'Nhập lại từ trả hàng ' + id, CreatedAt: now, Status: 'Trả lại vào kho'
        });
        affectedProducts[x.prod.ProductID] = true;
      }
    });
    appendRows('SalesReturnItems', returnItemRows);
    appendRows('StockMovements', movementRows);
    Object.keys(affectedProducts).forEach(function (pid) { recalculateProductStock(pid); });

    if (returnType === 'Hoàn tiền') {
      appendPaymentRow_({
        PaymentID: generateId('TT'), PaymentDate: rdate, ObjectType: 'Customer', ObjectID: customerId || '', ObjectName: customerName || '',
        SourceType: 'SalesReturn', SourceID: id, PaymentDirection: 'Out', Amount: total, Method: data.RefundMethod || 'Tiền mặt',
        Note: 'Hoàn tiền trả hàng ' + id, CreatedBy: getUser_(), CreatedAt: now
      });
    } else { // Trừ công nợ
      var applied = 0;
      if (data.SalesID) {
        var so = sheetToObjects_('SalesOrders').filter(function (s) { return s.SalesID === data.SalesID; })[0];
        if (so) {
          var tot = toNumber(so.TotalAmount);
          applied = Math.min(total, toNumber(so.ReceivableAmount));
          var paid = Math.min(tot, toNumber(so.PaidAmount) + applied);
          updateRowById('SalesOrders', 'SalesID', data.SalesID, {
            PaidAmount: paid, ReceivableAmount: Math.max(0, tot - paid), PaymentStatus: calculatePaymentStatus(tot, paid)
          });
        }
      } else if (customerId) {
        var remain = total;
        var openOrders = sheetToObjects_('SalesOrders').filter(function (s) {
          return s.CustomerID === customerId && toNumber(s.ReceivableAmount) > 0;
        }).sort(function (a, b) { return new Date(a.SalesDate) - new Date(b.SalesDate); });
        openOrders.forEach(function (so2) {
          if (remain <= 0) return;
          var use = Math.min(remain, toNumber(so2.ReceivableAmount));
          var tot2 = toNumber(so2.TotalAmount);
          var paid2 = Math.min(tot2, toNumber(so2.PaidAmount) + use);
          updateRowById('SalesOrders', 'SalesID', so2.SalesID, {
            PaidAmount: paid2, ReceivableAmount: Math.max(0, tot2 - paid2), PaymentStatus: calculatePaymentStatus(tot2, paid2)
          });
           remain -= use;
         });
        applied = total - remain;
      }
      if (applied > 0) {
        appendPaymentRow_({
          PaymentID: generateId('TT'), PaymentDate: rdate, ObjectType: 'Customer', ObjectID: customerId || '', ObjectName: customerName || '',
          SourceType: (data.SalesID ? 'SalesOrder' : 'SalesReturn'), SourceID: (data.SalesID || id), PaymentDirection: 'In',
          Amount: applied, Method: 'Đối trừ công nợ', Note: 'Trừ công nợ từ trả hàng ' + id, CreatedBy: getUser_(), CreatedAt: now
        });
      }
      var refundRemain = Math.max(0, total - applied);
      updateRowById('SalesReturns', 'ReturnID', id, {
        RefundAmount: refundRemain,
        Status: refundRemain > 0 ? 'Chờ hoàn tiền' : 'Hoàn tất',
        Notes: (data.Notes || '') + (data.Notes ? ' | ' : '') + 'Đã trừ công nợ ' + formatMoney_(applied) + (refundRemain > 0 ? ', còn phải hoàn ' + formatMoney_(refundRemain) : '')
      });
    }
    if (customerId) refreshCustomerBalance_(customerId);
    return ok_({ ReturnID: id }, 'Đã tạo phiếu trả hàng ' + id);
  } catch (e) { return err_(e.message); }
}

function completeSalesReturnRefund(returnId, method, note) {
  if (!returnId) return err_('Thiếu mã phiếu trả');
  return runLocked_({ ReturnID: returnId }, '__locked',
    ['SalesReturns', 'Payments', 'Customers'].concat(FINANCE_LOCK_SHEETS_),
    function () {
      try {
        var ret = sheetToObjects_('SalesReturns').filter(function (r) { return r.ReturnID === returnId; })[0];
        if (!ret) return err_('Không tìm thấy phiếu trả');
        var amount = toNumber(ret.RefundAmount);
        if (amount <= 0) return err_('Phiếu trả không còn số tiền phải hoàn');
        var now = new Date();
        appendPaymentRow_({
          PaymentID: generateId('TT'), PaymentDate: now, ObjectType: 'Customer', ObjectID: ret.CustomerID || '', ObjectName: ret.CustomerName || '',
