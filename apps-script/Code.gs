/* ===== AMC MODULE: BÁO CÁO NHẬP - XUẤT - TỒN =====
 * Báo cáo kho quan trọng nhất của doanh nghiệp sản xuất:
 *      Tồn cuối kỳ = Tồn đầu kỳ + Nhập trong kỳ − Xuất trong kỳ
 * Số liệu cộng thẳng từ SỔ BIẾN ĐỘNG KHO nên luôn khớp với tồn hiện tại,
 * xem theo TỪNG KHO hoặc gộp tất cả kho đều được.
 * ========================================================================== */

/** Dòng biến động này là NHẬP hay XUẤT (đã tính cả trạng thái chứng từ). */
function nxtDirection_(m) {
  var eff = movementEffective_(m);
  if (eff > 0) return { inQty: eff, outQty: 0 };
  if (eff < 0) return { inQty: 0, outQty: -eff };
  return { inQty: 0, outQty: 0 };
}

/**
 * Nhập - Xuất - Tồn theo kỳ.
 * filters: { from, to, warehouseId, category, onlyMoved }
 *   - Không truyền from/to  -> lấy từ đầu đến nay (tồn đầu kỳ = 0).
 *   - warehouseId trống     -> gộp tất cả kho (gồm cả hàng đang chuyển).
 *   - onlyMoved = true      -> chỉ hiện mặt hàng có phát sinh trong kỳ.
 */
function getStockLedgerReport(filters) {
  try {
    filters = filters || {};
    var from = filters.from ? new Date(String(filters.from) + 'T00:00:00') : null;
    var to = filters.to ? new Date(String(filters.to) + 'T23:59:59') : null;
    var whId = filters.warehouseId ? String(filters.warehouseId) : '';

    var def = null;
    try { def = whDefault_(); } catch (e) { console.warn('[getStockLedgerReport]', (e && e.message) || String(e));  def = null; }
    var whMap = {};
    try { whAll_().forEach(function (w) { whMap[String(w.WarehouseID)] = w; }); } catch (e) { console.warn('[getStockLedgerReport]', (e && e.message) || String(e));  }

    var products = {};
    sheetToObjects_('Products').forEach(function (p) {
      if (isServiceProduct_(p)) return;              // dịch vụ không có tồn kho
      if (filters.category && String(p.Category || '') !== String(filters.category)) return;
      products[String(p.ProductID)] = p;
    });

    var acc = {};
    function nxtBucket(pid) {
      return acc[pid] || (acc[pid] = { open: 0, inQty: 0, outQty: 0, inValue: 0, outValue: 0, lastCost: 0 });
    }

    sheetToObjects_('StockMovements').forEach(function (m) {
      var pid = String(m.ProductID || '');
      if (!pid || !products[pid]) return;
      // Lọc theo kho: dòng cũ chưa có kho thì coi như thuộc kho mặc định.
      var mw = String(m.WarehouseID || (def ? def.WarehouseID : ''));
      if (whId && mw !== whId) return;

      var d = parseDate_(m.Date);
      if (!d || isNaN(d.getTime())) return;
      var dir = nxtDirection_(m);
      if (!dir.inQty && !dir.outQty) return;
      var b = nxtBucket(pid);
      var cost = toNumber(m.UnitCost);
      if (cost > 0) b.lastCost = cost;

      if (from && d < from) {                        // trước kỳ -> dồn vào tồn đầu kỳ
        b.open += dir.inQty - dir.outQty;
        return;
      }
      if (to && d > to) return;                      // sau kỳ -> bỏ qua
      b.inQty += dir.inQty; b.outQty += dir.outQty;
      b.inValue += dir.inQty * cost;
      b.outValue += dir.outQty * cost;
    });

    var rows = [];
    Object.keys(products).forEach(function (pid) {
      var p = products[pid];
      var b = acc[pid];
      if (!b) {
        if (filters.onlyMoved) return;
        b = { open: 0, inQty: 0, outQty: 0, inValue: 0, outValue: 0, lastCost: toNumber(p.CostPrice) };
      }
      if (filters.onlyMoved && !b.inQty && !b.outQty) return;
      var close = b.open + b.inQty - b.outQty;
      var cost = b.lastCost || toNumber(p.CostPrice);
      rows.push({
        ProductID: p.ProductID, SKU: p.SKU, ProductName: p.ProductName,
        Unit: p.Unit, Category: p.Category, CostPrice: cost,
        OpenQty: roundMoney_(b.open), OpenValue: Math.round(b.open * cost),
        InQty: roundMoney_(b.inQty), InValue: Math.round(b.inValue),
        OutQty: roundMoney_(b.outQty), OutValue: Math.round(b.outValue),
        CloseQty: roundMoney_(close), CloseValue: Math.round(close * cost)
      });
    });
    rows.sort(function (a, b2) { return String(a.ProductName).localeCompare(String(b2.ProductName), 'vi'); });

    var sum = rows.reduce(function (s, r) {
      s.openValue += r.OpenValue; s.inQty += r.InQty; s.inValue += r.InValue;
      s.outQty += r.OutQty; s.outValue += r.OutValue; s.closeValue += r.CloseValue;
      return s;
    }, { openValue: 0, inQty: 0, inValue: 0, outQty: 0, outValue: 0, closeValue: 0 });

    var whList = [];
    try {
      whList = whVisible_().map(function (w) {
        return { WarehouseID: w.WarehouseID, WarehouseName: w.WarehouseName, IsDefault: whTruthy_(w.IsDefault) };
      });
    } catch (e) { console.warn('[getStockLedgerReport]', (e && e.message) || String(e));  whList = []; }

    return ok_({
      from: filters.from || '', to: filters.to || '',
      warehouseId: whId, warehouseName: whId && whMap[whId] ? whMap[whId].WarehouseName : 'Tất cả kho',
      warehouses: whList, rows: rows, summary: sum, productCount: rows.length
    });
  } catch (e) { return err_(e.message); }
}

/**
 * THẺ KHO của một mặt hàng: liệt kê từng lần nhập/xuất kèm tồn sau mỗi lần,
 * để đối chiếu khi số liệu có nghi vấn.
 */
function getStockCardReport(productId, filters) {
  try {
    filters = filters || {};
    var p = sheetToObjects_('Products').filter(function (x) { return String(x.ProductID) === String(productId); })[0];
    if (!p) return err_('Không tìm thấy sản phẩm.');
    var from = filters.from ? new Date(String(filters.from) + 'T00:00:00') : null;
    var to = filters.to ? new Date(String(filters.to) + 'T23:59:59') : null;
    var whId = filters.warehouseId ? String(filters.warehouseId) : '';
    var def = null;
    try { def = whDefault_(); } catch (e) { console.warn('[getStockCardReport]', (e && e.message) || String(e));  def = null; }

    var all = sheetToObjects_('StockMovements').filter(function (m) {
      if (String(m.ProductID) !== String(productId)) return false;
      var mw = String(m.WarehouseID || (def ? def.WarehouseID : ''));
      return !whId || mw === whId;
    }).map(function (m) {
      var d = parseDate_(m.Date);
      return { m: m, d: (d && !isNaN(d.getTime())) ? d : new Date(0) };
    }).sort(function (a, b) { return a.d - b.d; });

    var open = 0, lines = [], running = 0;
    all.forEach(function (x) {
      var dir = nxtDirection_(x.m);
      if (!dir.inQty && !dir.outQty) return;
      if (from && x.d < from) { open += dir.inQty - dir.outQty; return; }
      if (to && x.d > to) return;
      running = (lines.length ? running : open) + dir.inQty - dir.outQty;
      lines.push({
        Date: x.m.Date, Type: x.m.Type, SourceType: x.m.SourceType, SourceID: x.m.SourceID,
        WarehouseName: x.m.WarehouseName || (def ? def.WarehouseName : ''),
        InQty: dir.inQty, OutQty: dir.outQty, UnitCost: toNumber(x.m.UnitCost),
        Balance: roundMoney_(running), Notes: x.m.Notes, CreatedBy: x.m.CreatedBy
      });
    });
    return ok_({
      product: { ProductID: p.ProductID, SKU: p.SKU, ProductName: p.ProductName, Unit: p.Unit },
      warehouseId: whId, openQty: roundMoney_(open),
      closeQty: roundMoney_(lines.length ? running : open),
      lines: lines, count: lines.length
    });
  } catch (e) { return err_(e.message); }
}

