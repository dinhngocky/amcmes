/** Tên tab thực tế (tiếng Việt) từ tên nội bộ. */
function resolveSheetName_(name) { return SHEET_LABELS[name] || name; }

/** Header tiếng Việt theo thứ tự cột của SCHEMA. */
function viHeaders_(name) {
  var keys = SCHEMA[name] || [];
  var map = LABELS[name] || {};
  return keys.map(function (k) { return map[k] || k; });
}

/** Dịch các cột enum sang tiếng Việt trước khi ghi xuống sheet. */
function translateRowForSheet_(object) {
  var clone = {};
  for (var k in object) {
    var v = object[k];
    if (VLABELS[k] && VLABELS[k][v] !== undefined) v = VLABELS[k][v];
    clone[k] = v;
  }
  return clone;
}

