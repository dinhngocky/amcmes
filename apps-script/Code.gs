/* ============================================================================
 *  AMC MODULE: BOM NHIỀU LEVEL (VIEW ONLY - DATA VẪN PHẲNG)
 *  Cấu trúc dữ liệu KHÔNG ĐỔI. Chỉ thêm lớp build cây để hiển thị.
 * ==========================================================================*/

/**
 * Build cây BOM từ mảng phẳng MachineBOMLines.
 *
 * Cấu trúc cây:
 *   Level 0: Máy (1 node duy nhất)
 *   Level 1: Cụm (Module) — nhóm theo ModuleID hoặc ModuleCode
 *   Level 2: Vật tư trong cụm — mỗi dòng BOM
 *
 * Quy tắc nhóm:
 *   - Nếu có ModuleID → nhóm theo ModuleID (chính xác nhất)
 *   - Nếu không có ModuleID nhưng có ModuleCode → nhóm theo ModuleCode
 *   - Nếu không có cả 2 → nhóm vào "Chưa gán cụm" (nhóm mặc định)
 *
 * Các trường được tính lại ở mỗi cấp:
 *   - LineCount: số dòng con
 *   - TotalQty: tổng RequiredQty
 *   - CriticalA/B/C: số dòng theo mức độ
 *   - MissingDRI: số dòng chưa có người phụ trách
 */
function buildBOMTree_(lines, machine, project, modules) {
  lines = lines || [];

  // Bản đồ Module để bổ sung tên nếu dòng BOM không ghi
  var moduleMap = {}, moduleCodeMap = {};
  (modules || []).forEach(function (m) {
    if (m.ModuleID) moduleMap[String(m.ModuleID)] = m;
    if (m.ModuleCode) moduleCodeMap[String(m.ModuleCode).trim().toLowerCase()] = m;
  });

  // Nhóm theo cụm. Khởi tạo cả cụm chưa có dòng BOM để màn hình phân cụm luôn
  // thấy đúng danh sách đã khai báo trong Dự án & Máy.
  var byModule = {};
  var unassigned = [];
  var moduleOrder = []; // giữ thứ tự xuất hiện lần đầu
  (modules || []).forEach(function (m) {
    var key = String(m.ModuleID || m.ModuleCode || '').trim();
    if (key && !byModule[key]) { byModule[key] = []; moduleOrder.push(key); }
  });

  lines.forEach(function (line) {
    var moduleId = String(line.ModuleID || '').trim();
    var moduleCode = String(line.ModuleCode || '').trim();
    var matched = !moduleId && moduleCode ? moduleCodeMap[moduleCode.toLowerCase()] : null;
    var key = moduleId || (matched && matched.ModuleID) || moduleCode || '__UNASSIGNED__';
    if (!byModule[key]) {
      byModule[key] = [];
      moduleOrder.push(key);
    }
    byModule[key].push(line);
  });

  // Build từng node cụm
  var children = moduleOrder.map(function (key) {
    var moduleLines = byModule[key];
    var firstLine = moduleLines[0] || {};
    var moduleMeta = moduleMap[key] || {};
    var moduleId = String(firstLine.ModuleID || moduleMeta.ModuleID || '').trim();
    var moduleCode = String(firstLine.ModuleCode || moduleMeta.ModuleCode || '').trim();
    var moduleName = String(firstLine.ModuleName || moduleMeta.ModuleName || '').trim();
    if (!moduleMeta.ModuleID && moduleId) moduleMeta = moduleMap[moduleId] || moduleMeta;

    // Nếu line không ghi tên cụm nhưng có trong metadata → lấy từ metadata
    if (!moduleName && moduleMeta.ModuleName) moduleName = moduleMeta.ModuleName;
    if (!moduleCode && moduleMeta.ModuleCode) moduleCode = moduleMeta.ModuleCode;

    var isUnassigned = key === '__UNASSIGNED__';

    // Thống kê cụm
    var totalQty = 0, criticalA = 0, criticalB = 0, criticalC = 0, missingDRI = 0;
    moduleLines.forEach(function (l) {
      totalQty += toNumber(l.RequiredQty);
      var c = String(l.CriticalLevel || 'C').toUpperCase();
      if (c === 'A') criticalA++;
      else if (c === 'B') criticalB++;
      else criticalC++;
      if (!String(l.DRI || '').trim()) missingDRI++;
    });

    return {
      type: 'module',
      id: moduleId || moduleCode || '__UNASSIGNED__',
      moduleId: moduleId,
      moduleCode: isUnassigned ? 'TOÀN MÁY' : moduleCode,
      moduleName: isUnassigned ? 'Vật tư ở cấp máy' : moduleName,
      moduleDrawingNo: firstLine.ModuleDrawingNo || moduleMeta.ModuleDrawingNo || '',
      owner: moduleMeta.Owner || '',
      bomGroup: moduleMeta.BOMGroup || firstLine.BOMGroup || '',
      isUnassigned: isUnassigned,

      // Con của cụm: các dòng vật tư
      children: moduleLines.map(function (l) {
        return {
          type: 'line',
          line: l,
          productId: l.ProductID || '',
          partNumber: l.PartNumber || '',
          sku: l.SKU || '',
          productName: l.ProductName || '',
          brandMaterial: l.BrandMaterial || '',
          category: l.Category || '',
          unit: l.Unit || '',
          moduleQty: toNumber(l.ModuleQty),
          qtyPerModule: toNumber(l.QtyPerModule),
          qtyPerMachine: toNumber(l.QtyPerMachine),
          spareQty: toNumber(l.SpareQty),
          requiredQty: toNumber(l.RequiredQty),
          criticalLevel: String(l.CriticalLevel || 'C').toUpperCase(),
          sourceType: l.SourceType || '',
          dri: l.DRI || '',
          notes: l.Notes || ''
        };
      }),

      // Thống kê
      lineCount: moduleLines.length,
      totalQty: totalQty,
      criticalA: criticalA,
      criticalB: criticalB,
      criticalC: criticalC,
      missingDRI: missingDRI
    };
  });

  // Đưa cụm "Chưa gán" xuống cuối
  children.sort(function (a, b) {
    if (a.isUnassigned) return 1;
    if (b.isUnassigned) return -1;
    return String(a.moduleCode || '').localeCompare(String(b.moduleCode || ''), undefined, { numeric: true });
  });

  // Thống kê cấp máy
  var machineTotalQty = 0, machineA = 0, machineB = 0, machineC = 0, machineMissingDRI = 0;
  children.forEach(function (c) {
    machineTotalQty += c.totalQty;
    machineA += c.criticalA;
    machineB += c.criticalB;
    machineC += c.criticalC;
    machineMissingDRI += c.missingDRI;
  });

  return {
    type: 'machine',
    machineId: machine ? machine.MachineID : '',
    machineCode: machine ? machine.MachineCode : '',
    machineName: machine ? machine.MachineName : '',
    machineModel: machine ? machine.MachineModel : '',
    projectCode: project ? project.ProjectCode : '',
    projectName: project ? project.ProjectName : '',
    children: children,
    moduleCount: children.length,
    lineCount: lines.length,
    totalQty: machineTotalQty,
    criticalA: machineA,
    criticalB: machineB,
    criticalC: machineC,
    missingDRI: machineMissingDRI
  };
}

/**
 * API: Trả BOM dạng cây.
 * Gọi từ UI khi user bấm nút "Xem dạng cây".
 *
 * machineId: mã máy
 * versionId: mã phiên bản BOM (tùy chọn — nếu không truyền, lấy bản DRAFT hoặc RELEASED mới nhất)
 */
function getMachineBOMTree(machineId, versionId, options) {
  try {
    var machine = cachedSheetToObjects_('Machines').filter(function (x) {
      return String(x.MachineID) === String(machineId);
    })[0];
    if (!machine) return err_('Không tìm thấy máy.', 'ERR_NOT_FOUND');

    var project = cachedSheetToObjects_('Projects').filter(function (x) {
      return String(x.ProjectID) === String(machine.ProjectID);
    })[0] || null;

    // Lấy danh sách phiên bản
    var versions = cachedSheetToObjects_('MachineBOMVersions').filter(function (x) {
      return String(x.MachineID) === String(machineId);
    });
    versions = machineBomSortVersions_(versions);

    // Chọn phiên bản
    var selected = null;
    if (versionId) {
      selected = versions.filter(function (x) { return String(x.BOMVersionID) === String(versionId); })[0] || null;
    }
    if (versionId && !selected) return err_('Phiên bản BOM không thuộc máy đang chọn.');
    if (!selected) {
      selected = versions.filter(machineBomDraft_)[0]
        || versions.filter(function (x) { return amcvnText_(x.Status).toUpperCase() === 'RELEASED'; })[0]
        || versions[0] || null;
    }

    if (!selected) {
      return ok_({
        machine: machine,
        project: project,
        versions: versions,
        selectedVersion: null,
        tree: null,
        lines: [],
        message: 'Máy này chưa có phiên bản BOM nào.'
      });
    }

    // Lấy lines phẳng
    var lines = machineBomLines_(selected.BOMVersionID);

    // Sắp xếp lines theo cụm rồi theo mã hàng để cây đẹp
    lines.sort(function (a, b) {
      var ma = String(a.ModuleCode || a.ModuleName || '').localeCompare(String(b.ModuleCode || b.ModuleName || ''), undefined, { numeric: true });
      if (ma !== 0) return ma;
      return String(a.PartNumber || a.SKU || '').localeCompare(String(b.PartNumber || b.SKU || ''), undefined, { numeric: true });
    });

    var modules = cachedSheetToObjects_('MachineModules').filter(function (x) {
      return String(x.MachineID) === String(machineId);
    });

    var totalsAll = bomTotalsV224_(lines);
    var pageInfo = options && options.paged ? pageRowsV224_(lines, options, 'bom') : null;
    if (pageInfo) lines = pageInfo.rows;
    // Build tree only for the visible page.
    var tree = buildBOMTree_(lines, machine, project, modules);

    return ok_({
      machine: machine,
      project: project,
      versions: versions,
      selectedVersion: selected,
      tree: tree,
      lines: lines,
      modules: modules,
      pagination: pageInfo ? pageMetaV224_(pageInfo) : null,
      filterOptions: pageInfo ? pageInfo.filterOptions : null,
      totals: pageInfo ? totalsAll : {
        lineCount: lines.length,
        moduleCount: tree.moduleCount || 0,
        totalQty: tree.totalQty || 0,
        lines: lines.length,
        modules: tree.moduleCount || 0,
        requiredQty: tree.totalQty || 0,
        criticalA: tree.criticalA || 0,
        criticalB: tree.criticalB || 0,
        criticalC: tree.criticalC || 0,
        missingDRI: tree.missingDRI || 0
      }
    });
  } catch (e) {
    return err_(e, 'ERR_BOM_TREE');
  }
}

/**
 * Thao tác theo CỤM (bulk theo ModuleID) — dùng cho cây BOM.
 *
 * action: 'duplicate' (nhân bản cụm), 'delete' (xóa cụm), 'clearDRI' (xóa người phụ trách),
 *         'setCritical' (đặt critical level cho cả cụm), 'setDRI' (đặt DRI cho cả cụm)
 */
function bulkUpdateBOMByModule(versionId, moduleId, action, payload) {
  return withMutationLock_(['MachineBOMVersions', 'MachineBOMLines'], function () {
    try {
      var version = amcvnFind_('MachineBOMVersions', 'BOMVersionID', versionId);
      if (!version) return err_('Không tìm thấy phiên bản BOM.', 'ERR_NOT_FOUND');
      if (!machineBomDraft_(version)) {
        return err_('Chỉ có thể thao tác trên bản nháp. Bản đã phát hành phải tạo phiên bản mới.', 'ERR_BOM_RELEASED');
      }

      // Lấy các dòng thuộc cụm này
      var lines = machineBomLines_(versionId).filter(function (x) {
        var mid = String(x.ModuleID || '').trim();
        var mcode = String(x.ModuleCode || '').trim();
        if (moduleId === '__UNASSIGNED__') {
          return !mid && !mcode;
        }
        return mid === String(moduleId) || mcode === String(moduleId);
      });

      if (!lines.length) return err_('Không tìm thấy dòng nào trong cụm này.', 'ERR_BOM_EMPTY');

      var now = new Date();
      var user = getUser_();

      if (action === 'delete') {
        // Xóa cả cụm
        var ids = lines.map(function (l) { return l.BOMLineID; });
        removeBOMLinesV224_(versionId, ids);
        var remaining = machineBomLines_(versionId).length;
        updateRowById('MachineBOMVersions', 'BOMVersionID', versionId, { TotalLines: remaining, UpdatedAt: now });
        writeAudit_('Xóa cụm BOM', 'MachineBOMVersion', versionId, 'Cụm ' + moduleId + ' · ' + ids.length + ' dòng');
        return ok_({ deleted: ids.length, remaining: remaining }, 'Đã xóa ' + ids.length + ' dòng thuộc cụm.');
      }

      if (action === 'clearDRI') {
        var updates = {};
        lines.forEach(function (l) {
          updates[l.BOMLineID] = { DRI: '', UpdatedBy: user, UpdatedAt: now };
        });
        writeBOMChangesV224_(versionId, updates);
        return ok_({ updated: lines.length }, 'Đã xóa DRI của ' + lines.length + ' dòng.');
      }

      if (action === 'setCritical') {
        var level = String((payload && payload.level) || 'C').toUpperCase();
        if (['A', 'B', 'C'].indexOf(level) < 0) return err_('Mức độ không hợp lệ.', 'ERR_BOM_LEVEL');
        var upd2 = {};
        lines.forEach(function (l) {
          upd2[l.BOMLineID] = { CriticalLevel: level, UpdatedBy: user, UpdatedAt: now };
        });
        writeBOMChangesV224_(versionId, upd2);
        return ok_({ updated: lines.length, level: level }, 'Đã đặt mức ' + level + ' cho ' + lines.length + ' dòng.');
      }

      if (action === 'setDRI') {
        var dri = String((payload && payload.dri) || '').trim();
        var upd3 = {};
        lines.forEach(function (l) {
          upd3[l.BOMLineID] = { DRI: dri, UpdatedBy: user, UpdatedAt: now };
        });
        writeBOMChangesV224_(versionId, upd3);
        return ok_({ updated: lines.length, dri: dri }, 'Đã đặt DRI "' + dri + '" cho ' + lines.length + ' dòng.');
      }

      if (action === 'duplicate') {
        // Nhân bản cụm: copy sang ModuleID mới (do user chọn) hoặc tạm chưa gán
        var newModuleId = String((payload && payload.newModuleId) || '').trim();
        var newModuleCode = String((payload && payload.newModuleCode) || '').trim();
        var newModuleName = String((payload && payload.newModuleName) || '').trim();

        // Nếu user chưa chọn module mới -> tạo mã tạm
        if (!newModuleCode) {
          var baseCode = String(lines[0].ModuleCode || 'MOD');
          newModuleCode = baseCode + '-COPY-' + String(Date.now()).slice(-4);
          newModuleName = (lines[0].ModuleName || 'Cụm') + ' (bản sao)';
        }

        var ids = generateIds('MBL', lines.length);
        var newLines = lines.map(function (l, i) {
          var copy = {};
          SCHEMA.MachineBOMLines.forEach(function (k) { copy[k] = l[k] == null ? '' : l[k]; });
          copy.BOMLineID = ids[i]; copy.RootLineID = ''; copy.ChangeType = ''; copy.BOMVersionID = versionId;
          copy.ModuleID = newModuleId;
          copy.ModuleCode = newModuleCode;
          copy.ModuleName = newModuleName;
          copy.CreatedBy = user;
          copy.CreatedAt = now;
          copy.UpdatedAt = now;
          return copy;
        });
        appendRows('MachineBOMLines', newLines);
        var total = machineBomLines_(versionId).length;
        updateRowById('MachineBOMVersions', 'BOMVersionID', versionId, { TotalLines: total, UpdatedAt: now });
        writeAudit_('Nhân bản cụm BOM', 'MachineBOMVersion', versionId, 'Cụm ' + moduleId + ' → ' + newModuleCode);
        return ok_({ created: newLines.length, newModuleCode: newModuleCode }, 'Đã nhân bản cụm thành ' + newModuleCode);
      }

      return err_('Hành động không hỗ trợ: ' + action, 'ERR_BOM_ACTION');
    } catch (e) {
      return err_(e, 'ERR_BOM_BULK');
    }
  });
}

/**
 * Gộp nhiều cụm vào 1 cụm đích.
 * moduleIds: mảng mã cụm cần gộp
 * targetModuleId, targetModuleCode, targetModuleName: cụm đích
 */
function mergeBOMModules(versionId, moduleIds, target) {
  return withMutationLock_(['MachineBOMVersions', 'MachineBOMLines'], function () {
    try {
      var version = amcvnFind_('MachineBOMVersions', 'BOMVersionID', versionId);
      if (!version) return err_('Không tìm thấy phiên bản BOM.', 'ERR_NOT_FOUND');
      if (!machineBomDraft_(version)) return err_('Chỉ có thể gộp trên bản nháp.', 'ERR_BOM_RELEASED');

      if (!Array.isArray(moduleIds) || moduleIds.length < 2) {
        return err_('Cần chọn ít nhất 2 cụm để gộp.', 'ERR_BOM_MERGE_MIN');
      }
      if (!target || (!target.moduleId && !target.moduleCode)) {
        return err_('Chưa chọn cụm đích.', 'ERR_BOM_MERGE_TARGET');
      }

      var idsMap = {};
      moduleIds.forEach(function (id) { idsMap[String(id)] = true; });

      var allLines = machineBomLines_(versionId);

      var toUpdate = allLines.filter(function (x) {
        var key = String(x.ModuleID || x.ModuleCode || '__UNASSIGNED__');
        return idsMap[key];
      });

      if (!toUpdate.length) return err_('Không có dòng nào thuộc các cụm đã chọn.', 'ERR_BOM_MERGE_EMPTY');

      var now = new Date();
      var user = getUser_();
      var updates = {};
      toUpdate.forEach(function (l) {
        updates[l.BOMLineID] = {
          ModuleID: target.moduleId || '',
          ModuleCode: target.moduleCode || '',
          ModuleName: target.moduleName || '',
          ModuleDrawingNo: target.moduleDrawingNo || l.ModuleDrawingNo || '',
          UpdatedBy: user,
          UpdatedAt: now
        };
      });
      writeBOMChangesV224_(versionId, updates);

      writeAudit_('Gộp cụm BOM', 'MachineBOMVersion', versionId,
        moduleIds.length + ' cụm → ' + (target.moduleCode || target.moduleId));

      return ok_({
        moved: toUpdate.length,
        target: target
      }, 'Đã gộp ' + moduleIds.length + ' cụm (' + toUpdate.length + ' dòng) vào "' + (target.moduleName || target.moduleCode) + '".');
    } catch (e) {
      return err_(e, 'ERR_BOM_MERGE');
    }
  });
}

/**
 * Tách một cụm thành nhiều cụm nhỏ dựa trên tiêu chí.
 * splitBy: 'category' | 'bomGroup' | 'criticalLevel' | 'sourceType'
 */
function splitBOMModule(versionId, moduleId, splitBy) {
  return withMutationLock_(['MachineBOMVersions', 'MachineBOMLines'], function () {
    try {
      var version = amcvnFind_('MachineBOMVersions', 'BOMVersionID', versionId);
      if (!version) return err_('Không tìm thấy phiên bản BOM.', 'ERR_NOT_FOUND');
      if (!machineBomDraft_(version)) return err_('Chỉ có thể tách trên bản nháp.', 'ERR_BOM_RELEASED');

      var fieldMap = {
        'category': 'Category',
        'bomGroup': 'BOMGroup',
        'criticalLevel': 'CriticalLevel',
        'sourceType': 'SourceType'
      };
      var field = fieldMap[splitBy];
      if (!field) return err_('Tiêu chí tách không hợp lệ.', 'ERR_BOM_SPLIT_FIELD');

      var lines = machineBomLines_(versionId).filter(function (x) {
        var mid = String(x.ModuleID || '').trim();
        var mcode = String(x.ModuleCode || '').trim();
        if (moduleId === '__UNASSIGNED__') return !mid && !mcode;
        return mid === String(moduleId) || mcode === String(moduleId);
      });

      if (lines.length < 2) return err_('Cụm chỉ có 1 dòng, không cần tách.', 'ERR_BOM_SPLIT_MIN');

      // Nhóm theo field
      var groups = {};
      lines.forEach(function (l) {
        var v = String(l[field] || 'Khác').trim() || 'Khác';
        (groups[v] = groups[v] || []).push(l);
      });

      var groupKeys = Object.keys(groups);
      if (groupKeys.length < 2) {
        return err_('Tất cả dòng đều có cùng giá trị "' + groupKeys[0] + '", không tách được.', 'ERR_BOM_SPLIT_SAME');
      }

      var baseCode = lines[0].ModuleCode || 'MOD';
      var baseName = lines[0].ModuleName || 'Cụm';
      var now = new Date();
      var user = getUser_();
      var updates = {};
      var newModules = [];

      groupKeys.forEach(function (key, idx) {
        var suffix = String(key).replace(/[^A-Za-z0-9]/g, '').slice(0, 8).toUpperCase() || ('G' + (idx + 1));
        var newCode = baseCode + '-' + suffix;
        var newName = baseName + ' (' + key + ')';
        newModules.push({ moduleCode: newCode, moduleName: newName, count: groups[key].length });
        groups[key].forEach(function (l) {
          updates[l.BOMLineID] = {
            ModuleID: '',
            ModuleCode: newCode,
            ModuleName: newName,
            UpdatedBy: user,
            UpdatedAt: now
          };
        });
      });

      writeBOMChangesV224_(versionId, updates);
      writeAudit_('Tách cụm BOM', 'MachineBOMVersion', versionId,
        moduleId + ' → ' + groupKeys.length + ' cụm theo ' + splitBy);

      return ok_({
        splitInto: newModules.length,
        modules: newModules
      }, 'Đã tách thành ' + newModules.length + ' cụm theo ' + splitBy + '.');
    } catch (e) {
      return err_(e, 'ERR_BOM_SPLIT');
    }
  });
}

/* Đăng ký phân quyền */
(function registerBOMTree_() {
  FN_MODULE_.getMachineBOMTree = 'production';
  FN_MODULE_.bulkUpdateBOMByModule = 'production';
