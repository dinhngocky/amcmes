  // Đảm bảo thứ tự sheet có đủ các module mới.
  _nxEnsureSheetOrder_();

  Object.keys(SCHEMA).forEach(function (name) {
    try {
      var result = _nxMigrateOneSheetStructureOnly_(ss, name);
      report.push(result);
    } catch (e) { console.warn('[NexUpOne_UpdateStructureOnly_NoDemo]', (e && e.message) || String(e)); 
      report.push({
        sheet: name,
        ok: false,
        message: e.message
      });
    }
  });

  // Tạo / cập nhật tab Hướng dẫn nhưng không seed data nghiệp vụ.
  try {
    _nxBuildStructureOnlyReadme_();
  } catch (e1) { console.warn('[NexUpOne_UpdateStructureOnly_NoDemo]', (e1 && e1.message) || String(e1)); 
    report.push({
      sheet: README_TAB || 'Hướng dẫn',
      ok: false,
      message: 'Không cập nhật được Hướng dẫn: ' + e1.message
    });
  }

  // Sắp xếp tab + tô màu tab + ẩn gridline.
  try {
    applyWorkbookPolish_();
  } catch (e2) { console.warn('[NexUpOne_UpdateStructureOnly_NoDemo]', (e2 && e2.message) || String(e2)); 
    report.push({
      sheet: 'Workbook',
      ok: false,
      message: 'Không polish workbook được: ' + e2.message
    });
  }

  var okCount = report.filter(function (r) { return r.ok; }).length;
  var failCount = report.length - okCount;

  SpreadsheetApp.getActive().toast(
    'Cập nhật cấu trúc xong: ' + okCount + ' sheet OK, ' + failCount + ' lỗi.',
    'AMCVN',
    6
  );

  Logger.log(JSON.stringify({
    startedAt: startedAt,
    finishedAt: new Date(),
    okCount: okCount,
    failCount: failCount,
    report: report
  }, null, 2));

  return ok_({
    okCount: okCount,
    failCount: failCount,
    report: report
  }, 'Đã cập nhật cấu trúc sheet, giữ nguyên dữ liệu hiện có, không thêm demo data.');
}

