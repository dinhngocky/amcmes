/** Đối soát BOM phát hành vào CTB theo khóa ổn định ProductID + ModuleID. */
function v218ReconcileReleasedBOM_(machineId,version,previousId){
  var machine=amcvnFind_('Machines','MachineID',machineId);
  if(!machine)throw new Error('Không tìm thấy máy.');
  var now=new Date(),user=getUser_(),products={};
  sheetToObjects_('Products').forEach(function(p){products[String(p.ProductID)]=p;});
  var desiredMap={};
  machineBomLines_(version.BOMVersionID).forEach(function(l){
    var required=Math.max(0,toNumber(l.RequiredQty));
    if(!l.ProductID||required<=0)return;
    var key=v218ReqKey_(l.ProductID,l.ModuleID),d=desiredMap[key];
    if(!d)d=desiredMap[key]={Key:key,ProductID:String(l.ProductID),ModuleID:String(l.ModuleID||''),RequiredQty:0,BOMLineIDs:[],Sample:l};
    d.RequiredQty+=required;d.BOMLineIDs.push(String(l.BOMLineID||''));
  });
  var desired=Object.keys(desiredMap).map(function(k){return desiredMap[k];});
  desired.sort(function(a,b){return a.ProductID.localeCompare(b.ProductID)||((b.ModuleID?1:0)-(a.ModuleID?1:0))||b.RequiredQty-a.RequiredQty;});
  var sourceRows=sheetToObjects_('MaterialRequirements').filter(function(r){
    return String(r.MachineID)===String(machineId)&&!!(r.BOMVersionID||r.BOMItemID||r.BOMLineID)&&(materialIsActive_(r)||String(r.BOMVersionID)===String(version.BOMVersionID));
  });
  var history={};sourceRows.forEach(function(r){history[r.RequirementID]=v218ReqHistoryScore_(r.RequirementID);});
  function candidateSort(a,b){
    var aa=materialIsActive_(a)?1:0,ba=materialIsActive_(b)?1:0;
    return ba-aa||(history[b.RequirementID]||0)-(history[a.RequirementID]||0)
      ||(String(b.BOMVersionID)===String(version.BOMVersionID)?1:0)-(String(a.BOMVersionID)===String(version.BOMVersionID)?1:0)
      ||new Date(b.LastUpdated||b.CreatedAt||0)-new Date(a.LastUpdated||a.CreatedAt||0);
  }
  var used={},assignments={};
  desired.forEach(function(d){
    var exact=sourceRows.filter(function(r){return !used[r.RequirementID]&&v218ReqKey_(r.ProductID,r.ModuleID)===d.Key;}).sort(candidateSort);
    var sameProduct=sourceRows.filter(function(r){return !used[r.RequirementID]&&String(r.ProductID)===d.ProductID;}).sort(candidateSort);
    var old=exact[0]||sameProduct[0]||null;
    if(old)used[old.RequirementID]=true;
    assignments[d.Key]={desired:d,old:old,id:old?old.RequirementID:generateId('MR')};
  });
  var cancelled=0,relinked=0,removed=0,superseded=0;
  sourceRows.forEach(function(r){
    if(used[r.RequirementID])return;
    var a=assignments[v218ReqKey_(r.ProductID,r.ModuleID)];
    if(a){
      relinked+=v218RelinkRequirement_(r.RequirementID,a.id,{ProjectID:machine.ProjectID,MachineID:machineId,ModuleID:a.desired.ModuleID,BOMVersionID:version.BOMVersionID},true);
      updateRowById('MaterialRequirements','RequirementID',r.RequirementID,{RequirementStatus:'CANCELLED',ShortageQty:0,ECNChangeType:'SUPERSEDED',ECNNo:version.ECNNo||'',ECNFromBOMVersionID:r.BOMVersionID||previousId||'',ECNToBOMVersionID:version.BOMVersionID,SupersededBy:a.id,LastUpdated:now});
      superseded++;cancelled++;
    }else{
      updateRowById('MaterialRequirements','RequirementID',r.RequirementID,{RequirementStatus:'CANCELLED',ShortageQty:0,ECNChangeType:'REMOVED',ECNNo:version.ECNNo||'',ECNFromBOMVersionID:r.BOMVersionID||previousId||'',ECNToBOMVersionID:version.BOMVersionID,SupersededBy:'',LastUpdated:now});
      materialAppendLog_(r,r.MaterialStatus,r.MaterialStatus,{forceLog:true,Note:'ECN '+(version.ECNNo||version.VersionNo)+': vật tư không còn dùng trong BOM hiện hành',ActualDate:now});
      removed++;cancelled++;
    }
  });
  var created=0,updated=0,added=0,changed=0,unchanged=0,reqsByProduct={},claimed={};
  desired.forEach(function(d){
    var a=assignments[d.Key],old=a.old,p=products[d.ProductID]||{},sample=d.Sample;
    var oldRequired=old?toNumber(old.RequiredQty):0,sameContext=old&&String(old.ProductID)===d.ProductID&&String(old.ModuleID||'')===d.ModuleID;
    var changeType=!old?'ADDED':((sameContext&&Math.abs(oldRequired-d.RequiredQty)<0.000001)?'UNCHANGED':'UPDATED');
    var available=Math.max(0,materialAvailableFor_(d.ProductID,old&&old.RequirementID)-(claimed[d.ProductID]||0));
    var owned=old?dedicatedOwnedQty_(old):0;
    var allocated=old?Math.max(owned,Math.min(d.RequiredQty,Math.max(0,toNumber(old.AllocatedQty)))):Math.min(d.RequiredQty,available);
    allocated=Math.min(d.RequiredQty,Math.max(0,allocated));claimed[d.ProductID]=(claimed[d.ProductID]||0)+Math.max(0,allocated-owned);
    var shortage=Math.max(0,d.RequiredQty-allocated),critical=materialCritical_(sample.CriticalLevel||(old&&old.CriticalLevel));
    var obj={ProjectID:machine.ProjectID,MachineID:machineId,ModuleID:d.ModuleID,BOMItemID:d.BOMLineIDs[0]||'',BOMVersionID:version.BOMVersionID,BOMLineID:d.BOMLineIDs.join(','),ProductID:d.ProductID,
      SKU:sample.SKU||p.SKU||(old&&old.SKU)||'',ProductName:sample.ProductName||p.ProductName||(old&&old.ProductName)||'',Unit:sample.Unit||p.Unit||(old&&old.Unit)||'',RequiredQty:d.RequiredQty,
      RequiredDate:(old&&old.RequiredDate)||machine.PlanStartDate||'',AvailableStock:Math.max(0,toNumber(p.CurrentStock)),AllocatedQty:allocated,ShortageQty:shortage,CriticalLevel:critical,
      MaterialClass:materialClass_(sample.BOMGroup||sample.Category||sample.SourceType||(old&&old.MaterialClass)||p.Category||p.BrandMaterial),ReservedQty:old?materialReservationQty_(old.RequirementID):0,
      SourceType:sample.SourceType||(old&&old.SourceType)||'',PurchaseID:(old&&old.PurchaseID)||'',SupplierID:(old&&old.SupplierID)||'',SupplierName:(old&&old.SupplierName)||'',Owner:(old&&old.Owner)||'',
      InventoryMode:(old&&old.InventoryMode)||'COMMON',MaterialStatus:(old&&old.MaterialStatus)||(shortage<=0?'WAREHOUSE':'DEMAND_CREATED'),RiskLevel:materialRisk_(critical,shortage,(old&&old.RequiredDate)||machine.PlanStartDate),
      RequirementStatus:'ACTIVE',ECNChangeType:changeType,ECNNo:version.ECNNo||'',ECNFromBOMVersionID:(old&&old.BOMVersionID)||previousId||'',ECNToBOMVersionID:version.BOMVersionID,SupersededBy:'',PreviousRequirementID:old?old.RequirementID:'',LastUpdated:now};
    if(old){
      var moduleChanged=String(old.ModuleID||'')!==String(obj.ModuleID||'');
      updateRowById('MaterialRequirements','RequirementID',old.RequirementID,obj);updated++;
      if(moduleChanged)syncMaterialModuleRefsV224_(old.RequirementID,obj.ModuleID);
      if(changeType==='UPDATED'){changed++;materialAppendLog_(Object.assign({},old,obj),old.MaterialStatus,obj.MaterialStatus,{forceLog:true,Note:'ECN '+(version.ECNNo||version.VersionNo)+': cập nhật theo BOM hiện hành',ActualDate:now});}
    }else{
      obj.RequirementID=a.id;obj.CreatedBy=user;obj.CreatedAt=now;appendRow('MaterialRequirements',obj);materialAppendLog_(obj,'',obj.MaterialStatus,{Note:'ECN '+(version.ECNNo||version.VersionNo)+': thêm mới từ BOM',ActualDate:now});created++;added++;
