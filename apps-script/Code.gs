    'SP': 'Products', 'KH': 'Customers', 'NCC': 'Suppliers', 'PM': 'PurchaseOrders',
    'PMI': 'PurchaseItems', 'HD': 'SalesOrders', 'HDI': 'SalesItems', 'BG': 'Quotes',
    'BGI': 'QuoteItems', 'MV': 'StockMovements', 'KK': 'InventoryChecks',
    'KKI': 'InventoryCheckItems', 'TT': 'Payments', 'U': 'Users',
    'TR': 'SalesReturns', 'TRI': 'SalesReturnItems',
    'RFQ':'ProcurementRFQs','RFL':'ProcurementRFQLines','SBQ':'SupplierQuotations','SQL':'SupplierQuotationItems','PP':'PurchaseProposals','PPI':'PurchaseProposalItems','PRQ': 'PurchaseRequisitions', 'PRQI': 'PurchaseRequisitionItems', 'PR': 'PurchaseReturns', 'PRI': 'PurchaseReturnItems', 'AL': 'PaymentAllocations',
    // Chứng từ ghi nợ cũ đầu kỳ — thiếu 4 dòng này thì đếm số thứ tự trên nhầm sổ
    // và mọi phiếu nợ cũ đều mang chung một mã.
    'NOKH': 'SalesOrders', 'NOKHI': 'SalesItems', 'NONC': 'PurchaseOrders', 'NONCI': 'PurchaseItems',
    'CA': 'CashAccounts', 'FC': 'FinanceCategories', 'FT': 'FinanceTransactions',
    'BL': 'BudgetLines', 'BOM': 'BOM', 'LSX': 'ProductionOrders', 'PLOG': 'ProductionProgressLogs',
    // Các module mở rộng của khách: kho hàng, chuyển kho, POS, nhân sự & lương.
    'KHO': 'Warehouses', 'CK': 'StockTransfers', 'CKI': 'StockTransferItems',
    'CA1': 'PosShifts', 'POS': 'PosOrders',
    'NV': 'Employees', 'CC': 'Attendance', 'BLG': 'PayrollPeriods', 'PLG': 'PayrollLines',
    // AMCVN Core V1.
    'PJ': 'Projects', 'MC': 'Machines', 'MOD': 'MachineModules',
    'MR': 'MaterialRequirements', 'MSL': 'MaterialStatusLogs', 'MEX': 'MaterialExceptions',
    'RCV': 'WarehouseReceipts', 'RCVI': 'WarehouseReceiptItems', 'IQC': 'IQCInspections',
    'LOC': 'MaterialLocations', 'KIT': 'MaterialKits', 'KI': 'MaterialKitItems',
    'STG': 'MachineStageLogs', 'ASN': 'MachineAssignments', 'MI': 'MachineIssues',
    'QI': 'QualityIssues', 'FAT': 'FATChecks', 'PN': 'FATPunchList',
    'MBV': 'MachineBOMVersions', 'MBL': 'MachineBOMLines', 'ECN': 'BOMECNLogs'
  });
  return map[prefix] || 'Products';
}

function calculatePaymentStatus(total, paid) {
  total = toNumber(total); paid = toNumber(paid);
  if (paid <= 0) return 'Chưa thanh toán';
  if (paid > total + 0.5) return 'Thanh toán thừa';
  if (paid >= total) return 'Đã thanh toán';
  return 'Thanh toán một phần';
}

/** Cấu hình hiển thị số do người dùng đặt trong Cài đặt (mặc định = như cũ). */
function numFmt_() {
  var s = {};
  try { s = settings_() || {}; } catch (e) { console.warn('[numFmt_]', (e && e.message) || String(e));  s = {}; }
  var dec = parseInt(s.NumDecimals, 10);
  if (isNaN(dec) || dec < 0 || dec > 4) dec = 0;
  return {
    dec: dec,
    thou: (s.ThousandSep === undefined || s.ThousandSep === '') ? '.' : (s.ThousandSep === 'none' ? '' : String(s.ThousandSep)),
    decSep: s.DecimalSep ? String(s.DecimalSep) : ',',
    symbol: (s.CurrencySymbol !== undefined && s.CurrencySymbol !== '') ? String(s.CurrencySymbol) : 'đ'
  };
}

/** Làm tròn tiền theo đúng số chữ số thập phân đã cài. */
function roundMoney_(n) {
  var d = numFmt_().dec;
  var p = Math.pow(10, d);
  return Math.round((toNumber(n) + Number.EPSILON) * p) / p;
}

/** Ghép số theo dấu ngăn cách người dùng chọn. */
function formatNumber_(n, dec) {
  var f = numFmt_();
  if (dec === undefined) dec = f.dec;
  n = toNumber(n);
  var neg = n < 0; n = Math.abs(n);
  var s = dec > 0 ? n.toFixed(dec) : String(Math.round(n));
  var parts = s.split('.');
  var ip = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, '\u0001').split('\u0001').join(f.thou);
  return (neg ? '-' : '') + ip + (parts[1] ? f.decSep + parts[1] : '');
}

function formatMoney_(n) {
  return formatNumber_(n) + ' ' + numFmt_().symbol;
}

/**
 * Tổng tiền ĐÃ THU/CHI THẬT cho 1 chứng từ, gộp cả 2 đường ghi nhận:
 *  - Payments trực tiếp (lúc tạo đơn / thu lẻ 1 chứng từ / thu thêm khi sửa): SourceType+SourceID = đơn
 *  - PaymentAllocations của phiếu thu GỘP nhiều chứng từ (Payments.SourceType = 'Nhiều chứng từ')
 * Tránh đếm trùng: chỉ cộng allocation của phiếu thu gộp (phiếu lẻ đã được tính ở Payments trực tiếp).
 */
function paidForSource_(sourceType, sourceId) {
  if (!sourceId) return 0;
  // Lọc theo SourceID (duy nhất theo mã chứng từ) — KHÔNG so SourceType vì trong sheet đã dịch sang tiếng Việt ('Hóa đơn'/'Phiếu mua').
  var direct = 0, grouped = {};
  sheetToObjects_('Payments').forEach(function (p) {
    if (p.SourceType === 'Nhiều chứng từ') { grouped[p.PaymentID] = true; return; } // phiếu thu/chi GỘP: cộng qua allocation
    if (p.SourceID === sourceId) direct += toNumber(p.Amount);
  });
  var alloc = 0;
  sheetToObjects_('PaymentAllocations').forEach(function (a) {
    if (a.SourceID === sourceId && grouped[a.PaymentID]) alloc += toNumber(a.Amount);
  });
  return direct + alloc;
}

function calculateStockStatus(current, min, max) {
  current = toNumber(current); min = toNumber(min); max = toNumber(max);
  if (current <= 0) return 'Hết hàng';
  if (max > 0 && current >= max) return 'Vượt tồn';
  if (current <= min) return 'Sắp hết';
  return 'Còn hàng';
}

function sanitizeForClient_(value) {
  if (value === null || value === undefined) return value;
  if (value instanceof Date) return Utilities.formatDate(value, getTz_(), "yyyy-MM-dd'T'HH:mm:ssXXX");
  if (Array.isArray(value)) return value.map(function (item) { return sanitizeForClient_(item); });
  if (typeof value === 'object') {
    var out = {};
    Object.keys(value).forEach(function (key) {
      out[key] = sanitizeForClient_(value[key]);
    });
    return out;
  }
  return value;
}

/**
 * CẤU TRÚC PHẢN HỒI CHUẨN cho mọi hàm backend mà frontend gọi:
 *   { success, message, data, errorCode }
 * -> Frontend chỉ cần kiểm tra r.success, không phải đoán nhiều kiểu response.
 */
function ok_(data, message) {
  return { success: true, data: sanitizeForClient_(data), message: message || '', errorCode: null };
}

/**
 * Lỗi backend: LUÔN log đầy đủ (kèm stack) ra Nhật ký thực thi để debug,
 * nhưng chỉ trả về câu thông báo dễ hiểu cho người dùng.
 * message có thể là chuỗi hoặc Error.
 */
function err_(message, errorCode) {
  var text, detail;
  if (message && typeof message === 'object' && message.message) {
    text = String(message.message);
    detail = text + (message.stack ? (' | ' + message.stack) : '');
  } else {
    text = String(message);
    detail = text;
  }
  try { console.error('[AMCVN][' + (errorCode || 'ERR_GENERIC') + '] ' + detail); } catch (logErr) { console.warn('[err_]', (logErr && logErr.message) || String(logErr)); }
  return { success: false, message: text, data: null, errorCode: errorCode || 'ERR_GENERIC' };
}

