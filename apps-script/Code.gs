  Object.keys(affected).forEach(function (pid) { recalculateProductStock(pid); });
}
function syncSalesInventoryOnEdit_(salesId, oldQty, newItems, pMap, salesDate) {
  var existing = salesInventoryAppliedQty_(salesId);
  var useDelta = qtyMapsMatch_(existing, oldQty);
  var movementRows = [];
  if (!useDelta) removeSalesInventory_(salesId);
  newItems.forEach(function (it) {
    var prod = pMap[it.ProductID] || {};
    if (itemProductType_(it, prod) === 'Service') return;
    var newQty = toNumber(it.Quantity);
    var oldItemQty = useDelta ? toNumber(oldQty[it.ProductID]) : 0;
    var diff = newQty - oldItemQty;
    if (diff > 0) movementRows.push({ Type: 'SaleOut', ProductID: it.ProductID, SKU: it.SKU, ProductName: it.ProductName, QuantityIn: 0, QuantityOut: diff, UnitCost: toNumber(it.CostPrice), UnitPrice: toNumber(it.SalePrice), StockAfter: '', Status: 'Đã giao', Notes: useDelta ? 'Xuất thêm do sửa ' + salesId : 'Xuất cho ' + salesId });
    if (diff < 0) movementRows.push({ Type: 'SaleAdjustIn', ProductID: it.ProductID, SKU: it.SKU, ProductName: it.ProductName, QuantityIn: Math.abs(diff), QuantityOut: 0, UnitCost: toNumber(it.CostPrice || prod.CostPrice), UnitPrice: toNumber(it.SalePrice), StockAfter: '', Status: 'Đã nhận', Notes: 'Hoàn tồn do sửa ' + salesId });
  });
  if (useDelta) {
    Object.keys(oldQty || {}).forEach(function (pid) {
      if (newItems.some(function (it) { return it.ProductID === pid; })) return;
      var prod = pMap[pid] || {};
      var qty = toNumber(oldQty[pid]);
      if (prod.ProductType === 'Service' || prod.Category === 'Dịch vụ') return;
      if (qty > 0) movementRows.push({ Type: 'SaleAdjustIn', ProductID: pid, SKU: prod.SKU || '', ProductName: prod.ProductName || pid, QuantityIn: qty, QuantityOut: 0, UnitCost: toNumber(prod.CostPrice), UnitPrice: toNumber(prod.SalePrice), StockAfter: '', Status: 'Đã nhận', Notes: 'Hoàn tồn do xóa khỏi ' + salesId });
    });
  }
  appendSalesInventoryRows_(salesId, movementRows, salesDate ? new Date(salesDate) : new Date(), useDelta ? 'Điều chỉnh do sửa ' + salesId : 'Chuẩn hóa tồn kho phiếu ' + salesId);
}
function rebuildSalesInventoryLedger_() {
