/* ============================================================================
 *  AMC MODULE: KIỂM VỊ TRÍ HÀNG LOẠT (BATCH QR AUDIT)
 *  Cho phép quét nhiều QR liên tục rồi lưu 1 lần.
 * ==========================================================================*/

/**
 * Tra cứu NHIỀU QR cùng lúc — trả về mảng kết quả, mỗi phần tử tương ứng 1 QR.
 * qrValues: mảng chuỗi QR
 */
function traceManyQr(qrValues) {
  try {
    if (!Array.isArray(qrValues) || !qrValues.length) {
      return err_('Chưa có mã QR nào để tra cứu.', 'ERR_QR_EMPTY');
    }
    if (qrValues.length > 200) {
      return err_('Một lần chỉ tra cứu tối đa 200 mã QR.', 'ERR_QR_TOO_MANY');
    }

    var results = [];
    for (var i = 0; i < qrValues.length; i++) {
      var qr = String(qrValues[i] || '').trim();
      if (!qr) {
        results.push({ qrValue: qr, success: false, message: 'Mã QR trống', data: null });
        continue;
      }
      try {
        var r = traceByQr(qr);
        results.push({
          qrValue: qr,
          success: r && r.success,
          message: (r && r.message) || '',
          data: (r && r.data) || null
        });
      } catch (e) {
        console.warn('[traceManyQr]', (e && e.message) || String(e));
        results.push({ qrValue: qr, success: false, message: e.message, data: null });
      }
    }
    return ok_({ results: results, total: results.length });
  } catch (e) {
    return err_(e, 'ERR_QR_TRACE_MANY');
  }
}

/**
 * So sánh vị trí hàng loạt.
 * items: [{
 *   QRValue: string,
 *   ReceiptItemID: string (nếu muốn chỉ định rõ lô nào),
 *   ActualLocation: string,
 *   ActualQty: number
 * }]
 */
function auditManyLocations(items) {
  try {
    items = items || [];
    if (!items.length) return err_('Không có dòng nào để kiểm.', 'ERR_AUDIT_EMPTY');
    if (items.length > 200) return err_('Một lần chỉ kiểm tối đa 200 dòng.', 'ERR_AUDIT_TOO_MANY');

    // Gom theo QR để tra cứu 1 lần
    var byQr = {};
    items.forEach(function (it) {
      var qr = String(it.QRValue || '').trim();
      if (!qr) return;
      if (!byQr[qr]) byQr[qr] = [];
      byQr[qr].push(it);
    });

    var out = [];
    Object.keys(byQr).forEach(function (qr) {
      var traceRes = traceByQr(qr);
      if (!traceRes || !traceRes.success) {
        byQr[qr].forEach(function (it) {
          out.push({
            QRValue: qr,
            ReceiptItemID: it.ReceiptItemID || '',
            SystemLocation: '',
            ActualLocation: String(it.ActualLocation || '').toUpperCase(),
            SystemQty: 0,
            ActualQty: toNumber(it.ActualQty),
            Result: 'NOT_FOUND',
            Message: (traceRes && traceRes.message) || 'Không tìm thấy',
            PartNumber: '',
            ProductID: '',
            ProductName: '',
            MachineID: '', ModuleID: '', RequirementID: ''
          });
        });
        return;
      }
      var data = traceRes.data;
      // Nếu có ReceiptItemID cụ thể -> lấy đúng lô đó
      // Nếu không -> lấy tất cả lô
      byQr[qr].forEach(function (it) {
        var wanted = String(it.ReceiptItemID || '').trim();
        var lots = data.lots || [];
        if (wanted) lots = lots.filter(function (l) { return String(l.ReceiptItemID) === wanted; });
        if (!lots.length && data.product) {
          // Fallback: tra theo product
          out.push({
            QRValue: qr,
            ReceiptItemID: '',
            SystemLocation: (data.product.Locations || []).map(function (l) { return l.LocationCode; }).join(', ').toUpperCase(),
            ActualLocation: String(it.ActualLocation || '').toUpperCase(),
            SystemQty: toNumber(data.product.CurrentStock),
            ActualQty: toNumber(it.ActualQty) || toNumber(data.product.CurrentStock),
            Result: 'PRODUCT_ONLY',
            PartNumber: data.product.PartNumber || '',
            ProductID: data.product.ProductID || '',
            ProductName: data.product.ProductName || '',
            MachineID: '', ModuleID: '', RequirementID: ''
          });
          return;
        }
        lots.forEach(function (lot) {
          var sysLoc = String(lot.SystemLocation || '').toUpperCase();
          var actLoc = String(it.ActualLocation || '').toUpperCase();
          var sysQty = toNumber(lot.CurrentQty);
          var actQty = toNumber(it.ActualQty) || sysQty;
          var result;
          if (!sysLoc && !actLoc) result = 'MATCH';
          else if (sysLoc === actLoc && Math.abs(sysQty - actQty) < 0.0001) result = 'MATCH';
          else if (!sysLoc && actLoc) result = 'EXTRA';
          else result = 'MISMATCH';

          out.push({
            QRValue: qr,
            ReceiptItemID: lot.ReceiptItemID,
            SystemLocation: sysLoc,
            ActualLocation: actLoc,
            SystemQty: sysQty,
            ActualQty: actQty,
            Result: result,
            LotNo: lot.LotNo || '',
            PartNumber: lot.PartNumber || '',
            ProductID: lot.ProductID || '',
            ProductName: lot.ProductName || '',
            MachineID: lot.MachineID || '',
            ModuleID: lot.ModuleID || '',
            RequirementID: lot.RequirementID || '',
            ReceiptID: lot.ReceiptID || '',
            PurchaseID: lot.PurchaseID || '',
            ProjectCode: lot.ProjectCode || '',
            MachineCode: lot.MachineCode || '',
            ModuleCode: lot.ModuleCode || '',
            CurrentLocations: lot.CurrentLocations || []
          });
        });
      });
    });

    return ok_({ audits: out, total: out.length });
  } catch (e) {
    return err_(e, 'ERR_AUDIT_MANY');
  }
}

/**
 * LƯU hàng loạt: nhận mảng các dòng đã được audit, ghi vào LocationAudits
 * và tùy chọn cập nhật MaterialLocations.
 *
 * data: {
 *   audits: [{ QRValue, ReceiptItemID, ProductID, MachineID, ModuleID, RequirementID,
 *              SystemLocation, ActualLocation, SystemQty, ActualQty, Result, Notes }],
 *   autoUpdateLocation: boolean,
 *   Notes: string
 * }
 */
function saveManyLocationAudits(data) {
  data = data || {};
  if (!data.__locked) {
    return runLocked_(data, '__locked',
      ['LocationAudits', 'MaterialLocations', 'AuditLog'],
      function () { return saveManyLocationAudits(data); });
  }
  try {
    var audits = data.audits || [];
    if (!audits.length) return err_('Không có dòng nào để lưu.', 'ERR_AUDIT_EMPTY');
    if (audits.length > 500) return err_('Một lần chỉ lưu tối đa 500 dòng.', 'ERR_AUDIT_TOO_MANY');

    var now = new Date();
    var user = getUser_();
    var autoUpdate = !!data.autoUpdateLocation;
    var rows = [];
    var ids = generateIds('AUDIT', audits.length);
    var updatedLocations = 0;

    audits.forEach(function (a, idx) {
      rows.push({
        AuditID: ids[idx],
        QRValue: String(a.QRValue || '').trim(),
        PartNumber: String(a.PartNumber || '').trim(),
        ProductID: String(a.ProductID || '').trim(),
        MachineID: String(a.MachineID || '').trim(),
        ModuleID: String(a.ModuleID || '').trim(),
        RequirementID: String(a.RequirementID || '').trim(),
        ReceiptItemID: String(a.ReceiptItemID || '').trim(),
        SystemLocation: String(a.SystemLocation || '').trim().toUpperCase(),
        ActualLocation: String(a.ActualLocation || '').trim().toUpperCase(),
        SystemQty: toNumber(a.SystemQty),
        ActualQty: toNumber(a.ActualQty),
        Result: String(a.Result || 'MATCH').toUpperCase(),
        AuditedBy: user,
        AuditedAt: now,
        Notes: String(a.Notes || data.Notes || '').trim()
      });
    });

    appendRows('LocationAudits', rows);

    if (autoUpdate) {
      audits.forEach(function (a) {
        if (String(a.Result || '').toUpperCase() !== 'MISMATCH') return;
        var newLoc = String(a.ActualLocation || '').trim().toUpperCase();
        if (!newLoc) return;

        var locs = sheetToObjects_('MaterialLocations').filter(function (l) {
          if (String(l.ProductID) !== String(a.ProductID)) return false;
          if (toNumber(l.Quantity) <= 0) return false;
          if (a.ReceiptItemID && String(l.ReceiptItemID) === String(a.ReceiptItemID)) return true;
          if (a.RequirementID && String(l.RequirementID) === String(a.RequirementID)) return true;
          return false;
        });

        locs.forEach(function (l) {
          updateRowById('MaterialLocations', 'LocationID', l.LocationID, {
            LocationCode: newLoc,
            UpdatedAt: now,
            UpdatedBy: user
          });
          updatedLocations++;
        });
      });
    }

    writeAudit_('Kiểm vị trí hàng loạt', 'LocationAudit', rows.length + ' dòng',
      rows.length + ' dòng · ' + (autoUpdate ? 'cập nhật ' + updatedLocations + ' vị trí' : 'chỉ ghi log'));

    return ok_({
      saved: rows.length,
      updatedLocations: updatedLocations,
      auditIds: rows.map(function (r) { return r.AuditID; })
    }, 'Đã lưu ' + rows.length + ' dòng kiểm vị trí'
      + (autoUpdate ? ', cập nhật ' + updatedLocations + ' vị trí trong kho' : ''));
  } catch (e) {
    return err_(e, 'ERR_AUDIT_MANY_SAVE');
  }
}

