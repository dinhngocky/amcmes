function detectWebAppUrl_() {
  try {
    var scriptId = ScriptApp.getScriptId();
    var token = ScriptApp.getOAuthToken();
    var res = UrlFetchApp.fetch('https://script.googleapis.com/v1/projects/' + scriptId + '/deployments', {
      headers: { Authorization: 'Bearer ' + token },
      muteHttpExceptions: true
    });
    if (res.getResponseCode() < 200 || res.getResponseCode() >= 300) return '';
    var json = JSON.parse(res.getContentText() || '{}');
    var candidates = [];
    (json.deployments || []).forEach(function (d) {
      (d.entryPoints || []).forEach(function (ep) {
        var web = ep.webApp || {};
        if (web.url) {
          candidates.push({
            url: web.url,
            time: d.updateTime || d.createTime || '',
            exec: /\/exec(\?|$)/.test(web.url)
          });
        }
      });
    });
    candidates.sort(function (a, b) {
      if (a.exec !== b.exec) return a.exec ? -1 : 1;
      return String(b.time).localeCompare(String(a.time));
    });
    return candidates.length ? candidates[0].url : '';
  } catch (e) { console.warn('[detectWebAppUrl_]', (e && e.message) || String(e)); 
    return '';
  }
}

function saveWebAppUrl_(url) {
  url = normalizeWebAppUrl_(url);
  if (!url) return '';
  PropertiesService.getScriptProperties().setProperty('NEXUPONE_WEBAPP_URL', url);
  try { updateSetting('WebAppUrl', url); } catch (e) { console.warn('[saveWebAppUrl_]', (e && e.message) || String(e)); }
  return url;
}

function getConfiguredWebAppUrl_(forceDetect) {
  if (forceDetect) {
    var detected = detectWebAppUrl_();
    if (detected) return saveWebAppUrl_(detected);
  }
  var props = PropertiesService.getScriptProperties();
  var saved = props.getProperty('NEXUPONE_WEBAPP_URL');
  if (saved) return saved;
  try {
    var settings = settings_();
    if (settings.WebAppUrl) return settings.WebAppUrl;
  } catch (e) { console.warn('[getConfiguredWebAppUrl_]', (e && e.message) || String(e)); }
  try { return ScriptApp.getService().getUrl() || ''; } catch (e2) { console.warn('[getConfiguredWebAppUrl_]', (e2 && e2.message) || String(e2));  return ''; }
}

function normalizeWebAppUrl_(input) {
  input = String(input || '').trim();
  if (!input) return '';
  if (/^https:\/\/script\.google\.com\/macros\/s\/[^\/\s]+\/(exec|dev)(\?.*)?$/i.test(input)) return input;
  var m = input.match(/\/macros\/s\/([^\/\s]+)\/?/i);
  var id = m ? m[1] : input;
  id = String(id || '').trim();
  if (!id) return '';
  return 'https://script.google.com/macros/s/' + id + '/exec';
}

function menuSetWebAppUrl_() {
  var ui = SpreadsheetApp.getUi();
  var current = getConfiguredWebAppUrl_();
  var res = ui.prompt(
