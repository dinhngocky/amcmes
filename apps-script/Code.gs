/** Đoán hành động từ tên hàm khi không khai báo trong FN_ACTION_. */
function authActionOf_(fn) {
  if (/^(get|build_get|check|preview|scan|diagnose|calculate|find|list|print)/.test(fn)) return 'v';
  if (/^(create|add|new|open|import|bulkImport|seed|taoDuLieu|setup|install)/.test(fn)) return 'c';
  if (/^(delete|remove|destroy|cancel|disable|bulkDelete)/.test(fn)) return 'd';
  return 'e';   // update / save / set / apply / recalculate / migrate / reconcile...
}

/** Phân hệ + hành động + quyền đặc biệt mà một lời gọi đòi hỏi. */
function authRequirement_(fn, args) {
  args = args || [];
  var extra = FN_EXTRA_[fn] || '';
  if (fn === 'updateField' || fn === 'updateInlineNote' || fn === 'getSheetData') {
    return {
      module: SHEET_MODULE_[String(args[0] || '')] || 'common',
      action: (fn === 'getSheetData' ? 'v' : 'e'), extra: extra
    };
  }
  if (fn === 'bulkDelete') {
    return { module: BULK_KIND_MODULE_[String(args[0] || '').toLowerCase()] || 'users', action: 'd', extra: extra };
  }
  return { module: FN_MODULE_[fn] || 'common', action: FN_ACTION_[fn] || authActionOf_(fn), extra: extra };
}

