    var movementIds = generateIds('MV', items.length);
    var movementRows = [], affectedProducts = {};
    items.forEach(function (it, idx) {
      var p = pMap[it.ProductID]; if (!p) return; var qty = toNumber(it.Quantity); if (qty <= 0) return;
      movementRows.push({
        MovementID: movementIds[idx], Date: d, Type: mode === 'in' ? 'ManualIn' : 'ManualOut', SourceType: 'Manual', SourceID: '',
        ProductID: p.ProductID, SKU: p.SKU, ProductName: p.ProductName, QuantityIn: mode === 'in' ? qty : 0, QuantityOut: mode === 'out' ? qty : 0,
        UnitCost: toNumber(p.CostPrice), UnitPrice: toNumber(p.SalePrice), StockAfter: '', CreatedBy: getUser_(),
        Notes: notes || (mode === 'in' ? 'Nhập kho thủ công' : 'Xuất kho thủ công'), CreatedAt: now, Status: st
