  whEnter_(data);   // module nhiều kho: nhớ kho đang thao tác cho các dòng biến động
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked',
    ['InventoryChecks', 'InventoryCheckItems', 'StockMovements', 'Products'],
    function () { return createInventoryCheck(data); });
  try {
    var id = generateId('KK');
    var now = new Date();
    var pMap = {}; sheetToObjects_('Products').forEach(function (p) { pMap[p.ProductID] = p; });
    var totalInc = 0, totalDec = 0, diffValue = 0, count = 0;
    var checkItems = [], movements = [], affectedProducts = {};
    var checkItemIds = generateIds('KKI', (data.items || []).length);
    var movementIds = generateIds('MV', (data.items || []).length);
    (data.items || []).forEach(function (it, idx) {
      var p = pMap[it.ProductID]; if (!p) return;
      if (isServiceProduct_(p)) return;   // Dịch vụ không có tồn -> bỏ qua khi kiểm kê
      var sys = toNumber(p.CurrentStock); var actual = toNumber(it.ActualStock);
      var diff = actual - sys;
      count++;
      if (diff > 0) totalInc += diff; else if (diff < 0) totalDec += Math.abs(diff);
      diffValue += diff * toNumber(p.CostPrice);
      checkItems.push({
        CheckItemID: checkItemIds[idx], CheckID: id, ProductID: p.ProductID, SKU: p.SKU,
        ProductName: p.ProductName, SystemStock: sys, ActualStock: actual, Difference: diff,
        Reason: it.Reason || '', Status: diff === 0 ? 'Khớp' : 'Lệch'
      });
      if (diff !== 0) {
        movements.push({
          MovementID: movementIds[idx], Date: now, Type: 'InventoryAdjust', SourceType: 'InventoryCheck', SourceID: id,
          ProductID: p.ProductID, SKU: p.SKU, ProductName: p.ProductName,
          QuantityIn: diff > 0 ? diff : 0, QuantityOut: diff < 0 ? Math.abs(diff) : 0,
          UnitCost: toNumber(p.CostPrice), UnitPrice: toNumber(p.SalePrice), StockAfter: '',
          CreatedBy: getUser_(), Notes: 'Điều chỉnh kiểm kê ' + id, CreatedAt: now, Status: 'Đã nhận'
        });
        affectedProducts[p.ProductID] = true;
      }
    });
    appendRows('InventoryCheckItems', checkItems);
    appendRows('StockMovements', movements);
    Object.keys(affectedProducts).forEach(function (pid) { recalculateProductStock(pid); });
    appendRow('InventoryChecks', {
      CheckID: id, CheckDate: docDate_(data.CheckDate, now), CheckedBy: getUser_(),
      TotalItems: count, TotalIncrease: totalInc, TotalDecrease: totalDec,
      EstimatedDifferenceValue: diffValue, Status: 'Hoàn tất', Notes: data.Notes || '', CreatedAt: now
    });
    return ok_({ CheckID: id }, 'Đã tạo phiếu kiểm kê ' + id);
  } catch (e) { return err_(e.message); }
}

/* ============================================================================
 *  DEBT / PAYMENT
 * ========================================================================== */

function getDebtSummary() {
  try {
    var sales = sheetToObjects_('SalesOrders');
    var purchases = sheetToObjects_('PurchaseOrders');
    var today = new Date(); today.setHours(0, 0, 0, 0);
    var receivable = 0, payable = 0, overdueReceivable = 0, overduePayable = 0;
    sales.forEach(function (s) {
      var r = toNumber(s.ReceivableAmount); receivable += r;
      if (r > 0 && s.DueDate && new Date(s.DueDate) < today) overdueReceivable += r;
    });
    purchases.forEach(function (p) {
      var r = toNumber(p.PayableAmount); payable += r;
      if (r > 0 && p.DueDate && new Date(p.DueDate) < today) overduePayable += r;
    });
    return ok_({ receivable: receivable, payable: payable, overdueReceivable: overdueReceivable, overduePayable: overduePayable });
  } catch (e) { return err_(e.message); }
}

function getReceivables() {
  try {
    var today = new Date(); today.setHours(0, 0, 0, 0);
    var rows = sheetToObjects_('SalesOrders').filter(function (s) { return toNumber(s.ReceivableAmount) > 0; })
      .map(function (s) {
        s.Overdue = s.DueDate && new Date(s.DueDate) < today;
        return s;
      });
    return ok_(rows);
  } catch (e) { return err_(e.message); }
}

function getPayables() {
  try {
    var today = new Date(); today.setHours(0, 0, 0, 0);
    var rows = sheetToObjects_('PurchaseOrders').filter(function (p) { return toNumber(p.PayableAmount) > 0; })
      .map(function (p) { p.Overdue = p.DueDate && new Date(p.DueDate) < today; return p; });
    return ok_(rows);
  } catch (e) { return err_(e.message); }
}

/**
 * Ghi nhận thanh toán. Hỗ trợ 2 chế độ:
 *  - Đơn lẻ (cũ):  { SourceType:'SalesOrder'|'PurchaseOrder', SourceID, Amount, Method, Note, PaymentDate }
 *  - Phân bổ (mới): { ObjectType:'Customer'|'Supplier', ObjectID, Method, Note, PaymentDate,
 *                     allocations:[{ SourceType, SourceID, Amount }] }  // 1 phiếu thu trả nhiều HĐ
 */
function recordPayment(data) {
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked',
    ['Payments', 'PaymentAllocations', 'SalesOrders', 'PurchaseOrders', 'Customers', 'Suppliers'].concat(FINANCE_LOCK_SHEETS_),
    function () { return recordPayment(data); });
  try {
    var dupChk = dupByClientRef_('Payments', 'PaymentID', data.ClientRef, 'Phiếu thu/chi');
    if (dupChk) return dupChk;
    var now = new Date();
    var pd = docDate_(data.PaymentDate, now);

    var allocations = data.allocations;
    var objectType = data.ObjectType;
    if (!allocations || !allocations.length) {
      if (!data.SourceID) return err_('Thiếu chứng từ thanh toán');
      objectType = (data.SourceType === 'SalesOrder') ? 'Customer' : 'Supplier';
      allocations = [{ SourceType: data.SourceType, SourceID: data.SourceID, Amount: toNumber(data.Amount) }];
    }
    allocations = allocations.filter(function (a) { return toNumber(a.Amount) > 0; });
    if (!allocations.length) return err_('Số tiền phân bổ không hợp lệ');

    var totalAmount = allocations.reduce(function (s, a) { return s + toNumber(a.Amount); }, 0);
    var direction = (objectType === 'Customer') ? 'In' : 'Out';
    var objectId = data.ObjectID || '';
    var objectName = '';
    var paymentId = generateId('TT');
    var salesMap = {}, purchaseMap = {};
    sheetToObjects_('SalesOrders').forEach(function (s) { salesMap[s.SalesID] = s; });
    sheetToObjects_('PurchaseOrders').forEach(function (p) { purchaseMap[p.PurchaseID] = p; });
    allocations.forEach(function (a) {
      if (a.SourceType === 'SalesOrder' && !salesMap[a.SourceID]) throw new Error('Không tìm thấy hóa đơn ' + a.SourceID);
      if (a.SourceType === 'PurchaseOrder' && !purchaseMap[a.SourceID]) throw new Error('Không tìm thấy phiếu mua ' + a.SourceID);
      if (a.SourceType !== 'SalesOrder' && a.SourceType !== 'PurchaseOrder') throw new Error('Loại chứng từ thanh toán không hợp lệ');
    });
    var allocationIds = generateIds('AL', allocations.length);
    var allocationRows = [];

    allocations.forEach(function (a, idx) {
      var amt = toNumber(a.Amount);
      if (a.SourceType === 'SalesOrder') {
        var so = salesMap[a.SourceID];
        if (!so) return;
        var total = toNumber(so.TotalAmount);
        var already = toNumber(so.PaidAmount);
        // P0-#4: chặn thu vượt số còn nợ (tránh tiền thừa bị nuốt mất)
        if (amt > (total - already) + 0.5) throw new Error('Số tiền thu cho hóa đơn ' + a.SourceID + ' vượt quá số còn nợ (còn ' + formatMoney_(Math.max(0, total - already)) + '). Hãy nhập tối đa số còn nợ.');
        var paid = already + amt;
        updateRowById('SalesOrders', 'SalesID', a.SourceID, {
          PaidAmount: paid, ReceivableAmount: Math.max(0, total - paid), PaymentStatus: calculatePaymentStatus(total, paid)
        });
        if (!objectId) objectId = so.CustomerID; if (!objectName) objectName = so.CustomerName;
      } else {
        var po = purchaseMap[a.SourceID];
        if (!po) return;
        var total2 = toNumber(po.TotalAmount);
        var already2 = toNumber(po.PaidAmount);
        if (amt > (total2 - already2) + 0.5) throw new Error('Số tiền chi cho phiếu mua ' + a.SourceID + ' vượt quá số còn nợ (còn ' + formatMoney_(Math.max(0, total2 - already2)) + '). Hãy nhập tối đa số còn nợ.');
        var paid2 = already2 + amt;
        updateRowById('PurchaseOrders', 'PurchaseID', a.SourceID, {
          PaidAmount: paid2, PayableAmount: Math.max(0, total2 - paid2), PaymentStatus: calculatePaymentStatus(total2, paid2)
        });
        if (!objectId) objectId = po.SupplierID; if (!objectName) objectName = po.SupplierName;
      }
      allocationRows.push({
        AllocationID: allocationIds[idx], PaymentID: paymentId, ObjectType: objectType, ObjectID: objectId,
        ObjectName: objectName, SourceType: a.SourceType, SourceID: a.SourceID, Amount: amt, CreatedAt: now
      });
    });
    appendRows('PaymentAllocations', allocationRows);

    // Tài khoản tiền: dùng ĐÚNG tài khoản người dùng chọn, không tự đẩy về tài khoản mặc định.
    var payMethod = data.Method || 'Tiền mặt';
    var nonCash = financeIsNonCashMethod_(payMethod);
    // Sheet chưa từng mở module Tài chính -> tự tạo tài khoản mặc định, KHÔNG chặn thanh toán.
    if (!nonCash) { try { seedFinanceDefaults_(); } catch (seedErr) { console.warn('[recordPayment]', (seedErr && seedErr.message) || String(seedErr));  } }
    var payAcc = nonCash ? null : financeAccountForPayment_(data.AccountID, payMethod);
    if (!nonCash && !payAcc) return err_('Chưa có tài khoản tiền nào đang hoạt động. Hãy tạo tài khoản ở module Tài chính trước.');
    if (data.AccountID && payAcc && String(payAcc.AccountID) !== String(data.AccountID)) return err_('Không tìm thấy tài khoản tiền đã chọn.');
    if (payAcc && String(payAcc.Status || 'Đang hoạt động') === 'Ngừng dùng') return err_('Tài khoản tiền đã ngừng dùng, hãy chọn tài khoản khác.');

    appendPaymentRow_({
    ClientRef: data.ClientRef || '',
      PaymentID: paymentId, PaymentDate: pd, ObjectType: objectType, ObjectID: objectId, ObjectName: objectName,
      SourceType: (allocations.length > 1 ? 'Nhiều chứng từ' : allocations[0].SourceType),
      SourceID: (allocations.length > 1 ? allocations.length + ' chứng từ' : allocations[0].SourceID),
      PaymentDirection: direction, Amount: totalAmount, Method: payMethod,
      BillImageUrl: data.BillImageUrl || '', BillAmount: data.BillAmount ? toNumber(data.BillAmount) : '', BillOcrText: data.BillOcrText || '',
      Note: data.Note || (direction === 'In' ? 'Thu tiền khách hàng' : 'Trả tiền nhà cung cấp'),
      CreatedBy: getUser_(), CreatedAt: now,
      AccountID: payAcc ? payAcc.AccountID : '', AccountName: payAcc ? payAcc.AccountName : ''
    });

    if (objectType === 'Customer') refreshCustomerBalance_(objectId); else refreshSupplierBalance_(objectId);
    writeAudit_('Ghi nhận thanh toán', 'Payment', paymentId, (objectName || '') + ' · ' + formatMoney_(totalAmount));
    return ok_({ PaymentID: paymentId, total: totalAmount, count: allocations.length }, 'Đã ghi nhận thanh toán');
  } catch (e) { return err_(e.message); }
}

/**
 * Ghi nhan thu/chi theo doi tuong ma khong bat buoc phai co chung tu cu.
 * Phan co the doi tru duoc phan bo FIFO; phan du duoc giu la thu/trả truoc.
 */
function recordPartyPayment_(data, isCustomer) {
  data = data || {};
  var objectType = isCustomer ? 'Customer' : 'Supplier';
  var objectId = String(data.ObjectID || '').trim();
  var amount = toNumber(data.Amount);
  if (!objectId) return err_(isCustomer ? 'Chọn khách hàng' : 'Chọn nhà cung cấp');
  if (!(amount > 0)) return err_('Số tiền phải lớn hơn 0');

  var partySheet = isCustomer ? 'Customers' : 'Suppliers';
  var partyIdKey = isCustomer ? 'CustomerID' : 'SupplierID';
  var partyNameKey = isCustomer ? 'CustomerName' : 'SupplierName';
  var party = sheetToObjects_(partySheet).filter(function (x) { return String(x[partyIdKey]) === objectId; })[0];
  if (!party) return err_(isCustomer ? 'Không tìm thấy khách hàng' : 'Không tìm thấy nhà cung cấp');

  var method = data.Method || 'Tiền mặt';
  var nonCash = financeIsNonCashMethod_(method);
  if (!nonCash) { try { seedFinanceDefaults_(); } catch (seedErr) { console.warn('[recordPartyPayment_]', (seedErr && seedErr.message) || String(seedErr));  } }
  var account = nonCash ? null : financeAccountForPayment_(data.AccountID, method);
  if (!nonCash && !account) return err_('Chưa có tài khoản tiền đang hoạt động. Hãy tạo tài khoản trong Tài chính › Sổ quỹ.');
  if (!nonCash && data.AccountID && String(account.AccountID) !== String(data.AccountID)) return err_('Không tìm thấy tài khoản tiền đã chọn.');
  if (account && String(account.Status || 'Đang hoạt động') === 'Ngừng dùng') return err_('Tài khoản tiền đã ngừng dùng.');

  var autoAllocate = data.AllocationMode !== 'advance' && data.AutoAllocate !== false;
  var sourceSheet = isCustomer ? 'SalesOrders' : 'PurchaseOrders';
  var sourceIdKey = isCustomer ? 'SalesID' : 'PurchaseID';
  var sourceDateKey = isCustomer ? 'SalesDate' : 'PurchaseDate';
  var dueKey = isCustomer ? 'ReceivableAmount' : 'PayableAmount';
  var paidKey = 'PaidAmount';
  var sourceType = isCustomer ? 'SalesOrder' : 'PurchaseOrder';
  var rows = autoAllocate ? sheetToObjects_(sourceSheet).filter(function (x) {
    return String(x[partyIdKey]) === objectId && !isCancelled_(String(x.Status || '')) && toNumber(x[dueKey]) > 0;
  }).sort(function (a, b) {
    var da = parseDate_(a[sourceDateKey]), db = parseDate_(b[sourceDateKey]);
    return (da ? da.getTime() : 0) - (db ? db.getTime() : 0) || String(a[sourceIdKey]).localeCompare(String(b[sourceIdKey]));
  }) : [];

  var remaining = amount, allocations = [];
  rows.forEach(function (row) {
    if (remaining <= 0) return;
    var due = toNumber(row[dueKey]);
    var used = Math.min(remaining, due);
    if (!(used > 0)) return;
    allocations.push({ row: row, SourceType: sourceType, SourceID: row[sourceIdKey], Amount: used });
    remaining -= used;
  });

  var paymentId = generateId('TT'), now = new Date();
  var allocationIds = generateIds('AL', allocations.length);
  allocations.forEach(function (a, idx) {
    var row = a.row, total = toNumber(row.TotalAmount), paid = toNumber(row[paidKey]) + a.Amount;
    var update = { PaidAmount: paid, PaymentStatus: calculatePaymentStatus(total, paid) };
    update[dueKey] = Math.max(0, total - paid);
    updateRowById(sourceSheet, sourceIdKey, a.SourceID, update);
    a.AllocationID = allocationIds[idx];
  });

  if (allocations.length) {
    appendRows('PaymentAllocations', allocations.map(function (a) {
      return {
        AllocationID: a.AllocationID, PaymentID: paymentId, ObjectType: objectType, ObjectID: objectId,
        ObjectName: party[partyNameKey] || '', SourceType: a.SourceType, SourceID: a.SourceID,
        Amount: a.Amount, CreatedAt: now
      };
    }));
  }

  var advanceLabel = isCustomer ? 'Thu trước / Khách trả trước' : 'Trả trước NCC';
  var defaultLabel = isCustomer ? 'Thu tiền khách hàng' : 'Trả tiền nhà cung cấp';
  var note = String(data.Note || '').trim();
  if (!note) note = allocations.length ? defaultLabel : advanceLabel;
  if (remaining > 0 && allocations.length) note += ' · ' + advanceLabel + ': ' + formatMoney_(remaining);

  appendPaymentRow_({
    PaymentID: paymentId, PaymentDate: docDate_(data.PaymentDate, now),
    ObjectType: objectType, ObjectID: objectId, ObjectName: party[partyNameKey] || '',
    SourceType: isCustomer ? 'CustomerReceipt' : 'SupplierPayment',
    SourceID: allocations.length === 1 ? allocations[0].SourceID : (allocations.length > 1 ? allocations.length + ' chứng từ' : ''),
    PaymentDirection: isCustomer ? 'In' : 'Out', Amount: amount, Method: method,
    BillImageUrl: data.BillImageUrl || '', BillAmount: data.BillAmount === '' || data.BillAmount == null ? '' : toNumber(data.BillAmount),
    BillOcrText: data.BillOcrText || '', Note: note, CreatedBy: getUser_(), CreatedAt: now,
    AccountID: account ? account.AccountID : '', AccountName: account ? account.AccountName : ''
  });

  if (isCustomer) refreshCustomerBalance_(objectId); else refreshSupplierBalance_(objectId);
  writeAudit_(isCustomer ? 'Lập phiếu thu khách hàng' : 'Lập phiếu chi NCC', 'Payment', paymentId,
    (party[partyNameKey] || '') + ' · ' + formatMoney_(amount));
  return ok_({
    PaymentID: paymentId, total: amount,
    allocated: amount - remaining, advance: remaining, count: allocations.length
  }, isCustomer ? 'Đã lập phiếu thu khách hàng' : 'Đã lập phiếu chi nhà cung cấp');
}

function recordCustomerReceipt(data) {
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked',
    ['Payments', 'PaymentAllocations', 'SalesOrders', 'Customers'].concat(FINANCE_LOCK_SHEETS_),
    function () { return recordCustomerReceipt(data); });
  try { return recordPartyPayment_(data, true); } catch (e) { return err_(e.message); }
}

function recordSupplierPayment(data) {
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked',
    ['Payments', 'PaymentAllocations', 'PurchaseOrders', 'Suppliers'].concat(FINANCE_LOCK_SHEETS_),
    function () { return recordSupplierPayment(data); });
  try { return recordPartyPayment_(data, false); } catch (e) { return err_(e.message); }
}

/* P1-#5: Xóa 1 phiếu thanh toán và tính lại công nợ liên quan */
function deletePayment(paymentId, __locked) {
  if (!__locked) return withMutationLock_(['Payments', 'PaymentAllocations', 'SalesOrders', 'PurchaseOrders', 'Customers', 'Suppliers'].concat(FINANCE_LOCK_SHEETS_), function () { return deletePayment(paymentId, true); });
  try {
    var pay = sheetToObjects_('Payments').filter(function (p) { return p.PaymentID === paymentId; })[0];
    if (!pay) return err_('Không tìm thấy phiếu thanh toán');
    var touchedC = {}, touchedS = {};
    /* FIX: KHÔNG so theo srcType — sheet lưu SourceType đã dịch ('Hóa đơn' / 'Phiếu mua'),
       nên so với 'SalesOrder'/'PurchaseOrder' luôn trượt và công nợ KHÔNG bao giờ được hoàn lại.
       SourceID là duy nhất nên tra thẳng theo SourceID. */
    function unapply(srcType, srcId, amt) {
      amt = toNumber(amt); if (!srcId || amt <= 0) return;
      var so = sheetToObjects_('SalesOrders').filter(function (s) { return s.SalesID === srcId; })[0];
      if (so) {
        var total = toNumber(so.TotalAmount), paid = Math.max(0, toNumber(so.PaidAmount) - amt);
        updateRowById('SalesOrders', 'SalesID', srcId, { PaidAmount: paid, ReceivableAmount: Math.max(0, total - paid), PaymentStatus: calculatePaymentStatus(total, paid) });
        if (so.CustomerID) touchedC[so.CustomerID] = true;
        return;
      }
      var po = sheetToObjects_('PurchaseOrders').filter(function (p) { return p.PurchaseID === srcId; })[0];
      if (po) {
        var t = toNumber(po.TotalAmount), pd = Math.max(0, toNumber(po.PaidAmount) - amt);
        updateRowById('PurchaseOrders', 'PurchaseID', srcId, { PaidAmount: pd, PayableAmount: Math.max(0, t - pd), PaymentStatus: calculatePaymentStatus(t, pd) });
        if (po.SupplierID) touchedS[po.SupplierID] = true;
      }
    }
    var allocs = sheetToObjects_('PaymentAllocations').filter(function (a) { return a.PaymentID === paymentId; });
    if (allocs.length) { allocs.forEach(function (a) { unapply(a.SourceType, a.SourceID, a.Amount); deleteRowById('PaymentAllocations', 'AllocationID', a.AllocationID); }); }
    else { unapply(pay.SourceType, pay.SourceID, pay.Amount); }
    deleteRowById('Payments', 'PaymentID', paymentId);
    try { cancelFinanceBySource_('Payment', paymentId); } catch (financeDeleteErr) { console.warn('[deletePayment]', (financeDeleteErr && financeDeleteErr.message) || String(financeDeleteErr));  }
    Object.keys(touchedC).forEach(function (id) { refreshCustomerBalance_(id); });
    Object.keys(touchedS).forEach(function (id) { refreshSupplierBalance_(id); });
    writeAudit_('Xóa thanh toán', 'Payment', paymentId, (pay.ObjectName || '') + ' · ' + formatMoney_(pay.Amount));
    return ok_(null, 'Đã xóa phiếu thanh toán ' + paymentId + ' và cập nhật lại công nợ');
  } catch (e) { return err_(e.message); }
}

/* P1-#6: Đối soát toàn hệ thống — đồng bộ tồn kho & công nợ từ sổ gốc */
function reconcileAll() {
  return withMutationLock_(['Products', 'StockMovements', 'SalesOrders', 'PurchaseOrders', 'Customers', 'Suppliers', 'Payments', 'PaymentAllocations'].concat(FINANCE_LOCK_SHEETS_), function () {
    var fixed = 0;
    var rebuiltSales = rebuildSalesInventoryLedger_();
    sheetToObjects_('Products').forEach(function (p) { recalculateProductStock(p.ProductID); });
    sheetToObjects_('SalesOrders').forEach(function (s) {
      if (isCancelled_(s.Status)) return;
      var paid = paidForSource_('SalesOrder', s.SalesID), total = toNumber(s.TotalAmount), rec = Math.max(0, total - paid);
      if (toNumber(s.PaidAmount) !== paid || toNumber(s.ReceivableAmount) !== rec) { fixed++; updateRowById('SalesOrders', 'SalesID', s.SalesID, { PaidAmount: paid, ReceivableAmount: rec, PaymentStatus: calculatePaymentStatus(total, paid) }); }
    });
    sheetToObjects_('PurchaseOrders').forEach(function (p) {
      if (isCancelled_(p.Status)) return;
      var paid = paidForSource_('PurchaseOrder', p.PurchaseID), total = toNumber(p.TotalAmount), pay = Math.max(0, total - paid);
      if (toNumber(p.PaidAmount) !== paid || toNumber(p.PayableAmount) !== pay) { fixed++; updateRowById('PurchaseOrders', 'PurchaseID', p.PurchaseID, { PaidAmount: paid, PayableAmount: pay, PaymentStatus: calculatePaymentStatus(total, paid) }); }
    });
    sheetToObjects_('Customers').forEach(function (c) { refreshCustomerBalance_(c.CustomerID); });
    sheetToObjects_('Suppliers').forEach(function (s) { refreshSupplierBalance_(s.SupplierID); });
    // Đối soát luôn sổ quỹ: bù bút toán cho Payment còn thiếu, tính lại số dư tài khoản & ngân sách.
    var financeMsg = '';
    try { reconcileFinance(); financeMsg = '; đã đối soát sổ quỹ & ngân sách'; }
    catch (finErr) { console.warn('[reconcileAll]', (finErr && finErr.message) || String(finErr));  financeMsg = '; (chưa đối soát được sổ quỹ: ' + finErr.message + ')'; }
    writeAudit_('Đối soát hệ thống', 'System', '', 'Đồng bộ tồn kho & công nợ; dựng lại ' + rebuiltSales.rebuilt + ' dòng xuất bán; sửa ' + fixed + ' chứng từ lệch' + financeMsg);
    return ok_({ fixed: fixed, rebuiltSales: rebuiltSales }, 'Đã đối soát: đồng bộ tồn kho & công nợ, dựng lại ' + rebuiltSales.rebuilt + ' dòng xuất bán' + (fixed ? (' — đã sửa ' + fixed + ' chứng từ bị lệch') : '') + financeMsg);
  });
}

/* ============================================================================
 *  SẢN XUẤT — Định mức (BOM) + Lệnh sản xuất
 * ========================================================================== */
var PRODUCTION_STATUS_FLOW = ['Đã lên lệnh', 'Đang sản xuất', 'Hoàn thành', 'Đã hủy'];
var PRODUCTION_STATUS_NEXT = {
  'Đã lên lệnh': ['Đang sản xuất', 'Đã hủy'],
  'Đang sản xuất': ['Hoàn thành', 'Đã hủy'],
  'Hoàn thành': [],
  'Đã hủy': []
};

function ensureProductionWorkflowSchema_() {
  ['ProductionOrders', 'ProductionProgressLogs'].forEach(function (name) {
    var sh = getSheet_(name);
    var headers = viHeaders_(name);
    if (sh.getLastColumn() < headers.length) {
      sh.getRange(1, 1, 1, headers.length).setValues([headers]);
      sh.setFrozenRows(1);
      clearDataCache_();
    }
  });
}

function getBOMItems() { return getSheetData('BOM'); }
function getProductionOrders() { ensureProductionWorkflowSchema_(); return getSheetData('ProductionOrders'); }

/* Định mức của 1 thành phẩm, enrich giá vốn/tồn NVL hiện tại */
function bomForProduct_(productId) {
  var pMap = {}; sheetToObjects_('Products').forEach(function (p) { pMap[p.ProductID] = p; });
  return sheetToObjects_('BOM').filter(function (b) { return b.ProductID === productId; }).map(function (b) {
    var lineType = normalizeBOMLineType_(b);
    var c = pMap[b.ComponentID] || {};
    var qty = toNumber(b.Quantity);
    var unitCost = lineType === 'MoneyCost' ? toNumber(b.UnitCost) : (toNumber(b.UnitCost) || toNumber(c.CostPrice));
    var amount = toNumber(b.Amount) || (qty * unitCost);
    return { BOMItemID: b.BOMItemID, LineType: lineType, CostGroup: b.CostGroup || (lineType === 'MoneyCost' ? 'Khác' : 'NVL'), CostName: b.CostName || '', ComponentID: lineType === 'MoneyCost' ? '' : b.ComponentID, ComponentName: lineType === 'MoneyCost' ? (b.CostName || b.ComponentName || 'Chi phí') : (b.ComponentName || c.ProductName || b.ComponentID), ComponentSKU: lineType === 'MoneyCost' ? '' : (b.ComponentSKU || c.SKU || ''), Quantity: qty, Unit: lineType === 'MoneyCost' ? (b.Unit || '') : (b.Unit || c.Unit || ''), UnitCost: unitCost, Amount: amount, Notes: b.Notes || '', CriticalLevel: materialCritical_(b.CriticalLevel), SourceType: b.SourceType || '', PreferredSupplierID: b.PreferredSupplierID || '', LeadTimeDays: toNumber(b.LeadTimeDays), RequiredDate: b.RequiredDate || '', Revision: b.Revision || '', unitCost: unitCost, stock: lineType === 'MoneyCost' ? 0 : toNumber(c.CurrentStock) };
  });
}

function normalizeBOMLineType_(row) {
  var t = String((row && row.LineType) || '').trim();
  if (t === 'MoneyCost' || t === 'Chi phí bằng tiền') return 'MoneyCost';
  if (t === 'Material' || t === 'NVL trừ kho') return 'Material';
  // Dữ liệu cũ: có mã thành phần là NVL; không có mã nhưng có tên/nhóm phí là chi phí tiền.
  return row && row.ComponentID ? 'Material' : 'MoneyCost';
}

function isStockProductionMaterial_(row, productMap) {
  if (!row || normalizeBOMLineType_(row) === 'MoneyCost' || !row.ComponentID) return false;
  return !productMap || !!productMap[row.ComponentID];
}

function bomLineAmount_(line) {
  var qty = toNumber(line && line.Quantity);
  var unitCost = toNumber((line && (line.UnitCost || line.unitCost)) || 0);
  return toNumber(line && line.Amount) || (qty * unitCost);
}

function getProductBOM(productId) {
  try {
    var p = sheetToObjects_('Products').filter(function (x) { return x.ProductID === productId; })[0];
    var comps = bomForProduct_(productId);
    var materialCost = comps.filter(function (c) { return c.LineType !== 'MoneyCost'; }).reduce(function (s, c) { return s + bomLineAmount_(c); }, 0);
    var moneyCost = comps.filter(function (c) { return c.LineType === 'MoneyCost'; }).reduce(function (s, c) { return s + bomLineAmount_(c); }, 0);
    return ok_({
      product: p,
      components: comps,
      materialComponents: comps.filter(function (c) { return c.LineType === 'Material'; }),
      moneyCosts: comps.filter(function (c) { return c.LineType === 'MoneyCost'; }),
      unitCost: materialCost + moneyCost,
      materialCost: materialCost,
      moneyCost: moneyCost
    });
  } catch (e) { return err_(e.message); }
}

/* Tổng quan định mức: mọi thành phẩm đang có BOM */
function getBOMSummary() {
  try {
    var pMap = {}; sheetToObjects_('Products').forEach(function (p) { pMap[p.ProductID] = p; });
    var byProd = {};
    sheetToObjects_('BOM').forEach(function (b) {
      var pp = pMap[b.ProductID] || {};
      var m = byProd[b.ProductID] || { ProductID: b.ProductID, ProductName: b.ProductName || pp.ProductName || b.ProductID, SKU: pp.SKU || '', Unit: pp.Unit || '', components: 0, materialLines: 0, moneyCostLines: 0, materialCost: 0, moneyCost: 0, unitCost: 0, CurrentStock: toNumber(pp.CurrentStock), SalePrice: toNumber(pp.SalePrice) };
      var c = pMap[b.ComponentID] || {};
      var lt = normalizeBOMLineType_(b);
      var amount = lt === 'MoneyCost' ? (toNumber(b.Amount) || (toNumber(b.Quantity || 1) * toNumber(b.UnitCost))) : (toNumber(b.Amount) || (toNumber(b.Quantity) * (toNumber(b.UnitCost) || toNumber(c.CostPrice))));
      m.components++;
      if (lt === 'MoneyCost') { m.moneyCostLines++; m.moneyCost += amount; }
      else { m.materialLines++; m.materialCost += amount; }
      m.unitCost = m.materialCost + m.moneyCost;
      byProd[b.ProductID] = m;
    });
    return ok_(Object.keys(byProd).map(function (k) { return byProd[k]; }));
  } catch (e) { return err_(e.message); }
}

/* Lưu định mức cho 1 thành phẩm (thay toàn bộ dòng cũ) */
function saveProductBOM(data) {
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked', ['BOM', 'Products'], function () { return saveProductBOM(data); });
  try {
    var productId = data.ProductID; if (!productId) return err_('Thiếu thành phẩm');
    var prod = sheetToObjects_('Products').filter(function (p) { return p.ProductID === productId; })[0];
    if (!prod) return err_('Không tìm thấy thành phẩm');
    // Dịch vụ không có tồn kho -> không thể là thành phẩm sản xuất.
    if (isServiceProduct_(prod)) return err_('"' + prod.ProductName + '" là Dịch vụ (không tồn kho) nên không thể làm thành phẩm sản xuất.');
    var pMap = {}; sheetToObjects_('Products').forEach(function (p) { pMap[p.ProductID] = p; });
    // ...và cũng không thể làm nguyên vật liệu.
    var svcComp = (data.components || []).filter(function (c) { return normalizeBOMLineType_(c) !== 'MoneyCost' && c.ComponentID && isServiceProduct_(pMap[c.ComponentID] || {}); })[0];
    if (svcComp) return err_('"' + ((pMap[svcComp.ComponentID] || {}).ProductName || svcComp.ComponentID) + '" là Dịch vụ nên không thể dùng làm nguyên vật liệu trong định mức.');
    sheetToObjects_('BOM').filter(function (b) { return b.ProductID === productId; }).forEach(function (b) { deleteRowById('BOM', 'BOMItemID', b.BOMItemID); });
    var comps = (data.components || []).filter(function (c) {
      var lt = normalizeBOMLineType_(c);
      if (lt === 'MoneyCost') return String(c.CostName || '').trim() && (toNumber(c.Amount) > 0 || toNumber(c.Quantity) * toNumber(c.UnitCost) > 0);
      return c.ComponentID && toNumber(c.Quantity) > 0 && c.ComponentID !== productId;
    });
    var ids = generateIds('BOM', comps.length);
    var rows = comps.map(function (c, i) {
      var lt = normalizeBOMLineType_(c);
      if (lt === 'MoneyCost') {
        var mQty = toNumber(c.Quantity) || 1;
        var mUnitCost = toNumber(c.UnitCost);
        var mAmount = toNumber(c.Amount) || (mQty * mUnitCost);
        return { BOMItemID: ids[i], ProductID: productId, ProductName: prod.ProductName, ComponentID: '', ComponentName: '', ComponentSKU: '', Quantity: mQty, Unit: '', CreatedAt: new Date(), LineType: 'MoneyCost', CostGroup: c.CostGroup || 'Khác', CostName: String(c.CostName || '').trim(), UnitCost: mUnitCost || mAmount, Amount: mAmount, Notes: c.Notes || '' };
      }
      var cp = pMap[c.ComponentID] || {};
      var qty = toNumber(c.Quantity);
      var unitCost = toNumber(c.UnitCost) || toNumber(cp.CostPrice);
      return { BOMItemID: ids[i], ProductID: productId, ProductName: prod.ProductName, ComponentID: c.ComponentID, ComponentName: cp.ProductName || c.ComponentID, ComponentSKU: cp.SKU || '', Quantity: qty, Unit: cp.Unit || '', CreatedAt: new Date(), LineType: 'Material', CostGroup: 'NVL', CostName: '', UnitCost: unitCost, Amount: qty * unitCost, Notes: c.Notes || '', CriticalLevel: materialCritical_(c.CriticalLevel), SourceType: c.SourceType || '', PreferredSupplierID: c.PreferredSupplierID || '', LeadTimeDays: Math.max(0, toNumber(c.LeadTimeDays)), RequiredDate: c.RequiredDate || '', Revision: c.Revision || '' };
    });
    appendRows('BOM', rows);
    writeAudit_('Lưu định mức', 'BOM', productId, prod.ProductName + ' · ' + rows.length + ' NVL');
    return ok_({ ProductID: productId, count: rows.length }, 'Đã lưu định mức cho ' + prod.ProductName + ' (' + rows.length + ' NVL)');
  } catch (e) { return err_(e.message); }
}

function deleteProductBOM(productId, __locked) {
  if (!__locked) return withMutationLock_(['BOM', 'ProductionOrders'], function () { return deleteProductBOM(productId, true); });
  try {
    if (!productId) return err_('Thieu thanh pham');
    var active = sheetToObjects_('ProductionOrders').filter(function (o) {
      return o.ProductID === productId && normalizeStatus_(o.Status, '') === 'Đang sản xuất';
    });
    if (active.length) return err_('Khong the xoa dinh muc vi dang co ' + active.length + ' lenh san xuat dang chay: ' + active.map(function (o) { return o.ProductionID; }).join(', '));
    sheetToObjects_('BOM').filter(function (b) { return b.ProductID === productId; }).forEach(function (b) { deleteRowById('BOM', 'BOMItemID', b.BOMItemID); });
    return ok_(null, 'Đã xóa định mức');
  } catch (e) { return err_(e.message); }
}

function getProductionSummary() {
  try {
    ensureProductionWorkflowSchema_();
    var orders = sheetToObjects_('ProductionOrders');
    var machineMap={};sheetToObjects_('Machines').forEach(function(m){machineMap[m.MachineID]=m;});
    orders=orders.map(function(o){var m=machineMap[o.MachineID]||{};return Object.assign({},o,{MachineCode:m.MachineCode||'',MachineName:m.MachineName||''});});
    var done = orders.filter(function (o) { return o.Status === 'Hoàn thành'; });
    var running = orders.filter(function (o) { return o.Status === 'Đang sản xuất'; });
    var planned = orders.filter(function (o) { return o.Status === 'Đã lên lệnh'; });
    var producedQty = done.reduce(function (s, o) { return s + toNumber(o.ActualQuantity || o.Quantity); }, 0);
    var materialCost = done.reduce(function (s, o) { return s + toNumber(o.ActualMaterialCost || o.MaterialCost); }, 0);
    
    // Data cho biểu đồ phân tích hao hụt
    var chartLabels = [], chartExpected = [], chartActual = [];
    done.slice(-15).forEach(function(o) {
      chartLabels.push(o.ProductionID);
      chartExpected.push(toNumber(o.MaterialCost));
      chartActual.push(toNumber(o.ActualMaterialCost) + toNumber(o.MoneyCostTotal) + toNumber(o.LaborCost) + toNumber(o.OverheadCost));
    });

    return ok_({
      total: orders.length,
      done: done.length,
      running: running.length,
      planned: planned.length,
      producedQty: producedQty,
      materialCost: materialCost,
      orders: orders,
      chart: { labels: chartLabels, expected: chartExpected, actual: chartActual }
    });
  } catch (e) { return err_(e.message); }
}

function getProductionDetail(id) {
  return cachedPayload_('proddetail:' + id, function () { return build_getProductionDetail(id); });
}
