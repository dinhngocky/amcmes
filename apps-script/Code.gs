/* ---------------------------------------------------------------------------
 * Tìm hoặc tạo vật tư theo mã hàng — dùng khi nhập Excel không khớp ProductID
 * -------------------------------------------------------------------------*/
function ensureProductByPartNumber_(partNumber, hint) {
  partNumber = String(partNumber || '').trim();
  if (!partNumber) return null;
  hint = hint || {};

  // Tìm theo PartNumber trước
  var hit = sheetToObjects_('Products').filter(function (p) {
    return String(p.PartNumber || '').trim().toLowerCase() === partNumber.toLowerCase();
  })[0];
  if (hit) return hit;

  // Không có → tạo mới từ hint
  var create = createProductQuick({
    ProductName:   hint.ProductName || partNumber,
    PartNumber:    partNumber,
    BrandMaterial: hint.BrandMaterial || 'Chưa xác định',
    Category:      hint.Category || '',
    Unit:          hint.Unit || 'cái',
    CostPrice:     toNumber(hint.UnitCost),
    SalePrice:     0,
    SKU:           hint.SKU || ''
  });
  if (create && create.success && create.data) return create.data;
  return null;
}

/* ---------------------------------------------------------------------------
 * API: Danh sách lô hàng TQ
 * -------------------------------------------------------------------------*/
function getChinaShipments(filters) {
  try {
    filters = filters || {};
    var rows = sheetToObjects_('ChinaShipments').slice();

    if (filters.status) {
      rows = rows.filter(function (x) {
        return String(x.Status || '') === String(filters.status);
      });
    }
    if (filters.purchaseId) {
      var pid = String(filters.purchaseId).toLowerCase();
      rows = rows.filter(function (x) {
        return String(x.PurchaseID || '').toLowerCase().indexOf(pid) >= 0;
      });
    }
    if (filters.projectCode) {
      var pc = String(filters.projectCode).toLowerCase();
      rows = rows.filter(function (x) {
        return String(x.ProjectCode || '').toLowerCase().indexOf(pc) >= 0;
      });
    }
    if (filters.search) {
      var q = String(filters.search).toLowerCase();
      rows = rows.filter(function (x) {
        var hay = [x.ShipmentCode, x.PurchaseID, x.ProjectCode, x.SupplierName,
                   x.TrackingNo, x.ContainerNo, x.Notes].join(' ').toLowerCase();
        return hay.indexOf(q) >= 0;
      });
    }

    rows.sort(function (a, b) {
      return new Date(b.CreatedAt || 0).getTime() - new Date(a.CreatedAt || 0).getTime();
    });
    return ok_(rows);
  } catch (e) { return err_(e.message); }
}

function getChinaShipmentDetail(shipmentId) {
  try {
    var h = amcvnFind_('ChinaShipments', 'ShipmentID', shipmentId);
    if (!h) return err_('Không tìm thấy lô hàng.');
    var items = sheetToObjects_('ChinaShipmentItems')
      .filter(function (x) { return String(x.ShipmentID) === String(shipmentId); })
      .sort(function (a, b) { return toNumber(a.LineNo) - toNumber(b.LineNo); });
    return ok_({ shipment: h, items: items });
  } catch (e) { return err_(e.message); }
}

/* ---------------------------------------------------------------------------
 * API: Tạo lô hàng TQ mới (nhập tay hoặc từ Excel)
 * data: {
 *   ClientRef,
 *   PurchaseID, ProjectCode, SupplierName,
 *   TrackingNo, ContainerNo,
 *   ShipDate, ETA, WarehouseID,
 *   Notes,
 *   items: [{
 *     PartNumber, ProductName, BrandMaterial, Unit,
 *     SentQty, UnitCost, ImageUrl, Notes
 *   }]
 * }
 * -------------------------------------------------------------------------*/
function createChinaShipment(data) {
  data = data || {};
  if (!data.__locked) {
    return runLocked_(data, '__locked',
      ['ChinaShipments', 'ChinaShipmentItems', 'Products'],
      function () { return createChinaShipment(data); });
  }
  try {
    // Chống trùng
    if (data.ClientRef) {
      var dup = sheetToObjects_('ChinaShipments').filter(function (x) {
        return String(x.ClientRef) === String(data.ClientRef);
      })[0];
      if (dup) return ok_(dup, 'Lô hàng ' + dup.ShipmentCode + ' đã được tạo trước đó');
    }

    var items = (data.items || []).filter(function (x) {
      return x && String(x.PartNumber || '').trim() && toNumber(x.SentQty) > 0;
    });
    if (!items.length) {
      return err_('Lô hàng phải có ít nhất 1 dòng có mã hàng và SL gửi > 0.');
    }

    // ProjectID nội bộ: match theo ProjectCode nếu có
    var projectId = '';
    var projectCode = String(data.ProjectCode || '').trim();
    if (projectCode) {
      var proj = sheetToObjects_('Projects').filter(function (p) {
        return String(p.ProjectCode || '').trim().toLowerCase() === projectCode.toLowerCase();
      })[0];
      if (proj) projectId = proj.ProjectID;
    }

    // Kho nhận
    var wh = null;
    if (data.WarehouseID) wh = whById_(data.WarehouseID);
    if (!wh) wh = whDefault_();

    var shipmentId = generateId('CNS');
    var now = new Date();

    // Số lô hiển thị: CN-yyMM-<số>
    var monthCode = Utilities.formatDate(now, getTz_(), 'yyMM');
    var seq = sheetToObjects_('ChinaShipments').filter(function (x) {
      return String(x.ShipmentCode || '').indexOf('CN-' + monthCode + '-') === 0;
    }).length + 1;
    var shipmentCode = 'CN-' + monthCode + '-' + ('000' + seq).slice(-4);

    // Tổng hợp
    var totalSent = 0, totalValue = 0;
    items.forEach(function (it) {
      totalSent += toNumber(it.SentQty);
      totalValue += toNumber(it.SentQty) * toNumber(it.UnitCost);
    });

    appendRow('ChinaShipments', {
      ShipmentID: shipmentId,
      ShipmentCode: shipmentCode,
      PurchaseID: String(data.PurchaseID || '').trim(),
      ProjectCode: projectCode,
      ProjectID: projectId,
      SupplierName: String(data.SupplierName || '').trim(),
      TrackingNo: String(data.TrackingNo || '').trim(),
      ContainerNo: String(data.ContainerNo || '').trim(),
      ShipDate: data.ShipDate ? docDate_(data.ShipDate) : '',
      ETA: data.ETA ? docDate_(data.ETA) : '',
      ActualArrivalDate: '',
      WarehouseID: wh.WarehouseID,
      WarehouseName: wh.WarehouseName,
      TotalLines: items.length,
      TotalSentQty: totalSent,
      TotalReceivedQty: 0,
      TotalDiffQty: 0,
      TotalDiffValue: 0,
      Status: 'PENDING',
      ReceivedBy: '',
      ReceivedAt: '',
      Notes: String(data.Notes || '').trim(),
      CreatedBy: getUser_(),
      CreatedAt: now,
      UpdatedAt: now,
      ClientRef: data.ClientRef || ''
    });

    // Dòng hàng — không tạo vật tư mới vội, chỉ match để điền ProductID nếu có
    var itemIds = generateIds('CNSI', items.length);
    var itemRows = items.map(function (it, i) {
      var partNo = String(it.PartNumber || '').trim();
      var prod = sheetToObjects_('Products').filter(function (p) {
        return String(p.PartNumber || '').trim().toLowerCase() === partNo.toLowerCase();
      })[0];
      return {
        ShipmentItemID: itemIds[i],
        ShipmentID: shipmentId,
        LineNo: i + 1,
        PartNumber: partNo,
        SKU: prod ? (prod.SKU || '') : String(it.SKU || '').trim(),
        ProductID: prod ? prod.ProductID : '',
        ProductName: String(it.ProductName || '').trim() || (prod ? prod.ProductName : ''),
        BrandMaterial: String(it.BrandMaterial || '').trim() || (prod ? prod.BrandMaterial : ''),
        Unit: String(it.Unit || '').trim() || (prod ? prod.Unit : 'cái'),
        SentQty: toNumber(it.SentQty),
        ReceivedQty: '',
        DiffQty: '',
        UnitCost: toNumber(it.UnitCost),
        LocationCode: '',
        LotNo: '',
        ImageUrl: String(it.ImageUrl || '').trim(),
        Notes: String(it.Notes || '').trim(),
        CreatedAt: now,
        UpdatedAt: now
      };
    });
    appendRows('ChinaShipmentItems', itemRows);

    writeAudit_('Tạo lô hàng TQ', 'ChinaShipment', shipmentId,
      shipmentCode + ' · PO ' + data.PurchaseID + ' · ' + items.length + ' dòng');

    return ok_({
      ShipmentID: shipmentId,
      ShipmentCode: shipmentCode,
      TotalLines: items.length,
      TotalSentQty: totalSent
    }, 'Đã tạo lô hàng ' + shipmentCode);
  } catch (e) { return err_(e.message); }
}

/* ---------------------------------------------------------------------------
 * API: Cập nhật thông tin lô (trước khi nhận)
 * -------------------------------------------------------------------------*/
function updateChinaShipment(shipmentId, data) {
  data = data || {};
  if (!data.__locked) {
    return runLocked_(data, '__locked',
      ['ChinaShipments'],
      function () { return updateChinaShipment(shipmentId, data); });
  }
  try {
    var h = amcvnFind_('ChinaShipments', 'ShipmentID', shipmentId);
    if (!h) return err_('Không tìm thấy lô hàng.');
    if (String(h.Status) === 'RECEIVED') {
      return err_('Lô hàng đã nhận, không sửa được thông tin đầu.');
    }

    var upd = {};
    ['PurchaseID', 'ProjectCode', 'SupplierName', 'TrackingNo', 'ContainerNo', 'Notes'].forEach(function (k) {
      if (data[k] !== undefined) upd[k] = String(data[k] || '').trim();
    });
    if (data.ShipDate !== undefined) upd.ShipDate = data.ShipDate ? docDate_(data.ShipDate) : '';
    if (data.ETA !== undefined) upd.ETA = data.ETA ? docDate_(data.ETA) : '';
    if (data.WarehouseID !== undefined) {
      var wh = whById_(data.WarehouseID) || whDefault_();
      upd.WarehouseID = wh.WarehouseID;
      upd.WarehouseName = wh.WarehouseName;
    }
    if (data.ProjectCode !== undefined) {
      var proj = sheetToObjects_('Projects').filter(function (p) {
        return String(p.ProjectCode || '').trim().toLowerCase() === String(data.ProjectCode || '').trim().toLowerCase();
      })[0];
      upd.ProjectID = proj ? proj.ProjectID : '';
    }
    upd.UpdatedAt = new Date();
    updateRowById('ChinaShipments', 'ShipmentID', shipmentId, upd);
    return ok_(null, 'Đã cập nhật lô hàng');
  } catch (e) { return err_(e.message); }
}

/* ---------------------------------------------------------------------------
 * API: Cập nhật SL thực nhận cho từng dòng — gọi khi kiểm hàng
 * items: [{ ShipmentItemID, ReceivedQty, LocationCode, LotNo, UnitCost, Notes }]
 * -------------------------------------------------------------------------*/
/**
 * Nhận hàng TQ — HÀNG VÀO TRẠNG THÁI CHỜ IQC, CHƯA VÀO TỒN KHO.
 * Tồn kho chỉ tăng sau khi IQC xác nhận đạt (xem confirmChinaShipmentIQC).
 */
function receiveChinaShipment(shipmentId, data) {
  data = data || {};
  if (!data.__locked) {
    return runLocked_(data, '__locked',
      ['ChinaShipments', 'ChinaShipmentItems', 'Products', 'StockMovements'],
      function () { return receiveChinaShipment(shipmentId, data); });
  }
  try {
    var h = amcvnFind_('ChinaShipments', 'ShipmentID', shipmentId);
    if (!h) return err_('Không tìm thấy lô hàng.');
    if (['RECEIVED', 'DIFF', 'RECEIVING'].indexOf(String(h.Status)) >= 0) {
      return err_('Lô hàng đã nhận hoặc đang chờ IQC. Hãy hủy nhận trước nếu muốn sửa.');
    }

    var items = data.items || [];
    if (!items.length) return err_('Chưa có dòng nào để nhận.');

    var itemMap = {};
    sheetToObjects_('ChinaShipmentItems')
      .filter(function (x) { return String(x.ShipmentID) === String(shipmentId); })
      .forEach(function (x) { itemMap[String(x.ShipmentItemID)] = x; });

    var now = new Date();
    var wh = whById_(h.WarehouseID) || whDefault_();
    var totalReceived = 0, totalDiffValue = 0;
    var stockMovements = [];
    var newProductsCreated = [];

    items.forEach(function (it) {
      var row = itemMap[String(it.ShipmentItemID)];
      if (!row) return;

      var sent = toNumber(row.SentQty);
      var received = toNumber(it.ReceivedQty);
      if (!isFinite(received) || received < 0) received = 0;
      var diff = received - sent;

      var productId = row.ProductID;
      var sku = row.SKU;
      var unitCost = toNumber(it.UnitCost !== undefined ? it.UnitCost : row.UnitCost);
      if (!productId) {
        var created = ensureProductByPartNumber_(row.PartNumber, {
          ProductName: row.ProductName,
          BrandMaterial: row.BrandMaterial,
          Unit: row.Unit,
          UnitCost: unitCost,
          SKU: sku
        });
        if (created) {
          productId = created.ProductID;
          sku = created.SKU;
          newProductsCreated.push(created.ProductName);
        }
      }

      updateRowById('ChinaShipmentItems', 'ShipmentItemID', row.ShipmentItemID, {
        ProductID: productId || '',
        SKU: sku || '',
        ReceivedQty: received,
        DiffQty: diff,
        UnitCost: unitCost,
        LocationCode: String(it.LocationCode || row.LocationCode || '').trim(),
        LotNo: String(it.LotNo || row.LotNo || '').trim(),
        Notes: it.Notes !== undefined ? String(it.Notes || '').trim() : row.Notes,
        UpdatedAt: now
      });

      totalReceived += received;
      totalDiffValue += diff * unitCost;

      // Sinh StockMovements với Status='Chờ IQC' — CHƯA vào tồn
      if (received > 0 && productId) {
        stockMovements.push({
          MovementID: '',
          Date: now,
          Type: 'ManualIn',
          SourceType: 'ChinaShipment',
          SourceID: shipmentId,
          ProductID: productId,
          SKU: sku || '',
          ProductName: row.ProductName,
          QuantityIn: received,
          QuantityOut: 0,
          UnitCost: unitCost,
          UnitPrice: '',
          StockAfter: '',
          CreatedBy: getUser_(),
          Notes: 'Nhập hàng TQ · lô ' + h.ShipmentCode + ' · CHỜ IQC' + (h.PurchaseID ? ' · PO ' + h.PurchaseID : ''),
          CreatedAt: now,
          Status: 'Chờ IQC',
          WarehouseID: wh.WarehouseID,
          WarehouseName: wh.WarehouseName
        });
      }
    });

    if (stockMovements.length) {
      var mids = generateIds('MV', stockMovements.length);
      stockMovements.forEach(function (m, i) { m.MovementID = mids[i]; });
      appendRows('StockMovements', stockMovements);
      // KHÔNG gọi recalculateProductStocks_ — vì Status='Chờ IQC' không tính vào tồn
    }

    var totalSent = toNumber(h.TotalSentQty);
    var diffTotal = totalReceived - totalSent;
    updateRowById('ChinaShipments', 'ShipmentID', shipmentId, {
      TotalReceivedQty: totalReceived,
      TotalDiffQty: diffTotal,
      TotalDiffValue: Math.round(totalDiffValue),
      Status: 'RECEIVING',
      ActualArrivalDate: now,
      ReceivedBy: getUser_(),
      ReceivedAt: now,
      UpdatedAt: now
    });

    writeAudit_('Nhận hàng TQ', 'ChinaShipment', shipmentId,
      h.ShipmentCode + ' · gửi ' + totalSent + ' · nhận ' + totalReceived + ' · CHỜ IQC');

    return ok_({
      ShipmentID: shipmentId,
      TotalSentQty: totalSent,
      TotalReceivedQty: totalReceived,
      TotalDiffQty: diffTotal,
      TotalDiffValue: Math.round(totalDiffValue),
      Status: 'RECEIVING',
      NewProductsCreated: newProductsCreated.length,
      PendingIQC: stockMovements.length
    }, 'Đã nhận hàng. Vật tư đang CHỜ IQC — kiểm tra chất lượng trước khi vào kho.');
  } catch (e) { return err_(e.message); }
}

/* ---------------------------------------------------------------------------
 * API: Hủy nhận hàng TQ — hoàn lại tồn kho, mở khóa để sửa
 * -------------------------------------------------------------------------*/
/**
 * Hủy nhận hàng TQ — hoàn lại tồn kho, mở khóa lô để sửa và nhận lại.
 * Xử lý được cả 2 trạng thái: RECEIVING (chờ IQC) và RECEIVED/DIFF (đã IQC).
 */
function cancelChinaShipmentReceipt(shipmentId) {
  return withMutationLock_(
    ['ChinaShipments', 'ChinaShipmentItems', 'StockMovements', 'MaterialLocations', 'Products'],
    function () {
      try {
        var h = amcvnFind_('ChinaShipments', 'ShipmentID', shipmentId);
        if (!h) return err_('Không tìm thấy lô hàng.');
        if (['RECEIVED', 'DIFF', 'RECEIVING'].indexOf(String(h.Status)) < 0) {
          return err_('Lô hàng chưa nhận hoặc đã hủy.');
        }

        var moves = sheetToObjects_('StockMovements').filter(function (m) {
          return String(m.SourceType) === 'ChinaShipment'
            && String(m.SourceID) === String(shipmentId);
        });
        var affected = {};
        moves.forEach(function (m) {
          affected[m.ProductID] = true;
          deleteRowById('StockMovements', 'MovementID', m.MovementID);
        });
        recalculateProductStocks_(Object.keys(affected));

        var now = new Date();
        var items = sheetToObjects_('ChinaShipmentItems').filter(function (x) {
          return String(x.ShipmentID) === String(shipmentId);
        });
        items.forEach(function (x) {
          updateRowById('ChinaShipmentItems', 'ShipmentItemID', x.ShipmentItemID, {
            ReceivedQty: '',
            DiffQty: '',
            AcceptedQty: '',
            RejectedQty: '',
            IQCStatus: '',
            LocationCode: '',
            NCRNo: '',
            UpdatedAt: now
          });
        });

        updateRowById('ChinaShipments', 'ShipmentID', shipmentId, {
          TotalReceivedQty: 0,
          TotalDiffQty: 0,
          TotalDiffValue: 0,
          Status: 'PENDING',
          ActualArrivalDate: '',
          ReceivedBy: '',
          ReceivedAt: '',
          IQCCompletedAt: '',
          IQCCompletedBy: '',
          UpdatedAt: now
        });

        writeAudit_('Hủy nhận hàng TQ', 'ChinaShipment', shipmentId, h.ShipmentCode);
        return ok_(null, 'Đã hủy nhận hàng, lô về trạng thái chờ nhận.');
      } catch (e) { return err_(e.message); }
    });
}

/* ---------------------------------------------------------------------------
 * API: Xóa lô hàng TQ (chỉ khi chưa nhận)
 * -------------------------------------------------------------------------*/
function deleteChinaShipment(shipmentId) {
  return withMutationLock_(
    ['ChinaShipments', 'ChinaShipmentItems'],
    function () {
      try {
        var h = amcvnFind_('ChinaShipments', 'ShipmentID', shipmentId);
        if (!h) return err_('Không tìm thấy lô hàng.');
        if (String(h.Status) === 'RECEIVED' || String(h.Status) === 'DIFF') {
          return err_('Lô đã nhận hàng, hãy hủy nhận trước khi xóa.');
        }
        var items = sheetToObjects_('ChinaShipmentItems').filter(function (x) {
          return String(x.ShipmentID) === String(shipmentId);
        });
        if (items.length) {
          deleteRowsByIds_('ChinaShipmentItems', 'ShipmentItemID', items.map(function (i) { return i.ShipmentItemID; }));
        }
        deleteRowById('ChinaShipments', 'ShipmentID', shipmentId);
        writeAudit_('Xóa lô hàng TQ', 'ChinaShipment', shipmentId, h.ShipmentCode);
        return ok_(null, 'Đã xóa lô hàng ' + h.ShipmentCode);
      } catch (e) { return err_(e.message); }
    });
}

/* ---------------------------------------------------------------------------
 * API: Báo cáo nhanh nhận hàng TQ theo lô
 * -------------------------------------------------------------------------*/
function getChinaShipmentReport(shipmentId) {
  try {
    var h = amcvnFind_('ChinaShipments', 'ShipmentID', shipmentId);
    if (!h) return err_('Không tìm thấy lô hàng.');
    var items = sheetToObjects_('ChinaShipmentItems')
      .filter(function (x) { return String(x.ShipmentID) === String(shipmentId); })
      .sort(function (a, b) { return toNumber(a.LineNo) - toNumber(b.LineNo); });

    var summary = {
      totalLines: items.length,
      totalSent: 0,
      totalReceived: 0,
      totalDiff: 0,
      diffValue: 0,
      matchedLines: 0,
      shortLines: 0,
      overLines: 0,
      pendingLines: 0
    };
    items.forEach(function (x) {
      var sent = toNumber(x.SentQty);
      var received = toNumber(x.ReceivedQty);
      var diff = toNumber(x.DiffQty);
      summary.totalSent += sent;
      summary.totalReceived += received;
      summary.totalDiff += diff;
      summary.diffValue += diff * toNumber(x.UnitCost);
      if (x.ReceivedQty === '' || x.ReceivedQty === null) summary.pendingLines++;
      else if (Math.abs(diff) < 0.0001) summary.matchedLines++;
      else if (diff < 0) summary.shortLines++;
      else summary.overLines++;
    });
    summary.diffValue = Math.round(summary.diffValue);

    return ok_({ shipment: h, items: items, summary: summary });
  } catch (e) { return err_(e.message); }
}

/**
 * Preview packing list đã được frontend map cột.
 * data: {
 *   rawHeaders: [...],      // tên cột gốc trong file (để hiển thị lại)
 *   mapping: { key: colIdx },  // { PartNumber: 0, ProductName: 1, ... }
 *   rows: [...],            // mảng object đã map theo key nội bộ
 *   totalRows: N            // tổng số dòng file (trước khi lọc)
 * }
 * Trả về: preview + summary + cảnh báo.
 */
function previewChinaPackingList(data) {
  try {
    data = data || {};
    var rows = data.rows || [];
    if (!rows.length) return err_('Không có dòng nào để kiểm tra.');

    // Bản đồ Product để match theo PartNumber
    var pmap = {};
    sheetToObjects_('Products').forEach(function (p) {
      var key = String(p.PartNumber || '').trim().toLowerCase();
      if (key && !pmap[key]) pmap[key] = p;
    });

    var out = [];
    var knownCount = 0, newCount = 0, badCount = 0;
    var totalSentQty = 0;

    rows.forEach(function (r, i) {
      var partNo = String(r.PartNumber || '').trim();
      var productName = String(r.ProductName || '').trim();
      var qty = toNumber(r.SentQty);
      var unit = String(r.Unit || '').trim() || 'cái';
      var brand = String(r.BrandMaterial || '').trim();
      var unitCost = toNumber(r.UnitCost);

      if (!partNo || !productName) {
        badCount++;
        out.push({
          _lineNo: i + 1,
          _status: 'INVALID',
          _reason: 'Thiếu Mã hàng hoặc Tên hàng',
          PartNumber: partNo, ProductName: productName,
          SentQty: qty, Unit: unit
        });
        return;
      }
      if (!isFinite(qty) || qty <= 0) {
        badCount++;
        out.push({
          _lineNo: i + 1,
          _status: 'INVALID',
          _reason: 'SL gửi không hợp lệ (phải > 0)',
          PartNumber: partNo, ProductName: productName,
          SentQty: qty, Unit: unit
        });
        return;
      }

      totalSentQty += qty;
      var hit = pmap[partNo.toLowerCase()];
      if (hit) knownCount++;
      else newCount++;

      out.push({
        _lineNo: i + 1,
        _status: hit ? 'EXISTS' : 'NEW',
        _reason: hit ? 'Đã có trong danh mục' : 'Sẽ tạo vật tư mới khi nhận',
        PartNumber: partNo,
        SKU: String(r.SKU || '').trim() || (hit ? (hit.SKU || '') : ''),
        ProductID: hit ? hit.ProductID : '',
        ProductName: productName,
        BrandMaterial: brand || (hit ? hit.BrandMaterial : ''),
        Category: String(r.Category || '').trim() || (hit ? (hit.Category || '') : ''),
        Unit: unit,
        SentQty: qty,
        UnitCost: unitCost,
        TechnicalSpecifications: String(r.TechnicalSpecifications || '').trim(),
        FAIRequired: productBool_(r.FAIRequired),
        ProjectCode: String(r.ProjectCode || '').trim(),
        MachineCode: String(r.MachineCode || '').trim(),
        MachineName: String(r.MachineName || '').trim(),
        ModuleCode: String(r.ModuleCode || '').trim(),
        ModuleName: String(r.ModuleName || '').trim(),
        LocationCode: String(r.LocationCode || '').trim(),
        LotNo: String(r.LotNo || '').trim(),
        SupplierName: String(r.SupplierName || '').trim(),
        InvoiceNo: String(r.InvoiceNo || '').trim(),
        InvoiceDate: String(r.InvoiceDate || '').trim(),
        ImageUrl: String(r.ImageUrl || '').trim(),
        Notes: String(r.Notes || '').trim()
      });
    });

    return ok_({
      rows: out,
      summary: {
        total: rows.length,
        valid: rows.length - badCount,
        known: knownCount,
        newProducts: newCount,
        invalid: badCount,
        totalSentQty: totalSentQty
      },
      meta: {
        rawHeaders: data.rawHeaders || [],
        mapping: data.mapping || {},
        totalRowsInFile: data.totalRows || rows.length
      }
    });
  } catch (e) { return err_(e.message); }
}

