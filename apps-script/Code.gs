    ScriptApp.newTrigger('sendDailyReminders').timeBased().everyDays(1).atHour(hour).create();
    updateSetting('ReminderEnabled', 'true'); updateSetting('ReminderHour', String(hour));
    if (ownerEmail !== undefined) updateSetting('OwnerEmail', ownerEmail);
    if (remindCustomers !== undefined) updateSetting('RemindCustomers', remindCustomers ? 'true' : 'false');
    return ok_({ active: true, hour: hour }, 'Đã bật nhắc nợ tự động lúc ' + hour + 'h hằng ngày');
  } catch (e) { return err_(e.message); }
}
function disableReminderSchedule_() { ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'sendDailyReminders') ScriptApp.deleteTrigger(t); }); }
function disableReminderSchedule() {
  try { disableReminderSchedule_(); updateSetting('ReminderEnabled', 'false'); return ok_({ active: false }, 'Đã tắt nhắc nợ tự động'); }
  catch (e) { return err_(e.message); }
}
function saveReminderSettings(enabled, hour, ownerEmail, remindCustomers, customerIntervalDays) {
  try {
    hour = Math.max(0, Math.min(23, toNumber(hour) || 8));
    customerIntervalDays = Math.max(1, toNumber(customerIntervalDays || 7) || 7);
    updateSetting('ReminderHour', String(hour));
    updateSetting('OwnerEmail', ownerEmail || '');
    updateSetting('RemindCustomers', remindCustomers ? 'true' : 'false');
    updateSetting('CustomerReminderIntervalDays', String(customerIntervalDays));
    if (enabled) {
      disableReminderSchedule_();
      ScriptApp.newTrigger('sendDailyReminders').timeBased().everyDays(1).atHour(hour).create();
      updateSetting('ReminderEnabled', 'true');
      return ok_({ active: true, hour: hour, ownerEmail: ownerEmail || '', remindCustomers: !!remindCustomers, customerIntervalDays: customerIntervalDays }, 'Đã lưu và bật lịch nhắc nợ');
    }
