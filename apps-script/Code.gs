function runReminders_(options) {
  options = options || {};
  var st = settings_();
  var owner = st.OwnerEmail || getUser_();
  var business = st.BusinessName || 'AMCVN';
  var remindCustomers = String(st.RemindCustomers) === 'true';
  var today = new Date(); today.setHours(0, 0, 0, 0);
  var custMap = {}; sheetToObjects_('Customers').forEach(function (c) { custMap[c.CustomerID] = c; });
  var overdue = sheetToObjects_('SalesOrders').filter(function (s) { return toNumber(s.ReceivableAmount) > 0 && s.DueDate && new Date(s.DueDate) < today; });
  var soon = new Date(today); soon.setDate(soon.getDate() + 7);
  var payablesDue = sheetToObjects_('PurchaseOrders').filter(function (p) { return toNumber(p.PayableAmount) > 0 && p.DueDate && new Date(p.DueDate) <= soon; });
  var cf = getCashFlowForecast().data || {};

  var customerEmailsSent = 0;
  if (remindCustomers && !options.skipCustomerEmails) {
    var interval = Math.max(1, toNumber(st.CustomerReminderIntervalDays || 7) || 7);
    var props = PropertiesService.getScriptProperties();
    var todayText = Utilities.formatDate(new Date(), getTz_(), 'yyyy-MM-dd');
    var byCust = {}; overdue.forEach(function (s) { (byCust[s.CustomerID] = byCust[s.CustomerID] || []).push(s); });
    Object.keys(byCust).forEach(function (cid) {
      var c = custMap[cid]; if (!c || !c.Email) return;
      var lastSent = props.getProperty('DebtReminderLastSent_' + cid) || '';
      if (daysSince_(lastSent) < interval) return;
      var list = byCust[cid];
      var email = buildCustomerDebtReminderEmail_(business, c, list, st);
      try {
        MailApp.sendEmail({ to: c.Email, subject: email.subject, htmlBody: email.html });
        props.setProperty('DebtReminderLastSent_' + cid, todayText);
        customerEmailsSent++;
      } catch (e) { console.warn('[runReminders_]', (e && e.message) || String(e));  }
    });
  }

  // Bản tin cho chủ doanh nghiệp
  var ovTotal = overdue.reduce(function (a, s) { return a + toNumber(s.ReceivableAmount); }, 0);
  var ovRows = overdue.slice(0, 30).map(function (s) { return '<tr><td style="padding:5px 9px;border:1px solid #eee">' + s.SalesID + '</td><td style="padding:5px 9px;border:1px solid #eee">' + s.CustomerName + '</td><td style="padding:5px 9px;border:1px solid #eee">' + formatDate(s.DueDate) + '</td><td style="padding:5px 9px;border:1px solid #eee;text-align:right;color:#b91c1c">' + money_(s.ReceivableAmount) + '</td></tr>'; }).join('');
  var payTotal = payablesDue.reduce(function (a, p) { return a + toNumber(p.PayableAmount); }, 0);
  var payRows = payablesDue.slice(0, 30).map(function (p) { return '<tr><td style="padding:5px 9px;border:1px solid #eee">' + p.PurchaseID + '</td><td style="padding:5px 9px;border:1px solid #eee">' + p.SupplierName + '</td><td style="padding:5px 9px;border:1px solid #eee">' + formatDate(p.DueDate) + '</td><td style="padding:5px 9px;border:1px solid #eee;text-align:right;color:#92400e">' + money_(p.PayableAmount) + '</td></tr>'; }).join('');
  var cfRows = (cf.weeks || []).map(function (w) { return '<tr><td style="padding:5px 9px;border:1px solid #eee">' + w.label + '</td><td style="padding:5px 9px;border:1px solid #eee;text-align:right;color:#065f46">' + money_(w.in) + '</td><td style="padding:5px 9px;border:1px solid #eee;text-align:right;color:#92400e">' + money_(w.out) + '</td><td style="padding:5px 9px;border:1px solid #eee;text-align:right">' + money_(w.in - w.out) + '</td></tr>'; }).join('');
  var digest = '<div style="font-family:Arial,sans-serif;color:#111;max-width:680px">'
    + '<h2 style="color:#630ed4">' + business + ' - Bản tin công nợ & dòng tiền</h2><p style="color:#666">Ngày ' + getTodayString() + '</p>'
    + '<h3>1. Công nợ phải thu QUÁ HẠN (' + overdue.length + ' hóa đơn - ' + money_(ovTotal) + ')</h3>'
    + (overdue.length ? '<table style="border-collapse:collapse;width:100%"><tr><th style="padding:5px 9px;border:1px solid #eee">Mã HĐ</th><th style="padding:5px 9px;border:1px solid #eee">Khách hàng</th><th style="padding:5px 9px;border:1px solid #eee">Hạn</th><th style="padding:5px 9px;border:1px solid #eee">Còn nợ</th></tr>' + ovRows + '</table>' : '<p>Không có.</p>')
    + '<h3>2. Phải trả NCC đến hạn trong 7 ngày (' + payablesDue.length + ' phiếu - ' + money_(payTotal) + ')</h3>'
    + (payablesDue.length ? '<table style="border-collapse:collapse;width:100%"><tr><th style="padding:5px 9px;border:1px solid #eee">Mã phiếu</th><th style="padding:5px 9px;border:1px solid #eee">NCC</th><th style="padding:5px 9px;border:1px solid #eee">Hạn</th><th style="padding:5px 9px;border:1px solid #eee">Còn nợ</th></tr>' + payRows + '</table>' : '<p>Không có.</p>')
    + '<h3>3. Dự báo dòng tiền 30 ngày</h3><table style="border-collapse:collapse;width:100%"><tr><th style="padding:5px 9px;border:1px solid #eee">Kỳ</th><th style="padding:5px 9px;border:1px solid #eee">Thu</th><th style="padding:5px 9px;border:1px solid #eee">Chi</th><th style="padding:5px 9px;border:1px solid #eee">Ròng</th></tr>' + cfRows + '</table>'
    + '<p style="margin-top:10px"><b>Dòng tiền ròng dự kiến: ' + money_((cf.net || 0)) + '</b></p>'
    + '<p style="color:#999;font-size:12px;margin-top:20px">Email tự động từ AMCVN.</p></div>';
  try { MailApp.sendEmail({ to: owner, subject: '[' + business + '] Bản tin công nợ & dòng tiền ' + getTodayString(), htmlBody: digest }); } catch (e) { console.warn('[runReminders_]', (e && e.message) || String(e));  }

  return ok_({ overdueCount: overdue.length, payablesDueCount: payablesDue.length, customerEmailsSent: customerEmailsSent, owner: owner }, 'Đã gửi: bản tin -> ' + owner + (remindCustomers ? (', ' + customerEmailsSent + ' email cho khách') : ''));
}

