      });
      var item = sheetToObjects_('PurchaseItems').filter(function (i) { return i.PurchaseID === main.PurchaseID && i.ProductID === 'NO_CU'; })[0];
      if (item) updateRowById('PurchaseItems', 'PurchaseItemID', item.PurchaseItemID, { ProductName: 'Nợ đầu kỳ', Quantity: 1, UnitCost: amt, LineTotal: amt });
      else appendRow('PurchaseItems', { PurchaseItemID: generateId('PMI'), PurchaseID: main.PurchaseID, ProductID: 'NO_CU', SKU: '', ProductName: 'Nợ đầu kỳ', Quantity: 1, UnitCost: amt, LineTotal: amt });
    }
    rows.slice(1).forEach(function (r) {
      updateRowById('PurchaseOrders', 'PurchaseID', r.PurchaseID, { TotalAmount: 0, Subtotal: 0, PayableAmount: 0, PaidAmount: 0, PaymentStatus: 'Đã thanh toán', Notes: 'Nợ cũ trùng đã được đưa về 0' });
    });
    refreshSupplierBalance_(supplierId);
    return ok_({ PurchaseID: main.PurchaseID, amount: amt }, 'Đã điều chỉnh nợ đầu kỳ nhà cung cấp');
  } catch (e) { return err_(e.message); }
}

/* ============================================================================
 *  PURCHASE
 * ========================================================================== */

function getPurchaseOrders() { return getSheetData('PurchaseOrders'); }

/**
 * data: { SupplierID, SupplierName, PurchaseDate, DueDate, Discount, VATPercent, ShippingFee,
 *         PaidAmount, Notes, items: [{ProductID, Quantity, UnitCost}] }
 */
function createPurchaseOrder(data) {
  vatEnter_(data);   // module VAT từng dòng: nhớ số hóa đơn của chứng từ này
  whEnter_(data);   // module nhiều kho: nhớ kho đang thao tác cho các dòng biến động
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked',
    ['PurchaseOrders', 'PurchaseItems', 'StockMovements', 'Payments', 'Suppliers', 'Products'].concat(FINANCE_LOCK_SHEETS_),
    function () { return createPurchaseOrder(data); });
  try {
    ensureTradingItemSnapshotSchema_();
    var dupChk = dupByClientRef_('PurchaseOrders', 'PurchaseID', data.ClientRef, 'Phiếu mua');
    if (dupChk) return dupChk;
    if (!countValidLines_(data.items)) return err_('Chưa chọn sản phẩm nào cho phiếu mua. Hãy thêm ít nhất 1 dòng hàng.', 'ERR_NO_ITEMS');
    var id = generateId('PM');
    var now = new Date();
    var products = cachedSheetToObjects_('Products');
    var pMap = {}; products.forEach(function (p) { pMap[p.ProductID] = p; });
    var loSP_ = assertKnownProducts_(data.items, pMap);
    if (loSP_) return err_(loSP_, 'ERR_PRODUCT_NOT_FOUND');

    var subtotal = 0;
    var isOpeningDebt = false;

    var items = (data.items || []).map(function (it) {
      if (it.ProductID === 'NO_CU') isOpeningDebt = true;
      var prod = pMap[it.ProductID] || {};
      var qty = toNumber(it.Quantity);
      var cost = toNumber(it.UnitCost || prod.CostPrice);
      var line = qty * cost;
      subtotal += line;
      return { prod: prod, qty: qty, cost: cost, line: line };
    });

    var discount = toNumber(data.Discount);
    assertDiscount_(discount, subtotal);
    var vatPercent = (data.VATPercent !== undefined) ? toNumber(data.VATPercent) : CONFIG.DEFAULT_VAT;
    var vatInfo = vatLines_(data.items, items.map(function (x) { return x.line; }), subtotal, discount, vatPercent);
    var vat = vatInfo.vat;
    var shipping = toNumber(data.ShippingFee);
    var total = Math.max(0, subtotal - discount + vat + shipping);
    var paid = toNumber(data.PaidAmount);

    var orderStatus = normalizeStatus_(data.Status, 'Đã nhập kho');
    if (isOpeningDebt) orderStatus = 'NO_CU'; // Ép thành NO_CU
    
    validateStatus_(isOpeningDebt ? 'Hoàn tất' : orderStatus, PURCHASE_STATUS_FLOW, 'Trạng thái phiếu mua');
    if (isCompleted_(orderStatus) && total - paid > 0) orderStatus = 'Đã nhập kho';
    var payable = isCancelled_(orderStatus) ? 0 : Math.max(0, total - paid);
    var supplierName = data.SupplierName;
    if (!supplierName) { var s = sheetToObjects_('Suppliers').filter(function (x) { return x.SupplierID === data.SupplierID; })[0]; supplierName = s ? s.SupplierName : ''; }

    appendRow('PurchaseOrders', {
      ClientRef: data.ClientRef || '',
      PurchaseID: id, PurchaseDate: docDate_(data.PurchaseDate, now),
      SupplierID: data.SupplierID, SupplierName: supplierName, Subtotal: subtotal, Discount: discount,
      VAT: vat, ShippingFee: shipping, TotalAmount: total, PaidAmount: paid, PayableAmount: payable,
      PaymentStatus: isCancelled_(orderStatus) ? 'Đã hủy' : calculatePaymentStatus(total, paid), DueDate: data.DueDate ? docDate_(data.DueDate) : '',
      Status: orderStatus, CreatedBy: getUser_(), Notes: data.Notes || '', CreatedAt: now
    });

    var itemIds = generateIds('PMI', items.length);
    var movementIds = generateIds('MV', items.length);
    var purchaseItemRows = [], movementRows = [], affectedProducts = {};
    
    items.forEach(function (x, idx) {
      purchaseItemRows.push({
        PurchaseItemID: itemIds[idx], PurchaseID: id, ProductID: x.prod.ProductID || 'NO_CU', SKU: x.prod.SKU,
        ProductName: x.prod.ProductName || 'Ghi nhận nợ cũ đầu kỳ', Quantity: x.qty, UnitCost: x.cost, LineTotal: x.line,
        ProductType: itemProductType_(null, x.prod),
        VATPercent: vatInfo.lines[idx].p, VATAmount: vatInfo.lines[idx].a
      });
      
      // BỎ QUA KHO
      // Dịch vụ: vẫn tính tiền/công nợ nhưng KHÔNG tạo biến động nhập kho.
      if (!isServiceProduct_(x.prod) && !isOpeningDebt && orderStatus !== 'Đã đặt hàng' && !isCancelled_(orderStatus)) {
        movementRows.push({
          MovementID: movementIds[idx], Date: docDate_(data.PurchaseDate, now), Type: 'PurchaseIn',
          SourceType: 'PurchaseOrder', SourceID: id, ProductID: x.prod.ProductID, SKU: x.prod.SKU,
          ProductName: x.prod.ProductName, QuantityIn: x.qty, QuantityOut: 0, UnitCost: x.cost,
          UnitPrice: x.prod.SalePrice, StockAfter: '', CreatedBy: getUser_(), Notes: 'Nhập từ ' + id, CreatedAt: now, Status: 'Đã nhận'
        });
        affectedProducts[x.prod.ProductID] = true;
      }
    });
    
    appendRows('PurchaseItems', purchaseItemRows);
    if (movementRows.length > 0) appendRows('StockMovements', movementRows);
    Object.keys(affectedProducts).forEach(function (pid) { recalculateProductStock(pid); });

    if (paid > 0 && !isCancelled_(orderStatus)) {
      appendPaymentRow_({
        PaymentID: generateId('TT'), PaymentDate: docDate_(data.PurchaseDate, now),
        ObjectType: 'Supplier', ObjectID: data.SupplierID, ObjectName: supplierName, SourceType: 'PurchaseOrder',
        SourceID: id, PaymentDirection: 'Out', Amount: paid, Method: data.Method || 'Tiền mặt',
        AccountID: data.AccountID || '',
        BillImageUrl: data.BillImageUrl || '', BillAmount: data.BillAmount ? toNumber(data.BillAmount) : '', BillOcrText: data.BillOcrText || '',
        Note: 'Thanh toán khi tạo ' + id, CreatedBy: getUser_(), CreatedAt: now
      });
    }
    refreshSupplierBalance_(data.SupplierID);
    return ok_({ PurchaseID: id }, 'Đã tạo phiếu mua ' + id);
  } catch (e) { return err_(e.message); }
}

function getPurchaseDetail(purchaseId) {
  return cachedPayload_('pdetail:' + purchaseId, function () { return build_getPurchaseDetail(purchaseId); });
}
function build_getPurchaseDetail(purchaseId) {
  try {
    var po = sheetToObjects_('PurchaseOrders').filter(function (p) { return p.PurchaseID === purchaseId; })[0];
    var items = sheetToObjects_('PurchaseItems').filter(function (i) { return i.PurchaseID === purchaseId; });
    var allocMap = {};
    sheetToObjects_('PaymentAllocations').filter(function (a) { return a.SourceID === purchaseId; })
      .forEach(function (a) { allocMap[a.PaymentID] = true; });
    var payments = sheetToObjects_('Payments').filter(function (p) { return p.SourceID === purchaseId || allocMap[p.PaymentID]; });
    return ok_({ order: po, items: items, payments: payments });
  } catch (e) { return err_(e.message); }
}

function removePurchaseInventory_(purchaseId) {
  var affected = {};
  sheetToObjects_('StockMovements').filter(function (m) {
    return m.SourceID === purchaseId; // lọc theo SourceID (SourceType đã dịch sang 'Phiếu mua')
  }).forEach(function (m) {
    affected[m.ProductID] = true;
    deleteRowById('StockMovements', 'MovementID', m.MovementID);
  });
  Object.keys(affected).forEach(function (pid) { recalculateProductStock(pid); });
}

/**
 * P0-#5: Đảo toàn bộ thanh toán liên quan 1 chứng từ khi HỦY/XÓA — gồm cả phiếu thu/chi GỘP.
 *  1) Xóa phiếu thu/chi trực tiếp (SourceType+SourceID = chứng từ): lúc tạo, thu thêm khi sửa, thu lẻ 1 chứng từ.
 *  2) Xóa các dòng PaymentAllocations trỏ tới chứng từ này.
 *  3) Với phiếu thu GỘP bị ảnh hưởng: tính lại tổng tiền theo allocation còn lại; nếu hết thì xóa phiếu.
 * Các chứng từ KHÁC trong cùng phiếu thu gộp giữ nguyên phần đã phân bổ của chúng.
 */
function reversePaymentsForSource_(sourceType, sourceId) {
  if (!sourceId) return;
  // Lọc theo SourceID (SourceType trong sheet đã dịch tiếng Việt nên không so theo tham số 'SalesOrder'/'PurchaseOrder').
  sheetToObjects_('Payments')
    .filter(function (p) { return p.SourceType !== 'Nhiều chứng từ' && p.SourceID === sourceId; })
    .forEach(function (p) {
      deleteRowById('Payments', 'PaymentID', p.PaymentID);
      // Xóa phiếu thu/chi thì phải hủy luôn bút toán sổ quỹ, nếu không số dư tài khoản tiền sẽ treo vĩnh viễn.
      try { cancelFinanceBySource_('Payment', p.PaymentID); } catch (e) { console.warn('[reversePaymentsForSource_]', (e && e.message) || String(e));  }
    });
  var touched = {};
  sheetToObjects_('PaymentAllocations')
    .filter(function (a) { return a.SourceID === sourceId; })
    .forEach(function (a) { touched[a.PaymentID] = true; deleteRowById('PaymentAllocations', 'AllocationID', a.AllocationID); });
  Object.keys(touched).forEach(function (pid) {
    var pay = sheetToObjects_('Payments').filter(function (p) { return p.PaymentID === pid; })[0];
    if (!pay) return; // phiếu lẻ đã xóa ở bước 1
    var remain = sheetToObjects_('PaymentAllocations').filter(function (a) { return a.PaymentID === pid; });
    if (!remain.length) {
      deleteRowById('Payments', 'PaymentID', pid);
      try { cancelFinanceBySource_('Payment', pid); } catch (e) { console.warn('[reversePaymentsForSource_]', (e && e.message) || String(e));  }
      return;
    }
    var sum = remain.reduce(function (s, a) { return s + toNumber(a.Amount); }, 0);
    updateRowById('Payments', 'PaymentID', pid, {
      Amount: sum,
      SourceType: (remain.length > 1 ? 'Nhiều chứng từ' : remain[0].SourceType),
      SourceID: (remain.length > 1 ? remain.length + ' chứng từ' : remain[0].SourceID)
    });
    // Số tiền phiếu đã đổi -> dựng lại bút toán sổ quỹ theo số mới.
    try { cancelFinanceBySource_('Payment', pid); syncFinanceFromPayment_(pid); } catch (e) { console.warn('[reversePaymentsForSource_]', (e && e.message) || String(e));  }
  });
}

function removePurchasePayments_(purchaseId) {
  reversePaymentsForSource_('PurchaseOrder', purchaseId);
}

function writePurchasePayment_(purchaseId, data, supplierName) {
  var paid = toNumber(data.PaidAmount);
  if (paid <= 0 || isCancelled_(data.Status)) return;
  appendPaymentRow_({
    PaymentID: generateId('TT'), PaymentDate: docDate_(data.PurchaseDate, new Date()),
    ObjectType: 'Supplier', ObjectID: data.SupplierID, ObjectName: supplierName, SourceType: 'PurchaseOrder',
    SourceID: purchaseId, PaymentDirection: 'Out', Amount: paid, Method: data.Method || 'Tiền mặt',
    AccountID: data.AccountID || '',
    BillImageUrl: data.BillImageUrl || '', BillAmount: data.BillAmount ? toNumber(data.BillAmount) : '', BillOcrText: data.BillOcrText || '',
    Note: data.Note || ('Thanh toán ' + purchaseId), CreatedBy: getUser_(), CreatedAt: new Date()
  });
}

function ensurePurchaseInventory_(purchaseId) {
  var po = sheetToObjects_('PurchaseOrders').filter(function (p) { return p.PurchaseID === purchaseId; })[0];
  if (!po) throw new Error('Không tìm thấy phiếu mua');
  var existing = sheetToObjects_('StockMovements').filter(function (m) {
    return m.SourceID === purchaseId; // lọc theo SourceID (SourceType trong sheet là 'Phiếu mua' đã dịch)
  });
  if (existing.length) return;
  var pMapPI = {}; sheetToObjects_('Products').forEach(function (p) { pMapPI[p.ProductID] = p; });
  // Dịch vụ: vẫn ghi phiếu mua & công nợ nhưng KHÔNG nhập kho.
  var items = sheetToObjects_('PurchaseItems').filter(function (i) {
    return i.PurchaseID === purchaseId && itemProductType_(i, pMapPI[i.ProductID] || {}) !== 'Service';
  });
  if (!items.length) return;
  var movementIds = generateIds('MV', items.length);
  var movementRows = [];
  items.forEach(function (it, idx) {
    movementRows.push({
      MovementID: movementIds[idx], Date: po.PurchaseDate ? new Date(po.PurchaseDate) : new Date(),
      Type: 'PurchaseIn', SourceType: 'PurchaseOrder', SourceID: purchaseId,
      ProductID: it.ProductID, SKU: it.SKU, ProductName: it.ProductName,
      QuantityIn: toNumber(it.Quantity), QuantityOut: 0, UnitCost: toNumber(it.UnitCost), UnitPrice: '',
      StockAfter: '', CreatedBy: getUser_(), Notes: 'Nhập từ ' + purchaseId, CreatedAt: new Date(), Status: 'Đã nhận'
    });
  });
  appendRows('StockMovements', movementRows);
  items.forEach(function (it) { recalculateProductStock(it.ProductID); });
}

function updatePurchaseFinancials_(purchaseId, totals) {
  var po = sheetToObjects_('PurchaseOrders').filter(function (p) { return p.PurchaseID === purchaseId; })[0];
  if (!po) throw new Error('Không tìm thấy phiếu mua');
  var total = totals && totals.TotalAmount !== undefined ? toNumber(totals.TotalAmount) : toNumber(po.TotalAmount);
  var paid = totals && totals.PaidAmount !== undefined ? toNumber(totals.PaidAmount) : toNumber(po.PaidAmount);
  var status = totals && totals.Status !== undefined ? totals.Status : po.Status;
  var payable = isCancelled_(status) ? 0 : Math.max(0, total - paid);
  var paymentStatus = isCancelled_(status) ? 'Đã hủy' : calculatePaymentStatus(total, paid);
  var updates = { PayableAmount: payable, PaymentStatus: paymentStatus };
  if (totals) {
    ['Subtotal', 'Discount', 'VAT', 'ShippingFee', 'TotalAmount', 'PaidAmount', 'Status', 'PurchaseDate', 'DueDate', 'Notes', 'SupplierID', 'SupplierName'].forEach(function (k) {
      if (totals[k] !== undefined) updates[k] = totals[k];
    });
  }
  if (isCompleted_(status) && payable > 0) updates.Status = 'Đã nhập kho';
  updateRowById('PurchaseOrders', 'PurchaseID', purchaseId, updates);
  refreshSupplierBalance_(updates.SupplierID || po.SupplierID);
}

function updatePurchaseStatus(purchaseId, status, __locked) {
  if (!__locked) return withMutationLock_(
    ['PurchaseOrders', 'PurchaseItems', 'StockMovements', 'Payments', 'Suppliers', 'Products'].concat(FINANCE_LOCK_SHEETS_),
    function () { return updatePurchaseStatus(purchaseId, status, true); });
  try {
    dedicatedBlockPO_(purchaseId);
    var po = sheetToObjects_('PurchaseOrders').filter(function (p) { return p.PurchaseID === purchaseId; })[0];
    if (!po) return err_('Không tìm thấy phiếu mua');
    status = validatePurchaseStatusChange_(po, status);
    if (status === 'Đã đặt hàng') {
      removePurchaseInventory_(purchaseId);
      updatePurchaseFinancials_(purchaseId, { Status: status });
    } else if (status === 'Đã nhập kho' || isCompleted_(status)) {
      ensurePurchaseInventory_(purchaseId);
      updatePurchaseFinancials_(purchaseId, { Status: status });
    } else if (isCancelled_(status)) {
      removePurchaseInventory_(purchaseId);
      removePurchasePayments_(purchaseId);
      updatePurchaseFinancials_(purchaseId, { Status: status, PaidAmount: 0 });
    } else {
      updateRowById('PurchaseOrders', 'PurchaseID', purchaseId, { Status: status });
    }
    return ok_(null, 'Đã cập nhật trạng thái phiếu mua');
  } catch (e) { return err_(e.message); }
}

function updatePurchaseOrder(purchaseId, data) {
  vatEnter_(data);   // module VAT từng dòng: nhớ số hóa đơn của chứng từ này
  whEnter_(data);   // module nhiều kho: nhớ kho đang thao tác cho các dòng biến động
  data = data || {};
  ensureTradingItemSnapshotSchema_();
  if (!data.__locked) return runLocked_(data, '__locked',
    ['PurchaseOrders', 'PurchaseItems', 'StockMovements', 'Payments', 'Suppliers', 'Products'].concat(FINANCE_LOCK_SHEETS_),
    function () { return updatePurchaseOrder(purchaseId, data); });
  try {
    dedicatedBlockPO_(purchaseId);
    var old = sheetToObjects_('PurchaseOrders').filter(function (p) { return p.PurchaseID === purchaseId; })[0];
    if (!old) return err_('Không tìm thấy phiếu mua');
    if (isCompleted_(old.Status) || isCancelled_(old.Status)) return err_('Không thể sửa phiếu mua đã hoàn tất hoặc đã hủy');
    var requestedStatus = validatePurchaseStatusChange_(old, data.Status || old.Status);
    // P0-#2: KHÔNG xóa lịch sử thanh toán khi sửa. Chỉ ghi nhận phần chênh lệch (mới − cũ).
    var paidSoFar = toNumber(old.PaidAmount);
    var desiredPaid = data.PaidAmount !== undefined ? toNumber(data.PaidAmount) : paidSoFar;
    var addPay = desiredPaid - paidSoFar;
    if (addPay < -0.5) return err_('Không thể giảm số tiền đã trả của phiếu mua (đã trả ' + formatMoney_(paidSoFar) + '). Hãy xóa/sửa phiếu chi liên quan trong mục Công nợ.');
    removePurchaseInventory_(purchaseId);
    sheetToObjects_('PurchaseItems').filter(function (i) { return i.PurchaseID === purchaseId; })
      .forEach(function (i) { deleteRowById('PurchaseItems', 'PurchaseItemID', i.PurchaseItemID); });
    var products = cachedSheetToObjects_('Products');
    var pMap = {}; products.forEach(function (p) { pMap[p.ProductID] = p; });
    var loSP_ = assertKnownProducts_(data.items, pMap);
    if (loSP_) return err_(loSP_, 'ERR_PRODUCT_NOT_FOUND');
    var subtotal = 0;
    var newItems = [];
    var newItemIds = generateIds('PMI', (data.items || []).length);
    (data.items || []).forEach(function (it, idx) {
      var prod = pMap[it.ProductID] || {};
      var qty = toNumber(it.Quantity);
      var cost = toNumber(it.UnitCost || prod.CostPrice);
      var line = qty * cost;
      subtotal += line;
      newItems.push({
        PurchaseItemID: newItemIds[idx], PurchaseID: purchaseId, ProductID: prod.ProductID, SKU: prod.SKU,
        ProductName: prod.ProductName, Quantity: qty, UnitCost: cost, LineTotal: line, ProductType: itemProductType_(it, prod)
      });
    });
    var discount = toNumber(data.Discount);
    assertDiscount_(discount, subtotal);
    var vatPercent = data.VATPercent !== undefined ? toNumber(data.VATPercent) : CONFIG.DEFAULT_VAT;
    var vatInfo = vatLines_(data.items, newItems.map(function (r) { return toNumber(r.LineTotal); }), subtotal, discount, vatPercent);
    vatStampItems_(newItems, vatInfo);
    appendRows('PurchaseItems', newItems);
    var vat = vatInfo.vat;
    var shipping = toNumber(data.ShippingFee);
    var total = Math.max(0, subtotal - discount + vat + shipping);
    var supplierName = data.SupplierName || old.SupplierName;
    if (!supplierName && data.SupplierID) {
      var s = sheetToObjects_('Suppliers').filter(function (x) { return x.SupplierID === data.SupplierID; })[0];
      supplierName = s ? s.SupplierName : '';
    }
    updatePurchaseFinancials_(purchaseId, {
      SupplierID: data.SupplierID || old.SupplierID, SupplierName: supplierName,
      PurchaseDate: docDate_(data.PurchaseDate, old.PurchaseDate),
      DueDate: data.DueDate ? docDate_(data.DueDate) : '', Subtotal: subtotal, Discount: discount,
      VAT: vat, ShippingFee: shipping, TotalAmount: total, PaidAmount: paidSoFar + (addPay > 0 ? addPay : 0),
      Notes: data.Notes || '', Status: requestedStatus
    });
    // Chỉ ghi thêm phiếu chi cho phần chênh lệch tăng thêm (giữ nguyên lịch sử cũ)
    if (addPay > 0.5 && !isCancelled_(requestedStatus)) {
      writePurchasePayment_(purchaseId, {
        SupplierID: data.SupplierID || old.SupplierID,
        PurchaseDate: data.PurchaseDate || old.PurchaseDate,
        PaidAmount: addPay, Status: requestedStatus, Method: data.Method, Note: 'Trả thêm khi sửa ' + purchaseId
      }, supplierName);
    }
    if (old.SupplierID !== (data.SupplierID || old.SupplierID)) refreshSupplierBalance_(old.SupplierID);
    if (requestedStatus !== 'Đã đặt hàng' && !isCancelled_(requestedStatus)) ensurePurchaseInventory_(purchaseId);
    whUpdateDocWarehouse_('PurchaseOrders', 'PurchaseID', purchaseId);   // đổi kho khi sửa phiếu thì ghi lại luôn
    vatUpdateDocInvoice_('PurchaseOrders', 'PurchaseID', purchaseId);    // nhập lại số hóa đơn thì ghi lại luôn
    return ok_({ PurchaseID: purchaseId }, 'Đã cập nhật phiếu mua ' + purchaseId);
  } catch (e) { return err_(e.message); }
}

function deletePurchaseOrder(purchaseId, __locked) {
  if (!__locked) return withMutationLock_(
    ['PurchaseOrders', 'PurchaseItems', 'StockMovements', 'Payments', 'Suppliers', 'Products'].concat(FINANCE_LOCK_SHEETS_),
    function () { return deletePurchaseOrder(purchaseId, true); });
  try {
    dedicatedBlockPO_(purchaseId);
    var po = sheetToObjects_('PurchaseOrders').filter(function (p) { return p.PurchaseID === purchaseId; })[0];
    if (!po) return err_('Không tìm thấy phiếu mua');
    removePurchaseInventory_(purchaseId);
    removePurchasePayments_(purchaseId);
    sheetToObjects_('PurchaseItems').filter(function (i) { return i.PurchaseID === purchaseId; })
      .forEach(function (i) { deleteRowById('PurchaseItems', 'PurchaseItemID', i.PurchaseItemID); });
    deleteRowById('PurchaseOrders', 'PurchaseID', purchaseId);
    refreshSupplierBalance_(po.SupplierID);
    return ok_(null, 'Đã xóa phiếu mua ' + purchaseId);
  } catch (e) { return err_(e.message); }
}

/* ============================================================================
 *  SALES
 * ========================================================================== */

function getSalesOrders() { return getSheetData('SalesOrders'); }

/**
 * data: { CustomerID, CustomerName, SalesDate, DueDate, Discount, VATPercent, ShippingFee,
 *         PaidAmount, Notes, items: [{ProductID, Quantity, SalePrice}] }
 */
function createSalesOrder(data) {
  vatEnter_(data);   // module VAT từng dòng: nhớ số hóa đơn của chứng từ này
  whEnter_(data);   // module nhiều kho: nhớ kho đang thao tác cho các dòng biến động
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked',
    ['SalesOrders', 'SalesItems', 'StockMovements', 'Payments', 'Customers', 'Products'].concat(FINANCE_LOCK_SHEETS_),
    function () { return createSalesOrder(data); });
  try {
    ensureTradingItemSnapshotSchema_();
    var dupChk = dupByClientRef_('SalesOrders', 'SalesID', data.ClientRef, 'Hóa đơn');
    if (dupChk) return dupChk;
    if (!countValidLines_(data.items)) return err_('Chưa chọn sản phẩm nào cho hóa đơn. Hãy thêm ít nhất 1 dòng hàng.', 'ERR_NO_ITEMS');
    var id = generateId('HD');
    var now = new Date();
    var products = sheetToObjects_('Products');
    var pMap = {}; products.forEach(function (p) { pMap[p.ProductID] = p; });
    var loSP_ = assertKnownProducts_(data.items, pMap);
    if (loSP_) return err_(loSP_, 'ERR_PRODUCT_NOT_FOUND');

    var subtotal = 0, costAmount = 0, profit = 0;
    var isOpeningDebt = false; // Cờ kiểm tra nợ cũ

    var rows = (data.items || []).map(function (it) {
      if (it.ProductID === 'NO_CU') isOpeningDebt = true;
      var prod = pMap[it.ProductID] || {};
      var qty = toNumber(it.Quantity);
      var price = toNumber(it.SalePrice || prod.SalePrice);
      var cost = toNumber(prod.CostPrice);
      var rev = qty * price, lcost = qty * cost, lprofit = rev - lcost;
      subtotal += rev; costAmount += lcost; profit += lprofit;
      return { prod: prod, qty: qty, price: price, cost: cost, rev: rev, lcost: lcost, lprofit: lprofit };
    });
    
    // Nếu là nợ cũ thì bỏ qua việc kiểm tra kho
    if (!isOpeningDebt) {
        var shortage = rows.filter(function (x) { return x.prod.ProductID && !(x.prod.ProductType === 'Service' || x.prod.Category === 'Dịch vụ') && x.qty > toNumber(x.prod.CurrentStock); });
        if (shortage.length) { var sx = shortage[0]; return err_('Không đủ tồn để bán "' + sx.prod.ProductName + '". Tồn hiện có: ' + toNumber(sx.prod.CurrentStock) + ', cần bán: ' + sx.qty); }
        // Nhiều kho: tổng tồn đủ nhưng RIÊNG kho xuất có thể không đủ -> báo rõ tên kho.
        var whShort = whCheckShortage_(rows.map(function (x) { return { prod: x.prod, qty: x.qty }; }));
        if (whShort) return err_(whShort, 'ERR_WH_STOCK');
    }

    var discount = toNumber(data.Discount);
    assertDiscount_(discount, subtotal);
    var vatPercent = (data.VATPercent !== undefined) ? toNumber(data.VATPercent) : CONFIG.DEFAULT_VAT;
    var vatInfo = vatLines_(data.items, rows.map(function (x) { return x.rev; }), subtotal, discount, vatPercent);
    var vat = vatInfo.vat;
    var shipping = toNumber(data.ShippingFee);
    var total = subtotal - discount + vat + shipping;
    var paid = toNumber(data.PaidAmount);
    var receivable = Math.max(0, total - paid);
    var orderStatus = receivable > 0 ? 'Đang xử lý' : 'Hoàn tất';
    
    // NẾU LÀ NỢ CŨ: Ghi chú thẳng vào Status để UI nhận diện
    if (isOpeningDebt) orderStatus = 'NO_CU';

    profit = profit - discount;
    var customerName = data.CustomerName;
    if (!customerName) { var c = sheetToObjects_('Customers').filter(function (x) { return x.CustomerID === data.CustomerID; })[0]; customerName = c ? c.CustomerName : ''; }

    appendRow('SalesOrders', {
      ClientRef: data.ClientRef || '',
      SalesID: id, SalesDate: docDate_(data.SalesDate, now), CustomerID: data.CustomerID,
      CustomerName: customerName, Subtotal: subtotal, Discount: discount, VAT: vat, ShippingFee: shipping,
      TotalAmount: total, PaidAmount: paid, ReceivableAmount: receivable, CostAmount: costAmount,
      Profit: profit, PaymentStatus: calculatePaymentStatus(total, paid),
      DueDate: data.DueDate ? docDate_(data.DueDate) : '', Status: orderStatus, CreatedBy: getUser_(),
      Notes: data.Notes || '', CreatedAt: now
    });

    var salesItemIds = generateIds('HDI', rows.length);
    var movementIds = generateIds('MV', rows.length);
    var salesItemRows = [], movementRows = [], affectedProducts = {};
    rows.forEach(function (x, idx) {
      salesItemRows.push({
        SalesItemID: salesItemIds[idx], SalesID: id, ProductID: x.prod.ProductID || 'NO_CU', SKU: x.prod.SKU,
        ProductName: x.prod.ProductName || 'Ghi nhận nợ cũ đầu kỳ', Quantity: x.qty, CostPrice: x.cost, SalePrice: x.price,
        LineRevenue: x.rev, LineCost: x.lcost, LineProfit: x.lprofit, ProductType: itemProductType_(null, x.prod),
        VATPercent: vatInfo.lines[idx].p, VATAmount: vatInfo.lines[idx].a
      });
      
      // BỎ QUA TẠO BIẾN ĐỘNG KHO NẾU LÀ NỢ CŨ
      if (!isOpeningDebt) {
          if (!(x.prod.ProductType === 'Service' || x.prod.Category === 'Dịch vụ')) {
        movementRows.push({
          MovementID: movementIds[idx],
          Date: docDate_(data.SalesDate, now),
          Type: 'SaleOut',
            SourceType: 'SalesOrder', SourceID: id, ProductID: x.prod.ProductID, SKU: x.prod.SKU,
            ProductName: x.prod.ProductName, QuantityIn: 0, QuantityOut: x.qty, UnitCost: x.cost,
            UnitPrice: x.price, StockAfter: '', CreatedBy: getUser_(), Notes: 'Xuất cho ' + id, CreatedAt: now, Status: 'Đã giao'
          });
          affectedProducts[x.prod.ProductID] = true;
          }
      }
    });
    
    appendRows('SalesItems', salesItemRows);
    if (movementRows.length > 0) appendRows('StockMovements', movementRows);
    Object.keys(affectedProducts).forEach(function (pid) { recalculateProductStock(pid); });

    if (paid > 0) {
      appendPaymentRow_({
        PaymentID: generateId('TT'), PaymentDate: docDate_(data.SalesDate, now),
        ObjectType: 'Customer', ObjectID: data.CustomerID, ObjectName: customerName, SourceType: 'SalesOrder',
        SourceID: id, PaymentDirection: 'In', Amount: paid, Method: data.Method || 'Tiền mặt',
        AccountID: data.AccountID || '',
        BillImageUrl: data.BillImageUrl || '', BillAmount: data.BillAmount ? toNumber(data.BillAmount) : '', BillOcrText: data.BillOcrText || '',
        Note: 'Thu khi tạo ' + id, CreatedBy: getUser_(), CreatedAt: now
      });
    }
    refreshCustomerBalance_(data.CustomerID);
    return ok_({ SalesID: id }, 'Đã tạo hóa đơn ' + id);
  } catch (e) { return err_(e.message); }
}

