    appendRow('CashAccounts', { AccountID: generateId('CA'), AccountName: data.AccountName, AccountType: data.AccountType || 'Cash',
      BankName: data.BankName || '', AccountNumber: data.AccountNumber || '', OpeningBalance: toNumber(data.OpeningBalance),
      CurrentBalance: toNumber(data.OpeningBalance), Currency: data.Currency || 'VND', IsDefault: financeBool_(data.IsDefault),
      Status: data.Status || 'Đang hoạt động', Notes: data.Notes || '', CreatedAt: now, UpdatedAt: now,
      BankCode: qr.BankCode, AccountHolder: qr.AccountHolder, VietQRUrl: qr.VietQRUrl, QRNoteTemplate: qr.QRNoteTemplate });
    recalculateCashAccounts();
    return ok_(null, 'Đã tạo tài khoản tiền');
  });
}
/* Chỉ tài khoản Bank mới giữ thông tin VietQR; đổi sang Cash/Ví thì xóa sạch để không sinh QR rác. */
function normalizeCashAccountQrFields_(data) {
  data = data || {};
  if (String(data.AccountType) !== 'Bank') return { BankCode: '', AccountHolder: '', VietQRUrl: '', QRNoteTemplate: '' };
  return {
    BankCode: String(data.BankCode || '').trim().toUpperCase(),
    AccountHolder: String(data.AccountHolder || '').trim(),
    VietQRUrl: String(data.VietQRUrl || '').trim(),
    QRNoteTemplate: String(data.QRNoteTemplate || '').trim()
  };
}
function clearDefaultCashAccounts_() {
  sheetToObjects_('CashAccounts').forEach(function (a) { if (financeBool_(a.IsDefault)) updateRowById('CashAccounts', 'AccountID', a.AccountID, { IsDefault: false }); });
}
function updateCashAccount(id, data) {
  return withMutationLock_(['CashAccounts', 'FinanceTransactions'], function () {
    data = data || {}; if (!financeFindById_('CashAccounts', 'AccountID', id)) return err_('Không tìm thấy tài khoản tiền.');
    if (financeBool_(data.IsDefault)) clearDefaultCashAccounts_();
    var qrU = normalizeCashAccountQrFields_(data);
    updateRowById('CashAccounts', 'AccountID', id, {
      AccountName: data.AccountName, AccountType: data.AccountType, BankName: data.BankName || '', AccountNumber: data.AccountNumber || '',
      OpeningBalance: toNumber(data.OpeningBalance), Currency: data.Currency || 'VND', IsDefault: financeBool_(data.IsDefault),
      Status: data.Status || 'Đang hoạt động', Notes: data.Notes || '', UpdatedAt: financeNow_(),
      BankCode: qrU.BankCode, AccountHolder: qrU.AccountHolder, VietQRUrl: qrU.VietQRUrl, QRNoteTemplate: qrU.QRNoteTemplate
    });
    recalculateCashAccounts();
    return ok_(null, 'Đã cập nhật tài khoản tiền');
  });
}
/* Số giao dịch đang tham chiếu tới tài khoản tiền (dùng cho UI xác nhận xóa). */
function cashAccountUsage_(id) {
  var txs = sheetToObjects_('FinanceTransactions').filter(function (t) { return t.AccountID === id || t.ToAccountID === id; });
  var pays = sheetToObjects_('Payments').filter(function (p) { return p.AccountID === id; });
  return { txCount: txs.length, paymentCount: pays.length, total: txs.length + pays.length };
}
function getCashAccountUsage(id) { try { return ok_(cashAccountUsage_(id)); } catch (e) { return err_(e.message); } }
function deleteCashAccount(id) {
  return withMutationLock_(['CashAccounts'], function () {
    if (!financeFindById_('CashAccounts', 'AccountID', id)) return err_('Không tìm thấy tài khoản tiền.');
    var use = cashAccountUsage_(id);
    if (use.total > 0) return err_('Tài khoản này đã có ' + use.total + ' giao dịch nên không thể xóa. Bạn có thể chuyển trạng thái sang Ngừng dùng.');
    deleteRowById('CashAccounts', 'AccountID', id);
    return ok_(null, 'Đã xóa tài khoản tiền');
  });
}

/* Sổ quỹ chi tiết 1 tài khoản: tiền vào / tiền ra / số dư sau mỗi giao dịch.
   Chuyển quỹ hiện đúng ở CẢ tài khoản nguồn (tiền ra) và tài khoản nhận (tiền vào). */
function getCashAccountLedger(accountId, limit) {
  try {
    var acc = financeFindById_('CashAccounts', 'AccountID', accountId);
    if (!acc) return err_('Không tìm thấy tài khoản tiền.');
    var rows = sheetToObjects_('FinanceTransactions')
      .filter(function (t) { return String(t.Status) !== 'Cancelled' && (t.AccountID === accountId || t.ToAccountID === accountId); })
      .sort(function (a, b) { return new Date(a.TransactionDate || 0) - new Date(b.TransactionDate || 0); });
    var bal = toNumber(acc.OpeningBalance);
    var ledger = rows.map(function (t) {
      var amt = toNumber(t.Amount), moneyIn = 0, moneyOut = 0, label = t.CategoryName || t.TransactionType || '';
      if (t.Direction === 'In') moneyIn = amt;
      else if (t.Direction === 'Out') moneyOut = amt;
      else if (t.Direction === 'Transfer') {
        if (t.ToAccountID === accountId) { moneyIn = amt; label = 'Nhận chuyển quỹ từ ' + (t.AccountName || t.AccountID); }
        else { moneyOut = amt; label = 'Chuyển quỹ sang ' + (t.ToAccountName || t.ToAccountID); }
      }
      bal += moneyIn - moneyOut;
      return { TransactionID: t.TransactionID, TransactionDate: t.TransactionDate, Description: label,
