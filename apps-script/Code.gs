function recalculateCashAccounts() {
  var accounts = sheetToObjects_('CashAccounts');
  var balances = {};
  accounts.forEach(function (a) { balances[a.AccountID] = toNumber(a.OpeningBalance); });
  sheetToObjects_('FinanceTransactions').forEach(function (t) {
    if (String(t.Status) === 'Cancelled') return;
    var amt = toNumber(t.Amount);
    if (!amt) return;
    if (t.Direction === 'In') balances[t.AccountID] = (balances[t.AccountID] || 0) + amt;
    else if (t.Direction === 'Out') balances[t.AccountID] = (balances[t.AccountID] || 0) - amt;
    else if (t.Direction === 'Transfer') {
      // Chuyển quỹ thiếu TK nhận -> bỏ qua, nếu không tiền sẽ biến mất khỏi tổng quỹ.
      if (!t.ToAccountID || t.ToAccountID === t.AccountID) return;
      balances[t.AccountID] = (balances[t.AccountID] || 0) - amt;
      balances[t.ToAccountID] = (balances[t.ToAccountID] || 0) + amt;
    }
  });
  accounts.forEach(function (a) { updateRowById('CashAccounts', 'AccountID', a.AccountID, { CurrentBalance: balances[a.AccountID] || 0, UpdatedAt: financeNow_() }); });
  return ok_(balances, 'Đã tính lại số dư tài khoản tiền');
}

function recalculateBudgets() {
  var txs = sheetToObjects_('FinanceTransactions').filter(function (t) { return t.Direction === 'Out' && t.TransactionType === 'Expense' && String(t.Status || '') === 'Paid'; });
  var plans = sheetToObjects_('BudgetPlans');
