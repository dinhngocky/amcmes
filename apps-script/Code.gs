/* ===== HẾT MODULE NHIỀU KHO HÀNG ===== */

/* ===== AMC MODULE: POS BÁN TẠI QUẦY =====
 * NGUYÊN TẮC: đơn POS KHÔNG phải một hệ thống riêng — nó vẫn là HÓA ĐƠN BÁN HÀNG
 * bình thường (SalesOrders), chỉ khác là được đánh dấu Kênh = "POS" và gắn với một CA BÁN.
 * Nhờ vậy doanh thu, tồn kho, công nợ, báo cáo, trả hàng... dùng chung một nguồn số liệu,
 * không bao giờ có chuyện "doanh thu POS" lệch với "doanh thu bán hàng".
 *
 * CA BÁN HÀNG (PosShifts): mở ca -> bán -> đóng ca và đếm tiền mặt thực tế.
 * Chênh lệch giữa tiền lẽ ra phải có và tiền đếm được luôn được ghi lại, không giấu.
 * ========================================================================== */

var POS_CHANNEL_ = 'POS';
var POS_WALKIN_NAME_ = 'Khách lẻ';

function installPosSchema_() {
  SCHEMA.PosShifts = ['ShiftID', 'ShiftCode', 'OpenedAt', 'OpenedBy', 'ClosedAt', 'ClosedBy',
    'WarehouseID', 'WarehouseName', 'AccountID', 'AccountName', 'OpeningCash',
    'CashSales', 'TransferSales', 'CardSales', 'OtherSales', 'TotalSales',
    'OrderCount', 'ExpectedCash', 'CountedCash', 'Difference', 'Status', 'Notes'];

  // Đánh dấu trên hóa đơn: đơn nào bán tại quầy và thuộc ca nào.
  ['Channel', 'ShiftID', 'CashReceived', 'ChangeGiven'].forEach(function (c) {
    if (SCHEMA.SalesOrders.indexOf(c) < 0) SCHEMA.SalesOrders.push(c);
  });

  SHEET_LABELS.PosShifts = 'Ca bán hàng';
  LABELS.PosShifts = {
    ShiftID: 'Mã ca', ShiftCode: 'Số ca', OpenedAt: 'Mở ca lúc', OpenedBy: 'Người mở ca',
    ClosedAt: 'Đóng ca lúc', ClosedBy: 'Người đóng ca', WarehouseID: 'Mã kho', WarehouseName: 'Kho bán',
    AccountID: 'Mã quỹ', AccountName: 'Quỹ tiền mặt', OpeningCash: 'Tiền đầu ca',
    CashSales: 'Bán tiền mặt', TransferSales: 'Bán chuyển khoản', CardSales: 'Bán quẹt thẻ',
    OtherSales: 'Bán hình thức khác', TotalSales: 'Tổng doanh thu ca', OrderCount: 'Số đơn',
    ExpectedCash: 'Tiền mặt lẽ ra có', CountedCash: 'Tiền mặt đếm được', Difference: 'Chênh lệch',
    Status: 'Trạng thái', Notes: 'Ghi chú'
  };
  LABELS.SalesOrders.Channel = 'Kênh bán';
  LABELS.SalesOrders.ShiftID = 'Ca bán hàng';
  LABELS.SalesOrders.CashReceived = 'Khách đưa';
  LABELS.SalesOrders.ChangeGiven = 'Tiền thối';

  if (typeof MONEY_COLS !== 'undefined') {
    ['OpeningCash', 'CashSales', 'TransferSales', 'CardSales', 'OtherSales', 'TotalSales',
      'ExpectedCash', 'CountedCash', 'Difference', 'CashReceived', 'ChangeGiven'].forEach(function (k) {
        if (MONEY_COLS.indexOf(k) < 0) MONEY_COLS.push(k);
      });
  }
  if (typeof SETUP_SHEET_ORDER !== 'undefined' && SETUP_SHEET_ORDER.indexOf('PosShifts') < 0) SETUP_SHEET_ORDER.push('PosShifts');
  if (typeof SETUP_TAB_COLORS !== 'undefined') SETUP_TAB_COLORS.PosShifts = '#f59e0b';
}
if (CONFIG.ENABLE_POS) installPosSchema_();

/* ------------------------------- Ca bán hàng ------------------------------- */
function posShifts_() { return sheetToObjects_('PosShifts'); }
function posShiftById_(id) {
  var list = posShifts_();
  for (var i = 0; i < list.length; i++) if (String(list[i].ShiftID) === String(id)) return list[i];
  return null;
}
/** Ca đang mở của người đang đăng nhập (chạy tay không đăng nhập thì lấy ca mở bất kỳ). */
function posOpenShiftOf_(user) {
  var me = String(user || getUser_() || '');
  var open = posShifts_().filter(function (s) { return String(s.Status || '') === 'Đang mở'; });
  var mine = open.filter(function (s) { return String(s.OpenedBy || '') === me; });
  return mine.length ? mine[mine.length - 1] : (open.length ? open[open.length - 1] : null);
}

/** Khách lẻ dùng chung cho mọi đơn không khai tên khách. Tạo một lần rồi dùng lại. */
function posWalkInCustomer_() {
  var hit = sheetToObjects_('Customers').filter(function (c) {
    return String(c.CustomerName || '').trim().toLowerCase() === POS_WALKIN_NAME_.toLowerCase();
  })[0];
  if (hit) return hit;
  var r = createCustomer({ CustomerName: POS_WALKIN_NAME_, CustomerGroup: 'Khách lẻ', Notes: 'Khách vãng lai mua tại quầy' });
  if (r && r.success && r.data) return r.data;
  throw new Error('Không tạo được hồ sơ "' + POS_WALKIN_NAME_ + '".');
}

/** Số tiền đã thu theo từng hình thức của một ca. */
function posShiftTotals_(shiftId) {
  var orders = sheetToObjects_('SalesOrders').filter(function (s) {
    return String(s.ShiftID || '') === String(shiftId) && !isCancelled_(String(s.Status || ''));
  });
  var pays = sheetToObjects_('Payments');
  var byOrder = {};
  pays.forEach(function (p) {
    if (String(p.SourceType) !== 'SalesOrder' && String(p.SourceType) !== 'Hóa đơn') return;
    (byOrder[String(p.SourceID)] = byOrder[String(p.SourceID)] || []).push(p);
  });
  var t = { cash: 0, transfer: 0, card: 0, other: 0, total: 0, count: orders.length, receivable: 0 };
  orders.forEach(function (o) {
    t.total += toNumber(o.TotalAmount);
    t.receivable += toNumber(o.ReceivableAmount);
    (byOrder[String(o.SalesID)] || []).forEach(function (p) {
      var m = String(p.Method || 'Tiền mặt');
      var amt = toNumber(p.Amount);
      if (m === 'Tiền mặt') t.cash += amt;
      else if (m === 'Chuyển khoản') t.transfer += amt;
      else if (m === 'Quẹt thẻ' || m === 'Thẻ') t.card += amt;
      else t.other += amt;
    });
  });
  return t;
}

function getCurrentPosShift() {
  try {
    var s = posOpenShiftOf_();
    if (!s) return ok_(null);
    var t = posShiftTotals_(s.ShiftID);
    var o = {};
    Object.keys(s).forEach(function (k) { o[k] = s[k]; });
    o.CashSales = t.cash; o.TransferSales = t.transfer; o.CardSales = t.card; o.OtherSales = t.other;
    o.TotalSales = t.total; o.OrderCount = t.count;
    o.ExpectedCash = toNumber(s.OpeningCash) + t.cash;
    return ok_(o);
  } catch (e) { return err_(e.message); }
}

function openPosShift(data) {
  return withMutationLock_(['PosShifts'], function () {
    try {
      data = data || {};
      var me = getUser_();
      var existing = posOpenShiftOf_(me);
      if (existing && String(existing.OpenedBy || '') === String(me)) {
        return err_('Bạn đang có ca "' + existing.ShiftCode + '" chưa đóng. Hãy đóng ca cũ trước khi mở ca mới.', 'ERR_POS_SHIFT_OPEN');
      }
      var w = (typeof whResolve_ === 'function') ? whResolve_(data.WarehouseID) : null;
      var acc = null;
      if (data.AccountID) {
        acc = sheetToObjects_('CashAccounts').filter(function (a) { return String(a.AccountID) === String(data.AccountID); })[0] || null;
      }
      var now = new Date();
      var id = generateId('CA1');
      var code = 'CA-' + Utilities.formatDate(now, getTz_(), 'yyMMdd') + '-' + padSeq_(posShifts_().filter(function (s) {
        return Utilities.formatDate(new Date(s.OpenedAt || now), getTz_(), 'yyMMdd') === Utilities.formatDate(now, getTz_(), 'yyMMdd');
      }).length + 1);
      var row = {
        ShiftID: id, ShiftCode: code, OpenedAt: now, OpenedBy: me, ClosedAt: '', ClosedBy: '',
        WarehouseID: w ? w.WarehouseID : '', WarehouseName: w ? w.WarehouseName : '',
        AccountID: acc ? acc.AccountID : '', AccountName: acc ? acc.AccountName : '',
        OpeningCash: Math.max(0, toNumber(data.OpeningCash)),
        CashSales: 0, TransferSales: 0, CardSales: 0, OtherSales: 0, TotalSales: 0, OrderCount: 0,
        ExpectedCash: Math.max(0, toNumber(data.OpeningCash)), CountedCash: '', Difference: '',
        Status: 'Đang mở', Notes: data.Notes || ''
      };
      appendRow('PosShifts', row);
      writeAudit_('Mở ca bán hàng', 'PosShift', id, code + ' · Tiền đầu ca ' + formatMoney_(row.OpeningCash));
      return ok_(row, 'Đã mở ca ' + code);
    } catch (e) { return err_(e.message); }
  });
}

function closePosShift(shiftId, data) {
  return withMutationLock_(['PosShifts'], function () {
    try {
      data = data || {};
      var s = posShiftById_(shiftId);
      if (!s) return err_('Không tìm thấy ca bán hàng.');
      if (String(s.Status || '') === 'Đã đóng') return err_('Ca này đã đóng rồi.');
      var t = posShiftTotals_(shiftId);
      var expected = toNumber(s.OpeningCash) + t.cash;
      var counted = (data.CountedCash === '' || data.CountedCash == null) ? expected : toNumber(data.CountedCash);
      var diff = counted - expected;
      var now = new Date();
      var upd = {
        ClosedAt: now, ClosedBy: getUser_(),
        CashSales: t.cash, TransferSales: t.transfer, CardSales: t.card, OtherSales: t.other,
        TotalSales: t.total, OrderCount: t.count,
        ExpectedCash: expected, CountedCash: counted, Difference: diff,
        Status: 'Đã đóng',
        Notes: data.Notes ? (s.Notes ? (s.Notes + ' | ' + data.Notes) : data.Notes) : s.Notes
      };
      updateRowById('PosShifts', 'ShiftID', shiftId, upd);
      writeAudit_('Đóng ca bán hàng', 'PosShift', shiftId,
        s.ShiftCode + ' · ' + t.count + ' đơn · ' + formatMoney_(t.total)
        + (Math.abs(diff) > 0.5 ? (' · Lệch quỹ ' + formatMoney_(diff)) : ' · Khớp quỹ'));
      var merged = {};
      Object.keys(s).forEach(function (k) { merged[k] = s[k]; });
      Object.keys(upd).forEach(function (k) { merged[k] = upd[k]; });
      return ok_(merged, Math.abs(diff) > 0.5
        ? ('Đã đóng ca. Quỹ lệch ' + formatMoney_(diff) + ' so với sổ — hãy ghi rõ lý do.')
        : 'Đã đóng ca, tiền mặt khớp sổ.');
    } catch (e) { return err_(e.message); }
  });
}

function getPosShifts(filters) {
  try {
    filters = filters || {};
    var rows = posShifts_().slice().reverse();
    if (filters.from || filters.to) {
      var from = filters.from ? new Date(String(filters.from) + 'T00:00:00') : null;
      var to = filters.to ? new Date(String(filters.to) + 'T23:59:59') : null;
      rows = rows.filter(function (s) {
        var d = s.OpenedAt ? new Date(s.OpenedAt) : null;
        if (!d || isNaN(d.getTime())) return false;
        if (from && d < from) return false;
        if (to && d > to) return false;
        return true;
      });
    }
    if (filters.status) rows = rows.filter(function (s) { return String(s.Status) === String(filters.status); });
    // Ca đang mở thì số liệu tính lại theo thời gian thực
    rows = rows.map(function (s) {
      if (String(s.Status || '') !== 'Đang mở') return s;
      var t = posShiftTotals_(s.ShiftID);
      var o = {};
      Object.keys(s).forEach(function (k) { o[k] = s[k]; });
      o.CashSales = t.cash; o.TransferSales = t.transfer; o.CardSales = t.card; o.OtherSales = t.other;
      o.TotalSales = t.total; o.OrderCount = t.count; o.ExpectedCash = toNumber(s.OpeningCash) + t.cash;
      return o;
    });
    return ok_(rows);
  } catch (e) { return err_(e.message); }
}

function getPosShiftDetail(shiftId) {
  try {
    var s = posShiftById_(shiftId);
    if (!s) return err_('Không tìm thấy ca bán hàng.');
    var t = posShiftTotals_(shiftId);
    var orders = sheetToObjects_('SalesOrders').filter(function (o) { return String(o.ShiftID || '') === String(shiftId); });
    var o = {};
    Object.keys(s).forEach(function (k) { o[k] = s[k]; });
    if (String(s.Status || '') === 'Đang mở') {
      o.CashSales = t.cash; o.TransferSales = t.transfer; o.CardSales = t.card; o.OtherSales = t.other;
      o.TotalSales = t.total; o.OrderCount = t.count; o.ExpectedCash = toNumber(s.OpeningCash) + t.cash;
    }
    return ok_({ shift: o, orders: orders, totals: t });
  } catch (e) { return err_(e.message); }
}

/* ------------------------------- Bán tại quầy ------------------------------- */
/**
 * Dữ liệu mở màn hình POS: sản phẩm bán được, khách hàng, ca đang mở, quỹ tiền.
 * Cố ý gọn nhẹ để máy tính tiền ở quầy mở nhanh.
 */
function getPosBootstrap() {
  try {
    var settings = {};
    try { cachedSheetToObjects_('Settings').forEach(function (s) { settings[s.Key] = s.Value; }); } catch (e) { console.warn('[getPosBootstrap]', (e && e.message) || String(e));  }
    var products = cachedSheetToObjects_('Products').filter(function (p) {
      return String(p.Status || '') !== 'Ngừng bán';
    }).map(function (p) {
      return {
        ProductID: p.ProductID, SKU: p.SKU, ProductName: p.ProductName, Unit: p.Unit,
        Category: p.Category, SalePrice: toNumber(p.SalePrice), CurrentStock: toNumber(p.CurrentStock),
        ImageUrl: p.ImageUrl || '', ProductType: p.ProductType || '', Status: p.Status || ''
      };
    });
    var customers = cachedSheetToObjects_('Customers').map(function (c) {
      return { CustomerID: c.CustomerID, CustomerName: c.CustomerName, Phone: c.Phone, ReceivableBalance: toNumber(c.ReceivableBalance) };
    });
    var accounts = [];
    try {
      accounts = cachedSheetToObjects_('CashAccounts').filter(function (a) { return String(a.Status || '') !== 'Ngừng dùng'; })
        .map(function (a) { return { AccountID: a.AccountID, AccountName: a.AccountName, AccountType: a.AccountType }; });
    } catch (e) { console.warn('[getPosBootstrap]', (e && e.message) || String(e));  accounts = []; }
    var whs = [];
    try { whs = (getWarehouses().data || []).filter(function (w) { return !w.IsTransit && String(w.Status || '') !== 'Ngừng dùng'; }); } catch (e) { console.warn('[getPosBootstrap]', (e && e.message) || String(e));  whs = []; }
    var cur = getCurrentPosShift();
    return ok_({
      products: products, customers: customers, accounts: accounts, warehouses: whs,
      shift: cur.success ? cur.data : null,
      defaultVat: toNumber(settings.DefaultVAT !== undefined && settings.DefaultVAT !== '' ? settings.DefaultVAT : CONFIG.DEFAULT_VAT),
      businessName: settings.BusinessName || CONFIG.APP_NAME,
      canDiscount: !AUTH_CTX_ || authHasExtra_(AUTH_CTX_, 'discount')
    });
  } catch (e) { return err_(e.message); }
}

/**
 * Tạo đơn bán tại quầy.
 * data: { items:[{ProductID,Quantity,SalePrice}], CustomerID, Discount, DiscountPercent, VATPercent,
 *         Method, AccountID, CashReceived, Notes, WarehouseID }
 * Đơn POS mặc định THU ĐỦ ngay. Muốn ghi nợ thì truyền PaidAmount nhỏ hơn tổng tiền.
 */
function createPosOrder(data) {
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked',
    ['SalesOrders', 'SalesItems', 'StockMovements', 'Payments', 'Customers', 'Products', 'PosShifts'].concat(FINANCE_LOCK_SHEETS_),
    function () { return createPosOrder(data); });
  try {
    var items = (data.items || []).filter(function (it) { return it && it.ProductID && toNumber(it.Quantity) > 0; });
    if (!items.length) return err_('Giỏ hàng đang trống.', 'ERR_NO_ITEMS');

    var shift = posOpenShiftOf_();
    if (!shift) return err_('Chưa mở ca bán hàng. Hãy bấm "Mở ca" trước khi bán.', 'ERR_POS_NO_SHIFT');

    // Nhân viên không được cấp quyền giảm giá thì mọi khoản giảm đều bị bỏ qua.
    var mayDiscount = !AUTH_CTX_ || authHasExtra_(AUTH_CTX_, 'discount');
    var subtotal = items.reduce(function (s, it) { return s + toNumber(it.Quantity) * toNumber(it.SalePrice); }, 0);
    var discount = mayDiscount ? Math.max(0, toNumber(data.Discount)) : 0;
    if (mayDiscount && toNumber(data.DiscountPercent) > 0) {
      discount = Math.max(discount, roundMoney_(subtotal * Math.min(100, toNumber(data.DiscountPercent)) / 100));
    }
    if (discount > subtotal) discount = subtotal;

    var customerId = data.CustomerID;
    if (!customerId) customerId = posWalkInCustomer_().CustomerID;

    var vatPercent = toNumber(data.VATPercent);
    var vat = roundMoney_(Math.max(0, subtotal - discount) * vatPercent / 100);
    var total = Math.max(0, subtotal - discount + vat);
    var paid = (data.PaidAmount === undefined || data.PaidAmount === null || data.PaidAmount === '')
      ? total : Math.max(0, toNumber(data.PaidAmount));
    if (paid > total) paid = total;
    var cashReceived = Math.max(0, toNumber(data.CashReceived));
    var method = data.Method || 'Tiền mặt';
    if (method === 'Tiền mặt' && cashReceived > 0 && cashReceived < paid) {
      return err_('Khách đưa ' + formatMoney_(cashReceived) + ' nhưng cần thu ' + formatMoney_(paid) + '.', 'ERR_POS_CASH');
    }

    var res = createSalesOrder({
      CustomerID: customerId, SalesDate: data.SalesDate || new Date(),
      WarehouseID: data.WarehouseID || shift.WarehouseID || '',
      Discount: discount, VATPercent: vatPercent, ShippingFee: 0,
      PaidAmount: paid, Method: method, AccountID: data.AccountID || shift.AccountID || '',
      Notes: data.Notes || '', ClientRef: data.ClientRef || '',
      items: items.map(function (it) { return { ProductID: it.ProductID, Quantity: toNumber(it.Quantity), SalePrice: toNumber(it.SalePrice) }; }),
      __locked: true
    });
    if (!res || !res.success) return res;

    var salesId = res.data && (res.data.SalesID || res.data.id);
    var change = (method === 'Tiền mặt' && cashReceived > 0) ? Math.max(0, cashReceived - paid) : 0;
    updateRowById('SalesOrders', 'SalesID', salesId, {
      Channel: POS_CHANNEL_, ShiftID: shift.ShiftID,
      CashReceived: cashReceived || '', ChangeGiven: change || ''
    });
    writeAudit_('Bán tại quầy', 'Hóa đơn', salesId,
      formatMoney_(total) + ' · ' + method + ' · ca ' + shift.ShiftCode);
    return ok_({
      SalesID: salesId, ShiftID: shift.ShiftID, ShiftCode: shift.ShiftCode,
      Subtotal: subtotal, Discount: discount, VAT: vat, TotalAmount: total,
      PaidAmount: paid, ReceivableAmount: Math.max(0, total - paid),
      CashReceived: cashReceived, ChangeGiven: change, Method: method
    }, 'Đã bán ' + formatMoney_(total) + (change > 0 ? (' · Thối lại ' + formatMoney_(change)) : ''));
  } catch (e) { return err_(e.message); }
}

/** Các đơn đã bán trong ca — dùng cho danh sách bên phải màn hình POS. */
function getPosOrders(shiftId) {
  try {
    var list = sheetToObjects_('SalesOrders').filter(function (o) {
      return shiftId ? String(o.ShiftID || '') === String(shiftId) : String(o.Channel || '') === POS_CHANNEL_;
    });
    return ok_(list.slice(-200).reverse());
  } catch (e) { return err_(e.message); }
}

/* ============================================================================
 *  CHẠY TAY MỘT LẦN TRONG APPS SCRIPT: setupPosModule()
 * ========================================================================== */
function setupPosModule() {
  var changed = [];
  try { changed = ensureSchemaColumns_(true); } catch (e) { console.warn('[setupPosModule]', (e && e.message) || String(e));  }
  var msg = 'Đã bật module POS bán tại quầy. Vào menu "Bán tại quầy" để mở ca và bán hàng.';
  if (changed.length) msg = 'Đã bổ sung cột cho: ' + changed.join(', ') + '. ' + msg;
  try { SpreadsheetApp.getUi().alert(msg); } catch (e) { console.warn('[setupPosModule]', (e && e.message) || String(e));  }
  return ok_({ changed: changed }, msg);
}

/* Đăng ký phân quyền cho module POS. */
(function () {
  var M = {
    getPosBootstrap: 'pos', createPosOrder: 'pos', getPosOrders: 'pos',
    openPosShift: 'pos', closePosShift: 'pos', getCurrentPosShift: 'pos',
    getPosShifts: 'pos', getPosShiftDetail: 'pos', setupPosModule: 'users'
  };
  Object.keys(M).forEach(function (k) { FN_MODULE_[k] = M[k]; });
  FN_ACTION_.createPosOrder = 'c';
  FN_ACTION_.openPosShift = 'c';
  FN_ACTION_.closePosShift = 'e';
  SHEET_MODULE_.PosShifts = 'pos';
  BULK_KIND_MODULE_.posshift = 'pos';
  FN_AUDIT_.createPosOrder = ['Bán tại quầy', 'Hóa đơn'];
  FN_AUDIT_.openPosShift = ['Mở ca bán hàng', 'Ca bán hàng'];
  FN_AUDIT_.closePosShift = ['Đóng ca bán hàng', 'Ca bán hàng'];
})();
/* ===== HẾT MODULE POS BÁN TẠI QUẦY ===== */

/* ===== AMC MODULE: VAT TỪNG DÒNG + SỐ HÓA ĐƠN =====
 * Một chứng từ có thể có nhiều mức thuế suất khác nhau (0% / 5% / 8% / 10%).
 * Cách tính (đúng thông lệ kế toán VN):
 *    Chiết khấu được PHÂN BỔ THEO TỶ LỆ cho từng dòng hàng,
 *    rồi tiền thuế mỗi dòng = (tiền hàng dòng đó sau chiết khấu) x thuế suất dòng đó.
 *    Tổng thuế của chứng từ = cộng tiền thuế các dòng.
 *
 * Dòng nào KHÔNG khai thuế suất riêng thì cả chứng từ vẫn tính như cũ theo VAT chung —
 * cố ý giữ vậy để chứng từ cũ và cách nhập cũ không bị đổi số.
 *
 * SỐ HÓA ĐƠN (InvoiceNo) là số hóa đơn đỏ / hóa đơn điện tử do cơ quan thuế quản,
 * TÁCH HẲN khỏi mã chứng từ nội bộ (HD0001) để không lẫn hai loại số với nhau.
 * ========================================================================== */

var VAT_RATES_ = [0, 5, 8, 10];
var VAT_DOC_CTX_ = null;     // số hóa đơn của chứng từ đang lập

function installVatSchema_() {
  ['VATPercent', 'VATAmount'].forEach(function (c) {
    ['SalesItems', 'PurchaseItems', 'QuoteItems'].forEach(function (sh) {
      if (SCHEMA[sh] && SCHEMA[sh].indexOf(c) < 0) SCHEMA[sh].push(c);
    });
  });
  ['InvoiceNo', 'InvoiceSerial', 'InvoiceDate'].forEach(function (c) {
    ['SalesOrders', 'PurchaseOrders'].forEach(function (sh) {
      if (SCHEMA[sh] && SCHEMA[sh].indexOf(c) < 0) SCHEMA[sh].push(c);
    });
  });

  ['SalesItems', 'PurchaseItems', 'QuoteItems'].forEach(function (sh) {
    LABELS[sh] = LABELS[sh] || {};
    LABELS[sh].VATPercent = 'Thuế suất (%)';
    LABELS[sh].VATAmount = 'Tiền thuế';
  });
  ['SalesOrders', 'PurchaseOrders'].forEach(function (sh) {
    LABELS[sh] = LABELS[sh] || {};
    LABELS[sh].InvoiceNo = 'Số hóa đơn';
    LABELS[sh].InvoiceSerial = 'Ký hiệu hóa đơn';
    LABELS[sh].InvoiceDate = 'Ngày hóa đơn';
  });
  if (typeof MONEY_COLS !== 'undefined' && MONEY_COLS.indexOf('VATAmount') < 0) MONEY_COLS.push('VATAmount');
}
installVatSchema_();

/**
 * Tính thuế cho từng dòng.
 *  items   : mảng dòng hàng do giao diện gửi lên (có thể mang VATPercent riêng)
 *  amounts : tiền hàng từng dòng TRƯỚC chiết khấu, cùng thứ tự với items
 *  Trả về { vat, lines:[{p, a}], perLine }
 */
function vatLines_(items, amounts, subtotal, discount, headerPercent) {
  items = items || []; amounts = amounts || [];
  var perLine = items.some(function (it) {
    return it && it.VATPercent !== undefined && it.VATPercent !== null && String(it.VATPercent) !== '';
  });
  var sub = toNumber(subtotal);
  var base = Math.max(0, sub - toNumber(discount));
  var ratio = sub > 0 ? base / sub : 0;
  var out = { vat: 0, lines: [], perLine: perLine };
  var sum = 0;
  amounts.forEach(function (amt, i) {
    var p = perLine ? Math.max(0, toNumber((items[i] || {}).VATPercent)) : toNumber(headerPercent);
    var a = roundMoney_(toNumber(amt) * ratio * p / 100);
    out.lines.push({ p: p, a: a });
    sum += a;
  });
  // Không khai theo dòng -> giữ ĐÚNG cách tính cũ để chứng từ cũ không đổi số một xu nào.
  out.vat = perLine ? roundMoney_(sum) : roundMoney_(base * toNumber(headerPercent) / 100);
  return out;
}

/** Ghi thuế suất & tiền thuế vào các dòng hàng đã dựng sẵn. */
function vatStampItems_(rows, vatInfo) {
  (rows || []).forEach(function (r, i) {
    var l = (vatInfo && vatInfo.lines && vatInfo.lines[i]) || { p: 0, a: 0 };
    r.VATPercent = l.p;
    r.VATAmount = l.a;
  });
  return rows;
}

/** Nhớ số hóa đơn của chứng từ đang lập để đóng dấu khi ghi dòng. */
function vatEnter_(data) {
  try {
    if (!data || typeof data !== 'object') { VAT_DOC_CTX_ = null; return; }
    var no = String(data.InvoiceNo == null ? '' : data.InvoiceNo).trim();
    var se = String(data.InvoiceSerial == null ? '' : data.InvoiceSerial).trim();
    var dt = data.InvoiceDate ? docDate_(data.InvoiceDate) : '';
    VAT_DOC_CTX_ = (no || se || dt) ? { InvoiceNo: no, InvoiceSerial: se, InvoiceDate: dt } : null;
  } catch (e) { console.warn('[vatEnter_]', (e && e.message) || String(e));  VAT_DOC_CTX_ = null; }
}

/** Đóng dấu số hóa đơn lên chứng từ vừa ghi (gọi từ appendRow/appendRows). */
function vatStampRows_(sheetName, rows) {
  try {
    if (!VAT_DOC_CTX_) return;
    if (sheetName !== 'SalesOrders' && sheetName !== 'PurchaseOrders') return;
    (rows || []).forEach(function (r) {
      if (!r || typeof r !== 'object') return;
      if (!r.InvoiceNo) r.InvoiceNo = VAT_DOC_CTX_.InvoiceNo;
      if (!r.InvoiceSerial) r.InvoiceSerial = VAT_DOC_CTX_.InvoiceSerial;
      if (!r.InvoiceDate) r.InvoiceDate = VAT_DOC_CTX_.InvoiceDate;
    });
  } catch (e) { console.warn('[vatStampRows_]', (e && e.message) || String(e));  }
}

/** Sửa chứng từ và có nhập lại số hóa đơn -> ghi đè lên chứng từ. */
function vatUpdateDocInvoice_(sheetName, idKey, idValue) {
