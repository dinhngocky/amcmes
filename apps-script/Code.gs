/**
 * Đọc cấu hình công đoạn điện từ Settings.
 * Trả về mảng [{code, label, sortOrder}].
 */
function getElecStagesConfig_() {
  try {
    var settings = settings_();
    var raw = settings.ProductionElecStages;
    if (!raw) return ELEC_STAGES_DEFAULT_.slice();
    var parsed = JSON.parse(raw);
    if (!Array.isArray(parsed) || !parsed.length) return ELEC_STAGES_DEFAULT_.slice();
    return parsed.map(function (x, i) {
      return {
        code: String(x.code || '').toUpperCase().replace(/[^A-Z0-9_]/g, '_'),
        label: String(x.label || x.code || ''),
        sortOrder: i + 1
      };
    }).filter(function (x) { return x.code; });
  } catch (e) {
    console.warn('[getElecStagesConfig_]', (e && e.message) || String(e));
    return ELEC_STAGES_DEFAULT_.slice();
  }
}

/**
 * Lấy danh sách module cơ khí từ BOM của máy.
 * Ưu tiên bản RELEASED mới nhất. Nếu chưa có BOM → trả về rỗng.
 */
function getMachineModulesFromBOM_(machineId) {
  var versions = sheetToObjects_('MachineBOMVersions').filter(function (v) {
    return String(v.MachineID) === String(machineId)
      && amcvnText_(v.Status).toUpperCase() === 'RELEASED';
  });
  versions = machineBomSortVersions_(versions);
  var releasedVersion = versions[0];
  if (!releasedVersion) {
    // Fallback: nếu chưa có bản RELEASED → lấy bản DRAFT mới nhất
    var drafts = sheetToObjects_('MachineBOMVersions').filter(function (v) {
      return String(v.MachineID) === String(machineId);
    });
    drafts = machineBomSortVersions_(drafts);
    releasedVersion = drafts[0];
  }
  if (!releasedVersion) return [];

  var lines = machineBomLines_(releasedVersion.BOMVersionID);

  // Nhóm theo ModuleID/ModuleCode để lấy unique modules
  var moduleMap = {};
  var order = [];
  lines.forEach(function (l) {
    var key = String(l.ModuleID || l.ModuleCode || '').trim();
    if (!key) return;
    if (!moduleMap[key]) {
      moduleMap[key] = {
        moduleId: l.ModuleID || '',
        moduleCode: l.ModuleCode || key,
        moduleName: l.ModuleName || l.ModuleCode || key,
        moduleDrawingNo: l.ModuleDrawingNo || '',
        lineCount: 0,
        bomVersionId: releasedVersion.BOMVersionID
      };
      order.push(key);
    }
    moduleMap[key].lineCount++;
  });

  return order.map(function (key) { return moduleMap[key]; });
}

/**
 * Lấy hoặc TỰ TẠO cây công đoạn cho máy.
 * Nếu máy chưa có ProductionStages → tạo từ BOM (mech) + config (elec).
 * Nếu BOM thay đổi → thêm module mới, node cũ không còn trong BOM → đánh dấu IsOrphan.
 */
function syncProductionStages_(machineId) {
  var machine = amcvnFind_('Machines', 'MachineID', machineId);
  if (!machine) throw new Error('Không tìm thấy máy.');

  var existingStages = sheetToObjects_('ProductionStages').filter(function (s) {
    return String(s.MachineID) === String(machineId);
  });

  var existingByKey = {};
  existingStages.forEach(function (s) {
    existingByKey[String(s.GroupCode) + '|' + String(s.StageCode)] = s;
  });

  var modules = getMachineModulesFromBOM_(machineId);
  var elecStages = getElecStagesConfig_();
  var now = new Date();
  var dri = amcvnText_(machine.Owner) || amcvnText_(machine.LeadEngineer) || '';
  var toCreate = [];
  var toUpdateOrphan = {};

  // Đánh dấu tất cả là orphan trước, sau đó "cứu" những node còn tồn tại
  var stillValidKeys = {};

  // === Nhóm MECH: 1 group header + N module con ===
  var mechGroupKey = 'MECH|__GROUP__';
  stillValidKeys[mechGroupKey] = true;
  if (!existingByKey[mechGroupKey]) {
    toCreate.push({
      StageID: generateId('STG'),
      MachineID: machineId,
      ProjectID: machine.ProjectID,
      GroupCode: 'MECH',
      GroupLabel: 'Mechanical Assembly',
      StageCode: '__GROUP__',
      StageName: 'Mechanical Assembly',
      ModuleID: '',
      ParentStageID: '',
      SortOrder: 0,
      TargetDate: '',
      ProgressPercent: 0,
      Status: 'NOT_STARTED',
      DRI: dri,
      OwnerID: '',
      OwnerName: '',
      Notes: '',
      IsOrphan: false,
      CreatedAt: now,
      UpdatedAt: now
    });
  }

  modules.forEach(function (m, i) {
    var code = 'MOD_' + (m.moduleId || m.moduleCode).replace(/[^A-Za-z0-9]/g, '_');
    var key = 'MECH|' + code;
    stillValidKeys[key] = true;
    if (!existingByKey[key]) {
      toCreate.push({
        StageID: generateId('STG'),
        MachineID: machineId,
        ProjectID: machine.ProjectID,
        GroupCode: 'MECH',
        GroupLabel: 'Mechanical Assembly',
        StageCode: code,
        StageName: m.moduleName || m.moduleCode,
        ModuleID: m.moduleId,
        ParentStageID: '',
        SortOrder: i + 1,
        TargetDate: '',
        ProgressPercent: 0,
        Status: 'NOT_STARTED',
        DRI: dri,
        OwnerID: '',
        OwnerName: '',
        Notes: m.moduleDrawingNo ? ('DWG: ' + m.moduleDrawingNo) : '',
        IsOrphan: false,
        CreatedAt: now,
        UpdatedAt: now
      });
    }
  });

  // === Nhóm ELEC: 1 group header + 5 stage con ===
  var elecGroupKey = 'ELEC|__GROUP__';
  stillValidKeys[elecGroupKey] = true;
  if (!existingByKey[elecGroupKey]) {
    toCreate.push({
      StageID: generateId('STG'),
      MachineID: machineId,
      ProjectID: machine.ProjectID,
      GroupCode: 'ELEC',
      GroupLabel: 'Electrical Assembly',
      StageCode: '__GROUP__',
      StageName: 'Electrical Assembly',
      ModuleID: '',
      ParentStageID: '',
      SortOrder: 0,
      TargetDate: '',
      ProgressPercent: 0,
      Status: 'NOT_STARTED',
      DRI: dri,
      OwnerID: '',
      OwnerName: '',
      Notes: '',
      IsOrphan: false,
      CreatedAt: now,
      UpdatedAt: now
    });
  }

  elecStages.forEach(function (st, i) {
    var key = 'ELEC|' + st.code;
    stillValidKeys[key] = true;
    if (!existingByKey[key]) {
      toCreate.push({
        StageID: generateId('STG'),
        MachineID: machineId,
        ProjectID: machine.ProjectID,
        GroupCode: 'ELEC',
        GroupLabel: 'Electrical Assembly',
        StageCode: st.code,
        StageName: st.label,
        ModuleID: '',
        ParentStageID: '',
        SortOrder: i + 1,
        TargetDate: '',
        ProgressPercent: 0,
        Status: 'NOT_STARTED',
        DRI: dri,
        OwnerID: '',
        OwnerName: '',
        Notes: '',
        IsOrphan: false,
        CreatedAt: now,
        UpdatedAt: now
      });
    }
  });

  // === Nhóm đơn: IO, DEBUG, FAT, CLEAN ===
  ['IO', 'DEBUG', 'FAT', 'CLEAN'].forEach(function (gc) {
    var key = gc + '|' + gc;
    stillValidKeys[key] = true;
    if (!existingByKey[key]) {
      var grp = STAGE_GROUPS_.filter(function (g) { return g.code === gc; })[0] || { label: gc };
      toCreate.push({
        StageID: generateId('STG'),
        MachineID: machineId,
        ProjectID: machine.ProjectID,
        GroupCode: gc,
        GroupLabel: grp.label,
        StageCode: gc,
        StageName: grp.label,
        ModuleID: '',
        ParentStageID: '',
        SortOrder: 0,
        TargetDate: '',
        ProgressPercent: 0,
        Status: 'NOT_STARTED',
        DRI: dri,
        OwnerID: '',
        OwnerName: '',
        Notes: '',
        IsOrphan: false,
        CreatedAt: now,
        UpdatedAt: now
      });
    }
  });

  // Đánh dấu node cũ không còn trong BOM/config là orphan
  existingStages.forEach(function (s) {
    var key = String(s.GroupCode) + '|' + String(s.StageCode);
    if (!stillValidKeys[key] && !toUpdateOrphan[s.StageID]) {
      toUpdateOrphan[s.StageID] = { IsOrphan: true, UpdatedAt: now };
    }
  });

  if (toCreate.length) {
    appendRows('ProductionStages', toCreate);
  }
  if (Object.keys(toUpdateOrphan).length) {
    updateRowsById_('ProductionStages', 'StageID', toUpdateOrphan);
  }

  // Trả về toàn bộ sau khi sync
  return sheetToObjects_('ProductionStages').filter(function (s) {
    return String(s.MachineID) === String(machineId);
  });
}

/**
 * API: Lấy cây công đoạn của máy.
 * Trả về: { machine, groups: [...] }
 *
 * Mỗi group có dạng:
 * {
 *   code, label, icon, hasChildren,
 *   children: [{ stageId, stageCode, stageName, targetDate, progressPercent, status, ... }],
 *   targetDate,          // Chỉ tính cho group có con (min target của con)
 *   averageProgress,     // Chỉ tính cho MECH và ELEC
 *   hasAverage: bool     // true cho MECH, ELEC
 * }
 */
function getProductionStages(machineId) {
  try {
    var machine = amcvnFind_('Machines', 'MachineID', machineId);
    if (!machine) return err_('Không tìm thấy máy.', 'ERR_NOT_FOUND');

    var project = amcvnFind_('Projects', 'ProjectID', machine.ProjectID);

    // Đảm bảo có stages
    var stages = syncProductionStages_(machineId);

    // Nhóm theo GroupCode
    var byGroup = {};
    stages.forEach(function (s) {
      var gc = String(s.GroupCode || '');
      if (!byGroup[gc]) byGroup[gc] = [];
      byGroup[gc].push(s);
    });

    // Build groups theo thứ tự STAGE_GROUPS_
    var groups = STAGE_GROUPS_.map(function (g) {
      var list = byGroup[g.code] || [];
      var groupHeader = list.filter(function (s) { return String(s.StageCode) === '__GROUP__' || !g.hasChildren; })[0];
      var children = list.filter(function (s) {
        if (String(s.StageCode) === '__GROUP__') return false;
        if (!g.hasChildren) return false; // nhóm đơn không có con
        return true;
      });

      // Sắp xếp con theo SortOrder
      children.sort(function (a, b) {
        return toNumber(a.SortOrder) - toNumber(b.SortOrder);
      });

      // Với nhóm đơn, chính node đó là con của nó trong view
      var displayChildren = g.hasChildren ? children : (groupHeader ? [groupHeader] : []);

      // Target date của group = min target của các con (nếu có)
      var groupTarget = '';
      children.forEach(function (c) {
        if (c.TargetDate) {
          var d = parseDate_(c.TargetDate);
          if (d && (!groupTarget || d < groupTarget)) groupTarget = d;
        }
      });

      // Average = trung bình cộng đơn giản của các con (chỉ khi hasChildren)
      var average = null;
      if (g.hasChildren && children.length) {
        var sum = children.reduce(function (acc, c) { return acc + toNumber(c.ProgressPercent); }, 0);
        average = Math.round(sum / children.length);
      }

      return {
        code: g.code,
        label: g.label,
        icon: g.icon,
        hasChildren: g.hasChildren,
        hasAverage: g.hasChildren && children.length > 0,
        groupStageId: groupHeader ? groupHeader.StageID : '',
        groupTargetDate: groupTarget ? Utilities.formatDate(groupTarget, getTz_(), 'yyyy-MM-dd') : '',
        averageProgress: average,
        children: displayChildren.map(function (c) {
          return {
            stageId: c.StageID,
            stageCode: c.StageCode,
            stageName: c.StageName,
            moduleId: c.ModuleID || '',
            targetDate: c.TargetDate ? Utilities.formatDate(parseDate_(c.TargetDate) || new Date(c.TargetDate), getTz_(), 'yyyy-MM-dd') : '',
            progressPercent: toNumber(c.ProgressPercent),
            status: c.Status || 'NOT_STARTED',
            dri: c.DRI || '',
            ownerName: c.OwnerName || '',
            notes: c.Notes || '',
            isOrphan: productBool_(c.IsOrphan),
            updatedAt: c.UpdatedAt || ''
          };
        })
      };
    });

    // Thông tin quyền
    var me = AUTH_CTX_ ? (AUTH_CTX_.FullName || AUTH_CTX_.Username || '') : getUser_();
    var driOfMachine = amcvnText_(machine.Owner) || amcvnText_(machine.LeadEngineer) || '';
    var isAdmin = AUTH_CTX_ ? authIsAdmin_(AUTH_CTX_) : true;
    var canEdit = isAdmin || (driOfMachine && me && String(me).trim().toLowerCase() === String(driOfMachine).trim().toLowerCase());

    return ok_({
      machine: {
        MachineID: machine.MachineID,
        MachineCode: machine.MachineCode,
        MachineName: machine.MachineName,
        MachineModel: machine.MachineModel,
        ProjectCode: (project && project.ProjectCode) || machine.ProjectCode || '',
        ProjectName: (project && project.ProjectName) || '',
        DRI: driOfMachine,
        Status: machine.Status,
        ProgressPercent: toNumber(machine.ProgressPercent),
        CurrentStage: machine.CurrentStage,
        PlanFATDate: machine.PlanFATDate,
        PlanShipDate: machine.PlanShipDate
      },
      groups: groups,
      canEdit: canEdit,
      currentUser: me
    });
  } catch (e) {
    return err_(e, 'ERR_STAGE_TREE');
  }
}

/**
 * Cập nhật 1 ô công đoạn (target + progress + notes).
 * Chỉ DRI hoặc Admin.
 */
function updateStageProgress(stageId, data) {
  data = data || {};
  return withMutationLock_(['ProductionStages', 'Machines', 'Projects'], function () {
    try {
      var stage = amcvnFind_('ProductionStages', 'StageID', stageId);
      if (!stage) return err_('Không tìm thấy công đoạn.', 'ERR_NOT_FOUND');

      // Check quyền
      var machine = amcvnFind_('Machines', 'MachineID', stage.MachineID);
      if (!machine) return err_('Không tìm thấy máy.', 'ERR_NOT_FOUND');

      var me = AUTH_CTX_ ? (AUTH_CTX_.FullName || AUTH_CTX_.Username || '') : getUser_();
      var driOfMachine = amcvnText_(machine.Owner) || amcvnText_(machine.LeadEngineer) || '';
      var isAdmin = AUTH_CTX_ ? authIsAdmin_(AUTH_CTX_) : true;
      var canEdit = isAdmin || (driOfMachine && me && String(me).trim().toLowerCase() === String(driOfMachine).trim().toLowerCase());
      if (!canEdit) {
        return err_('Chỉ DRI của máy (' + (driOfMachine || 'chưa gán') + ') hoặc quản trị viên mới được cập nhật tiến độ.', 'ERR_STAGE_PERM');
      }

      var upd = { UpdatedAt: new Date(), OwnerID: (AUTH_CTX_ && AUTH_CTX_.UserID) || '', OwnerName: me };

      if (data.ProgressPercent !== undefined) {
        var pct = Math.max(0, Math.min(100, toNumber(data.ProgressPercent)));
        upd.ProgressPercent = pct;
        // Tự suy status
        if (pct >= 100) upd.Status = 'DONE';
        else if (pct > 0) upd.Status = 'IN_PROGRESS';
        else upd.Status = 'NOT_STARTED';
      }
      if (data.TargetDate !== undefined) {
        upd.TargetDate = data.TargetDate ? docDate_(data.TargetDate) : '';
      }
      if (data.Notes !== undefined) {
        upd.Notes = String(data.Notes || '').trim();
      }
      if (data.Status !== undefined && ['NOT_STARTED', 'IN_PROGRESS', 'DONE', 'BLOCKED'].indexOf(String(data.Status)) >= 0) {
        upd.Status = String(data.Status);
      }

      updateRowById('ProductionStages', 'StageID', stageId, upd);

      // Cập nhật lại ProgressPercent của máy = trung bình của các công đoạn con (không phải nhóm)
      recalculateMachineProgress_(stage.MachineID);

      writeAudit_('Cập nhật công đoạn', 'ProductionStage', stageId,
        machine.MachineCode + ' · ' + stage.StageName + ' · ' + (upd.ProgressPercent != null ? upd.ProgressPercent + '%' : ''));

      return ok_({ stageId: stageId }, 'Đã cập nhật ' + stage.StageName);
    } catch (e) {
      return err_(e, 'ERR_STAGE_UPDATE');
    }
  });
}

/**
 * Cập nhật cả nhóm công đoạn (nhiều ô cùng lúc).
 * data: { updates: [{ stageId, progressPercent, targetDate, notes }], groupNotes }
 */
function updateStageGroupProgress(machineId, groupCode, data) {
  data = data || {};
  return withMutationLock_(['ProductionStages', 'Machines'], function () {
    try {
      var machine = amcvnFind_('Machines', 'MachineID', machineId);
      if (!machine) return err_('Không tìm thấy máy.', 'ERR_NOT_FOUND');

      // Check quyền
      var me = AUTH_CTX_ ? (AUTH_CTX_.FullName || AUTH_CTX_.Username || '') : getUser_();
      var driOfMachine = amcvnText_(machine.Owner) || amcvnText_(machine.LeadEngineer) || '';
      var isAdmin = AUTH_CTX_ ? authIsAdmin_(AUTH_CTX_) : true;
      var canEdit = isAdmin || (driOfMachine && me && String(me).trim().toLowerCase() === String(driOfMachine).trim().toLowerCase());
      if (!canEdit) {
        return err_('Chỉ DRI của máy (' + (driOfMachine || 'chưa gán') + ') hoặc quản trị viên mới được cập nhật.', 'ERR_STAGE_PERM');
      }

      var updates = data.updates || [];
      if (!updates.length) return err_('Không có dòng nào để cập nhật.', 'ERR_STAGE_EMPTY');

      var now = new Date();
      var updatesMap = {};
      updates.forEach(function (u) {
        if (!u.stageId) return;
        var row = {};
        if (u.progressPercent !== undefined) {
          var pct = Math.max(0, Math.min(100, toNumber(u.progressPercent)));
          row.ProgressPercent = pct;
          row.Status = pct >= 100 ? 'DONE' : (pct > 0 ? 'IN_PROGRESS' : 'NOT_STARTED');
        }
        if (u.targetDate !== undefined) {
          row.TargetDate = u.targetDate ? docDate_(u.targetDate) : '';
        }
        if (u.notes !== undefined) {
          row.Notes = String(u.notes || '').trim();
        }
        row.UpdatedAt = now;
        row.OwnerID = (AUTH_CTX_ && AUTH_CTX_.UserID) || '';
        row.OwnerName = me;
        updatesMap[u.stageId] = row;
      });

      updateRowsById_('ProductionStages', 'StageID', updatesMap);
      recalculateMachineProgress_(machineId);

      writeAudit_('Cập nhật nhóm công đoạn', 'Machine', machineId,
        groupCode + ' · ' + updates.length + ' dòng');

      return ok_({ updated: Object.keys(updatesMap).length }, 'Đã cập nhật ' + Object.keys(updatesMap).length + ' công đoạn');
    } catch (e) {
      return err_(e, 'ERR_STAGE_GROUP_UPDATE');
    }
  });
}

/**
 * Tính lại ProgressPercent của máy = trung bình các stage CON (không tính group header, không tính orphan).
 * Ghi vào Machines.ProgressPercent.
 */
function recalculateMachineProgress_(machineId) {
  var stages = sheetToObjects_('ProductionStages').filter(function (s) {
    return String(s.MachineID) === String(machineId)
      && String(s.StageCode) !== '__GROUP__'
      && !productBool_(s.IsOrphan);
  });
  if (!stages.length) return;
  var sum = stages.reduce(function (acc, s) { return acc + toNumber(s.ProgressPercent); }, 0);
  var avg = Math.round(sum / stages.length);
  updateRowById('Machines', 'MachineID', machineId, {
    ProgressPercent: avg,
    UpdatedAt: new Date()
  });
}

/**
 * Lấy cấu hình công đoạn điện.
 */
function getProductionStageConfig() {
  try {
    var elec = getElecStagesConfig_();
    return ok_({
      elecStages: elec,
      groups: STAGE_GROUPS_.map(function (g) {
        return { code: g.code, label: g.label, icon: g.icon, hasChildren: g.hasChildren, source: g.source };
      })
    });
  } catch (e) {
    return err_(e, 'ERR_STAGE_CONFIG');
  }
}

/**
 * Lưu cấu hình công đoạn điện. Chỉ Admin.
 * data: { elecStages: [{code, label}] }
 */
function saveProductionStageConfig(data) {
  data = data || {};
  return withMutationLock_(['Settings', 'ProductionStages'], function () {
    try {
      if (AUTH_CTX_ && !authIsAdmin_(AUTH_CTX_)) {
        return err_('Chỉ quản trị viên mới đổi được cấu hình công đoạn.', 'ERR_STAGE_CONFIG_PERM');
      }
      var list = data.elecStages || [];
      if (!Array.isArray(list)) return err_('Dữ liệu không hợp lệ.', 'ERR_STAGE_CONFIG_DATA');

      var cleaned = list.map(function (x, i) {
        return {
          code: String(x.code || '').toUpperCase().replace(/[^A-Z0-9_]/g, '_'),
          label: String(x.label || '').trim(),
          sortOrder: i + 1
        };
      }).filter(function (x) { return x.code && x.label; });

      if (!cleaned.length) return err_('Cần ít nhất 1 công đoạn điện.', 'ERR_STAGE_CONFIG_EMPTY');

      // Kiểm tra trùng code
      var codeSet = {};
      for (var i = 0; i < cleaned.length; i++) {
        if (codeSet[cleaned[i].code]) return err_('Mã công đoạn trùng: ' + cleaned[i].code, 'ERR_STAGE_CONFIG_DUP');
        codeSet[cleaned[i].code] = true;
      }

      updateSetting('ProductionElecStages', JSON.stringify(cleaned));
      return ok_({ elecStages: cleaned }, 'Đã lưu cấu hình công đoạn điện (' + cleaned.length + ' bước)');
    } catch (e) {
      return err_(e, 'ERR_STAGE_CONFIG_SAVE');
    }
  });
}

