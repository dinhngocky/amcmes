/* Phát hành BOM đồng thời vô hiệu mọi bản cũ và cập nhật CTB/PR/kit/sản xuất. */
function releaseMachineBOMVersion(versionId,data){
  data=data||{};
  var locks=['MachineBOMVersions','MachineBOMLines','BOMECNLogs','Products','Projects','Machines','MachineModules','MaterialRequirements','MaterialStatusLogs','MaterialExceptions',
    'PurchaseRequisitions','PurchaseRequisitionItems','PurchaseItems','PurchaseOrders','WarehouseReceiptItems','IQCInspections','MaterialKits','MaterialKitItems','MaterialReservations','MaterialLocations','StockMovements','ProductionOrders','AuditLog'];
  if(!data.__locked)return runLocked_(data,'__locked',locks,function(){return releaseMachineBOMVersion(versionId,data);});
  try{
    var version=machineBomVersion_(versionId);
    if(!version)return err_('Không tìm thấy phiên bản BOM.');
    if(!machineBomDraft_(version))return err_('Chỉ bản DRAFT mới có thể phát hành.');
    var lines=machineBomLines_(versionId);if(!lines.length)return err_('Không thể phát hành BOM chưa có dòng vật tư.');
    var releasedAll=machineBomSortVersions_(sheetToObjects_('MachineBOMVersions').filter(function(x){return String(x.MachineID)===String(version.MachineID)&&amcvnText_(x.Status).toUpperCase()==='RELEASED';}));
    var previous=releasedAll[0]||null,ecnNo=amcvnText_(data.ECNNo||version.ECNNo),ecnNote=amcvnText_(data.ECNNote||version.ECNNote);
    if(previous&&(!ecnNo||!ecnNote))return err_('Phiên bản thay đổi phải có Số ECN và Nội dung ECN.');
    var now=new Date(),diff=machineBomCompare_(previous?previous.BOMVersionID:'',versionId),obsolete={};
    releasedAll.forEach(function(v){obsolete[v.BOMVersionID]={Status:'OBSOLETE',UpdatedAt:now};});
    if(Object.keys(obsolete).length)updateRowsById_('MachineBOMVersions','BOMVersionID',obsolete);
    updateRowById('MachineBOMVersions','BOMVersionID',versionId,{ECNNo:ecnNo,ECNNote:ecnNote,EffectiveDate:data.EffectiveDate||version.EffectiveDate||now,Status:'RELEASED',TotalLines:lines.length,ReleasedBy:getUser_(),ReleasedAt:now,UpdatedAt:now});
    appendRow('BOMECNLogs',{ECNLogID:generateId('ECN'),ProjectID:version.ProjectID,MachineID:version.MachineID,BOMVersionID:versionId,FromVersion:previous?previous.VersionNo:'',ToVersion:version.VersionNo,ECNNo:ecnNo,ECNNote:ecnNote,AddedLines:diff.counts.added,UpdatedLines:diff.counts.updated,DeletedLines:diff.counts.deleted,EffectiveDate:data.EffectiveDate||version.EffectiveDate||now,ReleasedBy:getUser_(),ReleasedAt:now,CreatedAt:now});
    var current=machineBomVersion_(versionId),reconcile=v218ReconcileReleasedBOM_(version.MachineID,current,previous&&previous.BOMVersionID||'');
    writeAudit_('Phát hành BOM máy','MachineBOMVersion',versionId,version.VersionNo+(ecnNo?' / '+ecnNo:'')+' · CTB tự động');
    return ok_({version:machineBomVersion_(versionId),diff:diff,materialSyncRequired:false,reconcile:reconcile},'Đã phát hành BOM '+version.VersionNo+' và tự động cập nhật CTB/đề nghị mua/kit/sản xuất.');
  }catch(e){return err_(e.message);}
}

/* Gắn BOM hiện hành cho chứng từ hạ nguồn; giao dịch đã duyệt được giữ số lượng và gắn cờ rà soát ECN. */
function v218UpdateDownstream_(machineId,version,reqsByProduct){
  var now=new Date(),reviewRequests={},reviewPurchases={};
  function targetFor(x){
    var rows=reqsByProduct[String(x.ProductID||'')]||[];
    return rows.filter(function(r){return String(r.ModuleID||'')===String(x.ModuleID||'');})[0]||rows[0]||null;
  }
  [['PurchaseRequisitionItems','RequestItemID'],['PurchaseItems','PurchaseItemID'],['MaterialKitItems','KitItemID']].forEach(function(s){
    var updates={};
    try{
      sheetToObjects_(s[0]).forEach(function(x){
        if(String(x.MachineID||'')!==String(machineId))return;
        var t=targetFor(x),u={BOMVersionID:version.BOMVersionID},review=false;
        if(!t){u.ECNChangeType='REMOVED';review=true;}
        else{
          u.RequirementID=t.RequirementID;u.ProjectID=t.ProjectID;u.MachineID=t.MachineID;u.ModuleID=t.ModuleID;u.ECNChangeType=t.ECNChangeType||'UNCHANGED';
          review=String(x.RequirementID)!==String(t.RequirementID)||String(x.ModuleID||'')!==String(t.ModuleID||'')||toNumber(x.Quantity||x.RequiredQty)>toNumber(t.RequiredQty)+0.000001||['ADDED','UPDATED'].indexOf(u.ECNChangeType)>=0;
        }
        u.ECNReview=review?'YES':'';updates[x[s[1]]]=u;
        if(review&&x.RequestID)reviewRequests[x.RequestID]=true;
        if(review&&x.PurchaseID)reviewPurchases[x.PurchaseID]=true;
      });
      if(Object.keys(updates).length)updateRowsById_(s[0],s[1],updates);
    }catch(e){console.warn('[v218 downstream '+s[0]+']',e.message);}
  });
  try{
    var prUpdates={};Object.keys(reviewRequests).forEach(function(id){prUpdates[id]={ECNNo:version.ECNNo||'',ECNReview:'YES',UpdatedAt:now};});
    if(Object.keys(prUpdates).length)updateRowsById_('PurchaseRequisitions','RequestID',prUpdates);
    var poUpdates={};Object.keys(reviewPurchases).forEach(function(id){poUpdates[id]={BOMVersionID:version.BOMVersionID,ECNNo:version.ECNNo||'',ECNReview:'YES'};});
    if(Object.keys(poUpdates).length)updateRowsById_('PurchaseOrders','PurchaseID',poUpdates);
  }catch(e){console.warn('[v218 purchasing headers]',e.message);}
  try{
    var kitUpdates={};sheetToObjects_('MaterialKits').forEach(function(k){if(String(k.MachineID)===String(machineId)&&['RELEASED','CANCELLED'].indexOf(String(k.Status).toUpperCase())<0)kitUpdates[k.KitID]={BOMVersionID:version.BOMVersionID,ECNNo:version.ECNNo||'',UpdatedAt:now};});
    if(Object.keys(kitUpdates).length)updateRowsById_('MaterialKits','KitID',kitUpdates);
  }catch(e){console.warn('[v218 kits]',e.message);}
  try{
    var prodUpdates={};sheetToObjects_('ProductionOrders').forEach(function(p){if(String(p.MachineID)===String(machineId)&&['COMPLETED','CANCELLED','SHIPPED','ĐÃ HOÀN THÀNH','ĐÃ HỦY'].indexOf(String(p.Status).toUpperCase())<0)prodUpdates[p.ProductionID]={BOMVersionID:version.BOMVersionID,UpdatedAt:now};});
    if(Object.keys(prodUpdates).length)updateRowsById_('ProductionOrders','ProductionID',prodUpdates);
  }catch(e){console.warn('[v218 production]',e.message);}
}

/* ===================== AMCVN V20.19 - SIMPLE SUPPLIER QUOTATION IMPORT ===================== */
/**
 * NCC chỉ cần báo đơn giá cho các mặt hàng họ cung cấp.
 * VAT, leadtime, điều khoản thanh toán và hiệu lực được nhập một lần trên popup.
 */
function procNormalizeQuote_(id,data){
  data=data||{};
  var h=procFind_('ProcurementRFQs','RFQID',id);
  if(h.Status!=='OPEN')procFail_('RFQ không còn nhận báo giá.');
  var supplier=procFind_('Suppliers','SupplierID',data.SupplierID),lines={},seen={},out=[];
  procRows_('ProcurementRFQLines','RFQID',id).forEach(function(x){lines[x.RFQLineID]=x;});
  if(!Array.isArray(data.items)||!data.items.length)procFail_('File báo giá không có dữ liệu.');

  var vat=procNum_(data.VATPercent===undefined||data.VATPercent===''?0:data.VATPercent,'VAT',0);
  var lead=procNum_(data.LeadDays,'Leadtime',0);
  if(lead%1)procFail_('Leadtime phải là số ngày nguyên.');
  if(vat>100)procFail_('VAT phải trong khoảng 0–100%.');
  var terms=amcvnText_(data.PaymentTerms),until=amcvnText_(data.ValidUntil),validDay=procDay_(until);
  if(!terms)procFail_('Nhập điều khoản thanh toán áp dụng chung.');
  if(!/^\d{4}-\d{2}-\d{2}$/.test(until)||validDay!==until||validDay<procToday_())procFail_('Hiệu lực báo giá phải là yyyy-mm-dd và chưa hết hạn.');

  data.items.forEach(function(x,i){
    var line=lines[x.RFQLineID],prefix='Dòng '+(i+2)+': ';
    if(!line||String(x.RFQID)!==String(id))procFail_(prefix+'sai mã RFQ/dòng.');
    if(seen[x.RFQLineID])procFail_(prefix+'trùng dòng báo giá.');seen[x.RFQLineID]=true;
    if(String(x.PartNumber||'')!==String(line.PartNumber||'')||String(x.Unit||'')!==String(line.Unit||'')||procNum_(x.Quantity,prefix+'SL',0.000001)!==toNumber(line.Quantity))procFail_(prefix+'mã hàng, đơn vị hoặc số lượng đã bị thay đổi.');
    if(amcvnText_(x.Currency).toUpperCase()!==h.Currency)procFail_(prefix+'phải báo cùng tiền tệ '+h.Currency+'.');
    if(amcvnText_(x.UnitCost)==='')return;
    var cost=procNum_(x.UnitCost,prefix+'đơn giá',0.000001);
    out.push({RFQLineID:line.RFQLineID,ProductID:line.ProductID,PartNumber:line.PartNumber,Quantity:line.Quantity,
      UnitCost:cost,LeadDays:lead,VATPercent:vat,PaymentTerms:terms,ValidUntil:validDay,Notes:amcvnText_(x.Notes)});
  });
  if(!out.length)procFail_('NCC chưa nhập đơn giá cho mặt hàng nào.');
  return {rfq:h,supplier:supplier,items:out,
    total:procMoney_(out.reduce(function(n,x){return n+x.Quantity*x.UnitCost*(1+x.VATPercent/100);},0)),
    missingLines:Object.keys(lines).length-out.length,
    commonTerms:{VATPercent:vat,LeadDays:lead,PaymentTerms:terms,ValidUntil:validDay}};
}
/* API cũ giữ nguyên tên; hàm chuẩn hóa phía trên áp dụng cho cả xem trước và ghi chính thức. */

/* ===================== AMCVN V20.20 - PURCHASE PROPOSAL REVIEW DETAIL ===================== */
function procUniqueV220_(values){var seen={};return (values||[]).map(function(x){return amcvnText_(x);}).filter(function(x){if(!x||seen[x])return false;seen[x]=true;return true;});}
function getPurchaseProposal(id){
  try{
    var h=procFind_('PurchaseProposals','ProposalID',id),raw=procRows_('PurchaseProposalItems','ProposalID',id).map(function(x){return Object.assign({},dedicatedEnrich_(x),x);});
    var projects={},machines={},modules={};
    sheetToObjects_('Projects').forEach(function(x){projects[x.ProjectID]=x;});
    sheetToObjects_('Machines').forEach(function(x){machines[x.MachineID]=x;});
    sheetToObjects_('MachineModules').forEach(function(x){modules[x.ModuleID]=x;});
    var quoteHeaders={},quoteItems=sheetToObjects_('SupplierQuotationItems');
    sheetToObjects_('SupplierQuotations').forEach(function(x){quoteHeaders[x.QuoteID]=x;});
    var poHeaders={};sheetToObjects_('PurchaseOrders').forEach(function(x){poHeaders[x.PurchaseID]=x;});
    var purchaseItems=sheetToObjects_('PurchaseItems');
    var groups={};
    raw.forEach(function(x){
      var key=String(x.RFQLineID||x.ProductID),g=groups[key];
      if(!g)g=groups[key]={RFQLineID:x.RFQLineID,ProductID:x.ProductID,SKU:x.SKU,PartNumber:x.PartNumber,ProductName:x.ProductName,Unit:x.Unit,BrandMaterial:x.BrandMaterial,Quantity:0,RequestItemCount:0,ProjectCodes:[],MachineCodes:[],ModuleCodes:[],SelectedQuoteID:x.QuoteID,SelectedQuoteItemID:x.QuoteItemID,SelectedSupplierID:x.SupplierID,SelectedSupplierName:x.SupplierName,UnitCost:toNumber(x.UnitCost),VATPercent:toNumber(x.VATPercent),LeadDays:toNumber(x.LeadDays),PaymentTerms:x.PaymentTerms,Currency:x.Currency||h.Currency,RequiredDate:x.RequiredDate||''};
      g.Quantity+=toNumber(x.Quantity);g.RequestItemCount++;
      g.ProjectCodes.push((projects[x.ProjectID]||{}).ProjectCode||x.ProjectCode||'');
      g.MachineCodes.push((machines[x.MachineID]||{}).MachineCode||x.MachineCode||'');
      g.ModuleCodes.push((modules[x.ModuleID]||{}).ModuleCode||x.ModuleCode||'');
    });
    var reviewLines=Object.keys(groups).map(function(k){
      var g=groups[k];g.ProjectCodes=procUniqueV220_(g.ProjectCodes);g.MachineCodes=procUniqueV220_(g.MachineCodes);g.ModuleCodes=procUniqueV220_(g.ModuleCodes);
      g.LineAmount=procMoney_(g.Quantity*g.UnitCost*(1+g.VATPercent/100));
      g.Alternatives=quoteItems.filter(function(qi){
        if(String(qi.RFQLineID)!==String(g.RFQLineID))return false;
        var qh=quoteHeaders[qi.QuoteID];return qh&&(qh.Status==='ACTIVE'||String(qi.QuoteItemID)===String(g.SelectedQuoteItemID));
      }).map(function(qi){
        var qh=quoteHeaders[qi.QuoteID]||{},expired=String(qi.ValidUntil||'')<procToday_();
        return {QuoteID:qi.QuoteID,QuoteItemID:qi.QuoteItemID,SupplierID:qh.SupplierID,SupplierName:qh.SupplierName,UnitCost:toNumber(qi.UnitCost),VATPercent:toNumber(qi.VATPercent),LeadDays:toNumber(qi.LeadDays),PaymentTerms:qi.PaymentTerms,ValidUntil:qi.ValidUntil,Currency:qh.Currency||h.Currency,Expired:expired,IsSelected:String(qi.QuoteItemID)===String(g.SelectedQuoteItemID),Total:procMoney_(g.Quantity*toNumber(qi.UnitCost)*(1+toNumber(qi.VATPercent)/100))};
      });
      if(!g.Alternatives.some(function(a){return a.IsSelected;}))g.Alternatives.unshift({QuoteID:g.SelectedQuoteID,QuoteItemID:g.SelectedQuoteItemID,SupplierID:g.SelectedSupplierID,SupplierName:g.SelectedSupplierName,UnitCost:g.UnitCost,VATPercent:g.VATPercent,LeadDays:g.LeadDays,PaymentTerms:g.PaymentTerms,Currency:g.Currency,Expired:false,IsSelected:true,Total:g.LineAmount});
      g.Alternatives.sort(function(a,b){return (b.IsSelected?1:0)-(a.IsSelected?1:0)||a.Total-b.Total||a.LeadDays-b.LeadDays;});
      var historyMap={};
      purchaseItems.forEach(function(pi){
        if(String(pi.ProductID)!==String(g.ProductID))return;var po=poHeaders[pi.PurchaseID];if(!po||['Đã hủy','CANCELLED'].indexOf(String(po.Status))>=0)return;
