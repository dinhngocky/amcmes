/* Tổng quan trả hàng theo hóa đơn (cho badge ở danh sách phiếu bán) */
function getSalesReturnMap() {
  try {
    var soldByInvoice = {};
    sheetToObjects_('SalesItems').forEach(function (i) { soldByInvoice[i.SalesID] = (soldByInvoice[i.SalesID] || 0) + toNumber(i.Quantity); });
    var byInvoice = {};
    var itemsByReturn = {};
    sheetToObjects_('SalesReturnItems').forEach(function (i) { (itemsByReturn[i.ReturnID] = itemsByReturn[i.ReturnID] || []).push(i); });
    sheetToObjects_('SalesReturns').forEach(function (r) {
      if (!r.SalesID) return;
      if (isCancelled_(normalizeStatus_(r.Status, ''))) return;
      var m = byInvoice[r.SalesID] || { count: 0, qty: 0, amount: 0 };
      m.count++; m.amount += toNumber(r.TotalAmount);
      (itemsByReturn[r.ReturnID] || []).forEach(function (it) { m.qty += toNumber(it.Quantity); });
      byInvoice[r.SalesID] = m;
    });
    // Bổ sung: đã bán bao nhiêu & còn được trả bao nhiêu (theo SL) để đánh dấu "đã trả hết"
    Object.keys(byInvoice).forEach(function (id) {
      var m = byInvoice[id]; m.soldQty = soldByInvoice[id] || 0; m.remaining = Math.max(0, m.soldQty - m.qty); m.fullyReturned = m.remaining <= 0;
    });
    return ok_(byInvoice);
  } catch (e) { return err_(e.message); }
}

/* ----- Hủy / Sửa / Xóa hóa đơn bán hàng (đối xứng phiếu mua) ----- */
function validateSalesStatusChange_(so, next) {
  next = normalizeStatus_(next, so && so.Status || 'Hoàn tất');
  validateStatus_(next, SALES_STATUS_FLOW, 'Trạng thái hóa đơn');
  if (!so || !so.SalesID) return next;
  var cur = normalizeStatus_(so.Status, 'Hoàn tất');
  if (cur === next) return next;
  if (isCancelled_(cur)) throw new Error('Hóa đơn đã hủy, không thể đổi trạng thái');
  if ((SALES_STATUS_NEXT[cur] || []).indexOf(next) < 0) throw new Error('Không thể chuyển hóa đơn từ "' + cur + '" sang "' + next + '"');
  return next;
}
function removeSalesInventory_(salesId) {
