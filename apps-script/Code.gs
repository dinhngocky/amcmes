var ALLOWED_IMAGE_MIME_ = ['image/jpeg','image/png','image/webp','image/gif'];
var MAX_IMAGE_BYTES_ = 10 * 1024 * 1024;
function validateImageUpload_(file) {
  if (!file || typeof file.data !== 'string' || !file.data) throw new Error('Không có dữ liệu ảnh.');
  var mime = String(file.mimeType || '').trim().toLowerCase();
  if (ALLOWED_IMAGE_MIME_.indexOf(mime) < 0) throw new Error('Chỉ nhận JPEG, PNG, WEBP hoặc GIF.');
  var raw = file.data, match = /^data:([^;,]+);base64,/i.exec(raw);
  if (/^data:/i.test(raw)) {
    if (!match || match[1].toLowerCase() !== mime) throw new Error('MIME của ảnh không khớp.');
    raw = raw.slice(match[0].length);
  }
  if (raw.length > Math.ceil(MAX_IMAGE_BYTES_ / 3) * 4 || !/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(raw)) throw new Error('Dữ liệu ảnh không hợp lệ hoặc vượt 10 MB.');
  var bytes = Utilities.base64Decode(raw);
  if (!bytes.length || bytes.length > MAX_IMAGE_BYTES_) throw new Error('Ảnh phải có dung lượng từ 1 byte đến 10 MB.');
  var u = bytes.map(function (b) { return (b + 256) % 256; });
  var at = function (offset, values) { return values.every(function (v, i) { return u[offset+i] === v; }); };
  var signatures = {
    'image/jpeg': at(0,[255,216,255]),
    'image/png': at(0,[137,80,78,71,13,10,26,10]),
    'image/gif': at(0,[71,73,70,56,55,97]) || at(0,[71,73,70,56,57,97]),
    'image/webp': at(0,[82,73,70,70]) && at(8,[87,69,66,80])
  };
  if (!signatures[mime]) throw new Error('Nội dung tệp không khớp định dạng ảnh.');
  var ext = { 'image/jpeg':'jpg','image/png':'png','image/webp':'webp','image/gif':'gif' }[mime];
  var name = String(file.name || 'image').replace(/\.[^.]*$/, '').replace(/[^A-Za-z0-9_ -]/g, '_').slice(0,100) || 'image';
  return { bytes: bytes, mime: mime, name: name + '.' + ext };
}

function authSessionInfo_(token, userAgent) {
  token = String(token || '');
  if (!token || !userAgent) return null;
  var raw = PropertiesService.getScriptProperties().getProperty(AUTH_TOKEN_PREFIX_ + token);
  if (!raw) return null;
  var info;
  try { info = JSON.parse(raw); } catch (e) { console.warn('[authSessionInfo_]', e.message); return null; }
  if (!info || !info.u || !info.exp || info.exp <= Date.now() || !info.ua || info.ua !== simpleHash_(String(userAgent))) return null;
  return info;
}
function authRefresh(token, userAgent) {
  return withMutationLock_([], function () {
    var info = authSessionInfo_(token, userAgent);
    var user = info && authFindUserById_(info.u);
    if (!user || authIsLocked_(user)) return err_('Phiên đăng nhập đã hết hạn.', 'ERR_AUTH');
    if (info.exp - Date.now() < 30 * 60 * 1000) info = authSaveSession_(token, user.UserID, AUTH_TOKEN_TTL_, userAgent);
    return ok_({ expiresAt: info.exp });
  });
}

var MUTATION_CTX_ = null;
function trackMutationSheet_(name) {
  if (!MUTATION_CTX_ || MUTATION_CTX_.seen[name]) return;
  MUTATION_CTX_.seen[name] = true;
  if (name === 'Counters') getCountersSheet_();
  var snap = sheetSnapshot_(name);
  MUTATION_CTX_.snaps.push(snap);
  seedReqCacheFromSnapshot_(snap);
  if (name === 'StockMovements' && !MUTATION_CTX_.stockGuard) {
    MUTATION_CTX_.stockGuard = true;
    ['MaterialLocations','MaterialRequirements','Machines','MachineModules','Projects'].forEach(trackMutationSheet_);
    MUTATION_CTX_.before = dedicatedDeficits_();
  }
}
function trackMutationProperty_(key) {
  if (MUTATION_CTX_ && !Object.prototype.hasOwnProperty.call(MUTATION_CTX_.props, key))
    MUTATION_CTX_.props[key] = PropertiesService.getScriptProperties().getProperty(key);
}

// Đọc cấu trúc/range cho các công cụ bảo trì cũ, qua cùng một cổng cache.
function readSheetRange_(sh, row, col, numRows, numCols) {
  var actual = sh.getName();
  var name = Object.keys(SHEET_LABELS).filter(function (key) { return SHEET_LABELS[key] === actual; })[0] || actual;
  // Công cụ migration có thể ghi header trực tiếp trong cùng request.
  invalidateReqCache_(name);
  var values = sheetToObjects_(name, true, sh), out = [];
  for (var r = 0; r < (numRows || 1); r++) {
    var line = [];
    for (var c = 0; c < (numCols || 1); c++) {
      var source = values[row - 1 + r];
      line.push(source && source[col - 1 + c] !== undefined ? source[col - 1 + c] : '');
    }
    out.push(line);
  }
  return out;
}

