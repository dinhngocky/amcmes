/* ===== HẾT MODULE NHẬP HÀNG TRUNG QUỐC ===== */
function simpleHash_(value) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(value), Utilities.Charset.UTF_8)
    .map(function (b) { return ('0' + ((b + 256) % 256).toString(16)).slice(-2); }).join('');
}
function codeCounterKey_(prefix, cfg, when) {
  return prefix + '#' + codePeriodKey_(cfg.ResetBy, when) + '#' + simpleHash_(cfg.Template);
}
// Chạy bên trong lock của thao tác cấp mã; không xóa khóa cũ.
function migrateCodeCounter_(prefix, cfg, when) {
  var sh = getCountersSheet_(), key = codeCounterKey_(prefix, cfg, when);
  var current = codeCounterRead_(sh, key);
  if (current.row >= 0) return current;
  var old = codeCounterRead_(sh, prefix + '#' + codePeriodKey_(cfg.ResetBy, when));
  var value = Math.max(old.value, codeSeqMaxForTemplate_(prefix, cfg.Template, when));
  var row = sh.getLastRow() + 1;
  sh.getRange(row, 1, 1, 2).setValues([[key, value]]);
  invalidateReqCache_('Counters');
  return { row: row, value: value };
}
function migrateCodeCounters() {
  return withMutationLock_(['Counters'], function () {
    var migrated = 0, now = new Date();
    codeFormatEntities_().forEach(function (def) {
      var cfg = codeFormatFor_(def.key); if (!cfg) return;
      var before = codeCounterRead_(getCountersSheet_(), codeCounterKey_(def.key, cfg, now));
      migrateCodeCounter_(def.key, cfg, now);
      if (before.row < 0) migrated++;
    });
    return ok_({ migrated: migrated }, 'Đã chuyển bộ đếm; giữ nguyên khóa cũ.');
  });
}

var STATUS_ = Object.freeze({ CANCELLED: 'Đã hủy', LOCKED: 'Đã khóa', COMPLETED: 'Hoàn tất', TRANSFERRING: 'Đang chuyển', RECEIVED: 'Đã nhận' });
function statusText_(s) { return String(s == null ? '' : s).normalize('NFC').trim(); }
function isCancelled_(s) { s = statusText_(s); return s === STATUS_.CANCELLED || s === 'Đã huỷ'; }
function isLocked_(s) { s = statusText_(s); return s === STATUS_.LOCKED || s === 'Đã khoá'; }
function isCompleted_(s) { return statusText_(s) === STATUS_.COMPLETED; }

