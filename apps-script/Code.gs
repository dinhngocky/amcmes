    // Phiếu này có trừ kho ngay không? (xuất ở trạng thái đang giao)
    var subtractsNow = (mode === 'out' && OUT_ACTIVE_STATUS.indexOf(st) >= 0);
    var pMap = {}; sheetToObjects_('Products').forEach(function (p) { pMap[p.ProductID] = p; });
    if (subtractsNow) {
      for (var i = 0; i < items.length; i++) {
        var pp = pMap[items[i].ProductID]; if (!pp) return err_('Không tìm thấy sản phẩm');
