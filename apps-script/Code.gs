    logs.sort(function (a, b) { return new Date(b.CreatedAt || 0).getTime() - new Date(a.CreatedAt || 0).getTime(); });
    return ok_({ requirement: requirement, machine: machine, project: project, logs: logs });
  } catch (e) { return err_(e.message); }
}

function refreshMaterialRequirements(machineId, options) {
  options = options || {};
  if (!options.__locked) return runLocked_(options, '__locked', ['BOM', 'MachineBOMVersions', 'MachineBOMLines', 'Products', 'Projects', 'Machines', 'MachineModules', 'MaterialRequirements', 'MaterialStatusLogs', 'MaterialExceptions'], function () { return refreshMaterialRequirements(machineId, options); });
  try {
    var machine = amcvnFind_('Machines', 'MachineID', machineId);
    if (!machine) return err_('Không tìm thấy máy.', 'ERR_NOT_FOUND');
    var releasedVersion = machineBomSortVersions_(sheetToObjects_('MachineBOMVersions').filter(function (v) {
      return String(v.MachineID) === String(machineId) && amcvnText_(v.Status).toUpperCase() === 'RELEASED';
    }))[0] || null;
    var bom = [];
    if (releasedVersion) {
      bom = machineBomLines_(releasedVersion.BOMVersionID).map(function (l) { return {
        BOMItemID: l.BOMLineID, BOMVersionID: l.BOMVersionID, BOMLineID: l.BOMLineID,
        ComponentID: l.ProductID, ComponentSKU: l.SKU, ComponentName: l.ProductName,
        Quantity: l.RequiredQty, Unit: l.Unit, ModuleID: l.ModuleID, CriticalLevel: l.CriticalLevel,
        SourceType: l.SourceType, MaterialClass: materialClass_(l.BOMGroup || l.Category || l.SourceType), RequiredDate: '', PreferredSupplierID: ''
      }; });
    } else {
      if (!machine.ProductID) return err_('Máy chưa có BOM máy được phát hành và cũng chưa gắn thành phẩm/BOM cũ.');
      var allBom = sheetToObjects_('BOM').filter(function (b) { return b.ComponentID && String(b.ProductID) === String(machine.ProductID); });
      var specific = allBom.filter(function (b) { return String(b.MachineID || '') === String(machineId); });
      bom = specific.length ? specific : allBom.filter(function (b) { return !b.MachineID; });
    }
    if (!bom.length) return err_('Không tìm thấy dòng vật tư trong BOM đang phát hành của máy này.');
    var now = new Date(), products = {}, suppliers = {};
    sheetToObjects_('Products').forEach(function (p) { products[p.ProductID] = p; });
    sheetToObjects_('Suppliers').forEach(function (s) { suppliers[s.SupplierID] = s; });
    var existingRows = sheetToObjects_('MaterialRequirements').filter(function (r) { return String(r.MachineID) === String(machineId) && materialIsActive_(r); });
    var existing = {}, currentBom = {};
    existingRows.forEach(function (r) { if (r.BOMItemID) existing[r.BOMItemID] = r; });
    var otherAllocated = {};
    sheetToObjects_('MaterialRequirements').forEach(function (r) {
      if (!materialIsActive_(r) || materialStatusRank_(r.MaterialStatus) >= materialStatusRank_('RELEASED') || String(r.MachineID) === String(machineId)) return;
      otherAllocated[r.ProductID] = (otherAllocated[r.ProductID] || 0) + Math.max(0, toNumber(r.AllocatedQty));
    });
    var remaining = {};
    Object.keys(products).forEach(function (pid) { remaining[pid] = Math.max(0, toNumber(products[pid].CurrentStock) - (otherAllocated[pid] || 0)); });
    var created = 0, updated = 0;
    bom.forEach(function (b) {
      currentBom[b.BOMItemID] = true;
      var p = products[b.ComponentID] || {}, old = existing[b.BOMItemID], required = Math.max(0, toNumber(b.Quantity));
      if (!required) return;
      if(old&&old.MaterialStatus==='RELEASED'){updated++;return;}
      if(old)dedicatedGuardRequirement_(old.RequirementID,{ModuleID:b.ModuleID||old.ModuleID,RequiredQty:required});
      var pool = materialAvailableFor_(b.ComponentID,old&&old.RequirementID);
      var allocated = old ? Math.min(required, Math.max(0, toNumber(old.AllocatedQty))) : Math.min(required, pool);
      allocated = Math.min(allocated, pool); remaining[b.ComponentID] = Math.max(0, pool - allocated);
      var shortage = Math.max(0, required - allocated), critical = materialCritical_(b.CriticalLevel || (old && old.CriticalLevel));
      var supplierId = b.PreferredSupplierID || (old && old.SupplierID) || '', supplier = suppliers[supplierId] || {};
      var status = old && old.MaterialStatus || (shortage <= 0 ? 'WAREHOUSE' : 'DEMAND_CREATED');
      var obj = {
        ProjectID: machine.ProjectID, MachineID: machineId, ModuleID: b.ModuleID || (old && old.ModuleID) || '', BOMItemID: b.BOMItemID,
        ProductID: b.ComponentID, SKU: b.ComponentSKU || p.SKU || '', ProductName: b.ComponentName || p.ProductName || '', Unit: b.Unit || p.Unit || '',
        RequiredQty: required, RequiredDate: b.RequiredDate || (old && old.RequiredDate) || machine.PlanStartDate || '',
        AvailableStock: Math.max(0, toNumber(p.CurrentStock)), AllocatedQty: allocated, ShortageQty: shortage,
        CriticalLevel: critical, MaterialClass: materialClass_(b.MaterialClass || b.BOMGroup || b.Category || (old && old.MaterialClass) || p.Category || p.BrandMaterial), ReservedQty: materialReservationQty_(old && old.RequirementID), SourceType: b.SourceType || (old && old.SourceType) || '', PurchaseID: old && old.PurchaseID || '',
        SupplierID: supplierId, SupplierName: supplier.SupplierName || (old && old.SupplierName) || '', Owner: old && old.Owner || '',
        MaterialStatus: status, RiskLevel: materialRisk_(critical, shortage, b.RequiredDate || (old && old.RequiredDate) || machine.PlanStartDate),
        RequirementStatus: 'ACTIVE', LastUpdated: now, BOMVersionID: b.BOMVersionID || '', BOMLineID: b.BOMLineID || ''
      };
      if (old) { updateRowById('MaterialRequirements', 'RequirementID', old.RequirementID, obj); updated++; }
      else {
        obj.RequirementID = generateId('MR'); obj.CreatedBy = getUser_(); obj.CreatedAt = now;
        appendRow('MaterialRequirements', obj); materialAppendLog_(obj, '', status, { Note: 'Tạo nhu cầu từ BOM', ActualDate: now }); created++;
      }
    });
    existingRows.forEach(function (r) {
      if(r.BOMItemID&&!currentBom[r.BOMItemID]&&dedicatedReqHasHistory_(r.RequirementID))throw new Error('ECN làm mất dòng đã mua/nhận: '+r.RequirementID+'. Cần đối chiếu vật tư trước khi đồng bộ.');
      if (r.BOMItemID && !currentBom[r.BOMItemID]) updateRowById('MaterialRequirements', 'RequirementID', r.RequirementID, { RequirementStatus: 'CANCELLED', ShortageQty: 0, LastUpdated: now });
    });
    var ctb = syncMachineCTB_(machineId, true);
    writeAudit_('Đồng bộ nhu cầu vật tư từ BOM', 'Machine', machineId, 'Tạo ' + created + ', cập nhật ' + updated + ', CTB ' + ctb.percent + '%' + (releasedVersion ? ', BOM ' + releasedVersion.VersionNo : ''));
    return ok_({ created: created, updated: updated, ctb: ctb, bomVersion: releasedVersion }, 'Đã đồng bộ ' + (created + updated) + ' dòng vật tư' + (releasedVersion ? ' từ BOM ' + releasedVersion.VersionNo : '') + '. CTB: ' + ctb.percent + '% — ' + ctb.status);
  } catch (e) { return err_(e.message); }
}

function createMaterialRequirement(data) {
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked', ['Products', 'Projects', 'Machines', 'MachineModules', 'MaterialRequirements', 'MaterialStatusLogs', 'MaterialExceptions'], function () { return createMaterialRequirement(data); });
  try {
    var machine = amcvnFind_('Machines', 'MachineID', data.MachineID), product = amcvnFind_('Products', 'ProductID', data.ProductID);
    if (!machine) return err_('Vui lòng chọn máy hợp lệ.');
    if (!product) return err_('Vui lòng chọn vật tư hợp lệ.');
    var required = Math.max(0, toNumber(data.RequiredQty)); if (!required) return err_('Số lượng yêu cầu phải lớn hơn 0.');
    var available = materialAvailableFor_(product.ProductID, ''), allocated = Math.min(required, Math.max(0, data.AllocatedQty === undefined ? available : toNumber(data.AllocatedQty)));
    allocated = Math.min(allocated, available);
    var shortage = Math.max(0, required - allocated), critical = materialCritical_(data.CriticalLevel), now = new Date();
    var obj = {
      RequirementID: generateId('MR'), ProjectID: machine.ProjectID, MachineID: machine.MachineID, ModuleID: data.ModuleID || '', BOMItemID: '',
      ProductID: product.ProductID, SKU: product.SKU || '', ProductName: product.ProductName || '', Unit: product.Unit || '',
      RequiredQty: required, RequiredDate: data.RequiredDate || machine.PlanStartDate || '', AvailableStock: Math.max(0, toNumber(product.CurrentStock)),
      AllocatedQty: allocated, ShortageQty: shortage, CriticalLevel: critical, MaterialClass: materialClass_(data.MaterialClass || product.Category || product.BrandMaterial), ReservedQty: 0, SourceType: data.SourceType || '', PurchaseID: data.PurchaseID || '',
      SupplierID: data.SupplierID || '', SupplierName: data.SupplierName || '', Owner: data.Owner || '',
      MaterialStatus: data.MaterialStatus || (shortage <= 0 ? 'WAREHOUSE' : 'DEMAND_CREATED'),
      RiskLevel: materialRisk_(critical, shortage, data.RequiredDate), RequirementStatus: 'ACTIVE',
      CreatedBy: getUser_(), CreatedAt: now, LastUpdated: now
    };
    appendRow('MaterialRequirements', obj); materialAppendLog_(obj, '', obj.MaterialStatus, { Note: 'Tạo nhu cầu thủ công', ActualDate: now });
    var ctb = syncMachineCTB_(machine.MachineID, true);
    writeAudit_('Tạo nhu cầu vật tư', 'MaterialRequirement', obj.RequirementID, obj.SKU + ' / ' + machine.MachineCode);
    return ok_({ requirement: obj, ctb: ctb }, 'Đã thêm nhu cầu vật tư');
  } catch (e) { return err_(e.message); }
}

function updateMaterialRequirement(requirementId, data) {
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked', ['Products', 'Projects', 'Machines', 'MachineModules', 'MaterialRequirements', 'MaterialStatusLogs', 'MaterialExceptions'], function () { return updateMaterialRequirement(requirementId, data); });
  try {
    var old = amcvnFind_('MaterialRequirements', 'RequirementID', requirementId);
    if (!old) return err_('Không tìm thấy nhu cầu vật tư.', 'ERR_NOT_FOUND');
    if(data.ModuleID){var mod=amcvnFind_('MachineModules','ModuleID',data.ModuleID);if(!mod||String(mod.MachineID)!==String(old.MachineID))return err_('Cụm không thuộc máy của nhu cầu vật tư.');}
    dedicatedGuardRequirement_(requirementId,data);
    var upd = amcvnPick_(data, ['ModuleID', 'RequiredQty', 'RequiredDate', 'AllocatedQty', 'CriticalLevel', 'SourceType',
      'PurchaseID', 'SupplierID', 'SupplierName', 'Owner', 'MaterialStatus', 'RiskLevel', 'RequirementStatus', 'MaterialClass']);
    var required = upd.RequiredQty !== undefined ? Math.max(0, toNumber(upd.RequiredQty)) : Math.max(0, toNumber(old.RequiredQty));
