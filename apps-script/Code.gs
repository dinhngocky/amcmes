/* ============================================================================
 *  AMC MODULE: CÂY CÔNG ĐOẠN SẢN XUẤT (LƯỢT 4A)
 *
 *  NGHIỆP VỤ:
 *   - Mỗi máy có 1 cây công đoạn gồm 6 nhóm: MECH, ELEC, IO, DEBUG, FAT, CLEAN
 *   - Nhóm MECH: các module cơ khí, danh sách LẤY TỪ BOM (bản RELEASED mới nhất)
 *   - Nhóm ELEC: 5 công đoạn điện mặc định, có thể cài đặt trong Settings
 *   - Các nhóm IO/DEBUG/FAT/CLEAN: công đoạn đơn, không có con
 *   - Mỗi node có: TargetDate + ProgressPercent
 *   - Average CHỈ tính cho MECH và ELEC
 *   - Chỉ DRI của máy hoặc Admin mới được sửa Progress + Target
 *
 *  CẤU TRÚC DỮ LIỆU:
 *   - ProductionStages: bảng CHÍNH, mỗi dòng = 1 node (nhóm hoặc công đoạn)
 *   - Settings key "ProductionElecStages": JSON cấu hình công đoạn điện
 * ==========================================================================*/

var STAGE_GROUPS_ = [
  { code: 'MECH',  label: 'Mechanical Assembly', icon: 'precision_manufacturing', hasChildren: true,  source: 'BOM' },
  { code: 'ELEC',  label: 'Electrical Assembly', icon: 'electrical_services',      hasChildren: true,  source: 'CONFIG' },
  { code: 'IO',    label: 'IO Check',            icon: 'settings_input_component', hasChildren: false, source: 'SINGLE' },
  { code: 'DEBUG', label: 'Debug',               icon: 'bug_report',               hasChildren: false, source: 'SINGLE' },
  { code: 'FAT',   label: 'FAT',                 icon: 'fact_check',               hasChildren: false, source: 'SINGLE' },
  { code: 'CLEAN', label: 'Clean / Pack',        icon: 'inventory_2',              hasChildren: false, source: 'SINGLE' }
];

/* Cấu hình công đoạn điện mặc định (dùng khi Settings chưa có) */
var ELEC_STAGES_DEFAULT_ = [
  { code: 'PRE_WIRE',    label: 'Pre-Wire',    sortOrder: 1 },
