/* V13: Purchase requisitions and dedicated inventory by requirement/machine/module. */
function inventoryMode_(v){return String(v||'').toUpperCase()==='DEDICATED'?'DEDICATED':'COMMON';}
function dedicatedReq_(id,mode) {
  var r = amcvnFind_('MaterialRequirements', 'RequirementID', id);
  if (!r || !materialIsActive_(r)) throw new Error('Nhu cầu không còn hiệu lực: ' + id);
  var m = amcvnFind_('Machines', 'MachineID', r.MachineID), mod = amcvnFind_('MachineModules', 'ModuleID', r.ModuleID);
  mode=mode||r.InventoryMode||'COMMON';
  if (!m || (r.ModuleID&&!mod) || (mod&&String(mod.MachineID)!==String(m.MachineID)) || String(m.ProjectID) !== String(r.ProjectID)) throw new Error('Kiểm tra dự án/máy và cụm (nếu có) của vật tư: ' + (r.SKU || id));
  return r;
}
function dedicatedSame_(a,b) {
  return ['RequirementID','ProjectID','MachineID','ModuleID','ProductID'].every(function(k){return String(a[k]||'')===String(b[k]||'');});
}
function dedicatedEnrich_(r) {
