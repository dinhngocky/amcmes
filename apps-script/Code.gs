/* ===== AMC MODULE: TRẢ HÀNG NHÀ CUNG CẤP (đồng bộ 4 phiên bản) ===== */
/**
 * PHẠM VI: có mặt ở CẢ 4 phiên bản (TMv1, TMv2, SXv1, SXv2) với cùng nghiệp vụ & cùng giao diện.
 * Chỉ khác duy nhất ở chỗ móc nối sổ quỹ: TMv2/SXv2 ghi bút toán tài chính, TMv1/SXv1 thì không.
 *
 * NGHIỆP VỤ:
 *  - Trả hàng cho NCC làm GIẢM tồn kho (xuất kho) và GIẢM công nợ phải trả, hoặc NCC hoàn tiền.
 *  - Không cho trả vượt số lượng đã mua còn được trả (khi có phiếu mua gốc).
 *  - Không cho trả vượt tồn kho hiện có (tránh tồn âm vô lý).
 *  - Sửa phiếu = hoàn tác ảnh hưởng cũ -> ghi nhận ảnh hưởng mới (giữ nguyên mã phiếu).
 *  - Hủy/xóa phiếu = hoàn tác tồn kho + công nợ + thu chi liên quan.
 *  - Chống bấm Lưu nhiều lần bằng ClientRef (mã chống trùng do frontend sinh).
 */

var PR_BASE_LOCK_SHEETS_ = ['PurchaseReturns', 'PurchaseReturnItems', 'StockMovements',
  'PurchaseOrders', 'PurchaseItems', 'Payments', 'PaymentAllocations', 'Suppliers', 'Products'];
function prLockSheets_() { return PR_BASE_LOCK_SHEETS_.concat(FINANCE_LOCK_SHEETS_); }

var PR_RETURN_TYPES = ['Trừ công nợ', 'Nhận hoàn tiền'];
var PR_STATUSES = ['Hoàn tất', 'Chờ nhận hoàn tiền', 'Đã hủy'];

/** Ghi 1 dòng Thanh toán cho module trả hàng NCC (khác nhau giữa bản có/không có Tài chính). */
function prAppendPayment_(row) {
  // Bản có module Tài chính: đi qua appendPaymentRow_ để tự sinh bút toán sổ quỹ.
  return appendPaymentRow_(row);
}

/** Hủy bút toán sổ quỹ sinh ra từ 1 phiếu thanh toán (chỉ có tác dụng ở bản có Tài chính). */
function prCancelFinanceForPayment_(paymentId) {
  try { cancelFinanceBySource_('Payment', paymentId); } catch (e) { console.warn('[prCancelFinanceForPayment_]', (e && e.message) || String(e)); }
}

function prIsService_(prod) {
  if (!prod) return false;
  return prod.ProductType === 'Service' || prod.ProductType === 'Dịch vụ' || prod.Category === 'Dịch vụ';
}

/** Tồn kho hiện có của 1 sản phẩm (theo cột đã tính sẵn). */
function prStockOf_(prod) { return toNumber(prod && prod.CurrentStock); }

/** Tổng SL đã trả cho 1 phiếu mua, theo từng sản phẩm — BỎ QUA phiếu đã hủy và phiếu đang sửa. */
function prReturnedQtyByProduct_(purchaseId, excludeReturnId) {
  var map = {};
  if (!purchaseId) return map;
  var ids = {};
  sheetToObjects_('PurchaseReturns').forEach(function (r) {
    if (r.PurchaseID !== purchaseId) return;
    if (isCancelled_(normalizeStatus_(r.Status, ''))) return;
    if (excludeReturnId && r.PurchaseReturnID === excludeReturnId) return;
    ids[r.PurchaseReturnID] = true;
  });
  sheetToObjects_('PurchaseReturnItems').forEach(function (i) {
    if (!ids[i.PurchaseReturnID]) return;
    map[i.ProductID] = (map[i.ProductID] || 0) + toNumber(i.Quantity);
  });
  return map;
}

/** Danh sách sản phẩm còn được trả của 1 phiếu mua (frontend dùng để dựng dòng nhập liệu). */
function getPurchaseReturnableItems(purchaseId, excludeReturnId) {
  try {
    if (!purchaseId) return err_('Thiếu mã phiếu mua', 'ERR_PR_NO_PURCHASE');
    var po = sheetToObjects_('PurchaseOrders').filter(function (p) { return p.PurchaseID === purchaseId; })[0];
    if (!po) return err_('Không tìm thấy phiếu mua ' + purchaseId, 'ERR_PR_PURCHASE_NOT_FOUND');
    var returned = prReturnedQtyByProduct_(purchaseId, excludeReturnId);
    var pMap = {};
    sheetToObjects_('Products').forEach(function (p) { pMap[p.ProductID] = p; });
    var byProduct = {};
    sheetToObjects_('PurchaseItems').filter(function (i) { return i.PurchaseID === purchaseId; })
      .forEach(function (i) {
        var cur = byProduct[i.ProductID];
        if (!cur) {
          cur = byProduct[i.ProductID] = {
            ProductID: i.ProductID, SKU: i.SKU, ProductName: i.ProductName,
            PurchasedQty: 0, UnitCost: toNumber(i.UnitCost)
          };
        }
        cur.PurchasedQty += toNumber(i.Quantity);
        if (toNumber(i.UnitCost)) cur.UnitCost = toNumber(i.UnitCost);
      });
    var rows = Object.keys(byProduct).map(function (pid) {
      var r = byProduct[pid];
      var prod = pMap[pid] || {};
      r.ReturnedQty = toNumber(returned[pid]);
      r.RemainQty = Math.max(0, r.PurchasedQty - r.ReturnedQty);
      r.CurrentStock = prStockOf_(prod);
      r.IsService = prIsService_(prod);
      return r;
    });
    return ok_({ order: po, items: rows });
  } catch (e) { return err_(e, 'ERR_PR_RETURNABLE'); }
}

function getPurchaseReturns() {
  try { return ok_(cachedSheetToObjects_('PurchaseReturns')); }
  catch (e) { return err_(e, 'ERR_PR_LIST'); }
}

function getPurchaseReturnDetail(returnId) {
  return cachedPayload_('prdetail:' + returnId, function () { return build_getPurchaseReturnDetail(returnId); });
}
function build_getPurchaseReturnDetail(returnId) {
  try {
    var ret = sheetToObjects_('PurchaseReturns').filter(function (r) { return r.PurchaseReturnID === returnId; })[0];
    if (!ret) return err_('Không tìm thấy phiếu trả hàng NCC ' + returnId, 'ERR_PR_NOT_FOUND');
    var items = sheetToObjects_('PurchaseReturnItems').filter(function (i) { return i.PurchaseReturnID === returnId; });
    var payments = sheetToObjects_('Payments').filter(function (p) {
      return p.SourceID === returnId || String(p.Note || '').indexOf(returnId) >= 0;
    });
    var movements = sheetToObjects_('StockMovements').filter(function (m) { return m.SourceID === returnId; });
    return ok_({ ret: ret, items: items, payments: payments, movements: movements });
  } catch (e) { return err_(e, 'ERR_PR_DETAIL'); }
}

/**
 * Dựng & kiểm tra các dòng hàng trả. Ném lỗi (throw) khi dữ liệu không hợp lệ.
 * excludeReturnId: khi SỬA phiếu thì không tính chính phiếu đó vào phần đã trả.
 */
function prBuildLines_(data, excludeReturnId) {
  var pMap = {};
  sheetToObjects_('Products').forEach(function (p) { pMap[p.ProductID] = p; });

  var purchaseCost = {}, purchasedQty = {};
  if (data.PurchaseID) {
    sheetToObjects_('PurchaseItems').filter(function (i) { return i.PurchaseID === data.PurchaseID; })
      .forEach(function (i) {
        purchasedQty[i.ProductID] = (purchasedQty[i.ProductID] || 0) + toNumber(i.Quantity);
        if (toNumber(i.UnitCost)) purchaseCost[i.ProductID] = toNumber(i.UnitCost);
      });
  }
  var returnedQty = prReturnedQtyByProduct_(data.PurchaseID, excludeReturnId);

  var lines = [];
  (data.items || []).forEach(function (it) {
    var prod = pMap[it.ProductID];
    if (!prod) return;
    var qty = toNumber(it.Quantity);
    if (qty <= 0) return;
    var cost = (it.UnitCost !== undefined && it.UnitCost !== '' && it.UnitCost !== null)
      ? toNumber(it.UnitCost)
      : (purchaseCost[it.ProductID] !== undefined ? purchaseCost[it.ProductID] : toNumber(prod.CostPrice));
    lines.push({ prod: prod, qty: qty, cost: cost, amount: qty * cost, isService: prIsService_(prod) });
  });
  if (!lines.length) throw new Error('Chưa chọn sản phẩm cần trả cho nhà cung cấp');

  // Gộp theo sản phẩm để kiểm tra hạn mức
  var wantQty = {};
  lines.forEach(function (l) { wantQty[l.prod.ProductID] = (wantQty[l.prod.ProductID] || 0) + l.qty; });

  for (var pid in wantQty) {
    var prod = pMap[pid];
    // 1) Không vượt số còn được trả của phiếu mua gốc
    if (data.PurchaseID) {
      var remain = Math.max(0, toNumber(purchasedQty[pid]) - toNumber(returnedQty[pid]));
      if (wantQty[pid] > remain + 1e-9) {
        throw new Error('Số lượng trả "' + (prod.ProductName || pid) + '" vượt số còn được trả của phiếu mua ' +
          data.PurchaseID + '. Đã mua: ' + toNumber(purchasedQty[pid]) + ', đã trả: ' + toNumber(returnedQty[pid]) +
          ', còn được trả: ' + remain + '.');
      }
    }
    // 2) Không làm tồn kho âm (hàng hóa lưu kho mới kiểm tra; dịch vụ thì bỏ qua)
    if (!prIsService_(prod)) {
      var stock = prStockOf_(prod);
      if (wantQty[pid] > stock + 1e-9) {
        throw new Error('Không đủ tồn kho để trả "' + (prod.ProductName || pid) + '". Tồn hiện có: ' +
          stock + ', cần xuất trả: ' + wantQty[pid] + '.');
      }
    }
  }
  return lines;
}

/** Tính lại Đã trả / Còn phải trả của các phiếu mua từ lịch sử thanh toán (nguồn sự thật). */
function prRecomputePurchases_(purchaseIds) {
  var seen = {};
  (purchaseIds || []).forEach(function (id) { if (id) seen[id] = true; });
  var ids = Object.keys(seen);
  if (!ids.length) return;
  var poMap = {};
  sheetToObjects_('PurchaseOrders').forEach(function (p) { poMap[p.PurchaseID] = p; });
  var updates = {};
  ids.forEach(function (id) {
    var po = poMap[id];
    if (!po) return;
    var total = toNumber(po.TotalAmount);
    var paid = Math.min(total, Math.max(0, paidForSource_('PurchaseOrder', id)));
    var cancelled = isCancelled_(normalizeStatus_(po.Status, ''));
    updates[id] = {
      PaidAmount: paid,
      PayableAmount: cancelled ? 0 : Math.max(0, total - paid),
      PaymentStatus: cancelled ? 'Đã hủy' : calculatePaymentStatus(total, paid)
    };
  });
  if (Object.keys(updates).length) updateRowsById_('PurchaseOrders', 'PurchaseID', updates);
}

/** Ghi nhận toàn bộ ảnh hưởng của 1 phiếu trả NCC: kho + công nợ + tiền. */
function prApplyEffects_(ret, lines) {
  var now = new Date();
  var rdate = ret.ReturnDate ? parseDate_(ret.ReturnDate) || now : now;
  var id = ret.PurchaseReturnID;

  // 1) Chi tiết phiếu
  var itemIds = generateIds('PRI', lines.length);
  var itemRows = lines.map(function (l, idx) {
    return {
      PurchaseReturnItemID: itemIds[idx], PurchaseReturnID: id, ProductID: l.prod.ProductID,
      SKU: l.prod.SKU, ProductName: l.prod.ProductName, Quantity: l.qty, UnitCost: l.cost, LineTotal: l.amount
    };
  });
  appendRows('PurchaseReturnItems', itemRows);

  // 2) Xuất kho trả lại NCC (dịch vụ không có tồn -> không sinh biến động kho)
  var stockLines = lines.filter(function (l) { return !l.isService; });
  if (stockLines.length) {
    var moveIds = generateIds('MV', stockLines.length);
    var affected = {};
    var moveRows = stockLines.map(function (l, idx) {
      affected[l.prod.ProductID] = true;
      return {
        MovementID: moveIds[idx], Date: rdate, Type: 'PurchaseReturn', SourceType: 'PurchaseReturn', SourceID: id,
        ProductID: l.prod.ProductID, SKU: l.prod.SKU, ProductName: l.prod.ProductName,
        QuantityIn: 0, QuantityOut: l.qty, UnitCost: l.cost, UnitPrice: '', StockAfter: '',
        CreatedBy: getUser_(), Notes: 'Xuất trả nhà cung cấp ' + id, CreatedAt: now, Status: 'Trả lại NCC'
      };
    });
    appendRows('StockMovements', moveRows);
    recalculateProductStocks_(Object.keys(affected));
  }

  // 3) Tiền & công nợ
  var total = toNumber(ret.TotalAmount);
  var applied = 0, touchedPurchases = [];
  if (ret.ReturnType === 'Trừ công nợ') {
    var remain = total;
    var openPos = sheetToObjects_('PurchaseOrders').filter(function (p) {
      if (p.SupplierID !== ret.SupplierID) return false;
      if (isCancelled_(normalizeStatus_(p.Status, ''))) return false;
      if (ret.PurchaseID) return p.PurchaseID === ret.PurchaseID;
      return toNumber(p.PayableAmount) > 0;
    }).sort(function (a, b) { return new Date(a.PurchaseDate) - new Date(b.PurchaseDate); });

    openPos.forEach(function (po) {
      if (remain <= 0) return;
      var use = Math.min(remain, toNumber(po.PayableAmount));
      if (use <= 0) return;
      prAppendPayment_({
        PaymentID: generateId('TT'), PaymentDate: rdate, ObjectType: 'Supplier',
        ObjectID: ret.SupplierID || '', ObjectName: ret.SupplierName || '',
        SourceType: 'PurchaseOrder', SourceID: po.PurchaseID, PaymentDirection: 'Out',
        Amount: use, Method: 'Đối trừ công nợ',
        Note: 'Trừ công nợ từ phiếu trả NCC ' + id, CreatedBy: getUser_(), CreatedAt: now
      });
      touchedPurchases.push(po.PurchaseID);
      remain -= use;
      applied += use;
    });
    prRecomputePurchases_(touchedPurchases);
  }

  var refundRemain = Math.max(0, total - applied);
  if (ret.ReturnType === 'Nhận hoàn tiền') {
    // NCC hoàn tiền ngay -> ghi nhận 1 phiếu THU (tiền vào)
    prAppendPayment_({
      PaymentID: generateId('TT'), PaymentDate: rdate, ObjectType: 'Supplier',
      ObjectID: ret.SupplierID || '', ObjectName: ret.SupplierName || '',
      SourceType: 'PurchaseReturn', SourceID: id, PaymentDirection: 'In',
      Amount: total, Method: ret.RefundMethod || 'Tiền mặt',
      Note: 'NCC hoàn tiền phiếu trả ' + id, CreatedBy: getUser_(), CreatedAt: now,
      AccountID: ret.AccountID || '', AccountName: ''
    });
    refundRemain = 0;
  }

  var status = refundRemain > 0 ? 'Chờ nhận hoàn tiền' : 'Hoàn tất';
  updateRowById('PurchaseReturns', 'PurchaseReturnID', id, {
    RefundAmount: refundRemain, Status: status, UpdatedAt: now
  });
  if (ret.SupplierID) refreshSupplierBalance_(ret.SupplierID);
  return { applied: applied, refundRemain: refundRemain, status: status };
}

/** Hoàn tác TOÀN BỘ ảnh hưởng của 1 phiếu trả NCC (kho, thanh toán, sổ quỹ, công nợ). */
function prReverseEffects_(returnId, keepItems) {
  var ret = sheetToObjects_('PurchaseReturns').filter(function (r) { return r.PurchaseReturnID === returnId; })[0];

  // 1) Gỡ biến động kho
  var affected = {}, moveIds = [];
  sheetToObjects_('StockMovements').filter(function (m) { return m.SourceID === returnId; })
    .forEach(function (m) { affected[m.ProductID] = true; moveIds.push(m.MovementID); });
  if (moveIds.length) {
    deleteRowsByIds_('StockMovements', 'MovementID', moveIds);
    recalculateProductStocks_(Object.keys(affected));
  }

  // 2) Gỡ thanh toán liên quan (nhận diện theo SourceID hoặc Ghi chú có chứa mã phiếu trả)
  var relPay = sheetToObjects_('Payments').filter(function (p) {
    return p.SourceID === returnId || String(p.Note || '').indexOf(returnId) >= 0;
  });
  var touchedPurchases = [];
  var relIds = relPay.map(function (p) {
    if (p.SourceID && p.SourceID !== returnId) touchedPurchases.push(p.SourceID);
    return p.PaymentID;
  });
  if (relIds.length) {
    var relSet = {};
    relIds.forEach(function (x) { relSet[x] = true; });
    deleteRowsByIds_('PaymentAllocations', 'AllocationID',
      sheetToObjects_('PaymentAllocations').filter(function (a) { return relSet[a.PaymentID]; })
        .map(function (a) { return a.AllocationID; }));
    deleteRowsByIds_('Payments', 'PaymentID', relIds);
    relIds.forEach(function (pid) { prCancelFinanceForPayment_(pid); });
  }

  // 3) Tính lại công nợ các phiếu mua bị chạm
  prRecomputePurchases_(touchedPurchases);

  // 4) Gỡ chi tiết phiếu (khi sửa thì ghi lại ngay sau đó)
  if (!keepItems) {
    deleteRowsByIds_('PurchaseReturnItems', 'PurchaseReturnItemID',
      sheetToObjects_('PurchaseReturnItems').filter(function (i) { return i.PurchaseReturnID === returnId; })
        .map(function (i) { return i.PurchaseReturnItemID; }));
  }
  if (ret && ret.SupplierID) refreshSupplierBalance_(ret.SupplierID);
  return ret;
}

/**
 * data: { PurchaseID?, SupplierID, SupplierName?, ReturnDate?, ReturnType:'Trừ công nợ'|'Nhận hoàn tiền',
 *         RefundMethod?, Warehouse?, Reason?, Notes?, ClientRef?, AccountID?,
 *         items:[{ProductID, Quantity, UnitCost?}] }
 */
function createPurchaseReturn(data) {
  whEnter_(data);   // module nhiều kho: nhớ kho đang thao tác cho các dòng biến động
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked', prLockSheets_(),
    function () { return createPurchaseReturn(data); });
  try {
    // Chống bấm Lưu nhiều lần: cùng ClientRef -> trả lại phiếu đã tạo, KHÔNG ghi trùng.
    if (data.ClientRef) {
      var dup = sheetToObjects_('PurchaseReturns').filter(function (r) { return String(r.ClientRef) === String(data.ClientRef); })[0];
      if (dup) return ok_({ PurchaseReturnID: dup.PurchaseReturnID, duplicated: true },
        'Phiếu trả NCC ' + dup.PurchaseReturnID + ' đã được ghi nhận trước đó');
    }

    var supplierId = data.SupplierID, supplierName = data.SupplierName;
    if (data.PurchaseID) {
      var po0 = sheetToObjects_('PurchaseOrders').filter(function (p) { return p.PurchaseID === data.PurchaseID; })[0];
      if (!po0) return err_('Không tìm thấy phiếu mua ' + data.PurchaseID, 'ERR_PR_PURCHASE_NOT_FOUND');
      if (isCancelled_(normalizeStatus_(po0.Status, ''))) return err_('Phiếu mua ' + data.PurchaseID + ' đã hủy, không thể tạo phiếu trả.', 'ERR_PR_PURCHASE_CANCELLED');
      supplierId = supplierId || po0.SupplierID;
      supplierName = supplierName || po0.SupplierName;
    }
    if (!supplierId) return err_('Chưa chọn nhà cung cấp', 'ERR_PR_NO_SUPPLIER');
    if (!supplierName) {
      var sup = sheetToObjects_('Suppliers').filter(function (s) { return s.SupplierID === supplierId; })[0];
      supplierName = sup ? sup.SupplierName : '';
    }

    var returnType = data.ReturnType || 'Trừ công nợ';
    if (PR_RETURN_TYPES.indexOf(returnType) < 0) return err_('Kiểu xử lý không hợp lệ: ' + returnType, 'ERR_PR_TYPE');

    var lines = prBuildLines_(data, null);
    var subtotal = lines.reduce(function (s, l) { return s + l.amount; }, 0);

    var now = new Date();
    var rdate = data.ReturnDate ? (parseDate_(data.ReturnDate) || now) : now;
    var id = generateId('PR');
    appendRow('PurchaseReturns', {
      PurchaseReturnID: id, ReturnDate: rdate, PurchaseID: data.PurchaseID || '',
      SupplierID: supplierId, SupplierName: supplierName,
      Subtotal: subtotal, TotalAmount: subtotal, RefundAmount: 0,
      RefundMethod: data.RefundMethod || (returnType === 'Nhận hoàn tiền' ? 'Tiền mặt' : 'Đối trừ công nợ'),
      ReturnType: returnType, Warehouse: data.Warehouse || '', Reason: data.Reason || '',
      Status: 'Hoàn tất', CreatedBy: getUser_(), Notes: data.Notes || '',
      CreatedAt: now, UpdatedAt: now, ClientRef: data.ClientRef || ''
    });

    var res = prApplyEffects_({
      PurchaseReturnID: id, ReturnDate: rdate, PurchaseID: data.PurchaseID || '',
      SupplierID: supplierId, SupplierName: supplierName, TotalAmount: subtotal,
      ReturnType: returnType, RefundMethod: data.RefundMethod || '', AccountID: data.AccountID || ''
    }, lines);

    writeAudit_('Tạo phiếu trả hàng NCC', 'PurchaseReturn', id, (supplierName || '') + ' · ' + formatMoney_(subtotal));
    return ok_({ PurchaseReturnID: id, TotalAmount: subtotal, Status: res.status, RefundAmount: res.refundRemain },
      'Đã tạo phiếu trả hàng NCC ' + id);
  } catch (e) { return err_(e, 'ERR_PR_CREATE'); }
}

/** Sửa phiếu: hoàn tác ảnh hưởng cũ -> kiểm tra dữ liệu mới -> ghi nhận lại. Mã phiếu KHÔNG đổi. */
function updatePurchaseReturn(returnId, data) {
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked', prLockSheets_(),
    function () { return updatePurchaseReturn(returnId, data); });
  try {
    var old = sheetToObjects_('PurchaseReturns').filter(function (r) { return r.PurchaseReturnID === returnId; })[0];
    if (!old) return err_('Không tìm thấy phiếu trả hàng NCC ' + returnId, 'ERR_PR_NOT_FOUND');
    if (isCancelled_(normalizeStatus_(old.Status, ''))) return err_('Phiếu đã hủy, không thể sửa. Hãy tạo phiếu mới.', 'ERR_PR_CANCELLED');

    var purchaseId = data.PurchaseID !== undefined ? data.PurchaseID : old.PurchaseID;
    var supplierId = data.SupplierID || old.SupplierID;
    var supplierName = data.SupplierName || old.SupplierName;
    var returnType = data.ReturnType || old.ReturnType || 'Trừ công nợ';
    if (PR_RETURN_TYPES.indexOf(returnType) < 0) return err_('Kiểu xử lý không hợp lệ: ' + returnType, 'ERR_PR_TYPE');

    // Hoàn tác trước để phần kiểm tra tồn kho / hạn mức trả được tính trên trạng thái đã gỡ phiếu cũ.
    prReverseEffects_(returnId, false);

    var draft = {
      PurchaseID: purchaseId, SupplierID: supplierId,
      items: data.items !== undefined ? data.items
        : sheetToObjects_('PurchaseReturnItems').filter(function (i) { return i.PurchaseReturnID === returnId; })
          .map(function (i) { return { ProductID: i.ProductID, Quantity: i.Quantity, UnitCost: i.UnitCost }; })
    };
    var lines = prBuildLines_(draft, returnId);
    var subtotal = lines.reduce(function (s, l) { return s + l.amount; }, 0);

    var now = new Date();
    var rdate = data.ReturnDate ? (parseDate_(data.ReturnDate) || now) : (parseDate_(old.ReturnDate) || now);
    updateRowById('PurchaseReturns', 'PurchaseReturnID', returnId, {
      ReturnDate: rdate, PurchaseID: purchaseId || '', SupplierID: supplierId, SupplierName: supplierName,
      Subtotal: subtotal, TotalAmount: subtotal,
      RefundMethod: data.RefundMethod !== undefined ? data.RefundMethod : old.RefundMethod,
      ReturnType: returnType,
      Warehouse: data.Warehouse !== undefined ? data.Warehouse : old.Warehouse,
      Reason: data.Reason !== undefined ? data.Reason : old.Reason,
      Notes: data.Notes !== undefined ? data.Notes : old.Notes,
      UpdatedAt: now
    });

    var res = prApplyEffects_({
      PurchaseReturnID: returnId, ReturnDate: rdate, PurchaseID: purchaseId || '',
      SupplierID: supplierId, SupplierName: supplierName, TotalAmount: subtotal,
      ReturnType: returnType, RefundMethod: data.RefundMethod || old.RefundMethod || '',
      AccountID: data.AccountID || ''
    }, lines);

    writeAudit_('Sửa phiếu trả hàng NCC', 'PurchaseReturn', returnId, (supplierName || '') + ' · ' + formatMoney_(subtotal));
    return ok_({ PurchaseReturnID: returnId, TotalAmount: subtotal, Status: res.status, RefundAmount: res.refundRemain },
      'Đã cập nhật phiếu trả hàng NCC ' + returnId);
  } catch (e) { return err_(e, 'ERR_PR_UPDATE'); }
}

/** Hủy phiếu: giữ lại chứng từ để tra cứu nhưng hoàn tác toàn bộ ảnh hưởng số liệu. */
function cancelPurchaseReturn(returnId, __locked) {
  if (!__locked) return withMutationLock_(prLockSheets_(), function () { return cancelPurchaseReturn(returnId, true); });
  try {
    var ret = sheetToObjects_('PurchaseReturns').filter(function (r) { return r.PurchaseReturnID === returnId; })[0];
    if (!ret) return err_('Không tìm thấy phiếu trả hàng NCC ' + returnId, 'ERR_PR_NOT_FOUND');
    if (isCancelled_(normalizeStatus_(ret.Status, ''))) return ok_({ PurchaseReturnID: returnId }, 'Phiếu đã ở trạng thái Đã hủy');
    prReverseEffects_(returnId, true);
    updateRowById('PurchaseReturns', 'PurchaseReturnID', returnId, {
      Status: 'Đã hủy', RefundAmount: 0, UpdatedAt: new Date()
    });
    if (ret.SupplierID) refreshSupplierBalance_(ret.SupplierID);
    writeAudit_('Hủy phiếu trả hàng NCC', 'PurchaseReturn', returnId, (ret.SupplierName || '') + ' · ' + formatMoney_(ret.TotalAmount));
    return ok_({ PurchaseReturnID: returnId }, 'Đã hủy phiếu trả hàng NCC ' + returnId + ' và hoàn lại tồn kho/công nợ');
  } catch (e) { return err_(e, 'ERR_PR_CANCEL'); }
}

function deletePurchaseReturn(returnId, __locked) {
  if (!__locked) return withMutationLock_(prLockSheets_(), function () { return deletePurchaseReturn(returnId, true); });
  try {
    var ret = sheetToObjects_('PurchaseReturns').filter(function (r) { return r.PurchaseReturnID === returnId; })[0];
    if (!ret) return err_('Không tìm thấy phiếu trả hàng NCC ' + returnId, 'ERR_PR_NOT_FOUND');
    prReverseEffects_(returnId, false);
    deleteRowById('PurchaseReturns', 'PurchaseReturnID', returnId);
    if (ret.SupplierID) refreshSupplierBalance_(ret.SupplierID);
    writeAudit_('Xóa phiếu trả hàng NCC', 'PurchaseReturn', returnId, (ret.SupplierName || '') + ' · ' + formatMoney_(ret.TotalAmount));
    return ok_(null, 'Đã xóa phiếu trả hàng NCC ' + returnId + ' và hoàn lại tồn kho/công nợ liên quan');
  } catch (e) { return err_(e, 'ERR_PR_DELETE'); }
}

/** Ghi nhận NCC đã hoàn nốt số tiền còn lại của phiếu trả. */
function completePurchaseReturnRefund(returnId, method, note, accountId) {
  if (!returnId) return err_('Thiếu mã phiếu trả NCC', 'ERR_PR_NO_ID');
  return withMutationLock_(prLockSheets_(), function () {
    try {
      var ret = sheetToObjects_('PurchaseReturns').filter(function (r) { return r.PurchaseReturnID === returnId; })[0];
      if (!ret) return err_('Không tìm thấy phiếu trả hàng NCC', 'ERR_PR_NOT_FOUND');
      if (isCancelled_(normalizeStatus_(ret.Status, ''))) return err_('Phiếu đã hủy, không ghi nhận hoàn tiền.', 'ERR_PR_CANCELLED');
      var amount = toNumber(ret.RefundAmount);
      if (amount <= 0) return err_('Phiếu trả không còn số tiền chờ nhận hoàn', 'ERR_PR_NO_REFUND');
      var now = new Date();
      prAppendPayment_({
        PaymentID: generateId('TT'), PaymentDate: now, ObjectType: 'Supplier',
        ObjectID: ret.SupplierID || '', ObjectName: ret.SupplierName || '',
        SourceType: 'PurchaseReturn', SourceID: returnId, PaymentDirection: 'In',
        Amount: amount, Method: method || ret.RefundMethod || 'Tiền mặt',
        Note: note || ('NCC hoàn tiền còn lại phiếu trả ' + returnId),
        CreatedBy: getUser_(), CreatedAt: now, AccountID: accountId || '', AccountName: ''
      });
      updateRowById('PurchaseReturns', 'PurchaseReturnID', returnId, {
        RefundAmount: 0, RefundMethod: method || ret.RefundMethod || 'Tiền mặt',
        Status: 'Hoàn tất', UpdatedAt: now,
        Notes: (ret.Notes || '') + (ret.Notes ? ' | ' : '') + 'Đã nhận hoàn tiền ' + formatMoney_(amount)
      });
      if (ret.SupplierID) refreshSupplierBalance_(ret.SupplierID);
      return ok_({ PurchaseReturnID: returnId, Amount: amount }, 'Đã ghi nhận NCC hoàn tiền cho ' + returnId);
    } catch (e) { return err_(e, 'ERR_PR_REFUND'); }
  });
}

/** Tổng hợp nhanh cho dashboard / báo cáo. */
function getPurchaseReturnSummary(fromDate, toDate) {
  try {
    var from = fromDate ? parseDate_(fromDate) : null;
    var to = toDate ? parseDate_(toDate) : null;
    var count = 0, total = 0, pendingRefund = 0;
    sheetToObjects_('PurchaseReturns').forEach(function (r) {
      if (isCancelled_(normalizeStatus_(r.Status, ''))) return;
      var d = parseDate_(r.ReturnDate);
      if (from && d && d < from) return;
      if (to && d && d > to) return;
      count++;
      total += toNumber(r.TotalAmount);
      pendingRefund += toNumber(r.RefundAmount);
    });
    return ok_({ count: count, total: total, pendingRefund: pendingRefund });
  } catch (e) { return err_(e, 'ERR_PR_SUMMARY'); }
}
/**
 * Tổng hợp giá trị TRẢ HÀNG NCC trong khoảng ngày (bỏ phiếu đã hủy).
 * Dùng cho Dashboard / Báo cáo để "Tổng mua hàng" là số THUẦN (đã trừ hàng trả lại).
 */
function prReturnStats_(from, to) {
  var total = 0, count = 0, bySupplier = {}, list = [];
  sheetToObjects_('PurchaseReturns').forEach(function (r) {
    if (isCancelled_(normalizeStatus_(r.Status, ''))) return;
    var d = parseDate_(r.ReturnDate);
    if (from && d && d < from) return;
    if (to && d && d > to) return;
    var amt = toNumber(r.TotalAmount);
    total += amt; count++;
    var k = r.SupplierID || r.SupplierName || '';
    if (!bySupplier[k]) bySupplier[k] = { name: r.SupplierName || k, amount: 0, count: 0 };
    bySupplier[k].amount += amt;
    bySupplier[k].count++;
    list.push(r);
  });
  return { total: total, count: count, bySupplier: bySupplier, list: list };
}
/* ===== HẾT MODULE TRẢ HÀNG NHÀ CUNG CẤP ===== */

/* ===== AMC MODULE: BÙ HÀM DÙNG CHUNG (xóa KH/NCC/phiếu trả + xóa hàng loạt) ===== */
/**
 * Các hàm dưới đây vốn chỉ có ở nhánh TMv1/TMv2. Đưa sang SX để 4 phiên bản hành xử
 * GIỐNG NHAU ở phần nghiệp vụ dùng chung (khách hàng, nhà cung cấp, trả hàng, xóa hàng loạt).
 */

/** Tính lại Đã thu / Còn phải thu của hóa đơn 1 khách từ lịch sử thanh toán (nguồn sự thật). */
function reconcileCustomerOrders_(customerId) {
  var fixes = {};
  sheetToObjects_('SalesOrders').filter(function (s) {
    return s.CustomerID === customerId && !isCancelled_(normalizeStatus_(s.Status, ''));
  }).forEach(function (s) {
    var paid = paidForSource_('SalesOrder', s.SalesID), total = toNumber(s.TotalAmount), rec = Math.max(0, total - paid);
    if (toNumber(s.PaidAmount) !== paid || toNumber(s.ReceivableAmount) !== rec) {
      fixes[s.SalesID] = { PaidAmount: paid, ReceivableAmount: rec, PaymentStatus: calculatePaymentStatus(total, paid) };
    }
  });
  if (Object.keys(fixes).length) updateRowsById_('SalesOrders', 'SalesID', fixes);
}

/** Gỡ các phiếu thu/chi (kèm phân bổ & bút toán sổ quỹ) theo danh sách mã. */
function nxRemovePayments_(ids) {
  ids = (ids || []).filter(function (x) { return x; });
  if (!ids.length) return;
  var set = {};
  ids.forEach(function (x) { set[x] = true; });
  deleteRowsByIds_('PaymentAllocations', 'AllocationID',
    sheetToObjects_('PaymentAllocations').filter(function (a) { return set[a.PaymentID]; })
      .map(function (a) { return a.AllocationID; }));
  deleteRowsByIds_('Payments', 'PaymentID', ids);
    ids.forEach(function (pid) { try { cancelFinanceBySource_('Payment', pid); } catch (e) { console.warn('[nxRemovePayments_]', (e && e.message) || String(e)); } });
}

/**
 * Xóa phiếu trả hàng khách — đảo NGƯỢC toàn bộ tác động:
 *  1) Gỡ phiếu nhập-lại-kho -> tồn về trước khi trả.
 *  2) Xóa phiếu thu/chi liên quan (hoàn tiền, đối trừ công nợ).
 *  3) Tính lại công nợ toàn bộ hóa đơn của khách.
 *  4) Xóa chi tiết + phiếu trả, cập nhật số dư khách.
 */
function deleteSalesReturn(returnId, __locked) {
  if (!__locked) return withMutationLock_(
    ['SalesReturns', 'SalesReturnItems', 'StockMovements', 'Payments', 'PaymentAllocations', 'SalesOrders', 'Customers', 'Products'].concat(FINANCE_LOCK_SHEETS_),
    function () { return deleteSalesReturn(returnId, true); });
  try {
    var ret = sheetToObjects_('SalesReturns').filter(function (r) { return r.ReturnID === returnId; })[0];
    if (!ret) return err_('Không tìm thấy phiếu trả hàng', 'ERR_SR_NOT_FOUND');
    var affected = {}, moveIds = [];
    sheetToObjects_('StockMovements').filter(function (m) { return m.SourceID === returnId; })
      .forEach(function (m) { affected[m.ProductID] = true; moveIds.push(m.MovementID); });
    if (moveIds.length) {
      deleteRowsByIds_('StockMovements', 'MovementID', moveIds);
      recalculateProductStocks_(Object.keys(affected));
    }
    nxRemovePayments_(sheetToObjects_('Payments').filter(function (p) {
      return p.SourceID === returnId || String(p.Note || '').indexOf(returnId) >= 0;
    }).map(function (p) { return p.PaymentID; }));
    if (ret.CustomerID) reconcileCustomerOrders_(ret.CustomerID);
    deleteRowsByIds_('SalesReturnItems', 'ReturnItemID',
      sheetToObjects_('SalesReturnItems').filter(function (i) { return i.ReturnID === returnId; })
        .map(function (i) { return i.ReturnItemID; }));
    deleteRowById('SalesReturns', 'ReturnID', returnId);
    if (ret.CustomerID) refreshCustomerBalance_(ret.CustomerID);
    writeAudit_('Xóa phiếu trả hàng', 'SalesReturn', returnId, (ret.CustomerName || '') + ' · ' + formatMoney_(ret.TotalAmount));
    return ok_(null, 'Đã xóa phiếu trả hàng ' + returnId + ' và hoàn lại tồn/công nợ liên quan');
  } catch (e) { return err_(e, 'ERR_SR_DELETE'); }
}

/** Xóa khách hàng: CHẶN nếu đã phát sinh giao dịch để không tạo dữ liệu mồ côi. */
function deleteCustomer(customerId, __locked) {
  if (!__locked) return withMutationLock_(
    ['Customers', 'SalesOrders', 'SalesReturns', 'Payments', 'PaymentAllocations'].concat(FINANCE_LOCK_SHEETS_),
    function () { return deleteCustomer(customerId, true); });
  try {
    var c = sheetToObjects_('Customers').filter(function (x) { return x.CustomerID === customerId; })[0];
    if (!c) return err_('Không tìm thấy khách hàng', 'ERR_CUS_NOT_FOUND');
    // Chứng từ ghi NỢ CŨ ĐẦU KỲ không phải giao dịch mua bán — nó chỉ là số dư mang sang.
    var allSo = sheetToObjects_('SalesOrders').filter(function (s) { return s.CustomerID === customerId; });
    var openingDocs = allSo.filter(function (s) { return String(s.Status || '') === 'NO_CU'; });
    var orderCount = allSo.length - openingDocs.length;
    var retCount = sheetToObjects_('SalesReturns').filter(function (r) { return r.CustomerID === customerId; }).length;
    if (!orderCount && !retCount && openingDocs.length) {
      // Chỉ còn số nợ cũ -> dọn luôn giúp người dùng thay vì bắt đi tìm chứng từ.
      openingDocs.forEach(function (s) { var r = deleteSalesOrder(s.SalesID, true); if (!r || !r.success) throw new Error((r && r.message) || 'Không xóa được chứng từ nợ cũ'); });
    }
    if (orderCount || retCount) {
      return err_('Không thể xóa "' + (c.CustomerName || customerId) + '" vì đã phát sinh giao dịch (' +
        orderCount + ' hóa đơn, ' + retCount + ' phiếu trả). Hãy xóa/hủy các chứng từ đó trước, hoặc chuyển trạng thái sang "Ngừng giao dịch".',
        'ERR_CUS_HAS_TX');
    }
    nxRemovePayments_(sheetToObjects_('Payments').filter(function (p) {
      return p.SourceType === 'OpeningDebt' && p.ObjectID === customerId;
    }).map(function (p) { return p.PaymentID; }));
    deleteRowById('Customers', 'CustomerID', customerId);
    writeAudit_('Xóa khách hàng', 'Customer', customerId, c.CustomerName || '');
    return ok_(null, 'Đã xóa khách hàng ' + (c.CustomerName || customerId));
  } catch (e) { return err_(e, 'ERR_CUS_DELETE'); }
}

/** Xóa nhà cung cấp: CHẶN nếu đã có phiếu mua hoặc phiếu trả hàng NCC. */
function deleteSupplier(supplierId, __locked) {
  if (!__locked) return withMutationLock_(
    ['Suppliers', 'PurchaseOrders', 'PurchaseReturns', 'Payments', 'PaymentAllocations'].concat(FINANCE_LOCK_SHEETS_),
    function () { return deleteSupplier(supplierId, true); });
  try {
    var s = sheetToObjects_('Suppliers').filter(function (x) { return x.SupplierID === supplierId; })[0];
    if (!s) return err_('Không tìm thấy nhà cung cấp', 'ERR_SUP_NOT_FOUND');
    // Nợ cũ đầu kỳ được lưu thành phiếu mua nội bộ (NO_CU) — không phải giao dịch mua bán.
    var allPo = sheetToObjects_('PurchaseOrders').filter(function (p) { return p.SupplierID === supplierId; });
    var openingPo = allPo.filter(function (p) { return String(p.Status || '') === 'NO_CU'; });
    var poCount = allPo.length - openingPo.length;
    var prCount = sheetToObjects_('PurchaseReturns').filter(function (r) { return r.SupplierID === supplierId; }).length;
    if (!poCount && !prCount && openingPo.length) {
      openingPo.forEach(function (p) { var r = deletePurchaseOrder(p.PurchaseID, true); if (!r || !r.success) throw new Error((r && r.message) || 'Không xóa được chứng từ nợ cũ'); });
    }
    if (poCount || prCount) {
      return err_('Không thể xóa "' + (s.SupplierName || supplierId) + '" vì đã phát sinh giao dịch (' +
        poCount + ' phiếu mua, ' + prCount + ' phiếu trả NCC). Hãy xóa/hủy các chứng từ đó trước, hoặc chuyển trạng thái sang "Ngừng giao dịch".',
        'ERR_SUP_HAS_TX');
    }
    nxRemovePayments_(sheetToObjects_('Payments').filter(function (p) {
      return p.SourceType === 'OpeningDebt' && p.ObjectID === supplierId;
    }).map(function (p) { return p.PaymentID; }));
    deleteRowById('Suppliers', 'SupplierID', supplierId);
    writeAudit_('Xóa nhà cung cấp', 'Supplier', supplierId, s.SupplierName || '');
    return ok_(null, 'Đã xóa nhà cung cấp ' + (s.SupplierName || supplierId));
  } catch (e) { return err_(e, 'ERR_SUP_DELETE'); }
}

/**
 * Xóa HÀNG LOẠT theo loại. Mỗi mục dùng đúng hàm xóa riêng (đã tự cascade + tự khóa tuần tự).
 * Trả về số đã xóa và danh sách mục không xóa được kèm lý do -> UI báo rõ ràng.
 */
function bulkDelete(kind, ids) {
  try {
    if (!Array.isArray(ids)) return err_('Danh sách mã không hợp lệ.', 'ERR_BULK_IDS');
    ids = ids.filter(function (id, i, list) { return id != null && id !== '' && list.indexOf(id) === i; });
    if (!ids.length) return err_('Chưa chọn mục nào để xóa', 'ERR_BULK_EMPTY');
    var fnMap = { 'product': deleteProduct, 'sales': deleteSalesOrder, 'purchase': deletePurchaseOrder, 'quote': deleteQuote, 'movement': deleteStockMovement, 'check': deleteInventoryCheck, 'payment': deletePayment, 'return': deleteSalesReturn, 'customer': deleteCustomer, 'supplier': deleteSupplier, 'purchasereturn': deletePurchaseReturn, 'production': deleteProductionOrder };
    if (!Object.prototype.hasOwnProperty.call(fnMap, kind)) return err_('Loại dữ liệu không hỗ trợ.', 'ERR_BULK_KIND');
    return withMutationLock_(BULK_DELETE_SHEETS_[kind], function () {
      for (var i = 0; i < ids.length; i++) {
        var r = fnMap[kind](ids[i], true);
        if (!r || !r.success) {
          var failed = err_('Đã hoàn tác cả lô. Mã ' + ids[i] + ': ' + ((r && r.message) || 'Không xóa được'), 'ERR_BULK_ROLLBACK');
          failed.data = { deleted: 0, total: ids.length, rolledBack: true, failed: [{ id: ids[i], message: (r && r.message) || 'Không xóa được' }] };
          return failed;
        }
      }
      return ok_({ deleted: ids.length, failed: [], total: ids.length }, 'Đã xóa ' + ids.length + '/' + ids.length + ' mục');
    });
  } catch (e) { return err_(e, 'ERR_BULK'); }
}
/* ===== HẾT MODULE BÙ HÀM DÙNG CHUNG ===== */

/* ===== AMC MODULE: ENGINE NHẬP EXCEL (đồng bộ 4 phiên bản) ===== */
/**
 * Nhập dữ liệu hàng loạt từ Excel/CSV. Frontend gửi mảng object đã chuẩn hóa, backend GHI THEO LÔ
 * (không gọi từng dòng), tự bỏ qua / cập nhật / tạo mới khi trùng mã theo lựa chọn của người dùng,
 * và trả về số dòng thành công / lỗi kèm lý do từng dòng.
 * Nguồn gốc: bản SXv1 — đưa sang các phiên bản còn lại để 4 bản nhập liệu giống hệt nhau.
 */
var VAT_RATES = [0, 5, 8, 10];

function impStr_(v) { return String(v === null || v === undefined ? '' : v).trim(); }

/** Đọc số kiểu Việt Nam an toàn: "1.500.000" -> 1500000, "2,5" -> 2.5 */
function impNum_(v) {
  if (v === null || v === undefined || v === '') return 0;
  if (typeof v === 'number') return isNaN(v) ? 0 : v;
  var s = String(v).trim();
  if (!s) return 0;
  if (/^-?\d{1,3}([.,]\d{3})+$/.test(s)) return Number(s.replace(/[.,]/g, '')) || 0;
  s = s.replace(/[^\d.,\-]/g, '').replace(/,/g, '.');
  var n = parseFloat(s);
  return isNaN(n) ? 0 : n;
}

/** Ngày: nhận Date, ISO, "yyyy-MM-dd HH:mm:ss", "dd/MM/yyyy", số serial Excel. */
function impDate_(v) {
  if (v === null || v === undefined || v === '') return null;
  if (v instanceof Date) return isNaN(v.getTime()) ? null : v;
  var s = String(v).trim();
  if (!s) return null;
  if (/^\d{4}-\d{2}-\d{2}[ T]/.test(s)) {
    var d = new Date(s.replace(' ', 'T'));
    if (!isNaN(d.getTime())) return d;
  }
  if (/^\d{4}-\d{2}-\d{2}$/.test(s)) {
    var d2 = new Date(s + 'T00:00:00');
    if (!isNaN(d2.getTime())) return d2;
  }
  return parseDate_(s);
}

/** Gom kết quả của nhiều lô nhập (client gửi từng lô 100-400 dòng). */
function impResult_(created, updated, skipped, warnings, message) {
  return ok_({ created: created || 0, updated: updated || 0, skipped: skipped || 0, warnings: warnings || [] }, message || '');
}

/** Tra sản phẩm theo mã hệ thống -> SKU -> tên (dùng cho dòng hàng của chứng từ nhập). */
function impProductMaps_() {
  var maps = { bySku: {}, byName: {}, byId: {} };
  sheetToObjects_('Products').forEach(function (p) {
    if (p.ProductID) maps.byId[String(p.ProductID).trim().toLowerCase()] = p;
    var s = impStr_(p.SKU).toLowerCase(); if (s && !maps.bySku[s]) maps.bySku[s] = p;
    var n = impStr_(p.ProductName).toLowerCase().replace(/\s+/g, ' '); if (n && !maps.byName[n]) maps.byName[n] = p;
  });
  return maps;
}

function impCustomerMaps_() {
  var maps = { byId: {}, byKey: {}, byName: {} };
  sheetToObjects_('Customers').forEach(function (c) {
    var o = { id: c.CustomerID, name: c.CustomerName };
    if (c.CustomerID) maps.byId[String(c.CustomerID).trim().toLowerCase()] = o;
    var k = impPartyKey_(c.CustomerName, c.Phone); if (k && !maps.byKey[k]) maps.byKey[k] = o;
    var n = impStr_(c.CustomerName).toLowerCase().replace(/\s+/g, ' '); if (n && !maps.byName[n]) maps.byName[n] = o;
  });
  return maps;
}

function impSupplierMaps_() {
  var maps = { byId: {}, byKey: {}, byName: {} };
  sheetToObjects_('Suppliers').forEach(function (s) {
    var o = { id: s.SupplierID, name: s.SupplierName };
    if (s.SupplierID) maps.byId[String(s.SupplierID).trim().toLowerCase()] = o;
    var k = impPartyKey_(s.SupplierName, s.Phone); if (k && !maps.byKey[k]) maps.byKey[k] = o;
    var n = impStr_(s.SupplierName).toLowerCase().replace(/\s+/g, ' '); if (n && !maps.byName[n]) maps.byName[n] = o;
  });
  return maps;
}

function impFindProduct_(maps, sku, name, id) {
  var v = impStr_(id).toLowerCase(); if (v && maps.byId[v]) return maps.byId[v];
  v = impStr_(sku).toLowerCase(); if (v && maps.bySku[v]) return maps.bySku[v];
  v = impStr_(name).toLowerCase().replace(/\s+/g, ' '); if (v && maps.byName[v]) return maps.byName[v];
  return null;
}

/** Tra đối tác theo mã, nếu không có thì theo tên (+SĐT); trả về {id, name} hoặc null. */
function impFindParty_(maps, code, name, phone) {
  code = impStr_(code);
  if (code && maps.byId[code.toLowerCase()]) return maps.byId[code.toLowerCase()];
  var k = impPartyKey_(name, phone);
  if (k && maps.byKey[k]) return maps.byKey[k];
  var n = impStr_(name).toLowerCase().replace(/\s+/g, ' ');
  if (n && maps.byName[n]) return maps.byName[n];
  return null;
}

/** Khóa nhận diện đối tác khi file không có mã: tên (+ số điện thoại nếu có). */
function impPartyKey_(name, phone) {
  var n = impStr_(name).toLowerCase().replace(/\s+/g, ' ');
  if (!n) return '';
  var p = impStr_(phone).replace(/[^0-9]/g, '');
  return p ? (n + '|' + p) : n;
}

/** Hàng hóa dịch vụ không theo dõi tồn kho. */
function impIsService_(prod) { return !!prod && impStr_(prod.Category) === 'Dịch vụ'; }

/**
 * Chốt bộ ba Tổng tiền / Đã trả / Còn nợ khi file nguồn chỉ có 1-2 trong 3 số.
 * File "Nhập hàng" của KiotViet chỉ có cột "Cần trả NCC" -> coi tổng = còn nợ, đã trả = 0
 * (số dư công nợ vẫn đúng tuyệt đối, chỉ doanh số mua là thiếu).
 */
function impResolveMoney_(total, paid, outstanding, hasTotal, hasPaid, hasOutstanding) {
  total = Math.max(0, impNum_(total));
  paid = Math.max(0, impNum_(paid));
  outstanding = Math.max(0, impNum_(outstanding));
  if (hasTotal && hasPaid) return { total: total, paid: Math.min(paid, total) };
  if (hasTotal && hasOutstanding) return { total: total, paid: Math.max(0, total - outstanding) };
  if (hasTotal) return { total: total, paid: 0 };
  if (hasOutstanding) return { total: outstanding, paid: 0 };
  if (hasPaid) return { total: paid, paid: paid };
  return { total: 0, paid: 0 };
}

/**
 * Tạo nhanh các đối tác còn thiếu mà chứng từ tham chiếu tới (chỉ mã + tên).
 * missing: { khóaDuyNhất: {code, name} }
 */
function impCreateMissingCustomers_(maps, missing) {
  var list = Object.keys(missing).map(function (k) { return missing[k]; });
  if (!list.length) return 0;
  var needGen = list.filter(function (x) { return !x.code; }).length;
  var ids = needGen ? generateIds('KH', needGen) : [];
  var gi = 0, now = new Date(), rows = [];
  list.forEach(function (x) {
    var id = x.code || ids[gi++];
    if (x.code) bumpCounterTo_('KH', x.code);
    rows.push({
      CustomerID: id, CustomerName: x.name, Phone: '', Email: '', Address: '',
      CustomerGroup: 'Khách lẻ', TotalSales: 0, ReceivableBalance: 0, LastPurchaseDate: '',
      Status: 'Đang giao dịch', Notes: 'Tự tạo khi nhập chứng từ', CreatedAt: now
    });
    var o = { id: id, name: x.name };
    if (x.code) maps.byId[x.code.toLowerCase()] = o;
    maps.byId[String(id).toLowerCase()] = o;
    var n = impStr_(x.name).toLowerCase().replace(/\s+/g, ' '); if (n) { maps.byName[n] = o; maps.byKey[n] = o; }
  });
  appendRows('Customers', rows);
  return rows.length;
}

function impCreateMissingSuppliers_(maps, missing) {
  var list = Object.keys(missing).map(function (k) { return missing[k]; });
  if (!list.length) return 0;
  var needGen = list.filter(function (x) { return !x.code; }).length;
  var ids = needGen ? generateIds('NCC', needGen) : [];
  var gi = 0, now = new Date(), rows = [];
  list.forEach(function (x) {
    var id = x.code || ids[gi++];
    if (x.code) bumpCounterTo_('NCC', x.code);
    rows.push({
      SupplierID: id, SupplierName: x.name, ContactPerson: '', Phone: '', Email: '', Address: '',
      TaxCode: '', Website: '', Category: 'Nguyên liệu', TotalPurchase: 0, PayableBalance: 0,
      Status: 'Đang giao dịch', Notes: 'Tự tạo khi nhập chứng từ', CreatedAt: now
    });
    var o = { id: id, name: x.name };
    if (x.code) maps.byId[x.code.toLowerCase()] = o;
    maps.byId[String(id).toLowerCase()] = o;
    var n = impStr_(x.name).toLowerCase().replace(/\s+/g, ' '); if (n) { maps.byName[n] = o; maps.byKey[n] = o; }
  });
  appendRows('Suppliers', rows);
  return rows.length;
}

/** Khóa nhận diện 1 phiếu thu/chi để không nhập trùng khi chạy lại cùng một file. */
function impPaymentKey_(dateVal, objectId, amount, sourceId) {
  var d = impDate_(dateVal);
  var day = d ? Utilities.formatDate(d, Session.getScriptTimeZone(), 'yyyy-MM-dd') : impStr_(dateVal).slice(0, 10);
  return [day, impStr_(objectId), Math.round(toNumber(amount)), impStr_(sourceId)].join('|');
}

/** Trạng thái đối tác: phần mềm cũ hay xuất 1/0; cũng nhận chữ tiếng Việt/tiếng Anh. */
function impPartyStatus_(v) {
  var s = impStr_(v).toLowerCase();
  if (!s) return 'Đang giao dịch';
  if (s === '0' || s === 'false' || s.indexOf('ngừng') === 0 || s.indexOf('ngung') === 0 ||
      s.indexOf('inactive') === 0 || s.indexOf('khóa') === 0) return 'Ngừng giao dịch';
  return 'Đang giao dịch';
}

/** Đồng bộ dòng chi tiết của các chứng từ nợ cũ vừa được chỉnh tổng tiền. */
function impSyncOpeningDocItems_(soUpd, poUpd) {
  var soIds = Object.keys(soUpd || {}), poIds = Object.keys(poUpd || {});
  if (soIds.length) {
    var siUpd = {};
    sheetToObjects_('SalesItems').forEach(function (i) {
      if (!soUpd[i.SalesID]) return;
      var amt = toNumber(soUpd[i.SalesID].TotalAmount);
      siUpd[i.SalesItemID] = { Quantity: 1, SalePrice: amt, LineRevenue: amt, LineCost: 0, LineProfit: amt };
    });
    if (Object.keys(siUpd).length) updateRowsById_('SalesItems', 'SalesItemID', siUpd);
  }
  if (poIds.length) {
    var piUpd = {};
    sheetToObjects_('PurchaseItems').forEach(function (i) {
      if (!poUpd[i.PurchaseID]) return;
      var amt = toNumber(poUpd[i.PurchaseID].TotalAmount);
      piUpd[i.PurchaseItemID] = { Quantity: 1, UnitCost: amt, LineTotal: amt };
    });
    if (Object.keys(piUpd).length) updateRowsById_('PurchaseItems', 'PurchaseItemID', piUpd);
  }
}

/**
 * Nợ cũ trong app này được ghi bằng 1 chứng từ ảo "Ghi nhận nợ cũ đầu kỳ" (trạng thái NO_CU)
 * — giống hệt khi thêm tay trong màn hình Khách hàng/NCC — nên báo cáo công nợ vẫn khớp.
 * parties: [{id, name, amount}]
 */
/**
 * Gom số nợ cũ từ một dòng của file nhập.
 * Chỉ tính khi file THỰC SỰ có cột "Nợ cũ" — file không có cột đó thì giữ nguyên
 * nợ cũ đang có, tránh việc nhập lại danh sách khách làm mất sạch công nợ đầu kỳ.
 */
function impHasDebtCol_(r) {
  return r && r.OpeningDebt !== undefined && r.OpeningDebt !== null && String(r.OpeningDebt).trim() !== '';
}
function impCollectDebt_(bucket, id, name, r) {
  if (!impHasDebtCol_(r)) return;
  bucket.push({ id: id, name: name, amount: Math.max(0, impNum_(r.OpeningDebt)) });
}
/**
 * Bản nào lưu nợ cũ bằng CỘT trên hồ sơ (TM) thì trả về true; bản dùng CHỨNG TỪ (SX) trả về false.
 * Hai cơ chế không được chạy song song, nếu không công nợ bị cộng hai lần.
 */
function impPartyDebtUsesColumn_(kind) {
  var sheet = (kind === 'Customer') ? 'Customers' : 'Suppliers';
  return (SCHEMA[sheet] || []).indexOf('OpeningDebt') >= 0;
}

/**
 * Dọn dữ liệu cũ: chứng từ nợ cũ (NO_CU) đã lỡ sinh ra ở bản TM sẽ được CHUYỂN
 * phần còn nợ về cột, rồi đưa chứng từ về 0 (giữ lại làm lịch sử, không xóa để
 * không làm mồ côi các phiếu thu đã ghi vào đó).
 */
function impFoldOpeningDocsToColumn_(kind) {
  if (!impPartyDebtUsesColumn_(kind)) return 0;
  var isCus = (kind === 'Customer');
  var docSheet = isCus ? 'SalesOrders' : 'PurchaseOrders';
  var docKey = isCus ? 'SalesID' : 'PurchaseID';
  var partyKey = isCus ? 'CustomerID' : 'SupplierID';
  var partySheet = isCus ? 'Customers' : 'Suppliers';
  var remainKey = isCus ? 'ReceivableAmount' : 'PayableAmount';
  var docs = sheetToObjects_(docSheet).filter(function (d) { return String(d.Status || '') === 'NO_CU'; });
  if (!docs.length) return 0;

  var addByParty = {};
  var docUpd = {};
  docs.forEach(function (d) {
    var pid = String(d[partyKey] || ''); if (!pid) return;
    addByParty[pid] = (addByParty[pid] || 0) + Math.max(0, toNumber(d[remainKey]));
    var z = { Subtotal: 0, TotalAmount: 0, PaidAmount: 0, PaymentStatus: 'Đã thanh toán',
      Notes: 'Nợ cũ đã chuyển về hồ sơ ' + (isCus ? 'khách hàng' : 'nhà cung cấp') };
    z[remainKey] = 0;
    docUpd[String(d[docKey])] = z;
  });
  if (!Object.keys(addByParty).length) return 0;

  var partyUpd = {};
  sheetToObjects_(partySheet).forEach(function (p) {
    var pid = String(p[isCus ? 'CustomerID' : 'SupplierID']);
    if (addByParty[pid] === undefined) return;
    partyUpd[pid] = { OpeningDebt: Math.max(0, toNumber(p.OpeningDebt)) + addByParty[pid] };
  });
  if (Object.keys(partyUpd).length) updateRowsById_(partySheet, isCus ? 'CustomerID' : 'SupplierID', partyUpd);
  updateRowsById_(docSheet, docKey, docUpd);
  return Object.keys(docUpd).length;
}


function impWriteOpeningDocs_(kind, parties, now) {
  parties = (parties || []).filter(function (p) { return p && p.id; });
  if (!parties.length) return 0;
  now = now || new Date();
  var isCustomer = kind === 'Customer';

  /* Bản dùng CỘT (TM): ghi thẳng vào hồ sơ để không tạo thêm nguồn nợ thứ hai.
     Nhờ vậy mở form khách ra là thấy đúng số vừa nhập và sửa lại được. */
  if (impPartyDebtUsesColumn_(kind)) {
    impFoldOpeningDocsToColumn_(kind);          // dọn chứng từ cũ đã lỡ sinh ra
    var pSheet = isCustomer ? 'Customers' : 'Suppliers';
    var pKey = isCustomer ? 'CustomerID' : 'SupplierID';
    var upd = {};
    parties.forEach(function (p) { upd[String(p.id)] = { OpeningDebt: Math.max(0, impNum_(p.amount)) }; });
    updateRowsById_(pSheet, pKey, upd);
    return Object.keys(upd).length;
  }


  /* Đã có chứng từ nợ cũ của đối tượng nào thì SỬA lại đúng số mới, không tạo thêm.
     Nhờ vậy nhập lại file đã sửa số là công nợ đúng ngay, không phải dọn tay. */
  var docSheet = isCustomer ? 'SalesOrders' : 'PurchaseOrders';
  var itemSheet = isCustomer ? 'SalesItems' : 'PurchaseItems';
  var docKey = isCustomer ? 'SalesID' : 'PurchaseID';
  var itemKey = isCustomer ? 'SalesItemID' : 'PurchaseItemID';
  var partyKey = isCustomer ? 'CustomerID' : 'SupplierID';
  var existing = {};
  sheetToObjects_(docSheet).forEach(function (d) {
    if (String(d.Status || '') !== 'NO_CU') return;
    var k = String(d[partyKey] || '');
    if (k && !existing[k]) existing[k] = d;
  });
  var docUpd = {}, itemUpd = {}, leftover = [];
  var itemsByDoc = {};
  sheetToObjects_(itemSheet).forEach(function (i) {
    var k = String(i[docKey] || '');
    if (k && !itemsByDoc[k]) itemsByDoc[k] = i;
  });
  parties.forEach(function (p) {
    var cur = existing[String(p.id)];
    var amt = Math.max(0, Math.round(impNum_(p.amount)));
    if (!cur) { if (amt > 0) leftover.push(p); return; }
    var money = isCustomer
      ? { Subtotal: amt, TotalAmount: amt, ReceivableAmount: amt, PaidAmount: toNumber(cur.PaidAmount) }
      : { Subtotal: amt, TotalAmount: amt, PayableAmount: amt, PaidAmount: toNumber(cur.PaidAmount) };
    money.ReceivableAmount !== undefined && (money.ReceivableAmount = Math.max(0, amt - toNumber(cur.PaidAmount)));
    money.PayableAmount !== undefined && (money.PayableAmount = Math.max(0, amt - toNumber(cur.PaidAmount)));
    money.PaymentStatus = calculatePaymentStatus(amt, toNumber(cur.PaidAmount));
    docUpd[String(cur[docKey])] = money;
    var it = itemsByDoc[String(cur[docKey])];
    if (it) itemUpd[String(it[itemKey])] = isCustomer
      ? { Quantity: 1, SalePrice: amt, LineRevenue: amt, LineCost: 0, LineProfit: 0 }
      : { Quantity: 1, UnitCost: amt, LineTotal: amt };
  });
  if (Object.keys(docUpd).length) updateRowsById_(docSheet, docKey, docUpd);
  if (Object.keys(itemUpd).length) updateRowsById_(itemSheet, itemKey, itemUpd);
  parties = leftover;
  if (!parties.length) return 0;
  // Dùng tiền tố RIÊNG (NOKH/NONC) chứ không lấy số HD/PM: nếu lấy số HD, chứng từ nợ cũ sẽ
  // chiếm mất mã HD001, HD002... rồi khi nhập file hóa đơn cũ mang đúng mã đó sẽ bị coi là trùng
  // và bỏ qua -> mất chứng từ.
  var docIds = generateIds(isCustomer ? 'NOKH' : 'NONC', parties.length);
  var itemIds = generateIds(isCustomer ? 'NOKHI' : 'NONCI', parties.length);
  var docRows = [], itemRows = [];
  parties.forEach(function (p, i) {
    var amount = Math.round(impNum_(p.amount));
    if (isCustomer) {
      docRows.push({
        SalesID: docIds[i], SalesDate: now, CustomerID: p.id, CustomerName: p.name,
        Subtotal: amount, Discount: 0, VAT: 0, ShippingFee: 0, TotalAmount: amount,
        PaidAmount: 0, ReceivableAmount: amount, CostAmount: 0, Profit: 0,
        PaymentStatus: 'Chưa thanh toán', DueDate: '', Status: 'NO_CU', CreatedBy: getUser_(),
        Notes: 'Ghi nhận nợ cũ đầu kỳ (nhập từ file)', CreatedAt: now, InvoiceNo: ''
      });
      itemRows.push({
        SalesItemID: itemIds[i], SalesID: docIds[i], ProductID: 'NO_CU', SKU: '',
        ProductName: 'Ghi nhận nợ cũ đầu kỳ', Quantity: 1, CostPrice: 0, SalePrice: amount,
        LineRevenue: amount, LineCost: 0, LineProfit: 0, VATRate: 0, VATAmount: 0
      });
    } else {
      docRows.push({
        PurchaseID: docIds[i], PurchaseDate: now, SupplierID: p.id, SupplierName: p.name,
        Subtotal: amount, Discount: 0, VAT: 0, ShippingFee: 0, TotalAmount: amount,
        PaidAmount: 0, PayableAmount: amount, PaymentStatus: 'Chưa thanh toán', DueDate: '',
        Status: 'NO_CU', CreatedBy: getUser_(), Notes: 'Ghi nhận nợ cũ đầu kỳ (nhập từ file)',
        CreatedAt: now, InvoiceNo: ''
      });
      itemRows.push({
        PurchaseItemID: itemIds[i], PurchaseID: docIds[i], ProductID: 'NO_CU', SKU: '',
        ProductName: 'Ghi nhận nợ cũ đầu kỳ', Quantity: 1, UnitCost: amount, LineTotal: amount,
        VATRate: 0, VATAmount: 0
      });
    }
  });
  appendRows(isCustomer ? 'SalesOrders' : 'PurchaseOrders', docRows);
  appendRows(isCustomer ? 'SalesItems' : 'PurchaseItems', itemRows);
  return docRows.length;
}

/**
 * Bảng tra Số hóa đơn theo mã chứng từ (hóa đơn bán + phiếu mua) — khách hàng và NCC theo dõi
 * công nợ theo SỐ HÓA ĐƠN chứ không theo mã phiếu, nên mọi màn hình công nợ đều cần cột này.
 */
function invoiceNoMap_() {
  var map = {};
  sheetToObjects_('SalesOrders').forEach(function (s) { if (s.SalesID && s.InvoiceNo) map[s.SalesID] = s.InvoiceNo; });
  sheetToObjects_('PurchaseOrders').forEach(function (p) { if (p.PurchaseID && p.InvoiceNo) map[p.PurchaseID] = p.InvoiceNo; });
  return map;
}

/**
 * DOANH THU THUẦN của 1 hóa đơn = tiền hàng sau chiết khấu, KHÔNG gồm thuế GTGT và phí vận chuyển.
 * Thuế GTGT là khoản thu hộ nhà nước nên không phải doanh thu; nếu cộng vào thì doanh thu bị thổi
 * lên 5-10% và tỉ suất lợi nhuận (lợi nhuận/doanh thu) sai vì hai số khác gốc tính.
 */
function netRevenue_(s) {
  // Chứng từ ghi nợ cũ đầu kỳ KHÔNG phải doanh thu — nó chỉ mang số nợ có từ trước
  // khi dùng phần mềm. Chặn ngay tại đây để mọi thẻ KPI, biểu đồ và báo cáo đều đúng.
  if (String(s.Status || '') === 'NO_CU') return 0;
  var sub = toNumber(s.Subtotal), disc = toNumber(s.Discount);
  if (sub > 0) return Math.max(0, sub - disc);
  // Hóa đơn cũ không có cột Tạm tính -> suy ngược từ tổng tiền
  return Math.max(0, toNumber(s.TotalAmount) - toNumber(s.VAT) - toNumber(s.ShippingFee));
}

/**
 * GIÁ VỐN THỰC TẾ KHI NHẬP KHO.
 * Đơn giá ghi trên phiếu mua là giá TRƯỚC chiết khấu. Nếu lấy nguyên đơn giá đó làm giá vốn thì
 * hàng bị "đội giá" đúng bằng tiền chiết khấu — bán lại đúng giá đã mua sẽ ra LỖ đúng bằng số
 * tiền chiết khấu. Vì vậy chiết khấu của cả phiếu được phân bổ theo tỉ trọng thành tiền từng dòng.
 *   subtotal: tổng tiền hàng trước chiết khấu · discount: chiết khấu của cả phiếu
 */
function netUnitCost_(unitCost, subtotal, discount) {
  unitCost = toNumber(unitCost);
  subtotal = toNumber(subtotal);
  discount = Math.max(0, toNumber(discount));
  if (!discount || subtotal <= 0) return unitCost;
  var ratio = Math.max(0, subtotal - discount) / subtotal;
  return Math.round(unitCost * ratio);
}

function normalizeVatRate_(value, fallback) {
  if (value === '' || value === null || value === undefined) {
    return (fallback === undefined || fallback === null) ? null : normalizeVatRate_(fallback, null);
  }
  var n = toNumber(value);
  if (n > 0 && n < 1) n = n * 100;             // 0.08 -> 8
  n = Math.round(n * 100) / 100;
  var best = null, bestGap = null;
  for (var i = 0; i < VAT_RATES.length; i++) {
    var gap = Math.abs(VAT_RATES[i] - n);
    if (bestGap === null || gap < bestGap) { bestGap = gap; best = VAT_RATES[i]; }
  }
  return (bestGap !== null && bestGap <= 0.51) ? best : Math.max(0, n);
}

/**
 * TÍNH THUẾ GTGT THEO TỪNG DÒNG HÀNG.
 * Một đơn có thể vừa có hàng 8% vừa có hàng 10% (và 0% / 5%). Chiết khấu tổng của phiếu được
 * phân bổ theo tỉ trọng thành tiền của từng dòng rồi mới nhân thuế suất riêng của dòng đó,
 * nên tổng tiền thuế luôn khớp với hóa đơn thuế.
 *   lines: [{ line: thành tiền dòng, rate: thuế suất % (bỏ trống = lấy fallbackRate) }]
 *   trả về { vat, lines:[{rate, base, amount}], byRate: {'8': tiền thuế, '10': ...} }
 */
function computeLineVat_(lines, subtotal, discount, fallbackRate) {
  subtotal = toNumber(subtotal);
  discount = Math.max(0, toNumber(discount));
  var fb = normalizeVatRate_(fallbackRate, 0) || 0;
  var ratio = subtotal > 0 ? Math.max(0, subtotal - discount) / subtotal : 0;
  var out = { vat: 0, lines: [], byRate: {} };
  (lines || []).forEach(function (l) {
    var rate = (l.rate === null || l.rate === undefined || l.rate === '') ? fb : (normalizeVatRate_(l.rate, fb) || 0);
    var base = Math.round(toNumber(l.line) * ratio);
    var amount = Math.round(base * rate / 100);
    out.vat += amount;
    out.byRate[rate] = (out.byRate[rate] || 0) + amount;
    out.lines.push({ rate: rate, base: base, amount: amount });
  });
  return out;
}

/** Nếu mã tự đặt có phần số lớn hơn bộ đếm hiện tại thì đẩy bộ đếm lên cho khớp. */
function bumpCounterTo_(prefix, code) {
  trackMutationSheet_('Counters');
  var s = String(code || '');
  if (s.indexOf(prefix) !== 0) return;
  var num = parseInt(s.replace(/[^0-9]/g, ''), 10);
  if (isNaN(num)) return;
  var sh = getCountersSheet_();
  var lastRow = sh.getLastRow();
  var data = sheetToObjects_('Counters').map(function (r) { return [r.Prefix, r.LastSeq]; });
  var rowIdx = -1, stored = 0;
  for (var i = 0; i < data.length; i++) if (data[i][0] === prefix) { rowIdx = i + 2; stored = toNumber(data[i][1]); break; }
  if (num <= stored) return;
  if (rowIdx < 0) { rowIdx = sh.getLastRow() + 1; sh.getRange(rowIdx, 1).setValue(prefix); }
  sh.getRange(rowIdx, 2).setValue(num);
  invalidateReqCache_('Counters');
}

/** Tính lại số dư công nợ của TOÀN BỘ khách hàng / NCC trong 1 lần đọc + 1 lần ghi. */
function refreshAllCustomerBalances_() {
  var agg = {};
  sheetToObjects_('SalesOrders').forEach(function (s) {
    if (isCancelled_(normalizeStatus_(s.Status, ''))) return;
    var cid = s.CustomerID; if (!cid) return;
    var a = (agg[cid] = agg[cid] || { total: 0, receivable: 0, last: '' });
    if (String(s.Status || '') !== 'NO_CU') a.total += toNumber(s.TotalAmount);   // nợ cũ không phải "đã mua"
    a.receivable += toNumber(s.ReceivableAmount);
    if (s.SalesDate && (!a.last || new Date(s.SalesDate) > new Date(a.last))) a.last = s.SalesDate;
  });
  var updates = {};
  sheetToObjects_('Customers').forEach(function (c) {
    var a = agg[c.CustomerID] || { total: 0, receivable: 0, last: '' };
    if (toNumber(c.TotalSales) === a.total && toNumber(c.ReceivableBalance) === a.receivable && sameBalanceDate_(c.LastPurchaseDate, a.last)) return;
    updates[c.CustomerID] = { TotalSales: a.total, ReceivableBalance: a.receivable, LastPurchaseDate: a.last };
  });
  if (Object.keys(updates).length) updateRowsById_('Customers', 'CustomerID', updates, true);
}

function refreshAllSupplierBalances_() {
  var agg = {};
  sheetToObjects_('PurchaseOrders').forEach(function (p) {
    var sid = p.SupplierID; if (!sid) return;
    var a = (agg[sid] = agg[sid] || { total: 0, payable: 0 });
    a.total += toNumber(p.TotalAmount);
    a.payable += toNumber(p.PayableAmount);
  });
  var updates = {};
  sheetToObjects_('Suppliers').forEach(function (s) {
    var a = agg[s.SupplierID] || { total: 0, payable: 0 };
    if (toNumber(s.TotalPurchase) === a.total && toNumber(s.PayableBalance) === a.payable) return;
    updates[s.SupplierID] = { TotalPurchase: a.total, PayableBalance: a.payable };
  });
  if (Object.keys(updates).length) updateRowsById_('Suppliers', 'SupplierID', updates, true);
}

/**
 * data: { rows: [{CustomerID, CustomerName, Phone, Email, Address, CustomerGroup,
 *                 OpeningDebt, Status, Notes, CreatedAt, LastPurchaseDate}], mode }
