function getSettings() {
  try {
    var obj = {}; cachedSheetToObjects_('Settings').forEach(function (s) { obj[s.Key] = s.Value; });
    return ok_(obj);
  } catch (e) { return err_(e.message); }
}

function updateSetting(key, value) {
  try {
    var sh = getSheet_('Settings');
    var keys = SCHEMA.Settings || readSheetRange_(sh, 1, 1, 1, sh.getLastColumn())[0];
    var keyIdx = keys.indexOf('Key') + 1;
    var valIdx = keys.indexOf('Value') + 1;
    if (valIdx > 0) sh.getRange(1, valIdx, Math.max(sh.getMaxRows(), 1), 1).setNumberFormat('@');
    value = (value === null || value === undefined) ? '' : String(value);
    var last = sh.getLastRow();
    var found = false;
    if (last >= 2 && keyIdx > 0 && valIdx > 0) {
      var vals = readSheetRange_(sh, 2, keyIdx, last - 1, 1);
      for (var i = 0; i < vals.length; i++) {
        if (String(vals[i][0]) === String(key)) {
          sh.getRange(i + 2, valIdx).setNumberFormat('@').setValue(value);
          found = true;
          break;
        }
      }
    }
    if (!found) {
      appendRow('Settings', { Key: key, Value: value, Description: '' });
      if (valIdx > 0) sh.getRange(sh.getLastRow(), valIdx).setNumberFormat('@');
    }
    clearDataCache_('Settings');
    invalidateReqCache_('Settings');
    return ok_(null, 'Đã lưu cài đặt');
  } catch (e) { return err_(e.message); }
}

function saveSettings(settingsObj) {
  try {
    settingsObj = settingsObj || {};
    if (Object.prototype.hasOwnProperty.call(settingsObj, 'ProductCategories')) {
      var classifications = parseListSetting_(settingsObj.ProductCategories);
      if (!classifications.length) return err_('Phân loại Product Master phải có ít nhất một giá trị.');
      settingsObj.ProductCategories = classifications.join(', ');
    }
    for (var k in settingsObj) { updateSetting(k, settingsObj[k]); }
    return ok_(null, 'Đã lưu cài đặt');
  } catch (e) { return err_(e.message); }
}

function buildVietQrUrl_(bankCode, account, accountName, addInfo, amount) {
  var url = 'https://img.vietqr.io/image/' + encodeURIComponent(String(bankCode || '').trim().toUpperCase()) +
    '-' + encodeURIComponent(String(account || '').trim()) +
    '-compact2.png?accountName=' + encodeURIComponent(String(accountName || '').trim()) +
    '&addInfo=' + encodeURIComponent(String(addInfo || 'Thanh toan').trim());
  amount = toNumber(amount);
  if (amount > 0) url += '&amount=' + encodeURIComponent(Math.round(amount));
  return url;
}

/* Nội dung chuyển khoản của 1 tài khoản. {code} = mã chứng từ. */
function cashAccountQrNote_(acc, docCode) {
  var tpl = String((acc && acc.QRNoteTemplate) || '').trim() || 'Thanh toan {code}';
  return tpl.replace(/\{code\}/gi, String(docCode || '')).trim();
}
/* URL QR của 1 tài khoản tiền. VietQRUrl (nếu có) là ảnh QR tùy chỉnh -> dùng nguyên trạng. */
function buildCashAccountQrUrl_(acc, docCode, amount) {
  if (!acc) return '';
  if (String(acc.VietQRUrl || '').trim()) return String(acc.VietQRUrl).trim();
  if (String(acc.AccountType) !== 'Bank') return '';
  if (!acc.BankCode || !acc.AccountNumber) return '';
  return buildVietQrUrl_(acc.BankCode, acc.AccountNumber,
    acc.AccountHolder || acc.AccountName, cashAccountQrNote_(acc, docCode), amount);
}
/* Dùng cho preview trong popup tài khoản tiền (không gắn số tiền). */
function getCashAccountQrUrl(accountId, docCode, amount) {
  try {
    var acc = financeFindById_('CashAccounts', 'AccountID', accountId);
    if (!acc) return err_('Không tìm thấy tài khoản tiền.');
    return ok_({ url: buildCashAccountQrUrl_(acc, docCode, amount) });
  } catch (e) { return err_(e.message); }
}

/* accountId (tùy chọn): QR của đúng tài khoản nhận tiền được chọn.
   Bỏ trống -> fallback cấu hình ngân hàng chung trong Cài đặt (giữ tương thích ngược). */
function getBankQrDataUrl(docCode, amount, accountId) {
  try {
    var url = '';
    if (accountId) {
      var acc = financeFindById_('CashAccounts', 'AccountID', accountId);
      if (acc) url = buildCashAccountQrUrl_(acc, docCode, amount);
    }
    if (!url) {
      var s = settings_();
      if (s.BankCode && s.BankAccount && s.BankAccountName) {
        url = buildVietQrUrl_(s.BankCode, s.BankAccount, s.BankAccountName, (s.BankAddInfo || 'Thanh toan') + ' ' + (docCode || ''), amount);
      } else if (s.BankQR) {
        url = s.BankQR;
      }
    }
    if (!url) return ok_({ url: '', dataUrl: '' });
    var res = UrlFetchApp.fetch(url, { muteHttpExceptions: true, followRedirects: true });
    if (res.getResponseCode() >= 300) return ok_({ url: url, dataUrl: '' });
    var blob = res.getBlob();
    return ok_({ url: url, dataUrl: 'data:' + blob.getContentType() + ';base64,' + Utilities.base64Encode(blob.getBytes()) });
  } catch (e) {
    return err_(e.message);
  }
}

