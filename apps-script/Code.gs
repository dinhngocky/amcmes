      PlanStart: data.PlanStart || '', PlanFinish: data.PlanFinish || '', ActualStart: '', ActualFinish: '',
      ProgressPercent: amcvnPercent_(data.ProgressPercent), MaterialStatus: amcvnText_(data.MaterialStatus) || 'NOT_READY',
      AssemblyStatus: amcvnText_(data.AssemblyStatus) || 'NOT_STARTED', IssueCount: 0,
      Status: amcvnText_(data.Status) || 'ACTIVE', Notes: amcvnText_(data.Notes),
      CreatedBy: getUser_(), CreatedAt: now, UpdatedAt: now
    };
    appendRow('MachineModules', obj); refreshMachineRollup_(machine.MachineID);
    writeAudit_('Tạo module máy', 'MachineModule', id, code + ' / ' + machine.MachineCode);
    return ok_(obj, 'Đã tạo module ' + code);
  } catch (e) { return err_(e.message); }
}

function updateMachineModule(moduleId, data) {
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked', ['Projects', 'Machines', 'MachineModules'], function () { return updateMachineModule(moduleId, data); });
  try {
    var old = amcvnFind_('MachineModules', 'ModuleID', moduleId);
