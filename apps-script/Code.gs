    .setTitle('AMCVN — Quản lý lắp ráp máy')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1.0')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function include(filename) {
  return HtmlService.createHtmlOutputFromFile(filename).getContent();
}

/* ============================================================================
 *  SPREADSHEET HELPERS
 * ========================================================================== */

var SS_MEMO_ = null;
function getSpreadsheet_() {
  if (SS_MEMO_) return SS_MEMO_;
  var ss;
  if (CONFIG.SPREADSHEET_ID) ss = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
  else ss = SpreadsheetApp.getActiveSpreadsheet();
  if (!ss) throw new Error('Không tìm thấy Spreadsheet. Hãy gắn script với 1 Google Sheet hoặc điền CONFIG.SPREADSHEET_ID.');
  SS_MEMO_ = ss;
  return ss;
}

/**
 * Lấy sheet theo tên nội bộ (tiếng Anh). Trả về tab tiếng Việt tương ứng.
 * Tự đổi tên tab cũ (tiếng Anh) sang tiếng Việt nếu phát hiện -> không tạo tab trùng.
 */
var SHEET_MEMO_ = {};
function getSheet_(name) {
  if (SHEET_MEMO_[name]) return SHEET_MEMO_[name];
  var ss = getSpreadsheet_();
  var tab = resolveSheetName_(name);
  var sh = ss.getSheetByName(tab);
  if (!sh) {
    var old = ss.getSheetByName(name); // tab cũ tên tiếng Anh -> đổi tên
    if (old) { old.setName(tab); sh = old; }
  }
  if (!sh) {
    sh = ss.insertSheet(tab);
    if (SCHEMA[name]) {
      sh.getRange(1, 1, 1, SCHEMA[name].length).setValues([viHeaders_(name)]);
      sh.setFrozenRows(1);
    }
  }
  SHEET_MEMO_[name] = sh;
  return sh;
}

/**
 * TỰ NÂNG CẤP CẤU TRÚC SHEET (không mất dữ liệu cũ).
 * Khi bản mới thêm cột, file Sheet của khách vẫn đang thiếu tiêu đề của cột đó.
 * Hàm này ghi bổ sung tiêu đề tiếng Việt còn thiếu ở CUỐI dòng 1 — dữ liệu cũ giữ nguyên
 * vì cột mới luôn được thêm ở cuối SCHEMA. Trả về danh sách sheet đã bổ sung cột.
 */
/* Đổi mốc này mỗi khi có cột mới -> lần mở đầu tiên sau khi cập nhật, hệ thống tự
   bổ sung cột còn thiếu vào các sheet đang có, dữ liệu cũ giữ nguyên.
   Bản 2026.08.16: đăng nhập & phân quyền, nhiều kho, POS, VAT từng dòng, nhân sự & lương. */
var SCHEMA_VERSION_ = '2026.10.03-v20.24-bom-delta';
function ensureSchemaColumns_(force) {
  var props = PropertiesService.getScriptProperties();
  if (!force && props.getProperty('SCHEMA_VERSION') === SCHEMA_VERSION_) return [];
  var ss = getSpreadsheet_();
  var changed = [];
  var canSapXep = [];
  Object.keys(SCHEMA).forEach(function (name) {
    var tab = resolveSheetName_(name);
    var sh = ss.getSheetByName(tab) || ss.getSheetByName(name);
    if (!sh) return;                                  // sheet chưa tạo -> getSheet_ sẽ tạo đủ cột
    var keys = SCHEMA[name];
    var lastCol = sh.getLastColumn();

    /* KHÔNG được quyết định bằng cách ĐẾM SỐ CỘT.
       Bảng tính đời trước có thể còn sót cột lạ ở cuối (Quantity, Amount, WarehouseID...).
       Đếm tổng số cột thì sheet trông như "đã đủ rộng" nên bỏ qua, trong khi các cột của
       hệ thống chưa hề được thêm — mà dữ liệu lại đọc theo VỊ TRÍ, nên từ đó trở đi cột lạ
       bị hiểu nhầm thành cột của hệ thống. Phải so từng tiêu đề theo đúng vị trí. */
    var can = viHeaders_(name);
    var dangCo = lastCol > 0 ? readSheetRange_(sh, 1, 1, 1, lastCol)[0] : [];
    var khop = 0;
    while (khop < keys.length
      && String(dangCo[khop] === undefined ? '' : dangCo[khop]).trim() === String(can[khop] || '').trim()) khop++;
    if (khop >= keys.length) return;                  // đã đủ cột và đúng thứ tự

    // Vị trí tiếp theo đang bị một cột LẠ chiếm chỗ -> không tự chèn bừa lên dữ liệu.
    // Việc này để sapXepLaiCotSheet() lo: nó có xem trước và giữ nguyên dữ liệu cũ.
    if (khop < lastCol) { canSapXep.push(tab); return; }

    if (sh.getMaxColumns() < keys.length) sh.insertColumnsAfter(sh.getMaxColumns(), keys.length - sh.getMaxColumns());
    var labels = viHeaders_(name).slice(lastCol);
    sh.getRange(1, lastCol + 1, 1, labels.length).setValues([labels])
      .setFontWeight('bold').setBackground(CONFIG.HEADER_BG).setFontColor(CONFIG.HEADER_FG);
    try { sh.setFrozenRows(1); } catch (e) { console.warn('[ensureSchemaColumns_]', (e && e.message) || String(e)); }
    changed.push(tab + ' (+' + labels.length + ' cột)');
  });
  // Còn sheet lệch chỗ thì CHƯA đánh dấu đã nâng cấp xong, để lần sau còn kiểm lại.
  if (!canSapXep.length) props.setProperty('SCHEMA_VERSION', SCHEMA_VERSION_);
  if (changed.length) { clearDataCache_(); invalidateReqCache_(); }
  if (canSapXep.length) {
    changed.push('CẦN SẮP XẾP LẠI CỘT (chạy sapXepLaiCotSheet): ' + canSapXep.join(', '));
  }
  return changed;
}

/* Nhãn cột của các đời trước — cùng một trường nhưng ghi tên khác. Nhờ bảng này mà
   khi sắp xếp lại, cột cũ được nhận ra và giữ nguyên dữ liệu thay vì bị coi là cột lạ. */
var COT_TEN_CU_ = {
  'Mã kho mặc định': 'DefaultWarehouseID',
  'Tên kho mặc định': 'DefaultWarehouseName',
  'Kho xuất': 'WarehouseID',
  'Tên kho': 'WarehouseName'
};

/** Tiêu đề này ứng với trường nào trong thiết kế? Trả về '' nếu không nhận ra. */
function cotUngVoiTruong_(name, tieuDe) {
  var keys = SCHEMA[name] || [];
  var can = viHeaders_(name);
  var s = String(tieuDe === undefined || tieuDe === null ? '' : tieuDe).trim();
  if (!s) return '';
  for (var i = 0; i < keys.length; i++) {
    if (s === String(can[i] || '').trim()) return keys[i];   // đúng nhãn hiện tại
    if (s === keys[i]) return keys[i];                       // tiêu đề ghi bằng tên trường
  }
  var cu = COT_TEN_CU_[s];
  if (cu && keys.indexOf(cu) >= 0) return cu;                // nhãn của đời trước
  return '';
}

/**
 * SẮP XẾP LẠI CỘT cho khớp thiết kế — dùng khi bảng tính cũ còn cột lạ chen vào.
 *
 * Cách làm: đọc cả sheet, GHÉP THEO TÊN CỘT (không theo vị trí), rồi viết lại theo
 * đúng thứ tự thiết kế. Cột nào không nhận ra thì dồn ra SAU cùng, giữ nguyên dữ liệu
 * chứ không xóa. Nhờ vậy dữ liệu cũ không mất mà các cột của hệ thống về đúng chỗ.
 *
 * @param {boolean} xemTruoc true = chỉ báo sẽ làm gì, KHÔNG đụng vào bảng tính.
 */
function sapXepLaiCotSheet(xemTruoc) {
  // Nút Run trong Apps Script gọi hàm KHÔNG kèm tham số. Nếu để mặc định là chạy thật
  // thì chỉ cần bấm nhầm một cái là bảng tính bị viết lại. Nên không truyền gì = XEM TRƯỚC;
  // muốn sửa thật phải nói rõ, hoặc chạy sapXepLaiCotThatSu().
  if (xemTruoc === undefined || xemTruoc === null) xemTruoc = true;
  try {
    var ss = getSpreadsheet_();
    var ketQua = [], loi = [];
    Object.keys(SCHEMA).forEach(function (name) {
      var tab = resolveSheetName_(name);
      var sh = ss.getSheetByName(tab) || ss.getSheetByName(name);
      if (!sh) return;
      var keys = SCHEMA[name];
      var can = viHeaders_(name);
      var lastCol = sh.getLastColumn(), lastRow = sh.getLastRow();
      if (lastCol < 1 || lastRow < 1) return;

      var dangCo = readSheetRange_(sh, 1, 1, 1, lastCol)[0];

      // Đã đúng hết rồi thì bỏ qua, không đụng vào cho an toàn.
      var daDung = true;
      for (var i = 0; i < keys.length; i++) {
        if (String(dangCo[i] === undefined ? '' : dangCo[i]).trim() !== String(can[i] || '').trim()) { daDung = false; break; }
      }
      if (daDung) return;

      /* Ghép cột nguồn cho từng trường, theo thứ tự ưu tiên giảm dần:
         1) Đúng nhãn hiện tại / đúng tên trường — chắc chắn nhất.
         2) Nhãn của đời trước (bảng COT_TEN_CU_).
         3) Tiêu đề TRỐNG ngay tại vị trí của trường đó: cột đã được ghi dữ liệu theo
            vị trí nhưng chưa kịp đặt tiêu đề. Bỏ qua bước này là xóa trắng dữ liệu thật —
            ví dụ sheet Người dùng có mật khẩu nằm đúng chỗ mà ô tiêu đề còn để trống. */
      var nguon = {}, daLay = {};
      function nhan(truong, c) {
        if (!truong || nguon[truong] !== undefined || daLay[c]) return;
        nguon[truong] = c; daLay[c] = true;
      }
      var trong = function (c) {
        return String(dangCo[c] === undefined || dangCo[c] === null ? '' : dangCo[c]).trim() === '';
      };
      for (var c1 = 0; c1 < lastCol; c1++) {
        var s1 = String(dangCo[c1] === undefined ? '' : dangCo[c1]).trim();
        for (var k1 = 0; k1 < keys.length; k1++) {
          if (s1 && (s1 === String(can[k1] || '').trim() || s1 === keys[k1])) { nhan(keys[k1], c1); break; }
        }
      }
      for (var c2 = 0; c2 < lastCol; c2++) {
        var cu2 = COT_TEN_CU_[String(dangCo[c2] === undefined ? '' : dangCo[c2]).trim()];
        if (cu2 && keys.indexOf(cu2) >= 0) nhan(cu2, c2);
      }
      for (var k3 = 0; k3 < keys.length; k3++) {
        if (nguon[keys[k3]] === undefined && k3 < lastCol && trong(k3)) nhan(keys[k3], k3);
      }
      var cotLa = [];
      for (var c4 = 0; c4 < lastCol; c4++) if (!daLay[c4]) cotLa.push(c4);

      var thieu = keys.filter(function (k) { return nguon[k] === undefined; });
      ketQua.push({
        sheet: tab,
        giuLai: keys.length - thieu.length,
        themMoi: thieu.map(function (k) { return can[keys.indexOf(k)]; }),
        cotLa: cotLa.map(function (c) { return String(dangCo[c] || '(trống)'); })
      });
      if (xemTruoc) return;

      try {
        var duLieu = readSheetRange_(sh, 1, 1, lastRow, lastCol);
        var rongMoi = keys.length + cotLa.length;
        var raMoi = [];
        for (var r = 0; r < duLieu.length; r++) {
          var dong = [];
          for (var k = 0; k < keys.length; k++) {
            var src = nguon[keys[k]];
            dong.push(r === 0 ? can[k] : (src === undefined ? '' : duLieu[r][src]));
          }
          for (var f = 0; f < cotLa.length; f++) dong.push(duLieu[r][cotLa[f]]);
          raMoi.push(dong);
        }
        if (sh.getMaxColumns() < rongMoi) sh.insertColumnsAfter(sh.getMaxColumns(), rongMoi - sh.getMaxColumns());
        sh.getRange(1, 1, raMoi.length, rongMoi).setValues(raMoi);
        // Cột thừa bên phải vùng mới (nếu sheet từng rộng hơn) phải dọn sạch,
        // không thì còn sót bản sao dữ liệu cũ gây hiểu nhầm khi đối chiếu.
        if (lastCol > rongMoi) sh.getRange(1, rongMoi + 1, lastRow, lastCol - rongMoi).clearContent();
        sh.getRange(1, 1, 1, keys.length)
          .setFontWeight('bold').setBackground(CONFIG.HEADER_BG).setFontColor(CONFIG.HEADER_FG);
        try { sh.setFrozenRows(1); } catch (eF) { console.warn('[sapXepLaiCotSheet]', (eF && eF.message) || String(eF));  }
      } catch (eSheet) { console.warn('[sapXepLaiCotSheet]', (eSheet && eSheet.message) || String(eSheet)); 
        loi.push(tab + ': ' + eSheet.message);
      }
    });

    if (!xemTruoc && ketQua.length) { clearDataCache_(); invalidateReqCache_(); }

    var msg;
    if (!ketQua.length) msg = 'Mọi sheet đã đúng thứ tự cột, không cần sắp xếp lại.';
    else if (xemTruoc) msg = 'XEM TRƯỚC (chưa đụng vào dữ liệu): sẽ sắp xếp lại ' + ketQua.length + ' sheet.';
    else msg = 'Đã sắp xếp lại ' + ketQua.length + ' sheet. Cột lạ được dồn ra sau, dữ liệu giữ nguyên.';
    if (loi.length) msg += ' CÓ LỖI ở: ' + loi.join(' | ');

    try {
      Logger.log('=== SẮP XẾP LẠI CỘT' + (xemTruoc ? ' (XEM TRƯỚC)' : '') + ' ===');
      Logger.log(msg);
      ketQua.forEach(function (x) {
        Logger.log('- ' + x.sheet + ': giữ ' + x.giuLai + ' cột'
          + (x.themMoi.length ? ', thêm mới: ' + x.themMoi.join(', ') : '')
          + (x.cotLa.length ? ', dồn ra sau: ' + x.cotLa.join(', ') : ''));
      });
    } catch (eLog) { console.warn('[sapXepLaiCotSheet]', (eLog && eLog.message) || String(eLog));  }

    return ok_({ xemTruoc: !!xemTruoc, sheets: ketQua, loi: loi }, msg);
  } catch (e) { return err_(e.message); }
}

/** Chạy tay trong Apps Script: SỬA THẬT thứ tự cột. Hãy sao lưu bảng tính trước. */
function sapXepLaiCotThatSu() { return sapXepLaiCotSheet(false); }

/**
 * TỰ SOI CẤU TRÚC SHEET — chạy tay trước khi tin vào số liệu của một bảng tính cũ.
 *
 * Dữ liệu được đọc theo VỊ TRÍ cột, không theo tên. Nên nếu bảng tính do bản cũ tạo ra
 * mà xếp cột khác thứ tự hiện tại, mọi con số vẫn hiện ra bình thường nhưng nằm sai ô —
 * kiểu lỗi im lặng nguy hiểm nhất. Hàm này so từng tiêu đề với thiết kế và chỉ đúng chỗ lệch.
 *
 * Trả về { ok, checked, issues: [{ sheet, thieuCot, lech: [{cot, dangCo, phaiLa}] }] }
 */
function kiemTraCauTrucSheet() {
  try {
    var ss = getSpreadsheet_();
    var issues = [], checked = 0;
    Object.keys(SCHEMA).forEach(function (name) {
      var tab = resolveSheetName_(name);
      var sh = ss.getSheetByName(tab) || ss.getSheetByName(name);
      if (!sh) return;                                   // chưa có thì lúc dùng sẽ tự tạo đủ cột
      checked++;
      var keys = SCHEMA[name];
      var can = viHeaders_(name);
      var lastCol = sh.getLastColumn();
      if (lastCol < 1 || sh.getLastRow() < 1) return;
      var dangCo = readSheetRange_(sh, 1, 1, 1, Math.max(lastCol, keys.length))[0];
      var lech = [];
      for (var i = 0; i < keys.length; i++) {
        var a = String(dangCo[i] === undefined ? '' : dangCo[i]).trim();
        var b = String(can[i] || '').trim();
        if (!a) continue;                                // ô trống = cột chưa bổ sung, không phải lệch
        if (a !== b) lech.push({ cot: i + 1, dangCo: a, phaiLa: b });
      }
      var thieuCot = Math.max(0, keys.length - lastCol);
      if (lech.length || thieuCot) {
        issues.push({ sheet: tab, thieuCot: thieuCot, lech: lech });
      }
    });
    var ok = !issues.some(function (x) { return x.lech.length > 0; });
    var msg = ok
      ? (issues.length
        ? 'Cấu trúc đúng thứ tự. Có ' + issues.length + ' sheet còn thiếu cột mới — chạy capNhatCauTrucSheet() để bổ sung.'
        : 'Đã kiểm ' + checked + ' sheet: cấu trúc hoàn toàn khớp thiết kế.')
      : 'CẢNH BÁO: có sheet xếp SAI THỨ TỰ CỘT. Số liệu sẽ bị đọc lệch ô. '
        + 'Đừng dùng tiếp cho tới khi sửa lại thứ tự cột theo đúng thiết kế.';

    // Hàm này để CHẠY TAY trong Apps Script, mà nhật ký chỉ hiện thứ được Logger ghi ra —
    // giá trị trả về thì không thấy. Không in ra đây thì chạy xong không đọc được gì.
    try {
      Logger.log('=== KIỂM TRA CẤU TRÚC SHEET ===');
      Logger.log(msg);
      if (!issues.length) {
        Logger.log('Không có sheet nào cần xử lý.');
      } else {
        issues.forEach(function (it) {
          var phan = ['- ' + it.sheet + ':'];
          if (it.thieuCot) phan.push('thiếu ' + it.thieuCot + ' cột cuối');
          if (it.lech.length) phan.push('LỆCH ' + it.lech.length + ' cột');
          Logger.log(phan.join(' '));
          it.lech.slice(0, 10).forEach(function (l) {
            Logger.log('    cột ' + l.cot + ': đang là "' + l.dangCo + '" — phải là "' + l.phaiLa + '"');
          });
          if (it.lech.length > 10) Logger.log('    ... và ' + (it.lech.length - 10) + ' cột lệch nữa');
        });
      }
      Logger.log('Đã kiểm ' + checked + ' sheet. Kết luận: ' + (ok ? 'ĐẠT' : 'CÓ VẤN ĐỀ - xem ở trên'));
    } catch (eLog) { console.warn('[kiemTraCauTrucSheet]', (eLog && eLog.message) || String(eLog));  }

    return ok_({ ok: ok, checked: checked, issues: issues }, msg);
  } catch (e) { return err_(e.message); }
}

/** Cho phép chạy tay từ menu / Apps Script khi cần cập nhật cấu trúc ngay. */
function capNhatCauTrucSheet() {
  var changed = ensureSchemaColumns_(true);
  var msg = changed.length ? ('Đã bổ sung cột cho: ' + changed.join(', ')) : 'Cấu trúc sheet đã đầy đủ, không cần bổ sung.';
  try { SpreadsheetApp.getUi().alert(msg); } catch (e) { console.warn('[capNhatCauTrucSheet]', (e && e.message) || String(e)); }
  return ok_({ changed: changed }, msg);
}

/**
 * CACHE THEO REQUEST (P0 hiệu năng): trong 1 lần thực thi, mỗi sheet chỉ đọc từ
 * Spreadsheet đúng 1 lần; các lần gọi sau lấy từ bộ nhớ. Mọi helper GHI
 * (appendRow/appendRows/updateRowById/deleteRowById/bulkWrite_/updateSetting...)
 * đều xóa cache của sheet đó nên dữ liệu đọc sau khi ghi luôn mới.
 * Biến toàn cục của Apps Script được khởi tạo lại mỗi lần thực thi -> an toàn.
 */
var REQ_SHEET_CACHE_ = {};
function invalidateReqCache_(name) {
  Object.keys(REQ_SHEET_CACHE_).forEach(function(k){if(k.indexOf('__scope224_'+name+'_')===0)delete REQ_SHEET_CACHE_[k];});
  if(name==='MachineBOMLines'||name==='MachineBOMVersions'||name==='Products')delete REQ_SHEET_CACHE_.__bomGraphV224;
  if(name==='MaterialReservations')delete REQ_SHEET_CACHE_.__reservations224;
  if (name === undefined) { REQ_SHEET_CACHE_ = {}; return; }
  if (name === 'StockMovements') delete REQ_SHEET_CACHE_.__stockIndex;
  delete REQ_SHEET_CACHE_['__raw_' + name];
  delete REQ_SHEET_CACHE_[name];
  delete REQ_SHEET_CACHE_['__san_' + name];
}

/**
 * Đọc toàn bộ sheet -> mảng object với KEY tiếng Anh nội bộ (theo thứ tự cột SCHEMA),
 * bất kể header trên sheet là tiếng Việt. Logic phía sau không cần đổi.
 */
function sheetToObjects_(name, rawOnly, sourceSheet) {
  var rawKey = '__raw_' + name;
  if (rawOnly && REQ_SHEET_CACHE_[rawKey]) return REQ_SHEET_CACHE_[rawKey];
  if (!rawOnly && REQ_SHEET_CACHE_[name]) return hydrateMaterialRowsV224_(name, REQ_SHEET_CACHE_[name]);
  var sh = sourceSheet || getSheet_(name);
  var lastRow = sh.getLastRow(), lastCol = sh.getLastColumn();
  var values = REQ_SHEET_CACHE_[rawKey] || (lastRow && lastCol ? perfReadSheetV223_(sh, name, lastRow, lastCol) : []);
  REQ_SHEET_CACHE_[rawKey] = values;
  var keys = SCHEMA[name] || values[0] || [], out = [];
  for (var r = 1; r < values.length; r++) {
    var obj = {};
    for (var c = 0; c < keys.length; c++) obj[keys[c]] = values[r][c];
    obj.__row = r + 1; out.push(obj);
  }
  REQ_SHEET_CACHE_[name] = out;
  return rawOnly ? values : hydrateMaterialRowsV224_(name, out);
}

/* Memo hóa version cache trong 1 lần thực thi -> không gọi PropertiesService lặp lại. */
var DATA_CACHE_VERSION_MEMO_ = null;
var DATA_CACHE_DIRTY_ = false; // lần thực thi này có ghi dữ liệu
function dataCacheVersion_() {
  if (DATA_CACHE_VERSION_MEMO_) return DATA_CACHE_VERSION_MEMO_;
  var props = PropertiesService.getScriptProperties();
  var v = props.getProperty('DATA_CACHE_VERSION');
  if (!v) { v = String(Date.now()); try { props.setProperty('DATA_CACHE_VERSION', v); } catch (e) { console.warn('[dataCacheVersion_]', (e && e.message) || String(e)); } }
  DATA_CACHE_VERSION_MEMO_ = v + '_v5';
  return DATA_CACHE_VERSION_MEMO_;
}

function clearDataCache_(sheetNames) {
  delete REQ_SHEET_CACHE_.__bomGraphV224;
  delete REQ_SHEET_CACHE_.__reservations224;
  Object.keys(REQ_SHEET_CACHE_).forEach(function(k){if(k.indexOf('__scope224_')===0)delete REQ_SHEET_CACHE_[k];});
  perfMarkCacheV223_(sheetNames);
  // Chỉ ghi PropertiesService 1 lần cho mỗi lần thực thi (mỗi request 1 version mới là đủ).
  if (DATA_CACHE_DIRTY_) return;
  DATA_CACHE_DIRTY_ = true;
  var v = String(Date.now());
  PropertiesService.getScriptProperties().setProperty('DATA_CACHE_VERSION', v);
  DATA_CACHE_VERSION_MEMO_ = v + '_v5';
}

/* Độ dài UTF-8 (byte) — CacheService giới hạn 100KB theo BYTE, không phải ký tự. */
function utf8Length_(s) {
  var bytes = 0;
  for (var i = 0; i < s.length; i++) {
    var c = s.charCodeAt(i);
    if (c < 0x80) bytes += 1;
    else if (c < 0x800) bytes += 2;
    else if (c >= 0xD800 && c <= 0xDBFF) { bytes += 4; i++; }
    else bytes += 3;
  }
  return bytes;
}

/* Cache CHỈ để tăng tốc — không bao giờ được phép làm hỏng việc đọc dữ liệu.
   Lỗi cũ: guard đếm KÝ TỰ (<90000) nhưng Apps Script giới hạn 100KB theo BYTE.
   Tiếng Việt có dấu ~1,3 byte/ký tự nên một sổ thu chi khoảng 86 dòng lọt qua guard
   rồi làm cache.put ném "Argument too large: value" -> getFinanceTransactions trả err_
   -> danh sách Thu/Chi rỗng dù Sheet đầy dữ liệu. */
function cachedSheetToObjects_(name) {
  var sanKey = '__san_' + name;
  if (REQ_SHEET_CACHE_[sanKey]) return hydrateMaterialRowsV224_(name, REQ_SHEET_CACHE_[sanKey]);
  var cache = null;
  var key = '';
  // Request đã có ghi dữ liệu -> bỏ qua script cache (tránh put dữ liệu nửa chừng thành bản "sạch")
  if (!DATA_CACHE_DIRTY_) {
    try {
      cache = CacheService.getScriptCache();
      key = perfSheetCacheKeyV223_(name);
      var cached = perfCacheGetV223_(cache, key);
      if (cached) {
        var parsed = JSON.parse(cached);
        REQ_SHEET_CACHE_[sanKey] = parsed;
        return hydrateMaterialRowsV224_(name, parsed);
      }
    } catch (readErr) { console.warn('[cachedSheetToObjects_]', (readErr && readErr.message) || String(readErr));  cache = null; }
  }

  var data = sanitizeForClient_(sheetToObjects_(name));
  REQ_SHEET_CACHE_[sanKey] = data;
  if (cache && !DATA_CACHE_DIRTY_) {
    try {
      var json = JSON.stringify(data);
      perfCachePutV223_(cache, key, json, 180);
    } catch (writeErr) { console.warn('[cachedSheetToObjects_]', (writeErr && writeErr.message) || String(writeErr));  /* không cache được thì thôi, vẫn phải trả dữ liệu */ }
  }
  return hydrateMaterialRowsV224_(name, data);
}

/**
 * Cache KẾT QUẢ của các màn hình nặng (Dashboard, Báo cáo) trong 5 phút.
 * Khóa cache gắn với dataCacheVersion_ — mà mọi thao tác GHI đều đổi version này,
 * nên vừa nhanh vừa KHÔNG BAO GIỜ trả số liệu cũ sau khi người dùng thêm/sửa/xóa.
 */
function cachedPayload_(name, build) {
  if (DATA_CACHE_DIRTY_) return build();   // request này đã ghi dữ liệu -> tính lại cho chắc
  var key = 'payload:' + dataCacheVersion_() + ':' + name;
  var cache = null;
  try {
    cache = CacheService.getScriptCache();
    var hit = perfCacheGetV223_(cache, key);
    if (hit) return JSON.parse(hit);
  } catch (readErr) { console.warn('[cachedPayload_]', (readErr && readErr.message) || String(readErr));  cache = null; }
  var data = build();
  if (cache && data && data.success) {
    try {
      var json = JSON.stringify(data);
      perfCachePutV223_(cache, key, json, 300);
    } catch (writeErr) { console.warn('[cachedPayload_]', (writeErr && writeErr.message) || String(writeErr));  /* không cache được thì thôi, vẫn trả dữ liệu */ }
  }
  return data;
}

function sheetSnapshot_(sheetName) {
  invalidateReqCache_(sheetName);
  var sh = getSheet_(sheetName), values = sheetToObjects_(sheetName, true);
  var rows = Math.max(1, sh.getLastRow()), cols = Math.max((SCHEMA[sheetName] || []).length, sh.getLastColumn(), 1);
  var copy = [];
  for (var r = 0; r < rows; r++) {
    var line = [];
    for (var c = 0; c < cols; c++) line.push(values[r] && values[r][c] !== undefined ? values[r][c] : '');
    copy.push(line);
  }
  return { sheetName: sheetName, rows: rows, cols: cols, values: copy };
}

function restoreSheetSnapshot_(snap) {
  var sh = getSheet_(snap.sheetName);
  sh.clearContents();
  if (snap.values.length && snap.values[0].length) {
    sh.getRange(1, 1, snap.values.length, snap.values[0].length).setValues(snap.values);
  }
  var extraRows = sh.getLastRow() - snap.rows;
  if (extraRows > 0) sh.deleteRows(snap.rows + 1, extraRows);
  invalidateReqCache_(snap.sheetName);
}

/** Snapshot đã đọc toàn bộ sheet trong lock -> nạp luôn vào cache request, khỏi đọc lại lần 2. */
function seedReqCacheFromSnapshot_(snap) {
  invalidateReqCache_(snap.sheetName);
  REQ_SHEET_CACHE_['__raw_' + snap.sheetName] = snap.values;
  var keys = SCHEMA[snap.sheetName] || (snap.values || [])[0];
  if (!keys) return;
  var values = snap.values || [];
  var out = [];
  for (var r = 1; r < values.length; r++) {
    var obj = {};
    for (var c = 0; c < keys.length; c++) obj[keys[c]] = values[r][c];
    obj.__row = r + 1;
    out.push(obj);
  }
  REQ_SHEET_CACHE_[snap.sheetName] = out;
  delete REQ_SHEET_CACHE_['__san_' + snap.sheetName];
}

function withMutationLock_(sheetNames, work) {
  sheetNames = (sheetNames || []).slice();
  var stockGuard = sheetNames.indexOf('StockMovements') >= 0;
  if (stockGuard) sheetNames = sheetNames.concat(['MaterialLocations','MaterialRequirements','Machines','MachineModules','Projects']);
  if (MUTATION_CTX_) {
    sheetNames.forEach(trackMutationSheet_);
    if (stockGuard && !MUTATION_CTX_.stockGuard) {
      MUTATION_CTX_.stockGuard = true; MUTATION_CTX_.before = dedicatedDeficits_();
    }
    return work();
  }
  var lock = LockService.getDocumentLock() || LockService.getScriptLock(), acquired = false;
  var ctx = { seen: {}, snaps: [], props: {}, undo: [], stockGuard: stockGuard, before: null };
  function rollback() {
    var failures = [];
    for (var i = ctx.snaps.length - 1; i >= 0; i--) {
      try { restoreSheetSnapshot_(ctx.snaps[i]); } catch (e) { console.warn('[rollback sheet]', e.message); failures.push(ctx.snaps[i].sheetName); }
    }
    Object.keys(ctx.props).forEach(function (key) {
      try {
        var props = PropertiesService.getScriptProperties();
        if (ctx.props[key] === null) props.deleteProperty(key); else props.setProperty(key, ctx.props[key]);
      } catch (e) { console.warn('[rollback property]', e.message); failures.push('session property'); }
    });
    ctx.undo.slice().reverse().forEach(function (undo) { try { undo(); } catch (e) { console.warn('[rollback external]', e.message); failures.push('Drive'); } });
    invalidateReqCache_(); clearDataCache_(); SpreadsheetApp.flush();
    if (failures.length) throw new Error('Rollback chưa hoàn tất: ' + failures.join(', '));
  }
  try {
    lock.waitLock(30000); acquired = true; MUTATION_CTX_ = ctx;
    if (sheetNames.length) sheetNames = sheetNames.concat(['Counters','AuditLog']);
    sheetNames.forEach(trackMutationSheet_);
    if (stockGuard) ctx.before = dedicatedDeficits_();
    var result = work();
    if (result && result.success === false) { rollback(); return result; }
    if (ctx.stockGuard) { dedicatedAssertDeficits_(ctx.before); dedicatedReconcileCommon_(); dedicatedReconcileAllocations_(); }
    if (ctx.snaps.length) { clearDataCache_(Object.keys(ctx.seen)); SpreadsheetApp.flush(); }
    perfCommitCacheV223_();
    return result;
  } catch (e) {
    if (acquired) {
      try { rollback(); } catch (rollbackError) { return err_(rollbackError, 'ERR_ROLLBACK_INCOMPLETE'); }
    }
    return err_(e, acquired ? 'ERR_MUTATION' : 'ERR_LOCK');
  } finally {
    try { if (acquired) perfCommitCacheV223_(); } finally {
      MUTATION_CTX_ = null;
      if (acquired) lock.releaseLock();
    }
  }
}

/* Mọi thao tác chạm 'Payments' đều gián tiếp ghi sang sổ quỹ (appendPaymentRow_ -> syncFinanceFromPayment_
   -> recalculateFinance). Nếu 4 sheet này KHÔNG nằm trong snapshot rollback thì khi lỗi giữa chừng,
   công nợ được khôi phục nhưng bút toán sổ quỹ vẫn còn -> số dư tài khoản tiền lệch vĩnh viễn. */
var FINANCE_LOCK_SHEETS_ = ['FinanceTransactions', 'CashAccounts', 'BudgetPlans', 'BudgetLines'];

function runLocked_(flagObj, flagName, sheetNames, work) {
  flagName = flagName || '__locked';
  flagObj = flagObj || {};
  /* CHẶN TREO MÁY CHỦ: cơ chế này đánh dấu "đã khóa" lên chính object dữ liệu.
     Nếu nơi gọi lỡ truyền chuỗi/số thay vì object (gọi sai tham số) thì dấu đánh vào
     KHÔNG dính, hàm tự gọi lại chính nó vô hạn và làm hết bộ nhớ ngăn xếp.
     Bắt lỗi ngay tại đây để trả về câu báo rõ ràng thay vì treo. */
  if (typeof flagObj !== 'object') {
    return err_('Dữ liệu gửi lên không đúng định dạng (cần một đối tượng, nhận được '
      + (typeof flagObj) + '). Hãy tải lại trang rồi thử lại.', 'ERR_BAD_PAYLOAD');
  }
  if (flagObj[flagName]) return work();
  return withMutationLock_(sheetNames, function () {
    flagObj[flagName] = true;
    return work();
  });
}

function appendRows(sheetName, objects) {
  trackMutationSheet_(sheetName);
  objects = objects || [];
  if (!objects.length) return [];
  // Module nhiều kho: dòng nào chưa ghi kho thì đóng dấu kho đang thao tác.
  if (typeof whStampRows_ === 'function') whStampRows_(sheetName, objects);
  if (typeof vatStampRows_ === 'function') vatStampRows_(sheetName, objects);
  clearDataCache_(sheetName);
  var sh = getSheet_(sheetName);
  var keys = SCHEMA[sheetName] || readSheetRange_(sh, 1, 1, 1, sh.getLastColumn())[0];
  var rows = objects.map(function (object) {
    var obj = normalizeMaterialRefV224_(sheetName, translateRowForSheet_(object));
    return keys.map(function (h) { return (obj[h] !== undefined && obj[h] !== null) ? obj[h] : ''; });
  });
  sh.getRange(sh.getLastRow() + 1, 1, rows.length, keys.length).setValues(rows);
  invalidateReqCache_(sheetName);
  return objects;
}

/**
 * Cập nhật NHIỀU dòng theo ID trong 1 lần quét (P0 hiệu năng).
 * updatesMap: { idValue: {field: value, ...}, ... }
 */
function updateRowsById_(sheetName, idColumn, updatesMap, changedOnly) {
  trackMutationSheet_(sheetName);
  var ids = Object.keys(updatesMap || {});
  if (!ids.length) return 0;
  var keys = SCHEMA[sheetName];
  if (!keys) {
    ids.forEach(function (id) { updateRowById(sheetName, idColumn, id, updatesMap[id]); });
    return ids.length;
  }
  var rows = sheetToObjects_(sheetName);
  var sh = getSheet_(sheetName);
  var writes = [];
  rows.forEach(function (r) {
    var u = updatesMap[String(r[idColumn])];
    if (!u) return;
    var tu = normalizeMaterialRefV224_(sheetName, Object.assign({},r,translateRowForSheet_(u)));
    var arr = keys.map(function (k) {
      var v = (tu[k] !== undefined) ? tu[k] : r[k];
      return (v === undefined || v === null) ? '' : v;
    });
    writes.push([r.__row, arr]);
  });
  // Cập nhật diện rộng (đối soát, tính lại toàn bộ tồn...) -> ghi nguyên block 1 lần
  // thay vì hàng trăm lần setValues từng dòng.
  if (!changedOnly && writes.length > 20 && writes.length > rows.length * 0.3) {
    var byRow = {};
    writes.forEach(function (w) { byRow[w[0]] = w[1]; });
    var block = rows.map(function (r) {
      var normalized = normalizeMaterialRefV224_(sheetName,r);
      return byRow[r.__row] || keys.map(function (k) {
        var v = normalized[k];
        return (v === undefined || v === null) ? '' : v;
      });
    });
    if (block.length) sh.getRange(2, 1, block.length, keys.length).setValues(block);
  } else {
    writes.forEach(function (w) { sh.getRange(w[0], 1, 1, keys.length).setValues([w[1]]); });
  }
  if (writes.length) { clearDataCache_(); invalidateReqCache_(sheetName); }
  return writes.length;
}

/** Xóa NHIỀU dòng theo ID: quét cột ID 1 lần, xóa từ dưới lên (gộp dải liên tiếp). */
function deleteRowsByIds_(sheetName, idColumn, idValues) {
  trackMutationSheet_(sheetName);
  idValues = (idValues || []).filter(function (v) { return v !== undefined && v !== null && v !== ''; });
  if (!idValues.length) return 0;
  var sh = getSheet_(sheetName);
  var keys = SCHEMA[sheetName] || readSheetRange_(sh, 1, 1, 1, sh.getLastColumn())[0];
  var idIdx = keys.indexOf(idColumn);
  if (idIdx < 0) throw new Error('Không có cột ' + idColumn + ' trong ' + sheetName);
  var lastRow = sh.getLastRow();
  if (lastRow < 2) return 0;
  var want = {};
  idValues.forEach(function (v) { want[String(v)] = true; });
  var vals = sheetToObjects_(sheetName).map(function (r) { return [r[idColumn]]; });
  var rowsToDelete = [];
  for (var i = 0; i < vals.length; i++) if (want[String(vals[i][0])]) rowsToDelete.push(i + 2);
  for (var j = rowsToDelete.length - 1; j >= 0;) {
    var end = rowsToDelete[j], start = end, k = j - 1;
    while (k >= 0 && rowsToDelete[k] === start - 1) { start = rowsToDelete[k]; k--; }
    sh.deleteRows(start, end - start + 1);
    j = k;
  }
  if (rowsToDelete.length) { clearDataCache_(sheetName); invalidateReqCache_(sheetName); }
  return rowsToDelete.length;
}

/* ============================================================================
 *  UTILITIES
 * ========================================================================== */

function toNumber(value) {
  if (value === null || value === undefined || value === '') return 0;
  if (typeof value === 'number') return value;
  var s = String(value).trim().replace(/[^\d,.\-]/g, '');
  var negative = s.indexOf('-') === 0;
  s = s.replace(/-/g, '');
  var comma = s.lastIndexOf(','), dot = s.lastIndexOf('.');
  if (comma >= 0 && dot >= 0) {
    s = comma > dot ? s.replace(/\./g, '').replace(',', '.') : s.replace(/,/g, '');
  } else if (comma >= 0) {
    var commaParts = s.split(',');
    s = commaParts.length === 2 ? commaParts[0].replace(/\./g, '') + '.' + commaParts[1] : s.replace(/,/g, '');
  } else if (dot >= 0) {
    var dotParts = s.split('.');
    if (dotParts.length > 2) s = dotParts.join('');
    else if (dotParts.length === 2 && dotParts[1].length === 3 && dotParts[0].length <= 3) s = dotParts.join('');
  }
  var n = Number(s);
  if (negative) n = -n;
  return isNaN(n) ? 0 : n;
}

function itemProductType_(item, product) {
  return normalizeProductType_(item && item.ProductType) || normalizeProductType_(product && product.ProductType) || (isServiceProduct_(product) ? 'Service' : 'Product');
}

function servicePurchaseExpense_(purchases, purchaseItems, productMap, start, end) {
  var active = {};
  (purchases || []).forEach(function (p) {
    if (isCancelled_(p.Status) || p.Status === 'NO_CU') return;
    var d = parseDate_(p.PurchaseDate);
    if (start && (!d || d < start || d >= end)) return;
    active[p.PurchaseID] = true;
  });
  return (purchaseItems || []).reduce(function (sum, it) {
    if (!active[it.PurchaseID]) return sum;
    var prod = (productMap || {})[it.ProductID] || {};
    return itemProductType_(it, prod) === 'Service' ? sum + toNumber(it.LineTotal || (toNumber(it.Quantity) * toNumber(it.UnitCost))) : sum;
  }, 0);
}

function ensureTradingItemSnapshotSchema_() {
  ['PurchaseItems', 'SalesItems'].forEach(function (name) {
    var sh = getSheet_(name), schema = SCHEMA[name], col = schema.indexOf('ProductType') + 1;
    if (col > 0 && !readSheetRange_(sh, 1, col)[0][0]) sh.getRange(1, col).setValue(viHeaders_(name)[col - 1] || 'Loại mặt hàng');
  });
}

/**
 * Ngày của chứng từ — LUÔN trả về một ngày dùng được.
 *
 * new Date('chuỗi rác') cho ra "Invalid Date" và ghi xuống sheet thành ô rỗng. Chứng từ
 * vẫn được tạo nhưng không còn ngày, nên biến mất khỏi mọi báo cáo lọc theo khoảng thời
 * gian — doanh thu tự dưng hụt mà không ai biết. Không đọc được thì lấy ngày dự phòng.
 */
function docDate_(value, fallback) {
  var d = parseDate_(value);
  if (d) return d;
  if (fallback) {
    var f = parseDate_(fallback);
    if (f) return f;
  }
  return new Date();
}

function parseDate_(value) {
  if (!value) return null;
  if (value instanceof Date) return isNaN(value.getTime()) ? null : value;
  if (typeof value === 'number') {
    var serial = new Date(Math.round((value - 25569) * 86400000));
    return isNaN(serial.getTime()) ? null : serial;
  }
  var s = String(value).trim();
  if (/^\d+(?:\.\d+)?$/.test(s)) {
    var n = Number(s);
    return n >= 1 && n <= 2958465 ? parseDate_(n) : null;
  }
  if (s.match(/^\d{4}-\d{2}-\d{2}T/)) {
    var dIso = new Date(s);
    return isNaN(dIso.getTime()) ? null : dIso;
  }
  var m = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})(?:\s+(\d{1,2}):(\d{2})(?::(\d{2}))?)?$/);
  if (m) {
    var dmy = new Date(Number(m[3]), Number(m[2]) - 1, Number(m[1]), Number(m[4] || 0), Number(m[5] || 0), Number(m[6] || 0));
    return isNaN(dmy.getTime()) ? null : dmy;
  }
  m = s.match(/^(\d{4})[\/\-](\d{1,2})[\/\-](\d{1,2})(?:[T\s](\d{1,2}):(\d{2})(?::(\d{2}))?)?/);
  if (m) {
    var ymd = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]), Number(m[4] || 0), Number(m[5] || 0), Number(m[6] || 0));
    return isNaN(ymd.getTime()) ? null : ymd;
  }
  var d = new Date(s);
  return isNaN(d.getTime()) ? null : d;
}

function formatDate(date) {
  if (!date) return '';
  var d = parseDate_(date);
  if (!d) return String(date);
  return Utilities.formatDate(d, getTz_(), 'dd/MM/yyyy');
}

function getTodayString() {
  return Utilities.formatDate(new Date(), getTz_(), 'yyyy-MM-dd');
}

/**
 * SINH ID AN TOÀN (P0-#1).
 * Trước đây ID dựa vào getLastRow() -> sau khi XÓA dòng, số dòng giảm và ID kế tiếp
 * trùng ID đang tồn tại -> ghi đè nhầm bản ghi. Nay dùng bộ đếm 'Counters' tăng đơn điệu,
 * và mỗi lần cấp đều lấy max(bộ đếm, số lớn nhất đang có trong cột ID) nên KHÔNG BAO GIỜ trùng,
 * tự lành kể cả khi nạp lại demo hoặc chèn dữ liệu hàng loạt.
 */
function getCountersSheet_() {
  var ss = getSpreadsheet_();
  var sh = ss.getSheetByName('Counters');
  if (!sh) {
    sh = ss.insertSheet('Counters');
    sh.getRange(1, 1, 1, 2).setValues([['Prefix', 'LastSeq']]);
    sh.setFrozenRows(1);
    try { sh.hideSheet(); } catch (e) { console.warn('[getCountersSheet_]', (e && e.message) || String(e)); }
  }
  return sh;
}

function padSeq_(n) {
  var s = String(n);
  return s.length >= 3 ? s : ('000' + s).slice(-3);
}

/** Số thứ tự lớn nhất đang tồn tại trong cột ID (cột 1) của sheet ứng với prefix. */
function idSeqMax_(prefix) {
  // Dùng cache request: sheet thường đã được đọc trong cùng lần thực thi -> khỏi đọc lại.
  var sheetName = prefixToSheet_(prefix);
  var keys = SCHEMA[sheetName];
  var idKey = keys ? keys[0] : null;
  if (!idKey) return 0;
  var rows = sheetToObjects_(sheetName);
  // CHỈ nhận mã đúng dạng cũ: tiền tố + toàn chữ số (KH001). Mã theo Mẫu mã tuỳ biến
  // (vd HD2608-0001) KHÔNG được tính ở đây, nếu không số thứ tự sẽ nhảy vọt khi tắt mẫu.
  var rx = new RegExp('^' + escapeForRegex_(prefix) + '(\\d+)$');
  var max = 0;
  for (var i = 0; i < rows.length; i++) {
    var m = rx.exec(String(rows[i][idKey] || ''));
    if (m) { var num = parseInt(m[1], 10); if (!isNaN(num) && num > max) max = num; }
  }
  return max;
}

/* ================= SỬA LỖI "MÃ TỰ ĐỘNG NHẢY SAI" =================
   Bộ đếm mã chỉ tăng, không bao giờ lùi. Điều đó đúng khi dữ liệu còn nguyên,
   nhưng sai khi người dùng xóa dữ liệu mẫu / dữ liệu nhập thử: chỉ còn 1 sản phẩm
   mà hệ thống vẫn đề nghị SP036. Các hàm dưới đây chữa tận gốc mà KHÔNG có nguy cơ
   sinh mã trùng: chỉ hạ bộ đếm khi đã soi hết mọi sổ và chắc chắn không nơi nào
   còn dùng những số bị bỏ trống. */

/** Những sổ + cột đang THAM CHIẾU tới mã của một loại đối tượng. */
function codeRefCols_(prefix) {
  var map = {
    SP: [['SalesItems', 'ProductID'], ['PurchaseItems', 'ProductID'], ['StockMovements', 'ProductID'],
    ['InventoryCheckItems', 'ProductID'], ['SalesReturnItems', 'ProductID'], ['PurchaseReturnItems', 'ProductID'],
    ['QuoteItems', 'ProductID']],
    KH: [['SalesOrders', 'CustomerID'], ['SalesReturns', 'CustomerID'], ['Quotes', 'CustomerID'],
    ['Payments', 'ObjectID'], ['PaymentAllocations', 'ObjectID']],
    NCC: [['PurchaseOrders', 'SupplierID'], ['PurchaseReturns', 'SupplierID'],
    ['Payments', 'ObjectID'], ['PaymentAllocations', 'ObjectID']],
    HD: [['SalesItems', 'SalesID'], ['SalesReturns', 'SalesID'], ['StockMovements', 'SourceID'],
    ['Payments', 'SourceID'], ['PaymentAllocations', 'SourceID']],
    PM: [['PurchaseItems', 'PurchaseID'], ['PurchaseReturns', 'PurchaseID'], ['StockMovements', 'SourceID'],
    ['Payments', 'SourceID'], ['PaymentAllocations', 'SourceID']],
    BG: [['QuoteItems', 'QuoteID']],
    TR: [['SalesReturnItems', 'ReturnID'], ['StockMovements', 'SourceID'], ['Payments', 'SourceID']],
    PR: [['PurchaseReturnItems', 'PurchaseReturnID'], ['StockMovements', 'SourceID'], ['Payments', 'SourceID']]
  };
  return map[prefix] || [];
}

/** Số lớn nhất của dạng mã PREFIX+số ĐANG ĐƯỢC DÙNG ở bất kỳ đâu (kể cả chứng từ cũ). */
function codeMaxInUse_(prefix) {
  var rx = new RegExp('^' + escapeForRegex_(prefix) + '(\\d+)$');
  var max = idSeqMax_(prefix);
  var refs = codeRefCols_(prefix);
  for (var i = 0; i < refs.length; i++) {
    var sheetName = refs[i][0], col = refs[i][1];
    if (!SCHEMA[sheetName]) continue;
    var rows;
    try { rows = sheetToObjects_(sheetName); } catch (e) { console.warn('[codeMaxInUse_]', (e && e.message) || String(e));  continue; }
    for (var j = 0; j < rows.length; j++) {
      var m = rx.exec(String(rows[j][col] || ''));
      if (m) { var n = parseInt(m[1], 10); if (!isNaN(n) && n > max) max = n; }
    }
  }
  return max;
}

/**
 * Số nền ĐÚNG để cấp mã tiếp theo. Bộ đếm cao hơn thực tế (do đã xóa dữ liệu) thì
 * hạ xuống, nhưng chỉ khi soi hết mọi sổ mà không nơi nào còn dùng số bị bỏ trống.
 */
function codeHealBase_(prefix, stored) {
  var real = idSeqMax_(prefix);
  if (stored <= real) return Math.max(stored, real);
  // CHỈ hạ bộ đếm khi soi được đúng sổ của tiền tố này. Tiền tố lạ (không có trong
  // bảng ánh xạ) sẽ bị dò nhầm sang sổ khác và luôn ra 0 -> hạ xuống là sinh mã TRÙNG.
  var sheetName = prefixToSheet_(prefix);
  var known = false;
  for (var k in PREFIX_SHEET_MAP_) if (k === prefix) { known = true; break; }
  if (!known || !sheetName) return stored;
  return Math.max(real, codeMaxInUse_(prefix));
}

/**
 * Độ rộng phần số: học theo mã ĐANG CÓ thay vì luôn cố định 3 chữ số.
 * Khách tự đặt SP0001 thì mã tiếp theo phải là SP0002, không phải SP002.
 */
function codeWidthFor_(prefix) {
  var sheetName = prefixToSheet_(prefix);
  var keys = SCHEMA[sheetName];
  var idKey = keys ? keys[0] : null;
  if (!idKey) return 3;
  var rx = new RegExp('^' + escapeForRegex_(prefix) + '(\\d+)$');
  var rows;
  try { rows = sheetToObjects_(sheetName); } catch (e) { console.warn('[codeWidthFor_]', (e && e.message) || String(e));  return 3; }
  var w = 3;
  for (var i = 0; i < rows.length; i++) {
    var m = rx.exec(String(rows[i][idKey] || ''));
    if (m && m[1].length > w) w = m[1].length;
  }
  return Math.min(w, 12);
}

/** Đệm số 0 theo đúng độ rộng mà dữ liệu đang dùng. */
function padSeqFor_(prefix, n) {
  var s = String(n), w = codeWidthFor_(prefix);
  if (s.length >= w) return s;
  return (new Array(w + 1).join('0') + s).slice(-w);
}

/** Thoát ký tự đặc biệt để ghép chuỗi vào biểu thức chính quy an toàn. */
function escapeForRegex_(s) {
  return String(s == null ? '' : s).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

/* nextIds_ được định nghĩa trong MODULE ĐỊNH DẠNG MÃ ở cuối file:
   có cấu hình mẫu mã thì sinh theo mẫu, chưa cấu hình thì chạy y hệt trước đây. */

function nextId_(prefix) { return nextIds_(prefix, 1)[0]; }

/* Giữ tên cũ để mọi nơi đang gọi không phải đổi */
function generateId(prefix) { return generateIds(prefix, 1)[0]; }
function generateIds(prefix, count) {
  if (MUTATION_CTX_) return nextIds_(prefix, count);
  var r = withMutationLock_(['Counters'], function () { return ok_(nextIds_(prefix, count)); });
  if (!r.success) throw new Error(r.message);
  return r.data;
}

var PREFIX_SHEET_MAP_ = null;
function prefixToSheet_(prefix) {
