}
installWarehouseSchema_();

/* ---------------------------- Tra cứu kho ----------------------------
 * KHO TRUNG CHUYỂN: hàng đã rời kho gửi nhưng kho nhận chưa xác nhận thì nằm tạm ở đây.
 * Nhờ vậy TỒN TỔNG của doanh nghiệp không bị hụt trong lúc hàng đang trên đường,
 * mà tồn của từng kho thật vẫn đúng. Kho này không hiện trong danh sách kho của người dùng. */
var WH_TRANSIT_CODE_ = 'KHO-DANGCHUYEN';
var WH_TRANSIT_CACHE_ = null;

function whAll_() { return sheetToObjects_('Warehouses'); }
function whIsTransit_(w) {
  return !!w && String(w.WarehouseCode || '').toUpperCase() === WH_TRANSIT_CODE_;
}
/** Danh sách kho THẬT (bỏ kho trung chuyển) — dùng cho mọi màn hình và báo cáo. */
function whVisible_() { return whAll_().filter(function (w) { return !whIsTransit_(w); }); }
function whActive_() {
  return whVisible_().filter(function (w) { return String(w.Status || 'Đang dùng') !== 'Ngừng dùng'; });
}
/** Kho trung chuyển — tạo khi cần, không bao giờ hiện ra cho người dùng chọn. */
function whTransit_() {
  if (WH_TRANSIT_CACHE_) return WH_TRANSIT_CACHE_;
  var hit = whAll_().filter(whIsTransit_)[0];
  if (!hit) {
    hit = {
      WarehouseID: generateId('KHO'), WarehouseCode: WH_TRANSIT_CODE_, WarehouseName: 'Hàng đang chuyển',
      WarehouseType: 'Trung chuyển', Address: '', Manager: '', Phone: '', IsDefault: false,
      Status: 'Nội bộ', Notes: 'Kho hệ thống: giữ hàng đã rời kho gửi nhưng kho nhận chưa xác nhận',
      CreatedAt: new Date(), UpdatedAt: new Date()
    };
    appendRow('Warehouses', hit);
  }
  WH_TRANSIT_CACHE_ = hit;
  return hit;
}
function whById_(id) {
  if (!id) return null;
  var list = whAll_();
  for (var i = 0; i < list.length; i++) if (String(list[i].WarehouseID) === String(id)) return list[i];
  return null;
}
function whTruthy_(v) { return v === true || String(v).toLowerCase() === 'true' || String(v) === '1' || String(v) === 'x'; }

/** Kho mặc định — chưa có kho nào thì tạo "Kho chính" để hệ thống luôn có chỗ để ghi. */
function whDefault_() {
  if (WH_DEFAULT_CACHE_) return WH_DEFAULT_CACHE_;
  var list = whVisible_();
  var hit = list.filter(function (w) { return whTruthy_(w.IsDefault); })[0]
    || list.filter(function (w) { return String(w.WarehouseCode || '').toUpperCase() === 'KHO-CHINH'; })[0]
    || list[0];
  if (!hit) {
    hit = {
      WarehouseID: generateId('KHO'), WarehouseCode: 'KHO-CHINH', WarehouseName: 'Kho chính',
      WarehouseType: 'Kho tổng', Address: '', Manager: '', Phone: '', IsDefault: true,
      Status: 'Đang dùng', Notes: 'Kho được tạo tự động khi bật module nhiều kho',
      CreatedAt: new Date(), UpdatedAt: new Date()
    };
    appendRow('Warehouses', hit);
  }
  WH_DEFAULT_CACHE_ = hit;
  return hit;
}
/** Kho hợp lệ từ một mã bất kỳ; sai/thiếu thì rơi về kho mặc định. */
function whResolve_(id) { return whById_(id) || whDefault_(); }

/* Chứng từ con thừa kế kho của chứng từ gốc: trả hàng thì hàng phải quay về ĐÚNG
   cái kho đã xuất ra, chứ không phải về kho mặc định. */
var WH_INHERIT_FROM_ = [
  ['SalesID', 'SalesOrders', 'SalesID'],
  ['PurchaseID', 'PurchaseOrders', 'PurchaseID'],
  ['ProductionID', 'ProductionOrders', 'ProductionID']
];

/** Ghi nhớ kho của chứng từ đang lập, để mọi dòng biến động của nó vào đúng kho. */
function whEnter_(data) {
  try {
    WH_CTX_ = '';
    if (!data || typeof data !== 'object') return;
    // 1) Người dùng chọn kho ngay trên chứng từ
    var id = data.WarehouseID || data.warehouseId || data.Warehouse;
    if (id) { WH_CTX_ = String(whResolve_(id).WarehouseID); return; }
    // 2) Không chọn thì lấy theo chứng từ gốc (phiếu trả hàng, phiếu trả NCC...)
    for (var i = 0; i < WH_INHERIT_FROM_.length; i++) {
      var k = WH_INHERIT_FROM_[i];
      if (!data[k[0]]) continue;
      var rows = sheetToObjects_(k[1]);
      for (var j = 0; j < rows.length; j++) {
        if (String(rows[j][k[2]]) === String(data[k[0]]) && rows[j].WarehouseID) {
          WH_CTX_ = String(rows[j].WarehouseID);
          return;
        }
      }
    }
  } catch (e) { console.warn('[whEnter_]', (e && e.message) || String(e));  WH_CTX_ = ''; }
}

/** Những sheet có cột kho và cần đóng dấu tự động khi ghi dòng mới. */
var WH_STAMP_SHEETS_ = ['StockMovements', 'InventoryChecks', 'SalesOrders', 'PurchaseOrders',
  'SalesReturns', 'PurchaseReturns', 'ProductionOrders'];

/* Dòng biến động thuộc chứng từ nào -> tra sổ nào để biết chứng từ đó dùng kho gì.
   Nhận cả tên tiếng Anh (lúc mới dựng dòng) lẫn tên tiếng Việt (khi đọc lại từ sheet). */
var WH_SOURCE_DOC_ = {
  'SalesOrder': ['SalesOrders', 'SalesID'], 'Hóa đơn': ['SalesOrders', 'SalesID'],
  'PurchaseOrder': ['PurchaseOrders', 'PurchaseID'], 'Phiếu mua': ['PurchaseOrders', 'PurchaseID'],
  'SalesReturn': ['SalesReturns', 'ReturnID'], 'Phiếu trả hàng': ['SalesReturns', 'ReturnID'],
  'PurchaseReturn': ['PurchaseReturns', 'PurchaseReturnID'], 'Phiếu trả NCC': ['PurchaseReturns', 'PurchaseReturnID'],
  'ProductionOrder': ['ProductionOrders', 'ProductionID'], 'Lệnh sản xuất': ['ProductionOrders', 'ProductionID'],
  'InventoryCheck': ['InventoryChecks', 'CheckID'], 'Kiểm kê': ['InventoryChecks', 'CheckID']
};

/**
 * Kho của chứng từ gốc. RẤT QUAN TRỌNG: nhiều dòng biến động không sinh ra lúc lập
 * chứng từ mà sinh ra sau đó (đổi trạng thái phiếu mua sang "Đã nhập kho", chạy lệnh
 * sản xuất, đối soát dựng lại sổ, nhập Excel...). Những lần chạy đó KHÔNG còn nhớ
 * người dùng đã chọn kho nào, nên phải hỏi lại chính chứng từ gốc — nếu không hàng
 * sẽ chạy nhầm về kho mặc định.
 */
function whOfSourceDoc_(sourceType, sourceId) {
  try {
    if (!sourceType || !sourceId) return null;
    var map = WH_SOURCE_DOC_[String(sourceType)];
    if (!map) return null;
    var rows = sheetToObjects_(map[0]);
    for (var i = 0; i < rows.length; i++) {
      if (String(rows[i][map[1]]) === String(sourceId)) {
        return rows[i].WarehouseID ? whById_(rows[i].WarehouseID) : null;
      }
    }
    return null;
  } catch (e) { console.warn('[whOfSourceDoc_]', (e && e.message) || String(e));  return null; }
}

/** Đóng dấu kho cho các dòng sắp ghi (gọi từ appendRow/appendRows). */
function whStampRows_(sheetName, rows) {
  try {
    if (WH_STAMP_SHEETS_.indexOf(sheetName) < 0) return;
    var fallback = null;
    var docCache = {};
    (rows || []).forEach(function (r) {
      if (!r || typeof r !== 'object') return;
      if (r.WarehouseID) {                       // dòng đã tự ghi rõ kho (phiếu chuyển kho)
        if (!r.WarehouseName) { var w0 = whById_(r.WarehouseID); if (w0) r.WarehouseName = w0.WarehouseName; }
        return;
      }
      // 1) Người dùng vừa chọn kho ở chứng từ đang lập
      var w = WH_CTX_ ? whResolve_(WH_CTX_) : null;
      // 2) Không có thì hỏi lại chứng từ gốc của dòng biến động này
      if (!w && sheetName === 'StockMovements' && r.SourceType && r.SourceID) {
        var key = String(r.SourceType) + '|' + String(r.SourceID);
        if (docCache[key] === undefined) docCache[key] = whOfSourceDoc_(r.SourceType, r.SourceID);
        w = docCache[key];
      }
      // 3) Cuối cùng mới về kho mặc định
      if (!w) { if (!fallback) fallback = whDefault_(); w = fallback; }
      r.WarehouseID = w.WarehouseID;
      r.WarehouseName = w.WarehouseName;
    });
  } catch (e) { console.warn('[whStampRows_]', (e && e.message) || String(e));  /* thiếu kho thì thôi, tuyệt đối không được chặn nghiệp vụ */ }
}

/** Sửa chứng từ và có đổi kho -> ghi lại kho trên đầu chứng từ (chỉ khi người dùng thực sự chọn). */
function whUpdateDocWarehouse_(sheetName, idKey, idValue) {
  try {
    if (!WH_CTX_) return;
    var w = whResolve_(WH_CTX_);
    var upd = {};
    upd.WarehouseID = w.WarehouseID;
    upd.WarehouseName = w.WarehouseName;
    updateRowById(sheetName, idKey, idValue, upd);
  } catch (e) { console.warn('[whUpdateDocWarehouse_]', (e && e.message) || String(e));  }
}

/* ---------------------- Tồn theo kho (cộng từ sổ) ---------------------- */
/**
 * Tồn của TỪNG kho cho từng sản phẩm: { ProductID: { WarehouseID: soLuong } }.
 * Chỉ đọc sổ biến động đúng 1 lần nên gọi được cho cả danh mục lớn.
 */
function whStockMap_(productIds) {
  var only = null;
  if (productIds && productIds.length) {
    only = {}; productIds.forEach(function (p) { only[String(p)] = true; });
  }
  var def = whDefault_();
  var map = {};
  sheetToObjects_('StockMovements').forEach(function (m) {
    var pid = String(m.ProductID || ''); if (!pid) return;
    if (only && !only[pid]) return;
    var wid = String(m.WarehouseID || def.WarehouseID);
    var bag = map[pid] || (map[pid] = {});
    bag[wid] = (bag[wid] || 0) + movementEffective_(m);
  });
  return map;
}

/** Tồn của 1 sản phẩm tại 1 kho. */
function whStockOf_(productId, warehouseId) {
  var m = whStockMap_([productId])[String(productId)] || {};
  return toNumber(m[String(warehouseId)]);
}

/**
 * Kiểm tra đủ tồn TẠI KHO XUẤT. Trả về câu báo lỗi, hoặc '' nếu đủ.
 * lines: [{prod, qty}]
 */
function whCheckShortage_(lines) {
  try {
    lines = (lines || []).filter(function (x) {
      return x && x.prod && x.prod.ProductID && !isServiceProduct_(x.prod) && toNumber(x.qty) > 0;
    });
    if (!lines.length) return '';
    if (whActive_().length <= 1) return '';        // chỉ 1 kho -> tồn tổng đã là tồn kho đó
    var w = whResolve_(WH_CTX_);
    var map = whStockMap_(lines.map(function (x) { return x.prod.ProductID; }));
    for (var i = 0; i < lines.length; i++) {
      var pid = String(lines[i].prod.ProductID);
      var have = toNumber((map[pid] || {})[String(w.WarehouseID)]);
      if (toNumber(lines[i].qty) > have) {
        return 'Kho "' + w.WarehouseName + '" không đủ tồn để xuất "' + lines[i].prod.ProductName
          + '". Tồn tại kho này: ' + formatNumber_(have) + ', cần xuất: ' + formatNumber_(lines[i].qty)
          + '. Hãy chọn kho khác hoặc lập phiếu điều chuyển kho trước.';
      }
    }
    return '';
  } catch (e) { console.warn('[whCheckShortage_]', (e && e.message) || String(e));  return ''; }
}

/* ---------------------------- Danh mục kho ---------------------------- */
function getWarehouses() {
  try {
    whDefault_();                                  // đảm bảo luôn có ít nhất 1 kho
    var stock = whStockMap_(null);
    var totals = {};
    Object.keys(stock).forEach(function (pid) {
      Object.keys(stock[pid]).forEach(function (wid) {
        var t = totals[wid] || (totals[wid] = { qty: 0, skus: 0 });
        var q = stock[pid][wid];
        if (Math.abs(q) > 0.000001) { t.qty += q; t.skus++; }
      });
    });
    var pMap = {};
    sheetToObjects_('Products').forEach(function (p) { pMap[p.ProductID] = p; });
    var values = {};
    Object.keys(stock).forEach(function (pid) {
      Object.keys(stock[pid]).forEach(function (wid) {
        values[wid] = (values[wid] || 0) + stock[pid][wid] * toNumber((pMap[pid] || {}).CostPrice);
      });
    });
    var rows = whVisible_().map(function (w) {
      var t = totals[w.WarehouseID] || { qty: 0, skus: 0 };
      var o = {};
      Object.keys(w).forEach(function (k) { o[k] = w[k]; });
      o.IsDefault = whTruthy_(w.IsDefault);
      o.TotalQuantity = t.qty;
      o.SkuCount = t.skus;
      o.StockValue = Math.round(values[w.WarehouseID] || 0);
      return o;
    });
    // Hàng đang trên đường giữa hai kho — hiện riêng để không ai tưởng bị thất lạc.
    var tr = whAll_().filter(whIsTransit_)[0];
    if (tr) {
      var tt = totals[tr.WarehouseID] || { qty: 0, skus: 0 };
      if (Math.abs(tt.qty) > 0.000001) {
        rows.push({
          WarehouseID: tr.WarehouseID, WarehouseCode: tr.WarehouseCode, WarehouseName: tr.WarehouseName,
          WarehouseType: 'Trung chuyển', IsDefault: false, IsTransit: true, Status: 'Nội bộ',
          TotalQuantity: tt.qty, SkuCount: tt.skus, StockValue: Math.round(values[tr.WarehouseID] || 0)
        });
      }
    }
    return ok_(rows);
  } catch (e) { return err_(e.message); }
}

function createWarehouse(data) {
  return withMutationLock_(['Warehouses'], function () {
    try {
      data = data || {};
      var name = String(data.WarehouseName || '').trim();
      if (!name) return err_('Vui lòng nhập tên kho.');
      var code = String(data.WarehouseCode || '').trim().toUpperCase();
      if (!code) code = 'KHO-' + padSeq_(whAll_().length + 1);
      if (whAll_().some(function (w) { return String(w.WarehouseCode).toUpperCase() === code; })) {
        return err_('Mã kho "' + code + '" đã có rồi, hãy đặt mã khác.');
      }
      var makeDefault = whTruthy_(data.IsDefault) || whAll_().length === 0;
      if (makeDefault) whAll_().forEach(function (w) { updateRowById('Warehouses', 'WarehouseID', w.WarehouseID, { IsDefault: false }); });
      var row = {
        WarehouseID: generateId('KHO'), WarehouseCode: code, WarehouseName: name,
        WarehouseType: data.WarehouseType || 'Kho hàng', Address: data.Address || '',
        Manager: data.Manager || '', Phone: data.Phone || '', IsDefault: makeDefault,
        Status: data.Status || 'Đang dùng', Notes: data.Notes || '',
        CreatedAt: new Date(), UpdatedAt: new Date()
      };
      appendRow('Warehouses', row);
      WH_DEFAULT_CACHE_ = null;
      writeAudit_('Thêm kho hàng', 'Warehouse', row.WarehouseID, name);
      return ok_(row, 'Đã thêm kho "' + name + '"');
    } catch (e) { return err_(e.message); }
  });
}

function updateWarehouse(warehouseId, data) {
  return withMutationLock_(['Warehouses', 'StockMovements'], function () {
    try {
      data = data || {};
      var w = whById_(warehouseId);
      if (!w) return err_('Không tìm thấy kho.');
      var upd = {};
      if (data.WarehouseName !== undefined) {
        var name = String(data.WarehouseName || '').trim();
        if (!name) return err_('Vui lòng nhập tên kho.');
        upd.WarehouseName = name;
      }
      if (data.WarehouseCode !== undefined) {
        var code = String(data.WarehouseCode || '').trim().toUpperCase();
        if (code && whAll_().some(function (x) {
          return String(x.WarehouseID) !== String(warehouseId) && String(x.WarehouseCode).toUpperCase() === code;
        })) return err_('Mã kho "' + code + '" đã có rồi, hãy đặt mã khác.');
        upd.WarehouseCode = code;
      }
      ['WarehouseType', 'Address', 'Manager', 'Phone', 'Notes'].forEach(function (k) {
        if (data[k] !== undefined) upd[k] = String(data[k] || '');
      });
      if (data.Status !== undefined) {
        var st = String(data.Status || 'Đang dùng');
        if (st === 'Ngừng dùng') {
          var left = whStockLines_(warehouseId);
          if (left.length) return err_('Kho "' + w.WarehouseName + '" còn ' + left.length
            + ' mặt hàng đang tồn — hãy điều chuyển hết sang kho khác trước khi ngừng dùng.', 'ERR_WH_HAS_STOCK');
          if (whTruthy_(w.IsDefault)) return err_('Không thể ngừng dùng kho mặc định. Hãy đặt kho khác làm mặc định trước.');
        }
        upd.Status = st;
      }
      if (data.IsDefault !== undefined && whTruthy_(data.IsDefault)) {
        whAll_().forEach(function (x) {
          if (String(x.WarehouseID) !== String(warehouseId)) updateRowById('Warehouses', 'WarehouseID', x.WarehouseID, { IsDefault: false });
        });
        upd.IsDefault = true;
      }
      upd.UpdatedAt = new Date();
      updateRowById('Warehouses', 'WarehouseID', warehouseId, upd);
      // Đổi tên kho -> cập nhật luôn tên đã in trên sổ biến động cho khỏi lệch.
      if (upd.WarehouseName && upd.WarehouseName !== w.WarehouseName) {
        var fixes = {};
        sheetToObjects_('StockMovements').forEach(function (m) {
          if (String(m.WarehouseID) === String(warehouseId) && m.WarehouseName !== upd.WarehouseName) {
            fixes[m.MovementID] = { WarehouseName: upd.WarehouseName };
          }
        });
        if (Object.keys(fixes).length) updateRowsById_('StockMovements', 'MovementID', fixes);
      }
      WH_DEFAULT_CACHE_ = null;
      writeAudit_('Sửa kho hàng', 'Warehouse', warehouseId, upd.WarehouseName || w.WarehouseName);
      return ok_(Object.assign({}, w, upd), 'Đã cập nhật kho');
    } catch (e) { return err_(e.message); }
  });
}

/** Các mặt hàng còn tồn khác 0 tại một kho. */
function whStockLines_(warehouseId) {
  var map = whStockMap_(null);
  var pMap = {};
  sheetToObjects_('Products').forEach(function (p) { pMap[p.ProductID] = p; });
  var out = [];
  Object.keys(map).forEach(function (pid) {
    var q = toNumber(map[pid][String(warehouseId)]);
    if (Math.abs(q) <= 0.000001) return;
    var p = pMap[pid] || {};
    out.push({ ProductID: pid, SKU: p.SKU || '', ProductName: p.ProductName || pid, Quantity: q, UnitCost: toNumber(p.CostPrice) });
  });
  return out;
}

function getWarehouseDeletionInfo(warehouseId) {
  try {
    var w = whById_(warehouseId);
    if (!w) return err_('Không tìm thấy kho.');
    var lines = whStockLines_(warehouseId);
    var others = whActive_().filter(function (x) { return String(x.WarehouseID) !== String(warehouseId); })
      .map(function (x) { return { WarehouseID: x.WarehouseID, WarehouseCode: x.WarehouseCode, WarehouseName: x.WarehouseName }; });
    var moves = sheetToObjects_('StockMovements').filter(function (m) { return String(m.WarehouseID) === String(warehouseId); }).length;
    return ok_({ warehouse: w, lines: lines, movementCount: moves, otherWarehouses: others, isDefault: whTruthy_(w.IsDefault) });
  } catch (e) { return err_(e.message); }
}

function deleteWarehouse(warehouseId) {
  return withMutationLock_(['Warehouses', 'StockMovements'], function () {
    try {
      var w = whById_(warehouseId);
      if (!w) return err_('Không tìm thấy kho.');
      if (whIsTransit_(w)) return err_('Đây là kho hệ thống (hàng đang chuyển), không xóa được.');
      if (whVisible_().length <= 1) return err_('Đây là kho duy nhất — không thể xóa.');
      if (whTruthy_(w.IsDefault)) return err_('Không thể xóa kho mặc định. Hãy đặt kho khác làm mặc định trước.');
      var lines = whStockLines_(warehouseId);
      if (lines.length) {
        return err_('Kho "' + w.WarehouseName + '" còn ' + lines.length + ' mặt hàng đang tồn. '
          + 'Hãy dùng "Chuyển hết rồi xóa" để dồn hàng sang kho khác.', 'ERR_WH_HAS_STOCK');
      }
      var moves = sheetToObjects_('StockMovements').filter(function (m) { return String(m.WarehouseID) === String(warehouseId); });
      if (moves.length) {
        // Còn lịch sử nhưng tồn bằng 0: chuyển lịch sử về kho mặc định để không mồ côi số liệu.
        var def = whDefault_();
        var fixes = {};
        moves.forEach(function (m) { fixes[m.MovementID] = { WarehouseID: def.WarehouseID, WarehouseName: def.WarehouseName }; });
        updateRowsById_('StockMovements', 'MovementID', fixes);
      }
      deleteRowById('Warehouses', 'WarehouseID', warehouseId);
      WH_DEFAULT_CACHE_ = null;
      writeAudit_('Xóa kho hàng', 'Warehouse', warehouseId, w.WarehouseName);
      return ok_(null, 'Đã xóa kho "' + w.WarehouseName + '"');
    } catch (e) { return err_(e.message); }
  });
}

/** Dồn toàn bộ tồn của kho A sang kho B rồi xóa kho A. */
function transferAllAndDeleteWarehouse(fromId, toId) {
  try {
    var from = whById_(fromId), to = whById_(toId);
    if (!from) return err_('Không tìm thấy kho cần xóa.');
    if (!to) return err_('Vui lòng chọn kho nhận hàng.');
    if (String(fromId) === String(toId)) return err_('Kho nhận phải khác kho đang xóa.');
    var lines = whStockLines_(fromId);
    if (lines.length) {
      var mv = createStockTransfer({
        FromWarehouseID: fromId, ToWarehouseID: toId, TransferDate: new Date(),
        Reason: 'Dồn hàng trước khi xóa kho', AutoReceive: true,
        Notes: 'Tự động khi xóa kho ' + from.WarehouseName,
        items: lines.map(function (l) { return { ProductID: l.ProductID, Quantity: l.Quantity }; })
      });
      if (!mv.success) return mv;
    }
    return deleteWarehouse(fromId);
  } catch (e) { return err_(e.message); }
}

/* ------------------------- Báo cáo tồn theo kho ------------------------- */
function getWarehouseInventory(warehouseId) {
  try {
    var stock = whStockMap_(null);
    var whs = whVisible_();
    var tr = whAll_().filter(whIsTransit_)[0];
    var products = sheetToObjects_('Products').filter(function (p) { return !isServiceProduct_(p); });
    var rows = products.map(function (p) {
      var bag = stock[String(p.ProductID)] || {};
      var byWh = whs.map(function (w) {
        return { WarehouseID: w.WarehouseID, WarehouseName: w.WarehouseName, Quantity: toNumber(bag[String(w.WarehouseID)]) };
      });
      var inTransit = tr ? toNumber(bag[String(tr.WarehouseID)]) : 0;
      var total = byWh.reduce(function (s, x) { return s + x.Quantity; }, 0) + inTransit;
      return {
        ProductID: p.ProductID, SKU: p.SKU, ProductName: p.ProductName, Unit: p.Unit,
        CostPrice: toNumber(p.CostPrice), MinStock: toNumber(p.MinStock),
        TotalStock: total, InTransit: inTransit,
        StockValue: Math.round(total * toNumber(p.CostPrice)), byWarehouse: byWh
      };
    });
    if (warehouseId) {
      rows = rows.map(function (r) {
        var hit = r.byWarehouse.filter(function (x) { return String(x.WarehouseID) === String(warehouseId); })[0] || { Quantity: 0 };
        r.Quantity = hit.Quantity;
        r.StockValue = Math.round(hit.Quantity * r.CostPrice);
        return r;
      }).filter(function (r) { return Math.abs(r.Quantity) > 0.000001; });
    }
    return ok_({
      warehouses: whs.map(function (w) { return { WarehouseID: w.WarehouseID, WarehouseCode: w.WarehouseCode, WarehouseName: w.WarehouseName, IsDefault: whTruthy_(w.IsDefault), Status: w.Status }; }),
      rows: rows, warehouseId: warehouseId || '',
      inTransitTotal: rows.reduce(function (s, r) { return s + toNumber(r.InTransit); }, 0)
    });
  } catch (e) { return err_(e.message); }
}

/** Tồn của 1 sản phẩm tách theo từng kho — dùng cho popup chi tiết sản phẩm. */
function getProductWarehouseStock(productId) {
  try {
    var bag = whStockMap_([productId])[String(productId)] || {};
    var out = whVisible_().map(function (w) {
      return { WarehouseID: w.WarehouseID, WarehouseCode: w.WarehouseCode, WarehouseName: w.WarehouseName, Quantity: toNumber(bag[String(w.WarehouseID)]) };
    });
    var tr = whAll_().filter(whIsTransit_)[0];
    var inTransit = tr ? toNumber(bag[String(tr.WarehouseID)]) : 0;
    if (Math.abs(inTransit) > 0.000001) {
      out.push({ WarehouseID: tr.WarehouseID, WarehouseCode: tr.WarehouseCode, WarehouseName: tr.WarehouseName, Quantity: inTransit, IsTransit: true });
    }
    return ok_(out);
  } catch (e) { return err_(e.message); }
}

/* --------------------------- Điều chuyển kho --------------------------- */
function getStockTransfers() {
  try { return ok_(sheetToObjects_('StockTransfers')); } catch (e) { return err_(e.message); }
}

function getStockTransferDetail(transferId) {
  try {
    var t = sheetToObjects_('StockTransfers').filter(function (x) { return x.TransferID === transferId; })[0];
    if (!t) return err_('Không tìm thấy phiếu chuyển kho.');
    var items = sheetToObjects_('StockTransferItems').filter(function (x) { return x.TransferID === transferId; });
    var moves = sheetToObjects_('StockMovements').filter(function (m) { return String(m.SourceID) === String(transferId); });
    return ok_({ order: t, items: items, movements: moves });
  } catch (e) { return err_(e.message); }
}

/**
 * Lập phiếu chuyển kho. Mặc định phiếu ở trạng thái "Đang chuyển":
 * hàng đã RỜI kho xuất nhưng CHƯA vào kho nhận — đúng với thực tế hàng đang trên đường.
 * Bấm "Xác nhận nhận hàng" thì mới ghi dòng nhập cho kho nhận.
 * AutoReceive = true thì xuất và nhận luôn trong một lần (chuyển nội bộ tại chỗ).
 */
function createStockTransfer(data) {
  data = data || {};
  if (!data.__locked) return runLocked_(data, '__locked',
    ['StockTransfers', 'StockTransferItems', 'StockMovements', 'Products'],
    function () { return createStockTransfer(data); });
  try {
    var dup = dupByClientRef_('StockTransfers', 'TransferID', data.ClientRef, 'Phiếu chuyển kho');
    if (dup) return dup;
    var from = whById_(data.FromWarehouseID), to = whById_(data.ToWarehouseID);
    if (!from) return err_('Vui lòng chọn kho xuất.');
    if (!to) return err_('Vui lòng chọn kho nhận.');
    if (String(from.WarehouseID) === String(to.WarehouseID)) return err_('Kho xuất và kho nhận phải khác nhau.');
    var items = (data.items || []).filter(function (it) { return it && it.ProductID && toNumber(it.Quantity) > 0; });
    if (!items.length) return err_('Chưa chọn mặt hàng nào để chuyển.', 'ERR_NO_ITEMS');

    var pMap = {};
    sheetToObjects_('Products').forEach(function (p) { pMap[p.ProductID] = p; });
    var stock = whStockMap_(items.map(function (i) { return i.ProductID; }));

    // Gộp các dòng trùng sản phẩm rồi mới kiểm tồn -> không lách được bằng cách tách dòng.
    var merged = {};
    items.forEach(function (it) {
      var pid = String(it.ProductID);
      merged[pid] = (merged[pid] || 0) + toNumber(it.Quantity);
    });
    var pids = Object.keys(merged);
    for (var i = 0; i < pids.length; i++) {
      var p = pMap[pids[i]];
      if (!p) return err_('Không tìm thấy sản phẩm ' + pids[i]);
      if (isServiceProduct_(p)) return err_('"' + p.ProductName + '" là dịch vụ, không chuyển kho được.');
      var have = toNumber((stock[pids[i]] || {})[String(from.WarehouseID)]);
      if (merged[pids[i]] > have) {
        return err_('Kho "' + from.WarehouseName + '" chỉ còn ' + formatNumber_(have) + ' "' + p.ProductName
          + '", không đủ để chuyển ' + formatNumber_(merged[pids[i]]) + '.', 'ERR_WH_STOCK');
      }
    }

    var id = generateId('CK');
    var now = new Date();
    var tDate = docDate_(data.TransferDate, now);
    var autoReceive = whTruthy_(data.AutoReceive);
    var totalQty = 0, totalValue = 0;
    var itemIds = generateIds('CKI', pids.length);
    var itemRows = pids.map(function (pid, idx) {
      var p = pMap[pid];
      var qty = merged[pid];
      var cost = toNumber(p.CostPrice);
      totalQty += qty; totalValue += qty * cost;
      return {
        TransferItemID: itemIds[idx], TransferID: id, ProductID: pid, SKU: p.SKU || '',
        ProductName: p.ProductName || '', Quantity: qty, UnitCost: cost, LineTotal: qty * cost, Notes: ''
      };
    });

    appendRow('StockTransfers', {
      TransferID: id, TransferDate: tDate,
      FromWarehouseID: from.WarehouseID, FromWarehouseName: from.WarehouseName,
      ToWarehouseID: to.WarehouseID, ToWarehouseName: to.WarehouseName,
      TotalQuantity: totalQty, TotalValue: Math.round(totalValue),
      Status: autoReceive ? 'Đã nhận' : 'Đang chuyển', Reason: data.Reason || '',
      CreatedBy: getUser_(), Notes: data.Notes || '', CreatedAt: now,
      ReceivedAt: autoReceive ? now : '', ReceivedBy: autoReceive ? getUser_() : '',
      ClientRef: data.ClientRef || ''
    });
    appendRows('StockTransferItems', itemRows);

    /* Hàng rời kho gửi -> vào KHO TRUNG CHUYỂN, nên tồn tổng của doanh nghiệp không đổi.
       Kho nhận xác nhận thì hàng mới rời trung chuyển để vào kho nhận. */
    var transit = whTransit_();
    var mid = autoReceive ? to : transit;
    var mvIds = generateIds('MV', itemRows.length * (autoReceive ? 2 : 2));
    var moves = [];
    itemRows.forEach(function (it, idx) {
      moves.push({
        MovementID: mvIds[idx], Date: tDate, Type: 'TransferOut', SourceType: 'StockTransfer', SourceID: id,
        ProductID: it.ProductID, SKU: it.SKU, ProductName: it.ProductName,
        QuantityIn: 0, QuantityOut: it.Quantity, UnitCost: it.UnitCost, UnitPrice: '',
        StockAfter: '', CreatedBy: getUser_(), Notes: 'Chuyển sang ' + to.WarehouseName,
        CreatedAt: now, Status: 'Đã nhận',
        WarehouseID: from.WarehouseID, WarehouseName: from.WarehouseName
      });
      moves.push({
        MovementID: mvIds[itemRows.length + idx], Date: tDate, Type: 'TransferIn', SourceType: 'StockTransfer', SourceID: id,
        ProductID: it.ProductID, SKU: it.SKU, ProductName: it.ProductName,
        QuantityIn: it.Quantity, QuantityOut: 0, UnitCost: it.UnitCost, UnitPrice: '',
        StockAfter: '', CreatedBy: getUser_(),
        Notes: autoReceive ? ('Nhận từ ' + from.WarehouseName) : ('Đang trên đường về ' + to.WarehouseName),
        CreatedAt: now, Status: 'Đã nhận',
        WarehouseID: mid.WarehouseID, WarehouseName: mid.WarehouseName
      });
    });
    appendRows('StockMovements', moves);
    recalculateProductStocks_(pids);
    writeAudit_('Lập phiếu chuyển kho', 'StockTransfer', id,
      from.WarehouseName + ' -> ' + to.WarehouseName + ' · ' + formatNumber_(totalQty) + ' đơn vị');
    return ok_({ TransferID: id, Status: autoReceive ? 'Đã nhận' : 'Đang chuyển' },
      autoReceive ? 'Đã chuyển kho xong' : 'Đã lập phiếu chuyển kho ' + id + ' (chờ kho nhận xác nhận)');
  } catch (e) { return err_(e.message); }
}

function receiveStockTransfer(transferId, __locked) {
  if (!__locked) return withMutationLock_(['StockTransfers', 'StockMovements', 'Products'],
    function () { return receiveStockTransfer(transferId, true); });
  try {
    var t = sheetToObjects_('StockTransfers').filter(function (x) { return x.TransferID === transferId; })[0];
    if (!t) return err_('Không tìm thấy phiếu chuyển kho.');
    if (statusText_(t.Status) !== STATUS_.TRANSFERRING) return err_('Chỉ nhận phiếu đang chuyển; trạng thái hiện tại: ' + t.Status, 'ERR_TRANSFER_STATE');
    var items = sheetToObjects_('StockTransferItems').filter(function (x) { return x.TransferID === transferId; });
    if (!items.length) return err_('Phiếu không có dòng hàng nào.');
    var now = new Date();
    var transit = whTransit_();
    var ids = generateIds('MV', items.length * 2);
    var moves = [];
    items.forEach(function (it, idx) {
      // Rời kho trung chuyển...
      moves.push({
        MovementID: ids[idx], Date: now, Type: 'TransferOut', SourceType: 'StockTransfer', SourceID: transferId,
        ProductID: it.ProductID, SKU: it.SKU, ProductName: it.ProductName,
        QuantityIn: 0, QuantityOut: toNumber(it.Quantity), UnitCost: toNumber(it.UnitCost), UnitPrice: '',
        StockAfter: '', CreatedBy: getUser_(), Notes: 'Giao tới ' + t.ToWarehouseName,
        CreatedAt: now, Status: 'Đã nhận',
        WarehouseID: transit.WarehouseID, WarehouseName: transit.WarehouseName
      });
      // ...vào kho nhận.
      moves.push({
        MovementID: ids[items.length + idx], Date: now, Type: 'TransferIn', SourceType: 'StockTransfer', SourceID: transferId,
        ProductID: it.ProductID, SKU: it.SKU, ProductName: it.ProductName,
        QuantityIn: toNumber(it.Quantity), QuantityOut: 0, UnitCost: toNumber(it.UnitCost), UnitPrice: '',
        StockAfter: '', CreatedBy: getUser_(), Notes: 'Nhận từ ' + t.FromWarehouseName,
        CreatedAt: now, Status: 'Đã nhận',
        WarehouseID: t.ToWarehouseID, WarehouseName: t.ToWarehouseName
      });
    });
    appendRows('StockMovements', moves);
    updateRowById('StockTransfers', 'TransferID', transferId, { Status: 'Đã nhận', ReceivedAt: now, ReceivedBy: getUser_() });
    recalculateProductStocks_(items.map(function (i) { return i.ProductID; }));
    writeAudit_('Xác nhận nhận hàng chuyển kho', 'StockTransfer', transferId, t.ToWarehouseName);
    return ok_(null, 'Đã nhận hàng vào kho ' + t.ToWarehouseName);
  } catch (e) { return err_(e.message); }
}

function cancelStockTransfer(transferId, __locked) {
  if (!__locked) return withMutationLock_(['StockTransfers', 'StockMovements', 'Products'],
    function () { return cancelStockTransfer(transferId, true); });
  try {
    var t = sheetToObjects_('StockTransfers').filter(function (x) { return x.TransferID === transferId; })[0];
    if (!t) return err_('Không tìm thấy phiếu chuyển kho.');
    if (isCancelled_(t.Status)) return err_('Phiếu đã hủy rồi.', 'ERR_TRANSFER_STATE');
    if (String(t.Status) === 'Đã nhận') {
      return err_('Phiếu đã nhận hàng — muốn đảo lại hãy lập một phiếu chuyển ngược, không xóa lịch sử đã nhận.', 'ERR_TRANSFER_RECEIVED');
    }
    if (statusText_(t.Status) !== STATUS_.TRANSFERRING) return err_('Chỉ hủy phiếu đang chuyển.', 'ERR_TRANSFER_STATE');
    // Đang chuyển: gỡ các dòng xuất kho để trả hàng về kho cũ.
    whRemoveTransferMovements_(transferId);
    updateRowById('StockTransfers', 'TransferID', transferId, { Status: 'Đã hủy' });
    writeAudit_('Hủy phiếu chuyển kho', 'StockTransfer', transferId, t.FromWarehouseName + ' -> ' + t.ToWarehouseName);
    return ok_(null, 'Đã hủy phiếu chuyển kho, hàng trả về kho ' + t.FromWarehouseName);
  } catch (e) { return err_(e.message); }
}

function whRemoveTransferMovements_(transferId) {
  var moves = sheetToObjects_('StockMovements').filter(function (m) {
    return String(m.SourceType) === 'StockTransfer' || String(m.SourceType) === 'Phiếu chuyển kho';
  }).filter(function (m) { return String(m.SourceID) === String(transferId); });
  if (!moves.length) return [];
  var pids = [];
  moves.forEach(function (m) { if (pids.indexOf(m.ProductID) < 0) pids.push(m.ProductID); });
  deleteRowsByIds_('StockMovements', 'MovementID', moves.map(function (m) { return m.MovementID; }));
  recalculateProductStocks_(pids);
  return pids;
}

function deleteStockTransfer(transferId, __locked) {
  if (!__locked) return withMutationLock_(['StockTransfers', 'StockTransferItems', 'StockMovements', 'Products'],
    function () { return deleteStockTransfer(transferId, true); });
  try {
    var t = sheetToObjects_('StockTransfers').filter(function (x) { return x.TransferID === transferId; })[0];
    if (!t) return err_('Không tìm thấy phiếu chuyển kho.');
    if (!isCancelled_(t.Status)) return err_('Chỉ xóa phiếu đã hủy. Phiếu đang chuyển cần hủy trước; phiếu đã nhận cần lập chuyển ngược.', 'ERR_TRANSFER_STATE');
    whRemoveTransferMovements_(transferId);
    var items = sheetToObjects_('StockTransferItems').filter(function (x) { return x.TransferID === transferId; });
    if (items.length) deleteRowsByIds_('StockTransferItems', 'TransferItemID', items.map(function (i) { return i.TransferItemID; }));
    deleteRowById('StockTransfers', 'TransferID', transferId);
    writeAudit_('Xóa phiếu chuyển kho', 'StockTransfer', transferId, t.FromWarehouseName + ' -> ' + t.ToWarehouseName);
    return ok_(null, 'Đã xóa phiếu chuyển kho ' + transferId);
  } catch (e) { return err_(e.message); }
}

/* ============================================================================
 *  CHẠY TAY MỘT LẦN TRONG APPS SCRIPT: setupWarehouseModule()
 *  - Tạo sheet Kho hàng / Điều chuyển kho, bổ sung cột "Kho" cho sổ biến động.
 *  - Đóng dấu KHO CHÍNH cho toàn bộ biến động cũ -> tồn theo kho khớp tồn tổng ngay.
 * ========================================================================== */
function setupWarehouseModule() {
  var changed = [];
  try { changed = ensureSchemaColumns_(true); } catch (e) { console.warn('[setupWarehouseModule]', (e && e.message) || String(e)); }
  var def = whDefault_();
  var fixes = {};
  sheetToObjects_('StockMovements').forEach(function (m) {
    if (!m.WarehouseID) fixes[m.MovementID] = { WarehouseID: def.WarehouseID, WarehouseName: def.WarehouseName };
  });
  var n = Object.keys(fixes).length;
  if (n) updateRowsById_('StockMovements', 'MovementID', fixes);
  var msg = 'Đã bật module nhiều kho. Kho mặc định: "' + def.WarehouseName + '". '
    + (n ? ('Đã gán ' + n + ' dòng biến động cũ về kho này.') : 'Không có dòng biến động cũ nào cần gán.');
  if (changed.length) msg = 'Đã bổ sung cột cho: ' + changed.join(', ') + '. ' + msg;
  try { SpreadsheetApp.getUi().alert(msg); } catch (e) { console.warn('[setupWarehouseModule]', (e && e.message) || String(e)); }
  return ok_({ defaultWarehouse: def, stamped: n, changed: changed }, msg);
}

