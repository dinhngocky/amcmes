    return ok_(amcvnFind_('MachineModules', 'ModuleID', moduleId), 'Đã cập nhật module');
  } catch (e) { return err_(e.message); }
}

function deleteMachineModule(moduleId) {
  var lock = { value: moduleId };
  return runLocked_(lock, '__locked', ['Projects', 'Machines', 'MachineModules', 'MachineBOMLines', 'MachineAssignments', 'MachineIssues'], function () {
    try {
      var old = amcvnFind_('MachineModules', 'ModuleID', moduleId);
      if (!old) return err_('Không tìm thấy module.', 'ERR_NOT_FOUND');
      var hasMaterial = sheetToObjects_('MaterialRequirements').some(function (r) { return String(r.ModuleID) === String(moduleId) && materialIsActive_(r); });
      if (hasMaterial) return err_('Module đang có nhu cầu vật tư. Hãy chuyển hoặc xóa các dòng vật tư trước.');
      var hasBom = sheetToObjects_('MachineBOMLines').some(function (r) { return String(r.ModuleID) === String(moduleId); });
      if (hasBom) return err_('Module đang được sử dụng trong BOM máy. Hãy xử lý các phiên bản BOM trước.');
      var hasExecution = ['MachineAssignments', 'MachineIssues'].some(function (sheetName) {
        return sheetToObjects_(sheetName).some(function (r) { return String(r.ModuleID) === String(moduleId); });
      });
      if (hasExecution) return err_('Module đang có phân công hoặc issue sản xuất. Hãy xử lý dữ liệu liên quan trước.');
      deleteRowById('MachineModules', 'ModuleID', moduleId); refreshMachineRollup_(old.MachineID);
      writeAudit_('Xóa module máy', 'MachineModule', moduleId, old.ModuleCode || '');
      return ok_(null, 'Đã xóa module');
    } catch (e) { return err_(e.message); }
  });
}

/* ===== AMCVN SPRINT 2: MATERIAL CONTROL & CTB =========================== */

var MATERIAL_LIFECYCLE_ = ['BOM_RELEASED', 'DEMAND_CREATED', 'PO_RELEASED',
  'SUPPLIER_COMMITTED', 'MATERIAL_COMPLETE', 'PACKED', 'SHIPPED', 'IN_TRANSIT',
  'CUSTOMS', 'RECEIVED', 'IQC_COMPLETE', 'WAREHOUSE', 'KITTED', 'RELEASED'];

function materialStatusRank_(status) {
  var i = MATERIAL_LIFECYCLE_.indexOf(amcvnText_(status).toUpperCase());
  return i < 0 ? 0 : i;
}
function materialCritical_(v) {
  var s = amcvnText_(v).toUpperCase();
  if (s === 'A' || s.indexOf('A -') === 0 || s === 'CRITICAL') return 'A';
  if (s === 'B' || s.indexOf('B -') === 0 || s === 'IMPORTANT') return 'B';
  return 'C';
}
function materialIsActive_(r) { return amcvnText_(r.RequirementStatus).toUpperCase() !== 'CANCELLED'; }
function materialIsReady_(r) {
  return materialIsActive_(r) && toNumber(r.ShortageQty) <= 0
    && materialStatusRank_(r.MaterialStatus) >= materialStatusRank_('IQC_COMPLETE');
}
function materialRisk_(critical, shortage, requiredDate) {
  shortage = Math.max(0, toNumber(shortage));
  if (!shortage) return 'LOW';
  var overdue = false;
  if (requiredDate) {
    var d = new Date(requiredDate); if (!isNaN(d.getTime())) overdue = d.getTime() < new Date().setHours(0, 0, 0, 0);
  }
  if (materialCritical_(critical) === 'A' || overdue) return 'HIGH';
  if (materialCritical_(critical) === 'B') return 'MEDIUM';
  return 'LOW';
}
function materialAvailableFor_(productId, exceptRequirementId) { return dedicatedAvailable_(productId,exceptRequirementId); }

function materialAppendLog_(req, oldStatus, newStatus, data) {
  if (amcvnText_(oldStatus) === amcvnText_(newStatus) && !(data && data.forceLog)) return;
  var now = new Date();
  appendRow('MaterialStatusLogs', {
    LogID: generateId('MSL'), RequirementID: req.RequirementID, ProjectID: req.ProjectID,
    MachineID: req.MachineID, ModuleID: req.ModuleID, OldStatus: oldStatus || '',
    NewStatus: newStatus || '', PlanDate: data && data.PlanDate || '',
    ActualDate: data && data.ActualDate || now, Owner: data && data.Owner || req.Owner || '',
    Note: data && data.Note || '', CreatedBy: getUser_(), CreatedAt: now
  });
}

function buildCTBSummary_(machineId) {
  var reqs = readScopedRowsV224_('MaterialRequirements','MachineID',[machineId]).filter(function (r) {
    return String(r.MachineID) === String(machineId) && materialIsActive_(r);
  });
  var modules = sheetToObjects_('MachineModules').filter(function (m) { return String(m.MachineID) === String(machineId); });
  var moduleMap = {}; modules.forEach(function (m) { moduleMap[m.ModuleID] = m; });
  var out = { machineId: machineId, totalLines: reqs.length, readyLines: 0, shortageLines: 0,
    criticalShortage: 0, shortageQty: 0, percent: 0, status: 'NOT_CALCULATED', modules: [], shortages: [] };
  var groups = {};
  reqs.forEach(function (r) {
    var ready = materialIsReady_(r), shortage = Math.max(0, toNumber(r.ShortageQty));
    if (ready) out.readyLines++;
    if (shortage > 0) {
      out.shortageLines++; out.shortageQty += shortage;
      if (materialCritical_(r.CriticalLevel) === 'A') out.criticalShortage++;
      out.shortages.push(r);
    }
    var key = r.ModuleID || 'UNASSIGNED';
    if (!groups[key]) groups[key] = { ModuleID: r.ModuleID || '', ModuleCode: key === 'UNASSIGNED' ? 'UNASSIGNED' : (moduleMap[key] && moduleMap[key].ModuleCode || key), ModuleName: key === 'UNASSIGNED' ? 'Toàn máy' : (moduleMap[key] && moduleMap[key].ModuleName || ''), totalLines: 0, readyLines: 0, shortageLines: 0, criticalShortage: 0, percent: 0, status: 'NOT_CALCULATED' };
    var g = groups[key]; g.totalLines++; if (ready) g.readyLines++;
    if (shortage > 0) { g.shortageLines++; if (materialCritical_(r.CriticalLevel) === 'A') g.criticalShortage++; }
  });
  out.percent = out.totalLines ? Math.round(out.readyLines * 10000 / out.totalLines) / 100 : 0;
  out.status = !out.totalLines ? 'NOT_CALCULATED' : (out.criticalShortage > 0 ? 'BLOCKED' : (out.percent < 95 ? 'RISK' : 'READY'));
  Object.keys(groups).forEach(function (k) {
    var g = groups[k]; g.percent = g.totalLines ? Math.round(g.readyLines * 10000 / g.totalLines) / 100 : 0;
    g.status = g.criticalShortage > 0 ? 'BLOCKED' : (g.percent < 95 ? 'RISK' : 'READY'); out.modules.push(g);
  });
  out.modules.sort(function (a, b) { return amcvnSortCode_(a, b, 'ModuleCode'); });
  out.shortages.sort(function (a, b) {
    var ca = materialCritical_(a.CriticalLevel), cb = materialCritical_(b.CriticalLevel);
    return ca.localeCompare(cb) || (toNumber(b.ShortageQty) - toNumber(a.ShortageQty));
  });
  return out;
}

function syncShortageExceptions_(machineId, summary) {
  summary = summary || buildCTBSummary_(machineId);
  var now = new Date(), existing = {}, active = {};
  sheetToObjects_('MaterialExceptions').forEach(function (x) {
    if (String(x.MachineID) === String(machineId) && amcvnText_(x.ExceptionType).toUpperCase() === 'SHORTAGE'
      && amcvnText_(x.Status).toUpperCase() !== 'CLOSED') existing[x.RequirementID] = x;
  });
  summary.shortages.forEach(function (r) {
    active[r.RequirementID] = true;
    var desc = (r.SKU || r.ProductName || r.ProductID) + ': thiếu ' + Math.max(0, toNumber(r.ShortageQty)) + ' ' + (r.Unit || '');
    var old = existing[r.RequirementID];
    if (old) updateRowById('MaterialExceptions', 'ExceptionID', old.ExceptionID, {
      ModuleID: r.ModuleID || '', ProductID: r.ProductID, Description: desc, Owner: r.Owner || old.Owner || '',
      DueDate: r.RequiredDate || old.DueDate || '', RiskLevel: r.RiskLevel || materialRisk_(r.CriticalLevel, r.ShortageQty, r.RequiredDate), UpdatedAt: now
    });
    else appendRow('MaterialExceptions', {
      ExceptionID: generateId('MEX'), ProjectID: r.ProjectID, MachineID: r.MachineID, ModuleID: r.ModuleID || '',
      RequirementID: r.RequirementID, ProductID: r.ProductID, ExceptionType: 'SHORTAGE', Description: desc,
      Owner: r.Owner || '', Action: '', DueDate: r.RequiredDate || '', Status: 'OPEN',
      RiskLevel: r.RiskLevel || materialRisk_(r.CriticalLevel, r.ShortageQty, r.RequiredDate), ClosedDate: '',
      CreatedBy: getUser_(), CreatedAt: now, UpdatedAt: now
    });
  });
  Object.keys(existing).forEach(function (rid) {
    if (active[rid]) return;
    updateRowById('MaterialExceptions', 'ExceptionID', existing[rid].ExceptionID, { Status: 'CLOSED', ClosedDate: now, UpdatedAt: now });
  });
}

function syncMachineCTB_(machineId, syncExceptions) {
  var machine = amcvnFind_('Machines', 'MachineID', machineId);
  if (!machine) return buildCTBSummary_(machineId);
  var summary = buildCTBSummary_(machineId);
  updateRowById('Machines', 'MachineID', machineId, { CTBPercent: summary.percent, CTBStatus: summary.status, UpdatedAt: new Date() });
  var moduleUpdates = {};
  summary.modules.forEach(function (g) { if (g.ModuleID) moduleUpdates[g.ModuleID] = { MaterialStatus: g.status, UpdatedAt: new Date() }; });
  if (Object.keys(moduleUpdates).length) updateRowsById_('MachineModules', 'ModuleID', moduleUpdates);
  if (syncExceptions !== false) syncShortageExceptions_(machineId, summary);
  refreshProjectRollup_(machine.ProjectID);
  return summary;
}

function getMaterialRequirements(machineId, filters) {
  try {
    filters = filters || {};
    var rows = cachedSheetToObjects_('MaterialRequirements').filter(function (r) {
      if (machineId && String(r.MachineID) !== String(machineId)) return false;
      if (filters.projectId && String(r.ProjectID) !== String(filters.projectId)) return false;
      if (filters.moduleId && String(r.ModuleID) !== String(filters.moduleId)) return false;
      if (filters.shortageOnly && toNumber(r.ShortageQty) <= 0) return false;
      if (filters.criticalOnly && materialCritical_(r.CriticalLevel) !== 'A') return false;
      return materialIsActive_(r) || filters.includeCancelled;
    });
    rows.sort(function (a, b) {
      return materialCritical_(a.CriticalLevel).localeCompare(materialCritical_(b.CriticalLevel))
        || amcvnSortCode_(a, b, 'SKU');
    });
    return ok_(rows.map(dedicatedEnrich_));
  } catch (e) { return err_(e.message); }
}

function getMaterialRequirementDetail(requirementId) {
  try {
    var requirement = amcvnFind_('MaterialRequirements', 'RequirementID', requirementId);
    if (!requirement) return err_('Không tìm thấy nhu cầu vật tư.', 'ERR_NOT_FOUND');
